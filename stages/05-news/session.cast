[6698.285436, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gleft\u001b[12Gout\u001b[16G\"Youth\u001b[23Gbursaries:\u001b[34Gapplications\u001b[47Gopen\"\u001b[53Gbecause\u001b[61Git\u001b[64Gbreaks\u001b[71Goff\u001b[75Gmid-sentence.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[22m my first \u001b[38;2;177;185;249mextension:setup\u001b[68G\u001b[39mrun created a second copy \u001b[95Gf th\u001b[100G whole\r\u001b[2C\u001b[1Bpage tree. This installation was filled by the\u001b[50Gseed\u001b[55Gscript,\u001b[63Gso\u001b[66Git\u001b[69Ghad\u001b[73Gnever\u001b[79Grecorded\u001b[88Gthat\u001b[93Gthe\u001b[97Gpackage's\r\u001b[2C\u001b[1Bcontent was imp\u001b[19Gr\u001b[21Ged. I restored the database from the \u001b[59Gnapshot I to\u001b[72Gk beforehand and\u001b[89Grecorded\u001b[98Gthe\r\u001b[2C\u001b[1Bimport.\u001b[11GNow\u001b[15Gthe\u001b[19Gdata\u001b[24Gis\u001b[27Gclean:\u001b[34G29\u001b[37Gpages,\u001b[44Gone\u001b[48Ggroup.\u001b[55GThe\u001b[59GREADME\u001b[66Gexplains\u001b[75Ghow\u001b[79Gto\u001b[82Gavoid\u001b[88Gthis.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things are:\u001b[22m the news templates are in \u001b[38;2;177;185;249mResources/Private/Extensions/News/\u001b[39m, \u001b[84Gouting in\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mroute-enhancers.yaml\u001b[39m,\u001b[25Gthe gr\u001b[32Gup in \u001b[38;2;177;185;249mClasses/Initialization/CreateEditorGroupOnPackageInitialization.php\u001b[39m,\r\u001b[2C\u001b[1Band the\u001b[11Gseed scrip\u001b[22G is \u001b[38;2;177;185;249mBuild/Initialisation/seed-news.php\u001b[39m. The\u001b[66Gupdated \u001b[38;2;177;185;249mdata.xml\u001b[39m expor\u001b[89G \u001b[91Gncludes\u001b[99Gall\u001b[103Gthe\r\u001b[2C\u001b[1Bnews\u001b[8Gtables.\u001b[16GNothing\u001b[24Gis\u001b[27Gcommitted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done yet: the test on a fresh installation.\u001b[22m I