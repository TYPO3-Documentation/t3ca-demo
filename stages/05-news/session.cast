[391.711937, "o", "\u001b[?25l\u001b[H\u001b[3G4.\u001b[6G\u001b[1mA restricted text editor (RTE).\u001b[22m T\u001b[40Ge body text\u001b[52Gedi\u001b[56Gor should only offer the formatting the design\u001b[K\r\u001b[2C\u001b[1B  \u001b[6Gsupports, so editors can't paste in\u001b[42Gstyling \u001b[51Ghat breaks the\u001b[66Glook.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors can't change, and shouldn't:\u001b[45G\u001b[22mthe\u001b[49Gcard\u001b[54Glayout,\u001b[62Gthe\u001b[66Gnumber\u001b[73Gof\u001b[76Gnews\u001b[81Gon\u001b[84Gthe\u001b[88Ghome\u001b[93Gpage\u001b[98Gand\u001b[102Gthe\r\u001b[2C\u001b[1Bpage structure. Those stay in the sitepackag\u001b[48G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd\u001b[7Gset\u001b[11Gup\u001b[14Gthe\u001b[18Gfolder,\u001b[26Gthe\u001b[30Geditor\u001b[37Ggroup\u001b[43Gand\u001b[47Gthe\u001b[51GURLs\u001b[56Gtogether\u001b[65Gwith\u001b[70Gthe\u001b[74Gextension,\u001b[85Gso\u001b[88Git's\u001b[93Gready\u001b[99Gfor\r\u001b[2C\u001b[1Beditors\u001b[11Gfrom the sta\u001b[24Gt. You'\u001b[32G only need\u001b[43Gto create the actual ed\u001b[68Gor accounts. Should\u001b[88GI go\u001b[93Gahead\u001b[99Gwith\r\u001b[2C\u001b[1Btha\u001b[7G?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 11s · done 9:34 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, go ahead with news\u001b[39m                                                                                 \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(typo3-distribution-content)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoaded skill\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u00