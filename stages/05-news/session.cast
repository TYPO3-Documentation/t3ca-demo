45Gso\u001b[48Gan\u001b[51Gentry\u001b[57Gappears\u001b[65Gor\u001b[68Gdisappears\u001b[79Gon\u001b[82Gits\u001b[86Gown.\r\u001b[4C\u001b[1BManage the categories (\"Health\",\u001b[38G\"Roads\u001b[45G& transpo\u001b[55Gt\" and so\u001b[66Gn).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Ghome\u001b[12Gpage\u001b[17Gand\u001b[21Gthe\u001b[25G\"All\u001b[30Gnews\"\u001b[36Gpage\u001b[41Gupdate\u001b[48Gby\u001b[51Gthemselves.\u001b[63GThe\u001b[67Gnewest\u001b[74Gthree\u001b[80Gentries\u001b[88Galways\u001b[95Gshow\u001b[100Gon\u001b[103Gthe\r\u001b[2C\u001b[1Bhome page without\u001b[21Ganyone touching it.\u001b[41G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat has to be set up for that to work:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mA\u001b[8Gstorage folder for news rec\u001b[36Grds.\u001b[22m Editors\u001b[49Gwork\u001b[54Gin\u001b[57Gthis\u001b[62Gfolder,\u001b[70Gand\u001b[74Gthe\u001b[78Gnews\u001b[83Gplugins\u001b[91Gon\u001b[94Gthe\u001b[98Ghome\u001b[103Gand\r\u001b[2C\u001b[1B  \u001b[6GNews pages read from it.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA backend user group for editors.\u001b[69G\u001b[22mups\u001b[73Gor\u001b[76Gusers\u001b[82Gyet;\u001b[87Gthe\u001b[91Gonly\u001b[96Gaccount\u001b[104Gis\u001b[31;1H\u001b[29;3H\u001b[?25h"]
