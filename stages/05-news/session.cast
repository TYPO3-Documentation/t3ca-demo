[6698.254249, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gtext ed\u001b[15Gtor limited to paragraphs, two heading levels, bold,\u001b[68Gitalic,\u001b[76Glists\u001b[82Gand\u001b[86Glinks.\r\u001b[2C\u001b[1B-\u001b[5GYou only \u001b[15Geed to\u001b[22Gcr\u001b[25Gate the editor accounts (System\u001b[57G>\u001b[59GBackend\u001b[67Gusers)\u001b[74Gand\u001b[78Gput\u001b[82Gthem\u001b[87Gin\u001b[90G\"Editors\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent I changed on my own\u001b[22m (the Communications Office should check this)\u001b[K\r\u001b[4C\u001b[1BI fixed th\u001b[16G typ\u001b[21Gs from the document: \"the the\", \"there stall\", \"Pedestrains\", \"helth\", \"volunter\".\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gread\u001b[12Gthe\u001b[16Gboreholes\u001b[26Gdate\u001b[31G\"2062\"\u001b[38Gas 2026.\r\u001b[2C\u001b[1B- I left out \"Youth bursaries: applicat\u001b[43Gons \u001b[48Gpen\" be\u001b[56Gau\u001b[59Ge it breaks\u001b[71Goff mid-sentence.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[22m my first\u001b[52G\u001b[38;2;177;185;249mextension:setup\u001b[68G\u001b[39mrun\u001b[72Gcreated\u001b[80Ga\u001b[82Gsecond\u001b[89Gcopy\u001b[94Gof\u001b[97Gthe\u001b[101Gwhole\r\u001b[2C\u001b[1Bpage tree. This installation was filled by the seed script, so it had never r\u001b[81Gcorded that\u001b[93Gthe\u001b[97Gpackage's\r\u001b[2C\u001b[1Bcontent\u001b[11Gwas\u001b[15Gimported.\u001b[25GI\u001b[27Grestored\u001b[36Gthe\u001b[40Gdatabase\u001b[49Gfrom\u001b[54Gthe\u001b[58Gsnapshot\u001b[67GI\u001b[69Gtook\u001b[74Gbeforehand\u001b[85Gand\u001b[89Grecorded\u001b[98Gthe\r\u001b[2C\u001b[1Bimport. Now the data is clean: 29 pages, one group. The README explains how to\u001b[82Gavoid this.\u001b[94G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things are:\u001b[22m the\u001b[25Gnews \u001b[31Gempla\u001b[37Ges\u001b[40Gare in \u001b[38;2;177;185;249mResources/Private/Extensions/News/\u001b[39m, routing in\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mroute-enhancers.yaml\u001b[39m, the group in \u001b[38;2;177;185;249mClasses/Initialization/CreateEditorGroupOnPackageInitialization.php\u001b[39m,\r\u001b[2C\u001b[1Band\u001b[7Gthe\u001b[11Gseed\u001b[16Gscript\u001b[23Gis\u001b[26G\u001b[38;2;177;185;249mBuild/Initialisation/seed-news.php\u001b[39m.\u001b[62GThe\u001b[66Gupdated\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[83G\u001b[39mexport\u001b[90Gincludes\u001b[99Gall\u001b[103Gthe\r\u001b[2C\u001b[1Bnews tables. Nothing is committed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done yet: the test on a fresh installation.\u001b[22m It's the only proof that the package works on an emp\u001b[104Gy\u001b[K\r\u001b[2C\u001b[1Binstallation, and that test was blocked.\u001b[44GThe\u001b[48Gtest\u001b[53Gneeds\u001b[59Gthe\u001b[63Gdatabase\u001b[72Gdropped\u001b[80Gand\u001b[84G\u001b[38;2;177;185;249mtypo3 setup\u001b[96G\u001b[39mrun\u001b[100Gfrom\r\u001b[2C\u001b[1Bscratch.\u001b[12GI've\u001b[17Galready\u001b[25Gsaved\u001b[31Ga\u001b[33Gdatabase\u001b[42Gsnapshot\u001b[51G(\u001b[38;2;177;185;249mafter-news\u001b[39m)\u001b[64Gand\u001b[68Gcopies\u001b[75Gof\u001b[78G\u001b[38;2;177;185;249msettings.php\u001b[91G\u001b[39mand\u001b[95G\u001b[38;2;177;185;249mconfig/sites\r\u001b[2C\u001b[1B\u001b[39min \u001b[38;2;177;185;249m/tmp/claude-1000/-home-lina-wolf-projects-typo3-t3ca-2026-demo/f23fa177-4cff-4c08-bce2-fed5e033b09b/\r\u001b[2C\u001b[1Bscratchpad/fresh-backup\u001b[39m, \u001b[29Go\u001b[31Geverything can be restor\u001b[57G aft\u001b[62Grw\u001b[65Grds. One part h\u001b[81Gs never run at\u001b[96Gall: my\u001b[K\r\u001b[2C\u001b[1Blast \u001b[10Gange, which takes over\u001b[33Gp\u001b[35Gges who\u001b[43Ge exp\u001b[49Grted group doesn't\u001b[68Gexist on the new installation. Should I\r\u001b[2C\u001b[1Brun the fresh-install check that way \u001b[69Gdo you prefer