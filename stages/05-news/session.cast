26G\u001b[38;2;177;185;249m.card\u001b[32G\u001b[39mmarkup.\u001b[40GThe\u001b[44Gslider\u001b[51Gand\u001b[55Gtiles\u001b[61Geach\u001b[66Gneed\u001b[71Ga\u001b[73Gnew\u001b[77Gcontent\u001b[85Gelement\u001b[93Gwith\u001b[98Gits\u001b[102Gown\r\u001b[2C\u001b[1B  \u001b[6Gfields and templates, which is more code.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mIt's the most real content.\u001b[34G\u001b[22mThe news and events document is\u001b[66Gthe m\u001b[73Gn\u001b[75Gthing\u001b[81Gthe\u001b[85Gmunicipality keeps\u001b[K\r\u001b[5C\u001b[1Bupdated, an\u001b[18G it's the part of the\u001b[40Ghome pag\u001b[49G that\u001b[55Gchanges every week. The slider and tiles are a\u001b[102Gfew\r\u001b[7C\u001b[1Bxe\u001b[11G entries th\u001b[24G rarely change.\u001b[K\r\u001b[2C\u001b[1B3\u001b[8G\u001b[1m \u001b[10Gtarts the\u001b[20Gcontent cleanup early.\u001b[43G\u001b[22mThe\u001b[47Gdocument has typo\u001b[65G, a date set in\u001b[81G2062 a\u001b[88Gd a missing teaser.\r\u001b[5C\u001b[1BSomeone at the municipali\u001b[32Gy has to fix\u001b[45Gthose. If\u001b[55Gnews goes first, that review can happen while you\u001b[K\r\u001b[5C\u001b[1Bbuil\u001b[12Gthe other sections.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
