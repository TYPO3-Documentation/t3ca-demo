[6704.756668, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1BPag\u001b[9Gs crea\u001b[16Ged\u001b[20Gater bel\u001b[29Gng to Editors autom\u001b[49Gt\u001b[51Gcal\u001b[55Gy.\u001b[K\r\u001b[4C\u001b[1BA text editor\u001b[19Glimit\u001b[25Gd to paragraphs, two heading levels, bol\u001b[66G, italic, lists\u001b[82Gand l\u001b[89Gks.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou\u001b[9Gonly\u001b[14Gneed\u001b[19Gto\u001b[22Gcreate\u001b[29Gthe\u001b[33Geditor\u001b[40Gaccounts\u001b[49G(System\u001b[57G>\u001b[59GBackend\u001b[67Gusers)\u001b[74Gand\u001b[78Gput\u001b[82Gthem\u001b[87Gin\u001b[90G\"Editors\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent I changed on my own\u001b[22m (the Communications Offic\u001b[57G should check this)\u001b[K\r\u001b[6C\u001b[1Bfixed the typos from \u001b[29Ghe document: \"the\u001b[47Gthe\",\u001b[53G\"there\u001b[60Gstall\",\u001b[68G\"Pedestrains\",\u001b[83G\"helth\",\u001b[92G\"volunter\".\r\u001b[6C\u001b[1Br\u001b[9Gad\u001b[12Gthe\u001b[16Gboreholes d\u001b[28Gte \"2062\" as 2026.\u001b[47G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gleft\u001b[12Gout\u001b[16G\"Youth\u001b[23Gbursaries:\u001b[34Gapplications\u001b[47Gopen\"\u001b[53Gbecause\u001b[61Git\u001b[64Gbreaks\u001b[71Goff\u001b[75Gmid-sentence.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[43G\u001b[22mm\u001b[46Gfirst \u001b[38;2;177;185;249mextension:setup\u001b[39m run cr\u001b[75Gated a second copy of\u001b[97Gthe whole\r\u001b[2C\u001b[1Bpage tree. This installation was\u001b[36Gfilled by the seed script, s\u001b[65G it\u001b[69Ghad never recorded that th\u001b[96G package's\r\u001b[2C\u001b[1Bcontent\u001b[11Gwas\u001b[15Gimported. I\u001b[27Grestored the database from the snapshot I took beforehand and recorded\u001b[98Gthe\r\u001b[2C\u001b[1Bimport.\u001b[11GNow\u001b[15Gthe\u001b[19Gdata\u001b[24Gis\u001b[27Gclean:\u001b[34G29\u001b[37Gpages,\u001b[44Gone\u001b[48Ggroup.\u001b[55GThe\