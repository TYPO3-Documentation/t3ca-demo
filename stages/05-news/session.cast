[6650.268611, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bfrom\u001b[10Gthe\u001b[14Gnavigation.\u001b[26GThat's\u001b[33Gfixed.\u001b[40GOn\u001b[43Garticle\u001b[51Gpages\u001b[57Git\u001b[60Gcurrently\u001b[70Gends\u001b[75Gin\u001b[78G\"Article\"\u001b[88Grather\u001b[95Gthan\u001b[100Gthe\r\u001b[2C\u001b[1B  news title.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors get\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA \"News records\" folder hol\u001b[33Ging 8 c\u001b[41Gtegories and 7 news\u001b[61Gitems\u001b[67Gtaken\u001b[73Gfrom\u001b[78Gthe\u001b[82Gdocument.\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gbackend group called\u001b[28G\"Editors\", created automatically when\u001b[66Gthe\u001b[70Gpackage\u001b[78Gis\u001b[81Gset\u001b[85Gup.\u001b[89GI\u001b[91Gchecked\u001b[99Gwith\u001b[104Ga\r\u001b[4C\u001b[1Btemporary\u001b[15Gtest user (delet\u001b[33G \u001b[35Gfterwards).\u001b[47GThey\u001b[52Gcan:\r\u001b[6C\u001b[1Bedit pages, content,\u001b[28Gnews and categories on every page;\r\u001b[6C\u001b[1Bus\u001b[10G the Page, List\u001b[26Gand\u001b[30GMedia modules;\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- upload images, which go to \u001b[38;2;177;185;249mfileadmin/user_upload/news/\u001b[39m.\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7GThey\u001b[12Gcan't use th\u001b[25G raw\u001b[30GHTML content elem\u001b[48Gnt.\u001b[K\r\u001b[4C\u001b[1BPages creat\u001b[19Glate\u001b[24G belong to Editors a\u001b[45Gtomatically.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gtext\u001b[12Geditor\u001b[19Glimited\u001b[27Gto\u001b[30Gparagraphs,\u001b[42Gtwo\u001b[46Gheading\u001b[54Glevels,\u001b[62Gbold,\u001b[68Gitalic,\u001b[76Glists\u001b[82Gand\u001b[86Glinks.\r\u001b[2C\u001b[1B- You only need to create the edit\u001b[38Gr accounts (System > Backend users) and\u001b[78Gput\u001b[82Gthem\u001b[87Gin\u001b[90G\"Editors\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent I changed on my own\u001b[31G\u001b[22m(the Communications\u001b[51GOffice\u001b[58Gshould\u001b[65Gcheck\u001b[71Gthis)\r\u001b[6C\u001b[1Bfixed the typos\u001b[23Gfrom th\u001b[31G document: \"the\u001b[47Gth\u001b[50G\",\u001b[53G\"there stall\", \"Pedestrain\u001b[80G\", \"helth\",\u001b[92G\"volunter\".\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gread\u001b[12Gthe\u001b[16Gboreholes\u001b[26Gdate\u001b[31G\"2062\"\u001b[38Gas 2026.\r\u001b[2C\u001b[1B- I left out \"Youth bursaries: applications open\" because it breaks off mid-sent\u001b[84Gnce.\u001b[89G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[22m my first \u001b[38;2;177;185;249mextension:setup\u001b[39m run created a seco\u001b[89Gcopy of the whole\r\u001b[2C\u001b[1Bpage \u001b[9Gree. This\u001b[19Ginstallation was fill\u001b[41Gd by the seed\u001b[55Gscript, so\u001b[66Git h\u001b[71Gd never\u001b[79Grecorde\u001b[90Gat the\u001b[97Gpackage's\r\u001b[2C\u001b[1Bcontent\u001b[11Gwas\u001b[15Gimported.\u001b[25GI\u001b[27Grestored\u001b[36Gthe\u001b[40Gdatabase\u001b[49Gfrom\u001b[54Gthe\u001b[58Gsnapshot\u001b[67GI\u001b[69Gtook\u001b[74Gbeforehand\u001b[85Gand\u001b[89Grecorded\u001b[98Gthe\r\u001b[2C\u001b[1Bimport. Now the da\u001b[22Ga is clean: 29 pages,\u001b[44Go\u001b[46Ge group. The README explains how to av\u001b[85Gid this.\r\u001b[2C\u001b[1B                     \u001b[25G   \u001b[29G     \u001b[35G  \u001b[38G  \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[6650.285924, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5GThe breadcrumb now shows on\u001b[33GNews and article pages.\u001b[57GI\u001b[60Gwas also missing before on the other pages\u001b[K\r\u001b[4C\u001b[1Bhidden from\u001b[17Gthe\u001b[21Gmenu\u001b[26G(the\u001b[31GE-services\u001b[42Gportal,\u001b[50Gfor\u001b[54Gexample),\u001b[64Gbecause\u001b[72Gthe\u001b[76Gbreadcrumb\u001b[87Gskipped\u001b[95Gpages\u001b[101Ghidden\r\u001b[4C\u001b[1Bfrom\u001b[10Gthe\u001b[14Gnavigation.\u001b[26GThat's\u001b[33Gfixed.\u001b[40GOn\u001b[43Garticle\u001b[51Gpages\u001b[57Git\u001b[60Gcurrently\u001b[70Gends\u001b[75Gin\u001b[78G\"Article\"\u001b[88Grather\u001b[95Gthan\u001b[100Gthe\r\u001b[2C\u001b[1B  news title.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors get\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA \"News records\" folder hol\u001b[33Ging 8 c\u001b[41Gtegories and 7 news\u001b[61Gitems\u001b[67Gtaken\u001b[73Gfrom\u001b[78Gthe\u001b[82Gdocument.\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gbackend group called\u001b[28G\"Editors\", created automatically when\u001b[66Gthe\u001b[70Gpackage\u001b[78Gis\u001b[81Gset\u001b[85Gup.\u001b[89GI\u001b[91Gchecked\u001b[99Gwith\u001b[104Ga\r\u001b[4C\u001b[1Btemporary\u001b[15Gtest user (delet\u001b[33G \u001b[35Gfterwards).\u001b[47GThey\u001b[52Gcan:\r\u001b[6C\u001b[1Bedit pages, content,\u001b[28Gnews and categories on every page;\r\u001b[6C\u001b[1Bus\u001b[10G the Page, List\u001b[26Gand\u001b[30GMedia modules;\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- upload images, which go to \u001b[38;2;177;185;249mfileadmin/user_upload/news/\u001b[39m.\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7GThey\u001b[12Gcan't use th\u001b[25G raw\u001b[30GHTML content elem\u001b[48Gnt.\u001b[K\r\u001b[4C\u001b[1BPages creat\u001b[19Glate\u001b[24G belong to Editors a\u001b[45Gtomatically.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gtext\u001b[12Geditor\u001b[19Glimited\u001b[27Gto\u001b[30Gparagraphs,\u001