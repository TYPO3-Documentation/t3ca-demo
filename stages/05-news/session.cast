[255.423983, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mRe-exporting the distribution.\u001b[22m Once\u001b[41Gthere\u001b[47Gare\u001b[51Gnews\u001b[56Gand\u001b[60Gevent\u001b[66Grecords,\u001b[75Gthe\u001b[79Gexport\u001b[86Gneeds\u001b[92Gtheir\u001b[98Gtables\u001b[105Gas\r\u001b[4C\u001b[1Bwell\u001b[10G(\u001b[38;2;177;185;249m--table=tx_news_domain_model_news\u001b[45G\u001b[39metc.),\u001b[52Gand\u001b[56Gthe\u001b[60Gslider\u001b[67Gimages\u001b[74Ggo\u001b[77Ginto\u001b[82G\u001b[38;2;177;185;249mdata.xml.files/\u001b[39m.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd go in this order: the slider\u001b[36Ga\u001b[38Gd the tiles first\u001b[56G(they're sitepackage-only), \u001b[85Ghen news, then ev\u001b[103Gnts,\r\u001b[2C\u001b[1Bthen the newsletter once you've picked how it's se\u001b[54Gt. Shou\u001b[62Gd I start with\u001b[77Gthe slider?\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 42s · done 9:29 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mYou want the empty home page to show the design's slider, service tiles, news, events and \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mnewsletter sign-up, and I've worked out what each one needs. Next, I'd build the slider content element,\r\u001b[2C\u001b[1Bonce you say go and decide who sends the newsletter. (turn off recaps in /config)\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThat sounds like a lot. What should I start with, and why?\u001b[39m                                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'd\u001b[7Gstart\u001b[13Gwith\u001b[18G\u001b[1mNews\u001b[22m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy news first:\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mIt's mostly installing, not building.\u001b[44G\u001b[22m\u001b[38;2;177;185;249mgeorgringer/news\u001b[61G\u001b[39malready\u001b[69Gsupports\u001b[78GTYPO3\u001b[84G14.3,\u001b[90Gso\u001b[93Gthere's\u001b[101Gno\u001b[104GTCA\r\u001b[2C\u001b[1B   or JavaScript\u001b[20Gto\u001b[23Gwrite.\u001b[30GYou\u001b[34Ginstall\u001b[42Git,\u001b[46Gadd\u001b[50Ga\u001b[52GNews\u001b[57Gpage\u001b[62Gand\u001b[66Ga\u001b[68Gdetail\u001b[75Gpage,\u001b[81Gand\u001b[85Gwrite\u001b[91Gtemplates\u001b[101Gthat\r\u001b[5C\u001b[1Boutput\u001b[13Gthe\u001b[17Gdesign's\u001b[26G\u001b[38;2;177;185;249m.card\u001b[32G\u001b[39mmarkup.\u001b[40GThe\u001b[44Gslider\u001b[51Gand\u001b[55Gtiles\u001b[61Geach\u001b[66Gneed\u001b[71Ga\u001b[73Gnew\u001b[77Gcontent\u001b[85Gelement\u001b[93Gwith\u001b[98Gits\u001b[102Gown\r\u001b[2C\u001b[1B  \u001b[6Gfields and templates, which is more code.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mIt's the most real content.\u001b[34G\u001b[22mThe news and events document is\u001b[66Gthe m\u001b[73Gn\u001b[75Gthing\u001b[81Gthe\u001b[85Gmunicipality keeps\u001b[K\r\u001b[5C\u001b[1Bupdated, an\u001b[18G it's the part of the\u001b[40Ghome pag\u001b[49G that\u001b[55Gchanges every week. The slider and tiles are a\u001b[102Gfew\r\u001b[7C\u001b[1Bxe\u001b[11G entries th\u001b[24G rarely change.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[255.722153, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mIt starts the content cleanup early.\u001b[43G\u001b[22mThe\u001b[47Gdocument\u001b[56Ghas\u001b[60Gtypos,\u001b[67Ga\u001b[69Gdate\u001b[74Gset\u001b[78Gin\u001b[81G2062\u001b[86Gand\u001b[90Ga\u001b[92Gmissing\u001b[100Gteaser.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
