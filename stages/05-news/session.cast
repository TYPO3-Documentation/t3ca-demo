38;2;248;248;242m`Buil\u001b[17G/Initialisation/seed-news.php` the news on to\u001b[64Gof\u001b[67Gthem,\u001b[73Gand\u001b[77Git\u001b[80Gis\u001b[83Gexported\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 24 +\u001b[38;2;248;248;242mfrom there:                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 25 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 26 \u001b[22m     ddev exec php Build/Initialisation/seed-page-tree.php\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m27\u001b[15G\u001b[38;2;248;248;242mddev exec php Build/Init\u001b[40Galisatio\u001b[49G/seed\u001b[55Gnews.php                       \u001b[87G \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 28 \u001b[22m     ddev exec typo3 impexp:export --type=xml --pid=1 --levels=999 \\\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 23 -\u001b[38;2;248;248;242m        --table=pages --table=tt_content --\u001b[48;2;92;2;0minclude-related\u001b[48;2;61;1;0m=\u001b[48;2;92;2;0msys_file\u001b[48;2;61;1;0m \\                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 29 +\u001b[38;2;248;248;242m        --table=pages --table=tt_content --\u001b[48;2;4;71;0mtable\u001b[48;2;2;40;0m=\u001b[48;2;4;71;0msys_category\u001b[48;2;2;40;0m \\                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 30 +\u001b[38;2;248;248;242m        --table=tx_news_domain_model_news --table=tx_news_domain_model_link \\            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[11G\u001b[38;2;248;248;242m \u001b[13G     \u001b[19G--table=tx_news_domain_model_tag --includ\u001b[61G-related=sys_file\u001b[79G\\       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 32 \u001b[22m         --include-related=sys_file_reference --include-related=sys_file_metadata \\\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[11G\u001b[22m   \u001b[15G    --save-files-o\u001b[34Gts\u001b[37Gde-\u001b[69G\u001b[K\u001b[31;1H\