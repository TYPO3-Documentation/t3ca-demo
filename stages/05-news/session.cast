Gand\u001b[62Gso\u001b[65Gon).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe home page and\u001b[21Gthe \"All news\" page\u001b[41Gupdate\u001b[48Gby\u001b[51Gthemselves.\u001b[63GThe\u001b[67Gnewest\u001b[74Gthree\u001b[80Gentries\u001b[88Galways\u001b[95Gshow\u001b[100Gon\u001b[103Gthe\r\u001b[2C\u001b[1Bhome\u001b[8Gpage\u001b[13Gwithout\u001b[21Ganyone\u001b[28Gtouching\u001b[37Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat\u001b[8Ghas to be set up for that t\u001b[36G work:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA storage folder for news records.\u001b[41G\u001b[22mEditors\u001b[49Gwork\u001b[54Gin\u001b[57Gthis\u001b[62Gfolder,\u001b[70Gand\u001b[74Gthe\u001b[78Gnews\u001b[83Gplugins\u001b[91Gon\u001b[94Gthe\u001b[98Ghome\u001b[103Gand\r\u001b[2C\u001b[1B  \u001b[6GNews pages read from it.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA backend user group for editors.\u001b[22m The\u001b[44Gproject\u001b[52Ghas\u001b[56Gno\u001b[59Geditor\u001b[66Ggroups\u001b[73Gor\u001b[76Gusers\u001b[82Gyet;\u001b[87Gthe\u001b[91Gonly\u001b[96Gaccount\u001b[104Gis\r\u001b[5C\u001b[1Bthe admin you install with.\u001b[34GThe\u001b[38Ggr\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[340.700914, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gset\u001b[16Gup\u001b[19Gnews\u001b[24Gnow?\u001b[29GI'd\u001b[33Gadd\u001b[37Gthe\u001b[41Gextension\u001b[51Gwith\u001b[56Gcomposer,\u001b[66Gcreate\u001b[73Gthe\u001b[77GNews\u001b[82Gand\u001b[86Gdetail\u001b[93Gpages\u001b[99Gin\u001b[102Gthe\r\u001b[1B \u001b[3Gseed script, and override the\u001b[33Glist\u001b[38Gtemplate\u001b[47Gto\u001b[50Gmatch\u001b[56Gthe\u001b[60Gdesign's\u001b[69Gcards.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mWorked for 11s · done 9:32 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwill the editors be able to change the news themselves?\u001b[39m                                                 \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes.\u001b[8GThat's\u001b[15Gone\u001b[19Gof\u001b[22Gthe\u001b[26Gmain\u001b[31Greasons\u001b[39Gto\u001b[42Guse\u001b[46Gthe\u001b[50Gnews\u001b[55Gextension\u001b[65Grather\u001b[72Gthan\u001b[77Gwriting\u001b[85Gnews\u001b[90Ginto\u001b[95Gpages\u001b[101Gby\r\u001b[2C\u001b[1Bhand. A few things have to be set up first,\u001b[47Gthough,\u001b[55Gand\u001b[59Gnone\u001b[64Gof\u001b[67Gthem\u001b[72Gexist\u001b[78Gin\u001b[81Gthe\u001b[85Gproject\u001b[93Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors can do once it's set up:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BAdd, edit, hide and delete news in the backe\u001b[50Gd (Web\u001b[57G> List on a \"News\" folder), with title,\u001b[97Gdate,\r\u001b[2C\u001b[1B \u001b[5Gc\u001b[7Gte\u001b[10Gory, te\u001b[18Gs\u001b[20Gr, body text and images.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSchedule\u001b[14Gnews\u001b[19Gwith\u001b[24Gstart\u001b[30Gand\u001b[34Gend\u001b[38Gtimes,\u001b[45Gso\u001b[48Gan\u001b[51Gentry\u001b[57Gappears\u001b[65Gor\u001b[68Gdisappears\u001b[79Gon\u001b[82Gits\u001b[86Gown.\r\u001b[2C\u001b[1B- Manag\u001b[12Gthe c\u001b[18Gtegories (\"Health\", \"Roads & transport\" and so on).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Ghome\u001b[12Gpage\u001b[17Gand\u001b[21Gthe\u001b[25G\"All\u001b[30Gnews\"\u001b[36Gpage\u001b[41Gupdate\u001b[48Gby\u001b[51Gthemselves.\u001b[63GThe\u001b[67Gnewest\u001b[74Gthree\u001b[80Gentries\u001b[88Galways\u001b[95Gshow\u001b[100Gon\u001b[103Gthe\r\u001b[2C\u001b[1Bhome page without anyone touching it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat has to be set up for that to work:\r\u001b[2C\u001b[1B\u001b[22m1\u001b[8G\u001b[1mstorage\u001b[16Gfolder for\u001b[27Gnews rec\u001b[37Gds.\u001b[22m Editors work in this f\u001b[64Glde\u001b[68G, and the news plugins\u001b[93G the h\u001b[100Gme and\r\u001b[5C\u001b[1BNews pages read from it.   \u001b[34G   \u001b[38G  \u001b[31;1H\u001b[29;3H\u001b[?25h"]
