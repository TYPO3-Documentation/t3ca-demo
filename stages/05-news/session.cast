[253.724766, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mInitial content.\u001b[22m The \u001b[27Gexts for the\u001b[40Gslider and the t\u001b[57Gles are\u001b[65Gin\u001b[68G\u001b[38;2;177;185;249mindex.html\u001b[39m.\u001b[80GThe\u001b[84Gnews\u001b[89Gand\u001b[93Gevents\u001b[100Gare\u001b[104Gin\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdesign/docs/news-and-events.docx\u001b[39m.\u001b[39GThat\u001b[44Gdocument\u001b[53Ghas\u001b[57Gerrors\u001b[64Gto\u001b[67Gfix\u001b[71Gbefore\u001b[78Gimporting\u001b[88Git:\r\u001b[2C\u001b[1B  - typos (\"the the old market\u001b[34Gkeep\u001b[39Gthere\u001b[45Gstall\u001b[51Gnumber\",\u001b[60G\"Pedestrains\",\u001b[75G\"helth\",\u001b[84G\"volunter\",\u001b[96G\"Contcat\")\r\u001b[2C\u001b[1B \u001b[5G- one date set in \u001b[1m2062\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- at least one entry with no teaser\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BAfter\u001b[11Gthat, \u001b[18Gverything\u001b[28Ggoes\u001b[33Ginto\u001b[38G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[62G\u001b[39mas\u001b[65Gdescribed\u001b[75Gin\u001b[78Gthe\u001b[82Gpackage\u001b[90GREADME.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRe-exporting the distribution.\u001b[22m Once\u001b[41Gthere\u001b[47Gare\u001b[51Gnews\u001b[56Gand\u001b[60Gevent\u001b[66Grecords,\u001b[75Gthe\u001b[79Gexport\u001b[86Gneeds\u001b[92Gtheir\u001b[98Gtables\u001b[105Gas\r\u001b[4C\u001b[1Bwell\u001b[10G(\u001b[38;2;177;185;249m--table=tx_news_domain_model_news\u001b[45G\u001b[39metc.),\u001b[52Gand\u001b[56Gthe\u001b[60Gslider\u001b[67Gimages\u001b[74Ggo\u001b[77Ginto\u001b[82G\u001b[38;2;177;185;249mdata.xml.files/\u001b[39m.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd go in this order: the slider\u001b[36Ga\u001b[38Gd the tiles first\u001b[56G(they're sitepackage-only), \u001b[85Ghen news, then ev\u001b[103Gnts,\r\u001b[2C\u001b[1Bthen the newsletter once you've picked how it's se\u001b[54Gt. Shou\u001b[62Gd I start with\u001b[77Gthe slider?\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 42s · done 9:29 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mYou want the empty home page to show the design's slider, service tiles, news, events and \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mnewsletter sign-up, and I've worked out what each one needs. Next, I'd build the slider content element,\r\u001b[2C\u001b[1Bonce you say go and decide who sends the newsletter. (turn off recaps in /config)\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThat sounds like a lot. What should I start with, and why?\u001b[39m                                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'd\u001b[7Gstart\u001b[13Gwith\u001b[18G\u001b[1mNews\u001b[22m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy news first:\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[253.973447, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mIt's mostly installing, not building.\u001b[44G\u001b[22m\u001b[38;2;177;185;249mgeorgringer/news\u001b[61G\u001b[39malready\u001b[69Gsupports\u001b[78GTYPO3\u001b[84G14.3,\u001b[90Gso\u001b[93Gthere's\u001b[101Gno\u001b[104GTCA\u001b[31;1H\u001b[29;3H\u001b[?25h"]
