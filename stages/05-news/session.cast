[254.425433, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G\u001b[38;2;177;185;249mdesign/docs/news-and-events.docx\u001b[39m. That documen\u001b[52G has errors to fix before importing it:\u001b[K\r\u001b[4C\u001b[1B- typos (\"the the old market keep\u001b[39Gt\u001b[41Gere stall number\", \"Pedestrains\", \"helth\", \"volunter\",\u001b[96G\"Contcat\")\r\u001b[6C\u001b[1Bone date s\u001b[18Gt in\u001b[23G\u001b[1m2062\u001b[22m\u001b[K\r\u001b[6C\u001b[1Bat le\u001b[13Gst\u001b[16Gone\u001b[20Ge\u001b[22Gtry with\u001b[31Gno\u001b[34Gteaser\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BAfter\u001b[11Gthat,\u001b[17Geverything\u001b[28Ggoes\u001b[33Ginto\u001b[38G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[62G\u001b[39mas\u001b[65Gdescribed\u001b[75Gin\u001b[78Gthe\u001b[82Gpackage\u001b[90GREADME.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRe-exporting the distribution.\u001b[22m Once there are news and event re\u001b[69Gords,\u001b[75Gthe export ne\u001b[89Gds their\u001b[98Gtables\u001b[105Gas\r\u001b[2C\u001b[1B \u001b[5Gwell (\u001b[38;2;177;185;249m--table=tx_news_domain_model_news\u001b[39m \u001b[46Gtc.), and\u001b[56Gthe\u001b[60Gslider image\u001b[73G go into \u001b[38;2;177;185;249mdata.xml.files/\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd\u001b[7Ggo\u001b[10Gin\u001b[13Gthis\u001b[18Gorder:\u001b[25Gthe\u001b[29Gslider\u001b[36Gand\u001b[40Gthe\u001b[44Gtiles\u001b[50Gfirst\u001b[56G(they're\u001b[65Gsitepackage-only),\u001b[84Gthen\u001b[89Gnews,\u001b[95Gthen\u001b[100Gevents,\r\u001b[2C\u001b[1Bthen the newsletter once you'v\u001b[34G picked how it's sen\u001b[55G. S\u001b[59Gould I s\u001b[68Gart with the slider?\u001b[89G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 42s · done 9:29 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mYou want the empty home page to show the design's slider, service tiles, news, events and \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mnewsletter\u001b[14Gsign-up,\u001b[23Gand I've worked\u001b[39Gout what each one needs. Next, I'd build the slider content element,\r\u001b[2C\u001b[1Bonce you say \u001b[17Go and\u001b[23Gdecide who sen\u001b[38Gs the newsletter. (turn off recaps in /config)\u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThat sounds like a lot. What should I start with, and why?\u001b[39m                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'd\u001b[7Gstart\u001b[13Gwith\u001b[18G\u001b[1mNews\u001b[22m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy news first:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mIt's mostly installing, not building.\u001b[44G\u001b[22m\u001b[38;2;177;185;249mgeorgringer/news\u001b[61G\u001b[39malready\u001b[69Gsupports\u001b[78GTYPO3\u001b[84G14.3,\u001b[90Gso\u001b[93Gthere's\u001b[101Gno\u001b[104GTCA\r\u001b[2C\u001b[1B  \u001b[6Gor JavaScript to write. You install it, add a News page and a detail page, and write template\u001b[101Gthat\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[254.578106, "o", "\u001b[?25l\u001b[H\u001b[5G- typos (\"the the old market keep\u001b[39Gt\u001b[41Gere stall number\", \"Pedestrains\", \"helth\", \"volunter\",\u001b[96G\"Contcat\")\r\u001b[6C\u001b[1Bone date s\u001b[18Gt in\u001b[23G\u001b[1m2062\u001b[22m\u001b[K\r\u001b[6C\u001b[1Bat le\u001b[13Gst\u001b[16Gone\u001b[20Ge\u001b[22Gtry with\u001b[31Gno\u001b[34Gteaser\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BAfter\u001b[11Gthat,\u001b[17Geverything\u001b[28Ggoes\u001b[33Ginto\u001b[38G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[62G\u001b[39mas\u001b[65Gdescribed\u001b[75Gin\u001b[78Gthe\u001b[82Gpackage\u001b[90GREADME.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRe-exporting the distribution.\u001b[22m Once there are news and event re\u001b[69Gords,\u001b[75Gthe export ne\u001b[89Gds their\u001b[98Gtables\u001b[105Gas\r\u001b[2C\u001b[1B \u001b[5Gwell (\u001b[38;2;177;185;249m--table=tx_news_domain_model_news\u001b[39m \u001b[46Gtc.), and\u001b[56Gthe\u001b[60Gslider image\u001b[73G go into \u001b[38;2;177;185;249mdata.xml.files/\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd\u001b[7Ggo\u001b[10Gin\u001b[13Gthis\u001b[18Gorder:\u001b[25Gthe\u001b[29Gslider\u001b[36Gand\u001b[40Gthe\u001b[44Gtiles\u001b[50Gfirst\u001b[56G(they're\u001b[65Gsitepackage-only),\u001b[84Gthen\u001b[89Gnews,\u001b[95Gthen\u001b[100Gevents,\r\u001b[2C\u001b[1Bthen the newsletter once you'v\u001b[34G picked how it's sen\u001b[55G. S\u001b[59Gould I s\u001b[68Gart with the slider?\u001b[89G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 42s · done 9:29 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mYou want the empty home page to show the design's slider, service tiles, news, events and \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mnewsletter\u001b[14Gsign-up,\u001b[23Gand I've worked\u001b[39Gout what each one needs. Next, I'd build the slider content element,\r\u001b[2C\u001b[1Bonce you say \u001b[17Go and\u001b[23Gdecide who sen\u001b[38Gs the newsletter. (turn off recaps in /config)\u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThat sounds like a lot. What should I start with, and why?\u001b[39m                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'd\u001b[7Gstart\u001b[13Gwith\u001b[18G\u001b[1mNews\u001b[22m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy news first:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mIt's mostly installing, not building.\u001b[44G\u001b[22m\u001b[38;2;177;185;249mgeorgringer/news\u001b[61G\u001b[39malready\u001b[69Gsupports\u001b[78GTYPO3\u001b[84G14.3,\u001b[90Gso\u001b[93Gthere's\u001b[101Gno\u001b[104GTCA\r\u001b[2C\u001b[1B  \u001b[6Gor JavaScript to write. You install it, add a News page and a detail page, and write template\u001b[101Gthat\u001b[K\r\u001b[6C\u001b[1Butput the design's \u001b[38;2;177;185;249m.card\u001b[39m markup. The sli\u001b[48Ger and tiles e\u001b[63Gch\u001b[66Gneed \u001b[72G new conte\u001b[83Gt\u001b[85Gelem\u001b[90Gn\u001b[92G with its own\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[254.725354, "o", "\u001b[?25l\u001b[H\u001b[7Gat least one entry with no\u001b[34Gt\u001b[36Gaser\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BAfter tha\u001b[15G, every\u001b[23Ghing goes into \u001b[38;2;177;185;249mInitialisation/data.xml\u001b[62G\u001b[39mas\u001b[65Gdescribed\u001b[75Gin\u001b[78Gthe\u001b[82Gpackage\u001b[90GREADME.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRe-exporting the distribution.\u001b[36G\u001b[22mOnce\u001b[41Gthere\u001b[47Gare\u001b[51Gnews\u001b[56Gand\u001b[60Gevent\u001b[66Grecords,\u001b[75Gthe\u001b[79Gexport\u001b[86Gneeds\u001b[92Gtheir\u001b[98Gtables\u001b[105Gas\r\u001b[4C\u001b[1Bwell (\u001b[38;2;177;185;249m--table=tx_news_domain_model_news\u001b[39m etc.), and the slider images go into\u001b[82G\u001b[38;2;177;185;249mdata.xml.files/\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd go\u001b[10Gin this order: the slider and the tiles first\u001b[56G(they're sitepacka\u001b[75Ge-o\u001b[79Gly), then news, then\u001b[100Gevents,\r\u001b[2C\u001b[1Bthen\u001b[8Gthe\u001b[12Gnewsletter\u001b[23Gonce\u001b[28Gyou've\u001b[35Gpicked\u001b[42Ghow\u001b[46Git's\u001b[51Gsent.\u001b[57GShould\u001b[64GI\u001b[66Gstart\u001b[72Gwith\u001b[77Gthe\u001b[81Gslider?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 42s · done 9:29 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mYou want the empty home page to show the design's slider, service tiles, news, events and \r\u001b[2C\u001b[1Bnewsletter sign-up, and I've worked out what each one needs. Next, I'd build the slider content element,\r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3monce you say go\u001b[19Gand\u001b[23Gdecide who\u001b[34Gsends the newsl\u001b[50Gtt\u001b[53Gr. (turn off recaps in\u001b[76G/config)\u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThat sounds like a lot. What should I start with, and why?\u001b[39m                                              \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m I'd start with \u001b[1mNews\u001b[22m.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mWhy news first:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mIt's mostly installing, not building.\u001b[44G\u001b[22m\u001b[38;2;177;185;249mgeorgringer/news\u001b[61G\u001b[39malready\u001b[69Gsupports\u001b[78GTYPO3\u001b[84G14.3,\u001b[90Gso\u001b[93Gthere's\u001b[101Gno\u001b[104GTCA\r\u001b[5C\u001b[1Bor\u001b[9GJavaScript\u001b[20Gto\u001b[23Gwrite.\u001b[30GYou\u001b[34Ginstall\u001b[42Git,\u001b[46Gadd\u001b[50Ga\u001b[52GNews\u001b[57Gpage\u001b[62Gand\u001b[66Ga\u001b[68Gdetail\u001b[75Gpage,\u001b[81Gand\u001b[85Gwrite\u001b[91Gtemplates\u001b[101Gthat\r\u001b[2C\u001b[1B  \u001b[6Goutput the design's \u001b[38;2;177;185;249m.card\u001b[39m markup. The\u001b[44Gslider and tiles\u001b[61Geach need a new content element\u001b[93Gwith its \u001b[103Gwn\u001b[K\r\u001b[5C\u001b[1Bfields and templates, which\u001b[35Gs more\u001b[42Gcode.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[255.023295, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mIt's the most real content.\u001b[34G\u001b[22mThe\u001b[38Gnews\u001b[43Gand\u001b[47Gevents\u001b[54Gdocument\u001b[63Gis\u001b[66Gthe\u001b[70Gmain\u001b[75Gthing\u001b[81Gthe\u001b[85Gmunicipality\u001b[98Gkeeps\u001b[31;1H\u001b[29;3H\u001b[?25h"]
