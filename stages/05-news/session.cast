[950.038341, "o", "\u001b[?25l\u001b[H\u001b[5Gdesign.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m/news\u001b[39m lists all seven news items. Each one opens at a readable address like\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m/news/article/new-fish-market-opens-at-the-jetty\u001b[39m. The article's title i\u001b[77G the page heading\u001b[95Gand\u001b[99Gthe\r\u001b[4C\u001b[1Bbrowser-tab\u001b[17Gtitle. An address that doesn't exist gives\u001b[60Ga 404.\r\u001b[2C\u001b[1B-\u001b[5GThe breadcrumb\u001b[20Gnow\u001b[24Gshows\u001b[30Gon\u001b[33GNews\u001b[38Gand\u001b[42Garticle\u001b[50Gpages.\u001b[57GIt\u001b[60Gwas\u001b[64Galso\u001b[69Gmissing\u001b[77Gbefore\u001b[84Gon\u001b[87Gthe\u001b[91Gother\u001b[97Gpages\r\u001b[4C\u001b[1Bhidden from the menu (the E-services portal, for example), because the breadcrumb skipped pages\u001b[101Ghidden\r\u001b[4C\u001b[1Bfrom the navigation. That's fixed. On article pages it currently ends in \"Article\" rather than the\r\u001b[4C\u001b[1Bnews title.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors get\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GA \"News\u001b[13Grecords\"\u001b[22Gfolder\u001b[29Gholding\u001b[37G8\u001b[39Gcategories\u001b[50Gand\u001b[54G7\u001b[56Gnews\u001b[61Gitems\u001b[67Gtaken\u001b[73Gfrom\u001b[78Gthe\u001b[82Gdocument.\r\u001b[2C\u001b[1B-\u001b[5GA backend\u001b[15Ggroup called \"Editors\", crea\u001b[44Ged \u001b[48Gut\u001b[51Gmatically whe\u001b[70Gpackag\u001b[77G is set\u001b[85Gup.\u001b[89GI\u001b[91Gchecked\u001b[99Gwith\u001b[104Ga\r\u001b[4C\u001b[1Btemporary test us\u001b[23Gr (delet\u001b[32Gd afterwards).\u001b[47GTh\u001b[50Gy can:\u001b[K\r\u001b[4C\u001b[1B- edit pages,\u001b[19Gconten\u001b[26G, \u001b[29Gews and c\u001b[39Gtegories on every page;\r\u001b[4C\u001b[1B- use the Page, List and Media modules;\u001b[K\r\u001b[4C\u001b[1B- upload images, which go to \u001b[38;2;177;185;249mfileadmin/user_upload/news/\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B- They can't use the raw HTML content element.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPages created\u001b[19Glater\u001b[25Gbelong\u001b[32Gto\u001b[35GEditors\u001b[43Gautomatically.\r\u001b[1B  - A text editor limited\u001b[27Gto\u001b[30Gparagraphs,\u001b[42Gtwo\u001b[46Gheading\u001b[54Glevels,\u001b[62Gbold,\u001b[68Gitalic,\u001b[76Glists\u001b[82Gand\u001b[86Glinks.\r\u001b[2C\u001b[1B-\u001b[5GYou\u001b[9Gonly\u001b[14Gneed\u001b[19Gto\u001b[22Gcreate\u001b[29Gthe\u001b[33Geditor\u001b[40Gaccounts\u001b[49G(System\u001b[57G>\u001b[59GBackend\u001b[67Gusers)\u001b[74Gand\u001b[78Gput\u001b[82Gthem\u001b[87Gin\u001b[90G\"Editors\".\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mContent I changed on my own\u001b[22m (the Communications Office should check this)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI fixed the typos from the document: \"the the\", \"there\u001b[60Gstall\",\u001b[68G\"Pedestrains\",\u001b[83G\"helth\",\u001b[92G\"volunter\".\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gread\u001b[12Gthe\u001b[16Gboreholes\u001b[26Gdate\u001b[31G\"2062\"\u001b[38Gas 2026.\r\u001b[1B \u001b[3G- I left out \"Youth bursaries: applications open\" because\u001b[61Git\u001b[64Gbreaks\u001b[71Goff\u001b[75Gmid-sentence.\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[950.168758, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[38;2;177;185;249m/news\u001b[39m lists\u001b[17Gall\u001b[21Gseven\u001b[27Gnews\u001b[32Gitems.\u001b[39GEach\u001b[44Gone\u001b[48Gopens\u001b[54Gat\u001b[57Ga\u001b[59Greadable\u001b[68Gaddress\u001b[76Glike\r\u001b[2C\u001b[1B \u001b[10G\u001b[38;2;177;185;249m/article/new-fish-market-opens-at-the-jetty\u001b[39m. The\u001b[59Garticle's title is the\u001b[82Gpage\u001b[87Gheading\u001b[95Gand\u001b[99Gthe\r\u001b[4C\u001b[1Bbrowser-tab title. An address that doesn't exist giv\u001b[58Gs a 404.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe breadcrumb now\u001b[24Gshows on News an\u001b[41G articl\u001b[49G pages. It\u001b[60Gwas also\u001b[69Gmissing\u001b[77Gbefore\u001b[84Gon\u001b[87Gthe\u001b[91Gother\u001b[97Gpages\r\u001b[2C\u001b[1B \u001b[5Ghidden from the menu (the E-s\u001b[35Grvices\u001b[42Gporta\u001b[48G,\u001b[50Gfor example),\u001b[64Gbecause the br\u001b[79Gadcrumb\u001b[87Gskipped pages hidden\r\u001b[4C\u001b[1Bfrom the navigatio\u001b[24G.\u001b[26GThat's fixed. On a\u001b[46Gicle pag\u001b[55Gs it currently \u001b[71Gnds in \"Article\" rath\u001b[93Gr\u001b[95Gthan t\u001b[102Ge\u001b[K\r\u001b[4C\u001b[1Bnews\u001b[11Gitle.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors get\r\u001b[2C\u001b[1B\u001b[22m- A \"News records\"\u001b[22Gfolder\u001b[29Gholding\u001b[37G8\u001b[39Gcategories\u001b[50Gand\u001b[54G7\u001b[56Gnews\u001b[61Gitems\u001b[67Gtaken\u001b[73Gfrom\u001b[78Gthe\u001b[82Gdocument.\r\u001b[6C\u001b[1Bbackend group cal\u001b[25Ged \"Editors\",\u001b[40Greated automatically\u001b[61Gwh\u001b[64Gn the package\u001b[78Gis set \u001b[86Gp. I checked\u001b[99Gwith\u001b[104Ga\r\u001b[2C\u001b[1B \u001b[5Gtemporary\u001b[15Gtest user (\u001b[27Geleted afterwards).\u001b[47GThey can:\u001b[K\r\u001b[4C\u001b[1B- edit pages, content, n\u001b[30Gws and categories on every\u001b[57Gpage;\r\u001b[6C\u001b[1Buse the Page, List and Media modules;\u001b[K\r\u001b[7C\u001b[1Bpload im\u001b[19Gs, which go to \u001b[38;2;177;185;249mfileadmin/user_upload/news/\u001b[39m.\r\u001b[6C\u001b[1BThey can't u\u001b[20Ge\u001b[22Gt\u001b[24Ge raw HTML content element.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPages created later belong to\u001b[35GEdi\u001b[39Gors\u001b[43Gautoma\u001b[50Gically.\r\u001b[4C\u001b[1BA t\u001b[9Gxt edi\u001b[16Gor\u001b[20Gimited t\u001b[29G paragraphs, two he\u001b[49Gd\u001b[51Gng \u001b[55Gevels,\u001b[62Gbold,\u001b[68Gitalic,\u001b[76Glists\u001b[82Gand\u001b[86Glinks.\r\u001b[4C\u001b[1BYou only need\u001b[19Gto cr\u001b[25Gate the editor accounts (System > Backen\u001b[66G users) and put\u001b[82Gthem \u001b[89G \"Editors\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent I changed on my own\u001b[31G\u001b[22m(the\u001b[36GCommunications\u001b[51GOffice\u001b[58Gshould\u001b[65Gcheck\u001b[71Gthis)\r\u001b[2C\u001b[1B- I fixed the typos from the document: \"the the\", \"th\u001b[57Gre stall\", \"Pedestrains\",\u001b[83G\"helth\",\u001b[92G\"volunter\".\r\u001b[6C\u001b[1Bread the boreholes da\u001b[29Ge \"2062\" as 2026.\u001b[47G\u001b[K\r\u001b[6C\u001b[1Bl\u001b[9Gft\u001b[12Gout\u001b[16G\"Youth burs\u001b[28Gries: applications\u001b[47Gopen\"\u001b[53Gbecause\u001b[61Git\u001b[64Gbreaks\u001b[71Goff\u001b[75Gmid-sentence.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[43G\u001b[22mmy\u001b[46Gfirst\u001b[52G\u001b[38;2;177;185;249mextension:setup\u001b[68G\u001b[39mrun\u001b[72Gcreated\u001b[80Ga\u001b[82Gsecond\u001b[89Gcopy\u001b[94Gof\u001b[97Gthe\u001b[101Gwhole\u001b[31;1H\u001b[29;3H\u001b[?25h"]
