[6654.096623, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 18 \u001b[22m `Initialisation/Site/main/` is the site configuration that comes with it. It is\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 19 \u001b[22m copied only where no site called `main` exists, and it answers on base `/`.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 20 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 18 -\u001b[38;2;248;248;242mThe tree is not edited by hand. `Build/Initialisation/seed-page-tree.php` in the         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 19 -\u001b[38;2;248;248;242mproject writes it into an installation, and it is exported from there:                   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[11G\u001b[38;2;248;248;242mThe tre\u001b[19G is\u001b[23Gnot\u001b[27Gedited\u001b[34Gby\u001b[37Ghand.\u001b[43GTwo\u001b[47Gscripts\u001b[55Gin\u001b[58Gthe\u001b[62Gproject\u001b[70Gwrite\u001b[76Git\u001b[79Ginto\u001b[84Gan\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 22 +\u001b[38;2;248;248;242minstallation, `Build/Initialisation/seed-page-tree.php` the pages and                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 23 +\u001b[38;2;248;248;242m`Build/Initialisation/seed-news.php` the news on top of them, and it is exported         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242mfrom ther\u001b[21G:  \u001b[25G   \u001b[29G                                  \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m5\u001b[15G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 26 \u001b[22m     ddev exec php Build/Initialisation/seed-page-tree.php\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[15G\u001b[38;2;248;248;242mddev exec ph\u001b[28G Build/Initialisation/seed-news.php         \u001b[73G \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 28 \u001b[22m     ddev exec typo3 impexp:export --type=xml --pid=1 --levels=999 \\\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 23 -\u001b[38;2;248;248;242m        --table=pages --table=tt_content --\u001b[48;2;92;2;0minclude-related\u001b[48;2;61;1;0m=\u001b[48;2;92;2;0msys_file\u001b[48;2;61;1;0m \\                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 29 +\u001b[38;2;248;248;242m        --table=pages --table=tt_content --\u001b[48;2;4;71;0mtable\u001b[48;2;2;40;0m=\u001b[48;2;4;71;0msys_category\u001b[48;2;2;40;0m \\                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 30 +\u001b[38;2;248;248;242m        --table=tx_news_domain_model_news --table=tx_news_domain_model_link \\            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 31 +\u001b[38;2;248;248;242m        --table=tx_news_domain_model_tag --include-related=sys_file \\                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 32 \u001b[22m         --include-related=sys_file_reference --include-related=sys_file_metadata \\\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 33 \u001b[22m         --save-files-outside-export-file data\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 35 +\u001b[38;2;248;248;242mA table missing from that list is missing from the export without a warning.             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 36 +\u001b[38;2;248;248;242m                                                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 37 \u001b[11G\u001b[22mThe\u001b[15Gexport\u001b[22Glands\u001b[28Gin\u001b[31G`public/fileadmin/user_upload/_temp_/importexport/`;\u001b[84Gmove\r\u001b[6C\u001b[1B\u001b[2m38\u001b[11G\u001b[22m`data.xml`\u001b[22G(\u001b[24Gnd\u001b[27G`data.xml.files/`, once ther\u001b[56G are files) into `Ini\u001b[78Giali\u001b[83Gation/`.\r\u001b[6C\u001b[1B\u001b[2m39\u001b[11G\u001b[22m     \u001b[17G          \u001b[28G \u001b[30G         \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[6654.11271, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 16 +\u001b[38;2;248;248;242mlist page and the detail page. The other pages carry no content yet.                     \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m7\u001b[11G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m18\u001b[11G\u001b[22m`Initialisation/Site/main/`\u001b[39Gis\u001b[42Gthe\u001b[46Gsite\u001b[51Gconfiguration\u001b[65Gthat\u001b[70Gcomes\u001b[76Gwith\u001b[81Git.\u001b[85GIt\u001b[88Gis\r\u001b[5C\u001b[1B\u001b[2m 19 \u001b[22m copied only where no site called `main` exists, and it answers on base `/`.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 20 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 18 -\u001b[38;2;248;248;242mThe tree is not edited by hand. `Build/Initialisation/seed-page-tree.php` in the         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 19 -\u001b[38;2;248;248;242mproject writes it into an installation, and it is exported from there:                   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[11G\u001b[38;2;248;248;242mThe tree \u001b[21Gs not ed\u001b[30Gted by hand. Two scripts in the \u001b[63Gr\u001b[65Gject write it into an     \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242minstallation,\u001b[25G`Build/Initialisation/seed-page-tree.php`\u001b[67Gthe\u001b[71Gpages\u001b[77Gand\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 23 +\u001b[38;2;248;248;242m`Build/Initialisation/seed-news.php` the news on top of them, and it is exported         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 24 +\u001b[38;2;248;248;242mfrom there:                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 25 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[25G\u001b[22mph\u001b[28G Bu\u001b[32Gld/Initialisation/seed-page-tree.php\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 27