[354.75414, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 11s · done 9:32 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwill the editors be able to change the news themselves?\u001b[39m                                                 \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes.\u001b[8GThat's\u001b[15Gone\u001b[19Gof\u001b[22Gthe\u001b[26Gmain\u001b[31Greasons\u001b[39Gto\u001b[42Guse\u001b[46Gthe\u001b[50Gnews\u001b[55Gextension\u001b[65Grather\u001b[72Gthan\u001b[77Gwriting\u001b[85Gnews\u001b[90Ginto\u001b[95Gpages\u001b[101Gby\r\u001b[1B \u001b[3Ghand. A few\u001b[15Gthings\u001b[22Ghave to be set up fir\u001b[44Gt, though,\u001b[55Gand \u001b[60Gone of \u001b[70Gm\u001b[72Gexist in the\u001b[85Gproject yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors can do once it's set up:\r\u001b[2C\u001b[1B\u001b[22m- Add, edit, hide and delete news in the\u001b[44Gbackend\u001b[52G(Web\u001b[57G>\u001b[59GList\u001b[64Gon\u001b[67Ga\u001b[69G\"News\"\u001b[76Gfolder),\u001b[85Gwith\u001b[90Gtitle,\u001b[97Gdate,\r\u001b[2C\u001b[1B \u001b[5Gcategory, teas\u001b[20Gr, bo\u001b[26Gy text and\u001b[38Gmages.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSch\u001b[9Gdule news with star\u001b[29G and end tim\u001b[43G,\u001b[45Gso\u001b[48Gan\u001b[51Gentry\u001b[57Gappears\u001b[65Gor\u001b[68Gdisappears\u001b[79Gon\u001b[82Gits\u001b[86Gown.\r\u001b[4C\u001b[1BManage the categories (\"Health\",\u001b[38G\"Roads\u001b[45G& transpo\u001b[55Gt\" and so\u001b[66Gn).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Ghome\u001b[12Gpage\u001b[17Gand\u001b[21Gthe\u001b[25G\"All\u001b[30Gnews\"\u001b[36Gpage\u001b[41Gupdate\u001b[48Gby\u001b[51Gthemselves.\u001b[63GThe\u001b[67Gnewest\u001b[74Gthree\u001b[80Gentries\u001b[88Galways\u001b[95Gshow\u001b[100Gon\u001b[103Gthe\r\u001b[2C\u001b[1Bhome page without\u001b[21Ganyone touching it.\u001b[41G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat has to be set up for that to work:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mA\u001b[8Gstorage folder for news rec\u001b[36Grds.\u001b[22m Editors\u001b[49Gwork\u001b[54Gin\u001b[57Gthis\u001b[62Gfolder,\u001b[70Gand\u001b[74Gthe\u001b[78Gnews\u001b[83Gplugins\u001b[91Gon\u001b[94Gthe\u001b[98Ghome\u001b[103Gand\r\u001b[2C\u001b[1B  \u001b[6GNews pages read from it.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA backend user group for editors.\u001b[40G\u001b[22mThe\u001b[44Gproject\u001b[52Ghas\u001b[56Gno\u001b[59Geditor\u001b[66Ggroups\u001b[73Gor\u001b[76Gusers\u001b[82Gyet;\u001b[87Gthe\u001b[91Gonly\u001b[96Gaccount\u001b[104Gis\r\u001b[2C\u001b[1B  \u001b[6Gthe admin you install with. The group\u001b[44Gneeds:\u001b[K\r\u001b[5C\u001b[1B- access to the News folder\u001b[34Gand\u001b[38Gth\u001b[31;1H\u001b[29;3H\u001b[?25h"]
