[6649.91334, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5G- use\u001b[11Gth\u001b[14G Page, List and Media modules;\u001b[K\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7Gupload \u001b[15Gmages, which go to \u001b[38;2;177;185;249mfileadmin/user_upload/news/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- They ca\u001b[15G't use\u001b[22Gth\u001b[25G raw HTML content element.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPages\u001b[11Gcreated\u001b[19Glater\u001b[25Gbelong\u001b[32Gto\u001b[35GEditors\u001b[43Gautomatically.\r\u001b[2C\u001b[1B- A text editor limited to paragraphs, two heading levels, bold, italic, lists\u001b[82Gand\u001b[86Glinks.\r\u001b[4C\u001b[1BYou only n\u001b[16Ged t\u001b[21G create the editor accounts (System > Backend users) and put them in \"Editors\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent I changed on my own\u001b[22m (the Commun\u001b[43Gcati\u001b[48Gns Offi\u001b[56Ge \u001b[59Ghould check\u001b[71Gthis)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gfixed\u001b[13Gthe\u001b[17Gtypos\u001b[23Gfrom\u001b[28Gthe\u001b[32Gdocument:\u001b[42G\"the\u001b[47Gthe\",\u001b[53G\"there\u001b[60Gstall\",\u001b[68G\"Pedestrains\",\u001b[83G\"helth\",\u001b[92G\"volunter\".\r\u001b[2C\u001b[1B- I read the boreholes date \"2062\" as 2026.\u001b[K\r\u001b[2C\u001b[1B- I left out \"Youth bursaries: applications open\" because it breaks off mid-s\u001b[81Gntence.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[22m my first \u001b[38;2;177;185;249mextension:setup\u001b[39m run created a\u001b[82Gsecond copy\u001b[94Gof\u001b[97Gthe\u001b[101Gwhole\r\u001b[2C\u001b[1Bpage\u001b[8Gtree.\u001b[14GThis\u001b[19Ginstallation\u001b[32Gwas\u001b[36Gfilled\u001b[43Gby\u001b[46Gthe\u001b[50Gseed\u001b[55Gscript,\u001b[63Gso\u001b[66Git\u001b[69Ghad\u001b[73Gnever\u001b[79Grecorded\u001b[88Gthat\u001b[93Gthe\u001b[97Gpackage's\r\u001b[2C\u001b[1Bcontent was imported.\u001b[25GI res\u001b[31Gored \u001b[37Ghe\u001b[40Gdatabase from the snapshot I took beforehand and recorded\u001b[98Gthe\r\u001b[2C\u001b[1Bimport. Now the data is clean: 29 pages, one group. The README explains how to avoid this.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things are:\u001b[22m the news templates\u001b[40Gare\u001b[44Gin\u001b[47G\u001b[38;2;177;185;249mResources/Private/Extensions/News/\u001b[39m,\u001b[83Grouting\u001b[91Gin\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mroute-enhancers.yaml\u001b[39m,\u001b[25Gthe\u001b[29Ggroup\u001b[35Gin\u001b[38G\u001b[38;2;177;185;249mClasses/Initialization/CreateEditorGroupOnPackageInitialization.php\u001b[39m,\r\u001b[2C\u001b[1Band the seed script is \u001b[38;2;177;185;249mBuild/Initialisation/seed-news.php\u001b[39m. The updated \u001b[38;2;177;185;249mdata.xml\u001b[39m export includes all \u001b[104Ghe\r\u001b[2C\u001b[1Bnews tables. Nothing is committed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done yet: the test on a fresh installation.\u001b[22m It's the only proof that the package works on an empty\u001b[K\r\u001b[2C\u001b[1Binstallation, and that te\u001b[29Gt\u001b[31Gwas blocked. The test ne\u001b[57Gs th\u001b[62G d\u001b[65Gtabase dropped \u001b[81Gnd \u001b[38;2;177;185;249mtypo3 setup\u001b[96G\u001b[39mrun from\r\u001b[2C\u001b[1Bscrat\u001b[10G. I've already saved a\u001b[33Gd\u001b[35Gtabas\u001b[69Gopies of \u001b[38;2;177;185;249msettings.php\u001b[39m and \u001b[38;2;177;185;249mconfig/sites\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[6649.929653, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Btemporary\u001b[15Gtest user (delet\u001b[33G \u001b[35Gfterwards).\u001b[47GThey\u001b[52Gcan:\r\u001b[6C\u001b[1Bedit pages, content,\u001b[28Gnews and categories on every page;\r\u001b[6C\u001b[1Bus\u001b[10G the Page, List\u001b[26Gand\u001b[30GMedia modules;\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- upload images, which go to \u001b[38;2;177;185;249mfileadmin/user_upload/news/\u001b[39m.\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7GThey\u001b[12Gcan't use th\u001b[25G raw\u001b[30GHTML content elem\u001b[48Gnt.\u001b[K\r\u001b[4C\u001b[1BPages creat\u001b[19Glate\u001b[24G belong to Editors a\u001b[45Gtomatically.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gtext\u001b[12Geditor\u001b[19Glimited\u001b[27Gto\u001b[30Gparagraphs,\u001b[42Gtwo\u001b[46Gheading\u001b[54Glevels,\u001b[62Gbold,\u001b[68Gitalic,\u001b[76Glists\u001b[82Gand\u001b[86Glinks.\r\u001b[2C\u001b[1B- You only need to create the edit\u001b[38Gr accounts (System > Backend users) and\u001b[78Gput\u001b[82Gthem\u001b[87Gin\u001b[90G\"Editors\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent I changed on my own\u001b[31G\u001b[22m(the Communications\u001b[51GOffice\u001b[58Gshould\u001b[65Gcheck\u001b[71Gthis)\r\u001b[6C\u001b[1Bfixed the typos\u001b[23Gfrom th\u001b[31G document: \"the\u001b[47Gth\u001b[50G\",\u001b[53G\"there stall\", \"Pedestrain\u001b[80G\", \"helth\",\u001b[92G\"volunter\".\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gread\u001b[12Gthe\u001b[16Gboreholes\u001b[26Gdate\u001b[31G\"2062\"\u001b[38Gas 2026.\r\u001b[2C\u001b[1B- I left out \"Youth bursaries: applications open\" because it breaks off mid-sent\u001b[84Gnce.\u001b[89G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[22m my first \u001b[38;2;177;185;249mextension:setup\u001b[39m run created a seco\u001b[89Gcopy of the whole\r\u001b[2C\u001b[1Bpage \u001b[9Gree. This\u001b[19Ginstallation was fill\u001b[41Gd by the seed\u001b[55Gscript, so\u001b[66Git h\u001b[71Gd never\u001b[79Grecorde\u001b[90Gat the\u001b[97Gpackage's\r\u001b[2C\u001b[1Bcontent\u001b[11Gwas\u001b[15Gimported.\u001b[25GI\u001b[27Grestored\u001b[36Gthe\u001b[40Gdatabase\u001b[49Gfrom\u001b[54Gthe\u001b[58Gsnapshot\u001b[67GI\u001b[69Gtook\u001b[74Gbeforehand\u001b[85Gand\u001b[89Grecorded\u001b[98Gthe\r\u001b[2C\u001b[1Bimport. Now the da\u001b[22Ga is clean: 29 pages,\u001b[44Go\u001b[46Ge group. The README explains how to av\u001b[85Gid this.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things are:\u001b[22m \u001b[22Ghe news templates are in \u001b[38;2;177;185;249mR\u001b[49Gsource\u001b[56G/Private/Extensions/News/\u001b[39m,\u001b[83Grouting in\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mroute-enhancers.yaml\u001b[39m, the group in\u001b[38G\u001b[38;2;177;185;249mClasses/Initialization/CreateEditorGroupOnPackageInitialization.php\u001b[39m,\r\u001b[2C\u001b[1Band\u001b[7Gthe\u001b[11Gseed\u001b[16Gscript\u001b[23Gis\u001b[26G\u001b[38;2;177;185;249mBuild/Initialisation/seed-news.php\u001b[39m.\u001b[62GThe\u001b[66Gupdated\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[83G\u001b[39mexport\u001b[90Gincludes\u001b[99Gall\u001b[103Gthe\r\u001b[2C\u001b[1Bnews tables. Nothing is committed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done yet: the test on a fresh ins\u001b[69G\u001b[22mf that the package works on an empty\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[6650.206284, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5GA backend\u001b[15Ggroup calle\u001b[27G \"Editors\", created\u001b[47Gautomatically\u001b[61Gwhen\u001b[66Gthe\u001b[70Gpackage\u001b[78Gis\u001b[81Gset\u001b[85Gup.\u001b[89GI\u001b[91Gchecked\u001b[99Gwith\u001b[104Ga\r\u001b[4C\u001b[1Btemporary test user (del\u001b[30Gted afterwards). They can:\u001b[57G\u001b[K\r\u001b[6C\u001b[1Bedit pages, content, news and categories\u001b[48Gon\u001b[51Gevery\u001b[57Gpage;\r\u001b[7C\u001b[1Bse the P\u001b[19G, List and Media modules;\u001b[K\r\u001b[6C\u001b[1Bupload image\u001b[20G,\u001b[22Gw\u001b[24Gich go to \u001b[38;2;177;185;249mfileadmin/user_upload/news/\u001b[39m.\r\u001b[2C\u001b[1B \u001b[5G- They can't use the raw HTML\u001b[35Gcon\u001b[39Gent\u001b[43Gelemen\u001b[50G.\u001b[K\r\u001b[4C\u001b[1BPag\u001b[9Gs crea\u001b[16Ged\u001b[20Gater bel\u001b[29Gng to Editors autom\u001b[49Gt\u001b[51Gcal\u001b[55Gy.\u001b[K\r\u001b[4C\u001b[1BA text editor\u001b[19Glimit\u001b[25Gd to paragraphs, two heading levels, bol\u001b[66G, italic, lists\u001b[82Gand l\u001b[89Gks.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou\u001b[9Gonly\u001b[14Gneed\u001b[19Gto\u001b[22Gcreate\u001b[29Gthe\u001b[33Geditor\u001b[40Gaccounts\u001b[49G(System\u001b[57G>\u001b[59GBackend\u001b[67Gusers)\u001b[74Gand\u001b[78Gput\u001b[82Gthem\u001b[87Gin\u001b[90G\"Editors\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent I changed on my own\u001b[22m (the Communications Offic\u001b[57G should check this)\u001b[K\r\u001b[6C\u001b[1Bfixed the typos from \u001b[29Ghe document: \"the\u001b[47Gthe\",\u001b[53G\"there\u001b[60Gstall\",\u001b[68G\"Pedestrains\",\u001b[83G\"helth\",\u001b[92G\"volunter\".\r\u001b[6C\u001b[1Br\u001b[9Gad\u001b[12Gthe\u001b[16Gboreholes d\u001b[28Gte \"2062\" as 2026.\u001b[47G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gleft\u001b[12Gout\u001b[16G\"Youth\u001b[23Gbursaries:\u001b[34Gapplications\u001b[47Gopen\"\u001b[53Gbecause\u001b[61Git\u001b[64Gbreaks\u001b[71Goff\u001b[75Gmid-sentence.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSomething to know on this installation:\u001b[43G\u001b[22mm\u001b[46Gfirst \u001b[38;2;177;185;249mextension:setup\u001b[39m run cr\u001b[75Gated a second copy of\u001b[97Gthe whole\r\u001b[2C\u001b[1Bpage tree. This installation was\u001b[36Gfilled by the seed script, s\u001b[65G it\u001b[69Ghad never recorded that th\u001b[96G package's\r\u001b[2C\u001b[1Bcontent\u001b[11Gwas\u001b[15Gimported. I\u001b[27Grestored the database from the snapshot I took beforehand and recorded\u001b[98Gthe\r\u001b[2C\u001b[1Bimport.\u001b[11GNow\u001b[15Gthe\u001b[19Gdata\u001b[24Gis\u001b[27Gclean:\u001b[34G29\u001b[37Gpages,\u001b[44Gone\u001b[48Ggroup.\u001b[55GThe\u001b[59GREADME\u001b[66Gexplains\u001b[75Ghow\u001b[79Gto\u001b[82Gavoid\u001b[88Gthis.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things are:\u001b[22m the\u001b[25Gnews tem\u001b[34Glates are in \u001b[38;2;177;185;249mResources/Privat\u001b[64G/Extensions/News/\u001b[39m, routing in\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mroute-enhancers.yaml\u001b[39m, the group in \u001b[38;2;177;185;249mClasses/Initialization/CreateEditorGroupOnPackageInitialization.php\u001b[39m,\r\u001b[2C\u001b[1Band the s\u001b[13Ged\u001b[16Gscript is \u001b[38;2;177;185;249mBuild/Initialisation/seed-news.php\u001b[39m.\u001b[62GThe\u001b[66Gupdated\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[83G\u001b[39mexport\u001b[90Gincludes\u001b[99Gall\u001b[103Gthe\r\u001b[2C\u001b[1Bnews\u001b[8Gtables.\u001b[16GNothing\u001b[24Gis\u001b[27Gcommitted.\r\u001b[2C\u001b[1B                                     \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
