[256.227204, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mIt settles events cheaply.\u001b[33G\u001b[22mOnce\u001b[38Gnews\u001b[43Gis\u001b[46Grunning,\u001b[55Gyou\u001b[59Gcan\u001b[63Gsee\u001b[67Gwhether\u001b[75Gnews\u001b[80Grecords\u001b[88Gin\u001b[91Gan\u001b[94G\"Events\"\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[256.379093, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 42s · done 9:29 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mYou want the empty home page to show the design's slider, service tiles, news, events and \r\u001b[2C\u001b[1Bnewsletter sign-up, and I've worked out what each one needs. Next, I'd build the slider content element,\r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3monce you say go\u001b[19Gand\u001b[23Gdecide who\u001b[34Gsends the newsl\u001b[50Gtt\u001b[53Gr. (turn off recaps in\u001b[76G/config)\u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThat sounds like a lot. What should I start with, and why?\u001b[39m                                              \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m I'd start with \u001b[1mNews\u001b[22m.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mWhy news first:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mIt's mostly installing, not building.\u001b[44G\u001b[22m\u001b[38;2;177;185;249mgeorgringer/news\u001b[61G\u001b[39malready\u001b[69Gsupports\u001b[78GTYPO3\u001b[84G14.3,\u001b[90Gso\u001b[93Gthere's\u001b[101Gno\u001b[104GTCA\r\u001b[5C\u001b[1Bor\u001b[9GJavaScript\u001b[20Gto\u001b[23Gwrite.\u001b[30GYou\u001b[34Ginstall\u001b[42Git,\u001b[46Gadd\u001b[50Ga\u001b[52GNews\u001b[57Gpage\u001b[62Gand\u001b[66Ga\u001b[68Gdetail\u001b[75Gpage,\u001b[81Gand\u001b[85Gwrite\u001b[91Gtemplates\u001b[101Gthat\r\u001b[2C\u001b[1B  \u001b[6Goutput the design's \u001b[38;2;177;185;249m.card\u001b[39m markup. The\u001b[44Gslider and tiles\u001b[61Geach need a new content element\u001b[93Gwith its \u001b[103Gwn\u001b[K\r\u001b[5C\u001b[1Bfields and templates, which\u001b[35Gs more\u001b[42Gcode.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mIt's the most real content.\u001b[22m The news and events document is\u001b[66Gth\u001b[69G m\u001b[72Gi\u001b[74G thing the\u001b[85Gmunicipal\u001b[96Gy\u001b[98Gkeeps\u001b[K\r\u001b[5C\u001b[1Bupdated, and it's the\u001b[28Gpart of the home page\u001b[50Gthat\u001b[55Gchanges\u001b[63Gevery\u001b[69Gweek.\u001b[75GThe\u001b[79Gslider\u001b[86Gand\u001b[90Gtiles\u001b[96Gare\u001b[100Ga\u001b[102Gfew\r\u001b[2C\u001b[1B  \u001b[6Gfixed entries that rarely change.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mIt starts the content cleanup early.\u001b[22m The document \u001b[58Gs typos, a\u001b[69Gdate set in 2062\u001b[90Ga mi\u001b[95Gsing\u001b[100Gteaser.\r\u001b[5C\u001b[1BSom\u001b[10Gon\u001b[13G at the municipa\u001b[30Gity has to\u001b[41Gfix\u001b[45Gthose.\u001b[52GIf\u001b[55Gnews\u001b[60Ggoes\u001b[65Gfirst,\u001b[72Gthat\u001b[77Greview\u001b[84Gcan\u001b[88Ghappen\u001b[95Gwhile\u001b[101Gyou\r\u001b[2C\u001b[1B  \u001b[6Gbuild the other sections.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mIt settles events cheaply.\u001b[22m Once\u001b[38Gnews is running,\u001b[55Gyou can \u001b[64Gee whether news r\u001b[82Gcords\u001b[88Gin an \"Events\"\u001b[K\r\u001b[5C\u001b[1Bcategory are good enough before\u001b[38Gyou\u001b[42Gbuild\u001b[48Ga\u001b[50Gseparate\u001b[59Gevent\u001b[65Grecord.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[256.773444, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mOther parts link to it.\u001b[30G\u001b[22mThe\u001b[34Ghome\u001b[39Gpage's\u001b[46G\"All\u001b[51Gnews\"\u001b[57Glink\u001b[62Gand\u001b[66Gthe\u001b[70G\"See\u001b[75Gthe\u001b[79Gforum\u001b[85Gdates\"\u001b[92Gslide\u001b[98Gneed\u001b[103Gnews\u001b[31;1H\u001b[29;3H\u001b[?25h"]
