[336.225172, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BThe home\u001b[12Gpage a\u001b[19Gd\u001b[22Ghe\u001b[25G\"All\u001b[30Gnews\"\u001b[36Gpage\u001b[41Gupdate\u001b[48Gby\u001b[51Gthemselves.\u001b[63GThe\u001b[67Gnewest\u001b[74Gthree\u001b[80Gentries\u001b[88Galways\u001b[95Gshow\u001b[100Gon\u001b[103Gthe\r\u001b[2C\u001b[1Bhome\u001b[8Gpage\u001b[13Gwithout\u001b[21Ganyone\u001b[28Gtouching\u001b[37Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat has to be set up for that to work:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mA storage folder for news records.\u001b[22m Editors work\u001b[55Gn this\u001b[62Gf\u001b[64Glder,\u001b[70Gand th\u001b[77G new\u001b[83Gplugins \u001b[92Gn \u001b[95Ghe home\u001b[103Gand\r\u001b[2C\u001b[1B   News\u001b[11Gpages\u001b[17Gread\u001b[22Gfrom\u001b[27Git.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA backend user group for editors.\u001b[40G\u001b[22mThe\u001b[44Gproject\u001b[52Ghas\u001b[56Gno\u001b[59Geditor\u001b[66Ggroups\u001b[73Gor\u001b[76Gusers\u001b[82Gyet;\u001b[87Gthe\u001b[91Gonly\u001b[96Gaccount\u001b[104Gis\r\u001b[2C\u001b[1B   the admin you\u001b[20Ginstall with. The group needs:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G - access to\u001b[18Gthe\u001b[22GNews\u001b[27Gfolder\u001b[34Gand\u001b[38Gthe\u001b[42Gcontent\u001b[50Gpages\r\u001b[5C\u001b[1B-\u001b[8Gpermission\u001b[19Gto\u001b[22Gedit\u001b[27Gthe\u001b[31Gnews\u001b[36Gand\u001b[40Gcategory\u001b[49Gtables\r\u001b[2C\u001b[1B   - a\u001b[10Gfil\u001b[14G mount for news images, so\u001b[41Gthey can't upload anywhere \u001b[69Gls\u001b[73G\u001b[K\r\u001b[2C\u001b[1B3. \u001b[1mReadable URLs.\u001b[22m The site \u001b[31Gas no route configur\u001b[53Gion y\u001b[59Gt, \u001b[63Go a news \u001b[73Getail\u001b[79Gpage\u001b[84Gwould\u001b[90Gget\u001b[94Ga\u001b[96Glink\u001b[101Glike\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249m?tx_news_pi1[news]=12\u001b[39m.\u001b[29GA\u001b[31Groute\u001b[37Genhancer\u001b[46Gturns\u001b[52Gthat\u001b[57Ginto\u001b[62G\u001b[38;2;177;185;249m/news/new-fish-market-opens-at-the-jetty\u001b[39m.\r\u001b[1B \u001b[3G4. \u001b[1mA restricted text editor (RTE).\u001b[38G\u001b[22mThe\u001b[42Gbody\u001b[47Gtext\u001b[52Geditor\u001b[59Gshould\u001b[66Gonly\u001b[71Goffer\u001b[77Gthe\u001b[81Gformatting\u001b[92Gthe\u001b[96Gdesign\r\u001b[5C\u001b[1Bsupports,\u001b[16Gso\u001b[19Geditors\u001b[27Gcan't\u001b[33Gpaste\u001b[39Gin\u001b[42Gstyling\u001b[50Gthat\u001b[55Gbreaks\u001b[62Gthe\u001b[66Glook.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors can't change, and shouldn't:\u001b[45G\u001b[22mthe\u001b[49Gcard\u001b[54Glayout,\u001b[62Gthe\u001b[66Gnumber\u001b[73Gof\u001b[76Gnews\u001b[81Gon\u001b[84Gthe\u001b[88Ghome\u001b[93Gpage\u001b[98Gand\u001b[102Gthe\r\u001b[1B \u001b[3Gpage structure. Those stay in the \u001b[38Gi\u001b[40Ge\u001b[42Gackage.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd set up the folder, the editor group and the URLs together with the extension,\u001b[85Gso\u001b[88Git's\u001b[93Gready\u001b[99Gfor\r\u001b[2C\u001b[1Beditors from the start. You'd only need to create the actual editor accounts. Should\u001b[88GI\u001b[90Ggo\u001b[93Gahead\u001b[99Gwith\r\u001b[2C\u001b[1Bthat?\u001b[K\r\u001b[26C\u001b[2B\u001b[38;2;153;153;153m1.0k tokens · \u001b[38;2;163;163;163mthinking\u001b[38;2;153;153;153m)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
