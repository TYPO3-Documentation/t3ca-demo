[1037.002193, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mEffort:\u001b[22m Install\u001b[19Git\u001b[22Gand\u001b[26Gadd\u001b[30Gone\u001b[34Gelement\u001b[42Gto\u001b[45Gthe\u001b[49Gform\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1mLink filter\u001b[22m in the form file\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a visitor notices:\u001b[22m Me\u001b[30Gsages containi\u001b[45Gg\u001b[47G\u001b[38;2;177;185;249mhttp\u001b[39m or \u001b[38;2;177;185;249mwww\u001b[39m are rejected\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPrivacy:\u001b[22m None\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEffort:\u001b[22m A few lines of YAML; also blocks real people who paste a link\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[11GRate limit\u001b[22G\u001b[22mper\u001b[26GIP\u001b[29Gaddress\r\u001b[2C\u001b[1B\u001b[1mWhat a visitor notices:\u001b[22m Too many submissions\u001b[48Gin\u001b[51Ga\u001b[53Gshort\u001b[59Gtime\u001b[64Gare\u001b[68Grefused\r\u001b[2C\u001b[1B\u001b[1mPrivacy:\u001b[22m H\u001b[14Gndles IP addresses,\u001b[34Gwhi\u001b[38Gh n\u001b[42Geds\u001b[46Ga mention in the privacy\u001b[71Gpolicy\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEffort:\u001b[22m Custom\u001b[18Gcode\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1mHosted CAPTCHA\u001b[26G\u001b[22m(Frie\u001b[32Gdly Captcha, captcha.eu, mosparo, TrustCaptcha)\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a visitor notices:\u001b[22m Mostly invisible\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPrivacy:\u001b[22m Data goes to an outside servic\u001b[45Gwhich needs\u001b[57Ga \u001b[60Groce\u001b[65Gsing agreement and policy\u001b[91Gtext;\u001b[97Gmosparo\r\u001b[4C\u001b[1Bcan\u001b[9Gbe\u001b[12Ghosted\u001b[19Gyourself\r\u001b[2C\u001b[1B\u001b[1mEffort:\u001b[22m Extension\u001b[21Gplus account or own server\u001b[48G\u0