[801.870685, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mHeading style:\u001b[20G\u001b[22mthe\u001b[24G\"Write\u001b[31Gto\u001b[34Gus\"\u001b[38Gsubheader\u001b[48Gshows\u001b[54Gas\u001b[57Gan\u001b[60G\u001b[38;2;177;185;249m<h3>\u001b[39m,\u001b[66Gwhile\u001b[72Gthe\u001b[76Gdesign\u001b[83Ghas\u001b[87Ga\u001b[89Glead\u001b[94Gparagraph\r\u001b[4C\u001b[1Bthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gwant\u001b[15Gto\u001b[18Gcommit,\u001b[26Gsay\u001b[30Gso\u001b[33Gand\u001b[37GI'll\u001b[42Gshow\u001b[47Gyou\u001b[51Gthe\u001b[55Gcommit\u001b[62Gmessage\u001b[70Gfirst.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 6m 32s · done 6:41 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhere3 can I see the mail?\u001b[39m                                                                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1BRan\u001b[7G\u001b[1m1\u001b[9G\u001b[22mshell\u001b[15Gcommand\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gmails\u001b[13Gare\u001b[17Gin\u001b[20GMailpit,\u001b[29Gwhich\u001b[35GDDEV\u001b[40Gruns\u001b[45Galongside\u001b[55Gthe\u001b[59Gsite:\u001b[65G\u001b]8;id=1ubqeku;https://demo.ddev.site:8026\u0007\u001b[94m\u001b[1mhttps://demo.ddev.site:8026\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1BYou\u001b[7Gcan\u001b[11Galso\u001b[16Gopen\u001b[21Git\u001b[24Gfrom\u001b[29Gthe\u001b[33Gterminal\u001b[42Gwith\u001b[47G\u001b[38;2;177;185;249mddev mailpit\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDDEV catches\u001b[16Gevery\u001b[22Gmail\u001b[27Gthe\u001b[31Gsite\u001b[36Gsends,\u001b[43Gso\u001b[46Gnothing\u001b[54Ggoes\u001b[59Gto\u001b[62Ga\u001b[64Greal\u001b[69Gaddress.\u001b[78GYou'll\u001b[85Gfind\u001b[90Gmy\u001b[93Gtest\u001b[98Gmessages\r\u001b[2C\u001b[1Bthere:\u001b[K\r\u001