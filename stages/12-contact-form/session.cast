[870.933985, "o", "\u001b[?25l\u001b[H\u001b[3Gmunicipality\u001b[16Gsends\u001b[22Git\u001b[25Gfor\u001b[29Gthem,\u001b[35Gfrom\u001b[40Gits\u001b[44Gown\u001b[48Gdomain.\u001b[56GThat\u001b[61Ghurts\u001b[67Gthe\u001b[71Gmunicipality's\u001b[86Gmail\u001b[91Greputation,\u001b[103Gso\r\u001b[1B \u001b[3Gits\u001b[7Grea\u001b[11G m\u001b[14Gils start landing in\u001b[35Gspam\u001b[40Gfolders. The honeypot only stops simple bots, and nothing\u001b[98Glimits\r\u001b[2C\u001b[1Bhow\u001b[7Goften\u001b[13Gthe\u001b[17Gform\u001b[22Gcan\u001b[26Gbe\u001b[29Gsent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's already fine:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTampered submissions:\u001b[27G\u001b[22mEXT:form\u001b[37Gign\u001b[41G the\u001b[46Gf\u001b[48Grm's hidden st\u001b[63Gte \u001b[67Gnd the list \u001b[80Gf a\u001b[84Glowe\u001b[90Gfield\u001b[96G,\u001b[98Gso a\u001b[K\r\u001b[2C\u001b[1B  modified\u001b[14Gsubmission\u001b[25Gis\u001b[28Grejected.\r\u001b[4C\u001b[1B\u001b[1mInjected\u001b[14Gma\u001b[17Gkup:\u001b[22m the mail te\u001b[34Gplates\u001b[41Gescap\u001b[48Geverything the\u001b[63Gvisitor\u001b[71Genters.\u001b[79GAll\u001b[83Gaddresses\u001b[93Gpass\u001b[98Gan\u001b[101Gemail\r\u001b[2C\u001b[1B \u001b[5Gcheck before they reach the mailer.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLength limits:\u001b[20G\u001b[22mname\u001b[25Gis\u001b[28Gcapped\u001b[35Gat\u001b[38G200\u001b[42Gcharacters\u001b[53Gand\u001b[57Gthe\u001b[61Gmessage\u001b[69Gat\u001b[72G5,000.\u001b[79GThere's\u001b[87Gno\u001b[90Gfile\u001b[95Gupload,\u001b[103Gso\r\u001b[2C\u001b[1B  nothing lands on the server.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpam bots:\u001b[16G\u001b[22mthe\u001b[20Ghoneypot\u001b[29Gcatches\u001b[37Gsimple\u001b[44Gones.\r\u001b[2C\u001b[1B- \u001b[1mCookies:\u001b[22m l\u001b[16Gading th\u001b[25G pag\u001b[30G sets none,\u001b[43Go the form\u001b[54Gneeds no cookie banner. In TYPO3 14.3 the\u001b[96Ghoneypot\u001b[105Gno\r\u001b[2C\u001b[1B  longer uses \u001b[18G session.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mData privacy\u001b[22m\u001b[K\r\u001b[2B  What's good: the form collects only what's needed, and the phone number is optional. Nothing is stored\u001b[K\r\u001b[2C\u001b[1Bin\u001b[6GTYPO3's\u001b[14Gdatabase.\u001b[24GThe\u001b[28Ghint\u001b[33Gtext\u001b[38Gasks\u001b[43Gpeople\u001b[50Gnot\u001b[54Gto\u001b[57Gsend\u001b[62GID\u001b[65Gor\u001b[68Gbank\u001b[73Gnumbers,\u001b[82Gand\u001b[86Gthe\u001b[90Gform\u001b[95Glogs\u001b[100Gno\r\u001b[1B \u001b[3Gpersonal\u001b[12Gdata.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat the municipality has to decide or write; I haven't decided\u001b[67Gany\u001b[71Gof\u001b[74Git\u001b[77Gfor\u001b[81Gthem:\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mThe copy to the visitor\u001b[22m also sends personal data to whatever address was typed. One typo and a\u001b[K\r\u001b[5C\u001b[1Bstranger gets the message.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mLegal basis:\u001b[19G\u001b[22manswering\u001b[29Ga\u001b[31Gcitizen's\u001b[41Gmessage\u001b[49Gis\u001b[52Gprobably\u001b[61Gpart\u001b[66Gof\u001b[69Gthe\u001b[73Gmunicipality's\u001b[88Gpublic\u001b[95Gtask,\u001b[101Gnot\r\u001b[1B \u001b[3G   something that needs consent. If so, the \"I agree…\"\u001b[58Gcheckbox\u001b[67Gmay\u001b[71Gbe\u001b[74Gthe\u001b[78Gwrong\u001b[84Gtool\u001b[89Gand\u001b[93Gcould\u001b[99Gbecome\u001b[106Ga\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[871.074869, "o", "\u001b[?25l\u001b[H\u001b[3Gits real mail\u001b[17G start landing in\u001b[35Gspa\u001b[40Gfolders. The honeypot only\u001b[67Gstops s\u001b[75Gmple bots,\u001b[86Gand nothing limit\u001b[104G\u001b[K\r\u001b[2C\u001b[1Bhow\u001b[7Goften the form can be sent.\u001b[35G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's already fine:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTampered submissions:\u001b[27G\u001b[22mEXT:form\u001b[36Gsigns\u001b[42Gthe\u001b[46Gform's\u001b[53Ghidden\u001b[60Gstate\u001b[66Gand\u001b[70Gthe\u001b[74Glist\u001b[79Gof\u001b[82Gallowed\u001b[90Gfields,\u001b[98Gso\u001b[101Ga\r\u001b[2C\u001b[1B \u001b[5Gmodified submission is rejected.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInjected markup:\u001b[22m the mail templates\u001b[41Gescape\u001b[48Geverything\u001b[59Gthe\u001b[63Gvisitor\u001b[71Genters.\u001b[79GAll\u001b[83Gaddresses\u001b[93Gpass\u001b[98Gan\u001b[101Gemail\r\u001b[2C\u001b[1B \u001b[5Gcheck before they r\u001b[25Gach the \u001b[34Gailer.\u001b[41G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLength limits:\u001b[22m name is capped at 200\u001b[42Gcharacters\u001b[53Gand\u001b[57Gthe\u001b[61Gmessage\u001b[69Gat\u001b[72G5,000.\u001b[79GThere's\u001b[87Gno\u001b[90Gfile\u001b[95Gupload,\u001b[103Gso\r\u001b[2C\u001b[1B \u001b[5Gnothing lands o\u001b[21G the \u001b[27Gerver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpam bots:\u001b[22m the honeypot catches\u001b[37Gsimple\u001b[44Gones.\r\u001b[4C\u001b[1B\u001b[1mCookies:\u001b[22m loading the page sets none, so the form\u001b[54Gneeds\u001b[60Gno\u001b[63Gcookie\u001b[70Gbanner.\u001b[78GIn\u001b[81GTYPO3\u001b[87G14.3\u001b[92Gthe\u001b[96Ghoneypot\u001b[105Gno\r\u001b[2C\u001b[1B \u001b[5Glonger uses a session.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mData privacy\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BWhat's\u001b[10Ggood:\u001b[16Gthe\u001b[20Gform\u001b[25Gcollects\u001b[34Gonly\u001b[39Gwhat's\u001b[46Gneeded,\u001b[54Gand\u001b[58Gthe\u001b[62Gphone\u001b[68Gnumber\u001b[75Gis\u001b[78Goptional.\u001b[88GNothing\u001b[96Gis\u001b[99Gstored\r\u001b[2C\u001b[1Bin TYPO3's da\u001b[17Gabase. The hin\u001b[32G text asks peopl\u001b[49G not\u001b[54Gto send\u001b[62GID or\u001b[68Gbank numbers, a\u001b[84Gd the form logs n\u001b[102G\u001b[K\r\u001b[2C\u001b[1Bpersonal dat\u001b[16G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat\u001b[8Gthe\u001b[12Gmunicipality\u001b[25Ghas\u001b[29Gto\u001b[32Gdecide\u001b[39Gor\u001b[42Gwrite;\u001b[49GI\u001b[51Ghaven't\u001b[59Gdecided\u001b[67Gany\u001b[71Gof\u001b[74Git\u001b[77Gfor\u001b[81Gthem:\r\u001b[2C\u001b[1B1. \u001b[1mThe copy to the visitor\u001b[22m also sends pe\u001b[44Gsonal data to whatev\u001b[65Gr\u001b[68Gddress was typed. One\u001b[90Gtypo\u001b[95Gand\u001b[99Ga\r\u001b[2C\u001b[1B  \u001b[6Gstranger gets the message.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mLegal basis:\u001b[22m answering a citizen's\u001b[41Gmessage\u001b[49Gis\u001b[52Gprobably\u001b[61Gpart\u001b[66Gof\u001b[69Gthe\u001b[73Gmunicipality's\u001b[88Gpublic\u001b[95Gtask,\u001b[101Gnot\r\u001b[2C\u001b[1B  \u001b[6Gsomething that ne\u001b[24Gds consen\u001b[34G. If \u001b[40Go, the \"I agree…\" checkbox may be the wrong tool and \u001b[94Gould bec\u001b[103Gme\u001b[106Ga\r\u001b[6C\u001b[1Bhor\u001b[11G notice inst\u001b[24Gad. Which law applies depends on the deploy\u001b[68Gent, for example Keny\u001b[90G's\u001b[93GData\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[871.374487, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's already fine:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTampered submissions:\u001b[27G\u001b[22mEXT:form\u001b[36Gsigns\u001b[42Gthe\u001b[46Gform's\u001b[53Ghidden\u001b[60Gstate\u001b[66Gand\u001b[70Gthe\u001b[74Glist\u001b[79Gof\u001b[82Gallowed\u001b[90Gfields,\u001b[98Gso\u001b[101Ga\r\u001b[2C\u001b[1B  modified submission\u001b[25Gis\u001b[28Grejected.\r\u001b[4C\u001b[1B\u001b[1mInject\u001b[14Gmarkup:\u001b[22m the mail templates escape everything the visitor enter\u001b[77G.\u001b[79GAll addr\u001b[88Gsses pa\u001b[96Gs\u001b[98Gan\u001b[101Gemail\r\u001b[4C\u001b[1Bcheck before they reach th\u001b[32G mailer.\r\u001b[4C\u001b[1B\u001b[1mLength li\u001b[15Gits:\u001b[22m name is capp\u001b[33Gd at 200 ch\u001b[45Gracters and the message at 5,000\u001b[79GThere's no file upload, so\u001b[K\r\u001b[4C\u001b[1Bnothing lands on th\u001b[25G server.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam bots:\u001b[22m the\u001b[20Ghon\u001b[24Gypot catches simple ones.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCookies:\u001b[22m loading\u001b[26Gpage sets\u001b[36Gnone,\u001b[42Gso\u001b[45Gthe\u001b[49Gform\u001b[54Gneeds\u001b[60Gno\u001b[63Gcookie\u001b[70Gbanner.\u001b[78GIn\u001b[81GTYPO3\u001b[87G14.3\u001b[92Gthe\u001b[96Ghoneypot\u001b[105Gno\r\u001b[2C\u001b[1B \u001b[5Glonger uses a session.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mData privacy\u001b[22m\u001b[K\r\u001b[2C\u001b[2BWhat's good:\u001b[16Gthe\u001b[20Gform\u001b[25Gcollects\u001b[34Gonly\u001b[39Gwhat's\u001b[46Gneeded,\u001b[54Gand\u001b[58Gthe\u001b[62Gphone\u001b[68Gnumber\u001b[75Gis\u001b[78Goptional.\u001b[88GNothing\u001b[96Gis\u001b[99Gstored\r\u001b[2C\u001b[1Bin\u001b[6GTYPO3's\u001b[14Gdatabase.\u001b[24GThe\u001b[28Ghint\u001b[33Gtext\u001b[38Gasks\u001b[43Gpeople\u001b[50Gnot\u001b[54Gto\u001b[57Gsend\u001b[62GID\u001b[65Gor\u001b[68Gbank\u001b[73Gnumbers,\