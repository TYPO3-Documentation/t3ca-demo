[801.842124, "o", "\u001b[?25l\u001b[H\u001b[5Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you want to commit,\u001b[26Gsay so and\u001b[37GI'll show you th\u001b[54G commi\u001b[61G me\u001b[65Gsage first.\u001b[77G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 6m 32s · done 6:41 PM\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhere3 can I see the mail?\u001b[39m                                                                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1BRan \u001b[1m1\u001b[22m shell\u001b[15Gcommand\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe mails a\u001b[15Ge in Mailpit,\u001b[29Gwhich DDEV\u001b[40Gruns\u001b[45Galongside\u001b[55Gthe\u001b[59Gsite:\u001b[65G\u001b]8;id=1ubqeku;https://demo.ddev.site:8026\u0007\u001b[94m\u001b[1mhttps://demo.ddev.site:8026\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1BYou can also\u001b[16Gopen\u001b[21Git\u001b[24Gfrom\u001b[29Gthe\u001b[33Gterminal\u001b[42Gwith\u001b[47G\u001b[38;2;177;185;249mddev mailpit\u001b[39m.\r\u001b[2C\u001b[2BDDEV catches every mail the site sends, s\u001b[45G nothing goes to\u001b[62Ga re\u001b[67Gl add\u001b[73Gess.\u001b[78GYou'll\u001b[85Gfind\u001b[90Gmy\u001b[93Gtest\u001b[98Gmessages\r\u001b[2C\u001b[1Bthere:\r\u001b[1B \u001b[3G- \u001b[1m\"Contact form: Health\"\u001b[22m: the message\u001b[41Gto\u001b[44Gthe\u001b[48Gmunicipality.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\"Your message to Mto Safi Municipality\"\u001b[22m:\u001b[46Gthe\u001b[50Gcopy\u001b[55Gfor\u001b[59Gthe\u001b[63Gvisitor.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMailpit\u001b[11Ghas\u001b[15Gan\u001b[18GHTML\u001b[23Gand\u001b[27Ga\u001b[29Gplain-text\u001b[40Gtab\u001b[44Gfor\u001b[48Geach\u001b[53Gmail,\u001b[59Gso\u001b[62Gyou\u001b[66Gcan\u001b[70Gcheck\u001b[76Gboth\u001b[81Gversions.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne correction to my earlier note: the sitepackage README says \u001b[38;2;177;185;249mddev launch -m\u001b[39m, but\u001b[86Gthis DDEV\u001b[96Gversion\u001b[K\r\u001b[2C\u001b[1Bnames the\u001b[13Gcommand\u001b[21G\u001b[38;2;177;185;249mddev mailpit\u001b[39m.\u001b[35GI\u001b[37Gcan\u001b[41Gfix\u001b[45Gthat\u001b[50Gline\u001b[55Gif\u001b[58Gyou\u001b[62Glike.\r\u001b[4C\u001b[2B\u001b[38;2;235;159;127mnif\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
