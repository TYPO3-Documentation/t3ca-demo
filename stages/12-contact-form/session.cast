[946.427178, "o", "\u001b[?25l\u001b[H\u001b[3G4.\u001b[6G\u001b[1mRetention:\u001b[17G\u001b[22mthe\u001b[21Gonly\u001b[26Gcopy of each\u001b[39Gmessag\u001b[47Glives in the \u001b[38;2;177;185;249minfo@\u001b[39m mailbox, so\u001b[78Ghow long it's kept \u001b[98Gs se\u001b[103G by\r\u001b[2C\u001b[1B  \u001b[6Gthe municipality's\u001b[25Gmail po\u001b[33Gicy.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mMail transport on production:\u001b[22m use an SMTP server\u001b[55Gwith TLS, and sender records\u001b[84G(SPF/DKIM)\u001b[95Gfor\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mmtosafi.example\u001b[39m. DDEV only uses Mailpit.\u001b[47G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BRemove\u001b[10Gthe\u001b[14Gcopy\u001b[19Gto\u001b[22Gthe\u001b[26Gvisitor.\u001b[35GThe\u001b[39Gthank-you\u001b[49Gmessage\u001b[57Gon\u001b[60Gthe\u001b[64Gpage\u001b[69Galready\u001b[77Gconfirms\u001b[86Gthe\u001b[90Gmessage\u001b[98Gwas\u001b[102Gsent,\r\u001b[2C\u001b[1Band removing the copy\u001b[25Gfixes\u001b[31Gboth\u001b[36Gthe\u001b[40Gspam\u001b[45Gproblem\u001b[53Gand\u001b[57Gthe\u001b[61Gtypo\u001b[66Grisk.\u001b[72GIf\u001b[75Gthey\u001b[80Gwant\u001b[85Gto\u001b[88Gkeep\u001b[93Ga\u001b[95Gcopy,\u001b[101Git\r\u001b[2C\u001b[1Bshould\u001b[10Ghold\u001b[15Gonly\u001b[20Gfixed\u001b[26Gtext\u001b[31Gand\u001b[35Gnone\u001b[40Gof\u001b[43Gwhat\u001b[48Gthe\u001b[52Gvisitor\u001b[60Gentered.\u001b[69GThat\u001b[74Glimits\u001b[81Gthe\u001b[85Gabuse\u001b[91Gbut\u001b[95Gdoesn't\u001b[103Gstop\r\u001b[2C\u001b[1Bit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BS\u001b[10GI rem\u001b[16Gve it? It's a small change: the\u001b[48Gform YAML, the README, \u001b[72Gnd the \u001b[80Gucc\u001b[84Gss text, which\u001b[K\r\u001b[2C\u001b[1Bcurrently\u001b[13Gsays\u001b[18G\"We\u001b[22Ghave\u001b[27Gsent\u001b[32Ga\u001b[34Gcopy\u001b[39Gto\u001b[42Gyour\u001b[47Ge