[1349.222927, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mALTCHA\u001b[10Gcaused\u001b[17Git,\u001b[21Gand\u001b[25GI\u001b[27Gmissed\u001b[34Git\u001b[37Gbecause\u001b[45GI\u001b[47Gdidn't\u001b[54Gcheck\u001b[60Gthe\u001b[64Gmail\u001b[69Glayout\u001b[76Gafter\u001b[82Ginstalling\u001b[93Git.\u001b[97GIt's\u001b[102Gfixed\r\u001b[2C\u001b[1Bnow:\u001b[8Ga\u001b[10Gnew\u001b[14Gtest\u001b[19Gmail\u001b[24Guses\u001b[29Gthe\u001b[33GMto\u001b[37GSafi\u001b[42Glayout\u001b[49Gagain,\u001b[56Gwith\u001b[61Gno\u001b[64GTYPO3\u001b[70Gimprint\u001b[78Gand\u001b[82Gno\u001b[85GALTCHA\u001b[92Gvalue.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it happened:\u001b[20G\u001b[22mALTCHA\u001b[27Gships\u001b[33Gits\u001b[37Gown\u001b[41Gcopy\u001b[46Gof\u001b[49GTYPO3's\u001b[57Gmail\u001b[62Gtemplate,\u001b[72Gwhich\u001b[78Guses\u001b[83Gthe\u001b[87GTYPO3\u001b[93G\"SystemEmail\"\r\u001b[1B \u001b[3Glayout\u001b[10Gwith the logo and copyright notic\u001b[44G. It registers that\u001b[64Gcopy\u001b[69Gfor both mail finishers\u001b[93Gunder key\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m2011\u001b[39m. Wh\u001b[12Gn\u001b[14Gs\u001b[16Gveral template paths\u001b[37Gare registered, the one\u001b[61Gwith the\u001b[70Ghighes\u001b[78Gkey\u001b[82Gwins, and\u001b[92Gmy site\r\u001b[2C\u001b[1Btemplate\u001b[12Ghad\u001b[16Gkey\u001b[20G\u001b[38;2;177;185;249m20\u001b[39m.\u001b[24GSo\u001b[27Gafter\u001b[33GALTCHA\u001b[40Gwas\u001b[44Ginstalled,\u001b[55Gits\u001b[59Gtemplate\u001b[68Greplaced\u001b[77Gthe\u001b[81Gsite's.\u001b[89GALTCHA\u001b[96Gships\u001b[102Gthe\r\u001b[2C\u001b[1Bcopy so the solved puzzle doesn't\u001b[37Gappear as a\u001b[49Gform value in the mail.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix, in two files:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mForm setup:\u001b[22m in\u001b[20G\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m, th\u001b[68Gsite's mail template\u001b[89Gand layout pa\u001b[104Gs\r\u001b[2C\u001b[1B  now use key \u001b[38;2;177;185;249m2100\u001b[22G\u001b[39mfor both fi\u001b[34Gishers, so they win\u001b[54Gover ALTCHA's \u001b[38;2;177;185;249m2011\u001b[39m.\u001b[74GA\u001b[76Gcomment\u001b[84Gexplains\u001b[93Gthe\u001b[97Gnumber.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMail templates:\u001b[21G\u001b[22mthe\u001b[25Gsite's\u001b[32G\u001b[38;2;177;185;249mDefault.fluid.html\u001b[51G\u001b[39mand\u001b[55G\u001b[38;2;177;185;249mDefault.fluid.txt\u001b[73G\u001b[39mleave\u001b[79Gout\u001b[83Gthe\u001b[87GALTCHA\u001b[94Gfield,\u001b[101Gas\r\u001b[2C\u001b[1B  ALTCHA's own template\u001b[27Gdoes.\u001b[33GOtherwise\u001b[43Gthe\u001b[47Glong\u001b[52Gencoded\u001b[60Gpuzzle\u001b[67Gsolution\u001b[76Gwould\u001b[82Gappear\u001b[89Gin\u001b[92Gthe\u001b[96Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis will\u001b[13Ghappen again\u001b[26Gwhenever an extension reg\u001b[52Gsters mail templates with a high\u001b[85Gr key. Aft\u001b[96Gr\u001b[K\r\u001b[2C\u001b[1Binstalling or upda\u001b[22Ging a form extension, check one mail in Mailpit.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted\u001b[24Gyet.\u001b[29GStill\u001b[35Gopen:\u001b[41Gthe\u001b[45Gconsent\u001b[53Gtext\u001b[58Grenders\u001b[66Gbold\u001b[71Ginstead\u001b[79Gof\u001b[82Gnormal\u001b[89Gweight,\u001b[97Gand\u001b[101Gthe\r\u001b[2C\u001b[1Bfre\u001b[7Gh-\u001b[10Gnstall check of\u001b[26G\u001b[38;2;177;185;249mdata.xml\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 42s · done 6:53 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIf you can solve this puzzle so quickly cant an attacker do the same?\u001b[39m                                   \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✽\u001b[3GContemplating… \u001b[39m\u001b[K\r\u001