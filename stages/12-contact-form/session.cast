[54.598224, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  and a honeypot sp\u001b[23Gm trap. After subm\u001b[42Gssion \u001b[49Gt\u001b[51Gcan email\u001b[61Gthe\u001b[65Gsite owner, e\u001b[79Gail the\u001b[87Gsender,\u001b[96Gave to\u001b[K\r\u001b[4C\u001b[1Bthe database,\u001b[19Gredirect or \u001b[32Ghow a\u001b[38Gthank-you message.\u001b[57GYou\u001b[61Gcan\u001b[65Gship\u001b[70Gthe\u001b[74Gform\u001b[79Ginside\u001b[86Gyour\u001b[91Gsitepackage.\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Changing the markup means overriding\u001b[45GFluid\u001b[51Gtemplates\u001b[61Gand\u001b[65Gpartials.\u001b[75GSubmissions\u001b[87Gare\u001b[91Gnot\u001b[95Gstored\u001b[102Gor\r\u001b[2C\u001b[1B  listed in the backend unless you\u001b[38Gadd\u001b[42Gsomething.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m2. powermail (third-party)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m A popular form\u001b[30Gextension th\u001b[44G stores s\u001b[54Gbmissions as records\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Backend list\u001b[22Gand export\u001b[33Gof submissions, extra\u001b[55Gspam\u001b[60Gchecks,\u001b[68Gmore\u001b[73Gfeatures\u001b[82Gfor\u001b[86Geditors\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Another dependency to keep up to date,\u001b[47Gand\u001b[51Gyou\u001b[55Gneed\u001b[60Gto\u001b[63Gcheck\u001b[69Git\u001b[72Gsupports\u001b[81GTYPO3\u001b[87G14.3\u001b[92Gbefore\r\u001b[2C\u001b[1B  choosing it. Too much for\u001b[31Ga\u001b[33Gsimple\u001b[40Gcontact\u001b[48Gform.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m3. Your own plugin\r\u001b[2C\u001b[1BWhat it is:\u001b[22m Your\u001b[20Gown controller, form objec\u001b[47G, validation\u001b[64Gmail code\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[9G\u001b[22mFull control\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m You have to write validation, spam protection,\u001b[55Gmail\u001b[60Gand\u001b[64Gerror\u001b[70Ghandling\u001b[79Gyourself.\u001b[89GOnly\u001b[94Gworth\u001b[100Git\r\u001b[2C\u001b[1B  for unusual logic, such as\u001b[32Gwriting\u001b[40Ginto\u001b[45Gyour\u001b[50Gown\u001b[54Gtables\u001b[61Gor\u001b[64Gcalling\u001b[72Gan\u001b[75GAPI.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m4. External service\r\u001b[2C\u001b[1BWhat it is:\u001b[22m An embedded form from\u001b[37Ga hosted\u001b[46Gprovider\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m No code\u001b[17Gto write\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[8G\u001b[22mVisitor\u001b[16Gdata\u001b[21Ggoes\u001b[26Gto\u001b[29Ga\u001b[31Gthird\u001b[37Gparty\u001b[43G(a\u001b[46GGDPR\u001b[51Gproblem),\u001b[61Git\u001b[64Glooks\u001b[70Gdifferent\u001b[80Gfrom\u001b[85Gyour\u001b[90Gsite,\u001b[96Gand\u001b[100Git\r\u001b[2C\u001b[1B  doesn't fit a self-contained demo.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mMy recommendation: EXT:form, with the form shipped in the sitepackage\u001b[22m\u001b[K\r\u001b[5C\u001b[1B                     \u001b[28G    \u001b[33G   \u001b[37G   \u001b[31;1H\u001b[29;3H\u001b[?25h"]
