[54.181805, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ we need a contact form, what ways can it be created and what can you recommend?\u001b[39m                         \r\u001b[2C\u001b[1B\u001b[49m\u001b[1mOption:\u001b[22m \u001b[1m2. powermail (third-party)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m A\u001b[17Gpopul\u001b[23Gr form extension that stor\u001b[50Gs submissions a\u001b[66G records\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Back\u001b[14Gnd list a\u001b[24Gd export of submissions, extra\u001b[55Gspam\u001b[60Gche\u001b[64Gks, more features for editors\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Another dependen\u001b[25Gy\u001b[27Gt\u001b[29G keep u\u001b[37G to da\u001b[44Ge, and you\u001b[55Gneed\u001b[60Gto\u001b[63Gcheck\u001b[69Git\u001b[72Gsupports\u001b[81GTYPO3\u001b[87G14.3\u001b[92Gbefore\r\u001b[2C\u001b[1B  choosing it. Too much for a simple contact\u001b[48Gform.\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m3. Your own plugin\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m You\u001b[19G own\u001b[24Gcontroller,\u001b[36Gform\u001b[41Gobject,\u001b[49Gvalidation\u001b[60Gand\u001b[64Gmail\u001b[69Gcode\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m F\u001b[11Gll con\u001b[18Grol\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m You have\u001b[17Gt\u001b[19G write validation, spam protectio\u001b[53G, mail and\u001b[64Gerror handling yourself.\u001b[89GOnly\u001b[94Gworth\u001b[100Git\r\u001b[2C\u001b[1B  for unusual logic, such as writing into\u001b[45Gyour\u001b[50Gown\u001b[54Gtables\u001b[61Gor\u001b[64Gcalling\u001b[72Gan\u001b[75GAPI.\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m4. External service\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m An embedd\u001b[25Gd\u001b[27Gform\u001b[32Gfrom\u001b[37Ga\u001b[39Ghosted\u001b[46Gprovider\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m No c\u001b[14Gde to write\u001b[26G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Visitor d\u001b[18Gta goes to a third party\u001b[43G(a\u001b[46GGDPR\u001b[51Gproblem),\u001b[61Git\u001b[64Glooks\u001b[70Gdifferent\u001b[80Gfrom\u001b[85Gyour\u001b[90Gsite,\u001b[96Gand\u001b[100Git\r\u001b[4C\u001b[1Bdoesn't\u001b[13Gfit\u001b[17Ga\u001b[19Gself-contained\u001b[34Gdemo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation: EXT:form, with the form shipped in the sitepackage\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mTurn it on:\u001b[22m add \u001b[23G\u001b[38;2;177;185;249mypo3/form\u001b[33G\u001b[39mto the dependencies\u001b[53Gin\u001b[56G\u001b[38;2;177;185;249mConfiguration/Sets/Sitepackage/config.yaml\u001b[39m,\u001b[100Gnext\u001b[105Gto\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mfluid-styled-content\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m and \u001b[38;2;177;185;249mke_search\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDefine the form in the sitepackage:\u001b[22m put it \u001b[50Gn a fil\u001b[58G like \u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\r\u001b[5C\u001b[1B\u001b[39mwith name, email, subject, message and a\u001b[47Gprivacy\u001b[55Gc\u001b[58Gckbox. Regi\u001b[70Gter\u001b[74Gtha\u001b[78G folder\u001b[86Gas a f\u001b[93Grm storage\r\u001b[5C\u001b[1Blocation\u001b[15Gin a\u001b[20Gsmall form setup YAM\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49msion\u001b[74Gcontrol\u001b[82Gand\u001b[86Gworks\u001b[92Gon\u001b[95Ga\u001b[97Gfresh\u001b[31;1H\u001b[29;3H\u001b[?25h"]
