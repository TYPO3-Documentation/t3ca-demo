oblem\"\u001b[90G\u001b[39min\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m * the sidebar beside it.\u001b[36GThe\u001b[40Gpage\u001b[45Ggets\u001b[50Gthe\u001b[54Gpage\u001b[59Glayout\u001b[66G\u001b[38;2;230;219;116m\"Sidebar right\"\u001b[39m,\u001b[83Gthe\u001b[87Gelements\r\u001b[7C\u001b[1B\u001b[2m9\u001b[11G\u001b[22m*\u001b[13Gseed-pages.php\u001b[28Gwrote\u001b[34Gmove\u001b[39Ginto\u001b[44Gits\u001b[48Gsidebar,\u001b[57G\u001b[38;2;249;38;114mand\u001b[61G\u001b[39mthe\u001b[65G\u001b[38;2;230;219;116m\"Visit us\"\u001b[76G\u001b[39mimage\u001b[82Gmoves\u001b[88Gabove\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m * its\u001b[17Gtext,\u001b[23Gbecause\u001b[31Gthe\u001b[35Gsidebar\u001b[43Gis\u001b[46Gtoo\u001b[50Gnarrow\u001b[57G\u001b[38;2;249;38;114mfor\u001b[61G\u001b[39mboth\u001b[66Gside\u001b[71Gby\u001b[74Gside.\u001b[80GThe\u001b[84Gform\u001b[89Gis\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +97 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBefore running th\u001b[21G seed I'll\u001b[32Gtake a DDEV snap\u001b[49Ghot of the database so it can be rolled back, then\u001b[100Grefresh\r\u001b[2C\u001b[1Bthe composer lock.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\r\u001b[42C\u001b[2B\u001b[38;2;153;153;153mthought for 2s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
