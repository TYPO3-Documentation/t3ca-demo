[1130.998868, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Rendering the page\u001b[22Gand\u001b[26Gchecking\u001b[35Gthe\u001b[39Gwidget\u001b[46Gmarkup\u001b[53Gand\u001b[57Gthe\u001b[61Gchallenge\u001b[71Gendpoint:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gwidget\u001b[14Grenders\u001b[22Gand\u001b[26Gthe\u001b[30Gchallenge\u001b[40Gendpoint\u001b[49Greturns\u001b[57Ga\u001b[59Gsigned\u001b[66Gpuzzle\u001b[73Gwithout\u001b[81Gcaching.\u001b[90GNow\u001b[94Gthe\u001b[98Gbehaviour\r\u001b[2C\u001b[1Btest. First, is there\u001b[25Ga\u001b[27Gheadless\u001b[36Gbrowser\u001b[44Gto\u001b[47Gsolve\u001b[53Ga\u001b[55Greal\u001b[60Gchallenge?\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mChrome\u001b[10Gis\u001b[13Gon\u001b[16Gthe\u001b[20Ghost.\u001b[26GI'll\u001b[31Gdrive\u001b[37Git\u001b[40Gwith\u001b[45G\u001b[38;2;177;185;249mpuppeteer-core\u001b[39m,\u001b[61Ginstalled\u001b[71Gonly\u001b[76Gin\u001b[79Gthe\u001b[83Gscratchpad\u001b[94G(no\u001b[98Gbrowser\r\u001b[2C\u001b[1Bdownload), to submit the form the\u001b[37Gway\u001b[41Ga\u001b[43Gvisitor\u001b[51Gwould:\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNo\u001b[6Gnpm\u001b[10Gon\u001b[13Gthe\u001b[17Ghost.\u001b[23GInstead\u001b[31GI'll\u001b[36Gsolve\u001b[42Gthe\u001b[46Gchallenge\u001b[56Gin\u001b[59GPython\u001b[66Gthe\u001b[70Gsame\u001b[75Gway\u001b[79Gthe\u001b[83Gwidget\u001b[90Gdoes.\u001