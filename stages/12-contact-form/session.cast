[1209.149348, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mALTCHA is working on\u001b[24Gthe\u001b[28Gcontact\u001b[36Gform.\u001b[42GVisitors\u001b[51Gtick\u001b[56G\"I'm\u001b[61Gnot\u001b[65Ga\u001b[67Grobot\"\u001b[74Gbefore\u001b[81Gsending,\u001b[90Gand\u001b[94Gthe\u001b[98Ghoneypot\r\u001b[2C\u001b[1Bstays\u001b[9Gas\u001b[12Ga\u001b[14Gsecond\u001b[21Glayer.\u001b[28GNothing\u001b[36Gis\u001b[39Gcommitted.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I tested:\u001b[22m I solv\u001b[25Gd the puzzle\u001b[39Gwith a script\u001b[53Gthat\u001b[58Gdoes\u001b[63Gthe\u001b[67Gsame\u001b[72Gcomputation\u001b[84Gas\u001b[87Gthe\u001b[91Gwidget.\r\u001b[2C\u001b[2B┌──────────────────────────┬─────────────────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[15GCase\u001b[30G│\u001b[64GResult\u001b[104G│\r\u001b[2C\u001b[1B├\u001b[30G┼\u001b[104G┤\r\u001b[4C\u001b[1BCorrectly\u001b[15Gsolved\u001b[22Gpuzzle\u001b[32GSent,\u001b[38Gexactly\u001b[46G1\u001b[48Gmail\u001b[64G      \r\u001b[4C\u001b[2BN\u001b[7G solution     \u001b[22G      \u001b[32GR\u001b[34Gject\u001b[39Gd: \"Please tick\u001b[55G\"I'm\u001b[60Gnot\u001b[64Ga\u001b[66Grobot\"\u001b[73Gand\u001b[77Gwait\u001b[82Guntil\u001b[88Git\u001b[91Gis\u001b[94Gchecked.\"\r\u001b[4C\u001b[2BSame solution\u001b[19Gsent\u001b[24Gagain\u001b[40G,\u001b[42Gsince \u001b[49Gach puzzle\u001b[60Gc\u001b[62Gunts \u001b[68Gnce \u001b[73G   \u001b[77G    \u001b[82G     \u001b[88G  \u001b[91G  \u001b[94G         \r\u001b[4C\u001b[2BF\u001b[7Gk\u001b[19G    \u001b[24G     \u001b[40G \u001b[42G     \u001b[48G    \u001b[53G      \u001b[60G      \u001b[67G    \r\u001b[2C\u001b[1B└\u001b[30G┴\u001b[104G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe form still works on cached pages, because each visitor gets a fresh puzzle from an uncached\u001b[K\r\u001b[2C\u001b[1Bendpoint.\u001b[13GI\u001b[15Galso\u001b[20Gtook\u001b[25Ga\u001b[27Gscreenshot\u00