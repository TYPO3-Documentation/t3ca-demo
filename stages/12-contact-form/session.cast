[634.350581, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mMai\u001b[9Gs:\u001b[22m a\u001b[14Gsite layout and templates under \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m. The consent checkbox is\r\u001b[4C\u001b[1Bl\u001b[7Gft out\u001b[14Gof th\u001b[20G mails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[24G\u001b[39mis now a depe\u001b[38Gdency of the\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[39m updat\u001b[44G also adds \u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m, which the sit\u001b[85Gpackage alr\u001b[97Gady\u001b[K\r\u001b[4C\u001b[1Br\u001b[7Gquired\u001b[14Gbut the lock had\u001b[31Gmissed.\r\u001b[4C\u001b[1B\u001b[1mContact page:\u001b[22m a new \u001b[26Gcript,\u001b[33G\u001b[38;2;177;185;249mBuild/Initialisation/seed-contac\u001b[66G-f\u001b[69Grm.php\u001b[39m, runs after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m.\u001b[104GIt\r\u001b[4C\u001b[1Bswitches the page to the \"Sidebar right\" \u001b[47Gayout, puts the form in\u001b[71Gt\u001b[73Ge main area and moves the address,\r\u001b[4C\u001b[1Bopen\u001b[10Gng ho\u001b[16Grs and \"Report\u001b[31Ga problem\"\u001b[42Ginto\u001b[47Gthe\u001b[51Gsidebar.\u001b[60GI\u001b[62Gre-exported\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[84Gand\u001b[88Gthe\u001b[92Gdiff\u001b[97Gcontains\r\u001b[2C\u001b[1B \u001b[5Gonly those changes.\u001b[25GThe README explains all of this.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFresh-install check:\u001b[22m this needs an empty database, and\u001b[60Gthe\u001b[64Gsafety\u001b[71Gcheck\u001b[77Gblocked\u001b[85Gme\u001b[88Gfrom\u001b[93Gdropping\u001b[102Git.\r\u001b[4C\u001b[1BYour\u001b[10Ginstallation\u001b[23Gis\u001b[26Gunchanged\u001b[36Gby\u001b[39Gthat\u001b[44Gattempt.\u001b[53GTo\u001b[56Grun\u001b[60Git\u001b[63Gyourself,\u001b[73Geither\u001b[80Gfollow\u001b[87G\"Starting\u001b[97Gover\"\u001b[103Gand\r\u001b[2C\u001b[1B  \"Fresh install\"\u001b[21Gin\u001b[24Gthe\u001b[28Groot\u001b[33G\u001b[38;2;177;185;249mREADME.md\u001b[39m,\u001b[44Gor\u001b[47Gtell\u001b[52Gme\u001b[55Gto\u001b[58Ggo\u001b[61Gahead\u001b[67Gand\u001b[71GI'll\u001b[76Gdo\u001b[79Git\u001b[82Gbetween\u001b[90Gtwo\u001b[94Gdatabase\r\u001b[2C\u001b[1B \u001b[5Gsnapshots and restore yours afterwards. A sn\u001b[50Gpshot\u001b[56Gfrom b\u001b[63Gfore m\u001b[73Ganges exists as\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mbefore-contact-form\u001b[39m.\u001b[26G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisual check:\u001b[22m I\u001b[21Go\u001b[23Gly checked the HTML\u001b[44Gnot the\u001b[52Gpage in a browser.\u001b[71GPlease look a\u001b[85G the\u001b[93G-column\u001b[K\r\u001b[4C\u001b[1Blayout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMail sender:\u001b[22m the mails\u001b[28Gcome\u001b[33Gfrom\u001b[38G\u001b[38;2;177;185;249mnoreply@mtosafi.example\u001b[39m.\u001b[63GOn\u001b[66Ga\u001b[68Glive\u001b[73Gserver,\u001b[81Gthat\u001b[86Gdomain\u001b[93Ghas\u001b[97Gto\u001b[100Gallow\r\u001b[2C\u001b[1B \u001b[5Gthe server to\u001b[19Gsend mail for i\u001b[35G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHeading style:\u001b[20G\u001b[22mthe\u001b[24G\"Write\u001b[31Gto\u001b[34Gus\"\u001b[38Gsubheader\u001b[48Gshows\u001b[54Gas\u001b[57Gan\u001b[60G\u001b[38;2;177;185;249m<h3>\u001b[39m,\u001b[66Gwhile\u001b[72Gthe\u001b[76Gdesign\u001b[83Ghas\u001b[87Ga\u001b[89Glead\u001b[94Gparagraph\r\u001b[2C\u001b[1B \u001b[5Gthere.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you want to commit, say so and I'll show you the commit message first.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 6m 32s · done 6:41 PM\r\u001b[3B\u001b[39m❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
