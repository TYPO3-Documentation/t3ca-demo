[1197.957501, "o", "\u001b[?25l\u001b[H\u001b[3G│\u001b[5GFake solution            │ Rejected                                                            \u001b[104G│\r\u001b[2C\u001b[1B└──────────────────────────┴─────────────────────────────────────────────────────────────────────────┘\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe form still works on cached pages, because each visitor gets a fresh puzzle from an uncached\u001b[K\r\u001b[2C\u001b[1Bendpoint. I also took a screenshot with headless Chrome: the two-column layout and the widget render\r\u001b[2C\u001b[1Bproperly.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mComposer:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[39m is in the project's and the sitepackage's \u001b[38;2;177;185;249mcomposer.json\u001b[39m, and\u001b[103Gthe\r\u001b[4C\u001b[1Block file is updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite set:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[39m is now a dependency.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA element above the button, with friendlier error texts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm setup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m gives the element the design's \u001b[38;2;177;185;249mform-field\r\u001b[4C\u001b[1B\u001b[39mclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty means it signs puzzles\r\u001b[4C\u001b[1Bwith TYPO3's encryption key, which is fine, and the change belongs in the commit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m a sectio\u001b[22G on ALTCHA. \u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't change.\u001b[58G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[27G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[4C\u001b[1Bdetermined\u001b[16Gspammer\u001b[24Gcan\u001b[28Gstill\u001b[34Gsolve\u001b[40Git\u001b[43Gcheaply:\u001b[52Gmy\u001b[55Gscript\u001b[62Gneeded\u001b[69G0.1\u001b[73Gseconds.\u001b[82GYou\u001b[86Gcan\u001b[90Graise\u001b[96Gthe\r\u001b[1B \u001b[3G  difficulty in\u001b[19Gthe site\u001b[28Gsettings\u001b[37G(\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m),\u001b[65Gbut\u001b[69Gthat\u001b[74Gslows\u001b[80Gdown\u001b[85Gcheap\u001b[91Gphones\u001b[98Gtoo.\r\u001b[1B  - \u001b[1mCleanup needs a cron job.\u001b[22m Every page view stores one puzzle in the database, and\u001b[86Gnothing\u001b[94Gdeletes\u001b[102Gthem\r\u001b[4C\u001b[1Bautomatically.\u001b[20GThe\u001b[24Gscheduler\u001b[34Gextension\u001b[44Gisn't\u001b[50Ginstalled,\u001b[61Gso\u001b[64Gproduction\u001b[75Gneeds\u001b[81Ga\u001b[83Gcron\u001b[88Gjob\u001b[92Grunning\u001b[100G\u001b[38;2;177;185;249mtypo3 \r\u001b[1B\u001b[39m \u001b[3G  \u001b[38;2;177;185;249maltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m.\u001b[68GIt's\u001b[73Gin\u001b[76Gthe\u001b[80GREADME.\r\u001b[1B  -\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1198.356535, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[38G\u001b[22mThe\u001b[42Gextension\u001b[52Gregisters\u001b[62Gits\u001b[66Gform\u001b[71Gsetup\u001b[77Gthe\u001b[81Gold\u001b[85GTypoScript\u001b[96Gway,\u001b[101Gwhich\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1198.589513, "o", "\u001b[?25l\u001b[H\u001b[3GThe form still works\u001b[24Gon\u001b[27Gcached pages,\u001b[41Gbecause\u001b[49Geach\u001b[54Gvisitor\u001b[62Ggets\u001b[67Ga\u001b[69Gfresh\u001b[75Gpuzzle\u001b[82Gfrom\u001b[87Gan\u001b[90Guncached\u001b[104G\u001b[K\r\u001b[2C\u001b[1Bendpoint. I also took a screenshot with headless Chrome: the two-column layout and the widget render\u001b[K\r\u001b[2C\u001b[1Bproperly.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[4C\u001b[1Block\u001b[10Gfile\u001b[15Gis\u001b[18Gupdated.\r\u001b[2C\u001b[1B- \u001b[1mSite set:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mF\u001b[7Grm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA element above the button, with friendlier error texts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm setup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty means it\u001b[91Gsign\u001b[96G puzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fine, and the change belongs in the commit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt's a hurdle, not a wall.\u001b[22m It stops bots that do\u001b[54G't run\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[4C\u001b[1Bdetermined\u001b[16Gspammer\u001b[24Gcan\u001b[28Gstill\u001b[34Gsolve\u001b[40Git\u001b[43Gcheaply:\u001b[52Gmy\u001b[55Gscript\u001b[62Gneeded\u001b[69G0.1\u001b[73Gseconds.\u001b[82GYou\u001b[86Gcan\u001b[90Graise\u001b[96Gthe\r\u001b[2C\u001b[1B  difficulty in the site\u001b[28Gsettings\u001b[37G(\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m),\u001b[65Gbut\u001b[69Gthat\u001b[74Gslows\u001b[80Gdown\u001b[85Gcheap\u001b[91Gphones\u001b[98Gtoo.\r\u001b[4C\u001b[1B\u001b[1mCleanup needs a cron\u001b[26Gjob.\u001b[22m Every page view stores one puzzle in the\u001b[72Gdatabase, and nothing\u001b[94Gdelet\u001b[101G them\r\u001b[4C\u001b[1Bau\u001b[8Gomatically. The\u001b[24Gscheduler\u001b[34Gextens\u001b[41Gon isn't installed, so pro\u001b[68Guction nee\u001b[80G a cron job running\u001b[100G\u001b[38;2;177;185;249mtypo3 \r\u001b[4C\u001b[1Baltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. I\u001b[70G's in the\u001b[80GREADME.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mReady for TYPO3\u001b[21G14.3\u001b[26Gbut not 15.\u001b[22m Th\u001b[42Gexten\u001b[48Gi\u001b[50Gn registers its form setup th\u001b[80G old TypoScript way, which\r\u001b[4C\u001b[1BTYPO3 14.2 deprecated and 15\u001b[34Gremoves. It works on 14.3\u001b[61Gbut the exte\u001b[74Gsion must be updated before any\u001b[K\r\u001b[4C\u001b[1Bmove to TYPO3 15.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1199.040225, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mVisitors have to click the checkbox.\u001b[42G\u001b[22mIt\u001b[45Gverifies\u001b[54Gin\u001b[57Gunder\u001b[63Ga\u001b[65Gsecond.\u001b[73GSetting\u001b[81G\u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1199.400567, "o", "\u001b[?25l\u001b[H\u001b[3Gendpoint. I a\u001b[17Gso took a\u001b[27Gscre\u001b[32Gnshot with headless Chrome: the \u001b[65Gwo-column\u001b[75Glayout\u001b[82Gand the\u001b[90Gwidget render\r\u001b[2C\u001b[1Bpro\u001b[7Gerly\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mComposer:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glock file\u001b[15Gis updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite set:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA elem\u001b[48Gnt above the\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[8C\u001b[1B\u001b[1m setup:\u001b[22m \u001b[38;2;177;185;249mConfigur\u001b[26Gtion/Form/Sitepackage/config.yaml\u001b[39m gives the element the design's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe\u001b[37Gextension\u001b[47Gadded\u001b[53Gan\u001b[56Gempty\u001b[62G\u001b[38;2;177;185;249mhmac\u001b[67G\u001b[39msetting.\u001b[76GEmpty\u001b[82Gmeans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fi\u001b[46Ge, an\u001b[53Gthe change belongs in the com\u001b[83Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m a section on ALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39md\u001b[45Gdn't chang\u001b[56G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mIt'\u001b[10Ga hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[2C\u001b[1B \u001b[5Gdetermined spammer can still solve it cheaply: my sc\u001b[58Gipt needed 0.1 sec\u001b[78Gds. You can raise the\u001b[K\r\u001b[5C\u001b[1Bifficulty\u001b[16Gin th\u001b[22G site\u001b[29Gettings (\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m), but\u001b[69Gthat sl\u001b[77Gws down cheap phones too.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every\u001b[37Gpage view stores one puzzle\u001b[65Gin the databa\u001b[79Ge, a\u001b[84Gd nothing d\u001b[96Gle\u001b[99Ges them\r\u001b[2C\u001b[1B \u001b[5Gautomatically. The scheduler extension isn'\u001b[49G in\u001b[53Gtalled, so production needs a cro\u001b[87G job running \u001b[38;2;177;185;249mtypo3 \r\u001b[4C\u001b[1Baltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. It's in the README.\u001b[88G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The extension registers its form \u001b[72Getup the old TypoScript\u001b[96Gway,\u001b[101Gwhich\r\u001b[2C\u001b[1B \u001b[5GTYPO3 14.2 deprecated and 15 removes. I\u001b[45G works\u001b[52Gon 14.3, bu\u001b[64G the ext\u001b[73Gnsion must be updated before any\u001b[K\r\u001b[4C\u001b[1Bmove to TYPO3 15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisitors have to click the checkbox.\u001b[42G\u001b[22mIt\u001b[45Gverifies\u001b[54Gin\u001b[57Gunder\u001b[63Ga\u001b[65Gsecond.\u001b[73GSetting\u001b[81G\u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\r\u001b[2C\u001b[1B \u001b[5Gsolve the puzzle as soon as someone starts filling in the\u001b[63Gform, so it's usually done before they\u001b[102G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1199.539179, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B  lock file is\u001b[18Gupdated.\r\u001b[4C\u001b[1B\u001b[1mSite \u001b[12Gt\u001b[36G\u001b[22m is now a dependency.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[29G\u001b[39mhas\u001b[33Gan\u001b[36GALTCHA\u001b[43Gelement\u001b[51Gabove\u001b[57Gthe\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[4C\u001b[1B\u001b[1mForm\u001b[13Gup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m s\u001b[69Gtting. Empty\u001b[82Gm\u001b[84Gans it\u001b[91Gsigns puzzles\r\u001b[4C\u001b[1Bwith TYPO3's\u001b[18Gencryption\u001b[29Gkey,\u001b[34Gwhich\u001b[40Gis\u001b[43Gfine,\u001b[49Gand\u001b[53Gthe\u001b[57Gchange\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[4C\u001b[1B\u001b[1mREADME:\u001b[22m a section on ALTCHA. \u001b[38;2;177;185;249mdata.xml\u001b[39m didn't change.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[2C\u001b[1B  determined spammer can\u001b[28Gstill\u001b[34Gsolve\u001b[40Git\u001b[43Gcheaply:\u001b[52Gmy\u001b[55Gscript\u001b[62Gneeded\u001b[69G0.1\u001b[73Gseconds.\u001b[82GYou\u001b[86Gcan\u001b[90Graise\u001b[96Gthe\r\u001b[2C\u001b[1B \u001b[5Gdifficulty in the site setting\u001b[36G (\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m), but that sl\u001b[77Gws down cheap phones too\u001b[103G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every page view stores one puzzl\u001b[64G in the database,\u001b[82Gand\u001b[86Gnothing deletes\u001b[102Gthem\r\u001b[4C\u001b[1Bautomatically. The scheduler extension isn't installed, so production needs a cron job ru\u001b[95Gning \u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249maltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m.\u001b[68GIt's in the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The exte\u001b[47Gsion registers its form setup the\u001b[81Gold TypoScript way, which\r\u001b[4C\u001b[1BTYPO3 14.2 deprecated and 15 removes. It works on 14.3, but the extension must be updated\u001b[95Gbefore\u001b[102Gany\r\u001b[2C\u001b[1B \u001b[5Gmove to TYPO3 15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisitors have to click the checkbox.\u001b[22m It verifies in under a\u001b[65Gsecond. Setting \u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\r\u001b[4C\u001b[1Bs\u001b[7Glve the puzzle as\u001b[25Gsoon\u001b[30Gas\u001b[33Gsomeone\u001b[41Gstarts\u001b[48Gfilling\u001b[56Gin\u001b[59Gthe\u001b[63Gform,\u001b[69Gso\u001b[72Git's\u001b[77Gusually\u001b[85Gdone\u001b[90Gbefore\u001b[97Gthey\r\u001b[2C\u001b[1B \u001b[5Greach the checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1199.83987, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mContent Security Policy:\u001b[30G\u001b[22mthe\u001b[34Gextension\u001b[44Gloosens\u001b[52Gthe\u001b[56Gsite's\u001b[63GCSP\u001b[67Gfor\u001b[71Gthe\u001b[75Gwidget\u001b[82G(it\u001b[86Gallows\u001b[93G\u001b[38;2;177;185;249mblob:\u001b[99G\u001b[39mworkers\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1199.992187, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B  lock file is\u001b[18Gupdated.\r\u001b[4C\u001b[1B\u001b[1mSite \u001b[12Gt\u001b[36G\u001b[22m is now a dependency.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[29G\u001b[39mhas\u001b[33Gan\u001b[36GALTCHA\u001b[43Gelement\u001b[51Gabove\u001b[57Gthe\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[4C\u001b[1B\u001b[1mForm\u001b[13Gup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m s\u001b[69Gtting. Empty\u001b[82Gm\u001b[84Gans it\u001b[91Gsigns puzzles\r\u001b[4C\u001b[1Bwith TYPO3's\u001b[18Gencryption\u001b[29Gkey,\u001b[34Gwhich\u001b[40Gis\u001b[43Gfine,\u001b[49Gand\u001b[53Gthe\u001b[57Gchange\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[4C\u001b[1B\u001b[1mREADME:\u001b[22m a section on ALTCHA. \u001b[38;2;177;185;249mdata.xml\u001b[39m didn't change.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[2C\u001b[1B  determined spammer can\u001b[28Gstill\u001b[34Gsolve\u001b[40Git\u001b[43Gcheaply:\u001b[52Gmy\u001b[55Gscript\u001b[62Gneeded\u001b[69G0.1\u001b[73Gseconds.\u001b[82GYou\u001b[86Gcan\u001b[90Graise\u001b[96Gthe\r\u001b[2C\u001b[1B \u001b[5Gdifficulty in the site setting\u001b[36G (\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m), but that sl\u001b[77Gws down cheap phones too\u001b[103G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every page view stores one puzzl\u001b[64G in the database,\u001b[82Gand\u001b[86Gnothing deletes\u001b[102Gthem\r\u001b[4C\u001b[1Bautomatically. The scheduler extension isn't installed, so production needs a cron job ru\u001b[95Gning \u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249maltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m.\u001b[68GIt's in the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The exte\u001b[47Gsion registers its form setup the\u001b[81Gold TypoScript way, which\r\u001b[4C\u001b[1BTYPO3 14.2 deprecated and 15 removes. It works on 14.3, but the extension must be updated\u001b[95Gbefore\u001b[102Gany\r\u001b[2C\u001b[1B \u001b[5Gmove to TYPO3 15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisitors have to click the checkbox.\u001b[22m It verifies in under a\u001b[65Gsecond. Setting \u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\r\u001b[4C\u001b[1Bs\u001b[7Glve the puzzle as\u001b[25Gsoon\u001b[30Gas\u001b[33Gsomeone\u001b[41Gstarts\u001b[48Gfilling\u001b[56Gin\u001b[59Gthe\u001b[63Gform,\u001b[69Gso\u001b[72Git's\u001b[77Gusually\u001b[85Gdone\u001b[90Gbefore\u001b[97Gthey\r\u001b[2C\u001b[1B \u001b[5Greach the checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent Security Policy:\u001b[30G\u001b[22mthe exte\u001b[39Gsion loosens the\u001b[56Gsite's\u001b[63GCSP for the widget (it allows \u001b[38;2;177;185;249mblob:\u001b[39m workers\r\u001b[4C\u001b[1Band inline styles)\u001b[25GThat\u001b[30Gonly\u001b[35Ghas\u001b[39Gan\u001b[42Geffect\u001b[49Gif\u001b[52Gthe\u001b[56Gfrontend\u001b[65GCSP\u001b[69Gis\u001b[72Gswitched\u001b[81Gon.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1200.440629, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Glock file\u001b[15Gis updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite set:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA elem\u001b[48Gnt above the\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[8C\u001b[1B\u001b[1m setup:\u001b[22m \u001b[38;2;177;185;249mConfigur\u001b[26Gtion/Form/Sitepackage/config.yaml\u001b[39m gives the element the design's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe\u001b[37Gextension\u001b[47Gadded\u001b[53Gan\u001b[56Gempty\u001b[62G\u001b[38;2;177;185;249mhmac\u001b[67G\u001b[39msetting.\u001b[76GEmpty\u001b[82Gmeans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fi\u001b[46Ge, an\u001b[53Gthe change belongs in the com\u001b[83Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m a section on ALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39md\u001b[45Gdn't chang\u001b[56G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mIt'\u001b[10Ga hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[2C\u001b[1B \u001b[5Gdetermined spammer can still solve it cheaply: my sc\u001b[58Gipt needed 0.1 sec\u001b[78Gds. You can raise the\u001b[K\r\u001b[5C\u001b[1Bifficulty\u001b[16Gin th\u001b[22G site\u001b[29Gettings (\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m), but\u001b[69Gthat sl\u001b[77Gws down cheap phones too.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every\u001b[37Gpage view stores one puzzle\u001b[65Gin the databa\u001b[79Ge, a\u001b[84Gd nothing d\u001b[96Gle\u001b[99Ges them\r\u001b[2C\u001b[1B \u001b[5Gautomatically. The scheduler extension isn'\u001b[49G in\u001b[53Gtalled, so production needs a cro\u001b[87G job running \u001b[38;2;177;185;249mtypo3 \r\u001b[4C\u001b[1Baltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. It's in the README.\u001b[88G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The extension registers its form \u001b[72Getup the old TypoScript\u001b[96Gway,\u001b[101Gwhich\r\u001b[2C\u001b[1B \u001b[5GTYPO3 14.2 deprecated and 15 removes. I\u001b[45G works\u001b[52Gon 14.3, bu\u001b[64G the ext\u001b[73Gnsion must be updated before any\u001b[K\r\u001b[4C\u001b[1Bmove to TYPO3 15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisitors have to click the checkbox.\u001b[42G\u001b[22mIt\u001b[45Gverifies\u001b[54Gin\u001b[57Gunder\u001b[63Ga\u001b[65Gsecond.\u001b[73GSetting\u001b[81G\u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\r\u001b[2C\u001b[1B \u001b[5Gsolve the puzzle as soon as someone starts filling in the\u001b[63Gform, so it's usually done before they\u001b[102G\u001b[K\r\u001b[4C\u001b[1Breach\u001b[15Gcheckbox.\u001b[25G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent Security Policy:\u001b[30G\u001b[22mthe\u001b[34Gextension\u001b[44Gloosens\u001b[52Gthe\u001b[56Gsite's\u001b[63GCSP\u001b[67Gfor\u001b[71Gthe\u001b[75Gwidget\u001b[82G(it\u001b[86Gallows\u001b[93G\u001b[38;2;177;185;249mblob:\u001b[99G\u001b[39mworkers\r\u001b[2C\u001b[1B \u001b[5Gand inline styles). That\u001b[30Gonly has an effect if\u001b[56Gfrontend CSP is switched on.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill\u001b[9Gopen\u0