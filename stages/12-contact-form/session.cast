[873.087496, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bits\u001b[7Greal mails start landing in\u001b[35Gspam\u001b[40Gfolders.\u001b[49GThe\u001b[53Ghoneypot\u001b[62Gonly\u001b[67Gstops\u001b[73Gsimple\u001b[80Gbots,\u001b[86Gand\u001b[90Gnothing\u001b[98Glimits\r\u001b[2C\u001b[1Bhow\u001b[7Goften\u001b[13Gthe\u001b[17Gform\u001b[22Gcan\u001b[26Gbe\u001b[29Gsent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's already fine:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTampered submissions:\u001b[22m EXT:form signs\u001b[42Gthe\u001b[46Gform's\u001b[53Ghidden\u001b[60Gstate\u001b[66Gand\u001b[70Gthe\u001b[74Glist\u001b[79Gof\u001b[82Gallowed\u001b[90Gfields,\u001b[98Gso\u001b[101Ga\r\u001b[2C\u001b[1B \u001b[5Gmodified submission is rejected.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInjected markup:\u001b[22m th\u001b[25G mail te\u001b[34Gplates\u001b[41Gescape\u001b[48Geverything\u001b[59Gthe\u001b[63Gvisitor\u001b[71Genters.\u001b[79GAll\u001b[83Gaddresses\u001b[93Gpass\u001b[98Gan\u001b[101Gemail\r\u001b[2C\u001b[1B \u001b[5Gcheck before they reach the mailer.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLength limits:\u001b[22m \u001b[21Game i\u001b[27G capped\u001b[35Gat\u001b[38G200\u001b[42Gcharacters\u001b[53Gand\u001b[57Gthe\u001b[61Gmessage\u001b[69Gat\u001b[72G5,000.\u001b[79GThere's\u001b[87Gno\u001b[90Gfile\u001b[95Gupload,\u001b[103Gso\r\u001b[2C\u001b[1B \u001b[5Gnothing lands on the server.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam bots:\u001b[22m the honeypot catches simple ones.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCookies:\u001b[22m loading the page\u001b[31Gsets\u001b[36Gnone,\u001b[42Gso\u001b[45Gthe\u001b[49Gform\u001b[54Gneeds\u001b[60Gno\u001b[63Gcookie\u001b[70Gbanner.\u001b[78GIn\u001b[81GTYPO3\u001b[87G14.3\u001b[92Gthe\u001b[96Ghoneypot\u001b[105Gno\r\u001b[4C\u001b[1Blonger\u001b[12Guses\u001b[17Ga\u001b[19Gsession.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mData privacy\r\u001b[2C