[1332.779201, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mALTCHA\u001b[10Gcaused it, and I miss\u001b[32Gd it\u001b[37Gbecause I didn't check the mail layout a\u001b[78Gter installing it. It's\u001b[102Gfixed\r\u001b[2C\u001b[1Bnow: a\u001b[10Gnew\u001b[14Gtest mai\u001b[23G uses the\u001b[33GMto Safi \u001b[43Gayout\u001b[49Gagain,\u001b[56Gwith\u001b[61Gno\u001b[64GTYPO3\u001b[70Gimprint\u001b[78Gand\u001b[82Gno\u001b[85GALTCHA\u001b[92Gvalue.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it happened:\u001b[22m ALTCHA ships\u001b[33Gits\u001b[37Gown\u001b[41Gcopy\u001b[46Gof\u001b[49GTYPO3's\u001b[57Gmail\u001b[62Gtemplate,\u001b[72Gwhich\u001b[78Guses\u001b[83Gthe\u001b[87GTYPO3\u001b[93G\"SystemEmail\"\r\u001b[2C\u001b[1Blayout with\u001b[15Gthe logo\u001b[24Gand\u001b[28Gcopyright\u001b[38Gnotice.\u001b[46GIt\u001b[49Gregisters\u001b[59Gthat\u001b[64Gcopy\u001b[69Gfor\u001b[73Gboth\u001b[78Gmail\u001b[83Gfinishers\u001b[93Gunder\u001b[99Gkey\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m2011\u001b[39m. When severa\u001b[21G template\u001b[31Gpaths\u001b[37Gare\u001b[41Gregistered,\u001b[53Gthe\u001b[57Gone\u001b[61Gwith\u001b[66Gthe\u001b[70Ghighest\u001b[78Gkey\u001b[82Gwins,\u001b[88Gand\u001b[92Gmy\u001b[95Gsite\r\u001b[2C\u001b[1Btemplate had key \u001b[38;2;177;185;249m20\u001b[39m. So after ALTCHA was installed, its template replaced the site's. ALTCHA ships\u001b[102Gthe\r\u001b[2C\u001b[1Bcopy so the solved puzzle doesn't appear as a form value in the mail.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix, in two files:\r\u001b[1B\u001b[22m  - \u001b[1mForm setup:\u001b[22m in \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m,\u001b[64Gthe\u001b[68Gsite's\u001b[75Gmail\u001b[80Gtemplate\u001b[89Gand\u001b[93Glayout\u001b[100Gpaths\r\u001b[4C\u001b[1Bnow\u001b[9Guse\u001b[13Gkey\u001b[17G\u001b[38;2;177;185;249m2100\u001b[22G\u001b[39mfor\u001b[26Gboth\u001b[31Gfinishers,\u001b[42Gso\u001b[45Gthey\u001b[50Gwin\u001b[54Gover\u001b[59GALTCHA's\u001b[68G\u001b[38;2;177;185;249m2011\u001b[39m.\u001b[74GA\u001b[76Gcomment\u001b[84Gexplains\u001b[93Gthe\u001b[97Gnumber.\r\u001b[1B \u001b[3G- \u001b[1mMail templates:\u001b[21G\u001b[22mthe site's \u001b[38;2;177;185;249mDefault.fluid.html\u001b[39m \u001b[52Gnd \u001b[38;2;177;185;249mDefault.fluid.txt\u001b[39m l\u001b[75Gave \u001b[83Gthe\u001b[87GALTCHA field, as\r\u001b[4C\u001b[1BALTCHA's\u001b[14Gown\u001b[18Gtemplate\u001b[27Gdoes.\u001b[33GOtherwise\u001b[43Gthe\u001b[47Glong\u001b[52Gencoded\u001b[60Gpuzzle\u001b[67Gsolution\u001b[76Gwould\u001b[82Gappear\u001b[89Gin\u001b[92Gthe\u001b[96Gmail.\r\u001b[1B\u001b[K\r\u001b[1B  This will happen again whenever an extension registers mail templates with a higher key. After\u001b[K\r\u001b[2C\u001b[1Binstalling or updating a form extension, check one mail in Mailpit.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing is committed yet. Still\u001b[35Gopen:\u001b[41Gthe\u001b[45Gconsent\u001b[53Gtext\u001b[58Grenders\u001b[66Gbold\u001b[71Ginstead\u001b[79Gof\u001b[82Gnormal\u001b[89Gweight,\u001b[97Gand\u001b[101Gthe\r\u001b[2C\u001b[1Bfresh-install check of \u001b[38;2;177;185;249mdata.xml\u001b[39m.\u001b[K\r\u001b[29C\u001b[2B\u001b[38;2;153;153;153m9\u001b[39m\u001b[31;1H\u001b[29;7H\u001b[?25h"]
