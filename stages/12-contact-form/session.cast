[1370.529079, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mMaking it harder\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌\u001b[37G┬\u001b[57G┬\u001b[103G┐\r\u001b[16C\u001b[1BMeasure\u001b[44GEffect\u001b[59G \u001b[61G         \u001b[71G     Downside    \u001b[89G    \u001b[94G \u001b[96G      \r\u001b[2C\u001b[1B├─────────────────────────────────┼───────────────────┼─────────────────────────────────────────────┤\r\u001b[4C\u001b[1B                          \u001b[39G      \u001b[59GA visitor's ch\u001b[74Gap phone wai\u001b[87Gs too. A factor\r\u001b[4C\u001b[1B\u001b[1mRaise ALTCHA difficulty\u001b[39G\u001b[22mEvery\u001b[45Gsolve\u001b[51Ggets\u001b[60Gof\u001b[63G10 means \u001b[73Geveral seconds\u001b[88Gon\u001b[91Ga\u001b[93Gphone,\r\u001b[2C\u001b[1B│ (\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m)      │ slower            │ but only 2 s per solve for the attacker, so │\r\u001b[38C\u001b[1B    \u001b[44G   \u001b[48G    \u001b[53G   \u001b[59G it still doesn't stop them.\u001b[88G          \r\u001b[2C\u001b[1B├─────────────────────────────────┼───────────────────┼─────────────────────────────────────────────┤\r\u001b[4C\u001b[1B        \u001b[14G    \u001b[19G \u001b[21G  \u001b[24G    \u001b[39GCaps how fast one\u001b[59GCustom code. It processes IP addresses,   \r\u001b[4C\u001b[1B\u001b[1mLimit submissions per IP \u001b[40G\u001b[22mmachine\u001b[48Gcan\u001b[59Gwhich\u001b[65Gthe\u001b[69Gprivacy\u001b[77Gpolicy\u001b[84Gmust\u001b[89Gmention.\u001b[98GAn\r\u001b[2C\u001b[1B│ \u001b[1maddress\u001b[22m, e.g. 5 an hour         │ send, whatever it │ attacker with many IP addresses can spread  │\r\u001b[4C\u001b[1B               \u001b[21G    \u001b[26G      \u001b[39G solves   \u001b[50G   \u001b[59Gout.\r\u001b[2C\u001b[1B├─────────────────────────────────┼───────────────────┼─────────────────────────────────────────────┤\r\u001b[4C\u001b[1B\u001b[1mContent filter\u001b[22m,\u001b[21Ge.g.\u001b[26Greject\u001b