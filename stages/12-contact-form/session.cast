G\u001b[1mSpam:\u001b[22m a submis\u001b[20Gion\u001b[24Gthat\u001b[29Gfills\u001b[35Gthe\u001b[39Ghidden\u001b[46Ghoneypot\u001b[55Gfield\u001b[61Gis\u001b[64Grejected\u001b[73Gand\u001b[77Gno\u001b[80Gmail\u001b[85Gis\u001b[88Gsent.\r\u001b[4C\u001b[1B\u001b[1mValid message:\u001b[22m the\u001b[24Gvisitor sees the gr\u001b[44Gen \"Asante! Your\u001b[61Gmessag\u001b[68G has\u001b[73Gbeen sent.\"\u001b[85Gbox. In Mailpit,\u001b[102Gone\r\u001b[2C\u001b[1B \u001b[5Gmail went to \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m with the visi\u001b[53Gor\u001b[56Gas \u001b[60Geply-to,\u001b[69Gand\u001b[73Ga copy went\u001b[85Gt\u001b[87G the vis\u001b[96Gtor. B\u001b[103Gth\r\u001b[4C\u001b[1Buse a Mto\u001b[15GSafi mail layout instead of the TYPO3-b\u001b[55Ganded system m\u001b[70Gil.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mForm defini\u001b[17Gion:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith\u001b[70Gthe\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[2C\u001b[1B \u001b[5Gname, email, phone, topic, message (at least 20 characters)\u001b[65Gand a consent checkbox. It's a file under\r\u001b[4C\u001b[1Bversion control, so\u001b[26Ghe back\u001b[34Gnd Forms module\u001b[50Gshows it but can't\u001b[69Gedit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepac\u001b[69G\u001b[39m:form's Bootstrap\u001b[87Gclasses\u001b[95Gwith\u001b[100Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
