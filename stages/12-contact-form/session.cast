[1455.980361, "o", "\u001b[?25l\u001b[H\u001b[3G│ Cookies        \u001b[34G│\u001b[36GNone,\u001b[42Gnot\u001b[46Geven\u001b[51Gafter\u001b[57Gsending\u001b[103G│\r\u001b[2C\u001b[1B└──────────────────────────────┴────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere the data does end up\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mThe mail to \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m.\u001b[40G\u001b[22mIt\u001b[43Gholds\u001b[49Geverything\u001b[60Gthe\u001b[64Gvisitor\u001b[72Gentered\u001b[80Gexcept\u001b[87Gthe\u001b[91Gconsent\u001b[99Gbox\u001b[103Gand\r\u001b[2C\u001b[1B  \u001b[10GALTCHA answe\u001b[23G. On DDEV that's Mailpit. On\u001b[52Gth\u001b[55G l\u001b[58Gve site it's:\u001b[K\r\u001b[2C\u001b[1B   - the outgoing ma\u001b[24Gl\u001b[26Gserver, which\u001b[40Gmay\u001b[44Gqu\u001b[47Gue the message briefly and logs sender an\u001b[89G recipient\u001b[K\r\u001b[2C\u001b[1B     \u001b[9Gddresses;\u001b[K\r\u001b[5C\u001b[1B-\u001b[8Gthe\u001b[12Gmunicipality's\u001b[27Gmail\u001b[32Gprovider\u001b[41Gand\u001b[45Gthe\u001b[49G\u001b[38;2;177;185;249minfo@\u001b[55G\u001b[39mmailbox,\u001b[64Gwhere\u001b[70Git\u001b[73Gstays\u001b[79Guntil\u001b[85Gsomeone\u001b[93Gdeletes\u001b[101Git;\r\u001b[2C\u001b[1B  \u001b[6G- everywhere the staff forward,\u001b[38Gprin\u001b[44Gor file\u001b[52Git.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mThe visitor's browser, briefly.\u001b[38G\u001b[22mIf\u001b[41Gthe\u001b[45Gform\u001b[50Gcomes\u001b[56Gback\u001b[61Gwith\u001b[66Gan\u001b[69Gerror,\u001b[76Gthe\u001b[80Gentered\u001b[88Gvalues\u001b[95Gare\u001b[99Gin\u001b[102Gthe\r\u001b[1B \u001b[3G   page and in a signed hidden\u001b[34Gfield.\u001b[41GNothing\u001b[49Gis\u001b[52Gstored\u001b[59Gon\u001b[62Gthe\u001b[66Gserver.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe web server log.\u001b[26G\u001b[22mIt\u001b[29Gkeeps\u001b[35Gthe\u001b[39GIP\u001b[42Gaddress\u001b[50Gand\u001b[54Gtime\u001b[59Gof\u001b[62Gevery\u001b[68Gsubmission,\u001b[80Gas\u001b[83Gfor\u001b[87Gevery\u001b[93Gpage\u001b[98Gview,\u001b[104Gand\r\u001b[1B     on the live server how long it's kept depends on the hosting setup.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mWhat that means for privacy\u001b[31G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAll\u001b[9Gretention\u001b[19Gand\u001b[23Gdeletion\u001b[32Ghappens\u001b[40Gin\u001b[43Gthe\u001b[47Gmailbox,\u001b[56Gunder\u001b[62Gthe\u001b[66Gmunicipality's\u001b[81Gmail\u001b[86Gpolicy.\u001b[94GThat\u001b[99Gmakes\r\u001b[1B \u001b[3G  the \u001b[38;2;177;185;249minfo@\u001b[39m mailbox the place\u001b[33Gto decide\u001b[43Gwho\u001b[47Gcan\u001b[51Gread\u001b[56Gthese\u001b[62Gmessages\u001b[71Gand\u001b[75Ghow\u001b[79Glong\u001b[84Gthey're\u001b[92Gkept.\r\u001b[1B  - Because nothing goes into TYPO3, there's nothing in TYPO3 to export or delete when a citizen asks for\u001b[K\r\u001b[4C\u001b[1Btheir data. The municipality answers such requests from the mailbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe privacy policy, still placeholder text, should say this: what the form collects, that\u001b[95Git\u001b[98Garrives\r\u001b[4C\u001b[1Bby email at the municipality, who\u001b[39Greads\u001b[45Git,\u001b[49Ghow\u001b[53Glong\u001b[58Git's\u001b[63Gkept,\u001b[69Gand\u001b[73Gthat\u001b[78Gthe\u001b[82Gweb\u001b[86Gserver\u001b[93Glogs\u001b[98GIP\r\u001b[4C\u001b[1Baddresses.\r\u001b[1B \u001b[3G-\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
