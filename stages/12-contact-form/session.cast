[52.946337, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mBad:\u001b[8G\u001b[22mChanging\u001b[17Gthe\u001b[21Gmarkup\u001b[28Gmeans\u001b[34Goverriding\u001b[45GFluid\u001b[51Gtemplates\u001b[61Gand\u001b[65Gpartials.\u001b[75GSubmissions\u001b[87Gare\u001b[91Gnot\u001b[95Gstored\u001b[102Gor\r\u001b[1B    listed\u001b[12Gin the backend unless\u001b[34Gyou\u001b[38Gadd\u001b[42Gsomething.\r\u001b[1B  ────────────────────────────────────────\r\u001b[1B  \u001b[1mOption:\u001b[11G2. powermail (third-party)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[15G\u001b[22mA\u001b[17Gpopular\u001b[25Gform\u001b[30Gextension\u001b[40Gthat\u001b[45Gstores\u001b[52Gsubmissions\u001b[64Gas\u001b[67Grecords\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[9G\u001b[22mBackend\u001b[17Glist\u001b[22Gand\u001b[26Gexport\u001b[33Gof\u001b[36Gsubmissions,\u001b[49Gextra\u001b[55Gspam\u001b[60Gchecks,\u001b[68Gmore\u001b[73Gfeatures\u001b[82Gfor\u001b[86Geditors\r\u001b[1B  \u001b[1mBad:\u001b[22m Another dependency to keep up to date, and you need to check it supports TYPO3 14.3 before\u001b[K\r\u001b[4C\u001b[1Bchoosing\u001b[14Git.\u001b[18GToo\u001b[22Gmuch\u001b[27Gfor\u001b[31Ga\u001b[33Gsimple\u001b[40Gcontact\u001b[48Gform.\r\u001b[1B \u001b[3G────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[11G3. Your own plugin\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m Your own contr\u001b[30Gller, form object, validation and mail code\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Full control\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m You have to write\u001b[26Gvalidation,\u001b[38Gspam\u001b[43Gprotection,\u001b[55Gmail\u001b[60Gand\u001b[64Gerror\u001b[70Ghandling\u001b[79Gyourself.\u001b[89GOnly\u001b[94Gworth\u001b[100Git\r\u001b[4C\u001b[1Bfor\u001b[9Gunusual\u001b[17Glogic,\u001b[24Gsuch\u001b[29Gas\u001b[32Gwriting\u001b[40Ginto\u001b[45Gyour\u001b[50Gown\u001b[54Gtables\u001b[61Gor\u001b[64Gcalling\u001b[72Gan\u001b[75GAPI.\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[11G4. External service\r\u001b[2C\u001b[1BWhat it is:\u001b[15G\u001b[22mAn\u001b[18Gembedded\u001b[27Gform\u001b[32Gfrom\u001b[37Ga\u001b[39Ghosted\u001b[46Gprovider\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[9G\u001b[22mNo\u001b[12Gcode\u001b[17Gto\u001b[20Gwrite\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[8G\u001b[22mVisitor\u001b[16Gdata\u001b[21Ggoes\u001b[26Gto\u001b[29Ga\u001b[31Gthird\u001b[37Gparty\u001b[43G(a\u001b[46GGDPR\u001b[51Gproblem),\u001b[61Git\u001b[64Glooks\u001b[70Gdifferent\u001b[80Gfrom\u001b[85Gyour\u001b[90Gsite,\u001b[96Gand\u001b[100Git\r\u001b[4C\u001b[1Bdoesn't\u001b[13Gfit\u001b[17Ga\u001b[19Gself-contained\u001b[34Gdemo.\r\u001b[2C\u001b[2B\u001b[1mMy recommendation: EXT:form, with the form shipped in the sitepackage\r\u001b[2C\u001b[2B\u001b[22m1.\u001b[6G\u001b[1mTurn it on:\u001b[18G\u001b[22madd\u001b[22G\u001b[38;2;177;185;249mtypo3/form\u001b[33G\u001b[39mto\u001b[36Gthe\u001b[40Gdependencies\u001b[53Gin\u001b[56G\u001b[38;2;177;185;249mConfiguration/Sets/Sitepackage/config.yaml\u001b[39m,\u001b[100Gnext\u001b[105Gto\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mfluid-styled-content\u001b[39m,\u001b[28G\u001b[38;2;177;185;249mnews\u001b[33G\u001b[39mand\u001b[37G\u001b[38;2;177;185;249mke_search\u001b[39m.\r\u001b[1B \u001b[3G2.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[53.279705, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mDefine the form in the sitepackage:\u001b[42G\u001b[22mput\u001b[46Git\u001b[49Gin\u001b[52Ga\u001b[54Gfile\u001b[59Glike\u001b[64G\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[53.530683, "o", "\u001b[?25l\u001b[H\u001b[3G  listed in the backend unles\u001b[34Gyou ad\u001b[41G someth\u001b[49Gng.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m2. powermail (third-party)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m A popular form extension\u001b[40Gthat\u001b[45Gstores\u001b[52Gsubmissions\u001b[64Gas\u001b[67Grecords\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Backend\u001b[17Glist \u001b[23Gnd export of submissions, \u001b[50Gxtra spam check\u001b[66G, more features\u001b[82Gfor\u001b[86Geditors\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Anoth\u001b[14Gr depende\u001b[24Gcy to keep up to date, and you\u001b[55Gneed\u001b[60Gto \u001b[64Gheck it supports TYPO3 14.3 before\r\u001b[2C\u001b[1B  choosing it. Too mu\u001b[25Gh\u001b[27Gf\u001b[29Gr a sim\u001b[37Gle con\u001b[44Gact form.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m3. Your own plugin\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m Your own controller,\u001b[36Gform\u001b[41Gobject,\u001b[49Gvalidation\u001b[60Gand\u001b[64Gmail\u001b[69Gcode\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Full cont\u001b[19Gol\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Yo\u001b[11G have \u001b[18Go write\u001b[26Gvalidation,\u001b[38Gspam\u001b[43Gprotection,\u001b[55Gmail\u001b[60Gand\u001b[64Gerror\u001b[70Ghandling\u001b[79Gyourself.\u001b[89GOnly\u001b[94Gworth\u001b[100Git\r\u001b[2C\u001b[1B  for unusual\u001b[17Gl\u001b[19Ggic, such as writing into your ow\u001b[53G tables or\u001b[64Gcalling an API.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m4. External service\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m An embedded form\u001b[32Gfrom\u001b[37Ga\u001b[39Ghosted\u001b[46Gprovider\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m No code to writ\u001b[25G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Visit\u001b[14Gr data goes\u001b[26Gto\u001b[29Ga\u001b[31Gthird\u001b[37Gparty\u001b[43G(a\u001b[46GGDPR\u001b[51Gproblem),\u001b[61Git\u001b[64Glooks\u001b[70Gdifferent\u001b[80Gfrom\u001b[85Gyour\u001b[90Gsite,\u001b[96Gand\u001b[100Git\r\u001b[2C\u001b[1B  doesn't fit \u001b[18G self-contained demo.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation: EXT:form, with the form shipped in the sitepackage\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mTurn it on:\u001b[18G\u001b[22madd\u001b[22G\u001b[38;2;177;185;249mtypo3/form\u001b[33G\u001b[39mto\u001b[36Gthe\u001b[40Gdependencies\u001b[53Gin\u001b[56G\u001b[38;2;177;185;249mConfiguration/Sets/Sitepackage/config.yaml\u001b[39m,\u001b[100Gnext\u001b[105Gto\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mfluid-styled-con\u001b[23Gent\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[33G\u001b[39mand \u001b[38;2;177;185;249mke_search\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDefine the form in the sitepackage:\u001b[22m put it\u001b[49Gin\u001b[52Ga\u001b[54Gfile\u001b[59Glike\u001b[64G\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gwith name, email, subject, message and a pr\u001b[50Gvacy ch\u001b[58Gckbox. Register that folder as a form storage\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[53.633507, "o", "\u001b[?25l\u001b[H\u001b[3G────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m2. powermail (third-party)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m A popular form extension\u001b[40Gthat\u001b[45Gstores\u001b[52Gsubmissions\u001b[64Gas\u001b[67Grecords\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Backend\u001b[17Glist \u001b[23Gnd export of submissions, \u001b[50Gxtra spam check\u001b[66G, more features\u001b[82Gfor\u001b[86Geditors\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Anoth\u001b[14Gr depende\u001b[24Gcy to keep up to date, and you\u001b[55Gneed\u001b[60Gto \u001b[64Gheck it supports TYPO3 14.3 before\r\u001b[2C\u001b[1B  choosing it. Too mu\u001b[25Gh\u001b[27Gf\u001b[29Gr a sim\u001b[37Gle con\u001b[44Gact form.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m3. Your own plugin\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m Your own controller,\u001b[36Gform\u001b[41Gobject,\u001b[49Gvalidation\u001b[60Gand\u001b[64Gmail\u001b[69Gcode\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Full cont\u001b[19Gol\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Yo\u001b[11G have \u001b[18Go write\u001b[26Gvalidation,\u001b[38Gspam\u001b[43Gprotection,\u001b[55Gmail\u001b[60Gand\u001b[64Gerror\u001b[70Ghandling\u001b[79Gyourself.\u001b[89GOnly\u001b[94Gworth\u001b[100Git\r\u001b[2C\u001b[1B  for unusual\u001b[17Gl\u001b[19Ggic, such as writing into your ow\u001b[53G tables or\u001b[64Gcalling an API.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m4. External service\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m An embedded form\u001b[32Gfrom\u001b[37Ga\u001b[39Ghosted\u001b[46Gprovider\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m No code to writ\u001b[25G\u001b[K\r\u001b