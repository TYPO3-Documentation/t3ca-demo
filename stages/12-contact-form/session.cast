[1200.902462, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty means it\u001b[91Gsign\u001b[96G puzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fine, and the change belongs in the commit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt's a hurdle, not a wall.\u001b[22m It stops bots that do\u001b[54G't run\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[4C\u001b[1Bdetermined\u001b[16Gspammer\u001b[24Gcan\u001b[28Gstill\u001b[34Gsolve\u001b[40Git\u001b[43Gcheaply:\u001b[52Gmy\u001b[55Gscript\u001b[62Gneeded\u001b[69G0.1\u001b[73Gseconds.\u001b[82GYou\u001b[86Gcan\u001b[90Graise\u001b[96Gthe\r\u001b[2C\u001b[1B  difficulty in the site\u001b[28Gsettings\u001b[37G(\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m),\u001b[65Gbut\u001b[69Gthat\u001b[74Gslows\u001b[80Gdown\u001b[85Gcheap\u001b[91Gphones\u001b[98Gtoo.\r\u001b[4C\u001b[1B\u001b[1mCleanup needs a cron\u001b[26Gjob.\u001b[22m Every page view stores one puzzle in the\u001b[72Gdatabase, and nothing\u001b[94Gdelet\u001b[101G them\r\u001b[4C\u001b[1Bau\u001b[8Gomatically. The\u001b[24Gscheduler\u001b[34Gextens\u001b[41Gon isn't installed, so pro\u001b[68Guction nee\u001b[80G a cron job running\u001b[100G\u001b[38;2;177;185;249mtypo3 \r\u001b[4C\u001b[1Baltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. I\u001b[70G's in the\u001b[80GREADME.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mReady for TYPO3\u001b[21G14.3\u001b[26Gbut not 15.\u001b[22m Th\u001b[42Gexten\u001b[48Gi\u001b[50Gn registers its form setup th\u001b[80G old TypoScript way, which\r\u001b[4C\u001b[1BTYPO3 14.2 deprecated and 15\u001b[34Gremoves. It works on 14.3\u001b[61Gbut the exte\u001b[74Gsion must be updated before any\u001b[K\r\u001b[4C\u001b[1Bmove to TYPO3 15.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mVisitors have to click \u001b[29Ghe checkbox.\u001b[42G\u001b[22mIt ver\u001b[49Gfies in under a second. Setting\u001b[81G\u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[39m would\r\u001b[4C\u001b[1Bsolve\u001b[11Gthe puzzl\u001b[21G \u001b[23Gs soo\u001b[29G as some\u001b[38Gn\u001b[40G starts filli\u001b[54Gg in the form,\u001b[69Gso it's usually done before they\u001b[102G\u001b[K\r\u001b[4C\u001b[1Breach the checkbox.\r\u001b[4C\u001b[1B\u001b[1mContent Securi\u001b[20Gy\u001b[22GPolicy:\u001b[22m the extension loosens the site's\u001b[63GCSP f\u001b[69Gr the widget (it allows \u001b[38;2;177;185;249mblob:\u001b[39m workers\u001b[K\r\u001b[4C\u001b[1Band inline sty\u001b[21Gs).\u001b[25GThat\u001b[30Gonly has an effect \u001b[50Gf the\u001b[56Gfront\u001b[62Gnd CSP\u001b[69Gis\u001b[72Gswitched on.\u001b[85G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill open from before: the consent text\u001b[44Grend\u001b[49Gr\u001b[52Gbold while\u001b[63Gthe\u001b[67Gdesign shows normal weight (a small Sa\u001b[106Gs\r\u001b[2C\u001b[1Bfix plus a\u001b[14G a\u001b[17Gset build), and the fresh-install check of \u001b[38;2;177;185;249mdata.xml\u001b[39m. Tell me if\u001b[81Gyou\u001b[85Gwant\u001b[90Geither\u001b[97Gdone,\u001b[103Gor\r\u001b[2C\u001b[1Bsay\u001b[7G\"commit\"\u001b[16Gand\u001b[20GI'll\u001b[25Gshow\u001b[30Gyou\u001b[34Gthe\u001b[38Gcommit\u001b[45Gmessage\u001b[53Gfirst.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m*\u001b[3GRuminating… \u001b[38;2;153;153;153m(2m 16s · ↓\u001b[39m \u001b[38;2;153;153;153m11.9k tokens)\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
