[1520.08031, "o", "\u001b[?25l\u001b[H\u001b[6G- \u001b[9Gverywhere th\u001b[22G staff forward, print or file\u001b[52Git.\u001b[56G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mThe visitor's browser, briefly.\u001b[22m If the form\u001b[50Gcomes back with an error, the \u001b[82Gt\u001b[85Ged values are in\u001b[102Gthe\r\u001b[5C\u001b[1Bpage and in a\u001b[20Gsigned\u001b[27Ghidden\u001b[34Gfield.\u001b[41GNothing\u001b[49Gis\u001b[52Gstored\u001b[59Gon\u001b[62Gthe\u001b[66Gserver.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe web server log.\u001b[22m It kee\u001b[33Gs the IP a\u001b[44Gdress and time of every submi\u001b[74Gsion, as for every\u001b[93Gpag\u001b[97G view, and\r\u001b[5C\u001b[1Bon the live server how\u001b[29Gl\u001b[31Gng it's kep\u001b[44Gdepends\u001b[52Gon the\u001b[59Ghosting\u001b[67Gsetup.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat that means for privacy\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAll\u001b[9Gretention and deletion happens in th\u001b[46G mailb\u001b[53Gx, under \u001b[63Ghe municipality's\u001b[81Gmail\u001b[86Gpolicy.\u001b[94GThat\u001b[99Gmakes\r\u001b[4C\u001b[1Bthe\u001b[9G\u001b[38;2;177;185;249minfo@\u001b[15G\u001b[39mmailbox\u001b[23Gthe\u001b[27Gplace\u001b[33Gto\u001b[36Gdecide\u001b[43Gwho\u001b[47Gcan\u001b[51Gread\u001b[56Gthese\u001b[62Gmessages\u001b[71Gand\u001b[75Ghow\u001b[79Glong\u001b[84Gthey're\u001b[92Gkept.\r\u001b[2C\u001b[1B- Because nothing goes into\u001b[31GTYPO3,\u001b[38Gthere's\u001b[46Gnothing\u001b[54Gin\u001b[57GTYPO3\u001b[63Gto\u001b[66Gexport\u001b[73Gor\u001b[76Gdelete\u001b[83Gwhen\u001b[88Ga\u001b[90Gcitizen\u001b[98Gasks\u001b[103Gfor\r\u001b[4C\u001b[1Btheir\u001b[11Gdata.\u001b[17GThe\u001b[21Gmunicipality\u001b[34Ganswers\u001b[42Gsuch\u001b[47Grequests\u001b[56Gfrom\u001b[61Gthe\u001b[65Gmailbox.\r\u001b[4C\u001b[1BThe\u001b[9Gprivacy policy, still pl\u001b[34Gceholder\u001b[44Gext, should\u001b[56Gsay this:\u001b[66Gwhat the form collects, that it arrives\r\u001b[4C\u001b[1Bby email at the munici\u001b[28Gality, who reads it, how long it's kept, and that the web serv\u001b[91Gr logs\u001b[98GIP\r\u001b[2C\u001b[1B \u001b[5Gaddre\u001b[11Gses.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf the per-IP spam limit we discussed is ev\u001b[49Gr added, it\u001b[61Gwould keep IP\u001b[75Gaddresses\u001b[85Gfor\u001b[89Ga\u001b[91Gshort\u001b[97Gtime\u001b[102Gand\r\u001b[2C\u001b[1B \u001b[5Gwould need its own line in the p\u001b[39Gicy.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdi\u001b[8Gn't check\u001b[18Gthe\u001b[22Glive\u001b[27Gserver's\u001b[36Gmail\u001b[41Gand\u001b[45Gserver\u001b[52Glogs,\u001b[58Gbecause\u001b[66Gthis\u001b[71Gproject\u001b[79Ghas\u001b[83Gno\u001b[86Glive\u001b[91Gserver\u001b[98Gyet.\r\u001b[2C\u001b[1BThose d\u001b[11Gpend on\u001b[19Gthe host\u001b[28Gng.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 26s · done 6:55 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255m/exit\u001b[39m                                                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✢\u001b[3GGenera\u001b[38;2;235;159;127mtin\u001b[38;2;215;119;87mg… \u001b[47G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
