[1209.166223, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────┬─────────────────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[15GCase\u001b[30G│\u001b[64GResult\u001b[104G│\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GCorrectly\u001b[15Gsolved\u001b[22Gpuzzle\u001b[30G│\u001b[32GSent,\u001b[38Gexactly\u001b[46G1\u001b[48Gmail\u001b[104G│\r\u001b[2C\u001b[1B├\u001b[30G┼\u001b[104G┤\r\u001b[4C\u001b[1BNo\u001b[8Gsolution   \u001b[32GRejected:\u001b[42G\"Please\u001b[50Gtick\u001b[55G\"I'm\u001b[60Gnot\u001b[64Ga robot\"\u001b[73Gand\u001b[77Gwait\u001b[82Guntil\u001b[88Git\u001b[91Gis\u001b[94Gchecked.\"\r\u001b[4C\u001b[2BSame so\u001b[13Guti\u001b[17Gn sent again\u001b[32GR\u001b[34Gject\u001b[39Gd, since\u001b[48Ge\u001b[50Gch\u001b[53Gpuzzle\u001b[60Gcounts\u001b[67Gonce\r\u001b[4C\u001b[2BFake solution\u001b[40G \u001b[42G       \u001b[50G    \u001b[55G    \u001b[60G   \u001b[64G \u001b[66G      \u001b[73G   \u001b[77G    \u001b[82G     \u001b[88G  \u001b[91G  \u001b[94G         \r\u001b[2C\u001b[1B└\u001b[30G┴\u001b[104G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe form still works on cached pages, because each visitor gets a fresh puzzle from an uncached\u001b[K\r\u001b[2C\u001b[1Bendpoint. I also\u001b[20Gtook\u001b[25Ga\u001b[27Gscreenshot with\u001b[43Gheadless\u001b[52GChrome:\u001b[60Gthe\u001b[64Gtwo-column\u001b[75Glayout\u001b[82Gand\u001b[86Gthe\u001b[90Gwidget\u001b[97Grender\u001b[104G\u001b[K\r\u001b[2C\u001b[1Bproperly.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhat changed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[39m is in the\u001b[52Gproject's and the sitepackage's \u001b[38;2;177;185;249mcomposer.json\u001b[39m, and the\r\u001b[2C\u001b[1B  lock file\u001b[15Gis\u001