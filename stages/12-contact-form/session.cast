th\u001b[19Glinks\u001b[39Gpayoff\u001b[46Gof\u001b[49Glink\u001b[59GAlso\u001b[64Gblocks\u001b[71Gcitizens\u001b[80Gwho\u001b[84Gpaste\u001b[90Ga\u001b[92Glink\r\u001b[2C\u001b[1B│                                 │ spam              │                                             │\r\u001b[2C\u001b[1B├─────────────────────────────────┼───────────────────┼─────────────────────────────────────────────┤\r\u001b[4C\u001b[1B                              \u001b[39GThe ma\u001b[47G serve\u001b[54G  \u001b[59G   \u001b[63G  \u001b[66G      \u001b[73G   \u001b[77G              \u001b[92G  \u001b[95G    \u001b[100G  \r\u001b[4C\u001b[1B\u001b[1mMail rules at the municipality\u001b[39G\u001b[22mor a\u001b[44Gfilter \u001b[52Gorts\u001b[59GNot\u001b[63Gin\u001b[66GTYPO3;\u001b[73Gthe\u001b[77Gmunicipality's\u001b[92GIT\u001b[95Gdoes\u001b[100Git\r\u001b[2C\u001b[1B│                                 │  the messages     │                                             │\r\u001b[2C\u001b[1B└─────────────────────────────────┴───────────────────┴─────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BKeep the honeypo\u001b[21Gand ALTCHA as\u001b[35Gthey are. Together they\u001b[59Gstop untargeted bo\u001b[78Gs,\u001b[81Gwhich is the \u001b[95Gpam\u001b[99Ga\u001b[K\r\u001b[2C\u001b[1Bmun\u001b[7Gcipal contact f\u001b[23Grm actually\u001b[35Ggets,\u001b[41Gwithout\u001b[49Gbothering\u001b[59Gvisitors.\u001b[69GRaising\u001b[77Gthe\u001b[81Gdifficulty\u001b[92Gmostly\u001b[99Ghurts\r\u001b[2C\u001b[1Bvisitors\u001b[12Gon\u001b[15Gslow\u001b[20Gphones.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
