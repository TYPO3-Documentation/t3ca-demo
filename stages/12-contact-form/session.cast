file\u001b[15Gis\u001b[18Gupdated.\r\u001b[2C\u001b[1B- \u001b[1mSite set:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mF\u001b[7Grm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA element above the button, with friendlier error texts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm setup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty means it\u001b[91Gsign\u001b[96G puzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fine, and the change belongs in the commit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B \u001b[5G                           \u001b[33G   \u001b[37G   \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1209.472836, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│ Correctly solved puzzle  │ Sent, exactly 1 mail                                                    │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ No solution              │ Rejected: \"Please tick \"I'm not a robot\" and wait until it is checked.\" │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Same solution sent again │ Rejected, since each puzzle counts once                                 │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Fake solution            │ Rejected                                                                │\r\u001b[2C\u001b[1B└──────────────────────────┴─────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gform\u001b[12Gstill\u001b[18Gworks\u001b[24Gon\u001b[27Gcached\u001b[34Gpages,\u001b[41Gbecause\u001b[49Geach\u001b[54Gvisitor\u001b[62Ggets\u001b[67Ga\u001b[69Gfresh\u001b[75Gpuzzle\u001b[82Gfrom\u001b[87Gan\u001b[90Guncached\r\u001b[2C\u001b[1Bendpoint. I a\u001b[17Gso took a\u001b[27Gscre\u001b[32Gnshot with headless Chrome: the \u001b[65Gwo-column\u001b[75Glayout\u001b[82Gand the\u001b[90Gwidget render\r\u001b[2C\u001b[1Bpro\u001b[7Gerly\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mComposer:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glock file\u001b[15Gis updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite set:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA elem\u001b[48Gnt above the\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[8C\u001b[1B\u001b[1m setup:\u001b[22m \u001b[38;2;177;185;249mConfigur\u001b[26Gtion/Form/Sitepackage/config.yaml\u001b[39m gives the element the design's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe\u001b[37Gextension\u001b[47Gadded\u001b[53Gan\u001b[56Gempty\u001b[62G\u001b[38;2;177;185;249mhmac\u001b[67G\u001b[39msetting.\u001b[76GEmpty\u001b[82Gmeans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fi\u001b[46Ge, an\u001b[53Gthe change belongs in the com\u001b[83Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m a section on ALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39md\u001b[45Gdn't chang\u001b[56G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1209.489485, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ No solution              │ Rejected: \"Please tick \"I'm not a robot\" and wait until it is checked.\" │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Same solution sent again │ Rejected, since each puzzle counts once                                 │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Fake solution            │ Rejected                                                                │\r\u001b[2C\u001b[1B└──────────────────────────┴─────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gform\u001b[12Gstill\u001b[18Gworks\u001b[24Gon\u001b[27Gcached\u001b[34Gpages,\u001b[41Gbecause\u001b[49Geach\u001b[54Gvisitor\u001b[62Ggets\u001b[67Ga\u001b[69Gfresh\u001b[75Gpuzzle\u001b[82Gfrom\u001b[87Gan\u001b[90Guncached\r\u001b[2C\u001b[1Bendpoint. I a\u001b[17Gso took a\u001b[27Gscre\u001b[32Gnshot with headless Chrome: the \u001b[65Gwo-column\u001b[75Glayout\u001b[82Gand the\u001b[90Gwidget render\r\u001b[2C\u001b[1Bpro\u001b[7Gerly\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mComposer:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glock file\u001b[15Gis updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite set:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA elem\u001b[48Gnt above the\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[8C\u001b[1B\u001b[1m setup:\u001b[22m \u001b[38;2;177;185;249mConfigur\u001b[26Gtion/Form/Sitepackage/config.yaml\u001b[39m gives the element the design's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe\u001b[37Gextension\u001b[47Gadded\u001b[53Gan\u001b[56Gempty\u001b[62G\u001b[38;2;177;185;249mhmac\u001b[67G\u001b[39msetting.\u001b[76GEmpty\u001b[82Gmeans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fi\u001b[46Ge, an\u001b[53Gthe change belongs in the com\u001b[83Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m a section on ALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39md\u001b[45Gdn't chang\u001b[56G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mIt'\u001b[10Ga hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[69Gpt\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1209.505391, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[2BSame solution\u001b[19Gsent\u001b[24Gagain\u001b[40G,\u001b[42Gsince \u001b[49Gach puzzle\u001b[60Gc\u001b[62Gunts \u001b[68Gnce \u001b[73G   \u001b[77G    \u001b[82G     \u001b[88G  \u001b[91G  \u001b[94G         \r\u001b[4C\u001b[2BF\u001b[7Gk\u001b[19G    \u001b[24G     \u001b[40G \u001b[42G     \u001b[48G    \u001b[53G      \u001b[60G      \u001b[67G    \r\u001b[2C\u001b[1B└\u001b[30G┴\u001b[104G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe form still works on cached pages, because each visitor gets a fresh puzzle from an uncached\u001b[K\r\u001b[2C\u001b[1Bendpoint.\u001b[13GI\u001b[15Galso\u001b[20Gtook\u001b[25Ga\u001b[27Gscreenshot\u001b[38Gwith\u001b[43Gheadless\u001b[52GChrome:\u001b[60Gthe\u001b[64Gtwo-column\u001b[75Glayout\u001b[82Gand\u001b[86Gthe\u001b[90Gwidget\u001b[97Grender\r\u001b[2C\u001b[1Bproperly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B  lock file is\u001b[18Gupdated.\r\u001b[4C\u001b[1B\u001b[1mSite \u001b[12Gt\u001b[36G\u001b[22m is now a dependency.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[29G\u001b[39mhas\u001b[33Gan\u001b[36GALTCHA\u001b[43Gelement\u001b[51Gabove\u001b[57Gthe\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[4C\u001b[1B\u001b[1mForm\u001b[13Gup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m s\u001b[69Gtting. Empty\u001b[82Gm\u001b[84Gans it\u001b[91Gsigns puzzles\r\u001b[4C\u001b[1Bwith TYPO3's\u001b[18Gencryption\u001b[29Gkey,\u001b[34Gwhich\u001b[40Gis\u001b[43Gfine,\u001b[49Gand\u001b[53Gthe\u001b[57Gchange\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[4C\u001b[1B\u001b[1mREADME:\u001b[22m a section on ALTCHA. \u001b[38;2;177;185;249mdata.xml\u001b[39m didn't change.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[2C\u001b[1B  determined spammer can\u001b[28Gstill\u001b[34Gsolve\u001b[40Git\u001b[43Gcheaply:\u001b[52Gmy\u001b[55Gscript\u001b[62Gneeded\u001b[69G0.1\u001b[73Gseconds.\u001b[82GYou\u001b[86Gcan\u001b[90Graise\u001b[96Gthe\r\u001b[2C\u001b[1B \u001b[5Gdifficulty in the site setting\u001b[36G (\u001b[38;2;177;185;249mal\u001b[69G\u001b[39mthat sl\u001b[77Gws down cheap phones too\u001b[103G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1209.52527, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[2BF\u001b[7Gk\u001b[19G    \u001b[24G     \u001b[40G \u001b[42G     \u001b[48G    \u001b[53G      \u001b[60G      \u001b[67G    \r\u001b[2C\u001b[1B└\u001b[30G┴\u001b[104G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe form still works on cached pages, because each visitor gets a fresh puzzle from an uncached\u001b[K\r\u001b[2C\u001b[1Bendpoint.\u001b[13GI\u001b[15Galso\u001b[20Gtook\u001b[25Ga\u001b[27Gscreenshot\u001b[38Gwith\u001b[43Gheadless\u001b[52GChrome:\u001b[60Gthe\u001b[64Gtwo-column\u001b[75Glayout\u001b[82Gand\u001b[86Gthe\u001b[90Gwidget\u001b[97Grender\r\u001b[2C\u001b[1Bproperly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B  lock file is\u001b[18Gupdated.\r\u001b[4C\u001b[1B\u001b[1mSite \u001b[12Gt\u001b[36G\u001b[22m is now a dependency.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[29G\u001b[39mhas\u001b[33Gan\u001b[36GALTCHA\u001b[43Gelement\u001b[51Gabove\u001b[57Gthe\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[4C\u001b[1B\u001b[1mForm\u001b[13Gup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m s\u001b[69Gtting. Empty\u001b[82Gm\u001b[84Gans it\u001b[91Gsigns puzzles\r\u001b[4C\u001b[1Bwith TYPO3's\u001b[18Gencryption\u001b[29Gkey,\u001b[34Gwhich\u001b[40Gis\u001b[43Gfine,\u001b[49Gand\u001b[53Gthe\u001b[57Gchange\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[4C\u001b[1B\u001b[1mREADME:\u001b[22m a section on ALTCHA. \u001b[38;2;177;185;249mdata.xml\u001b[39m didn't change.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[2C\u001b[1B  determined spammer can\u001b[28Gstill\u001b[34Gsolve\u001b[40Git\u001b[43Gcheaply:\u001b[52Gmy\u001b[55Gscript\u001b[62Gneeded\u001b[69G0.1\u001b[73Gseconds.\u001b[82GYou\u001b[86Gcan\u001b[90Graise\u001b[96Gthe\r\u001b[2C\u001b[1B \u001b[5Gdifficulty in the site setting\u001b[36G (\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m), but that sl\u001b[77Gws down cheap phones too\u001b[103G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every page view stores one puzzl\u001b[64G in the database,\u001b[82Gand\u001b[86Gnothing deletes\u001b[102Gthem\r\u001b[4C\u001b[1Bautomatically. The scheduler extens\u001b[69Gction needs a cron job ru\u001b[95Gning \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
