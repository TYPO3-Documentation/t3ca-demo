l\u001b[9Gretention and\u001b[23Gdeletion happens in\u001b[43Gt\u001b[45Ge\u001b[47Gm\u001b[49Gilbox,\u001b[56Gunder\u001b[62Gthe municipality's mail policy. That\u001b[99Gmakes\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[38;2;177;185;249minfo@\u001b[39m ma\u001b[18Glbox the place to decide who can read these messages and how long they're kept.\u001b[98G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GBecause nothing\u001b[21Ggoes \u001b[27Gnto TYPO3, there's nothing in TYPO3 to export or\u001b[76Gdelete\u001b[83Gwhen\u001b[88Ga\u001b[90Gcitizen\u001b[98Gasks\u001b[103Gfor\r\u001b[2C\u001b[1B \u001b[5Gt\u001b[8Gir data.\u001b[17GThe municipa\u001b[30Gity answers such requests\u001b[56Gfrom the mailbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe pr\u001b[12Gvacy\u001b[17Gpolicy, stil\u001b[30G place\u001b[38Gld\u001b[41Gr tex\u001b[49Gshou\u001b[54Gd say this: what the form collects, that it\u001b[98Garrives\r\u001b[4C\u001b[1Bby email at\u001b[17Gthe\u001b[21Gmunicipality,\u001b[35Gwho\u001b[39Greads\u001b[45Git,\u001b[49Ghow\u001b[53Glong\u001b[58Git's\u001b[63Gkept,\u001b[69Gand\u001b[73Gthat\u001b[78Gthe\u001b[82Gweb\u001b[86Gserver\u001b[93Glogs\u001b[98GIP\r\u001b[2C\u001b[1B \u001b[5Gaddresses.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf the p\u001b[14Gr-IP spam\u001b[26Gmit we discussed is\u001b[46Gever\u001b[51Gadded,\u001b[58Git\u001b[61Gwould\u001b[67Gkeep\u001b[72GIP\u001b[75Gaddresses\u001b[85Gfor\u001b[89Ga\u001b[91Gshort\u001b[97Gtime\u001b[102Gand\r\u001b[4C\u001b[1Bwould\u001b[11Gneed\u001b[16Gits\u001b[20Gown\u001b[24Gline\u001b[29Gin\u001b[32Gthe\u001b[36Gpolicy.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI didn't check the live server's\u001b[36Gmail\u001b[41Gand\u001b[45Gserver\u001b[52Glogs,\u001b[58Gbecause\u001b[66Gthis\u001b[71Gproject\u001b[79Ghas\u001b[83Gno\u001b[86Glive\u001b[91Gserver\u001b[98Gyet.\r\u001b[2C\u001b[1BThose\u001b[9Gdepend\u001b[16Gon\u001b[19Gthe\u001b[23Ghosting.\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
