[631.425142, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I tested on \u001b]8;id=12ra721;https://demo.ddev.site/contact\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/contact\u001b]8;;\u0007\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong input:\u001b[18G\u001b[22meach\u001b[23Gbad\u001b[27Gfield\u001b[33Gshows\u001b[39Gits\u001b[43Gown\u001b[47Gmessage\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[4C\u001b[1Bdesign's\u001b[14Gstyles.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpam:\u001b[11G\u001b[22ma\u001b[13Gsubmission that\u001b[29Gfil\u001b[33Gs the hidden h\u001b[49Geypot field is rejected\u001b[73Gand\u001b[77Gno\u001b[80Gmail\u001b[85Gis\u001b[88Gsent.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[20G\u001b[22mth\u001b[23G visitor sees the green \"Asante! Your message\u001b[69Ghas\u001b[73Gbeen\u001b[78Gsent.\"\u001b[85Gbox.\u001b[90GIn\u001b[93GMailpit,\u001b[102Gone\r\u001b[4C\u001b[1Bmail went to \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m with the visitor as reply-to, and a copy went to the visitor.\u001b[101GBoth\r\u001b[4C\u001b[1Buse a\u001b[11GMto\u001b[15GSafi\u001b[20Gmail\u001b[25Glay\u001b[29Gut instead of \u001b[44Ghe TYPO3-branded system mail.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\u001b[19G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith\u001b[70Gthe\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[4C\u001b[1Bname, email, phone, topic, message (at least 20 charac\u001b[60Gers) and a consent checkbox. It's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[4C\u001b[1Bversion control, so the backend Fo\u001b[40Gms module show\u001b[55G it but can't edit \u001b[75Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[57G\u001b[39mreplaces\u001b[66GEXT:form's\u001b[77GBootstrap\u001b[87Gclasses\u001b[95Gwith\u001b[100Gthe\r\u001b[4C\u001b[1Bdesign's classes. The only template override is \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds \u001b[38;2;177;185;249mclass=\"form\"\u001b[39m to the\u001b[101Gform\r\u001b[4C\u001b[1Btag because a form definition can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a site layout and templates under \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m. The consent checkbox\u001b[103Gis\r\u001b[4C\u001b[1Bleft out of the\u001b[21Gmails.\r\u001b[1B  - \u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m is\u001b[27Gnow\u001b[31Ga\u001b[33Gdependency\u001b[44Gof\u001b[47Gthe\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m.\u001b[20GThe\u001b[24G\u001b[38;2;177;185;249mcomposer.lock\u001b[38G\u001b[39mupdate\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[1B \u001b[3G  required but the lock h\u001b[29Gd missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[19G\u001b[22ma\u001b[21Gnew\u001b[25Gscript,\u001b[33G\u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m,\u001b[77Gruns\u001b[82Gafter\u001b[88G\u001b[38;2;177;185;249mseed-pages.php\u001b[39m.\u001b[104GIt\r\u001b[1B \u001b[3G  sw\u001b[8Gtches the page to the \"Sidebar\u001b[39Gright\"\u001b[46Glayout,\u001b[54Gputs\u001b[59Gthe\u001b[63Gform\u001b[68Gin\u001b[71Gthe\u001b[75Gmain\u001b[80Garea\u001b[85Gand\u001b[89Gmoves\u001b[95Gthe\u001b[99Gaddress,\r\u001b[4C\u001b[1Bopening\u001b[13Ghours\u001b[19Gand\u001b[23G\"Report\u001b[31Ga\u001b[33Gproblem\"\u001b[42Ginto\u001b[47Gthe\u001b[51Gsidebar.\u001b[60GI\u001b[62Gre-exported\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[84Gand\u001b[88Gthe\u001b[92Gdiff\u001b[97Gcontains\r\u001b[1B \u001b[3G  only those changes. The README explains all of this.\u001b[K\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[631.557816, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mWrong input:\u001b[18G\u001b[22meach\u001b[23Gbad\u001b[27Gfield\u001b[33Gshows\u001b[39Gits\u001b[43Gown\u001b[47Gmessage\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[2C\u001b[1B  design's styles.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam:\u001b[22m a submission that fill\u001b[34G the\u001b[39Ghidden honeypot\u001b[55Gfield\u001b[62Gs\u001b[64Greject\u001b[71Gd and no mail is\u001b[88Gs\u001b[90Gnt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[22m the\u001b[24Gvisitor\u001b[32Gsees\u001b[37Gthe\u001b[41Ggreen\u001b[47G\"Asante!\u001b[56GYour\u001b[61Gmessage\u001b[69Ghas\u001b[73Gbeen\u001b[78Gsent.\"\u001b[85Gbox.\u001b[90GIn\u001b[93GMailpit,\u001b[102Gone\r\u001b[2C\u001b[1B \u001b[5Gmail went to \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39G\u001b[39mw\u001b[41Gth the visitor as reply-to, an\u001b[74G copy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe visitor.\u001b[101GBoth\r\u001b[2C\u001b[1B \u001b[5Guse a Mto Safi\u001b[20Gmail layout\u001b[32Ginstead of the\u001b[47GTYPO3-branded\u001b[61Gsy\u001b[64Gtem mail.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith\u001b[70Gthe\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[2C\u001b[1B  name, email, phone,\u001b[25Gtopic,\u001b[32Gmessage\u001b[40G(at\u001b[44Gleast\u001b[50G20\u001b[53Gcharacters)\u001b[65Gand\u001b[69Ga\u001b[71Gconsent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B \u001b[5Gversion control,\u001b[22Gso the backend Forms module shows it but can'\u001b[68G edit\u001b[74Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes with the\u001b[K\r\u001b[4C\u001b[1Bd\u001b[7Gsign's classes. The only t\u001b[34Gmplate overrid\u001b[50Gis \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag because a form definition can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and templates und\u001b[45G \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m. The consent\u001b[94Gcheckbox is\r\u001b[4C\u001b[1Bleft out of\u001b[17Gthe mails.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m is \u001b[28Gow a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cm\u001b[74G-f\u001b[79G\u001b[39m is in\u001b[86Gthe si\u001b[93Gepackage's\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[38G\u001b[39mupdate\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[2C\u001b[1B \u001b[5Grequired but the lock\u001b[27Ghad\u001b[31Gmissed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m a n\u001b[23Gw script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m,\u001b[77Gruns after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m.\u001b[104GIt\r\u001b[4C\u001b[1Bswitch\u001b[12Gs\u001b[14Gthe\u001b[18Gpage to t\u001b[28Ge \"S\u001b[33Gdebar\u001b[39Gright\"\u001b[46Glayout,\u001b[54Gputs\u001b[59Gthe\u001b[63Gform\u001b[68Gin\u001b[71Gthe\u001b[75Gmain\u001b[80Garea\u001b[85Gand\u001b[89Gmoves\u001b[95Gthe\u001b[99Gaddress,\r\u001b[2C\u001b[1B \u001b[5Gopening hours\u001b[20Gnd \"Report a\u001b[33Gproblem\" into the sidebar. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m, and\u001b[88Gthe diff contains\u001b[K\r\u001b[4C\u001b[1Bonly those chan\u001b[22Gs. The README explains a\u001b[47Gl \u001b[50Gf this.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[31;1H\u001b[29;3H\u001b[?25h"]
