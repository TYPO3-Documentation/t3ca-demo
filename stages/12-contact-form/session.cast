[951.708628, "o", "\u001b[?25l\u001b[H\u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 34 -\u001b[38;2;248;248;242m      senderName: 'Mto Safi Municipality'                                                \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 35 -\u001b[38;2;248;248;242m      replyToRecipients:                                                                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 36 -\u001b[38;2;248;248;242m        info@mtosafi.example: 'Mto Safi Municipality'                                    \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 37 -\u001b[38;2;248;248;242m      addHtmlPart: true                                                                  \u001b[101G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 38 -\u001b[38;2;248;248;242m      attachUploads: false                                                               \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 39 -\u001b[38;2;248;248;242m  -                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 28 \u001b[15G\u001b[22m\u001b[38;2;166;226;46midentifier:\u001b[27G\u001b[38;2;230;219;116mConfirmation\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 29 \u001b[22m \u001b[12G   \u001b[38;2;166;226;46moptions:\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 42 -\u001b[38;2;248;248;242m      message: '<div class=\"alert alert--success\"><strong>Asante! Your message has been s\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m    -\u001b[38;2;248;248;242ment.</strong><p>\u001b[48;2;92;2;0mWe\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mhave\u001b[48;2;61;1;0m \u001b[48;2;92;2;0msent\u001b[48;2;61;1;0m \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mcopy \u001b[48;2;61;1;0mto your email address \u001b[48;2;92;2;0mand will answer \u001b[48;2;61;1;0mwithin five wor\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242mking days.</p></div>'                                                                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 30 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46mmessage:\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m'<div class=\"alert alert--success\"><strong>Asante! Your message has been s\r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;230;219;116ment.</strong><p>\u001b[48;2;4;71;0mThe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mright\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mdepartment\u001b[48;2;2;40;0m \u001b[48;2;4;71;0manswers\u001b[48;2;2;40;0m to your email address within five working da\u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;230;219;116mys.</p></div>'\u001b[38;2;248;248;242m                                                                           \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[2m 31 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 32 \u001b[11G\u001b[22m\u001b[38;2;166;226;46mrenderables:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 33 \u001b[22m   -\u001b[K\r\u001b[2C\u001b[2BUpdating README\u001b[19Gf\u001b[21Gr removed\u001b[31Gvisitor\u001b[39Gcopy\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[951.776172, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m205 -\u001b[38;2;248;248;242mand\u001b[16Ga copy goes to \u001b[32Ghe visitor. Both mails\u001b[55Gare\u001b[59Gsent\u001b[64Gfrom\u001b[69G`noreply@mtosafi.example`;\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m206 -\u001b[38;2;248;248;242mthe\u001b[16Gserver that sends the\u001b[38Gmail\u001b[43Ghas\u001b[47Gto\u001b[50Gbe\u001b[53Gallowed\u001b[61Gto\u001b[64Gsend\u001b[69Gfor\u001b[73Gthat\u001b[78Gdomain.\u001b[86GEditors\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m207 -\u001b[38;2;248;248;242mchange\u001b[19Gthe recipient in th\u001b[39G con\u001b[44Gent eleme\u001b[54Gt (\"Override\u001b[67Gfinisher\u001b[76Gsettings\")\u001b[87Gwithout\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m208 -\u001b[38;2;248;248;242mtouching \u001b[22Ghe file. Th\u001b[35Gmails\u001b[41Guse\u001b[45Gthe\u001b[49Glayout\u001b[56Gof\u001b[59Gthe\u001b[63Gsite,\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m209 -\u001b[38;2;248;248;242m`Resources/Priv\u001b[28Gte/Extensions/Form/Layouts/Email.fluid.html`\u001b[73Gand\u001b[77G`.txt`,\u001b[85Ginstead\u001b[93Gof\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m210 -\u001b[38;2;248;248;242mthe\u001b[16Gcore\u001b[21Glayout\u001b[28G\"SystemEmail\"\u001b[42Gwith\u001b[47Gthe\u001b[51GTYPO3\u001b[57Glogo.\u001b[63GThe\u001b[67Gconsent\u001b[75Gcheckbox\u001b[84Gis\u001b[87Gleft\u001b[92Gout\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 211 -\u001b[38;2;248;248;242mof them. On DDEV they land in Mailpit (`ddev launch -m`).                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 204 +\u001b[38;2;248;248;242mA message goes to `info@mtosafi.example`, with the visitor's address as reply-to\u001b[48;2;4;71;0m.\u001b[48;2;2;40;0m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 205 +\u001b[38;2;248;248;242mIt is sent from `noreply@mtosafi.example`; the server that sends the mail has to be     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 206 +\u001b[38;2;248;248;242mallowed to send for that domain. Editors change the recipient in the content            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 207 +\u001b[38;2;248;248;242melement (\"Override finisher settings\") without touching the file. The mail uses the     \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m2\u001b[9G8 +\u001b[38;2;248;248;242mlayout of the site, `Resources/Private/Extensions/Form/Layouts/Email.fluid.html` and    \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m209 +\u001b[38;2;248;248;242m`.txt`, instead of the core layout \"SystemEmail\" with the TYPO3 logo. The consent       \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m210 +\u001b[38;2;248;248;242mcheckbox is left out of it. On DDEV it lands in Mailpit (`ddev mailpit`).               \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m2\u001b[9G1 \r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 212 +\u001b[38;2;248;248;242mThe visitor gets no copy by mail, only the confirmation on the page. A copy would go    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 213 +\u001b[38;2;248;248;242mto whatever address was entered, with the text that was entered, so anybody could       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 214 +\u001b[38;2;248;248;242muse the form to send mail from the municipality's domain to a stranger, and a           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 215 +\u001b[38;2;248;248;242mmistyped address would hand the message to somebody else.                               \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 216 +\u001b[38;2;248;248;242m                                                                                        \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 217 \u001b[22m A honeypot\u001b[23Gfield\u001b[29Gkeeps\u001b[35Gsimple\u001b[42Gbots\u001b[47Gout.\u001b[52GNothing\u001b[60Gis\u001b[63Gstored\u001b[70Gin\u001b[73Gthe\u001b[77Gdatabase:\u001b[87Gthe\r\u001b[5C\u001b[1B\u001b[2m 218 \u001b[22m mails are the\u001b[26Gonly\u001b[31Gcopy\u001b[36Gof\u001b[39Ga\u001b[41Gmessage.\r\u001b[5C\u001b[1B\u001b[2m 219 \u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed b\u001b[17Gauto\u001b[22Gm\u001b[24Gde\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[3GProofing…\u001b[15G\u001b[38;2;153;153;153m5\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
