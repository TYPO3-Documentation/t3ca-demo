[1207.589927, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[2BNo solution  \u001b[19G    \u001b[24G     \u001b[40G:\u001b[42G\"Pleas\u001b[49G tick \"I'm\u001b[60Gn\u001b[62Gt a r\u001b[68Gbot\"\u001b[73Gand\u001b[77Gwait\u001b[82Guntil\u001b[88Git\u001b[91Gis\u001b[94Gchecked.\"\r\u001b[4C\u001b[2BS\u001b[7Gm\u001b[19Gsent\u001b[24Gagain\u001b[40G,\u001b[42Gsince\u001b[48Geach\u001b[53Gpuzzle\u001b[60Gcounts\u001b[67Gonce\r\u001b[2C\u001b[1B├\u001b[30G┼\u001b[104G┤\r\u001b[2C\u001b[1B│\u001b[5GFake\u001b[10Gsolution\u001b[30G│\u001b[32GRejected\u001b[104G│\r\u001b[2C\u001b[1B└──────────────────────────┴─────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe form still\u001b[18Gworks\u001b[24Gon\u001b[27Gcached\u001b[34Gpages,\u001b[41Gbecause\u001b[49Geach\u001b[54Gvisitor\u001b[62Ggets\u001b[67Ga\u001b[69Gfresh\u001b[75Gpuzzle\u001b[82Gfrom\u001b[87Gan\u001b[90Guncached\r\u001b[2C\u001b[1Bendpoint.\u001b[13GI\u001b[15Galso\u001b[20Gtook\u001b[25Ga\u001b[27Gscreenshot\u001b[38Gwith\u001b[43Gheadless\u001b[52GChrome:\u001b[60Gthe\u001b[64Gtwo-column\u001b[75Glayout\u001b[82Gand\u001b[86Gthe\u001b[90Gwidget\u001b[97Grender\r\u001b[2C\u001b[1Bproperly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mCompo\u001b[12Gr\u001b[36G\u001b[22m\u001b[38;2;177;185;249m ^2.0\u001b[39m is in the project's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glock file is updated.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSite\u001b[13G:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[39m is now a dependency.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[29G\u001b[39mhas\u001b[33Gan\u001b[36GALTCHA\u001b[43Gelement\u001b[51Gabove\u001b[57Gthe\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[4C\u001b[1B\u001b[1mForm setup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m gives th\u001b[69G element the\u001b[82Gd\u001b[84Gsign's\u001b[91G\u001b[38;2;177;185;249mform-field\u001b[39m\u001b[K\r\u001b[4C\u001b[1Bclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extension added an empty\u001b[62G\u001b[38;2;177;185;249mhmac\u001b[67G\u001b[39msetting.\u001b[76GEmpty\u001b[82Gmeans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[4C\u001b[1Bwith\u001b[10GTYPO3's\u001b[18Gencryption\u001b[29Gkey,\u001b[34Gwhich\u001b[40Gis\u001b[43Gfine,\u001b[49Gand\u001b[53Gthe\u001b[57Gchange\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[2C\u001b[1B- \u001b[1mREADME:\u001b[22m a section on ALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[22m It \u001b[36Gtops\u001b[69Gpt or d\u001b[77Gn't solve ALTCHA puzzles\u001b[103GA\u001b[31;1H\u001b[29;3H\u001b[?25h"]
