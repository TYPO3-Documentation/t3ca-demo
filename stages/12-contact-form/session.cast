der\u001b[53G\u001b[39min\u001b[56G\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m.\u001b[100GThey\u001b[105Gdo\r\u001b[2C\u001b[1Bnot\u001b[7Ging \u001b[12Gow, but if an editor ev\u001b[36Gr adds a copy to\u001b[53Ganother form, \u001b[68Gt gets\u001b[75Gthe site's mail\u001b[91Glayout\u001b[98Ginstead\r\u001b[2C\u001b[1Bof the TYPO3 one. \u001b[38;2;177;185;249mdata.xml\u001b[30G\u001b[39mdidn't chang\u001b[43G,\u001b[45Gbecause the\u001b[57Gcopy was defined only in the form file\r\u001b[2C\u001b[2BThe \u001b[8Gres\u001b[12G-instal\u001b[20G check of \u001b[38;2;177;185;249mdata.xml\u001b[39G\u001b[39mis still open, and nothing is committed yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 32s · done 6:47 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhat about spam protection?\u001b[39m                                                                             \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m·\u001b[3GKneading… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
