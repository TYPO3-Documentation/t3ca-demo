[620.110125, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm\u001b[7Gsnapshotting\u001b[20Gthe\u001b[24Gcurrent\u001b[32Gdatabase,\u001b[42Grecreating\u001b[53Git\u001b[56Gempty\u001b[62Gto\u001b[65Grun\u001b[69Gthe\u001b[73GREADME\u001b[80Gsetup\u001b[86Gfresh,\u001b[93Gthen\u001b[98Grestoring\r\u001b[2C\u001b[1Bthe snapshot so your\u001b[24Ginstallation\u001b[37Gis\u001b[40Gleft\u001b[45Gas\u001b[48Git\u001b[51Gwas.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[39m \u001b[3G\u001b[38;2;153;153;153mDid not run \u001b[1m1\u001b[22m call \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ddev snapshot --name after-contact-form 2>&1 | tail -1 && ddev mysql -uroot -proot -e \"DROP \r\u001b[5C\u001b[1BDATABASE db; CREATE DATABASE db; GRANT ALL ON db.* TO 'db'@'%';\" && PW=\"Ts$(openssl rand -hex 8)!a9\" \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m&& ddev exe\u001b[18G bash -c \"TYPO3_DB_DRIVER=mysqli TYPO3_DB_HOST=db TYPO3_DB_PORT=3306 TYPO3_DB_DBNAME=db \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mTYPO…\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Blocked by auto mode · /permissions to\u001b[45Greview\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m│\u001b[22m \u001b[38;2;153;153;153mAuto mod\u001b[17G:\u001b[19G[Destructive or Unwanted Actions]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The safety check blocked the database drop, so nothing\u001b[58Gran\u001b[62Gand\u001b[66Gyour\u001b[71Ginstall\u001b[79Gstill\u001b[85Ghas\u001b[89Gthe\u001b[93Gseeded\r\u001b[2C\u001b[1Bcontent. I'm finishing the docs and leaving the fresh-install\u001b[65Gproof\u001b[71Gto\u001b[74Gyou.\u001b[38;2;153;153;153m · summary\r\u001b[2B●\u001b[3G\u001b[39mRunning \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3 - <<'EOF'\u001b[26G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mf='README.md'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mt=open(f).read()\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mdef rep(old,new):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mglobal t…\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
