[410.759152, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 68 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 69 \u001b[22m     \u001b[38;2;166;226;46mfinishersDefinition:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m70\u001b[17G\u001b[22m\u001b[38;2;117;113;94m# The mails of a form go out in the site's own layout. The core template\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFlush, render\u001b[17Gagain, then send an invalid and a valid submission:\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mValidation shows 6 errors\u001b[29G(all\u001b[34Ginvalid\u001b[42Gfields)\u001b[50Gand\u001b[54Gthe\u001b[58Gvalid\u001b[64Gsubmission\u001b[75Gshows\u001b[81Gthe\u001b[85Gconfirmation.\u001b[99GChecking\r\u001b[2C\u001b[1Bthe\u001b[7Gerror\u001b[13Gtexts\u001b[19Gand\u001b[23Gthe\u001b[27Gmails\u001b[33Gin\u001b[36GMailpit:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth emails have the\u001b[24Gcorrect\u001b[32Gsender,\u001b[40Grecipient\u001b[50Gand\u001b[54Greply-to.\u001b[64GThe\u001b[68Gphone\u001b[74Gerror\u001b[80Gpoints\u001b[87Gto\u001b[90Ga\u001b[92Gnonexistent\r\u001b[2C\u001b[1Bfield\u001b[9Gdescription,\u001b[22Gso\u001b[25GI'm\u001b[29Ggiving\u001b[36Git\u001b[39Gits\u001b[43Gown\u001b[47Gmessage,\u001b[56Gand\u001b[60GI'm\u001b[64Gchecking\u001b[73Gthe\u001b[77Gvisitor's\u001b[87Gcopy\u001b[92Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTw\u001b[6G more fixes are in progress: the plain-text gr\u001b[53Geting\u001b[59Gruns\u001b[64Ginto\u001b[69Gthe\u001b[73Gnext\u001b[78Gparagraph,\u001b[89Gand\u001b[93Gthe\u001b[97Gconsent\r\u001b[1B  checkbox shows as \"Privacy policy: 1\" in both mails. I'm hiding the checkbox in the mails, since consent\r\u001b[2C\u001b[1Bis\u001b[6Grequired anyway, as the core already does for static text.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\r\u001b[20C\u001b[2B\u001b[38;2;153;153;153m9\u001b[43Gthought for 5s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
