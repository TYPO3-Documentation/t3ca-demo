\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIf you can solve this puzzle so quickly cant an attacker do the same?\u001b[39m                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3\u001b[16G-I\u001b[19G- <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mimport subprocess,json,hashlib,time\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mdef curl(u): return subprocess.run(['curl','-sk',u],capture_output=True,text=True).stdout\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mts=[]\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mfor i in range(10):…\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
