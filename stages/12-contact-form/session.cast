[725.510989, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m, wi\u001b[68Gh the\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[2C\u001b[1B \u001b[5Gname, email, phone, topic, message (at least 20 characters) and a consent checkbox. It's a file under\r\u001b[4C\u001b[1Bv\u001b[7Grsion control, so the back\u001b[34Gnd Forms modul\u001b[50Gshows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[57G\u001b[39mreplaces\u001b[66GEXT:form's\u001b[77GBootstrap\u001b[87Gclasses\u001b[95Gwith\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's\u001b[14Gclasses. The only template ov\u001b[45Gride is \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds \u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto the form\r\u001b[4C\u001b[1Btag because\u001b[17Ga form definition\u001b[35Gcan't\u001b[41Gset\u001b[45Git.\r\u001b[4C\u001b[1B\u001b[1mMails:\u001b[22m a site layout a\u001b[28Gd templates under \u001b[38;2;177;185;249mResources/Private/Extension\u001b[74G/F\u001b[79G/\u001b[39m. The\u001b[86Gconsen\u001b[93G checkbox is\r\u001b[4C\u001b[1Bleft out of the mails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m is\u001b[27Gnow\u001b[31Ga dependency\u001b[44Gof\u001b[47Gthe\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mcomposer.json\u001b[39m. Th\u001b[23G \u001b[38;2;177;185;249mcomposer.lock\u001b[39m update also adds \u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m, which\u001b[77Gthe sitepackage already\u001b[K\r\u001b[4C\u001b[1Brequir\u001b[12Gd\u001b[14Gbut\u001b[18Gthe lock \u001b[28Gad m\u001b[33Gssed.\u001b[39G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[20G\u001b[22m new script,\u001b[33G\u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m, runs after\u001b[88G\u001b[38;2;177;185;249mseed-pages.php\u001b[39m. It\r\u001b[4C\u001b[1Bswitches the pa\u001b[22G to the \"Sidebar right\" \u001b[47Gay\u001b[50Gut, puts\u001b[59Gthe\u001b[63Gform\u001b[68Gin\u001b[71Gthe\u001b[75Gmain\u001b[80Garea\u001b[85Gand\u001b[89Gmoves\u001b[95Gthe\u001b[99Gaddress,\r\u001b[4C\u001b[1Bopening\u001b[13Ghours\u001b[19Gand\u001b[23G\"Report\u001b[31Ga\u001b[33Gproblem\"\u001b[42Ginto\u001b[47Gthe\u001b[51Gsidebar.\u001b[60GI\u001b[62Gre-exported\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[84Gand\u001b[88Gthe\u001b[92Gdiff\u001b[97Gcontains\r\u001b[2C\u001b[1B  only those\u001b[16Gchanges.\u001b[25GThe\u001b[29GREADME\u001b[36Gexplains\u001b[45Gall\u001b[49Gof\u001b[52Gthis.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFresh-install check:\u001b[22m this needs an empty databas\u001b[54G, and the safety\u001b[71Gcheck blocked m\u001b[87G from dropping it.\r\u001b[4C\u001b[1BYour installation is unchanged by that attempt. To\u001b[56Grun it y\u001b[65Gurself, either follow \"Starting\u001b[97Gover\"\u001b[103Gand\r\u001b[4C\u001b[1B\"Fresh install\" in the\u001b[28Groot\u001b[33G\u001b[38;2;177;185;249mREADME.md\u001b[39m,\u001b[44Gor\u001b[47Gtell\u001b[52Gme\u001b[55Gto\u001b[58Ggo\u001b[61Gahead\u001b[67Gand\u001b[71GI'll\u001b[76Gdo\u001b[79Git\u001b[82Gbetween\u001b[90Gtwo\u001b[94Gdatabase\r\u001b[2C\u001b[1B \u001b[5Gsnapshots and\u001b[19Grestore yours aft\u001b[37Grwards. A snapshot from bef\u001b[65Gre my\u001b[71Gchang\u001b[77Gs exists\u001b[86Gas\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mbefore-contact-form\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mVisual ch\u001b[15Gck:\u001b[22m I only check\u001b[32Gd the\u001b[38GHT\u001b[69G. Please look \u001b[86Gthe two-column\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[725.552307, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Buse\u001b[9Ga\u001b[11GMto\u001b[15GSafi\u001b[20Gmail\u001b[25Glayout\u001b[32Ginstead\u001b[40Gof\u001b[43Gthe\u001b[47GTYPO3-branded\u001b[61Gsystem\u001b[68Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's buil\u001b[17G:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22m \u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith the fields from \u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[4C\u001b[1Bname, email, phone,\u001b[26Gopic, m\u001b[34Gssage (at least\u001b[50G20 characters) and\u001b[69Ga consent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B \u001b[5Gversion control, so the backend Forms module shows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes wi\u001b[99G the\u001b[K\r\u001b[4C\u001b[1Bdesign's classes. Th\u001b[26G o\u001b[29Gly template\u001b[41Goverride\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m,\u001b[70Gwhich\u001b[76Gadds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag bec\u001b[13Gu\u001b[15Ge a\u001b[19Gform defini\u001b[31Gion can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and\u001b[30Gtemplates\u001b[40Gunder\u001b[46G\u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out of the mail\u001b[26G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtyp\u001b[17G3/form\u001b[24G\u001b[39mis now a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cms-form\