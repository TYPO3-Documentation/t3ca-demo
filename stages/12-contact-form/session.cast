[1456.521011, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere the data does end up\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mThe mail \u001b[16Go\u001b[18G\u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m.\u001b[40G\u001b[22mIt\u001b[43Gholds\u001b[49Geverything\u001b[60Gthe\u001b[64Gvisitor\u001b[72Gentered\u001b[80Gexcept\u001b[87Gthe\u001b[91Gconsent\u001b[99Gbox\u001b[103Gand\r\u001b[5C\u001b[1Bthe\u001b[10GALTCHA\u001b[17Ganswer.\u001b[25GOn\u001b[28GDDEV\u001b[33Gthat's\u001b[40GMailpit.\u001b[49GOn\u001b[52Gthe\u001b[56Glive\u001b[61Gsite\u001b[66Git's:\r\u001b[2C\u001b[1B  \u001b[6G- the outgoing mail server, which\u001b[40Gmay queue the message briefly and logs s\u001b[81Gnd\u001b[84Gr and recipient\u001b[K\r\u001b[5C\u001b[1B  addresses;\u001b[K\r\u001b[11C\u001b[1Bm\u001b[14Gnic\u001b[18Gpality's mail prov\u001b[37Gder \u001b[42Gnd the \u001b[38;2;177;185;249minfo@\u001b[39m mailbox, where\u001b[70Git stay\u001b[79Guntil someon\u001b[92G del\u001b[97Gtes\u001b[101Git;\r\u001b[5C\u001b[1B-\u001b[8Geve\u001b[12Gywh\u001b[16Gre\u001b[19Gthe\u001b[23Gstaff\u001b[29Gforward,\u001b[38Gprint\u001b[44Gor\u001b[47Gfile\u001b[52Git.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mThe visitor's browser, briefly.\u001b[22m If\u001b[41Gthe\u001b[45Gform comes back with an error, the entered values are in \u001b[103Ghe\r\u001b[5C\u001b[1Bpage and in a signed hidden field. Nothing is\u001b[52Gs\u001b[54Gored\u001b[59Gon\u001b[62Gthe\u001b[66Gserver.\r\u001b[2C\u001b[1B3\u001b[10G\u001b[1mweb se\u001b[17Gver l\u001b[23Gg.\u001b[22m It keeps the IP address\u001b[50Gand time of every submission,\u001b[80Gas for e\u001b[89Gery page v\u001b[100Gew, and\r\u001b[5C\u001b[1Bon the live\u001b[18Gserver how long\u001b[34Git's kept depend\u001b[52Gon the\u001b[59Ghos\u001b[63Ging setup\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat that means for privacy\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- All retention and deletion\u001b[32Ghappens\u001b[40Gin\u001b[43Gthe\u001b[47Gmailbox,\u001b[56Gunder\u001b[62Gthe\u001b[66Gmunicipality's\u001b[81Gmail\u001b[86Gpolicy.\u001b[94GThat\u001b[99Gmakes\r\u001b[4C\u001b[1Bthe\u001b[9G\u001b[38;2;177;185;249minfo@\u001b[15G\u001b[39mmailbox\u001b[23Gthe\u001b[27Gplace\u001b[33Gto\u001b[36Gdecide\u001b[43Gwho\u001b[47Gcan\u001b[51Gread\u001b[56Gthese\u001b[62Gmessages\u001b[71Gand\u001b[75Ghow\u001b[79Glong\u001b[84Gthey're\u001b[92Gkept.\r\u001b[4C\u001b[1BBecause \u001b[14Gothing goes int\u001b[30G TYPO3, there's nothing in TYPO3 to\u001b[66Gexport or delete when a \u001b[91Gitizen asks for\r\u001b[7C\u001b[1Bir data. The munici\u001b[28Gality answers such\u001b[47Grequests\u001b[56Gfrom th\u001b[64G m\u001b[67Gilbox.\u001b[K\r\u001b[4C\u001b[1BThe privacy policy, still\u001b[31Gplacehold\u001b[42G text, should say this:\u001b[66Gwhat \u001b[72Ghe form collects,\u001b[90Gthat it\u001b[99Grrives\u001b[K\r\u001b[4C\u001b[1Bby email \u001b[15Gt\u001b[17Gt\u001b[33G, who \u001b[40Geads it, how long it's kept, and that\u001b[78Gthe\u001b[82Gweb\u001b[86Gserver\u001b[93Glogs\u001b[98GIP\r\u001b[2C\u001b[1B \u001b[5Gaddresses.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf\u001b[8Gthe per-IP spam limit we discuss\u001b[41Gd is ever added,\u001b[60G would keep IP \u001b[76Gddresses for a short time\u001b[102Gand\r\u001b[4C\u001b[1Bwould n\u001b[13Ged\u001b[16Gits\u001b[20Gown\u001b[24Gline\u001b[29Gin\u001b[32Gthe\u001b[36Gpolicy.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1456.816966, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhere the data does end up\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mThe mail to \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m.\u001b[40G\u001b[22mIt\u001b[43Gholds\u001b[49Geverything\u001b[60Gthe\u001b[64Gvisitor\u001b[72Gentered\u001b[80Gexcept\u001b[87Gthe\u001b[91Gconsent\u001b[99Gbox\u001b[103Gand\r\u001b[2C\u001b[1B  \u001b[6Gthe ALTCHA answer. On DDEV that's\u001b[40GMailpit.\u001b[49GOn the live site it's:\u001b[72G\u001b[K\r\u001b[5C\u001b[1B- the outgoi\u001b[19Gg mail server, which\u001b[40Gm\u001b[42Gy queue the message briefly and\u001b[74Glogs\u001b[79Gsender\u001b[86Gand\u001b[90Grecipient\r\u001b[5C\u001b[1B \u001b[8Gaddresses;\u001b[K\r\u001b[5C\u001b[1B-\u001b[8Gthe municipality's\u001b[27Gmail\u001b[32Gprovider\u001b[41Gand\u001b[45Gthe\u001b[49G\u001b[38;2;177;185;249minfo@\u001b[55G\u001b[39mmailbox,\u001b[64Gwhere\u001b[70Git\u001b[73Gstays\u001b[79Guntil\u001b[85Gsomeone\u001b[93Gdeletes\u001b[101Git;\r\u001b[7C\u001b[1Bev\u001b[11Grywhere the staff forward, p\u001b[40Gint or file it.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mThe visitor's browser, briefly.\u001b[38G\u001b[22mIf the form comes\u001b[56Gback\u001b[61Gwith\u001b[66Gan\u001b[69Gerror,\u001b[76Gthe\u001b[80Gentered\u001b[88Gvalues\u001b[95Gare\u001b[99Gin\u001b[102Gthe\r\u001b[2C\u001b[1B  \u001b[6Gpage and in a signed hidden field.\u001b[41GNothing is stored on the\u001b[66Gserve\u001b[72G.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe web server log.\u001b[22m It ke\u001b[32Gps the IP address and time\u001b[60Gf\u001b[62Gev\u001b[65Gry submission,\u001b[80Gas\u001b[83Gfor\u001b[87Gevery\u001b[93Gpage\u001b[98Gview,\u001b[104Gand\r\u001b[2C\u001b[1B  \u001b[6Gon the live server how\u001b[29Glong i\u001b[36G's\u001b[39Gkept \u001b[45Gepends on th\u001b[59Ghosting setup.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat that means for privacy\r\u001b[2C