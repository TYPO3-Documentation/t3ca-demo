[291.362799, "o", "\u001b[?25l\u001b[H\r\u001b[30C\u001b[24B\u001b[38;2;153;153;153m8\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[291.383805, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[9G\u001b[22mshell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWriting the form setup,\u001b[27Gform\u001b[32Gdefinition\u001b[43Gand\u001b[47Gmail\u001b[52Gtemplates\u001b[62Gnow.\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1p23efk;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Configuration/Form/Sitepackage/config.yaml\u0007~/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Configuration/Form/Site…/config.yaml\u001b]8;;\u0007)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m78\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b]8;id=1p23efk;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Configuration/Form/Sitepackage/config.yaml\u0007\u001b[1m~/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Configuration/For\u001b]8;;\u0007\r\u001b[1B\u001b[22m \u001b[3G   \u001b]8;id=1p23efk;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Configuration/Form/Sitepackage/config.yaml\u0007\u001b[1mm/Sitepackage/config.yaml\u001b[22m\u001b]8;;\u0007\u001b[K\r\u001b[1B     \u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m# Form setup of the Mto Safi site. EXT:form finds it by its place,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  2 \u001b[22m\u001b[38;2;117;113;94m# Configuration/Form/<SetName>/config.yaml, and merges it over its own base setup.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m3\u001b[10G\u001b[22m\u001b[38;2;166;226;46mname:\u001b[39m \u001b[38;2;230;219;116mmtosafi/sitepackage-form\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m\u001b[38;2;166;226;46mlabel:\u001b[39m \u001b[38;2;230;219;116m'Mto Safi forms'\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m\u001b[38;2;166;226;46mpersistenceManager:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m\u001b[38;2;117;113;94m# The forms of the site are files in the sitepackage, under version control.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m8\u001b[10G\u001b[22m  \u001b[38;2;117;113;94m# The form editor lists them but cannot save or delete them.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m9\u001b[12G\u001b[22m\u001b[38;2;166;226;46mallowedExtensionPaths:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[12G\u001b[22m  \u001b[38;2;166;226;46m10:\u001b[39m \u001b[38;2;230;219;116m'EXT:mtosafi_sitepackage/Resources/Private/Forms/'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +68 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mChecking email finisher\u001b[27Gmessage\u001b[35Goptions\r\u001b[2C\u001b[2B\u001b[1mWrite\u001b[22m(\u001b]8;id=1jvrfgu;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Forms/contact.form.yaml\u0007~/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private…/contact.form.yaml\u001b]8;;\u0007)\u001b[31;1H\u001b[29;3H\u001b[?25h"]
