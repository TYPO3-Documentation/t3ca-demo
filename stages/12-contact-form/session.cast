\r\u001b[7C\u001b[1B\u001b[2m9\u001b[13G\u001b[22mseed-pages.php wrot\u001b[33G move into it\u001b[47G sid\u001b[52Gbar, \u001b[38;2;249;38;114mand\u001b[61G\u001b[39mthe \u001b[38;2;230;219;116m\"Visit us\"\u001b[39m image moves above\r\u001b[6C\u001b[1B\u001b[2m10\u001b[13G\u001b[22mits\u001b[17Gtext, because the sid\u001b[39Gbar is too\u001b[50Gnarrow \u001b[38;2;249;38;114mfor\u001b[39m b\u001b[63Gth\u001b[66Gside by side. The form is\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +97 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBefore running the\u001b[22Gseed\u001b[27GI'll\u001b[32Gtake\u001b[37Ga\u001b[39GDDEV\u001b[44Gsnapshot\u001b[53Gof\u001b[56Gthe\u001b[60Gdatabase\u001b[69Gso\u001b[72Git\u001b[75Gcan\u001b[79Gbe\u001b[82Grolled\u001b[89Gback,\u001b[95Gthen\u001b[100Grefresh\r\u001b[2C\u001b[1Bthe\u001b[7Gcomposer\u001b[16Glock.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m she\u001b[17Gl command…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo && ddev snapshot --name before-contact-form 2>&1 |\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mtail -2; ddev composer update mtosafi/sitepackage 2>&1 | tail -5; git status --short\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
