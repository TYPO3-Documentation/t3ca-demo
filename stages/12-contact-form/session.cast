[1332.809368, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mALTCHA\u001b[10Gcaused it, and I miss\u001b[32Gd it\u001b[37Gbecause I didn't check the\u001b[64Gmail layout after\u001b[82Ginstalling it. It's\u001b[102Gfixed\r\u001b[2C\u001b[1Bnow:\u001b[8Ga\u001b[10Gnew\u001b[14Gtest\u001b[19Gmail\u001b[24Guses\u001b[29Gthe\u001b[33GMto\u001b[37GSafi\u001b[42Glayout\u001b[49Gagain,\u001b[56Gwith\u001b[61Gno\u001b[64GTYPO3\u001b[70Gimprint\u001b[78Gand\u001b[82Gno\u001b[85GALTCHA\u001b[92Gvalue.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it happened:\u001b[22m ALTCHA shi\u001b[31Gs \u001b[34Gts own copy\u001b[46Gof\u001b[49GTYPO3's mail \u001b[63Gemplate, whic\u001b[78Guses\u001b[83Gthe TYPO3\u001b[93G\"SystemEmail\"\r\u001b[2C\u001b[1Blayout with th\u001b[18G logo and copyright notice. It regist\u001b[56Grs that copy for both\u001b[78Gmail finishers under key\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m2011\u001b[39m. When sev\u001b[18Gral templ\u001b[28Gte paths are reg\u001b[45Gstered, the one with the high\u001b[75Gst k\u001b[80Gy wins, and my site\u001b[K\r\u001b[2C\u001b[1Btemplate \u001b[13Gad key \u001b[38;2;177;185;249m20\u001b[39m. So after ALTCHA w\u001b[42Gs\u001b[44Ginstalled, its template replaced\u001b[77Gthe\u001b[81Gsite's.\u001b[89GALTCHA\u001b[96Gships\u001b[102Gthe\r\u001b[2C\u001b[1Bcopy\u001b[8Gso\u001b[11Gthe\u001b[15Gsolved\u001b[22Gpuzzle\u001b[29Gdoesn't\u001b[37Gappear\u001b[44Gas\u001b[47Ga\u001b[49Gform\u001b[54Gvalue\u001b[60Gin\u001b[63Gthe\u001b[67Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix, in two files:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm setup:\u001b[17G\u001b[22min \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m, the\u001b[68Gsite's mail template a\u001b[91Gd\u001b[93Glayout paths\r\u001b[2C\u001b[1B \u001b[5Gnow use key \u001b[38;2;177;185;249m2100\u001b[39m for both finishers, so they wi\u001b[53G over ALTCHA's \u001b[38;2;177;185;249m2011\u001b[39m. A comment explains the number.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMail templates:\u001b[22m the site'\u001b[31G \u001b[38;2;177;185;249mDefault.fluid.html\u001b[39m and \u001b[38;2;177;185;249mDefault.fluid.txt\u001b[39m leave out th\u001b[86G ALTCHA field, as\r\u001b[4C\u001b[1BALTCHA's\u001b[14Gown\u001b[18Gtemplate\u001b[27Gdoes.\u001b[33GOtherwise\u001b[43Gthe\u001b[47Glong\u001b[52Gencoded\u001b[60Gpuzzle\u001b[67Gsolution\u001b[76Gwould\u001b[82Gappear\u001b[89Gin\u001b[92Gthe\u001b[96Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis will happen \u001b[21Ggain\u001b[26Gwhenever an extension registers mail tem\u001b[67Glates\u001b[73Gwith\u001b[78Ga\u001b[80Ghigher\u001b[87Gkey.\u001b[92GAfter\r\u001b[2C\u001b[1Binstalling\u001b[14Gor\u001b[17Gupdating\u001b[26Ga\u001b[28Gform\u001b[33Gextension,\u001b[44Gcheck\u001b[50Gone\u001b[54Gmail\u001b[59Gin\u001b[62GMailpit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing is committed yet. Still open:\u001b[41Gthe\u001b[45Gconsent\u001b[53Gtext\u001b[58Grenders\u001b[66Gbold\u001b[71Ginstead\u001b[79Gof\u001b[82Gnormal\u001b[89Gweight,\u001b[97Gand\u001b[101Gthe\r\u001b[2C\u001b[1Bfresh-install\u001b[17Gcheck\u001b[23Gof\u001b[26G\u001b[38;2;177;185;249mdata.xml\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mCrunched for 1m 42s\u001b[23G· done 6:53 PM\u001b[39m\u001b[K\r\u001b[3B❯ \u001b[31;1H\u001b[29;7H\u001b[?25h"]
