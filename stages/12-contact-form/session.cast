[1187.113971, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 154 +\u001b[38;2;248;248;242m            -                                                                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 155 +\u001b[38;2;248;248;242m              \u001b[38;2;166;226;46mcode:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m1719693214\u001b[38;2;248;248;242m                                                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 156 +\u001b[38;2;248;248;242m              \u001b[38;2;166;226;46mmessage:\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m'Please tick \"I\u001b[38;2;248;248;242m''\u001b[38;2;230;219;116mm not a robot\" and wait until it is checked.'\u001b[38;2;248;248;242m   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[20G\u001b[38;2;248;248;242m    -                                                                           \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[22G\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mcode:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m1719694187\u001b[38;2;248;248;242m    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[24G\u001b[38;2;248;248;242m \u001b[26G\u001b[38;2;166;226;46mmessage:\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m'The robot check has expired. Please tick \"I\u001b[38;2;248;248;242m''\u001b[38;2;230;219;116mm not a robot\" agai\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116mn.'\u001b[38;2;248;248;242m                \u001b[32G          \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 160 \u001b[22m         \u001b[38;2;166;226;46mvalidators:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 161 \u001b[22m           -\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 162 \u001b[22m             \u001b[38;2;166;226;46midentifier:\u001b[39m \u001b[38;2;230;219;116mAltcha\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[20G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe contact\u001b[15Gpage\u001b[20Grenders correctly, but\u001b[43Gthe\u001b[47Gconsent\u001b[55Gtext\u001b[60Gis\u001b[63Gbold\u001b[68Gwhere\u001b[74Gthe\u001b[78Gdesign\u001b[85Gcalls\u001b[91Gfor\u001b[95Gnormal\r\u001b[1B  weight, which I'll fix in\u001b[29Gthe\u001b[33GCSS.\u001b[38GI'm\u001b[42Gupdating\u001b[51Gthe\u001b[55GREADME\u001b[62Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[2B●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage && python3 - <<'EOF'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mf='README.md'\u001b[20G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153mt=open(f).read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mold=\"\"\"A honeypot field keeps simple bots out. Nothing is stored in the database: the\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mmails are the only copy of a message.…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1187.148813, "o", "\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;2;215;119;87m✽\u001b[19G\u001b[38;2;153;153;153m3\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1187.212672, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[17BDocument ALTCHA\u001b[19Gin sitepackage\u001b[34GREADME\r\u001b[2C\u001b[7B\u001b[38;2;230;149;117mRuminating…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1187.266088, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m218\u001b[12G\u001b[38;2;248;248;242mthat\u001b[17Gfill\u001b[22Gin every\u001b[31Gfield.\u001b[38GALTCHA\u001b[45G(`bbysaeth/typo3-altcha`,\u001b[71Gset\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m219\u001b[12G\u001b[38;2;248;248;242m`bbysaeth/typo3-altcha`) adds the field \"I'm not a robot\": a click lets the browser     \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m220\u001b[12G\u001b[38;2;248;248;242msolve\u001b[18Ga\u001b[20Gsmall\u001b[26Gproof-of-work puzzle, and the form is sent only with a solution the       \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m221\u001b[12G\u001b[38;2;248;248;242mserver\u001b[19Gsigned\u001b[26Gand\u001b[30Ghas\u001b[34Gnot\u001b[38Gseen\u001b[43Gsolved\u001b[50Gbefore.\u001b[58GIt\u001b[61Gneeds\u001b[67Gno\u001b[70Goutside\u001b[78Gservice\u001b[86Gand\u001b[90Gsets\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m222\u001b[12G\u001b[38;2;248;248;242mno\u001b[15Gcookie.\u001b[23GIts widget loads JavaScript and CSS on the pages that carry a form.          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 223 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m224\u001b[12G\u001b[38;2;248;248;242mALTCHA stores every challenge it hands out in `tx_typo3altcha_domain_model_challenge`   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 225 +\u001b[38;2;248;248;242mso that a solution counts once, a row per form view. Nothing deletes them on its own;   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 226 +\u001b[38;2;248;248;242mrun this regularly, for example from cron:                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 227 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 228 +\u001b[38;2;248;248;242m    vendor/bin/typo3 altcha:remove-obsolete-challenges --include-solved-challenges      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 229 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 230 +\u001b[38;2;248;248;242mThe messages themselves are not stored in the database: the mail is the only copy.      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 231 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 232 +\u001b[38;2;248;248;242mALTCHA still registers its form setup through TypoScript                                \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 233 +\u001b[38;2;248;248;242m(`plugin.tx_form.settings.yamlConfigurations`), which TYPO3 14.2 deprecated and 15      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 234 +\u001b[38;2;248;248;242mremoves. It works on 14.3; the extension has to move to `Configuration/Form/` before    \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 235 +\u001b[38;2;248;248;242mthe site can go to TYPO3 15.                                                            \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 236 +\u001b[38;2;248;248;242m                                                                                        \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 237 \u001b[22m The consent\u001b[24Glabel\u001b[30Glinks\u001b[36Gto\u001b[39Gthe\u001b[43Gprivacy\u001b[51Gpolicy\u001b[58Gby\u001b[61Gits\u001b[65Gaddress,\u001b[74G`/privacy-policy`,\r\u001b[5C\u001b[1B\u001b[2m 238 \u001b[22m rather than\u001b[24Gby\u001b[27Gpage\u001b[32Guid,\u001b[37Gso\u001b[40Gthe\u001b[44Glink\u001b[49Gholds\u001b[55Gon\u001b[58Gany\u001b[62Ginstallation\u001b[75Gthe\u001b[79Gpackage\u001b[87Gis\r\u001b[5C\u001b[1B\u001b[2m 239 \u001b[22m imported into, as long as the page keeps that address.\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by aut\u001b[21G mode\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1187.297456, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[24B\u001b[38;2;228;144;112mRuminating…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1188.073712, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m20\u001b[12G\u001b[38;2;248;248;242msolve a small proof-of-work puzzle, and the form is sent only with\u001b[79Ga\u001b[81Gsolution\u001b[90Gthe\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m21\u001b[12G\u001b[38;2;248;248;242mserver signed and has not seen solved before. I\u001b[61Gneeds no outside service and sets \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[12G\u001b[38;2;248;248;242mn\u001b[14G cookie. Its widget loads\u001b[40GJavaScript and CSS on the pages that carry a form.   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 223 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m4\u001b[12G\u001b[38;2;248;248;242mALTCHA stores every challenge it hands\u001b[51Gout\u001b[55Gin `tx_\u001b[63Gypo3\u001b[68Gltcha_domain_model_challenge`\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 225 +\u001b[38;2;248;248;242mso that a solution counts once, a row per form view. Nothing deletes them on its own;   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242mrun thi\u001b[20G regularly,\u001b[32Gfor example from cr\u001b[52Gn:\u001b[55G  \u001b[58G                                       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242m  \u001b[15G    \u001b[20G \u001b[22G        \u001b[31G      \u001b[38G     \u001b[44G \u001b[46G   \u001b[50G   \u001b[54G    \u001b[59G     \u001b[65G       \u001b[73G       \u001b[81G    \u001b[86G  \u001b[89G   \u001b[93G    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242m   \u001b[16Gvendo\u001b[22G/bin/typo3 altch\u001b[39G:remove-obsolete-challenges\u001b[67G--include-solved-challenges\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\r\u001b[7C\u001b[1B30\u001b[12G\u001b[38;2;248;248;242mThe\u001b[16Gm\u001b[18Gssages themselves are not stored in the database: the mail is the only copy.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m31\r\u001b[8C\u001b[1B2\u001b[12G\u001b[38;2;248;248;242mALTCHA \u001b[20Gtill\u001b[25Gregi\u001b[30Gters its form\u001b[45Getup through\u001b[58GTypoScript   \u001b[72G    \u001b[77G  \u001b[80G   \u001b[84G    \u001b[89G     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[12G\u001b[38;2;248;248;242m(`plugin.tx_form.settings.yamlConfigurations`),\u001b[60Gwhich\u001b[66GTYPO3\u001b[72G14.2\u001b[77Gdeprecated\u001b[88Gand\u001b[92G15\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242mremoves. It works on 14.3;\u001b[39Gthe extension has to m\u001b[62Gve to `Configuration/Form/`\u001b[90Gbefore\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242mthe site can go to TYPO3 15.                   \u001b[60G     \u001b[66G     \u001b[72G    \u001b[77G          \u001b[88G   \u001b[92G  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m        \u001b[21G  \u001b[24G     \u001b[30G  \u001b[33G     \u001b[39G   \u001b[43G         \u001b[53G   \u001b[57G  \u001b[60G    \u001b[65G  \u001b[68G                     \u001b[90G      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 237 \u001b[22m The consent label links to the privacy policy by its address, `/privacy-policy`,\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 238 \u001b[22m rather than by page uid, so the link holds on any installation the package is\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22mimported into, as\u001b[31Go\u001b[33Gg as the page keeps that\u001b[58Gaddre\u001b[64Gs.\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[27G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3GRuminating…\u001b[19G\u001b[38;2;153;153;153m4\u001b[29G8\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
