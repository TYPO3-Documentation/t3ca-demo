[960.720677, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 205 +\u001b[38;2;248;248;242mIt is sent from `noreply@mtosafi.example`; the server that sends the mail has to be     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 206 +\u001b[38;2;248;248;242mallowed to send for that domain. Editors change the recipient in the content            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 207 +\u001b[38;2;248;248;242melement (\"Override finisher settings\") without touching the file. The mail uses the     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242mlayout of\u001b[22Gth\u001b[25G site, `Resources/Private/Extensions/Form/Layouts/Email.fluid.html` and\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242m`.txt`, instead\u001b[28Gof the core l\u001b[42Gyout \"SystemEmail\" with\u001b[68Ge TYPO3 logo. The\u001b[86Gconsent  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m10\u001b[12G\u001b[38;2;248;248;242mcheckbox is left \u001b[30Gut of it. On DD\u001b[46GV it lands in\u001b[60GMailpit (`ddev mailpit`).   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 211 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m12\u001b[12G\u001b[38;2;248;248;242mThe visitor gets no\u001b[32Gcopy by mail, only the confirmation on the page. A copy would go\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m13\u001b[12G\u001b[38;2;248;248;242mto whatever ad\u001b[27Gress was entered, with th\u001b[53G text that was \u001b[69Gntered, so anybody could\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242mus\u001b[15G the form to send\u001b[33Gmail from\u001b[43Gthe municipality's domain to a stranger, and\u001b[88Ga\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 215 +\u001b[38;2;248;248;242mmistyped address would hand the message to somebody else.                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m   \u001b[16G       \u001b[24G    \u001b[29G  \u001b[32G    \u001b[37G  \u001b[40G     \u001b[46G    \u001b[51G   \u001b[55G            \u001b[68G  \u001b[71G   \u001b[75G     \u001b[81G \u001b[83G    \u001b[88G     \u001b[94G  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 217 \u001b[22m A honeypot field keeps simple bots out. Nothing is stored in the database: the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 218 \u001b[22m mails are the only copy of a message.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 219 \u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNow a test send to\u001b[22Gconfirm that exactly one mail\u001b[52Ggoes\u001b[57Gout:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo && S=/tmp/claude-1000/-home-lina-wolf-projects-typ\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mo3-t3ca-2026-demo/db49a4f2-0898-4127-afe1-beed593b783b/scratchpad; ddev exec typo3 cache:flush \r\u001b[5C\u001b[1B>/dev/null; rm -f \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m/tmp/claude-1000/-home-lina-wolf-projects-typo3-t3ca-2026-demo/db49a4f2-0898-4127-afe…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
