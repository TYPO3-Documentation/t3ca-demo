[415.336191, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;153;153;153m...\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  94 \u001b[22m            \u001b[24G\u001b[38;2;166;226;46midentifier:\u001b[36G\u001b[38;2;230;219;116mRegularExpression\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  95 \u001b[24G\u001b[22m\u001b[38;2;166;226;46moptions:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  96 \u001b[22m  \u001b[14G     \u001b[20G \u001b[22G    \u001b[38;2;166;226;46mregularExpression:\u001b[39m \u001b[38;2;230;219;116m'/^[0-9+()\\/ -]{0,30}$/'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  97 +\u001b[38;2;248;248;242m        \u001b[38;2;166;226;46mvalidationErrorMessages:\u001b[38;2;248;248;242m                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m  98 +\u001b[38;2;248;248;242m          -                                                                             \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  99 +\u001b[38;2;248;248;242m            \u001b[38;2;166;226;46mcode:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m1221565130\u001b[38;2;248;248;242m                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 100 +\u001b[38;2;248;248;242m            \u001b[38;2;166;226;46mmessage:\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m'Please enter a phone number, such as +254 700 000 000.'\u001b[38;2;248;248;242m           \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[2m 101 \u001b[22m   \u001b[15G   -\u001b[20G\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 102 \u001b[22m         \u001b[38;2;166;226;46mtype:\u001b[39m \u001b[38;2;230;219;116mSingleSelect\u001b[39G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 103 \u001b[20G\u001b[22m\u001b[38;2;166;226;46midentifier:\u001b[32G\u001b[38;2;230;219;116mtopic\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 146 \u001b