[873.923854, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255mere3 can\u001b[14GI see the mail?\u001b[39m           \r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhat about data privacy and security?\u001b[39m                                                                   \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gform\u001b[12Gis\u001b[15Gtechnically\u001b[27Gsound,\u001b[34Gbut\u001b[38Gmy\u001b[41Gdesign\u001b[48Ghas\u001b[52Gone\u001b[56Greal\u001b[61Gsecurity\u001b[70Gflaw,\u001b[76Gand\u001b[80Ga\u001b[82Gfew\u001b[86Gprivacy\u001b[94Gdecisions\r\u001b[2C\u001b[1Bbelong to\u001b[13Gthe\u001b[17Gsite\u001b[22Gowner.\u001b[29GMy\u001b[32Grecommendation\u001b[47Gis\u001b[50Gat\u001b[53Gthe\u001b[57Gend.\r\u001b[2C\u001b[2B\u001b[1mSecurity\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe flaw: the copy to the visitor can be abused to send spam.\u001b[22m The\u001b[69Gcopy goes\u001b[79Gto whatever addr\u001b[96Gss\u001b[99Gsomeone\r\u001b[2C\u001b[1Btypes into the form. It includes the\u001b[40Gname a\u001b[47Gd message they en\u001b[65Gered,\u001b[71Gand it comes from\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mnoreply@mtosafi.example\u001b[39m. A spammer can enter a strang\u001b[57Gr's addres\u001b[68G and\u001b[73Gtheir own text, a\u001b[91Gd the\u001b[K\r\u001b[2C\u001b[1Bmunicipali\u001b[14Gy sends\u001b[22Git for\u001b[29Gthem,\u001b[35Gfrom\u001b[40Gits\u001b[44Gown\u001b[48Gdomain.\u001b[56GThat\u001b[61Ghurts\u001b[67Gthe\u001b[71Gmunicipality's\u001b[86Gmail\u001b[91Greputation,\u001b[103Gso\r\u001b[2C\u001b[1Bits\u001b[7Greal\u001b[12Gmails\u001b[18Gstart\u001b[24Glanding\u001b[32Gin\u001b[35Gspam\u001b[40Gfolders.\u001b[49GThe\u001b[53Ghoneypot\u001b[62Gonly\u001b[67Gstops\u001b[73Gsimple\u001b[80Gbots,\u001b[86Gand\u001b[90Gnothing\u001b[98Glimits\r\u001b[2C\u001b[1Bhow often the form can\u001b[26Gbe\u001b[29Gsent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's already fine:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTamper\u001b[14Gsubmissions:\u001b[22m EXT:form signs the form's hidden state and the li\u001b[77Gt\u001b[79Gof allow\u001b[88Gd field\u001b[96G,\u001b[98Gso\u001b[101Ga\u001b[K\r\u001b[4C\u001b[1Bmodified submission is rej\u001b[32Gcted.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mInjected \u001b[15Garkup:\u001b[22m the mail t\u001b[33Gmplates esc\u001b[45Gpe everything the visitor enters\u001b[79GAll addresses pass an email\r\u001b[4C\u001b[1Bcheck before they r\u001b[25Gach the mailer.\r\u001b[4C\u001b[1B\u001b[1mLength limits:\u001b[20G\u001b[22mnam\u001b[24G is capped at 200 characters\u001b[53Gand\u001b[57Gthe\u001b[61Gmessage\u001b[69Gat\u001b[72G5,000.\u001b[79GThere's\u001b[87Gno\u001b[90Gfile\u001b[95Gupload,\u001b[103Gso\r\u001b[2C\u001b[1B \u001b[5Gnothing lands on\u001b[26Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpam bots:\u001b[22m the honeypot\u001b[29Gcatches\u001b[37Gsimple\u001b[44Gones.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCookies:\u001b[14G\u001b[22mloading\u001b[22Gthe\u001b[26Gpage\u001b[31Gsets\u001b[36Gnone\u001b[70Gbanner.\u001b[78GIn\u001b[81GTYPO3\u001b[87G14.3\u001b[92Gthe\u001b[96Ghoneypot\u001b[105Gno\u001b[31;1H\u001b[29;3H\u001b[?25h"]
