[1188.974973, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[13G\u001b[38;2;248;248;242mer\u001b[17Gr signed\u001b[26Gand has not seen solved before. It\u001b[61Gneeds no outside service and\u001b[90Gsets\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[12G\u001b[38;2;248;248;242mno cookie. Its widget\u001b[34Gl\u001b[36Gad\u001b[39G JavaScript and CSS on the pages \u001b[73Ghat car\u001b[81Gy a form.    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 223 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 224 +\u001b[38;2;248;248;242mALTCHA stores every challenge it hands out in `tx_typo3altcha_domain_model_challenge`   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242mso that a solution counts once, a row per form view. Nothing deletes them on its own;\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242mrun this regularly, for example\u001b[44Gfrom cron:    \u001b[59G     \u001b[65G       \u001b[73G       \u001b[81G    \u001b[86G  \u001b[89G   \u001b[93G    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242m   \u001b[16G    \u001b[21G          \u001b[32G   \u001b[36G       \u001b[44G    \u001b[49G     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[16G\u001b[38;2;248;248;242mvendor/bin/typo3\u001b[33Galtcha:remove-obsolete-challenges\u001b[67G--include-solved-challenges\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[16G\u001b[38;2;248;248;242m                \u001b[33G                                 \u001b[67G                           \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m30\u001b[12G\u001b[38;2;248;248;242mThe\u001b[16Gmessages\u001b[25Gthemselves\u001b[36Gare\u001b[40Gnot\u001b[44Gstored\u001b[51Gin\u001b[54Gthe\u001b[58Gdatabase:\u001b[68Gthe\u001b[72Gmail\u001b[77Gis\u001b[80Gthe\u001b[84Gonly\u001b[89Gcopy.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;248;248;242m   \u001b[16G        \u001b[25G          \u001b[36G   \u001b[40G   \u001b[44G      \u001b[51G  \u001b[54G   \u001b[58G         \u001b[68G   \u001b[72G    \u001b[77G  \u001b[80G   \u001b[84G    \u001b[89G     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[12G\u001b[38;2;248;248;242mALTCHA\u001b[19Gstill\u001b[25Gregisters\u001b[35Gits\u001b[39Gform\u001b[44Gsetup\u001b[50Gthrough\u001b[58GTypoScript\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[12G\u001b[38;2;248;248;242m(`plugin.tx_form.\u001b[30Gettings.yamlConfigurati\u001b[54Gns`), whi\u001b[64Gh TYPO3\u001b[72G14.2\u001b[77Gdeprecated\u001b[88Gand\u001b[92G15\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242mremoves. It w\u001b[27Gks on 14.3; the extension ha\u001b[56G to\u001b[60Gmove to `Configuration/Form/` before\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242mthe site\u001b[21Gcan go to TYPO3 15.  \u001b[43G         \u001b[53G   \u001b[57G  \u001b[60G    \u001b[65G  \u001b[68G                     \u001b[90G      \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m   \u001b[16G    \u001b[21G   \u001b[25G  \u001b[28G  \u001b[31G     \u001b[37G   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 237 \u001b[22m The consent label links to the privacy policy by its address, `/privacy-policy`,\u001b[K\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22mrather than\u001b[24Gby page uid, so the l\u001b[46Gnk holds on\u001b[58Gany installation the p\u001b[82Gkage \u001b[88Gs\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22mimported i\u001b[23Gto,\u001b[27Gas long as the page \u001b[48Geeps that\u001b[59Gddres\u001b[65G.\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[27G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ git diff config/system/settings.php; git diff composer.lock 