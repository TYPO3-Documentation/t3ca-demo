[733.331469, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I tested on \u001b]8;id=12ra721;https://demo.ddev.site/contact\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/contact\u001b]8;;\u0007\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong input:\u001b[22m \u001b[19Gach\u001b[23Gbad\u001b[27Gfield\u001b[33Gshows\u001b[39Gits\u001b[43Gown\u001b[47Gmessage\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's style\u001b[20G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam:\u001b[22m a submission\u001b[24Gthat fills the hidd\u001b[44Gn honeypot field\u001b[61Gis rej\u001b[68Gcted\u001b[73Gand no mail\u001b[85Gis sent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[22m the visitor sees the green \"Asan\u001b[53Ge!\u001b[56GYou\u001b[60G message\u001b[69Ghas\u001b[73Gbeen sent.\"\u001b[85Gb\u001b[87Gx. In Ma\u001b[96Glpit, \u001b[103Gne\r\u001b[4C\u001b[1Bmail went\u001b[15Gto \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m with the visito\u001b[55G as reply-to, \u001b[70Gnd a\u001b[75Gcopy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe\u001b[92Gvisitor.\u001b[101GBoth\r\u001b[4C\u001b[1Buse\u001b[9Ga\u001b[11GMto\u001b[15GSafi\u001b[20Gmail\u001b[25Glayout\u001b[32Ginstead\u001b[40Gof\u001b[43Gthe\u001b[47GTYPO3-branded\u001b[61Gsystem\u001b[68Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's buil\u001b[17G:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22m \u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith the fields from \u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[4C\u001b[1Bname, email, phone,\u001b[26Gopic, m\u001b[34Gssage (at least\u001b[50G20 characters) and\u001b[69Ga consent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B \u001b[5Gversion control, so the backend Forms module shows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes wi\u001b[99G the\u001b[K\r\u001b[4C\u001b[1Bdesign's classes. Th\u001b[26G o\u001b[29Gly template\u001b[41Goverride\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m,\u001b[70Gwhich\u001b[76Gadds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag bec\u001b[13Gu\u001b[15Ge a\u001b[19Gform defini\u001b[31Gion can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and\u001b[30Gtemplates\u001b[40Gunder\u001b[46G\u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out of the mail\u001b[26G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtyp\u001b[17G3/form\u001b[24G\u001b[39mis now a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cms-form\u001b[39m i\u001b[82G in the sitepackage's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[39m update\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[2C\u001b[1B \u001b[5Grequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m \u001b[20G new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m, runs after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m. It\u001b[K\r\u001b[4C\u001b[1Bswitches the p\u001b[20Gge\u001b[23Gto the \"Sidebar right\" layout, puts the form in the main area and moves the addre\u001b[105Gs,\r\u001b[5C\u001b[1Bpening hours and \"Report a problem\" into the sidebar.\u001b[60GI\u001b[62Gre-exported\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[84Gand\u001b[88Gthe\u001b[92Gdiff\u001b[97Gcontains\r\u001b[4C\u001b[1Bonly\u001b[10Gthose\u001b[16Gchanges.\u001b[25GThe\u001b[29GREADME\u001b[36Gexpl\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[733.349211, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted.\u001b[25GOne\u001b[29Gcheck\u001b[35Gis\u001b[38Gstill\u001b[44Gopen:\u001b[50Gimporting\u001b[60Gthe\u001b[64Gnew\u001b[68G\u001b[38;2;177;185;249mdata.xml\u001b[77G\u001b[39minto\u001b[82Ga\u001b[84Gfresh\u001b[90Ginstallation.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I tested on \u001b]8;id=12ra721;https://demo.ddev.site/contact\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/contact\u001b]8;;\u0007\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong input:\u001b[22m \u001b[19Gach\u001b[23Gbad\u001b[27Gfield\u001b[33Gshows\u001b[39Gits\u001b[43Gown\u001b[47Gmessage\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's style\u001b[20G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam:\u001b[22m a submission\u001b[24Gthat fills the hidd\u001b[44Gn honeypot field\u001b[61Gis rej\u001b[68Gcted\u001b[73Gand no mail\u001b[85Gis sent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[22m the visitor sees the green \"Asan\u001b[53Ge!\u001b[56GYou\u001b[60G message\u001b[69Ghas\u001b[73Gbeen sent.\"\u001b[85Gb\u001b[87Gx. In Ma\u001b[96Glpit, \u001b[103Gne\r\u001b[4C\u001b[1Bmail went\u001b[15Gto \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m with the visito\u001b[55G as reply-to, \u001b[70Gnd a\u001b[75Gcopy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe\u001b[92Gvisitor.\u001b[101GBoth\r\u001b[4C\u001b[1Buse\u001b[9Ga\u001b[11GMto\u001b[15GSafi\u001b[20Gmail\u001b[25Glayout\u001b[32Ginstead\u001b[40Gof\u001b[43Gthe\u001b[47GTYPO3-branded\u001b[61Gsystem\u001b[68Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's buil\u001b[17G:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22m \u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith the fields from \u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[4C\u001b[1Bname, email, phone,\u001b[26Gopic, m\u001b[34Gssage (at least\u001b[50G20 characters) and\u001b[69Ga consent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B \u001b[5Gversion control, so the backend Forms module shows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes wi\u001b[99G the\u001b[K\r\u001b[4C\u001b[1Bdesign's classes. Th\u001b[26G o\u001b[29Gly template\u001b[41Goverride\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m,\u001b[70Gwhich\u001b[76Gadds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag bec\u001b[13Gu\u001b[15Ge a\u001b[19Gform defini\u001b[31Gion can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and\u001b[30Gtemplates\u001b[40Gunder\u001b[46G\u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out of the mail\u001b[26G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtyp\u001b[17G3/form\u001b[24G\u001b[39mis now a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cms-form\u001b[39m i\u001b[82G in the sitepackage's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[39m update\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[2C\u001b[1B \u001b[5Grequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m \u001b[20G new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m, runs after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m. It\u001b[K\r\u001b[4C\u001b[1Bswitches the p\u001b[20Gge\u001b[23Gto the \"Sidebar right\" layout, puts the form in the main area and moves the addre\u001b[105Gs,\r\u001b[5C\u001b[1Bpening hours and \"Report a problem\u001b[69Grted\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[84Gand\u001b[88Gthe\u001b[92Gdiff\u001b[97Gcontains\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[733.364698, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe contact form is on the Contact\u001b[38Gpage,\u001b[44Gbuilt\u001b[50Gwith EXT:form, and it works in your DDEV insta\u001b[97Glation.\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted.\u001b[25GOne\u001b[29Gcheck\u001b[35Gis\u001b[38Gstill\u001b[44Gopen:\u001b[50Gimporting\u001b[60Gthe\u001b[64Gnew\u001b[68G\u001b[38;2;177;185;249mdata.xml\u001b[77G\u001b[39minto\u001b[82Ga\u001b[84Gfresh\u001b[90Ginstallation.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I tested on \u001b]8;id=12ra721;https://demo.ddev.site/contact\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/contact\u001b]8;;\u0007\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong input:\u001b[22m \u001b[19Gach\u001b[23Gbad\u001b[27Gfield\u001b[33Gshows\u001b[39Gits\u001b[43Gown\u001b[47Gmessage\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's style\u001b[20G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam:\u001b[22m a submission\u001b[24Gthat fills the hidd\u001b[44Gn honeypot field\u001b[61Gis rej\u001b[68Gcted\u001b[73Gand no mail\u001b[85Gis sent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[22m the visitor sees the green \"Asan\u001b[53Ge!\u001b[56GYou\u001b[60G message\u001b[69Ghas\u001b[73Gbeen sent.\"\u001b[85Gb\u001b[87Gx. In Ma\u001b[96Glpit, \u001b[103Gne\r\u001b[4C\u001b[1Bmail went\u001b[15Gto \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m with the visito\u001b[55G as reply-to, \u001b[70Gnd a\u001b[75Gcopy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe\u001b[92Gvisitor.\u001b[101GBoth\r\u001b[4C\u001b[1Buse\u001b[9Ga\u001b[11GMto\u001b[15GSafi\u001b[20Gmail\u001b[25Glayout\u001b[32Ginstead\u001b[40Gof\u001b[43Gthe\u001b[47GTYPO3-branded\u001b[61Gsystem\u001b[68Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's buil\u001b[17G:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22m \u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith the fields from \u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[4C\u001b[1Bname, email, phone,\u001b[26Gopic, m\u001b[34Gssage (at least\u001b[50G20 characters) and\u001b[69Ga consent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B \u001b[5Gversion control, so the backend Forms module shows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes wi\u001b[99G the\u001b[K\r\u001b[4C\u001b[1Bdesign's classes. Th\u001b[26G o\u001b[29Gly template\u001b[41Goverride\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m,\u001b[70Gwhich\u001b[76Gadds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag bec\u001b[13Gu\u001b[15Ge a\u001b[19Gform defini\u001b[31Gion can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and\u001b[30Gtemplates\u001b[40Gunder\u001b[46G\u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out of the mail\u001b[26G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtyp\u001b[17G3/form\u001b[24G\u001b[39mis now a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cms-form\u001b[39m i\u001b[82G in the sitepackage's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[39m update\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[2C\u001b[1B \u001b[5Grequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m \u001b[20G new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m, runs after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m. It\u001b[K\r\u001b[4C\u001b[1Bswitches the p\u001b[20Gge\u001b[23Gto the \"Sidebar r\u001b[69Gn the main area and moves the addre\u001b[105Gs,\u001b[31;1H\u001b[29;3H\u001b[?25h"]
