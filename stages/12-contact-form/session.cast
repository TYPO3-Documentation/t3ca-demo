[1209.743887, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gform\u001b[12Gstill\u001b[18Gworks\u001b[24Gon\u001b[27Gcached\u001b[34Gpages,\u001b[41Gbecause\u001b[49Geach\u001b[54Gvisitor\u001b[62Ggets\u001b[67Ga\u001b[69Gfresh\u001b[75Gpuzzle\u001b[82Gfrom\u001b[87Gan\u001b[90Guncached\r\u001b[2C\u001b[1Bendpoint. I a\u001b[17Gso took a\u001b[27Gscre\u001b[32Gnshot with headless Chrome: the \u001b[65Gwo-column\u001b[75Glayout\u001b[82Gand the\u001b[90Gwidget render\r\u001b[2C\u001b[1Bpro\u001b[7Gerly\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mComposer:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glock file\u001b[15Gis updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite set:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mForm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA elem\u001b[48Gnt above the\u001b[61Gbutton,\u001b[69Gwith\u001b[74Gfriendlier\u001b[85Gerror\u001b[91Gtexts.\r\u001b[8C\u001b[1B\u001b[1m setup:\u001b[22m \u001b[38;2;177;185;249mConfigur\u001b[26Gtion/Form/Sitepackage/config.yaml\u001b[39m gives the element the design's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe\u001b[37Gextension\u001b[47Gadded\u001b[53Gan\u001b[56Gempty\u001b[62G\u001b[38;2;177;185;249mhmac\u001b[67G\u001b[39msetting.\u001b[76GEmpty\u001b[82Gmeans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fi\u001b[46Ge, an\u001b[53Gthe change belongs in the com\u001b[83Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m a section on ALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39md\u001b[45Gdn't chang\u001b[56G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mIt'\u001b[10Ga hurdle, not a wall.\u001b[32G\u001b[22mIt\u001b[35Gstops\u001b[41Gbots\u001b[46Gthat\u001b[51Gdon't\u001b[57Grun\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[2C\u001b[1B \u001b[5Gdetermined spammer can still solve it cheaply: my sc\u001b[58Gipt needed 0.1 sec\u001b[78Gds. You can raise the\u001b[K\r\u001b[5C\u001b[1Bifficulty\u001b[16Gin th\u001b[22G site\u001b[29Gettings (\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m), but\u001b[69Gthat sl\u001b[77Gws down cheap phones too.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every\u001b[37Gpage view stores one puzzle\u001b[65Gin the databa\u001b[79Ge, a\u001b[84Gd nothing d\u001b[96Gle\u001b[99Ges them\r\u001b[2C\u001b[1B \u001b[5Gautomatically. The scheduler extension isn'\u001b[49G in\u001b[53Gtalled, so production needs a cro\u001b[87G job running \u001b[38;2;177;185;249mtypo3 \r\u001b[4C\u001b[1Baltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. It's in the README.\u001b[88G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The extension registers its form \u001b[72Getup the old TypoScript\u001b[96Gway,\u001b[101Gwhich\r\u001b[2C\u001b[1B \u001b[5GTYPO3 14.2 deprecated and 15 remove\u001b[69Gext\u001b[73Gnsion must be updated before any\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
