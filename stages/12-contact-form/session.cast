[731.445877, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[1mWhat I tested on \u001b]8;id=12ra721;https://demo.ddev.site/contact\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/contact\u001b]8;;\u0007\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mWrong input:\u001b[22m each bad field shows its own message under it\u001b[64Gand\u001b[68Gthe field is m\u001b[83Grked red with the\u001b[K\r\u001b[4C\u001b[1Bdesign's\u001b[14Gstyles.\r\u001b[2C\u001b[1B- \u001b[1mSpam:\u001b[22m a submission that fills the hidden honeypot\u001b[55Gfield\u001b[61Gis\u001b[64Grejected\u001b[73Gand\u001b[77Gno\u001b[80Gmail\u001b[85Gis\u001b[88Gsent.\r\u001b[4C\u001b[1B\u001b[1mValid\u001b[11Gmessage:\u001b[22m t\u001b[22Ge visitor sees the gree\u001b[47G\"A\u001b[50Gant\u001b[54G! You\u001b[61Gmessage \u001b[70Gas b\u001b[75Gen\u001b[78Gsent.\" box. In Mailpit,\u001b[102Gone\r\u001b[4C\u001b[1Bmail went \u001b[16Go \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39G\u001b[39mwith\u001b[44Gthe\u001b[48Gvisitor\u001b[56Gas\u001b[59Greply-to,\u001b[69Gand\u001b[73Ga\u001b[75Gcopy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe\u001b[92Gvisitor.\u001b[101GBoth\r\u001b[2C\u001b[1B \u001b[5Guse a\u001b[11GMto Safi mail l\u001b[27Gyout ins\u001b[36Gead of the TYPO3-brande\u001b[61Gsyst\u001b[66Gm mail.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22m \u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m, with the\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[4C\u001b[1Bname,\u001b[11Gemail,\u001b[18Gphone,\u001b[25Gtopic,\u001b[32Gmessage\u001b[40G(at\u001b[44Gleast\u001b[50G20\u001b[53Gcharacters)\u001b[65Gand\u001b[69Ga\u001b[71Gconsent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B  version control,\u001b[22Gso\u001b[25Gthe\u001b[29Gbackend\u001b[37GForms\u001b[43Gmodule\u001b[50Gshows\u001b[56Git\u001b[59Gbut\u001b[63Gcan't\u001b[69Gedit\u001b[74Git.\r\u001b[4C\u001b[1B\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfigurati\u001b[26Gn/Form/S\u001b[35Gtepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes with the\u001b[K\r\u001b[4C\u001b[1Bdesign's c\u001b[16Gasses. The only\u001b[32Gt\u001b[34Gmplate override\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds \u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto th\u001b[101Gform\u001b[K\r\u001b[4C\u001b[1Btag because a form definition can't \u001b[42Get it.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMai\u001b[9Gs:\u001b[22m a\u001b[14Gsite layout and templates under \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m. The consent checkbox is\r\u001b[4C\u001b[1Bl\u001b[7Gft out\u001b[14Gof th\u001b[20G mails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[24G\u001b[39mis now a depe\u001b[38Gdency of the\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[39m updat\u001b[44G also adds \u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m, which the sit\u001b[85Gpackage alr\u001b[97Gady\u001b[K\r\u001b[4C\u001b[1Br\u001b[7Gquired\u001b[14Gbut the lock had\u001b[31Gmissed.\r\u001b[4C\u001b[1B\u001b[1mContact page:\u001b[22m a new \u001b[26Gcript,\u001b[33G\u001b[38;2;177;185;249mBuild/Initialisation/seed-contac\u001b[66G-f\u001b[69Grm.php\u001b[39m, runs after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m.\u001b[104GIt\r\u001b[4C\u001b[1Bswitches the page to the \"Sidebar right\" \u001b[47Gayout, puts the form in\u001b[71Gt\u001b[73Ge main area and moves the address,\r\u001b[4C\u001b[1Bopen\u001b[10Gng ho\u001b[16Grs and \"Report\u001b[31Ga problem\"\u001b[42Ginto\u001b[47Gthe\u001b[51Gsidebar.\u001b[60GI\u001b[62Gre-exported\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[84Gand\u001b[88Gthe\u001b[92Gdiff\u001b[97Gcontains\r\u001b[2C\u001b[1B \u001b[5Gonly those changes.\u001b[25GThe README explains all of this.\u001b[K\r\u001b[4C\u001b[1B        \u001b[14G   \u001b[18G    \u001b[23G  \u001b[26G   \u001b[30G        \u001b[39G \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[731.702803, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mWrong input:\u001b[22m each bad field shows its own message\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's styl\u001b[19Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpam:\u001b[22m a submis\u001b[20Gion\u001b[24Gthat\u001b[29Gfills\u001b[35Gthe\u001b[39Ghidden\u001b[46Ghoneypot\u001b[55Gfield\u001b[61Gis\u001b[64Grejected\u001b[73Gand\u001b[77Gno\u001b[80Gmail\u001b[85Gis\u001b[88Gsent.\r\u001b[4C\u001b[1B\u001b[1mValid message:\u001b[22m the\u001b[24Gvisitor sees the gr\u001b[44Gen \"Asante! Your\u001b[61Gmessag\u001b[68G has\u001b[73Gbeen sent.\"\u001b[85Gbox. In Mailpit,\u001b[102Gone\r\u001b[2C\u001b[1B \u001b[5Gmail went to \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m with the visi\u001b[53Gor\u001b[56Gas \u001b[60Geply-to,\u001b[69Gand\u001b[73Ga copy went\u001b[85Gt\u001b[87G the vis\u001b[96Gtor. B\u001b[103Gth\r\u001b[4C\u001b[1Buse a Mto\u001b[15GSafi mail layout instead of the TYPO3-b\u001b[55Ganded system m\u001b[70Gil.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mForm defini\u001b[17Gion:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith\u001b[70Gthe\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[2C\u001b[1B \u001b[5Gname, email, phone, topic, message (at least 20 characters)\u001b[65Gand a consent checkbox. It's a file under\r\u001b[4C\u001b[1Bversion control, so\u001b[26Ghe back\u001b[34Gnd Forms module\u001b[50Gshows it but can't\u001b[69Gedit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap\u001b[87Gclasses\u001b[95Gwith\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's\u001b[14Gclasses. The only template override is \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds \u001b[38;2;177;185;249mclass=\"form\"\u001b[39m to \u001b[99Ge form\r\u001b[4C\u001b[1Btag because a form d\u001b[26Gfi\u001b[29Gition can't\u001b[41Gset it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m \u001b[13G \u001b[15Gite\u001b[19Glayout and \u001b[31Gemplates under \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out\u001b[14Gof the mails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m i\u001b[26G now\u001b[31Ga\u001b[33Gdependency\u001b[44Gof\u001b[47Gthe\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mcomposer.js\u001b[17Gn\u001b[39m. The\u001b[24G\u001b[38;2;177;185;249mcomposer.lock\u001b[39m update also adds \u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m, which the \u001b[82Gitepackage already\u001b[K\r\u001b[4C\u001b[1Brequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m a new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m,\u001b[77Gruns\u001b[82Gafter\u001b[88G\u001b[38;2;177;185;249mseed-pages.php\u001b[39m.\u001b[104GIt\r\u001b[2C\u001b[1B \u001b[5Gswitches the p\u001b[20Gge to the \"Sidebar right\" layout, puts the form in the main area and moves the address,\r\u001b[4C\u001b[1Bopening hours \u001b[20Gnd\u001b[23G\"Report a problem\" into the sidebar. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m, and the diff contain\u001b[105G\u001b[K\r\u001b[5C\u001b[1Bnly those changes. The README explains all of this.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open:\u001b[22m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
