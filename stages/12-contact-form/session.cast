[860.294273, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhere3 can I see the mail?\u001b[39m                                                                              \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe mails are in Mailpit,\u001b[29Gwhich\u001b[35GDDEV\u001b[40Gruns\u001b[45Galongside\u001b[55Gthe\u001b[59Gsite:\u001b[65G\u001b]8;id=1ubqeku;https://demo.ddev.site:8026\u0007\u001b[94m\u001b[1mhttps://demo.ddev.site:8026\u001b]8;;\u0007\r\u001b[2B\u001b[22m\u001b[39m \u001b[3GYou\u001b[7Gc\u001b[9Gn also open it from\u001b[29Gt\u001b[31Ge terminal with \u001b[38;2;177;185;249mddev mailpit\u001b[39m.\u001b[K\r\u001b[2C\u001b[2BDDEV catches\u001b[16Gev\u001b[19Gry mail the si\u001b[35G se\u001b[39Gds, so nothing goes to\u001b[62Ga\u001b[64Greal\u001b[69Gaddress.\u001b[78GYou'll\u001b[85Gfind\u001b[90Gmy\u001b[93Gtest\u001b[98Gmessages\r\u001b[2C\u001b[1Bthere:\r\u001b[2C\u001b[1B- \u001b[1m\"Contact form: Health\"\u001b[22m: the m\u001b[35Gs\u001b[37Gage to the municipality.\u001b[62G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1m\"Your message to Mto Safi Municipality\"\u001b[22m:\u001b[46Gthe\u001b[50Gcopy\u001b[55Gfor\u001b[59Gthe\u001b[63Gvisitor.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMailpit has an HTML and a plain-text tab for \u001b[49Ga\u001b[51Gh mail,\u001b[59Gso you can check\u001b[76Gboth\u001b[81Gversions.\r\u001b[2C\u001b[2BOne correctio\u001b[18Gto my earlier note: \u001b[39Ghe sitepackage README says\u001b[66G\u001b[38;2;177;185;249mddev launch -m\u001b[39m, but this\u001b[91GDDEV\u001b[96Gversion\r\u001b[2C\u001b[1Bnames\u001b[9Gthe\u001b[13Gcommand\u001b[21G\u001b[38;2;177;185;249mddev mailpit\u001b[39m.\u001b[35GI\u001b[37Gcan\u001b[41Gfix\u001b[45Gthat\u001b[50Gline\u001b[55Gif\u001b[58Gyou\u001b[62Glike.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153