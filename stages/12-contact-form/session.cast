[1208.334379, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 239 \u001b[12G\u001b[22mimported\u001b[21Ginto,\u001b[27Gas\u001b[30Glong\u001b[35Gas\u001b[38Gthe\u001b[42Gpage\u001b[47Gkeeps\u001b[53Gthat\u001b[58Gaddress.\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allow\u001b[12Gd by auto mode\r\u001b[2B\u001b[39m \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mALTCHA\u001b[10Gis\u001b[13Gworking\u001b[21Gon\u001b[24Gthe\u001b[28Gcontact\u001b[36Gform.\u001b[42GVisitors\u001b[51Gtick\u001b[56G\"I'm\u001b[61Gnot\u001b[65Ga\u001b[67Grobot\"\u001b[74Gbefore\u001b[81Gsending,\u001b[90Gand\u001b[94Gthe\u001b[98Ghoneypot\r\u001b[2C\u001b[1Bstays as a second lay\u001b[25Gr. Nothing i\u001b[39Gcommitted.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhat I tested:\u001b[22m I solved the puzzles with a script that does the same computation as the widget.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌\u001b[30G┬\u001b[104G┐\r\u001b[4C\u001b[1B         \u001b[15GCase  \u001b[22G      \u001b[32G     \u001b[38G       \u001b[46G \u001b[48G    \u001b[64GResult\r\u001b[4C\u001b[2BC\u001b[7Grrectly solved\u001b[22Gpuzzle\u001b[32GS\u001b[34Gnt, \u001b[39Gxactly 1 mail  \u001b[55G    \u001b[60G   \u001b[64G \u001b[66G      \u001b[73G   \u001b[77G    \u001b[82G     \u001b[88G  \u001b[91G  \u001b[94G         \r\u001b[4C\u001b[2BNo solution  \u001b[19G    \u001b[24G     \u001b[40G:\u001b[42G\"Pleas\u001b[49G tick \"I'm\u001b[60Gn\u001b[62Gt a r\u001b[68Gbot\"\u001b[73Gand\u001b[77Gwait\u001b[82Guntil\u001b[88Git\u001b[91Gis\u001b[94Gchecked.\"\r\u001b[4C\u001b[2BS\u001b[7Gm\u001b[19Gsent\u001b[24Gagain\u001b[40G,\u001b[42Gsince\u001b[48Geach\u001b[53Gpuzzle\u001b[60Gcounts\u001b[67Gonce\r\u001b[2C\u001b[1B├\u001b[30G┼\u001b[104G┤\r\u001b[2C\u001b[1B│\u001b[5GFake\u001b[10Gsolution\u001b[30G│\u001b[32GRejected\u001b[104G│\r\u001b[2C\u001b[1B└──────────