[1370.512735, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B┌─────────────────────────────────┬───────────────────┬─────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│             Measure             │      Effect       │                  Downside                   │\r\u001b[2C\u001b[1B├─────────────────────────────────┼───────────────────┼─────────────────────────────────────────────┤\r\u001b[4C\u001b[1B                       \u001b[39G     \u001b[45G     \u001b[51G    \u001b[59GA visitor's ch\u001b[74Gap phon\u001b[82G waits too. A factor\r\u001b[4C\u001b[1B\u001b[1mRaise ALTCHA difficulty\u001b[22m   \u001b[39GEvery solve\u001b[51Ggets\u001b[59G of\u001b[63G10 mean\u001b[72Gs\u001b[74Gvera\u001b[79G sec\u001b[84Gnds on a phone\u001b[100G  \r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m)\u001b[39Gslower\u001b[59Gbu\u001b[63Gonly 2 s per solve\u001b[82Gfor the\u001b[90Gattacker,\u001b[100Gso\r\u001b[2C\u001b[1B│                                 │                   │  it still doesn't stop them.                │\r\u001b[2C\u001b[1B├─────────────────────────────────┼───────────────────┼─────────────────────────────────────────────┤\r\u001b[4C\u001b[1B                         \u001b[39GCaps how\u001b[48Gf\u001b[50Gst\u001b[53Gone\u001b[59GCustom code. It processes IP addresses,  \r\u001b[4C\u001b[1B\u001b[1mLimit \u001b[12Gubmissions per IP \u001b[39G\u001b[22m machine can  \u001b[54G  \u001b[59Gwhich the privacy policy mu\u001b[87Gt mention. An \r\u001b[4C\u001b[1B\u001b[1maddress\u001b[22m,\u001b[14Ge.g.\u001b[19G5\u001b[21Gan\u001b[24Ghour\u001b[39Gsend, whatever\u001b[54Git\u001b[59Gat\u001b[62Gacker\u001b[68Gwith\u001b[73Gmany\u001b[78GIP\u001b[81Gaddresses\u001b[91Gcan\u001b[95Gspread\r\u001b[2C\u001b[1B│                                 │  solves           │ out.                                        │\r\u001b[2C\u001b[1B├─────────────────────────────────┼───────────────────┼──────────────────────────────────────────