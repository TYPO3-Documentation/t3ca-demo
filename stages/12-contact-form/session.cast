ail layout\u001b[32Ginstead of the\u001b[47GTYPO3-branded\u001b[61Gsy\u001b[64Gtem mail.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith\u001b[70Gthe\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[2C\u001b[1B  name, email, phone,\u001b[25Gtopic,\u001b[32Gmessage\u001b[40G(at\u001b[44Gleast\u001b[50G20\u001b[53Gcharacters)\u001b[65Gand\u001b[69Ga\u001b[71Gconsent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B \u001b[5Gversion control,\u001b[22Gso the backend Forms module shows it but can'\u001b[68G edit\u001b[74Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes with the\u001b[K\r\u001b[4C\u001b[1Bd\u001b[7Gsign's classes. The only t\u001b[34Gmplate overrid\u001b[50Gis \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag because a form definition can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and templates und\u001b[45G \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m. The consent\u001b[94Gcheckbox is\r\u001b[4C\u001b[1Bleft out of\u001b[17Gthe mails.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m is \u001b[28Gow a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cm\u001b[74G-f\u001b[79G\u001b[39m is in\u001b[86Gthe si\u001b[93Gepackage's\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[38G\u001b[39mupdate\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[2C\u001b[1B \u001b[5Grequired but the lock\u001b[27Ghad\u001b[31Gmissed.  \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
