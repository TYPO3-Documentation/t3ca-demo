[725.441935, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes wi\u001b[99G the\u001b[K\r\u001b[4C\u001b[1Bdesign's classes. Th\u001b[26G o\u001b[29Gly template\u001b[41Goverride\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m,\u001b[70Gwhich\u001b[76Gadds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag bec\u001b[13Gu\u001b[15Ge a\u001b[19Gform defini\u001b[31Gion can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and\u001b[30Gtemplates\u001b[40Gunder\u001b[46G\u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out of the mail\u001b[26G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtyp\u001b[17G3/form\u001b[24G\u001b[39mis now a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cms-form\u001b[39m i\u001b[82G in the sitepackage's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[39m update\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[2C\u001b[1B \u001b[5Grequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m \u001b[20G new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m, runs after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m. It\u001b[K\r\u001b[4C\u001b[1Bswitches the p\u001b[20Gge\u001b[23Gto the \"Sidebar right\" layout, puts the form in the main area and moves the addre\u001b[105Gs,\r\u001b[5C\u001b[1Bpening hours and \"Report a problem\" into the sidebar.\u001b[60GI\u001b[62Gre-exported\u001b[74G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[84Gand\u001b[88Gthe\u001b[92Gdiff\u001b[97Gcontains\r\u001b[4C\u001b[1Bonly\u001b[10Gthose\u001b[16Gchanges.\u001b[25GThe\u001b[29GREADME\u001b[36Gexplains\u001b[45Gall\u001b[49Gof\u001b[52Gthis.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill ope\u001b[13G:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFresh-install check:\u001b[26G\u001b[22mthis \u001b[32Ge\u001b[35Gs an empty database,\u001b[56Gand\u001b[60Gthe safety ch\u001b[74Gck blocked me from dropping it.\u001b[K\r\u001b[4C\u001b[1BYour installation is unchanged by that\u001b[44Gattempt. To run it yourself, either follo\u001b[86G \"Starting over\"\u001b[103Gand\r\u001b[4C\u001b[1B\"Fre\u001b[11G install\" in the root\u001b[33G\u001b[38;2;177;185;249mREADME.md\u001b[39m, or\u001b[47Gtell me to go\u001b[61Gahead and\u001b[71GI'll do\u001b[79Git between\u001b[90Gtwo\u001b[94Gdatabase\r\u001b[4C\u001b[1Bsnapshots and restore\u001b[27Gyours\u001b[33Gafterwards.\u001b[45GA\u001b[47Gsnapshot\u001b[56Gfrom\u001b[61Gbefore\u001b[68Gmy\u001b[71Gchanges\u001b[79Gexists\u001b[86Gas\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mbefore-contact-form\u001b[39m.\u001b[26G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisual check:\u001b[19G\u001b[22mI\u001b[21Gonly\u001b[26Gchecked\u001b[34Gthe\u001b[38GHTML,\u001b[44Gnot\u001b[48Gthe\u001b[52Gpage\u001b[57Gin\u001b[60Ga\u001b[62Gbrowser.\u001b[71GPlease\u001b[78Glook\u001b[83Gat\u001b[86Gthe\u001b[90Gtwo-column\r\u001b[2C\u001b[1B \u001b[5Glayout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMail sender:\u001b[22m th\u001b[21G mails come\u001b[33Gfrom\u001b[38G\u001b[38;2;177;185;249mnoreply@mtosafi.example\u001b[39m.\u001b[63GOn\u001b[66Ga\u001b[68Glive\u001b[73Gserver,\u001b[81Gthat\u001b[86Gdomain\u001b[93Ghas\u001b[97Gto\u001b[100Gallow\r\u001b[2C\u001b[1B \u001b[5Gthe server to send\u001b[24Gmail for it.\u001b[K\r\u