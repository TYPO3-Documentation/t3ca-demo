[1109.83198, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat a visitor no\u001b[21Gices:\u001b[22m Too many submissions\u001b[48Gin\u001b[51Ga\u001b[53Gshort\u001b[59Gtime\u001b[64Gare\u001b[68Grefused\r\u001b[2C\u001b[1B\u001b[1mPrivacy:\u001b[22m Handles IP addresses, which needs a\u001b[48Gmention in\u001b[60Ghe privacy policy\r\u001b[2C\u001b[1B\u001b[1mEffort:\u001b[22m Custom code\u001b[23G\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1mHosted CAPTCHA\u001b[22m (Friendly Captcha,\u001b[45Gcaptcha.eu,\u001b[57Gmosparo,\u001b[66GTrustCaptcha)\r\u001b[2C\u001b[1B\u001b[1mWhat a visi\u001b[15Gor\u001b[18Gnotices:\u001b[22m Mostly invisible\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPrivacy:\u001b[22m Data goes to an \u001b[29Gu\u001b[31Gside servic\u001b[43G,\u001b[45Gwhich\u001b[51Gneeds\u001b[57Ga\u001b[59Gprocessing\u001b[70Gagreement\u001b[80Gand\u001b[84Gpolicy\u001b[91Gtext;\u001b[97Gmosparo\r\u001b[2C\u001b[1B  can be\u001b[12Ghosted yourself\u001b[28G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEffort:\u001b[22m Extension plus account\u001b[34Gor\u001b[37Gown\u001b[41Gserver\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1mGoogle reCAPTCHA\u001b[22m (\u001b[38;2;177;185;249mhaffner/jh_captcha\u001b[39m)\r\u001b[2C\u001b[1B\u001b[1mWhat a visitor\u001b[18Gnotices:\u001b[22m Sometimes a puzzle\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPrivacy:\u001b[22m Sends visitor data \u001b[32Go Google, so I\u001b[47Gadvise\u001b[54Gagainst\u001b[62Git\u001b[65Gfor\u001b[69Ga\u001b[71Gpublic\u001b[78Gauthority\r\u001b[2C\u001b[1B\u001b[1mEffort:\u001b[22m Exten\u001b[17Gion plus\u001b[26GGoogle acc\u001b[37Gunt\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BAdd\u001b[7GALTCHA\u001b[14Gon\u001b[17Gtop\u001b[21Gof\u001b[24Gthe\u001b[28Ghoneypot.\u001b[38GIt\u001b[41Gstops\u001b[47Gautomated\u001b[57Gspam\u001b[62Gwithout\u001b[70Gan\u001b[73Goutside\u001b[81Gservice\u001b[89Gor\u001b[92Gcookies,\u001b[101Gand\r\u001b[2C\u001b[1Bmost visitors\u001b[17Gw\u001b[19Gn't notice it. For\u001b[38Ga municip\u001b[48Glity, that keeps the privacy side simpl\u001b[88G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBefore\u001b[10Grelying\u001b[18Gon\u001b[21Git,\u001b[25GI'd\u001b[29Ginstall\u001b[37Git\u001b[40Gin\u001b[43Gthis\u001b[48Gproject\u001b[56Gand\u001b[60Gtest\u001b[65Git\u001b[68Gagainst\u001b[76G14.3.\u001b[82GThe\u001b[86Gextension\u001b[96Gonly\u001b[101Gstates\r\u001b[2C\u001b[1Bthat it supports 14, and I haven't \u001b[39Gested \u001b[46Gt\u001b[48Gyet. I\u001b[57Glso adds a\u001b[68GJavaScript widget\u001b[86Gand a third-party\u001b[K\r\u001b[2C\u001b[1Bpackage\u001b[11Gthe si\u001b[18Ge\u001b[20Gwill \u001b[26Geed\u001b[30Gto keep\u001b[38Gupdated.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd\u001b[7Gskip\u001b[12Gthe\u001b[16Glink\u001b[21Gfilter\u001b[28Gfor\u001b[32Gnow,\u001b[37Gbec\u001b[70Glinks\u001b[76Gon\u001b[79Gpurpose,\u001b[88Gand\u001b[92Git's\u001b[97Gquick\u001b[103Gto\u001b[31;1H\u001b[29;3H\u001b[?25h"]
