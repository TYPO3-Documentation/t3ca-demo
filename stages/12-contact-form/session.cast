[725.456534, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gversion control, so the backend Forms module shows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes wi\u001b[99G the\u001b[K\r\u001b[4C\u001b[1Bdesign's classes. Th\u001b[26G o\u001b[29Gly template\u001b[41Goverride\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m,\u001b[70Gwhich\u001b[76Gadds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag bec\u001b[13Gu\u001b[15Ge a\u001b[19Gform defini\u001b[31Gion can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and\u001b[30Gtemplates\u001b[40Gunder\u001b[46G\u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out of the mail\u001b[26G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtyp\u001b[17G3/form\u001b[24G\u001b[39mis now a dependency of the site set, and \u001b[38;2;177;185;249mtypo3/cms-form\u001b[39m i\u001b[82G in the sitepackage's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m. The \u001b[38;2;177;185;249mcomposer.lock\u001b[39m update\u001b[45Galso\u001b[50Gadds\u001b[55G\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m,\u001b[71Gwhich\u001b[77Gthe\u001b[81Gsitepackage\u001b[93Galready\r\u001b[2C\u001b[1B \u001b[5Grequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m \u001b[20G new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m, runs after \u001b[38;2;177;185;249mseed-pages.php\u001b[39m. It\u001b[K\r\u001b[4C\u001b[1Bswitches the p\u001b[20Gge\u001b[23Gto the \"Sidebar right\" layou