of\u001b[81G\u001b[38;2;177;185;249mddev launch -m\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI left the mail layout\u001b[26Gset\u001b[30Gings for \u001b[38;2;177;185;249mEmailToSender\u001b[53G\u001b[39mi\u001b[55G \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m. Th\u001b[103Gy do\r\u001b[2C\u001b[1Bnothing now,\u001b[16Gbut if an editor ever adds a\u001b[45Gcopy to\u001b[53Ganother form, it g\u001b[72Gts the\u001b[79Gsite's\u001b[86Gmail\u001b[91Glayout\u001b[98Ginstead\r\u001b[2C\u001b[1Bof\u001b[6Gthe\u001b[10GTYPO3\u001b[16Gone.\u001b[21G\u001b[38;2;177;185;249mdata.xml\u001b[30G\u001b[39mdidn't\u001b[37Gchange,\u001b[45Gbecause\u001b[53Gthe\u001b[57Gcopy\u001b[62Gwas\u001b[66Gdefined\u001b[74Gonly\u001b[79Gin\u001b[82Gthe\u001b[86Gform\u001b[91Gfile.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gfresh-install\u001b[21Gcheck\u001b[27Gof\u001b[30G\u001b[38;2;177;185;249mdata.xml\u001b[39G\u001b[39mis\u001b[42Gstill\u001b[48Gopen,\u001b[54Gand\u001b[58Gnothing\u001b[66Gis\u001b[69Gcommitted\u001b[79Gyet.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mWorked for 32s ·\u001b[20Gd\u001b[22Gne 6:47 PM\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
