[415.213236, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mValidation\u001b[14Gshows\u001b[20G6\u001b[22Gerrors\u001b[29G(all\u001b[34Ginvalid\u001b[42Gfields)\u001b[50Gand\u001b[54Gthe\u001b[58Gvalid\u001b[64Gsubmission\u001b[75Gshows\u001b[81Gthe\u001b[85Gconfirmation.\u001b[99GChecking\r\u001b[1B \u001b[3Gthe error t\u001b[15Gxts \u001b[20Gnd the mails in Mailpit:\u001b[45G\u001b[K\r\u001b[2C\u001b[4BBoth emails \u001b[16Gave\u001b[20Gth\u001b[23G c\u001b[27Grect sender, rec\u001b[44Gpient\u001b[54Greply-to.\u001b[64GThe phone err\u001b[78Gr points to a nonexistent\u001b[K\r\u001b[2C\u001b[1Bfi\u001b[6Gld descrip\u001b[17Gion, so I'\u001b[28G giving\u001b[36Git its own\u001b[47Gmessage,\u001b[56Gand\u001b[60GI'm\u001b[64Gchecking\u001b[73Gthe\u001b[77Gvisitor's\u001b[87Gcopy\u001b[92Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[4B\u001b[39mTwo more fixes are in p\u001b[27Gogres\u001b[33G: the plain-t\u001b[47Gx\u001b[50Ggreeting runs\u001b[64Ginto the n\u001b[75Gxt paragraph, and th\u001b[96G consent\r\u001b[2C\u001b[1Bch\u001b[6Gckbox shows as \"Privacy policy: 1\" in both mails.\u001b[56GI'm\u001b[60Ghiding the checkbox \u001b[81Gn the\u001b[87Gmails, since consent\r\u001b[2C\u001b[1Bis\u001b[6Grequired\u001b[15Ganyway,\u001b[23Gas\u001b[26Gthe\u001b[30Gcore\u001b[35Galready\u001b[43Gdoes\u001b[48Gfor\u001b[52Gstatic\u001b[59Gtext.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage && python3 - <<'EOF'\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mf='Resources/Private/Forms/contact.form.yaml'\u001b[39m\