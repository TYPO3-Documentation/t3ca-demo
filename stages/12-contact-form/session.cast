[620.261721, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 41 +\u001b[38;2;248;248;242mpages, with the illustrations in `Build/Initialisation/images/`, and                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 42 +\u001b[38;2;248;248;242m`Build/Initialisation/seed-contact-form.php` the contact form on the \"Contact\" page,     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 43 +\u001b[38;2;248;248;242mand it is exported                                                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 44 \u001b[22m fr\u001b[14Gm there:\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 45 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 46 \u001b[15G\u001b[22mddev\u001b[20Gexec\u001b[25Gphp\u001b[29GBuild/Initialisation/seed-page-tree.php\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 49 \u001b[22m     ddev exec php Build/Initialisation/seed-not-found.php\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 50 \u001b[22m     ddev exec php Build/Initialisation/seed-search.php\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 51 \u001b[22m     ddev exec php Build/Initialisation/seed-pages.php\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 52 +\u001b[38;2;248;248;242m    ddev exec php Build/Initialisation/seed-contact-form.php                             \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 53 \u001b[22m     ddev exec typo3 impexp:export --type=xml\u001b[56G--pid=1\u001b[64G--levels=999\u001b[77G\\\r\u001b[5C\u001b[1B\u001b[2m 54 \u001b[22m         --table=pages --table=tt_content --table=sys_category\u001b[73G\\\r\u001b[5C\u001b[1B\u001b[2m 55 \u001b[19G\u001b[22m--table=tx_news_domain_model_news\u001b[53G--table=tx_news_domain_model_link\u001b[87G\\\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 183 \u001b[12G\u001b[22mte\u001b[15Gplate is `Resource\u001b[34G/Priv