[1209.79107, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[4C\u001b[1Block\u001b[10Gfile\u001b[15Gis\u001b[18Gupdated.\r\u001b[2C\u001b[1B- \u001b[1mSite set:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[37G\u001b[39mis\u001b[40Gnow\u001b[44Ga\u001b[46Gdependency.\r\u001b[4C\u001b[1B\u001b[1mF\u001b[7Grm:\u001b[22m \u001b[38;2;177;185;249mcontact.form.yaml\u001b[39m has an ALTCHA element above the button, with friendlier error texts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm setup:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[33G\u001b[22mthe extension added an empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty means it\u001b[91Gsign\u001b[96G puzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key, which is fine, and the change belongs in the commit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt's a hurdle, not a wall.\u001b[22m It stops bots that do\u001b[54G't run\u001b[61GJavaScript\u001b[72Gor\u001b[75Gdon't\u001b[81Gsolve\u001b[87GALTCHA\u001b[94Gpuzzles.\u001b[103GA\r\u001b[4