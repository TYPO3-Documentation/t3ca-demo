[1206.74231, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mForm setup:\u001b[17G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extensio\u001b[46G adde\u001b[53Gan empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty \u001b[83Geans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key,\u001b[34Gwhich is\u001b[43Gf\u001b[45Gne, and th\u001b[56G change\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThing\u001b[10Gyou should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[22m It stops bots that don't \u001b[58Gun JavaScript or d\u001b[78G't solve ALTCHA puzzles.\u001b[103GA\r\u001b[5C\u001b[1Betermined\u001b[16Gspamm\u001b[22Gr can\u001b[29Gtill solve it cheaply: my script needed\u001b[69G0.1 sec\u001b[77Gnds. You can raise the\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gdifficulty in the site settings\u001b[37G(\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m),\u001b[65Gbut that slow\u001b[79G dow\u001b[84G cheap phon\u001b[96Gs \u001b[99Goo.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every page view s\u001b[49Gore\u001b[53G one puzzle in the database, and \u001b[87Gothing deletes them\r\u001b[4C\u001b[1Bautomatically. The scheduler extension isn't installed, so production needs a cron\u001b[88Gjob\u001b[92Grunning\u001b[100G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249maltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. It'\u001b[72G in the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The ex\u001b[45Gension\u001b[52Gregisters i\u001b[64Gs form s\u001b[73Gtup the old TypoScript way, which\r\u001b[4C\u001b[1BTYPO3 14.2 deprecated\u001b[27Gand\u001b[31G15\u001b[34Gremoves.\u001b[43GIt\u001b[46Gworks\u001b[52Gon\u001b[55G14.3,\u001b[61Gbut\u001b[65Gthe\u001b[69Gextension\u001b[79Gmust\u001b[84Gbe\u001b[87Gupdated\u001b[95Gbefore\u001b[102Gany\r\u001b[2C\u001b[1B \u001b[5Gmove to TYPO3 15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisitors have to click the checkbox.\u001b[22m It verifies in under\u001b[63Ga second. Setting \u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\r\u001b[4C\u001b[1Bsolve\u001b[15Gpuzzle as\u001b[25Gsoon\u001b[30Gas\u001b[33Gsomeone\u001b[41Gstarts\u001b[48Gfilling\u001b[56Gin\u001b[59Gthe\u001b[63Gform,\u001b[69Gso\u001b[72Git's\u001b[77Gusually\u001b[85Gdone\u001b[90Gbefore\u001b[97Gthey\r\u001b[2C\u001b[1B \u001b[5Greach the checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent Security Policy:\u001b[30G\u001b[22mthe extension loosens\u001b[56Gsite's CSP for the widget (it\u001b[86Gallows\u001b[93G\u001b[38;2;177;185;249mblob:\u001b[99G\u001b[39mworkers\r\u001b[4C\u001b[1Band\u001b[9Ginline\u001b[16Gstyles).\u001b[25GThat\u001b[30Gonly\u001b[35Ghas\u001b[39Gan\u001b[42Geffect\u001b[49Gif\u001b[52Gthe\u001b[56Gfrontend\u001b[65GCSP\u001b[69Gis\u001b[72Gswitched\u001b[81Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill open from before: the cons\u001b[36Gnt text renders bold\u001b[57Gwhile the design shows normal weigh\u001b[93G (a\u001b[97Gsmall\u001b[103GSass\r\u001b[2C\u001b[1Bfix\u001b[7Gplus an asset build), and the fresh-install check of\u001b[60G\u001b[38;2;177;185;249mdata.xml\u001b[39m.\u001b[70GTell\u001b[75Gme\u001b[78Gif\u001b[81Gyou\u001b[85Gwant\u001b[90Geither\u001b[97Gdone,\u001b[103Gor\r\u001b[2C\u001b[1Bsay\u001b[7G\"commit\"\u001b[16Gand\u001b[20GI'll\u001b[25Gshow\u001b[30Gyou\u001b[34Gthe\u001b[38Gcommit\u001b[45Gmessage\u001b[53Gfirst.\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1206.758585, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ yes, try ALTCHA\u001b[39m                                                                                         \r\u001b[2C\u001b[1B\u001b[49m-\u001b[5G\u001b[1mForm setup:\u001b[17G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extensio\u001b[46G adde\u001b[53Gan empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty \u001b[83Geans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key,\u001b[34Gwhich is\u001b[43Gf\u001b[45Gne, and th\u001b[56G change\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThing\u001b[10Gyou should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[22m It stops bots that don't \u001b[58Gun JavaScript or d\u001b[78G't solve ALTCHA puzzles.\u001b[103GA\r\u001b[5C\u001b[1Betermined\u001b[16Gspamm\u001b[22Gr can\u001b[29Gtill solve it cheaply: my script needed\u001b[69G0.1 sec\u001b[77Gnds. You can raise the\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gdifficulty in the site settings\u001b[37G(\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m),\u001b[65Gbut that slow\u001b[79G dow\u001b[84G cheap phon\u001b[96Gs \u001b[99Goo.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every page view s\u001b[49Gore\u001b[53G one puzzle in the database, and \u001b[87Gothing deletes them\r\u001b[4C\u001b[1Bautomatically. The scheduler extension isn't installed, so production needs a cron\u001b[88Gjob\u001b[92Grunning\u001b[100G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249maltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. It'\u001b[72G in the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The ex\u001b[45Gension\u001b[52Gregisters i\u001b[64Gs form s\u001b[73Gtup the old TypoScript way, which\r\u001b[4C\u001b[1BTYPO3 14.2 deprecated\u001b[27Gand\u001b[31G15\u001b[34Gremoves.\u001b[43GIt\u001b[46Gworks\u001b[52Gon\u001b[55G14.3,\u001b[61Gbut\u001b[65Gthe\u001b[69Gextension\u001b[79Gmust\u001b[84Gbe\u001b[87Gupdated\u001b[95Gbefore\u001b[102Gany\r\u001b[2C\u001b[1B \u001b[5Gmove to TYPO3 15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisitors have to click the checkbox.\u001b[22m It verifies in under\u001b[63Ga second. Setting \u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\r\u001b[4C\u001b[1Bsolve\u001b[15Gpuzzle as\u001b[25Gsoon\u001b[30Gas\u001b[33Gsomeone\u001b[41Gstarts\u001b[48Gfilling\u001b[56Gin\u001b[59Gthe\u001b[63Gform,\u001b[69Gso\u001b[72Git's\u001b[77Gusually\u001b[85Gdone\u001b[90Gbefore\u001b[97Gthey\r\u001b[2C\u001b[1B \u001b[5Greach the checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent Security Policy:\u001b[30G\u001b[22mthe extension loosens\u001b[56Gsite's CSP for the widget (it\u001b[86Gallows\u001b[93G\u001b[38;2;177;185;249mblob:\u001b[99G\u001b[39mworkers\r\u001b[4C\u001b[1Band\u001b[9Ginline\u001b[16Gstyles).\u001b[25GThat\u001b[30Gonly\u001b[35Ghas\u001b[39Gan\u001b[42Geffect\u001b[49Gif\u001b[52Gthe\u001b[56Gfrontend\u001b[65GCSP\u001b[69Gis\u001b[72Gswitched\u001b[81Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill open from before: the cons\u001b[36Gnt text renders bold\u001b[57Gwhile the design shows normal weigh\u001b[93G (a\u001b[97Gsmall\u001b[103GSass\r\u001b[2C\u001b[1Bfix\u001b[7Gplus an asset build), and the fresh-install check of\u001b[60G\u001b[38;2;177;185;249mdata.xml\u001b[39m.\u001b[70GTell\u001b[75Gme\u001b[78Gif\u001b[81Gyou\u001b[85Gwant\u001b[90Geither\u001b[97Gdone,\u001b[103Gor\r\u001b[2C\u001b[1Bsay\u001b[7G\"commit\"\u001b[16Gand\u001b[20GI'll\u001b[25Gshow\u001b[30Gyou\u001b[34Gthe\u001b[38Gco\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1206.780126, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[1B\u001b[1m:\u001b[22m \u001b[38;2;177;185;249mcontact.form.y\u001b[26Gml\u001b[39m has an ALTCHA element above the button, with friendlier error\u001b[91Gtexts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm setup:\u001b[17G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extensio\u001b[46G adde\u001b[53Gan empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty \u001b[83Geans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key,\u001b[34Gwhich is\u001b[43Gf\u001b[45Gne, and th\u001b[56G change\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[43G\u001b[39mdidn't\u001b[50Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThing\u001b[10Gyou should know:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's a hurdle, not a wall.\u001b[22m It stops bots that don't \u001b[58Gun JavaScript or d\u001b[78G't solve ALTCHA puzzles.\u001b[103GA\r\u001b[5C\u001b[1Betermined\u001b[16Gspamm\u001b[22Gr can\u001b[29Gtill solve it cheaply: my script needed\u001b[69G0.1 sec\u001b[77Gnds. You can raise the\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gdifficulty in the site settings\u001b[37G(\u001b[38;2;177;185;249maltcha.maximumComplexity\u001b[39m),\u001b[65Gbut that slow\u001b[79G dow\u001b[84G cheap phon\u001b[96Gs \u001b[99Goo.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCleanup needs a cron job.\u001b[22m Every page view s\u001b[49Gore\u001b[53G one puzzle in the database, and \u001b[87Gothing deletes them\r\u001b[4C\u001b[1Bautomatically. The scheduler extension isn't installed, so production needs a cron\u001b[88Gjob\u001b[92Grunning\u001b[100G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249maltcha:remove-obsolete-challenges --include-solved-challenges\u001b[39m. It'\u001b[72G in the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReady for TYPO3 14.3 but not 15.\u001b[22m The ex\u001b[45Gension\u001b[52Gregisters i\u001b[64Gs form s\u001b[73Gtup the old TypoScript way, which\r\u001b[4C\u001b[1BTYPO3 14.2 deprecated\u001b[27Gand\u001b[31G15\u001b[34Gremoves.\u001b[43GIt\u001b[46Gworks\u001b[52Gon\u001b[55G14.3,\u001b[61Gbut\u001b[65Gthe\u001b[69Gextension\u001b[79Gmust\u001b[84Gbe\u001b[87Gupdated\u001b[95Gbefore\u001b[102Gany\r\u001b[2C\u001b[1B \u001b[5Gmove to TYPO3 15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisitors have to click the checkbox.\u001b[22m It verifies in under\u001b[63Ga second. Setting \u001b[38;2;177;185;249maltcha.auto: onfocus\u001b[102G\u001b[39mwould\r\u001b[4C\u001b[1Bsolve\u001b[15Gpuzzle as\u001b[25Gsoon\u001b[30Gas\u001b[33Gsomeone\u001b[41Gstarts\u001b[48Gfilling\u001b[56Gin\u001b[59Gthe\u001b[63Gform,\u001b[69Gso\u001b[72Git's\u001b[77Gusually\u001b[85Gdone\u001b[90Gbefore\u001b[97Gthey\r\u001b[2C\u001b[1B \u001b[5Greach the checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent Security Policy:\u001b[30G\u001b[22mthe extension loosens\u001b[56Gsite's CSP for the widget (it\u001b[86Gallows\u001b[93G\u001b[38;2;177;185;249mblob:\u001b[99G\u001b[39mworkers\r\u001b[4C\u001b[1Band\u001b[9Ginline\u001b[16Gstyles).\u001b[25GThat\u001b[30Gonly\u001b[35Ghas\u001b[39Gan\u001b[42Geffect\u001b[49Gif\u001b[52Gthe\u001b[56Gfrontend\u001b[65GCSP\u001b[69Gis\u001b[72Gswitched\u001b[81Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill open from before: the cons\u001b[36Gnt text renders bold\u001b[57Gwhile the design shows normal weigh\u0