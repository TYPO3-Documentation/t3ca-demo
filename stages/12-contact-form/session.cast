[270.266093, "o", "\u001b[?25l\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mCalled typo3-dev-companion \u001b[1m7\u001b[22m times, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTYPO3 14.3 still supports shipping form definitions in the\u001b[62Gextension,\u001b[73Gwith\u001b[78Gsetup\u001b[84Gfiles\u001b[90Gfound\r\u001b[2C\u001b[1Bautomatically,\u001b[18Gso\u001b[21GI'm\u001b[25Gnow\u001b[29Greading\u001b[37Gthe\u001b[41Ginstalled\u001b[51Gform\u001b[56Gextension's\u001b[68Gfiles\u001b[74Gfor\u001b[78Gthe\u001b[82Gexact\u001b[88Gformat.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m5\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mStatus: I know how EXT:form renders the form now. Next I'll\u001b[63Gread\u001b[68Gthe\u001b[72Gsite's\u001b[79Gform\u001b[84Gstyles\u001b[91Gso\u001b[94Gthe\u001b[98Gform\u001b[103Gcan\r\u001b[2C\u001b[1Breuse\u001b[9Gthe\u001b[13Gdesign's\u001b[22GCSS\u001b[26Gclasses.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm writing the contact\u001b[27Gform\u001b[32Gas\u001b[35Ga\u001b[37GYAML\u001b[42Gdefinition\u001b[53Gin\u001b[56Gthe\u001b[60Gsitepackage,\u001b[73Gstyled\u001b[80Gonly\u001b[85Gthrough\u001b[93Gconfiguration,\r\u001b[2C\u001b[1Bwith\u001b[8Gsite-branded\u001b[21Gemails,\u001b[29Gand\u001b[33GI'll\u001b[38Gre-export\u001b[48Gdata.xml\u001b[57Gafter\u001b[63Ga\u001b[65Gseed\u001b[70Gscript\u001b[77Gplaces\u001b[84Git\u001b[87Gon\u001b[90Gthe\u001b[94GContact\r\u001b[1B \u001b[3Gpage.\u001b[38;2;153;153;153m · summary\u001b[19G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;15