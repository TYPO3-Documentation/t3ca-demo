[733.396451, "o", "\u001b[?25l\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mCalled typo3-dev-companion \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gcontact\u001b[15Gform\u001b[20Gis\u001b[23Gon\u001b[26Gthe\u001b[30GContact\u001b[38Gpage,\u001b[44Gbuilt\u001b[50Gwith\u001b[55GEXT:form,\u001b[65Gand\u001b[69Git\u001b[72Gworks\u001b[78Gin\u001b[81Gyour\u001b[86GDDEV\u001b[91Ginstallation.\r\u001b[2C\u001b[1BNothing is committed. One check is still open: importing\u001b[60Gthe\u001b[64Gnew\u001b[68G\u001b[38;2;177;185;249mdata.xml\u001b[77G\u001b[39minto\u001b[82Ga\u001b[84Gfresh\u001b[90Ginstallation.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I tested on \u001b]8;id=12ra721;https://demo.ddev.site/contact\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/contact\u001b]8;;\u0007\u001b[39m:\r\u001b[4C\u001b[1BWrong input:\u001b[22m each bad field \u001b[34Ghows\u001b[39Gits own message\u001b[55Gunder\u001b[62Gt\u001b[64Gand th\u001b[71G field is marked\u001b[88Gr\u001b[90Gd with\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's styles.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpam:\u001b[22m a submission that fills the\u001b[39Gh\u001b[41Gdden honeypot field is rejecte\u001b[74Gnd no\u001b[80Gmail\u001b[85Gis\u001b[88Gsent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[20G\u001b[22mthe visitor\u001b[32Gsees the green\u001b[47G\"Asante! Your\u001b[61Gme\u001b[64Gsage has been\u001b[78Gsent.\"\u001b[85Gbox.\u001b[90GIn\u001b[93GMailpit,\u001b[102Gone\r\u001b[4C\u001b[1Bmail\u001b[10Gwent\u001b[15Gto\u001b[18G\u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39G\u001b[39mwith\u001b[44Gthe\u001b[48Gvisitor\u001b[56Gas\u001b[59Greply-to,\u001b[69Gand\u001b[73Ga\u001b[75Gcopy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe\u001b[92Gvisitor.\u001b[101GBoth\r\u001b[2C\u001b[1B  use a Mto Safi\u001b[20Gmail\u001b[25Glayout\u001b[32Ginstead\u001b[40Gof\u001b[43Gthe\u001b[47GTYPO3-branded\u001b[61Gsystem\u001b[68Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m, wi\u001b[68Gh the\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[2C\u001b[1B \u001b[5Gname, email, phone, topic, message (at least 20 characters) and a consent checkbox. It's a file under\r\u001b[4C\u001b[1Bv\u001b[7Grsion control, so the back\u001b[34Gnd Forms modul\u001b[50Gshows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[57G\u001b[39mreplaces\u001b[66GEXT:form's\u001b[77GBootstrap\u001b[87Gclasses\u001b[95Gwith\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's\u001b[14Gclasses. The only template ov\u001b[45Gride is \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds \u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto the form\r\u001b[4C\u001b[1Btag because\u001b[17Ga form definition\u001b[35Gcan't\u001b[41Gset\u001b[45Git.\r\u001b[4C\u001b[1B\u001b[1mMails:\u001b[22m a site layout a\u001b[28Gd templates under \u001b[38;2;177;185;249mResources/Private/Extension\u001b[74G/F\u001b[79G/\u001b[39m. The\u001b[86Gconsen\u001b[93G checkbox is\r\u001b[4C\u001b[1Bleft out of the mails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m is\u001b[27Gnow\u001b[31Ga dependency\u001b[44Gof\u001b[47Gthe\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mcomposer.json\u001b[39m. Th\u001b[23G \u001b[38;2;177;185;249mcomposer.lock\u001b[39m up\u001b[69G, which\u001b[77Gthe sitepackage already\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[733.658406, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLast\u001b[8Gcheck:\u001b[15Gdoes\u001b[20Gthe\u001b[24Ginstallation\u001b[37Gregister\u001b[46Gthe\u001b[50Gform\u001b[55Gsetup\u001b[61Gand\u001b[65Gthe\u001b[69Gdefinition?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe contact form is on the Contact\u001b[38Gpage,\u001b[44Gbuilt\u001b[50Gwith EXT:form, and it works in your DDEV insta\u001b[97Glation.\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted.\u001b[25GOne\u001b[29Gcheck\u001b[35Gis\u001b[38Gstill\u001b[44Gopen:\u001b[50Gimporting\u001b[60Gthe\u001b[64Gnew\u001b[68G\u001b[38;2;177;185;249mdata.xml\u001b[77G\u001b[39minto\u001b[82Ga\u001b[84Gfresh\u001b[90Ginstallation.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I tested on \u001b]8;id=12ra721;https://demo.ddev.site/contact\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/contact\u001b]8;;\u0007\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong input:\u001b[22m \u001b[19Gach\u001b[23Gbad\u001b[27Gfield\u001b[33Gshows\u001b[39Gits\u001b[43Gown\u001b[47Gmessage\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's style\u001b[20G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam:\u001b[22m a submission\u001b[24Gthat fills the hidd\u001b[44Gn honeypot field\u001b[61Gis rej\u001b[68Gcted\u001b[73Gand no mail\u001b[85Gis sent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[22m the visitor sees the green \"Asan\u001b[53Ge!\u001b[56GYou\u001b[60G message\u001b[69Ghas\u001b[73Gbeen sent.\"\u001b[85Gb\u001b[87Gx. In Ma\u001b[96Glpit, \u001b[103Gne\r\u001b[4C\u001b[1Bmail went\u001b[15Gto \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m with the visito\u001b[55G as reply-to, \u001b[70Gnd a\u001b[75Gcopy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe\u001b[92Gvisitor.\u001b[101GBoth\r\u001b[4C\u001b[1Buse\u001b[9Ga\u001b[11GMto\u001b[15GSafi\u001b[20Gmail\u001b[25Glayout\u001b[32Ginstead\u001b[40Gof\u001b[43Gthe\u001b[47GTYPO3-branded\u001b[61Gsystem\u001b[68Gmail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's buil\u001b[17G:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22m \u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith the fields from \u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[4C\u001b[1Bname, email, phone,\u001b[26Gopic, m\u001b[34Gssage (at least\u001b[50G20 characters) and\u001b[69Ga consent\u001b[79Gcheckbox.\u001b[89GIt's\u001b[94Ga\u001b[96Gfile\u001b[101Gunder\r\u001b[2C\u001b[1B \u001b[5Gversion control, so the backend Forms module shows it but can't edit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap classes wi\u001b[99G the\u001b[K\r\u001b[4C\u001b[1Bdesign's classes. Th\u001b[26G o\u001b[29Gly template\u001b[41Goverride\u001b[50Gis\u001b[53G\u001b[38;2;177;185;249mForm.fluid.html\u001b[39m,\u001b[70Gwhich\u001b[76Gadds\u001b[81G\u001b[38;2;177;185;249mclass=\"form\"\u001b[94G\u001b[39mto\u001b[97Gthe\u001b[101Gform\r\u001b[2C\u001b[1B \u001b[5Gtag bec\u001b[13Gu\u001b[15Ge a\u001b[19Gform defini\u001b[31Gion can't set it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m a\u001b[14Gsite layout and\u001b[30Gtemplates\u001b[40Gunder\u001b[46G\u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out of the mail\u001b[26G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtyp\u001b[17G3/form\u001b[24G\u00