[732.047154, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mForm defini\u001b[17Gion:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\u001b[39m,\u001b[65Gwith\u001b[70Gthe\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\r\u001b[2C\u001b[1B \u001b[5Gname, email, phone, topic, message (at least 20 characters)\u001b[65Gand a consent checkbox. It's a file under\r\u001b[4C\u001b[1Bversion control, so\u001b[26Ghe back\u001b[34Gnd Forms module\u001b[50Gshows it but can't\u001b[69Gedit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap\u001b[87Gclasses\u001b[95Gwith\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's\u001b[14Gclasses. The only template override is \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds \u001b[38;2;177;185;249mclass=\"form\"\u001b[39m to \u001b[99Ge form\r\u001b[4C\u001b[1Btag because a form d\u001b[26Gfi\u001b[29Gition can't\u001b[41Gset it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m \u001b[13G \u001b[15Gite\u001b[19Glayout and \u001b[31Gemplates under \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out\u001b[14Gof the mails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m i\u001b[26G now\u001b[31Ga\u001b[33Gdependency\u001b[44Gof\u001b[47Gthe\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mcomposer.js\u001b[17Gn\u001b[39m. The\u001b[24G\u001b[38;2;177;185;249mcomposer.lock\u001b[39m update also adds \u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m, which the \u001b[82Gitepackage already\u001b[K\r\u001b[4C\u001b[1Brequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m a new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m,\u001b[77Gruns\u001b[82Gafter\u001b[88G\u001b[38;2;177;185;249mseed-pages.php\u001b[39m.\u001b[104GIt\r\u001b[2C\u001b[1B \u001b[5Gswitches the p\u001b[20Gge to the \"Sidebar right\" layout, puts the form in the main area and moves the address,\r\u001b[4C\u001b[1Bopening hours \u001b[20Gnd\u001b[23G\"Report a problem\" into the sidebar. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m, and the diff contain\u001b[105G\u001b[K\r\u001b[5C\u001b[1Bnly those changes. The README explains all of this.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFresh-i\u001b[13Gstall check:\u001b[26G\u001b[22mthis\u001b[31Gneeds\u001b[37Gan\u001b[40Gempty\u001b[46Gdatabase,\u001b[56Gand\u001b[60Gthe\u001b[64Gsafety\u001b[71Gcheck\u001b[77Gblocked\u001b[85Gme\u001b[88Gfrom\u001b[93Gdropping\u001b[102Git.\r\u001b[2C\u001b[1B \u001b[5GYour installation is\u001b[26Guncha\u001b[32Gg\u001b[35G by that attempt. To\u001b[56Grun\u001b[60Git yourself, \u001b[74Gither follow \"Starting over\" and\r\u001b[4C\u001b[1B\"Fresh install\" in the root \u001b[38;2;177;185;249mREADME.md\u001b[39m,\u001b[44Gor tell me to go ahead and I'll do it bet\u001b[86Geen two database\u001b[103G\u001b[K\r\u001b[4C\u001b[1Bsnap\u001b[11Gots and restore yours\u001b[33Gafterwards. A\u001b[47Gsnapshot from\u001b[61Gbefore my\u001b[71Gchanges\u001b[79Gexists as\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mbefore-contact-form\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVisual check:\u001b[22m I only\u001b[26Gchecked\u001b[34Gthe\u001b[38GHTML,\u001b[44Gnot\u001b[48Gthe\u001b[52Gpage\u001b[57Gin\u001b[60Ga\u001b[62Gbrowser.\u001b[71GPlease\u001b[78Glook\u001b[83Gat\u001b[86Gthe\u001b[90Gtwo-column\r\u001b[2C\u001b[1B \u001b[5Glayout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMail sender:\u001b[18G\u001b[22mthe\u001b[22Gmails\u001b[28Gcome\u001b[33Gfrom\u001b[38G\u001b[38;2;177;185;249mno\u001b[69G\u001b[39mive\u001b[73Gserver,\u001b[81Gthat\u001b[86Gdomain\u001b[93Ghas\u001b[97Gto\u001b[100Gallow\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[732.071017, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gname, email, phone, topic, message (at least 20 characters)\u001b[65Gand a consent checkbox. It's a file under\r\u001b[4C\u001b[1Bversion control, so\u001b[26Ghe back\u001b[34Gnd Forms module\u001b[50Gshows it but can't\u001b[69Gedit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStyling:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m replaces EXT:form's Bootstrap\u001b[87Gclasses\u001b[95Gwith\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's\u001b[14Gclasses. The only template override is \u001b[38;2;177;185;249mForm.fluid.html\u001b[39m, which adds \u001b[38;2;177;185;249mclass=\"form\"\u001b[39m to \u001b[99Ge form\r\u001b[4C\u001b[1Btag because a form d\u001b[26Gfi\u001b[29Gition can't\u001b[41Gset it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMails:\u001b[22m \u001b[13G \u001b[15Gite\u001b[19Glayout and \u001b[31Gemplates under \u001b[38;2;177;185;249mResources/Private/Extensions/Form/\u001b[39m.\u001b[82GThe\u001b[86Gconsent\u001b[94Gcheckbox\u001b[103Gis\r\u001b[2C\u001b[1B \u001b[5Gleft out\u001b[14Gof the mails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWiring:\u001b[22m \u001b[38;2;177;185;249mtypo3/form\u001b[39m i\u001b[26G now\u001b[31Ga\u001b[33Gdependency\u001b[44Gof\u001b[47Gthe\u001b[51Gsite\u001b[56Gset,\u001b[61Gand\u001b[65G\u001b[38;2;177;185;249mtypo3/cms-form\u001b[80G\u001b[39mis\u001b[83Gin\u001b[86Gthe\u001b[90Gsitepackage's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mcomposer.js\u001b[17Gn\u001b[39m. The\u001b[24G\u001b[38;2;177;185;249mcomposer.lock\u001b[39m update also adds \u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m, which the \u001b[82Gitepackage already\u001b[K\r\u001b[4C\u001b[1Brequired but the lock had missed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContact page:\u001b[22m a new script, \u001b[38;2;177;185;249mBuild/Initialisation/seed-contact-form.php\u001b[39m,\u001b[77Gruns\u001b[82Gafter