[1207.918906, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│           Case           │                                 Result                                  │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Correctly solved puzzle  │ Sent, exactly 1 mail                                                    │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ No solution              │ Rejected: \"Please tick \"I'm not a robot\" and wait until it is checked.\" │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Same solution sent again │ Rejected, since each puzzle counts once                                 │\r\u001b[2C\u001b[1B├──────────────────────────┼─────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Fake solution            │ Rejected                                                                │\r\u001b[2C\u001b[1B└──────────────────────────┴─────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe form stil\u001b[17G works on\u001b[27Gcach\u001b[32Gd pages, because each visitor ge\u001b[65Gs a fresh\u001b[75Gpuzzle\u001b[82Gfrom an\u001b[90Guncached\u001b[K\r\u001b[2C\u001b[1Bend\u001b[7Goint\u001b[13GI\u001b[15Galso\u001b[20Gtook\u001b[25Ga\u001b[27Gscreenshot\u001b[38Gwith\u001b[43Gheadless\u001b[52GChrome:\u001b[60Gthe\u001b[64Gtwo-column\u001b[75Glayout\u001b[82Gand\u001b[86Gthe\u001b[90Gwidget\u001b[97Grender\r\u001b[2C\u001b[1Bproperly.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mComposer:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mbbysaeth/typo3-altcha ^2.0\u001b[42G\u001b[39mis\u001b[45Gin\u001b[48Gthe\u001b[52Gproject's\u001b[62Gand\u001b[66Gthe\u001b[70Gsitepackage's\u001b[84G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[99Gand\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glock file\u001b[15Gis updated.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSite set:\u001b[22m \u001b[38;2;177;185;249mbbysaeth/typo3-altcha\u001b[39m is now a d\u001b[48Gpendency.\u001b[K\r\u001b[8C\u001b[1B\u001b[1m:\u001b[22m \u001b[38;2;177;185;249mcontact.form.y\u001b[26Gml\u001b[39m has an ALTCHA element above the button, with friendlier error\u001b[91Gtexts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm setup:\u001b[17G\u001b[22m\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[60G\u001b[39mgives\u001b[66Gthe\u001b[70Gelement\u001b[78Gthe\u001b[82Gdesign's\u001b[91G\u001b[38;2;177;185;249mform-field\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gclass.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mconfig/system/settings.php\u001b[39m:\u001b[22m the extensio\u001b[46G adde\u001b[53Gan empty \u001b[38;2;177;185;249mhmac\u001b[39m setting. Empty \u001b[83Geans\u001b[88Git\u001b[91Gsigns\u001b[97Gpuzzles\r\u001b[2C\u001b[1B \u001b[5Gwith TYPO3's encryption key,\u001b[34Gwhich is\u001b[43Gf\u001b[45Gne, and th\u001b[56G change\u001b[64Gbelongs\u001b[72Gin\u001b[75Gthe\u001b[79Gcommit.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gsection\u001b[23Gon\u001b[26GALTCHA.\u001b[34G\u001b[38;2;177;185;249mdata.x\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
