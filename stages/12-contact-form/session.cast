[872.760152, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bhow often the form can\u001b[26Gbe\u001b[29Gsent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's already fine:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTamper\u001b[14Gsubmissions:\u001b[22m EXT:form signs the form's hidden state and the li\u001b[77Gt\u001b[79Gof allow\u001b[88Gd field\u001b[96G,\u001b[98Gso\u001b[101Ga\u001b[K\r\u001b[4C\u001b[1Bmodified submission is rej\u001b[32Gcted.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mInjected \u001b[15Garkup:\u001b[22m the mail t\u001b[33Gmplates esc\u001b[45Gpe everything the visitor enters\u001b[79GAll addresses pass an email\r\u001b[4C\u001b[1Bcheck before they r\u001b[25Gach the mailer.\r\u001b[4C\u001b[1B\u001b[1mLength limits:\u001b[20G\u001b[22mnam\u001b[24G is capped at 200 characters\u001b[53Gand\u001b[57Gthe\u001b[61Gmessage\u001b[69Gat\u001b[72G5,000.\u001b[79GThere's\u001b[87Gno\u001b[90Gfile\u001b[95Gupload,\u001b[103Gso\r\u001b[2C\u001b[1B \u001b[5Gnothing lands on\u001b[26Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpam bots:\u001b[22m the honeypot\u001b[29Gcatches\u001b[37Gsimple\u001b[44Gones.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCookies:\u001b[14G\u001b[22mloading\u001b[22Gthe\u001b[26Gpage\u001b[31Gsets\u001b[36Gnone,\u001b[42Gso\u001b[45Gthe\u001b[49Gform\u001b[54Gneeds\u001b[60Gno\u001b[63Gcookie\u001b[70Gbanner.\u001b[78GIn\u001b[81GTYPO3\u001b[87G14.3\u001b[92Gthe\u001b[96Ghoneypot\u001b[105Gno\r\u001b[2C\u001b[1B  longer uses\u001b[17Ga\u001b[19Gsession.\r\u001b[2C\u001b[2B\u001b[1mData privacy\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat's good: the\u001b[20Gform\u001b[25Gcollects\u001b[34Gonly\u001b[39Gwhat's\u001b[46Gneeded,\u001b[54Gand\u001b[58Gthe\u001b[62Gphone\u001b[68Gnumber\u001b[75Gis\u001b[78Goptional.\u001b[88GNothing\u001b[96Gis\u001b[99Gstored\r\u001b[2C\u001b[1Bin\u001b[6GTYPO3's\u001b[14Gdatabase.\u001b[24GThe\u001b[28Ghint\u001b[33Gtext\u001b[38Gasks\u001b[43Gpe