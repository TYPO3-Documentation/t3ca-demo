[93.880602, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m3. Your own plugin\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m Your own controller,\u001b[36Gform\u001b[41Gobject,\u001b[49Gvalidation\u001b[60Gand\u001b[64Gmail\u001b[69Gcode\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m Full cont\u001b[19Gol\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Yo\u001b[11G have \u001b[18Go write\u001b[26Gvalidation,\u001b[38Gspam\u001b[43Gprotection,\u001b[55Gmail\u001b[60Gand\u001b[64Gerror\u001b[70Ghandling\u001b[79Gyourself.\u001b[89GOnly\u001b[94Gworth\u001b[100Git\r\u001b[2C\u001b[1B  for unusual\u001b[17Gl\u001b[19Ggic, such as writing into your ow\u001b[53G tables or\u001b[64Gcalling an API.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption:\u001b[22m \u001b[1m4. External service\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it is:\u001b[22m An embedded form\u001b[32Gfrom\u001b[37Ga\u001b[39Ghosted\u001b[46Gprovider\r\u001b[2C\u001b[1B\u001b[1mGood:\u001b[22m No code to writ\u001b[25G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBad:\u001b[22m Visit\u001b[14Gr data goes\u001b[26Gto\u001b[29Ga\u001b[31Gthird\u001b[37Gparty\u001b[43G(a\u001b[46GGDPR\u001b[51Gproblem),\u001b[61Git\u001b[64Glooks\u001b[70Gdifferent\u001b[80Gfrom\u001b[85Gyour\u001b[90Gsite,\u001b[96Gand\u001b[100Git\r\u001b[2C\u001b[1B  doesn't fit \u001b[18G self-contained demo.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation: EXT:form, with the form shipped in the sitepackage\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mTurn it on:\u001b[18G\u001b[22madd\u001b[22G\u001b[38;2;177;185;249mtypo3/form\u001b[33G\u001b[39mto\u001b[36Gthe\u001b[40Gdependencies\u001b[53Gin\u001b[56G\u001b[38;2;177;185;249mConfiguration/Sets/Sitepackage/config.yaml\u001b[39m,\u001b[100Gnext\u001b[105Gto\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mfluid-styled-con\u001b[23Gent\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[33G\u001b[39mand \u001b[38;2;177;185;249mke_search\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDefine the form in the sitepackage:\u001b[22m put it\u001b[49Gin\u001b[52Ga\u001b[54Gfile\u001b[59Glike\u001b[64G\u001b[38;2;177;185;249mResources/Private/Forms/contact.form.yaml\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gwith name, email, subject, message and a pr\u001b[50Gvacy ch\u001b[58Gckbox. Register that folder as a form storage\u001b[K\r\u001b[5C\u001b[1Blocation in a small form setup YAML. The\u001b[47Gform is\u001b[55Gt\u001b[58Gn under ver\u001b[70Gion\u001b[74Gcon\u001b[78Grol and\u001b[86Gworks \u001b[93Gn a fresh\u001b[K\r\u001b[5C\u001b[1Binstall,\u001b[15Glike\u001b[20Gyour earlier stages.\u001b[K\r\u001b[5C\u001b[1B- One catch: b\u001b[21G default, forms stored\u001b[44Gin\u001b[47Gan\u001b[50Gextension\u001b[60Gare\u001b[64Gread-only\u001b[74Gin\u001b[77Gthe\u001b[81Gbackend\u001b[89Gform\u001b[94Geditor.\r\u001b[5C\u001b[1B \u001b[8GThat's fine for a demo\u001b[31Gdistribution. If editors should be \u001b[67Gble to\u001b[74Gchang\u001b[81Gthe form, you can allow\r\u001b[7C\u001b[1Bsaving\u001b[15Gto the extensi\u001b[30Gn pa\u001b[35Gh or keep\u001b[45Gthe form in fileadmin.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mWhat happens after sending:\u001b[22m one email to the site owner, an optional\u001b[75Gcopy\u001b[80Gto\u001b[83Gthe\u001b[87Gsender,\u001b[95Gthen\u001b[100Ga\r\u001b[2C\u001b[1B  \u001b[6Gthank-you message or a redirect\u001b[38Gto\u001b[69Gcipient address in a site\u001b[95Gsetting\u001b[103Gso\u001b[31;1H\u001b[29;3H\u001b[?25h"]
