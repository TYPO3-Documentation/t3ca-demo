te/contact\u001b]8;;\u0007\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong input:\u001b[18G\u001b[22meach\u001b[23Gbad\u001b[27Gfield\u001b[33Gshows\u001b[39Gits\u001b[43Gown\u001b[47Gmessage\u001b[55Gunder\u001b[61Git\u001b[64Gand\u001b[68Gthe\u001b[72Gfield\u001b[78Gis\u001b[81Gmarked\u001b[88Gred\u001b[92Gwith\u001b[97Gthe\r\u001b[2C\u001b[1B  design's styles.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSpam:\u001b[22m a submission that fill\u001b[34G the\u001b[39Ghidden honeypot\u001b[55Gfield\u001b[62Gs\u001b[64Greject\u001b[71Gd and no mail is\u001b[88Gs\u001b[90Gnt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mValid message:\u001b[22m the\u001b[24Gvisitor\u001b[32Gsees\u001b[37Gthe\u001b[41Ggreen\u001b[47G\"Asante!\u001b[56GYour\u001b[61Gmessage\u001b[69Ghas\u001b[73Gbeen\u001b[78Gsent.\"\u001b[85Gbox.\u001b[90GIn\u001b[93GMailpit,\u001b[102Gone\r\u001b[2C\u001b[1B \u001b[5Gmail went to \u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39G\u001b[39mw\u001b[41Gth the visitor as reply-to, an\u001b[74G copy\u001b[80Gwent\u001b[85Gto\u001b[88Gthe visitor.\u001b[101GBoth\r\u001b[2C\u001b[1B \u001b[5Guse a Mto Safi\u001b[20Gmail layout\u001b[32Ginstead of the\u001b[47GTYPO3-branded\u001b[61Gsy\u001b[64Gtem mail.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mForm definition:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mResources/Private/\u001b[70G\u001b[39mthe\u001b[74Gfields\u001b[81Gfrom\u001b[86G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m:\u001b[31;1H\u001b[29;3H\u001b[?25h"]
