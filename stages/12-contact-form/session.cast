th\u001b[21G mails come\u001b[33Gfrom\u001b[38G\u001b[38;2;177;185;249mnoreply@mtosafi.example\u001b[39m.\u001b[63GOn\u001b[66Ga\u001b[68Glive\u001b[73Gserver,\u001b[81Gthat\u001b[86Gdomain\u001b[93Ghas\u001b[97Gto\u001b[100Gallow\r\u001b[2C\u001b[1B \u001b[5Gthe server to send\u001b[24Gmail for it. \u001b[38G  \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
