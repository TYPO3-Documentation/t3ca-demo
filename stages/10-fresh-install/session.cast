[15271.295843, "o", "\u001b[2;8Hdoe\u001b[Cn't guess by page\u001b[Ctitle. TYPO3's impor\u001b[C keeps a\u001b[Cmap of old\u001b[Cpage\u001b[Cuids\u001b[Cto\u001b[Cnew\u001b[Cones,\u001b[Cand\u001b[Cthe\u001b[3;3H \u001b[Clistener uses that to correct the three\u001b[Cmenu/search settings and the 404 page link\u001b[3;89Hf \u001b[Cite \u001b[38;5;153mmain\u001b[39m.\u001b[4;3H-\u001b[CIt only acts in the setup run\u001b[4;37Hat actually impo\u001b[Cted \u001b[38;5;153mdata.xml\u001b[39m, and only if site \u001b[38;5;153mmain\u001b[39m's root page\u001b[Cis\u001b[5;3H \u001b[Cone of the impor\u001b[Ced\u001b[Cpages. It\u001b[Cworks whether\u001b[Cthe site\u001b[Cconfig came fr\u001b[Cm \u001b[38;5;153mInitialisatio\u001b[C/Site/main/\u001b[39m or was\u001b[6;5Halready in\u001b[C\u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wasn't \u001b[Cmported stays as it\u001b[Cis.\u001b[K\u001b[7;3H-\u001b[CYour live \u001b[38;5;153mdemo\u001b[39m install isn't affected, becau\u001b[Ce its import\u001b[Cis already recorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[8;3H \u001b[Cruns\u001b[Cthere. After a cache flush it still answ\u001b[Crs 200 on both\u001b[Cthe front\u001b[Cnd an\u001b[8;83Hthe backend.\u001b[K\u001b[9;5H\u001b[K\u001b[10;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[11;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[13;3H│   Setting   │ Before │          After          │\u001b[14;3H├─────────────┼────────┼─────────────────────────┤\u001b[15;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[16;3H├─────────────┼────────┼─────────────────────────┤\u001b[17;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[18;3H├─────────────┼────────┼─────────────────────────┤\u001b[19;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[20;3H├─────────────┼────────┼─────────────────────────┤\u001b[21;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[22;3H└─────────────┴────────┴─────────────────────────┘\u001b[23;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[25;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/sea\u001b[25;69H\u001b[39m. \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[25;95H404\u001b[Cwith\u001b[Cthe\u001b[28;3H"]
[15271.376705, "o", "\u001b[2d \u001b[Clistener uses that to correct the three\u001b[Cmenu/search settings and the 404 page link\u001b[2;89Hf \u001b[Cite \u001b[38;5;153mmain\u001b[39m.\u001b[3;3H-\u001b[CIt only acts in the setup run\u001b[3;37Hat actually impo\u001b[Cted \u001b[38;5;153mdata.xml\u001b[39m, and only if site \u001b[38;5;153mmain\u001b[39m's root page\u001b[Cis\u001b[4;3H \u001b[Cone of the impor\u001b[Ced\u001b[Cpages. It\u001b[Cworks whether\u001b[Cthe site\u001b[Cconfig came fr\u001b[Cm \u001b[38;5;153mInitialisatio\u001b[C/Site/main/\u001b[39m or was\u001b[5;5Halready in\u001b[C\u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wasn't \u001b[Cmported stays as it\u001b[Cis.\u001b[K\u001b[6;3H-\u001b[CYour live \u001b[38;5;153mdemo\u001b[39m install isn't affected, becau\u001b[Ce its import\u001b[Cis already recorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[7;3H \u001b[Cruns\u001b[Cthere. After a cache flush it still answ\u001b[Crs 200 on both\u001b[Cthe front\u001b[Cnd an\u001b[7;83Hthe backend.\u001b[K\u001b[8;5H\u001b[K\u001b[9;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[10;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[12;3H│   Setting   │ Before │          After          │\u001b[13;3H├─────────────┼────────┼─────────────────────────┤\u001b[14;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[15;3H├─────────────┼────────┼─────────────────────────┤\u001b[16;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[17;3H├─────────────┼────────┼─────────────────────────┤\u001b[18;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[19;3H├─────────────┼────────┼─────────────────────────┤\u001b[20;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;