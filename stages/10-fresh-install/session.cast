[15254.005815, "o", "\u001b[2d\u001b[K\n\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[4;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[6;3H│   Setting   │ Before │          After          │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[9;3H├─────────────┼────────┼─────────────────────────┤\u001b[10;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[11;3H├─────────────┼────────┼─────────────────────────┤\u001b[12;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[13;3H├─────────────┼────────┼─────────────────────────┤\u001b[14;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[15;3H└─────────────┴────────┴─────────────────────────┘\u001b[16;3H\u001b[K\nOn the\u001b[Cfront\u001b[Cn\u001b[C, th\u001b[C servic\u001b[C menu shows E-services portal\u001b[Cand Contact, and the foote\u001b[C show\u001b[17;95Hits\u001b[Cfour\u001b[C\u001b[K\u001b[18;3Hlinks. The hea\u001b[Cer search\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[19;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[20;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[22;3H-\u001b[CThe \"Page uids in the site s\u001b[Cttings\" sectio\u001b[C of \u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[23;3H \u001b[Cclaims the uids stay th\u001b[C same on an empty install, and it describes the listener.\u001b[K\u001b[24;3H-\u001b[CThe\u001b[Ccomment\u001b[Cabove\u001b[Cthe\u001b