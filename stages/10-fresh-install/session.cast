[14945.62647, "o", "\u001b[2d\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[4;3H│   Setting   │ Configured │ Fresh import │\u001b[5;3H├─────────────┼────────────┼──────────────┤\u001b[6;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[7;3H├─────────────┼────────────┼──────────────┤\u001b[8;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[9;3H├─────────────┼────────────┼──────────────┤\u001b[10;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[11;3H├─────────────┼────────────┼──────────────┤\u001b[12;3H│ 404 page    │ 33         │ 14           │\u001b[13;3H└─────────────┴────────────┴──────────────┘\u001b[14;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[16;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[17;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[18;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[19;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[21;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[22;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[24;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[25;3Htha\u001b[25;8Hwork\u001b[25;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[25;69H\u001b[38;5;153mngs.php\u001b[39m:\u001b[K\u001b[28;3H"]
[14945.642892, "o", "\u001b[2dThe\u001b[Cimport\u001b[Cgives\u001b[Cthe\u001b[Cpages\u001b[Cdifferent\u001b[Cuids:\u001b[3;3H\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[5;3H│   Setting   │ Configured │ Fresh import │\u001b[6;3H├─────────────┼────────────┼──────────────┤\u001b[7;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[8;3H├─────────────┼────────────┼──────────────┤\u001b[9;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[10;3H├─────────────┼────────────┼──────────────┤\u001b[11;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[12;3H├─────────────┼────────────┼──────────────┤\u001b[13;3H│ 404 page    │ 33         │ 14           │\u001b[14;3H└─────────────┴────────────┴──────────────┘\u001b[15;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[17;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[18;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[19;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[20;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[22;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[23;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[25;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextensio\u001b[25;69H\u001b[39mpty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[28;3H"]
[14945.658581, "o", "\u001b[2d\u001b[1mProblems found\u001b(B\u001b[m\u001b[K\u001b[4;3H\u001b[1m1. The page uids in the site configuration don't match a fresh import.\u001b[C\u001b(B\u001b[m\u001b[38;5;153mconfig/sites/main/settings.yaml\u001b[5;3H\u001b[39mand\u001b[C\u001b[38;5;153mconfig.yaml\u001b[C\u001b[39m(a\u001b[Cd the copies in\u001b[C\u001b[38;5;153mInitialisation/Site/main/\u001b[39m)\u001b[Cuse\u001b[Cthe\u001b[Cuids\u001b[Cfrom\u001b[Cyour\u001b[Cworking\u001b[Cdatabase.\u001b[6;3HThe import gives the pages different uids:\u001b[K\u001b[7;3H\u001b[K\n┌\u001b[8;17H┬\u001b[8;30H┬\u001b[8;45H┐\u001b[9;5H  Setting \u001b[9;19HConfigured\u001b[9;32HFresh\u001b[Cimport\u001b[11;7H\u001b[38;5;153mrviceMenu\u001b[11;19H\u001b[39m22\u001b[11;32H9 \u001b[13;5H\u001b[38;5;153mfooterMenu\u001b[13;19H\u001b[39m2\u001b[13;32H4 \u001b[14;3H├\u001b[14;17H┼\u001b[14;30H┼\u001b[14;45H┤\u001b[15;3H│\u001b[C\u001b[38;5;153msearchPage\u001b[15;17H\u001b[39m│\u001b[C16\u001b[15;30H│\u001b[C20\u001b[15;45H│\u001b[16;3H├─────────────┼────────────┼──────────────┤\u001b[17;3H│\u001b[C404\u001b[Cpage   \u001b[C│ 33      \u001b[C  │ 14   \u001b[C      \u001b[C│\u001b[18;3H└─────────────┴────────────┴──────────────┘\u001b[K\u001b[19;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[21;3H- The s\u001b[Crvice and footer menus are empty.\u001b[K\u001b[22;3H- The\u001b[Ch\u001b[Cader search sends you to\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[23;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[24;3H\u001b[K\nThe sitepackage R\u001b[CADME says these uid\u001b[25;69Hon th\u001b[25;76H starts em\u001b[Cty\"\u001b[25;94Hat is not\u001b[K\u001b[28;3H"]
[14945.674369, "o", "\u001b[2d   \u001b[38;5;153m/search\u001b[39m all\u001b[Creturned 200.\u001b[4;3H\u001b[1mProbl\u001b[Cms found\u001b(B\u001b[m\u001b[K\u001b[5;3H\u001b[K\n\u001b[1m1. The page uids in the site configuration don't match a fresh import.\u001b[C\u001b(B\u001b[m\u001b[38;5;153mconfig/sites/main/settings.yaml\u001b[7;3H\u001b[39mand\u001b[C\u001b[38;5;153mconfig.yaml\u001b[C\u001b[39m(and\u001b[Cthe\u001b[Ccopies\u001b[Cin\u001b[C\u001b[38;5;153mInitialisation/Site/main/\u001b[39m)\u001b[Cuse\u001b[Cthe\u001b[Cuids\u001b[Cfrom\u001b[Cyour\u001b[Cworking\u001b[Cdatabase.\u001b[8;3HThe import gives the pages different uids:\u001b[K\u001b[9;3H\u001b[K\n┌\u001b[10;17H┬\u001b[10;30H┬\u001b[10;45H┐\u001b[11;5H  Setting  \u001b[11;19HConfigured\u001b[11;32HFresh\u001b[Cimport\u001b[13;5H\u001b[38;5;153mserviceMenu\u001b[13;20H\u001b[39m2\u001b[13;32H9\u001b[15;5H\u001b[38;5;153mfooterMenu\u001b[15;19H\u001b[39m23\u001b[15;32H4 \u001b[17;5H\u001b[38;5;153msearchPage\u001b[17;19H\u001b[39m16\u001b[17;32H20\u001b[18;3H├\u001b[18;17H┼\u001b[18;30H┼\u001b[18;45H┤\u001b[19;3H│\u001b[C404\u001b[Cpage\u001b[19;17H│\u001b[C33\u001b[19;30H│\u001b[C14\u001b[19;45H│\u001b[20;3H└─────────────┴────────────┴──────────────┘\u001b[21;3H\u001b[K\nOn the fresh\u001b[22;17Hite:\u001b[K\u001b[23;5HThe service and footer menus \u001b[Cre empty.\u001b[C\u001b[K\u001b[24;3H-\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[25;3H- An unknown address shows \"Invalid e\u001b[25;69H3://p\u001b[Cge?uid=33\".\u001b[K\u001b[28;3H"]
[14945.717476, "o", "\u001b[2d4.\u001b[CThe frontend (with the site's\u001b[Caddress\u001b[Cset\u001b[Cto\u001b[Cthe\u001b[Cclone's\u001b[Chostname),\u001b[Cthe\u001b[Cbackend\u001b[Clogin\u001b[Cpage,\u001b[C\u001b[38;5;153m/news\u001b[C\u001b[39mand\u001b[3;6H\u001b[38;5;153m/search\u001b[C\u001b[39mall\u001b[Creturned 200.\u001b[4;3H\u001b[K\n\u001b[1mProblems found\u001b(B\u001b[m\u001b[6;3H\u001b[K\n\u001b[1m1. The page uids in the site configuration don't match a fresh import.\u001b(B\u001b[m \u001b[38;5;153mconfig/sites/main/settings.yaml\u001b[8;3H\u001b[39mand\u001b[C\u001b[38;5;153mconfig.yaml\u001b[39m (and\u001b[Cthe cop\u001b[Ces in \u001b[38;5;153mInitialisation/Site/main/\u001b[39m)\u001b[Cuse\u001b[Cthe\u001b[Cuids\u001b[Cfrom\u001b[Cyour\u001b[Cworking\u001b[Cdatabase.\u001b[9;3HThe\u001b[Cimport\u001b[Cgives\u001b[Cthe\u001b[Cpages\u001b[Cdifferent\u001b[Cuids:\u001b[10;3H\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[12;3H│   Setting   │ Configured │ Fresh import │\u001b[13;3H├─────────────┼────────────┼──────────────┤\u001b[14;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[15;3H├─────────────┼────────────┼──────────────┤\u001b[16;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[17;3H├─────────────┼────────────┼──────────────┤\u001b[18;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[19;3H├─────────────┼────────────┼──────────────┤\u001b[20;3H│ 404 page    │ 33         │ 14           │\u001b[21;3H└─────────────┴────────────┴──────────────┘\u001b[22;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[24;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[25;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/acc\u001b[39m\u001b[25;69H\u001b[K\u001b[28;3H"]
[14946.651252, "o", "\u001b[2d  \u001b[C\u001b[38;5;153m/search\u001b[39m all returned 200.\u001b[K\u001b[3;6H\u001b[K\u001b[4;3H\u001b[1mProblems found\u001b(B\u001b[m\u001b[5;3H\u001b[K\n\u001b[1m1. The page uids in the site configuration don't match a fresh import.\u001b[C\u001b(B\u001b[m\u001b[38;5;153mconfig/sites/main/settings.yaml\u001b[7;3H\u001b[39mand \u001b[38;5;153mconfig.yaml\u001b[39m (and the copies in \u001b[38;5;153mInitialisation/Site/main/\u001b[39m) use the uids from your working database.\u001b[8;3HThe\u001b[Cimport gives the\u001b[Cpages d\u001b[Cfferent uids:\u001b[K\u001b[9;3H\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[11;3H│   Setting   │ Configured │ Fresh import │\u001b[12;3H├─────────────┼────────────┼──────────────┤\u001b[13;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[14;3H├─────────────┼────────────┼──────────────┤\u001b[15;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[16;3H├─────────────┼────────────┼──────────────┤\u001b[17;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[18;3H├─────────────┼────────────┼──────────────┤\u001b[19;3H│ 404 page    │ 33         │ 14           │\u001b[20;3H└─────────────┴────────────┴──────────────┘\u001b[21;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[23;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[24;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[25;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid e\u001b[25;69H3://page?uid=33\".\u001b[28;3H"]
[14946.667475, "o", "\u001b[2;6H\u001b[K\u001b[3;3H\u001b[1mProblems found\u001b(B\u001b[m\u001b[4;3H\u001b[K\n\u001b[1m1. The page uids in the site configuration don't match a fresh import.\u001b[C\u001b(B\u001b[m\u001b[38;5;153mconfig/sites/main/settings.yaml\u001b[6;3H\u001b[39mand \u001b[38;5;153mconfig.yaml\u001b[39m (and the copies in \u001b[38;5;153mInitialisation/Site/main/\u001b[39m) use the uids from your working database.\u001b[7;3HThe\u001b[Cimport gives the\u001b[Cpages d\u001b[Cfferent uids:\u001b[K\u001b[8;3H\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[10;3H│   Setting   │ Configured │ Fresh import │\u001b[11;3H├─────────────┼────────────┼──────────────┤\u001b[12;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[13;3H├─────────────┼────────────┼──────────────┤\u001b[14;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[15;3H├─────────────┼────────────┼──────────────┤\u001b[16;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[17;3H├─────────────┼────────────┼──────────────┤\u001b[18;3H│ 404 page    │ 33         │ 14           │\u001b[19;3H└─────────────┴────────────┴──────────────┘\u001b[20;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[22;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[23;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[24;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[25;3H \u001b[C  \u001b[C       \u001b[C       \u001b[C     \u001b[C        \u001b[C \u001b[25;69H\u001b[K\u001b[28;3H"]
[14946.682554, "o", "\u001b[2d\u001b[1mProblems found\u001b(B\u001b[m\u001b[3;3H\u001b[K\n\u001b[1m1. The page uids in the site configuration don't match a fresh import.\u001b[C\u001b(B\u001b[m\u001b[38;5;153mconfig/sites/main/settings.yaml\u001b[5;3H\u001b[39mand \u001b[38;5;153mconfig.yaml\u001b[39m (and the copies in \u001b[38;5;153mInitialisation/Site/main/\u001b[39m) use the uids from your working database.\u001b[6;3HThe\u001b[Cimport gives the\u001b[Cpages d\u001b[Cfferent uids:\u001b[K\u001b[7;3H\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[9;3H│   Setting   │ Configured │ Fresh import │\u001b[10;3H├─────────────┼────────────┼──────────────┤\u001b[11;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[12;3H├─────────────┼────────────┼──────────────┤\u001b[13;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[14;3H├─────────────┼────────────┼──────────────┤\u001b[15;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[16;3H├─────────────┼────────────┼──────────────┤\u001b[17;3H│ 404 page    │ 33         │ 14           │\u001b[18;3H└─────────────┴────────────┴──────────────┘\u001b[19;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[21;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[22;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[23;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[24;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuid\u001b[25;69Hon\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[28;3H"]
[14946.69835, "o", "\u001b[2dThe import gives\u001b[Cthe\u001b[Cpages\u001b[Cdifferent\u001b[Cuids:\u001b[4;3H┌─────────────┬────────────┬──────────────┐\u001b[K\u001b[5;3H│  \u001b[CSetting   │\u001b[CCo\u001b[Cfigured │ Fresh\u001b[Cimport │\u001b[K\u001b[6;3H├─────────────┼────────────┼──────────────┤\u001b[7;3H│\u001b[C\u001b[38;5;153mserviceMenu\u001b[C\u001b[39m│\u001b[C22\u001b[7;30H│\u001b[C9\u001b[7;45H│\u001b[8;3H├\u001b[8;17H┼\u001b[8;30H┼\u001b[8;45H┤\u001b[9;5H\u001b[38;5;153mfooterMenu\u001b[9;19H\u001b[39m23        \u001b[9;32H4    \u001b[C      \u001b[11;7H\u001b[38;5;153marchPage\u001b[39m \u001b[11;19H16\u001b[11;32H20\u001b[13;5H404 page  \u001b[13;19H3\u001b[13;32H14\u001b[14;3H└\u001b[14;17H┴\u001b[14;30H┴\u001b[14;45H┘\u001b[15;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[17;3H-\u001b[CThe\u001b[Cservice\u001b[Cand footer\u001b[Cmenus are\u001b[Cempty.\u001b[C\u001b[K\u001b[18;3H- The header search sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[19;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[20;3H\u001b[K\nThe sit\u001b[Cpackage README says these uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[22;3Htrue,\u001b[Cb\u001b[Ccause the import assigns\u001b[Cnew uids.\u001b[K\u001b[23;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[25;3Hsitepackage READM\u001b[C points to \u001b[38;5;153mextensio\u001b[25;69H\u001b[39mpty d\u001b[25;76Habase (ste\u001b[C 2)\u001b[25;94He only route\u001b[28;3H"]
[14946.704647, "o", "\u001b[2d\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[4;3H│   Setting   │ Configured │ Fresh import │\u001b[5;3H├─────────────┼────────────┼──────────────┤\u001b[6;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[7;3H├─────────────┼────────────┼──────────────┤\u001b[8;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[9;3H├─────────────┼────────────┼──────────────┤\u001b[10;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[11;3H├─────────────┼────────────┼──────────────┤\u001b[12;3H│ 404 page    │ 33         │ 14           │\u001b[13;3H└─────────────┴────────────┴──────────────┘\u001b[14;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[16;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[17;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[18;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[19;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[21;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[22;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[24;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[25;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that\u001b[25;69H\u001b[38;5;153mngs.php\u001b[39m:\u001b[K\u001b[28;3H"]
[14946.720485, "o", "\u001b[2d│\u001b[2;7HSetting\u001b[2;17H│\u001b[CConfigured\u001b[C│\u001b[CFresh\u001b[Cimport\u001b[C│\u001b[3;3H├\u001b[3;17H┼\u001b[3;30H┼\u001b[3;45H┤\u001b[4;5H\u001b[38;5;153mserviceMenu\u001b[4;19H\u001b[39m22        \u001b[4;32H9    \u001b[C      \u001b[6;5H\u001b[38;5;153mfooterMenu\u001b[39m \u001b[6;20H3\u001b[6;32H4\u001b[8;5H\u001b[38;5;153msearchPage\u001b[8;19H\u001b[39m16\u001b[8;32H20\u001b[10;5H404 page  \u001b[10;19H33\u001b[10;32H14\u001b[11;3H└\u001b[11;17H┴\u001b[11;30H┴\u001b[11;45H┘\u001b[12;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[14;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[15;3H- The header\u001b[15;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[16;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[17;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[19;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[20;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[22;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[23;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[24;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[25;3H- i\u001b[25;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallTo\u001b[39m\u001b[25;69H\u001b[K\u001b[28;3H"]
[14946.996029, "o", "\u001b[2d├─────────────┼────────────┼──────────────┤\u001b[3;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[4;3H├─────────────┼────────────┼──────────────┤\u001b[5;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[6;3H├─────────────┼────────────┼──────────────┤\u001b[7;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[8;3H├─────────────┼────────────┼──────────────┤\u001b[9;3H│ 404 page    │ 33         │ 14           │\u001b[10;3H└─────────────┴────────────┴──────────────┘\u001b[11;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[13;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[14;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[15;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[16;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[18;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[19;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[21;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[22;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[23;3H- i\u001b[23;8Hdrop\u001b[23;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[24;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[25;3H \u001b[C  \u001b[C       \u001b[C              \u001b[C         \u001b[28;3H"]
[14947.011029, "o", "\u001b[3;5H\u001b[38;5;153mfooterMenu\u001b[39m \u001b[3;20H3\u001b[3;32H4\u001b[5;5H\u001b[38;5;153msearchPage\u001b[5;19H\u001b[39m16\u001b[5;32H20\u001b[7;5H404 page  \u001b[7;19H33\u001b[7;32H14\u001b[8;3H└\u001b[8;17H┴\u001b[8;30H┴\u001b[8;45H┘\u001b[9;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[11;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[12;3H- The header\u001b[12;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[13;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[14;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[16;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[17;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[19;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[20;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[21;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[22;3H- i\u001b[22;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[23;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[28;3H"]
[14947.025603, "o", "\u001b[2d│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[3;3H├─────────────┼────────────┼──────────────┤\u001b[4;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[5;3H├─────────────┼────────────┼──────────────┤\u001b[6;3H│ 404 page    │ 33         │ 14           │\u001b[7;3H└─────────────┴────────────┴──────────────┘\u001b[8;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[10;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[11;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[12;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[13;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[15;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[16;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[18;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[19;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[20;3H- i\u001b[20;8Hdrop\u001b[20;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[21;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[22;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[24;3H\u001b[K\n\u001b[1mSeed scripts\u001b[28;3H\u001b(B\u001b[m"]
[14947.041902, "o", "\u001b[2;5H404 page  \u001b[2;19H3\u001b[2;32H14\u001b[3;3H└\u001b[3;17H┴\u001b[3;30H┴\u001b[3;45H┘\u001b[4;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[6;3H-\u001b[CThe\u001b[Cservice\u001b[Cand footer\u001b[Cmenus are\u001b[Cempty.\u001b[C\u001b[K\u001b[7;3H- The header search sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[8;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[9;3H\u001b[K\nThe sit\u001b[Cpackage README says these uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[11;3Htrue,\u001b[Cb\u001b[Ccause the import assigns\u001b[Cnew uids.\u001b[K\u001b[12;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[14;3Hsitepackage READM\u001b[C points to \u001b[38;5;153mextension:setup\u001b[39m, w\u001b[Cich f\u001b[Cils on an empty d\u001b[14;76Habase (ste\u001b[C 2)\u001b[14;94He only route\u001b[15;4Hhat works is\u001b[C\u001b[38;5;153msetup --force\u001b[39m, a\u001b[Cd\u001b[Cthat rewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[16;3H-\u001b[Cit\u001b[Cdrops\u001b[Cthe\u001b[Cwhole\u001b[C\u001b[38;5;153mEXTENSIONS\u001b[C\u001b[39mblock\u001b[C(ke_search,\u001b[Cnews\u001b[Cand\u001b[Cbackend\u001b[Csettings),\u001b[17;3H- it changes \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[18;3H\u001b[K\nAfter that, the working tree\u001b[Cis dirty\u001b[Cand has to be rese\u001b[C with \u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[20;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[C\u001b[K\u001b[23;9Hemp\u001b[Cying eve\u001b[Cything b\u001b[Clow\u001b[Cthe root page, I\u001b[Cran th\u001b[C five scripts in the README's order:\u001b[K\u001b[24;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[25;3H  the site configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[25;69Hhe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[28;3H"]
[14947.049029, "o", "\u001b[2d\u001b[K\nOn the fresh site:\u001b[K\u001b[4;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[5;3H- The header\u001b[5;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[6;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[7;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[9;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[10;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[12;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[13;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[14;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[15;3H- i\u001b[15;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[16;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[19;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[21;3HAfter emptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[22;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[23;3H  \u001b[Che\u001b[Csite configu\u001b[Ca\u001b[Cio\u001b[C (49, 50, 43 and 60), so\u001b[Con that\u001b[Cinstall the me\u001b[Cus, search form and 404\u001b[Cpage\u001b[24;3H \u001b[Ca\u001b[24;9Hworked.\u001b[K\u001b[25;3H-\u001b[CRunning each one \u001b[Cgai\u001b[25;28Hstops with e\u001b[25;69H\u001b[K\u001b[28;3H"]
[14947.057128, "o", "\u001b[2d-\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[3;3H- An unknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[4;3H\u001b[K\nThe sit\u001b[Cpackag\u001b[C README says these uids \"are right on an installation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[6;3Htrue, because the import assigns new uids.\u001b[K\u001b[8;3H\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe top-\u001b[Cevel README\u001b[8;78Hays nothing about it.\u001b[CThe\u001b[9;3Hsit\u001b[Cpackage README poin\u001b[Cs to \u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[10;3Hthat\u001b[Cworks\u001b[Cis\u001b[C\u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand\u001b[Cthat\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[11;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csetting\u001b[C),\u001b[K\u001b[12;3H- it chan\u001b[12;14Hs \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153mins\u001b[CallT\u001b[ColPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[13;3H\u001b[K\nAfter that, the w\u001b[Crking tree is\u001b[Cdirty\u001b[Cand has to be reset with \u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[15;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[17;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[19;3H- All five exited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[20;5Hthe\u001b[Csite\u001b[Cconfiguration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[21;3H  all\u001b[Cworked.\u001b[K\u001b[22;5HRunning each one again stops with \u001b[Cxit 1\u001b[22;47Has intended.\u001b[C\u001b[K\u001b[23;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7\u001b[Ce\u001b[Ctries\u001b[23;49Hand searching for \"water\" give\u001b[C 3 results.\u001b[K\u001b[24;5H\u001b[K\u001b[25;3HA\u001b[Csecond \u001b[38;5;153msetup --force\u001b[39m on \u001b[Che filled \u001b[25;69Hns\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[28;3H"]
[14947.072368, "o", "\u001b[2dThe sit\u001b[Cpackag\u001b[C README says these uids \"are right on an installation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[3;3Htrue, because the import assigns new uids.\u001b[K\u001b[5;3H\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe top-\u001b[Cevel README\u001b[5;78Hays nothing about it.\u001b[CThe\u001b[6;3Hsit\u001b[Cpackage README poin\u001b[Cs to \u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[7;3Hthat\u001b[Cworks\u001b[Cis\u001b[C\u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand\u001b[Cthat\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[8;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csetting\u001b[C),\u001b[K\u001b[9;3H- it chan\u001b[9;14Hs \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153mins\u001b[CallT\u001b[ColPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[10;3H\u001b[K\nAfter that, the w\u001b[Crking tree is\u001b[Cdirty\u001b[Cand has to be reset with \u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[12;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[14;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[16;3H- All five exited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[17;5Hthe\u001b[Csite\u001b[Cconfiguration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[18;3H  all\u001b[Cworked.\u001b[K\u001b[19;5HRunning each one again stops with \u001b[Cxit 1\u001b[19;47Has intended.\u001b[C\u001b[K\u001b[20;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7\u001b[Ce\u001b[Ctries\u001b[20;49Hand searching for \"water\" give\u001b[C 3 results.\u001b[K\u001b[21;5H\u001b[K\u001b[22;3HA\u001b[Csecond \u001b[38;5;153msetup --force\u001b[39m on \u001b[Che filled da\u001b[Cabase refuses with\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[23;3Hcan't simply be run twice.\u001b[C\u001b[K\u001b[25;3H\u001b[1mSuggested fixes (I haven't changed an\u001b(B\u001b[m\u001b[25;69H\u001b[K\u001b[28;3H"]
[14947.088433, "o", "\u001b[2d\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe top-\u001b[Cevel README\u001b[2;78Hays nothing about it.\u001b[CThe\u001b[3;3Hsit\u001b[Cpackage README poin\u001b[Cs to \u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[4;3Hthat\u001b[Cworks\u001b[Cis\u001b[C\u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand\u001b[Cthat\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[5;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csetting\u001b[C),\u001b[K\u001b[6;3H- it chan\u001b[6;14Hs \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153mins\u001b[CallT\u001b[ColPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[7;3H\u001b[K\nAfter that, the w\u001b[Crking tree is\u001b[Cdirty\u001b[Cand has to be reset with \u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[9;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[11;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[13;3H- All five exited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[14;5Hthe\u001b[Csite\u001b[Cconfiguration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[15;3H  all\u001b[Cworked.\u001b[K\u001b[16;5HRunning each one again stops with \u001b[Cxit 1\u001b[16;47Has intended.\u001b[C\u001b[K\u001b[17;3H-