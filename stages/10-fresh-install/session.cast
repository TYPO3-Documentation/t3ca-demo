[14940.299521, "o", "\u001b[1;38r\u001b[38S\u001b[2;3HThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[Ctrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[3;3Huids.\u001b[5;3H\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[Csitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[6;3H\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[Cthat\u001b[Cworks\u001b[Cis\u001b[C\u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand\u001b[Cthat\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[7;3H\u001b[38;5;153msettings.php\u001b[39m:\u001b[8;3H-\u001b[Cit\u001b[Cdrops\u001b[Cthe\u001b[Cwhole\u001b[C\u001b[38;5;153mEXTENSIONS\u001b[C\u001b[39mblock\u001b[C(ke_search,\u001b[Cnews\u001b[Cand\u001b[Cbackend\u001b[Csettings),\u001b[9;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[11;3HAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[13;3H\u001b[1mSeed scripts\u001b[15;3H\u001b(B\u001b[mAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[16;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[Cconfiguration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[17;5Hand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[Call\u001b[Cworked.\u001b[18;3H-\u001b[CRunning\u001b[Ceach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[19;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[21;3HA\u001b[Csecond\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mon\u001b[Cthe\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[Ccan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[23;3H\u001b[1mSuggested fixes (I haven't changed anything)\u001b[25;3H\u001b(B\u001b[m-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter\u001b[Cthe\u001b[Cimport,\u001b[Clook\u001b[Cthe\u001b[Cpages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[Cconfiguration.\u001b[CThis\u001b[Cwould\u001b[Cwork\u001b[Clike\u001b[Cthe\u001b[26;5Hexisting\u001b[C\u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[CAlternatively,\u001b[Caccept\u001b[Cthe\u001b[Cproblem\u001b[Cand\u001b[Cdocument\u001b[Csetting\u001b[Cthe\u001b[Cuids\u001b[Cby\u001b[Chand.\u001b[27;3H-\u001b[C\u001b[1mFor problem 2:\u001b[C\u001b(B\u001b[madd\u001b[Ca\u001b[Cshort\u001b[C\"Fresh\u001b[Cinstall\"\u001b[Csection\u001b[Cto\u001b[Cthe\u001b[CREADME:\u001b[C\u001b[38;5;153mddev start\u001b[39m,\u001b[C\u001b[38;5;153mddev composer install\u001b[39m,\u001b[C\u001b[38;5;153mddev restart\u001b[39m,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[28;5H\u001b[39mwith\u001b[Cthe\u001b[Cenvironment\u001b[Cvariables,\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m,\u001b[Cthen\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m.\u001b[COptionally\u001b[Cwrap\u001b[Cit\u001b[Cin\u001b[Ca\u001b[CDDEV\u001b[29;5Hcommand.\u001b[31;3HThe\u001b[C\u001b[38;5;153mdemo-fresh\u001b[C\u001b[39mproject\u001b[Cis\u001b[Cstill\u001b[Crunning.\u001b[CShould\u001b[CI\u001b[Cremove\u001b[Cit\u001b[Cwith\u001b[C\u001b[38;5;153mddev delete -Oy demo-fresh\u001b[39m,\u001b[Cor\u001b[Cdo\u001b[Cyou\u001b[Cwant\u001b[Cto\u001b[Clook\u001b[Cat\u001b[Cit\u001b[Cfirst?\u001b[33;1H\u001b[38;5;246m✻\u001b[CChurned for 3m 7s · done 1:30 PM\u001b[34;103Hnew task? \u001b(B\u001b[m\u001b[38;5;153m/clear\u001b(B\u001b[m\u001b[38;5;246m to save \u001b(B\u001b[m\u001b[38;5;153m112.4k tokens\r\n\u001b(B\u001b[m\u001b[38;5;244m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[1;39r\u001b[35;115H\u001b[?25l\u001b(B\u001b[m\u001b[38;5;244m────────────────────────────\u001b[36;1H\u001b[39m❯ \u001b[2mfix the uids with a listener like the editor group\r\n\u001b(B\u001b[m\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
