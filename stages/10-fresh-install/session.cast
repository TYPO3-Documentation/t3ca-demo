[14947.403401, "o", "\u001b[2dsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[3;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[4;3H- i\u001b[4;8Hdrop\u001b[4;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[5;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[6;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[8;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[10;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[12;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[13;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[13;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[14;5Hall\u001b[Cworked.\u001b[K\u001b[15;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[16;5H\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7 en\u001b[Cries, and searching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[17;3H\u001b[K\nA\u001b[Csecond\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mon\u001b[Cthe\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[19;3Hcan't simply be run twice.\u001b[K\u001b[20;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[22;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter\u001b[Cthe\u001b[Cimport,\u001b[Clook\u001b[Cthe\u001b[Cpages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[24;3H \u001b[Cconfiguration.\u001b[CThis would work like the \u001b[Cxisting \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[K\u001b[25;5HAlternatively,\u001b[Caccept the\u001b[Cproblem a\u001b[25;69Hby hand.\u001b[K\u001b[28;3H"]
[14947.418141, "o", "\u001b[2d- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[3;3H- i\u001b[3;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[4;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[7;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[9;3HAfter emptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[10;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[11;3H  \u001b[Che\u001b[Csite configu\u001b[Ca\u001b[Cio\u001b[C (49, 50, 43 and 60), so\u001b[Con that\u001b[Cinstall the me\u001b[Cus, search form and 404\u001b[Cpage\u001b[12;3H \u001b[Ca\u001b[12;9Hworked.\u001b[K\u001b[13;3H-\u001b[CRunning each one \u001b[Cgai\u001b[13;28Hstops with exit 1, as intended.\u001b[C\u001b[K\u001b[14;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[15;3H\u001b[K\nA\u001b[Csecond \u001b[38;5;153msetup --forc\u001b[C\u001b[39m on the filled\u001b[Cda\u001b[Caba\u001b[Ce\u001b[Crefu\u001b[16;55Hs with \"c\u001b[Cntains already 57\u001b[Ctables\"\u001b[16;92HSo\u001b[Cthat\u001b[Cstep\u001b[17;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[18;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b[21;3H\u001b(B\u001b[m- \u001b[1mFor problem 1:\u001b(B\u001b[m after the import, look the pages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[22;5Hconfiguration.\u001b[CThis\u001b[Cwould\u001b[Cwork\u001b[Clike\u001b[Cthe\u001b[Cexisting\u001b[C\u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[23;3H \u001b[CAlternatively,\u001b[23;21Hcc\u001b[Cpt the pr\u001b[Cblem and\u001b[Cdocument setting the uids\u001b[Cby hand.\u001b[K\u001b[24;3H-\u001b[C\u001b[1mFor problem 2:\u001b[C\u001b(B\u001b[madd a short \"Fresh install\" \u001b[Cection to the README: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev comp\u001b[Cser install\u001b[39m,\u001b[25;5H\u001b[38;5;153mddev restart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -\u001b[25;69H\u001b[39mles, \u001b[38;5;153mgit checkout \u001b[28;3H\u001b(B\u001b[m"]
