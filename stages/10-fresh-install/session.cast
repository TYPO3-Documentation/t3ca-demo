[15272.43956, "o", "\u001b[2d \u001b[Cruns\u001b[Cthere. After a cache flush it still answ\u001b[Crs 200 on both\u001b[Cthe front\u001b[Cnd an\u001b[2;83Hthe backend.\u001b[K\u001b[3;5H\u001b[K\u001b[4;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[5;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[7;3H│   Setting   │ Before │          After          │\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[9;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[10;3H├─────────────┼────────┼─────────────────────────┤\u001b[11;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[12;3H├─────────────┼────────┼─────────────────────────┤\u001b[13;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[14;3H├─────────────┼────────┼─────────────────────────┤\u001b[15;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[16;3H└─────────────┴────────┴─────────────────────────┘\u001b[17;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[19;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[19;95H404\u001b[Cwith\u001b[Cthe\u001b[20;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[21;3H\u001b[K\n\u001b[1mAlso changed:\u001b[23;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[24;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[25;3H-\u001b[CThe comment above the s\u001b[Cttings writ\u001b[25;69H\u001b[38;5;153md-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[28;3H"]
[15272.469631, "o", "\u001b[2;5H\u001b[K\u001b[3;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[4;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[6;3H│   Setting   │ Before │          After          │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[9;3H├─────────────┼────────┼─────────────────────────┤\u001b[10;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[11;3H├─────────────┼────────┼─────────────────────────┤\u001b[12;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[13;3H├─────────────┼────────┼─────────────────────────┤\u001b[14;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[15;3H└─────────────┴────────┴─────────────────────────┘\u001b[16;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[18;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[18;95H404\u001b[Cwith\u001b[Cthe\u001b[19;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[20;3H\u001b[K\n\u001b[1mAlso changed:\u001b[22;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[23;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[24;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[25;3H \u001b[C   \u001b[C       \u001b[C     \u001b[C   \u001b[C        \u001b[C    \u001b[25;69H\u001b[K\u001b[28;3H"]
[15272.537677, "o", "\u001b[2d\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[3;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[5;3H│   Setting   │ Before │          After          │\u001b[6;3H├─────────────┼────────┼─────────────────────────┤\u001b[7;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[9;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[10;3H├─────────────┼────────┼─────────────────────────┤\u001b[11;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[12;3H├─────────────┼────────┼─────────────────────────┤\u001b[13;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[14;3H└─────────────┴────────┴─────────────────────────┘\u001b[15;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[17;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[17;95H404\u001b[Cwith\u001b[Cthe\u001b[18;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[19;3H\u001b[K\n\u001b[1mAlso changed:\u001b[21;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[22;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[23;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[24;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[25;69Hmitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[28;3H\u001b(B\u001b[m"]
[15274.106979, "o", "\u001b[2d\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[4;3H│   Setting   │ Before │          After          │\u001b[5;3H├─────────────┼────────┼─────────────────────────┤\u001b[6;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[9;3H├─────────────┼────────┼─────────────────────────┤\u001b[10;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[11;3H├─────────────┼────────┼─────────────────────────┤\u001b[12;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[13;3H└─────────────┴────────┴─────────────────────────┘\u001b[14;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[16;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[16;95H404\u001b[Cwith\u001b[Cthe\u001b[17;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[18;3H\u001b[K\n\u001b[1mAlso changed:\u001b[20;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[21;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[22;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[23;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[Cthe\u001b[Clistener\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[25;3H\u001b[39ma\u001b[Cd\u001b[C\u001b[38;5;153msettings.yaml\u001b[39m to the new uids, so\u001b[25;69Hhows them as changed after setup.\u001b[K\u001b[28;3H"]
[15274.663697, "o", "\u001b[2d┌─────────────┬────────┬─────────────────────────┐\u001b[3;3H│   Setting   │ Before │          After          │\u001b[4;3H├─────────────┼────────┼─────────────────────────┤\u001b[5;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[6;3H├─────────────┼────────┼─────────────────────────┤\u001b[7;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[9;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[10;3H├─────────────┼────────┼─────────────────────────┤\u001b[11;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[12;3H└─────────────┴────────┴─────────────────────────┘\u001b[13;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[15;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[15;95H404\u001b[Cwith\u001b[Cthe\u001b[16;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[17;3H\u001b[K\n\u001b[1mAlso changed:\u001b[19;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[20;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[21;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[22;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[Cthe\u001b[Clistener\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[24;3H\u001b[39ma\u001b[Cd\u001b[C\u001b[38;5;153msettings.yaml\u001b[39m to the new uids, so a colleague's \u001b[Corking tree shows them as changed after setup.\u001b[K\u001b[25;3HThat's expected, but\u001b[25;27Hy sho\u001b[Cl\u001b[Cn't c\u001b[25;69H\u001b[K\u001b[28;3H"]
[15275.85243, "o", "\u001b[2d│   Setting   │ Before │          After          │\u001b[3;3H├─────────────┼────────┼─────────────────────────┤\u001b[4;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[5;3H├─────────────┼────────┼─────────────────────────┤\u001b[6;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[9;3H├─────────────┼────────┼─────────────────────────┤\u001b[10;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[11;3H└─────────────┴────────┴─────────────────────────┘\u001b[12;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[14;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[14;95H404\u001b[Cwith\u001b[Cthe\u001b[15;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[16;3H\u001b[K\n\u001b[1mAlso changed:\u001b[18;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[19;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[20;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[21;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[Cthe\u001b[Clistener\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[23;3H\u001b[39ma\u001b[Cd\u001b[C\u001b[38;5;153msettings.yaml\u001b[39m to the new uids, so a colleague's \u001b[Corking tree shows them as changed after setup.\u001b[K\u001b[24;3HThat's expected, but\u001b[24;27Hy sho\u001b[Cl\u001b[Cn't commit those changes back.\u001b[K\u001b[25;3H      \u001b[C         \u001b[C   \u001b[C    \u001b[C         \u001b[C \u001b[28;3H"]
[15275.934485, "o", "\u001b[2d├─────────────┼────────┼─────────────────────────┤\u001b[3;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[4;3H├─────────────┼────────┼─────────────────────────┤\u001b[5;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[6;3H├─────────────┼────────┼─────────────────────────┤\u001b[7;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[9;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[10;3H└─────────────┴────────┴─────────────────────────┘\u001b[11;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[13;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[13;95H404\u001b[Cwith\u001b[Cthe\u001b[14;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[15;3H\u001b[K\n\u001b[1mAlso changed:\u001b[17;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[18;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[19;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[20;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[Cthe\u001b[Clistener\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[22;3H\u001b[39ma\u001b[Cd\u001b[C\u001b[38;5;153msettings.yaml\u001b[39m to the new uids, so a colleague's \u001b[Corking tree shows them as changed after setup.\u001b[K\u001b[23;3HThat's expected, but\u001b[23;27Hy sho\u001b[Cl\u001b[Cn't commit those changes back.\u001b[K\u001b[24;3H\u001b[K\nThe\u001b[Cfresh-install\u001b[Csteps\u001b[C(the\u001b[C\u001b[38;5;153msetup --\u001b[25;69H\u001b[39mented,\u001b[Cand\u001b[C\u001b[38;5;153mdemo-fresh\u001b[C\u001b[39mis\u001b[Cstill\u001b[28;3H"]
[15276.364581, "o", "\u001b[2d│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[3;3H├─────────────┼────────┼─────────────────────────┤\u001b[4;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[5;3H├─────────────┼────────┼─────────────────────────┤\u001b[6;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[9;3H└─────────────┴────────┴─────────────────────────┘\u001b[10;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[12;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[12;95H404\u001b[Cwith\u001b[Cthe\u001b[13;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[14;3H\u001b[K\n\u001b[1mAlso changed:\u001b[16;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[17;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[18;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[19;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[Cthe\u001b[Clistener\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[21;3H\u001b[39ma\u001b[Cd\u001b[C\u00