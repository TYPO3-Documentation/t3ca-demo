[15272.383372, "o", "\u001b[2d-\u001b[CYour live \u001b[38;5;153mdemo\u001b[39m install isn't affected, becau\u001b[Ce its import\u001b[Cis already recorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[3;3H \u001b[Cruns\u001b[Cthere. After a cache flush it still answ\u001b[Crs 200 on both\u001b[Cthe front\u001b[Cnd an\u001b[3;83Hthe backend.\u001b[K\u001b[4;5H\u001b[K\u001b[5;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[6;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[8;3H│   Setting   │ Before │          After          │\u001b[9;3H├─────────────┼────────┼─────────────────────────┤\u001b[10;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[11;3H├─────────────┼────────┼─────────────────────────┤\u001b[12;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[13;3H├─────────────┼────────┼─────────────────────────┤\u001b[14;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[15;3H├─────────────┼────────┼─────────────────────────┤\u001b[16;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[17;3H└─────────────┴────────┴─────────────────────────┘\u001b[18;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[20;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[20;95H404\u001b[Cwith\u001b[Cthe\u001b[21;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[22;3H\u001b[K\n\u001b[1mAlso changed:\u001b[24;3H\u001b(B\u0