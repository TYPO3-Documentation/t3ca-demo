[14933.253095, "o", "\u001b[16;5Hconfiguration.\u001b[CThis\u001b[Cwould\u001b[Cwork\u001b[Clike\u001b[Cthe\u001b[Cexisting\u001b[C\u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\r\n    Alternatively, accept the problem and document setting the uids by hand.\u001b[K\u001b[18;3H- \u001b[1mFor problem 2:\u001b(B\u001b[m add a short \"Fresh install\"\u001b[Csection\u001b[Cto\u001b[Cthe\u001b[CREADME:\u001b[C\u001b[38;5;153mddev start\u001b[39m,\u001b[C\u001b[38;5;153mddev composer install\u001b[39m,\u001b[19;5H\u001b[38;5;153mddev restart\u001b[39m,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[C\u001b[39mwith\u001b[Cthe\u001b[Cenvironment\u001b[Cvariables,\u001b[C\u001b[38;5;153mgit checkout \u001b[20;3H\u001b[39m  \u001b[38;5;153mconfig/system/settings.php\u001b[39m, then \u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m.\u001b[COption\u001b[Clly wrap\u001b[Cit\u001b[Cin\u001b[Ca\u001b[CDDEV\u001b[Ccommand.\u001b[22;3HThe \u001b[38;5;153mdemo-fresh\u001b[C\u001b[39mproject\u001b[Cis\u001b[Cstill\u001b[Crunning.\u001b[CShould\u001b[CI\u001b[Cremove\u001b[Cit\u001b[Cwith\u001b[C\u001b[38;5;153mddev delete -Oy demo-fresh\u001b[39m,\u001b[Cor\u001b[Cdo\u001b[Cyou\u001b[23;3Hwant to look at it first?\u001b[K\u001b[24;5H\u001b[K\r\n\u001b[38;5;246m✻\u001b[CChurned for 3m 7s · done 1:30 PM\u001b[26;3H\u001b[39m                                \u001b[26;67H\u001b[38;5;246mnew task? \u001b(B\u001b[m\u001b[38;5;153m/clear\u001b(B\u001b[m\u001b[38;5;246m to save \u001b(B\u001b[m\u001b[38;5;153m112.4k tokens\u001b[28;3H\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[14935.561496, "o", "\u001b[1d\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[3;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[5;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[5;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[6;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[7;3H \u001b[Call work\u001b[Cd.\u001b[K\u001b[8;5HRunning each one again stops with exi\u001b[C 1, as intended.\u001b[K\u001b[9;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[10;3H\u001b[K\nA second \u001b[38;5;153msetup --force\u001b[39m on the\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[12;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[13;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[15;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter the import, look th\u001b[C pages up by title and write their uids into the site\u001b[17;5Hconfiguration.\u001b[CThis would\u001b[Cwork like the existing \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[18;3H \u001b[CAlternatively,\u001b[18;21Hccept the problem\u001b[Ca\u001b[Cd document setting the uids by hand.\u001b[K\u001b[19;3H-\u001b[C\u001b[1mFor problem 2:\u001b(B\u001b[m add a short \"Fresh install\" s\u001b[Cction to the\u001b[CREADME: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev composer install\u001b[39m,\u001b[20;5H\u001b[38;5;153mddev re\u001b[Ctart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with the environment variables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[C\u001b[K\u001b[21;5H\u001b[38;5;153mconfig/system/settings.php\u001b[39m,\u001b[Cthen\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m.\u001b[COptionally\u001b[Cwrap\u001b[Cit\u001b[Cin\u001b[Ca\u001b[CDDEV\u001b[Ccommand.\u001b[22;3H\u001b[K\nThe \u001b[38;5;153mdemo-fresh\u001b[39m project is\u001b[Cstill\u001b[Crunning.\u001b[CShould\u001b[CI\u001b[Cremove\u001b[Cit\u001b[Cwith\u001b[C\u001b[38;5;153mddev delete -Oy demo-fresh\u001b[39m,\u001b[Cor\u001b[Cdo\u001b[Cyou\u001b[24;3Hwant\u001b[Cto\u001b[Clook\u001b[Cat\u001b[Cit\u001b[Cfirst?\r\n\u001b[K\u001b[28;3H"]
[14935.573607, "o", "\u001b[H\u001b[38;5;231m\u001b[48;5;237m❯ try installing the project fresh, do the import scripts etc work?\u001b[39m                                       \u001b[25;40H\u001b[38;5;231m Jump to bottom (ctrl+End) ↓ \u001b[28;3H\u001b(B\u001b[m"]
[14935.605728, "o", "\u001b[2d\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[4;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[6;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[6;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[7;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[8;3H \u001b[Call work\u001b[Cd.\u001b[K\u001b[9;5HRunning each one again stops with exi\u001b[C 1, as intended.\u001b[K\u001b[10;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[11;3H\u001b[K\nA second \u001b[38;5;153msetup --force\u001b[39m on the\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[13;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[14;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[16;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter the import, look th\u001b[C pages up by title and write their uids into the site\u001b[18;5Hconfiguration.\u001b[CThis would\u001b[Cwork like the existing \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[19;3H \u001b[CAlternatively,\u001b[19;21Hccept the problem\u001b[Ca\u001b[Cd document setting the uids by hand.\u001b[K\u001b[20;3H-\u001b[C\u001b[1mFor problem 2:\u001b(B\u001b[m add a short \"Fresh install\" s\u001b[Cction to the\u001b[CREADME: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev composer install\u001b[39m,\u001b[21;5H\u001b[38;5;153mddev re\u001b[Ctart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with the environment variables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[C\u001b[K\u001b[22;5H\u001b[38;5;153mconfig/system/settings.php\u001b[39m,\u001b[Cthen\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m.\u001b[COptionally\u001b[Cwrap\u001b[Cit\u001b[Cin\u001b[Ca\u001b[CDDEV\u001b[Ccommand.\u001b[23;3H\u001b[K\nThe \u001b[38;5;153mdemo-fresh\u001b[39m project is\u001b[Cstill\u001b[Crunning.\u001b[CShould\u001b[CI\u001b[Cremove\u001b[Cit\u001b[Cwith\u001b[C\u001b[38;5;153mddev delete -Oy demo-fresh\u001b[39m,\u001b[Cor\u001b[Cdo\u001b[Cyou\u001b[25;3Hwant\u001b[Cto\u001b[Clook\u001b[Cat\u001b[Cit\u001b[Cfirst?\u001b[28;3H"]
[14935.927064, "o", "\u001b[2dAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[3;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[5;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[7;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[7;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[8;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[9;3H \u001b[Call work\u001b[Cd.\u001b[K\u001b[10;5HRunning each one again stops with exi\u001b[C 1, as intended.\u001b[K\u001b[11;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[12;3H\u001b[K\nA second \u001b[38;5;153msetup --force\u001b[39m on the\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[14;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[15;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[17;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter the import, look th\u001b[C pages up by title and write their uids into the site\u001b[19;5Hconfiguration.\u001b[CThis would\u001b[Cwork like the existing \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[20;3H \u001b[CAlternatively,\u001b[20;21Hccept the problem\u001b[Ca\u001b[Cd document setting the uids by hand.\u001b[K\u001b[21;3H-\u001b[C\u001b[1mFor problem 2:\u001b(B\u001b[m add a short \"Fresh install\" s\u001b[Cction to the\u001b[CREADME: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev composer install\u001b[39m,\u001b[22;5H\u001b[38;5;153mddev re\u001b[Ctart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with the environment variables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[C\u001b[K\u001b[23;5H\u001b[38;5;153mconfig/system/settings.php\u001b[39m,\u001b[Cthen\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m.\u001b[COptionally\u001b[Cwrap\u001b[Cit\u001b[Cin\u001b[Ca\u001b[CDDEV\u001b[Ccommand.\u001b[24;3H\u001b[K\nThe \u001b[38;5;153mdemo-fresh\u001b[39m project is\u001b[Cstill\u001b[Crunni\u001b[25;69H\u001b[38;5;153mdev delete -Oy demo-fresh\u001b[39m,\u001b[Cor\u001b[Cdo\u001b[Cyou\u001b[28;3H"]
[14935.983793, "o", "\u001b[2d\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[4;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[6;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[8;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[8;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[9;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[10;3H \u001b[Call work\u001b[Cd.\u001b[K\u001b[11;5HRunning each one again stops with exi\u001b[C 1, as intended.\u001b[K\u001b[12;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[13;3H\u001b[K\nA second \u001b[38;5;153msetup --force\u001b[39m on the\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[15;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[16;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[18;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter the import, look th\u001b[C pages up by title and write their uids into the site\u001b[20;5Hconfiguration.\u001b[CThis would\u001b[Cwork like the existing \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[21;3H \u001b[CAlternatively,\u001b[21;21Hccept the problem\u001b[Ca\u001b[Cd document setting the uids by hand.\u001b[K\u001b[22;3H-\u001b[C\u001b[1mFor problem 2:\u001b(B\u001b[m add a short \"Fresh install\" s\u001b[Cction to the\u001b[CREADME: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev composer install\u001b[39m,\u001b[23;5H\u001b[38;5;153mddev re\u001b[Ctart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with the environment variables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[C\u001b[K\u001b[24;5H\u001b[38;5;153mconfig/system/settings.php\u001b[39m,\u001b[Cthen\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m.\u001b[COptionally\u001b[Cwrap\u001b[Cit\u001b[Cin\u001b[Ca\u001b[CDDEV\u001b[Ccommand.\u001b[25;3H   \u001b[C          \u001b[C       \u001b[C  \u001b[C     \u001b[C     \u001b[25;69H\u001b[K\u001b[28;3H"]
[14936.029554, "o", "\u001b[2d-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[3;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[5;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[7;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[9;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[9;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[10;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[11;3H \u001b[Call work\u001b[Cd.\u001b[K\u001b[12;5HRunning each one again stops with exi\u001b[C 1, as intended.\u001b[K\u001b[13;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[14;3H\u001b[K\nA second \u001b[38;5;153msetup --force\u001b[39m on the\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[16;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[17;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[19;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter the import, look th\u001b[C pages up by title and write their uids into the site\u001b[21;5Hconfiguration.\u001b[CThis would\u001b[Cwork like the existing \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[22;3H \u001b[CAlternatively,\u001b[22;21Hccept the problem\u001b[Ca\u001b[Cd document setting the uids by hand.\u001b[K\u001b[23;3H-\u001b[C\u001b[1mFor problem 2:\u001b(B\u001b[m add a short \"Fresh install\" s\u001b[Cction to the\u001b[CREADME: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev composer install\u001b[39m,\u001b[24;5H\u001b[38;5;153mddev re\u001b[Ctart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with the environment variables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[C\u001b[K\u001b[25;5H\u001b[38;5;153mconfig/system/settings.php\u001b[39m,\u001b[Cthen\u001b[C\u001b[38;5;153mty\u001b[25;69H\u001b[39mnally\u001b[Cwrap\u001b[Cit\u001b[Cin\u001b[Ca\u001b[CDDEV\u001b[Ccommand.\u001b[28;3H"]
[14936.099976, "o", "\u001b[2;8Hdrops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csettings),\u001b[3;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[4;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[6;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[8;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[10;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[10;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[11;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[12;3H \u001b[Call work\u001b[Cd.\u001b[K\u001b[13;5HRunning each one again stops with exi\u001b[C 1, as intended.\u001b[K\u001b[14;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[15;3H\u001b[K\nA second \u001b[38;5;153msetup --force\u001b[39m on the\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[17;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[18;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[20;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter the import, look th\u001b[C pages up by title and write their uids into the site\u001b[22;5Hconfiguration.\u001b[CThis would\u001b[Cwork like the existing \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[23;3H \u001b[CAlternatively,\u001b[23;21Hccept the problem\u001b[Ca\u001b[Cd document setting the uids by hand.\u001b[K\u001b[24;3H-\u001b[C\u001b[1mFor problem 2:\u001b(B\u001b[m add a short \"Fresh install\" s\u001b[Cction to the\u001b[CREADME: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev composer install\u001b[39m,\u001b[25;5H\u001b[38;5;153mddev re\u001b[Ctart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -\u001b[25;69H\u001b[39mles, \u001b[38;5;153mgit checkout \u001b[39m\u001b[C\u001b[K\u001b[28;3H"]
[14936.690499, "o", "\u001b[2;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[3;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[5;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[7;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[9;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[10;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[10;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[11;5Hall\u001b[Cworked.\u001b[K\u001b[12;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[13;5H\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7 en\u001b[Cries, and searching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[14;3H\u001b[K\nA\u001b[Csecond\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mon\u001b[Cthe\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[16;3Hcan't simply be run twice.\u001b[K\u001b[17;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[19;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter\u001b[Cthe\u001b[Cimport,\u001b[Clook\u001b[Cthe\u001b[Cpages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[21;3H \u001b[Cconfiguration.\u001b[CThis would work like the \u001b[Cxisting \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[K\u001b[22;5HAlternatively,\u001b[Caccept the\u001b[Cproblem and document setting the uids by hand.\u001b[K\u001b[23;3H-\u001b[C\u001b[1mFor problem 2:\u001b[23;21H\u001b(B\u001b[mdd a short \"Fresh\u001b[Ci\u001b[Cstall\" section to the README: \u001b[38;5;153mddev start\u001b[39m,\u001b[C\u001b[38;5;153mddev composer install\u001b[39m,\u001b[24;3H \u001b[C\u001b[38;5;153mddev restart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with th\u001b[C environment\u001b[Cvariables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[K\u001b[25;5H\u001b[38;5;153mconfig/\u001b[Cystem/settings.php\u001b[39m, then \u001b[38;5;153mty\u001b[25;69H\u001b[39mnally wrap it in a\u001b[CDDEV\u001b[Ccommand.\u001b[28;3H"]
