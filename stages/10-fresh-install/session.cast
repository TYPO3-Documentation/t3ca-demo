[207.87383, "o", "\u001b[1d\u001b[1m1. The page uids in the site configuration don't match a fresh import.\u001b[C\u001b(B\u001b[m\u001b[38;5;153mconfig/sites/main/settings.yaml\r\n\u001b[39m \u001b[Cand \u001b[38;5;153mconfig.yaml\u001b[39m (\u001b[Cnd th\u001b[C copies in\u001b[C\u001b[38;5;153mInitiali\u001b[Cati\u001b[Cn/Site/ma\u001b[Cn/\u001b[39m) \u001b[Cse\u001b[Cthe\u001b[Cuids from your working database.\u001b[3;3HThe import gives the\u001b[Cpages\u001b[Cdifferent\u001b[Cuids:\u001b[5;3H┌─────────────┬────────────┬──────────────┐\u001b[6;3H│\u001b[6;7HSetting\u001b[6;17H│\u001b[CConfigured\u001b[C│\u001b[CFresh\u001b[Cimport\u001b[C│\r\n \u001b[C├─────────────┼────────────┼──────────────┤\u001b[C\u001b[K\u001b[8;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22        \u001b[C│ 9       \u001b[C    │\u001b[C\u001b[K\u001b[9;3H├─────────────┼────────────┼──────────────┤\u001b[10;3H│\u001b[C\u001b[38;5;153mfooterMenu\u001b[10;17H\u001b[39m│\u001b[C23\u001b[10;30H│\u001b[C4\u001b[10;45H│\u001b[11;3H├─────────────┼────────────┼──────────────┤\u001b[12;3H│\u001b[C\u001b[38;5;153msearchPage\u001b[12;17H\u001b[39m│\u001b[C16\u001b[12;30H│\u001b[C20\u001b[12;45H│\r\n \u001b[C├─────────────┼────────────┼──────────────┤\u001b[C\u001b[K\u001b[14;3H│\u001b[C404\u001b[Cpage\u001b[14;17H│\u001b[C33\u001b[14;30H│\u001b[C14\u001b[14;45H│\u001b[15;3H└─────────────┴────────────┴──────────────┘\u001b[17;1H \u001b[COn the fresh\u001b[Csite:\u001b[K\u001b[18;3H- The service and footer menus are\u001b[Cempty.\u001b[K\u001b[19;3H-\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\r\n \u001b[C- An unknown address \u001b[Chows \"Invalid error handler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\r\n\u001b[K\u001b[22;3HThe sitepackage README says these uids \"are right on\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[23;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\r\n\u001b[K\r\n  \u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The top-level README\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[28;3H"]
[208.012111, "o", "\u001b[1dand \u001b[38;5;153mconfig.yaml\u001b[39m (and the copies in \u001b[38;5;153mInitialisation/Site/main/\u001b[39m) use the uids from your working database.\u001b[2;3HThe\u001b[Cimport gives the\u001b[Cpages d\u001b[Cfferent uids:\u001b[K\u001b[3;3H\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[5;3H│   Setting   │ Configured │ Fresh import │\u001b[6;3H├─────────────┼────────────┼──────────────┤\u001b[7;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[8;3H├─────────────┼────────────┼──────────────┤\u001b[9;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[10;3H├─────────────┼────────────┼──────────────┤\u001b[11;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[12;3H├─────────────┼────────────┼──────────────┤\u001b[13;3H│ 404 page    │ 33         │ 14           │\u001b[14;3H└─────────────┴────────────┴──────────────┘\u001b[15;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[17;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[18;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[19;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[20;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[22;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[23;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[25;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[28;3H"]
[208.161933, "o", "\u001b[1d\u001b[K\n┌─────────────┬────────────┬──────────────┐\u001b[3;3H│\u001b[3;7HSetting\u001b[3;17H│\u001b[CConfigured\u001b[C│\u001b[CFresh\u001b[Cimport\u001b[C│\u001b[4;3H├\u001b[4;17H┼\u001b[4;30H┼\u001b[4;45H┤\u001b[5;5H\u001b[38;5;153mserviceMenu\u001b[5;19H\u001b[39m22        \u001b[5;32H9    \u001b[C      \u001b[7;5H\u001b[38;5;153mfooterMenu\u001b[39m \u001b[7;20H3\u001b[7;32H4\u001b[9;5H\u001b[38;5;153msearchPage\u001b[9;19H\u001b[39m16\u001b[9;32H20\u001b[11;5H404 page  \u001b[11;19H33\u001b[11;32H14\u001b[12;3H└\u001b[12;17H┴\u001b[12;30H┴\u001b[12;45H┘\u001b[13;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[15;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[16;3H- The header\u001b[16;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[17;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[18;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[20;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[21;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[23;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[24;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[25;3H-\u001b[K\u001b[28;3H"]
[208.461369, "o", "\u001b[1d┌─────────────┬────────────┬──────────────┐\u001b[2;3H│   Setting   │ Configured │ Fresh import │\u001b[3;3H├─────────────┼────────────┼──────────────┤\u001b[4;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[5;3H├─────────────┼────────────┼──────────────┤\u001b[6;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[7;3H├─────────────┼────────────┼──────────────┤\u001b[8;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[9;3H├─────────────┼────────────┼──────────────┤\u001b[10;3H│ 404 page    │ 33         │ 14           │\u001b[11;3H└─────────────┴────────────┴──────────────┘\u001b[12;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[14;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[15;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[16;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[17;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[19;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[20;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[22;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[23;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[24;3H- i\u001b[24;8Hdrop\u001b[24;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[28;3H"]
[208.711684, "o", "\u001b[1d│   Setting   │ Configured │ Fresh import │\u001b[2;3H├─────────────┼────────────┼──────────────┤\u001b[3;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[4;3H├─────────────┼────────────┼──────────────┤\u001b[5;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[6;3H├─────────────┼────────────┼──────────────┤\u001b[7;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[8;3H├─────────────┼────────────┼──────────────┤\u001b[9;3H│ 404 page    │ 33         │ 14           │\u001b[10;3H└─────────────┴────────────┴──────────────┘\u001b[11;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[13;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[14;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[15;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[16;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[18;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[19;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[21;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[22;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[23;3H- i\u001b[23;8Hdrop\u001b[23;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[24;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[25;3H\u001b[K\u001b[3B"]
[208.863555, "o", "\u001b[1;5H\u001b[38;5;153mserviceMenu\u001b[1;19H\u001b[39m22        \u001b[1;32H9    \u001b[C      \u001b[3;5H\u001b[38;5;153mfooterMenu\u001b[39m \u001b[3;20H3\u001b[3;32H4\u001b[5;5H\u001b[38;5;153msearchPage\u001b[5;19H\u001b[39m16\u001b[5;32H20\u001b[7;5H404 page  \u001b[7;19H33\u001b[7;32H14\u001b[8;3H└\u001b[8;17H┴\u001b[8;30H┴\u001b[8;45H┘\u001b[9;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[11;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[12;3H- The header\u001b[12;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[13;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[14;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[16;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[17;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[19;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[20;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[21;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[22;3H- i\u001b[22;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[23;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[28;3H"]
[209.015221, "o", "\u001b[1;5H\u001b[38;5;153mfooterMenu\u001b[39m \u001b[1;20H3\u001b[1;32H4\u001b[3;5H\u001b[38;5;153msearchPage\u001b[3;19H\u001b[39m16\u001b[3;32H20\u001b[5;5H404 page  \u001b[5;19H33\u001b[5;32H14\u001b[6;3H└\u001b[6;17H┴\u001b[6;30H┴\u001b[6;45H┘\u001b[7;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[9;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[10;3H- The header\u001b[10;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[11;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[12;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[14;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[15;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[17;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[18;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[19;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[20;3H- i\u001b[20;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[21;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[24;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[28;3H"]
[209.167325, "o", "\u001b[1;5H\u001b[38;5;153msearchPage\u001b[1;19H\u001b[39m16\u001b[1;32H20\u001b[3;5H404 page  \u001b[3;19H33\u001b[3;32H14\u001b[4;3H└\u001b[4;17H┴\u001b[4;30H┴\u001b[4;45H┘\u001b[5;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[7;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[8;3H- The header\u001b[8;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[9;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[10;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[12;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[13;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[15;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[16;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[17;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[18;3H- i\u001b[18;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[19;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[22;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[24;3HAfter emptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[25;3H-\u001b[28;3H"]
[209.46076, "o", "\u001b[25;5HAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[28;3H"]
[209.867337, "o", "\u001b[1d├─────────────┼────────────┼──────────────┤\u001b[2;3H│ 404 page    │ 33         │ 14           │\u001b[3;3H└─────────────┴────────────┴──────────────┘\u001b[4;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[6;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[7;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[8;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[9;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[11;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[12;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[14;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[15;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[16;3H- i\u001b[16;8Hdrop\u001b[16;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[17;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[18;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[20;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[22;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[24;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[25;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[25;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[28;3H"]
[209.974187, "o", "\u001b[1d└\u001b[1;17H┴\u001b[1;30H┴\u001b[1;45H┘\u001b[2;3H\u001b[K\nOn the fresh site:\u001b[K\u001b[4;3H-\u001b[CThe\u001b[Cservice\u001b[Cand\u001b[Cfooter\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[5;3H- The header\u001b[5;17Hearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[6;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[7;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[9;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[10;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[12;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[13;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[14;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[15;3H- i\u001b[15;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[16;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[19;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[21;3HAfter emptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[22;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[23;3H  \u001b[Che\u001b[Csite configu\u001b[Ca\u001b[Cio\u001b[C (49, 50, 43 and 60), so\u001b[Con that\u001b[Cinstall the me\u001b[Cus, search form and 404\u001b[Cpage\u001b[24;3H \u001b[Ca\u001b[24;9Hworked.\u001b[K\u001b[25;3H-\u001b[C\u001b[K\u001b[28;3H"]
[210.113861, "o", "\u001b[1d\u001b[K\nOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[3;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[4;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[5;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[6;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[8;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[9;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[11;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[12;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[13;3H- i\u001b[13;8Hdrop\u001b[13;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[14;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[15;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[17;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[19;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[21;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[22;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[22;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[23;5Hall\u001b[Cworked.\u001b[K\u001b[24;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[28;3H"]
[210.514444, "o", "\u001b[1dOn\u001b[Cthe\u001b[Cfresh\u001b[Csite:\u001b[2;3H- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[3;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[4;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[5;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[7;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[8;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[10;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[11;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[12;3H- i\u001b[12;8Hdrop\u001b[12;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[13;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[14;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[16;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[18;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[20;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[21;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[21;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[22;5Hall\u001b[Cworked.\u001b[K\u001b[23;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[24;5H\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7 en\u001b[Cries, and searching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[25;3H\u001b[K\u001b[3B"]
[210.815377, "o", "\u001b[1d- The se\u001b[Cvice and footer\u001b[Cmenus\u001b[Care\u001b[Cempty.\u001b[2;9Hh\u001b[Cader search sends yo\u001b[C to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[3;5HAn unknown\u001b[Cadd\u001b[Cess shows \"Invalid error handler configuration:\u001b[Ct3://page?uid=33\".\u001b[4;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[6;3Htrue, b\u001b[Cc\u001b[Cuse the import a\u001b[Csign\u001b[C new uids.\u001b[K\u001b[7;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[9;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[10;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[11;3H- i\u001b[11;8Hdrop\u001b[11;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[12;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[13;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[15;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[17;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[19;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[20;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[20;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[21;5Hall\u001b[Cworked.\u001b[K\u001b[22;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[23;5H\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7 en\u001b[Cries, and searching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[24;3H\u001b[K\nA\u001b[Csecond\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mon\u001b[Cthe\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[28;3H"]
[210.961784, "o", "\u001b[1;5HAn unknown address shows \"Inv\u001b[Clid error\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[2;3H\u001b[K\nThe sitepackage README says these uids \"are right\u001b[Con an ins\u001b[Callation th\u001b[Ct starts empty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[4;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[5;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[7;3Hsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[8;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[9;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[10;3H- i\u001b[10;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[11;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[14;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[16;3HAfter emptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[17;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[18;3H  \u001b[Che\u001b[Csite configu\u001b[Ca\u001b[Cio\u001b[C (49, 50, 43 and 60), so\u001b[Con that\u001b[Cinstall the me\u001b[Cus, search form and 404\u001b[Cpage\u001b[19;3H \u001b[Ca\u001b[19;9Hworked.\u001b[K\u001b[20;3H-\u001b[CRunning each one \u001b[Cgai\u001b[20;28Hstops with exit 1, as intended.\u001b[C\u001b[K\u001b[21;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[22;3H\u001b[K\nA\u001b[Csecond \u001b[38;5;153msetup --forc\u001b[C\u001b[39m on the filled\u001b[Cda\u001b[Caba\u001b[Ce\u001b[Crefu\u001b[23;55Hs with \"c\u001b[Cntains already 57\u001b[Ctables\"\u001b[23;92HSo\u001b[Cthat\u001b[Cstep\u001b[24;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[25;3H\u001b[K\u001b[3B"]
[211.117987, "o", "\u001b[1dtrue, because the import assigns new uids.\u001b[K\u001b[3;3H\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe top-\u001b[Cevel README\u001b[3;78Hays nothing about it.\u001b[CThe\u001b[4;3Hsit\u001b[Cpackage README poin\u001b[Cs to \u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[5;3Hthat\u001b[Cworks\u001b[Cis\u001b[C\u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand\u001b[Cthat\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[6;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csetting\u001b[C),\u001b[K\u001b[7;3H- it chan\u001b[7;14Hs \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153mins\u001b[CallT\u001b[ColPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[8;3H\u001b[K\nAfter that, the w\u001b[Crking tree is\u001b[Cdirty\u001b[Cand has to be reset with \u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[10;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[12;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[14;3H- All five exited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[15;5Hthe\u001b[Csite\u001b[Cconfiguration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[16;3H  all\u001b[Cworked.\u001b[K\u001b[17;5HRunning each one again stops with \u001b[Cxit 1\u001b[17;47Has intended.\u001b[C\u001b[K\u001b[18;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7\u001b[Ce\u001b[Ctries\u001b[18;49Hand searching for \"water\" give\u001b[C 3 results.\u001b[K\u001b[19;5H\u001b[K\u001b[20;3HA\u001b[Csecond \u001b[38;5;153msetup --force\u001b[39m on \u001b[Che filled da\u001b[Cabase refuses with\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[21;3Hcan't simply be run twice.\u001b[C\u001b[K\u001b[23;3H\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[K\u001b[24;3H\u001b[K\n-\u001b[28;3H"]
[211.221774, "o", "\u001b[25;5H\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter\u001b[Cthe\u001b[Cimport,\u001b[Clook\u001b[Cthe\u001b[Cpages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[28;3H"]
[211.618415, "o", "\u001b[1d\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b[C\u001b(B\u001b[mThe\u001b[Ctop-level\u001b[CREADME\u001b[Csays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[3;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, which fails \u001b[Cn an \u001b[Cmpty datab\u001b[Cse\u001b[C(s\u001b[Cep 2). The\u001b[Conly route\u001b[4;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[5;3H- i\u001b[5;8Hdrop\u001b[5;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[6;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[7;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[9;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[11;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[13;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[14;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[14;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[15;5Hall\u001b[Cworked.\u001b[K\u001b[16;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[17;5H\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7 en\u001b[Cries, and searching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[18;3H\u001b[K\nA\u001b[Csecond\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mon\u001b[Cthe\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[20;3Hcan't simply be run twice.\u001b[K\u001b[21;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[23;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter\u001b[Cthe\u001b[Cimport,\u001b[Clook\u001b[Cthe\u001b[Cpages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[25;3H \u001b[Cconfiguration.\u001b[CThis would work like the \u001b[Cxisting \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[K\u001b[28;3H"]
[211.912516, "o", "\u001b[1dsitepackage\u001b[CREADME\u001b[Cpoints\u001b[Cto\u001b[C\u001b[38;5;153mextension:setup\u001b[39m,\u001b[Cwhich\u001b[Cfails\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[2;3Hthat works is \u001b[38;5;153msetup --force\u001b[39m, and that rewrites the commit\u001b[Ced \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[3;3H- it drops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_searc\u001b[C, news and backend settings),\u001b[K\u001b[4;3H- i\u001b[4;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[5;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[8;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[10;3HAfter emptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[11;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[12;3H  \u001b[Che\u001b[Csite configu\u001b[Ca\u001b[Cio\u001b[C (49, 50, 43 and 60), so\u001b[Con that\u001b[Cinstall the me\u001b[Cus, search form and 404\u001b[Cpage\u001b[13;3H \u001b[Ca\u001b[13;9Hworked.\u001b[K\u001b[14;3H-\u001b[CRunning each one \u001b[Cgai\u001b[14;28Hstops with exit 1, as intended.\u001b[C\u001b[K\u001b[15;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[16;3H\u001b[K\nA\u001b[Csecond \u001b[38;5;153msetup --forc\u001b[C\u001b[39m on the filled\u001b[Cda\u001b[Caba\u001b[Ce\u001b[Crefu\u001b[17;55Hs with \"c\u001b[Cntains already 57\u001b[Ctables\"\u001b[17;92HSo\u001b[Cthat\u001b[Cstep\u001b[18;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[19;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b[22;3H\u001b(B\u001b[m- \u001b[1mFor problem 1:\u001b(B\u001b[m after the import, look the pages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[23;5Hconfiguration.\u001b[CThis\u001b[Cwould\u001b[Cwork\u001b[Clike\u001b[Cthe\u001b[Cexisting\u001b[C\u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[24;3H \u001b[CAlternatively,\u001b[24;21Hcc\u001b[Cpt the pr\u001b[Cblem and\u001b[Cdocument setting the uids\u001b[Cby hand.\u001b[K\u001b[25;3H-\u001b[C\u001b[K\u001b[28;3H"]
[212.2108, "o", "\u001b[25;5H\u001b[1mFor problem 2:\u001b[C\u001b(B\u001b[madd\u001b[Ca\u001b[Cshort\u001b[C\"Fresh\u001b[Cinstall\"\u001b[Csection\u001b[Cto\u001b[Cthe\u001b[CREADME:\u001b[C\u001b[38;5;153mddev start\u001b[39m,\u001b[C\u001b[38;5;153mddev composer install\u001b[39m,\u001b[28;3H"]
[212.615905, "o", "\u001b[1dthat works is \u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand that rewrites the committed\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[2;3H- i\u001b[2;8Hdrop\u001b[2;14Hthe whole \u001b[38;5;153mEXTENSIONS\u001b[39m block\u001b[C(ke_search, news and backend settings),\u001b[3;8Hchanges \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[4;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[6;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[8;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[10;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[11;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[11;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[12;5Hall\u001b[Cworked.\u001b[K\u001b[13;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[14;5H\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7 en\u001b[Cries, and searching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[15;3H\u001b[K\nA\u001b[Csecond\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mon\u001b[Cthe\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[17;3Hcan't simply be run twice.\u001b[K\u001b[18;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[20;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter\u001b[Cthe\u001b[Cimport,\u001b[Clook\u001b[Cthe\u001b[Cpages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[22;3H \u001b[Cconfiguration.\u001b[CThis would work like the \u001b[Cxisting \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[K\u001b[23;5HAlternatively,\u001b[Caccept the\u001b[Cproblem and document setting the uids by hand.\u001b[K\u001b[24;3H-\u001b[C\u001b[1mFor problem 2:\u001b[24;21H\u001b(B\u001b[mdd a short \"Fresh\u001b[Ci\u001b[Cstall\" section to the README: \u001b[38;5;153mddev start\u001b[39m,\u001b[C\u001b[38;5;153mddev composer install\u001b[39m,\u001b[25;3H \u001b[C\u001b[38;5;153mddev restart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with th\u001b[C environment\u001b[Cvariables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[K\u001b[28;3H"]
[212.76419, "o", "\u001b[1d- i\u001b[1;8Hchanges \u001b[38;5;153mencry\u001b[CtionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and \u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[2;3H\u001b[K\nAfter that, the working tree is dirty and has to be\u001b[Creset with\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[5;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[7;3HAfter emptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[8;3H-\u001b[CAll\u001b[Cfive\u001b[Cexited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[9;3H  \u001b[Che\u001b[Csite configu\u001b[Ca\u001b[Cio\u001b[C (49, 50, 43 and 60), so\u001b[Con that\u001b[Cinstall the me\u001b[Cus, search form and 404\u001b[Cpage\u001b[10;3H \u001b[Ca\u001b[10;9Hworked.\u001b[K\u001b[11;3H-\u001b[CRunning each one \u001b[Cgai\u001b[11;28Hstops with exit 1, as intended.\u001b[C\u001b[K\u001b[12;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[13;3H\u001b[K\nA\u001b[Csecond \u001b[38;5;153msetup --forc\u001b[C\u001b[39m on the filled\u001b[Cda\u001b[Caba\u001b[Ce\u001b[Crefu\u001b[14;55Hs with \"c\u001b[Cntains already 57\u001b[Ctables\"\u001b[14;92HSo\u001b[Cthat\u001b[Cstep\u001b[15;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[16;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b[19;3H\u001b(B\u001b[m- \u001b[1mFor problem 1:\u001b(B\u001b[m after the import, look the pages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[20;5Hconfiguration.\u001b[CThis\u001b[Cwould\u001b[Cwork\u001b[Clike\u001b[Cthe\u001b[Cexisting\u001b[C\u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[21;3H \u001b[CAlternatively,\u001b[21;21Hcc\u001b[Cpt the pr\u001b[Cblem and\u001b[Cdocument setting the uids\u001b[Cby hand.\u001b[K\u001b[22;3H-\u001b[C\u001b[1mFor problem 2:\u001b[C\u001b(B\u001b[madd a short \"Fresh install\" \u001b[Cection to the README: \u001b[38;5;153mddev start\u001b[39m, \u001b[38;5;153mddev comp\u001b[Cser install\u001b[39m,\u001b[23;5H\u001b[38;5;153mddev restart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with the enviro\u001b[Cment variables, \u001b[38;5;153mgit checkout \u001b[24;3H\u001b[39m \u001b[C\u001b[38;5;153mconfig/system/settings.php\u001b[39m, th\u001b[Cn \u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m. Optionally wrap it\u001b[Cin a DDEV command.\u001b[K\u001b[25;5H\u001b[K\u001b[28;3H"]
[213.060135, "o", "\u001b[1d\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[3;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[5;3H\u001b[K\nAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[7;3H- All\u001b[Cfive exit\u001b[Cd 0. They\u001b[Cr\u001b[Cbuil\u001b[C the tree, 7 news and 8\u001b[Ccontent elements, and wrote their own\u001b[Cuids\u001b[Cinto\u001b[8;3H \u001b[Cthe\u001b[Cs\u001b[Ct\u001b[8;14Hconfiguration (49, 50,\u001b[C43 and 60),\u001b[Cso on that\u001b[Cins\u001b[Call\u001b[Cth\u001b[C menus, search form and 404 page\u001b[K\u001b[9;5Hall\u001b[Cworked.\u001b[K\u001b[10;3H-\u001b[CRunning \u001b[Cach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[11;5H\u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m indexed 7 en\u001b[Cries, and searching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[12;3H\u001b[K\nA\u001b[Csecond\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mon\u001b[Cthe\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[14;3Hcan't simply be run twice.\u001b[K\u001b[15;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed anything)\u001b(B\u001b[m\u001b[17;3H\u001b[K\n-\u001b[C\u001b[1mFor problem 1:\u001b[C\u001b(B\u001b[mafter\u001b[Cthe\u001b[Cimport,\u001b[Clook\u001b[Cthe\u001b[Cpages\u001b[Cup\u001b[Cby\u001b[Ctitle\u001b[Cand\u001b[Cwrite\u001b[Ctheir\u001b[Cuids\u001b[Cinto\u001b[Cthe\u001b[Csite\u001b[19;3H \u001b[Cconfiguration.\u001b[CThis would work like the \u001b[Cxisting \u001b[38;5;153mCreateEditorGroupOnPackageInitialization\u001b[39m.\u001b[K\u001b[20;5HAlternatively,\u001b[Caccept the\u001b[Cproblem and document setting the uids by hand.\u001b[K\u001b[21;3H-\u001b[C\u001b[1mFor problem 2:\u001b[21;21H\u001b(B\u001b[mdd a short \"Fresh\u001b[Ci\u001b[Cstall\" section to the README: \u001b[38;5;153mddev start\u001b[39m,\u001b[C\u001b[38;5;153mddev composer install\u001b[39m,\u001b[22;3H \u001b[C\u001b[38;5;153mddev restart\u001b[39m, \u001b[38;5;153mtypo3 setup --force -n\u001b[39m with th\u001b[C environment\u001b[Cvariables, \u001b[38;5;153mgit checkout \u001b[39m\u001b[K\u001b[23;5H\u001b[38;5;153mconfig/\u001b[Cystem/settings.php\u001b[39m, then \u001b[38;5;153mtypo3 ke_search:indexing\u001b[39m. Optionally wrap it in a\u001b[CDDEV\u001b[Ccommand.\u001b[24;5H\u001b[K\u001b[25;3HThe\u001b[C\u001b[38;5;153mdemo-fresh\u001b[C\u001b[39mproject\u001b[Cis\u001b[Cstill\u001b[Crunning.\u001b[CShould\u001b[CI\u001b[Cremove\u001b[Cit\u001b[Cwith\u001b[C\u001b[38;5;153mddev delete -Oy demo-fresh\u001b[39m,\u001b[Cor\u001b[Cdo\u001b[Cyou\u001b[28;3H"]
