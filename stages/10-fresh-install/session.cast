[15317.984774, "o", "\u001b[1;8H\u001b[38;5;77m\u001b[48;5;22m6\u001b[1;11H\u001b[38;5;231msitepackage\u001b[Cpoints\u001b[Cthe\u001b[Cmenus,\u001b[Cthe\u001b[Csearch\u001b[Cpage\u001b[Cand\u001b[Cthe\u001b[C404\u001b[Cpage\u001b[Cat\u001b[Cthem\u001b[C(see\u001b[2;8H\u001b[38;5;77m7\u001b[2;11H\u001b[38;5;231m\"Page uids in the site settings\" in `packages/\u001b[Ctosafi_sitepackage/README.md`).\u001b[3;8H\u001b[38;5;77m8\u001b[3;11H\u001b[38;5;231mKeep\u001b[Cthe\u001b[Cchange\u001b[Cin\u001b[Cyour\u001b[Cinstallation\u001b[Cand\u001b[Cdo\u001b[Cnot\u001b[Ccommit\u001b[Cit.\u001b[4;8H\u001b[38;5;77m9\u001b[4;11H\u001b[38;5;231m     \u001b[C   \u001b[C      \u001b[C    \u001b[C       \u001b[C     \u001b[C                               \u001b[C   \u001b[5;7H\u001b[38;5;77m50\u001b[5;11H\u001b[38;5;231m### Starting over \u001b[C        \u001b[C   \u001b[C      \u001b[C     \u001b[C   \u001b[C     \u001b[C   \u001b[C     \u001b[C   \u001b[C   \u001b[6;7H\u001b[38;5;77m51\u001b[6;11H\u001b[38;5;231m           \u001b[C      \u001b[C   \u001b[C      \u001b[C   \u001b[C      \u001b[C    \u001b[C   \u001b[C   \u001b[C   \u001b[C    \u001b[C  \u001b[C    \u001b[C    \u001b[7;7H\u001b[38;5;77m52\u001b[7;11H\u001b[38;5;231mThe setup refuses\u001b[Ca database that holds t\u001b[Cbles already, so it cannot run twice\u001b[8;7H\u001b[38;5;77m53\u001b[8;11H\u001b[38;5;231mon the same installation. Remove the\u001b[Cproject with its da\u001b[Cabase\u001b[Cand\u001b[Crun\u001b[Cthe\u001b[9;7H\u001b[38;5;77m54\u001b[9;11H\u001b[38;5;231msteps\u001b[Cagain:\u001b[10;8H\u001b[38;5;77m5\u001b[10;11H\u001b[38;5;231m   \u001b[C        \u001b[C    \u001b[11;8H\u001b[38;5;77m6\u001b[11;15H\u001b[38;5;231mddev\u001b[Cdelete\u001b[C--omit-snapshot\u001b[C--yes\u001b[12;8H\u001b[38;5;77m7\u001b[12;11H\u001b[38;5;231m   \u001b[Cgi\u001b[C checkout config/    \u001b[C    \u001b[C     \u001b[C      \u001b[C        \u001b[C  \u001b[C  \u001b[C      \u001b[C   \u001b[C     \u001b[13;8H\u001b[38;5;77m8\u001b[13;11H\u001b[38;5;231m  \u001b[C   \u001b[C    \u001b[C             \u001b[C      \u001b[C   \u001b[C       \u001b[C    \u001b[C   \u001b[C        \u001b[C   \u001b[C   \u001b[C   \u001b[14;8H\u001b[38;5;77m9\u001b[14;11H\u001b[38;5;231m## Seed scripts\u001b[15;7H\u001b[38;5;77m60\u001b[16;7H61\u001b[16;11H\u001b[38;5;231mThe\u001b[Ccontent in `data.xml` i\u001b[C not edited\u001b[Cby\u001b[Chand.\u001b[CIt\u001b[Cis\u001b[Cwritten\u001b[Cby\u001b[Cthe\u001b[Cscripts\u001b[Cin\u001b[17;7H\u001b[38;5;77m62\u001b[17;11H\u001b[38;5;231m`Build/Initialisation/` and\u001b[Cexported\u001b[Cfrom\u001b[Cthere;\u001b[Cthe\u001b[Corder\u001b[Cand\u001b[Cthe\u001b[Cexport\u001b[18;7H\u001b[38;5;77m63\u001b[18;11H\u001b[38;5;231mcommand\u001b[Care\u001b[Cin\u001b[C`packages/mtosafi_sitepackage/README.md`.\u001b[39m\u001b[49m\u001b[19;6H\u001b[K\r\n\u001b[38;5;231m●\u001b[C\u001b[39mRunning the documented setup steps in the clone now, starting with the reset; I'm also clearing out\u001b[21;3H\u001b[38;5;153mvendor/\u001b[39m and \u001b[38;5;153mpublic/\u001b[39m first.\u001b[38;5;246m · summary\u001b[39m\u001b[K\u001b[22;6H\u001b[K\r\n\u001b[38;5;246m●\u001b[C\u001b[39mRunning \u001b[1m1\u001b(B\u001b[m shell command…\u001b[K\u001b[25;18H\u001b[38;5;246m3\u001b[25;39Hthought for 5s)\u001b[28;3H\u001b(B\u001b[m"]
