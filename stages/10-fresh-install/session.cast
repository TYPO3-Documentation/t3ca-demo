[15254.021846, "o", "\u001b[2;5Hruns\u001b[Cthere.\u001b[CAfter\u001b[Ca\u001b[Ccache\u001b[Cflush\u001b[Cit\u001b[Cstill\u001b[Canswers\u001b[C200\u001b[Con\u001b[Cboth\u001b[Cthe\u001b[Cfrontend\u001b[Cand\u001b[Cthe\u001b[Cbackend.\u001b[3;3H\u001b[K\n\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[5;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[7;3H│   Setting   │ Before │          After          │\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[9;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[10;3H├─────────────┼────────┼─────────────────────────┤\u001b[11;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[12;3H├─────────────┼────────┼─────────────────────────┤\u001b[13;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[14;3H├─────────────┼────────┼─────────────────────────┤\u001b[15;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[16;3H└─────────────┴────────┴─────────────────────────┘\u001b[17;3H\u001b[K\nOn the\u001b[Cfront\u001b[Cn\u001b[C, th\u001b[C servic\u001b[C menu shows E-services portal\u001b[Cand Contact, and the foote\u001b[C show\u001b[18;95Hits\u001b[Cfour\u001b[C\u001b[K\u001b[19;3Hlinks. The hea\u001b[Cer search\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[20;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[21;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[23;3H-\u001b[CThe \"Page uids in the site s\u001b[Cttings\" sectio\u001b[C of \u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[24;3H \u001b[Cclaims the uids stay th\u001b[C same on an empty install, and it describes the listener.\u001b[K\u001b[25;3H-\u001b[CThe\u001b[Ccomment\u001b[Cabove\u001b[Cthe\u001b[Csettings\u001b[Cwrit\u001b[25;69H\u001b[38;5;153md-page-tree.php\u001b[C\u001b[39mnow\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[28;3H"]
[15254.035926, "o", "\u001b[2;5Halready in \u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wasn't\u001b[Cimported stays as it is.\u001b[C\u001b[K\u001b[3;3H-\u001b[CYour\u001b[Clive\u001b[C\u001b[38;5;153mdemo\u001b[C\u001b[39minstall\u001b[Cisn't\u001b[Caffected,\u001b[Cbecause\u001b[Cits\u001b[Cimport\u001b[Cis\u001b[Calready\u001b[Crecorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[4;3H  runs there. After a cache flush it still answers 200\u001b[Con both the frontend and the backend.\u001b[6;3H\u001b[1mResult on a fresh install\u001b(B\u001b[m (database emptied, committed\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[7;3H\u001b[K\n┌\u001b[8;17H┬\u001b[8;26H┬\u001b[8;52H┐\u001b[9;5H  Setting  \u001b[9;19HBefore\u001b[9;28H \u001b[C       After        \u001b[11;5H\u001b[38;5;153mserviceMenu\u001b[11;20H\u001b[39m2\u001b[11;28H9\u001b[11;31HService navigation\"\u001b[13;5H\u001b[38;5;153mfooterMenu\u001b[13;19H\u001b[39m23\u001b[13;28H4 \"Footer navigation\"\u001b[15;5H\u001b[38;5;153msearchPage\u001b[15;19H\u001b[39m16    \u001b[15;28H20 \"Search\" \u001b[C   \u001b[C      \u001b[16;3H├\u001b[16;17H┼\u001b[16;26H┼\u001b[16;52H┤\u001b[17;3H│\u001b[C404\u001b[Cpage\u001b[17;17H│\u001b[C\u001b[38;5;153muid=33\u001b[C\u001b[39m│\u001b[C\u001b[38;5;153muid=14\u001b[C\u001b[39m\"Page\u001b[Cnot\u001b[Cfound\"\u001b[C│\u001b[18;3H└─────────────┴────────┴─────────────────────────┘\u001b[C\u001b[K\u001b[19;3H\u001b[K\nOn the fronte\u001b[20;18H,\u001b[Cthe service\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[21;3Hlinks.\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[22;3H\"Page not found\"\u001b[Cpage.\u001b[23;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[25;9H\"Pag\u001b[C uids in\u001b[25;28Hi\u001b[Ce settings\u001b[25;69H\u001b[38;5;153m_sitepackage/README.md\u001b[39m no longer\u001b[K\u001b[28;3H"]
[15254.066094, "o", "\u001b[2d-\u001b[CIt onl\u001b[2;13Hacts in the setup run that ac\u001b[Cu\u001b[Clly imported \u001b[38;5;153mdata.xml\u001b[39m, and\u001b[Conly if\u001b[Csite\u001b[C\u001b[38;5;153mmain\u001b[39m's\u001b[Croot\u001b[Cpage\u001b[Cis\u001b[3;3H \u001b[Cone of the imported page\u001b[C. It works whether the site c\u001b[Cnfig c\u001b[Cme from \u001b[38;5;153mInitialisation/Site/main/\u001b[39m or was\u001b[4;5Halready in \u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wasn't\u001b[Cimported stays as it is.\u001b[C\u001b[K\u001b[5;3H-\u001b[CYour\u001b[Clive\u001b[C\u001b[38;5;153mdemo\u001b[C\u001b[39minstall\u001b[Cisn't\u001b[Caffected,\u001b[Cbecause\u001b[Cits\u001b[Cimport\u001b[Cis\u001b[Calready\u001b[Crecorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[6;3H  runs there. After a cache flush it still answers 200\u001b[Con both the frontend and the backend.\u001b[8;3H\u001b[1mResult on a fresh install\u001b(B\u001b[m (database emptied, committed\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[9;3H\u001b[K\n┌\u001b[10;17H┬\u001b[10;26H┬\u001b[10;52H┐\u001b[11;5H  Setting  \u001b[11;19HBefore\u001b[11;28H \u001b[C       After        \u001b[13;5H\u001b[38;5;153mserviceMenu\u001b[13;20H\u001b[39m2\u001b[13;28H9\u001b[13;31HService navigation\"\u001b[15;5H\u001b[38;5;153mfooterMenu\u001b[15;19H\u001b[39m23\u001b[15;28H4 \"Footer navigation\"\u001b[17;5H\u001b[38;5;153msearchPage\u001b[17;19H\u001b[39m16    \u001b[17;28H20 \"Search\" \u001b[C   \u001b[C      \u001b[18;3H├\u001b[18;17H┼\u001b[18;26H┼\u001b[18;52H┤\u001b[19;3H│\u001b[C404\u001b[Cpage\u001b[19;17H│\u001b[C\u001b[38;5;153muid=33\u001b[C\u001b[39m│\u001b[C\u001b[38;5;153muid=14\u001b[C\u001b[39m\"Page\u001b[Cnot\u001b[Cfound\"\u001b[C│\u001b[20;3H└─────────────┴────────┴─────────────────────────┘\u001b[C\u001b[K\u001b[21;3H\u001b[K\nOn the fronte\u001b[22;18H,\u001b[Cthe service\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[23;3Hlinks.\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[24;3H\"Page not found\"\u001b[Cpage.\u001b[25;3H \u001b[C   \u001b[C     \u001b[C    \u001b[C  \u001b[C   \u001b[C    \u001b[C        \u001b[25;69H\u001b[K\u001b[28;3H"]
[15254.40387, "o", "\u001b[2d \u001b[Clistener uses that to correct\u001b[2;37He three menu/sea\u001b[Cch settings and the 404 page link of site \u001b[38;5;153mmain\u001b[39m.\u001b[C\u001b[K\u001b[3;3H-\u001b[CIt only acts in \u001b[Che\u001b[Csetup run\u001b[Cthat actually\u001b[Cimported\u001b[C\u001b[38;5;153mdata.xml\u001b[39m, and \u001b[Cnly if site \u001b[38;5;153mmai\u001b[C\u001b[39m's root page is\u001b[K\u001b[4;5Hone of the\u001b[Cimported pages. It works whether the s\u001b[Cte config came from\u001b[C\u001b[38;5;153mInitialisation/Site/main/\u001b[C\u001b[39mor\u001b[Cwas\u001b[5;3H \u001b[Calready in \u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wa\u001b[Cn't imported\u001b[Cstays as it is.\u001b[K\u001b[6;3H-\u001b[CYour\u001b[Clive \u001b[38;5;153mdemo\u001b[39m install isn't affected, becaus\u001b[C its import is\u001b[Calready r\u001b[Ccorde\u001b[6;83Hso the listener\u001b[Cnever\u001b[7;5Hruns\u001b[Cthere.\u001b[CAfter\u001b[Ca\u001b[Ccache\u001b[Cflush\u001b[Cit\u001b[Cstill\u001b[Canswers\u001b[C200\u001b[Con\u001b[Cboth\u001b[Cthe\u001b[Cfrontend\u001b[Cand\u001b[Cthe\u001b[Cbackend.\u001b[8;3H\u001b[K\n\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[10;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[12;3H│   Setting   │ Before │          After          │\u001b[13;3H├─────────────┼────────┼─────────────────────────┤\u001b[14;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[15;3H├─────────────┼────────┼─────────────────────────┤\u001b[16;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[17;3H├─────────────┼────────┼─────────────────────────┤\u001b[18;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[19;3H├─────────────┼────────┼─────────────────────────┤\u001b[20;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[21;3H└─────────────┴────────┴─────────────────────────┘\u001b[22;3H\u001b[K\nOn the\u001b[Cfront\u001b[Cn\u001b[C, th\u001b[C servic\u001b[C menu shows E-services portal\u001b[Cand Contact, and the foote\u001b[C show\u001b[23;95Hits\u001b[Cfour\u001b[C\u001b[K\u001b[24;3Hlinks. The hea\u001b[Cer search\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[25;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[28;3H"]
[15254.428802, "o", "\u001b[2d-\u001b[CIt doesn't guess by page title. TYPO3's\u001b[Cimport keeps a map of old page uids to new\u001b[2;89Hne\u001b[C, and the\u001b[3;3H \u001b[Clistener uses that to correct\u001b[3;37He three menu/sea\u001b[Cch settings and the 404 page link of site \u001b[38;5;153mmain\u001b[39m.\u001b[C\u001b[K\u001b[4;3H-\u001b[CIt only acts in \u001b[Che\u001b[Csetup run\u001b[Cthat actually\u001b[Cimported\u001b[C\u001b[38;5;153mdata.xml\u001b[39m, and \u001b[Cnly if site \u001b[38;5;153mmai\u001b[C\u001b[39m's root page is\u001b[K\u001b[5;5Hone of the\u001b[Cimported pages. It works whether the s\u001b[Cte config came from\u001b[C\u001b[38;5;153mInitialisation/Site/main/\u001b[C\u001b[39mor\u001b[Cwas\u001b[6;3H \u001b[Calready in \u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wa\u001b[Cn't imported\u001b[Cstays as it is.\u001b[K\u001b[7;3H-\u001b[CYour\u001b[Clive \u001b[38;5;153mdemo\u001b[39m install isn't affected, becaus\u001b[C its import is\u001b[Calready r\u001b[Ccorde\u001b[7;83Hso the listener\u001b[Cnever\u001b[8;5Hruns\u001b[Cthere.\u001b[CAfter\u001b[Ca\u001b[Ccache\u001b[Cflush\u001b[Cit\u001b[Cstill\u001b[Canswers\u001b[C200\u001b[Con\u001b[Cboth\u001b[Cthe\u001b[Cfrontend\u001b[Cand\u001b[Cthe\u001b[Cbackend.\u001b[9;3H\u001b[K\n\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[11;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[13;3H│   Setting   │ Before │          After          │\u001b[14;3H├─────────────┼────────┼─────────────────────────┤\u001b[15;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[16;3H├─────────────┼────────┼─────────────────────────┤\u001b[17;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[18;3H├─────────────┼────────┼─────────────────────────┤\u001b[19;3H│ \