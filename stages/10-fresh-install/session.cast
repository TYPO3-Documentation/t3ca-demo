[14940.596079, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[2;2H\u001b[1K\u001b[CThe\u001b[1X\u001b[Csitepackage\u001b[1X\u001b[CREADME\u001b[1X\u001b[Csays\u001b[1X\u001b[Cthese\u001b[1X\u001b[Cuids\u001b[1X\u001b[C\"are\u001b[1X\u001b[Cright\u001b[1X\u001b[Con\u001b[1X\u001b[Can\u001b[1X\u001b[Cinstallation\u001b[1X\u001b[Cthat\u001b[1X\u001b[Cstarts\u001b[1X\u001b[Cempty\".\u001b[1X\u001b[CThat\u001b[1X\u001b[Cis\u001b[1X\u001b[Cnot\u001b[1X\u001b[Ctrue,\u001b[1X\u001b[Cbecause\u001b[1X\u001b[Cthe\u001b[1X\u001b[Cimport\u001b[K\u001b[3;2H\u001b[1K\u001b[Cuids.\u001b[K\r\n\u001b[K\u001b[5;2H\u001b[1K\u001b[1m\u001b[C2. There is no documented way to do a fresh install.\u001b(B\u001b[m\u001b[1X\u001b[CThe\u001b[1X\u001b[Ctop-level\u001b[1X\u001b[CREADME\u001b[1X\u001b[Csays\u001b[1X\u001b[Cnothing\u001b[1X\u001b[Cabout\u001b[1X\u001b[Cit.\u001b[1X\u001b[CThe\u001b[1X\u001b[Csitepackage\u001b[1X\u001b[CREADME\u001b[1X\u001b[Cpoints\u001b[6;2H\u001b[1K\u001b[38;5;153m\u001b[Cextension:setup\u001b[39m,\u001b[1X\u001b[Cwhich\u001b[1X\u001b[Cfails\u001b[1X\u001b[Con\u001b[1X\u001b[Can\u001b[1X\u001b[Cempty\u001b[1X\u001b[Cdatabase\u001b[1X\u001b[C(step\u001b[1X\u001b[C2).\u001b[1X\u001b[CThe\u001b[1X\u001b[Conly\u001b[1X\u001b[Croute\u001b[1X\u001b[Cthat\u001b[1X\u001b[Cworks\u001b[1X\u001b[Cis\u001b[1X\u001b[38;5;153m\u001b[Csetup --force\u001b[39m,\u001b[1X\u001b[Cand\u001b[1X\u001b[Cthat\u001b[1X\u001b[Crewrites\u001b[1X\u001b[Cthe\u001b[K\u001b[7;2H\u001b[1K\u001b[38;5;153m\u001b[Csettings.php\u001b[39m:\u001b[K\u001b[8;2H\u001b[1K\u001b[C-\u001b[1X\u001b[Cit\u001b[1X\u001b[Cdrops\u001b[1X\u001b[Cthe\u001b[1X\u001b[Cwhole\u001b[1X\u001b[38;5;153m\u001b[CEXTENSIONS\u001b[39m\u001b[1X\u001b[Cblock\u001b[1X\u001b[C(ke_search,\u001b[1X\u001b[Cnews\u001b[1X\u001b[Cand\u001b[1X\u001b[Cbackend\u001b[1X\u001b[Csettings),\u001b[K\u001b[9;2H\u001b[1K\u001b[C-\u001b[1X\u001b[Cit\u001b[1X\u001b[Cchanges\u001b[1X\u001b[38;5;153m\u001b[CencryptionKey\u001b[39m,\u001b[1X\u001b[38;5;153m\u001b[CinstallToolPassword\u001b[39m\u001b[1X\u001b[Cand\u001b[1X\u001b[38;5;153m\u001b[Csitename\u001b[39m.\u001b[K\r\n\u001b[K\u001b[11;2H\u001b[1K\u001b[CAfter\u001b[1X\u001b[Cthat,\u001b[1X\u001b[Cthe\u001b[1X\u001b[Cworking\u001b[1X\u001b[Ctree\u001b[1X\u001b[Cis\u001b[1X\u001b[Cdirty\u001b[1X\u001b[Cand\u001b[1X\u001b[Chas\u001b[1X\u001b[Cto\u001b[1X\u001b[Cbe\u001b[1X\u001b[Creset\u001b[1X\u001b[Cwith\u001b[1X\u001b[38;5;153m\u001b[Cgit checkout config/system/settings.php\u001b[39m.\u001b[K\r\n\u001b[K\u001b[13;2H\u001b[1K\u001b[1m\u001b[CSeed scripts\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[15;2H\u001b[1K\u001b[CAfter\u001b[1X\u001b[Cemptying\u001b[1X\u001b[Ceverything\u001b[1X\u001b[Cbelow\u001b[1X\u001b[Cthe\u001b[1X\u001b[Croot\u001b[1X\u001b[Cpage,\u001b[1X\u001b[CI\u001b[1X\u001b[Cran\u001b[1X\u001b[Cthe\u001b[1X\u001b[Cfive\u001b[1X\u001b[Cscripts\u001b[1X\u001b[Cin\u001b[1X\u001b[Cthe\u001b[1X\u001b[CREADME's\u001b[1X\u001b[Corder:\u001b[K\u001b[16;2H\u001b[1K\u001b[C-\u001b[1X\u001b[CAll\u001b[1X\u001b[Cfive\u001b[1X\u001b[Cexited 0.\u001b[1X\u001b[CThey\u001b[1X\u001b[Crebuilt\u001b[1X\u001b[Cthe\u001b[1X\u001b[Ctree,\u001b[1X\u001b[C7\u001b[1X\u001b[Cnews\u001b[1X\u001b[Cand\u001b[1X\u001b[C8\u001b[1X\u001b[Ccontent\u001b[1X\u001b[Celements,\u001b[1X\u001b[Cand\u001b[1X\u001b[Cwrote\u001b[1X\u001b[Ctheir\u001b[1X\u001b[Cown\u001b[1X\u001b[Cuids\u001b[1X\u001b[Cinto\u001b[1X\u001b[Cthe\u001b[1X\u001b[Csite\u001b[1X\u001b[Cconfiguratio\u001b[17;4H\u001b[1K\u001b[Cand 60),\u001b[1X\u001b[Cso\u001b[1X\u001b[Con\u001b[1X\u001b[Cthat\u001b[1X\u001b[Cinstall\u001b[1X\u001b[Cthe\u001b[1X\u001b[Cmenus,\u001b[1X\u001b[Csearch\u001b[1X\u001b[Cform\u001b[1X\u001b[Cand\u001b[1X\u001b[C404\u001b[1X\u001b[Cpage\u001b[1X\u001b[Call\u001b[1X\u001b[Cworked.\u001b[K\u001b[18;2H\u001b[1K\u001b[C-\u001b[1X\u001b[CRunning\u001b[1X\u001b[Ceach\u001b[1X\u001b[Cone\u001b[1X\u001b[Cagain\u001b[1X\u001b[Cstops\u001b[1X\u001b[Cwith\u001b[1X\u001b[Cexit\u001b[1X\u001b[C1,\u0