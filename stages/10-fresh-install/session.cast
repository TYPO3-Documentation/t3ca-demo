[14944.808929, "o", "\u001b[2dThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[3;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[4;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[6;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[7;3Htha\u001b[7;8Hwork\u001b[7;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[Crewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[8;8Hdrops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csettings),\u001b[9;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[10;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[12;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[14;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[16;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[16;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[17;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[Cand 60),\u001b[Cso\u001b[Con\u001b[Cthat\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[18;3H \u001b[Call work\u001b[Cd.\u001b[K\u001b[19;5HRunning each one again stops with exi\u001b[C 1, as intended.\u001b[K\u001b[20;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[21;3H\u001b[K\nA second \u001b[38;5;153msetup --force\u001b[39m on the\u001b[Cfilled\u001b[Cdatabase\u001b[Crefuses\u001b[Cwith\u001b[C\"contains\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[23;3Hcan't\u001b[Csimply\u001b[Cbe\u001b[Crun\u001b[Ctwice.\u001b[24;3H\u001b[K\n\u001b[1mSuggested fixes (I haven't changed an\u001b[28;3H\u001b(B\u001b[m"]
[14944.824908, "o", "\u001b[2d- The h\u001b[Cader s\u001b[Carch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[3;3H- An unknown address shows \"Invalid error handler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[5;3HThe sitepackage README says these uids \"are right on\u001b[Can insta\u001b[Clation that\u001b[5;78Htarts empty\". That is\u001b[Cnot\u001b[6;3Htru\u001b[C, because the impor\u001b[C assigns new uids.\u001b[K\u001b[7;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The top-level\u001b[CREADME \u001b[Cays\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[9;3Hsitepacka\u001b[9;14H README points to \u001b[38;5;153mex\u001b[Censi\u001b[Cn:setup\u001b[39m, which\u001b[Cfails on an\u001b[Cempty\u001b[Cdatabase\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[10;3Hthat\u001b[Cworks\u001b[Cis\u001b[C\u001b[38;5;153msetup --force\u001b[39m,\u001b[Cand\u001b[Cthat\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153msettings.php\u001b[39m:\u001b[11;3H- it drops the wh\u001b[Cle \u001b[38;5;153mEXTENSIONS\u001b[C\u001b[39mblock\u001b[C(ke_search, news and backend settings),\u001b[K\u001b[12;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[13;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[15;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[17;5H\u001b[K\u001b[18;3HAfter\u001b[Cemptying\u001b[Ceverything\u001b[Cbelow\u001b[Cthe\u001b[Croot\u001b[Cpage,\u001b[CI\u001b[Cran\u001b[Cthe\u001b[Cfive\u001b[Cscripts\u001b[Cin\u001b[Cthe\u001b[CREADME's\u001b[Corder:\u001b[19;5HAll five exited 0. They rebuilt th\u001b[C tree\u001b[19;47H7 news and 8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[20;3H \u001b[Cthe site configuration (49, 50, 43\u001b[Ca\u001b[Cd 60)\u001b[20;49Hso on that install the menus, \u001b[Cearch form and\u001b[C404\u001b[Cpage\u001b[21;5Hall\u001b[Cworked.\u001b[22;3H-\u001b[CRunning each one again s\u001b[Cops with exi\u001b[C 1, as intended.\u001b[K\u001b[23;3H- \u001b[38;5;153mtypo3 ke_search:indexing\u001b[C\u001b[39mindexed\u001b[C7\u001b[Centries,\u001b[Cand\u001b[Csearching\u001b[Cfor\u001b[C\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults.\u001b[25;3HA second \u001b[38;5;153msetup --force\u001b[39m on the filled \u001b[25;69Hns\u001b[Calready\u001b[C57\u001b[Ctables\".\u001b[CSo\u001b[Cthat\u001b[Cstep\u001b[28;3H"]
[14944.840094, "o", "\u001b[2dOn the fresh\u001b[2;17Hite:\u001b[K\u001b[3;5HThe service and footer menus \u001b[Cre empty.\u001b[C\u001b[K\u001b[4;3H-\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[5;3H- An unknown address shows \"Invalid error handler\u001b[Cconfigura\u001b[Cion: t3://p\u001b[Cge?uid=33\".\u001b[K\u001b[6;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[8;3Htrue, because the import assigns new uids.\u001b[K\u001b[9;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The \u001b[Cop-level README says\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[11;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, w\u001b[Cich fails on an empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[12;3Htha\u001b[12;8Hworks is \u001b[38;5;153msetu\u001b[C --force\u001b[39m, and that rewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[13;3H-\u001b[Cit\u001b[Cdrops\u001b[Cthe\u001b[Cwhole\u001b[C\u001b[38;5;153mEXTENSIONS\u001b[C\u001b[39mblock\u001b[C(ke_search,\u001b[Cnews\u001b[Cand\u001b[Cbackend\u001b[Csettings),\u001b[14;3H- it changes \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[16;3HAfter that, the\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[18;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[19;3H\u001b[K\nAf\u001b[Cer\u001b[Cemptying eve\u001b[Cy\u001b[Chi\u001b[Cg below the root page, I\u001b[Cran the\u001b[Cfive scripts i\u001b[C the README's order:\u001b[K\u001b[21;3H-\u001b[CA\u001b[21;9Hfive exited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[22;3H \u001b[Cthe site configur\u001b[Ctio\u001b[22;28H(49, 50, 43 and 60), so on that\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[23;3H \u001b[Call worked.\u001b[K\u001b[24;3H-\u001b[CRunning\u001b[Ceach\u001b[Cone\u001b[Cagain\u001b[Cstops\u001b[Cwith\u001b[Cexit\u001b[C1,\u001b[Cas\u001b[Cintended.\u001b[25;3H-\u001b[C\u001b[38;5;153mtypo3 ke_search:ind\u001b[Cxing\u001b[39m indexed 7\u001b[25;69Hater\" gives 3\u001b[Cresults\u001b[25;92H\u001b[K\u001b[28;3H"]
[14944.857496, "o", "\u001b[2d└─────────────┴────────────┴──────────────┘\u001b[3;3H\u001b[K\nOn the fresh\u001b[4;17Hite:\u001b[K\u001b[5;5HThe service and footer menus \u001b[Cre empty.\u001b[C\u001b[K\u001b[6;3H-\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[7;3H- An unknown address shows \"Invalid error handler\u001b[Cconfigura\u001b[Cion: t3://p\u001b[Cge?uid=33\".\u001b[K\u001b[8;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[10;3Htrue, because the import assigns new uids.\u001b[K\u001b[11;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The \u001b[Cop-level README says\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[13;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, w\u001b[Cich fails on an empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[14;3Htha\u001b[14;8Hworks is \u001b[38;5;153msetu\u001b[C --force\u001b[39m, and that rewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[15;3H-\u001b[Cit\u001b[Cdrops\u001b[Cthe\u001b[Cwhole\u001b[C\u001b[38;5;153mEXTENSIONS\u001b[C\u001b[39mblock\u001b[C(ke_search,\u001b[Cnews\u001b[Cand\u001b[Cbackend\u001b[Csettings),\u001b[16;3H- it changes \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[18;3HAfter that, the\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[20;3H\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[K\u001b[21;3H\u001b[K\nAf\u001b[Cer\u001b[Cemptying eve\u001b[Cy\u001b[Chi\u001b[Cg below the root page, I\u001b[Cran the\u001b[Cfive scripts i\u001b[C the README's order:\u001b[K\u001b[23;3H-\u001b[CA\u001b[23;9Hfive exited 0.\u001b[CThey\u001b[Crebuilt\u001b[Cthe\u001b[Ctree,\u001b[C7\u001b[Cnews\u001b[Cand\u001b[C8\u001b[Ccontent\u001b[Celements,\u001b[Cand\u001b[Cwrote\u001b[Ctheir\u001b[Cown\u001b[Cuids\u001b[Cinto\u001b[24;3H \u001b[Cthe site configur\u001b[Ctio\u001b[24;28H(49, 50, 43 and 60), so on that\u001b[Cinstall\u001b[Cthe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[25;3H \u001b[Call worked.             \u001b[C       \u001b[C \u001b[25;69H\u001b[K\u001b[28;3H"]
[14945.155999, "o", "\u001b[2d│ 404 page    │ 33         │ 14           │\u001b[3;3H└─────────────┴────────────┴──────────────┘\u001b[4;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[6;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[7;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[8;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[9;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[11;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[12;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[14;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[15;3Htha\u001b[15;8Hwork\u001b[15;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[Crewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[16;8Hdrops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csettings),\u001b[17;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[18;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[20;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[22;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[24;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[24;14Hexited 0. They rebuilt\u001b[Cthe tree, 7\u001b[Cnews and 8\u001b[Ccon\u001b[Cent\u001b[Cel\u001b[Cments, and wrote their own uids into\u001b[25;5Hthe\u001b[Csite configuration\u001b[C(49,\u001b[C50,\u001b[C43\u001b[25;69Hhe\u001b[Cmenus,\u001b[Csearch\u001b[Cform\u001b[Cand\u001b[C404\u001b[Cpage\u001b[28;3H"]
[14945.172734, "o", "\u001b[2d├─────────────┼────────────┼──────────────┤\u001b[3;3H│ 404 page    │ 33         │ 14           │\u001b[4;3H└─────────────┴────────────┴──────────────┘\u001b[5;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[7;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[8;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[9;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[10;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[12;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[13;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[15;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[16;3Htha\u001b[16;8Hwork\u001b[16;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[Crewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[17;8Hdrops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csettings),\u001b[18;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[19;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[21;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[23;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che root page, I ran the\u001b[Cfive scripts in the README's order:\u001b[K\u001b[25;3H-\u001b[CAll\u001b[Cf\u001b[Cv\u001b[25;14Hexited 0. They rebuilt\u001b[Cthe\u001b[25;69Hl\u001b[Cments, and wrote their own uids into\u001b[28;3H"]
[14945.188586, "o", "\u001b[2d│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[3;3H├─────────────┼────────────┼──────────────┤\u001b[4;3H│ 404 page    │ 33         │ 14           │\u001b[5;3H└─────────────┴────────────┴──────────────┘\u001b[6;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[8;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[9;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[10;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[11;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[13;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[14;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[16;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[17;3Htha\u001b[17;8Hwork\u001b[17;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[Crewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[18;8Hdrops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csettings),\u001b[19;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[20;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[22;3H\u001b[K\n\u001b[1mSeed scripts\u001b(B\u001b[m\u001b[24;3H\u001b[K\nAfter\u001b[Cemptying \u001b[Cverything\u001b[Cb\u001b[Clow \u001b[Che r\u001b[25;69Hpts in the README's order:\u001b[K\u001b[28;3H"]
[14945.203594, "o", "\u001b[2d├─────────────┼────────────┼──────────────┤\u001b[3;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[4;3H├─────────────┼────────────┼──────────────┤\u001b[5;3H│ 404 page    │ 33         │ 14           │\u001b[6;3H└─────────────┴────────────┴──────────────┘\u001b[7;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[9;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[10;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[11;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[12;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[14;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[15;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[17;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[18;3Htha\u001b[18;8Hwork\u001b[18;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[Crewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[19;8Hdrops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csettings),\u001b[20;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallToolPassword\u001b[C\u001b[39mand\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[21;3H\u001b[K\nAfter\u001b[Cthat,\u001b[Cthe\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[23;3H\u001b[K\n\u001b[1mSeed scripts\u001b[25;3H\u001b(B\u001b[m     \u001b[C        \u001b[C          \u001b[C     \u001b[C   \u001b[C \u001b[25;69H\u001b[K\u001b[28;3H"]
[14945.224441, "o", "\u001b[3;5H\u001b[38;5;153mfooterMenu\u001b[3;19H\u001b[39m23\u001b[3;32H4 \u001b[5;5H\u001b[38;5;153msearchPage\u001b[5;19H\u001b[39m16\u001b[5;32H20\u001b[6;3H├\u001b[6;17H┼\u001b[6;30H┼\u001b[6;45H┤\u001b[7;3H│\u001b[C404\u001b[Cpage\u001b[7;17H│\u001b[C33\u001b[7;30H│\u001b[C14\u001b[7;45H│\u001b[8;3H└─────────────┴────────────┴──────────────┘\u001b[9;3H\u001b[K\nOn the fresh\u001b[10;17Hite:\u001b[K\u001b[11;5HThe service and footer menus \u001b[Cre empty.\u001b[C\u001b[K\u001b[12;3H-\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[13;3H- An unknown address shows \"Invalid error handler\u001b[Cconfigura\u001b[Cion: t3://p\u001b[Cge?uid=33\".\u001b[K\u001b[14;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[16;3Htrue, because the import assigns new uids.\u001b[K\u001b[17;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The \u001b[Cop-level README says\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[19;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, w\u001b[Cich fails on an empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[20;3Htha\u001b[20;8Hworks is \u001b[38;5;153msetu\u001b[C --force\u001b[39m, and that rewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[21;3H-\u001b[Cit\u001b[Cdrops\u001b[Cthe\u001b[Cwhole\u001b[C\u001b[38;5;153mEXTENSIONS\u001b[C\u001b[39mblock\u001b[C(ke_search,\u001b[Cnews\u001b[Cand\u001b[Cbackend\u001b[Csettings),\u001b[22;3H- it changes \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[24;3HAfter that, the\u001b[Cworking\u001b[Ctree\u001b[Cis\u001b[Cdirty\u001b[Cand\u001b[Chas\u001b[Cto\u001b[Cbe\u001b[Creset\u001b[Cwith\u001b[C\u001b[38;5;153mgit checkout config/system/settings.php\u001b[39m.\u001b[28;3H"]
[14945.239953, "o", "\u001b[3;5H\u001b[38;5;153mserviceMenu\u001b[3;20H\u001b[39m2\u001b[3;32H9\u001b[5;5H\u001b[38;5;153mfooterMenu\u001b[5;19H\u001b[39m23\u001b[5;32H4 \u001b[7;5H\u001b[38;5;153msearchPage\u001b[7;19H\u001b[39m16\u001b[7;32H20\u001b[8;3H├\u001b[8;17H┼\u001b[8;30H┼\u001b[8;45H┤\u001b[9;3H│\u001b[C404\u001b[Cpage\u001b[9;17H│\u001b[C33\u001b[9;30H│\u001b[C14\u001b[9;45H│\u001b[10;3H└─────────────┴────────────┴──────────────┘\u001b[11;3H\u001b[K\nOn the fresh\u001b[12;17Hite:\u001b[K\u001b[13;5HThe service and footer menus \u001b[Cre empty.\u001b[C\u001b[K\u001b[14;3H-\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Csends\u001b[Cyou\u001b[Cto\u001b[C\u001b[38;5;153m/access-to-information\u001b[39m.\u001b[15;3H- An unknown address shows \"Invalid error handler\u001b[Cconfigura\u001b[Cion: t3://p\u001b[Cge?uid=33\".\u001b[K\u001b[16;3H\u001b[K\nThe\u001b[Csitepackage\u001b[CREADME\u001b[Csays\u001b[Cthese\u001b[Cuids\u001b[C\"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[18;3Htrue, because the import assigns new uids.\u001b[K\u001b[19;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The \u001b[Cop-level README says\u001b[Cnothing\u001b[Cabout\u001b[Cit.\u001b[CThe\u001b[21;3Hsitepackage README points to \u001b[38;5;153mextension:setup\u001b[39m, w\u001b[Cich fails on an empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[22;3Htha\u001b[22;8Hworks is \u001b[38;5;153msetu\u001b[C --force\u001b[39m, and that rewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[23;3H-\u001b[Cit\u001b[Cdrops\u001b[Cthe\u001b[Cwhole\u001b[C\u001b[38;5;153mEXTENSIONS\u001b[C\u001b[39mblock\u001b[C(ke_search,\u001b[Cnews\u001b[Cand\u001b[Cbackend\u001b[Csettings),\u001b[24;3H- it changes \u001b[38;5;153mencryptionKey\u001b[39m, \u001b[38;5;153minstallToolPassword\u001b[39m and\u001b[C\u001b[38;5;153msitename\u001b[39m.\u001b[K\u001b[28;3H"]
[14945.581561, "o", "\u001b[2d│   Setting   │ Configured │ Fresh import │\u001b[3;3H├─────────────┼────────────┼──────────────┤\u001b[4;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[5;3H├─────────────┼────────────┼──────────────┤\u001b[6;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[7;3H├─────────────┼────────────┼──────────────┤\u001b[8;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[9;3H├─────────────┼────────────┼──────────────┤\u001b[10;3H│ 404 page    │ 33         │ 14           │\u001b[11;3H└─────────────┴────────────┴──────────────┘\u001b[12;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[14;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[15;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[16;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[17;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[19;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[20;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[22;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[23;3Htha\u001b[23;8Hwork\u001b[23;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[Crewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[24;8Hdrops the whole \u001b[38;5;153mEXTENSIONS\u001b[39m block (ke_search, news and backend\u001b[Csettings),\u001b[25;3H-\u001b[Cit\u001b[Cchanges\u001b[C\u001b[38;5;153mencryptionKey\u001b[39m,\u001b[C\u001b[38;5;153minstallTo\u001b[28;3H\u001b(B\u001b[m"]
[14945.609654, "o", "\u001b[2d┌─────────────┬────────────┬──────────────┐\u001b[3;3H│   Setting   │ Configured │ Fresh import │\u001b[4;3H├─────────────┼────────────┼──────────────┤\u001b[5;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22         │ 9            │\u001b[6;3H├─────────────┼────────────┼──────────────┤\u001b[7;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23         │ 4            │\u001b[8;3H├─────────────┼────────────┼──────────────┤\u001b[9;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16         │ 20           │\u001b[10;3H├─────────────┼────────────┼──────────────┤\u001b[11;3H│ 404 page    │ 33         │ 14           │\u001b[12;3H└─────────────┴────────────┴──────────────┘\u001b[13;3H\u001b[K\nOn the f\u001b[Cesh site:\u001b[K\u001b[15;9Hs\u001b[Crvice and footer men\u001b[Cs are empty.\u001b[K\u001b[16;5HThe header\u001b[Csea\u001b[Cch sends you to \u001b[38;5;153m/access-to-information\u001b[39m.\u001b[K\u001b[17;3H-\u001b[CAn\u001b[Cunknown\u001b[Caddress\u001b[Cshows\u001b[C\"Invalid\u001b[Cerror\u001b[Chandler\u001b[Cconfiguration:\u001b[Ct3://page?uid=33\".\u001b[18;3H\u001b[K\nThe sit\u001b[Cp\u001b[Cckage README say\u001b[C the\u001b[Ce uids \"are\u001b[Cright\u001b[Con\u001b[Can\u001b[Cinstallation\u001b[Cthat\u001b[Cstarts\u001b[Cempty\".\u001b[CThat\u001b[Cis\u001b[Cnot\u001b[20;3Htrue,\u001b[Cbecause\u001b[Cthe\u001b[Cimport\u001b[Cassigns\u001b[Cnew\u001b[Cuids.\u001b[21;3H\u001b[K\n\u001b[1m2. There is no documented way to do a fresh install.\u001b(B\u001b[m The t\u001b[Cp-lev\u001b[Cl README s\u001b[Cys\u001b[Cno\u001b[Ching about\u001b[Cit. The\u001b[K\u001b[23;3Hsitepackage README points to\u001b[C\u001b[38;5;153mextension:setup\u001b[39m, which fails on\u001b[Can empty database\u001b[C(step\u001b[C2).\u001b[CThe\u001b[Conly\u001b[Croute\u001b[24;3Htha\u001b[24;8Hwork\u001b[24;14His \u001b[38;5;153msetup --force\u001b[39m, and that\u001b[Crewrites the committed \u001b[38;5;153msettings.php\u001b[39m:\u001b[K\u001b[25;8Hdrops the whole \