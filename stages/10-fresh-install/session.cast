[15312.421881, "o", "\u001b[1d└\u001b[1;17H┴\u001b[1;26H┴\u001b[1;52H┘\u001b[2;3H\u001b[K\nOn the frontend, the service menu shows E-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[4;3Hlinks.\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[5;3H\"Page not fou\u001b[5;18H\"\u001b[Cpage.\u001b[K\u001b[6;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[8;3H-\u001b[CThe\u001b[C\"Page\u001b[Cuids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[9;3H  claims the uids\u001b[Cstay\u001b[Cthe\u001b[Csame\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cinstall,\u001b[Cand\u001b[Cit\u001b[Cdescribes\u001b[Cthe\u001b[Clistener.\u001b[10;9Hcomm\u001b[Cnt above\u001b[10;28He\u001b[Ctings write\u001b[Cin \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now says the same.\u001b[11;5H\u001b[K\u001b[12;3HOne side effect: on\u001b[Ca fresh \u001b[12;33Hstall, the listener rewrites the committed \u001b[38;5;153mconfig/sites/main/config.yaml\u001b[13;3H\u001b[39mand\u001b[C\u001b[38;5;153msettings.yaml\u001b[C\u001b[39mto\u001b[Cthe\u001b[Cnew\u001b[Cuids,\u001b[Cso\u001b[Ca\u001b[Ccolleague's\u001b[Cworking\u001b[Ctree\u001b[Cshows\u001b[Cthem\u001b[Cas\u001b[Cchanged\u001b[Cafter\u001b[Csetup.\u001b[14;3HThat's \u001b[Cxpected,\u001b[Cbut they shouldn't commit thos\u001b[C changes back.\u001b[C\u001b[K\u001b[15;3H\u001b[K\u001b[16;5He fresh-install s\u001b[Ceps (the \u001b[38;5;153msetup --force\u001b[C\u001b[39mpart)\u001b[Care still undocumented,\u001b[Cand\u001b[C\u001b[38;5;153mdemo-fresh\u001b[C\u001b[39mis\u001b[Cstill\u001b[17;3Hrunning.\u001b[CShould\u001b[CI\u001b[Cwrite\u001b[Cthe\u001b[CREADME\u001b[Csection,\u001b[Cdraft\u001b[Ca\u001b[Ccommit\u001b[Cmessage,\u001b[Cor\u001b[Cremove\u001b[C\u001b[38;5;153mdemo-fresh\u001b[39m?\u001b[18;3H\u001b[K\r\n\u001b[38;5;246m✻\u001b[CBaked for 2m 3s · done 5:38 PM\u001b[39m\u001b[K\u001b[21;1H\u001b[38;5;246m\u001b[48;5;237m❯ \u001b[38;5;231mwrite the fresh install section in the README\u001b[39m                                                           \u001b[23;1H\u001b[49m\u001b[38;5;246m \u001b[39m \u001b[1mWrite\u001b(B\u001b[m(README.md)\u001b[K\u001b[25;3H\u001b[38;5;216mEnvisioning…\u001b[25;27H\u001b(B\u001b[m\u001b[38;5;246m9\u001b[28;3H\u001b(B\u001b[m"]
[15312.544255, "o", "\u001b[25;1H\u001b[38;5;174m✻\u001b[28;3H\u001b(B\u001b[m"]
[15312.567356, "o", "\u001b[1d   \u001b[38;5;77m\u001b[48;5;22m 41 +\u001b[38;5;231m                                                                                         \u001b[2;6H\u001b[38;5;77m 42 +\u001b[38;5;231mLog in at https://demo.ddev.site/typo3/ as `admin`.                                      \u001b[3;3H\u001b[39m\u001b[49m  \u001b[C\u001b[38;5;77m\u001b[48;5;22m 43 +\u001b[38;5;231m                                                                                         \u001b[39m\u001b[49m\u001b[K\u001b[4;3H   \u001b[38;5;77m\u001b[48;5;22m 44 +\u001b[38;5;231mAfter the setup, `git status` shows `config/sites/main/config.yaml` and                  \u001b[39m\u001b[49m\u001b[K\u001b[5;3H   \u001b[38;5;77m\u001b[48;5;22m 45 +\u001b[38;5;231m`settings.yaml` as changed. The import gives the pages new uids, and the                 \u001b[6;6H\u001b[38;5;77m 46 +\u001b[38;5;231msitepackage points the menus, the search page and the 404 page at them (see              \u001b[7;3H\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 47 +\u001b[38;5;231m\"Page uids in the site settings\" in `packages/mtosafi_sitepackage/README.md`).           \u001b[8;3H\u001b[39m\u001b[49m \u001b[C \u001b[38;5;77m\u001b[48;5;22m 48 +\u001b[38;5;231mKeep the change in your installation and do not commit it.                               \u001b[39m\u001b[49m\u001b[K\u001b[9;5H \u001b[38;5;77m\u001b[48;5;22m 49 +\u001b[38;5;231m                                                                                         \u001b[10;3H\u001b[39m\u001b[49m \u001b[C \u001b[38;5;77m\u001b[48;5;22m 50 +\u001b[38;5;231m### Starting over                                                                        \u001b[39m\u001b[49m\u001b[K\u001b[11;6H\u001b[38;5;77m\u001b[48;5;22m 51 +\u001b[38;5;231m                                                                                         \u001b[12;3H\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 52 +\u001b[38;5;231mThe setup refuses a database that holds tables already, so it cannot run twice           \u001b[39m\u001b[49m\u001b[K\u001b[13;3H   \u001b[38;5;77m\u001b[48;5;22m 53 +\u001b[38;5;231mon the same installation. Remove the project with its database and run the               \u001b[39m\u001b[49m\u001b[K\u001b[14;3H   \u001b[38;5;77m\u001b[48;5;22m 54 +\u001b[38;5;231msteps again:                                                                             \u001b[15;6H\u001b[38;5;77m 55 +\u001b[38;5;231m                                                                                         \u001b[16;3H\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 56 +\u001b[38;5;231m    ddev delete --omit-snapshot --yes                                                    \u001b[17;3H\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 57 +\u001b[38;5;231m    git checkout config/                                                                 \u001b[18;6H\u001b[38;5;77m 58 +\u001b[38;5;231m                                                                                         \r\n\u001b[39m\u001b[49m \u001b[C   \u001b[38;5;77m\u001b[48;5;22m 59 +\u001b[38;5;231m## Seed scripts                                                                          \u001b[20;6H\u001b[38;5;77m 60 +\u001b[38;5;231m                                                                                         \r\n\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m 61 +\u001b[38;5;231mThe content in `data.xml` is not edited by hand. It is written by the scripts in         \u001b[39m\u001b[49m\u001b[K\u001b[22;6H\u001b[38;5;77m\u001b[48;5;22m 62 +\u001b[38;5;231m`Build/Initialisation/` and exported from there; the order and the export                \r\n\u001b[39m\u001b[49m \u001b[C   \u001b[38;5;77m\u001b[48;5;22m 63 +\u001b[38;5;231mcommand are in `packages/mtosafi_sitepackage/README.md`.                                 \u001b[28;3H\u001b(B\u001b[m"]
