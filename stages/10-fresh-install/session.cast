[15071.674113, "o", "\u001b[2;1H \u001b[C\u001b[1mResult on a fresh install\u001b(B\u001b[m (database emptied, committed\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\r\n\u001b[K\u001b[4;3H┌─────────────┬────────┬─────────────────────────┐\u001b[5;3H│\u001b[5;6H Setting  \u001b[C│\u001b[CBefore\u001b[C│          After  \u001b[C   \u001b[C  \u001b[C│\u001b[K\u001b[6;3H├─────────────┼────────┼─────────────────────────┤\u001b[7;3H│\u001b[C\u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[K\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[K\u001b[9;3H│\u001b[C\u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[K\u001b[10;3H├─────────────┼────────┼─────────────────────────┤\u001b[K\u001b[11;3H│\u001b[C\u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[K\u001b[12;3H├─────────────┼────────┼─────────────────────────┤\u001b[K\u001b[13;3H│\u001b[C404 page\u001b[13;16H │ \u001b[38;5;153muid=33\u001b[C\u001b[39m│ \u001b[38;5;153muid=14\u001b[C\u001b[39m\"Page\u001b[Cnot\u001b[Cfound\"\u001b[C│\u001b[14;3H└─────────────┴────────┴─────────────────────────┘\u001b[16;1H \u001b[COn the\u001b[Cfrontend, th\u001b[16;24Hservice menu\u001b[16;38Hhows\u001b[CE-services\u001b[Cportal and Contact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[17;3Hlinks.\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[18;1H \u001b[C\"Page not\u001b[Cfound\" page.\u001b[K\r\n\u001b[K\u001b[20;3H\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[21;3H-\u001b[CThe \"Page uids in the site settings\" section of \u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[39m no longer\u001b[22;5Hclaims the uids stay the same on an empty\u001b[Cinstall,\u001b[Cand\u001b[Cit\u001b[Cdescribes\u001b[Cthe\u001b[Clistener.\u001b[23;3H-\u001b[CThe\u001b[Ccomment\u001b[Cabove\u001b[Cthe\u001b[Csettings\u001b[Cwrite\u001b[Cin\u001b[C\u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[C\u001b[39mnow\u001b[Csays\u001b[Cthe\u001b[Csame.\r\n\u001b[K\r\n  One side effect: on a fresh install, the listener rewrites the committed\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[28;3H\u001b(B\u001b[m"]
[15071.957406, "o", "\u001b[1d\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[2;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[4;3H│   Setting   │ Before │          After          │\u001b[5;3H├─────────────┼────────┼─────────────────────────┤\u001b[6;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[9;3H├─────────────┼────────┼─────────────────────────┤\u001b[10;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[11;3H├─────────────┼────────┼─────────────────────────┤\u001b[12;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[13;3H└─────────────┴────────┴─────────────────────────┘\u001b[14;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[16;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[16;95H404\u001b[Cwith\u001b[Cthe\u001b[17;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[18;3H\u001b[K\n\u001b[1mAlso changed:\u001b[20;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[21;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[22;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[23;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[Cthe\u001b[Clistener\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[25;3H\u001b[39ma\u001b[Cd\u001b[C\u001b[38;5;153msettings.yaml\u001b[39m to the new uids, so a colleague's \u001b[Corking tree shows them as changed after setup.\u001b[K\u001b[28;3H"]
[15072.110914, "o", "\u001b[1d┌─────────────┬────────┬─────────────────────────┐\u001b[K\u001b[2;3H│\u001b[2;7HSetting\u001b[2;17H│\u001b[CBefore\u001b[C│\u001b[2;37HAfter\u001b[2;52H│\u001b[3;3H├\u001b[3;17H┼\u001b[3;26H┼\u001b[3;52H┤\u001b[4;5H\u001b[38;5;153mserviceMenu\u001b[4;19H\u001b[39m22    \u001b[4;28H9\u001b[C\"Service navigation\"\u001b[6;5H\u001b[38;5;153mfooterMenu\u001b[39m \u001b[6;20H3\u001b[6;28H4\u001b[6;31HFooter navigation\" \u001b[8;5H\u001b[38;5;153msearchPage\u001b[8;19H\u001b[39m16\u001b[8;28H20 \"Search\"          \u001b[10;5H404 page  \u001b[10;19H\u001b[38;5;153muid=33\u001b[10;28Huid=14\u001b[39m \"Page\u001b[Cnot\u001b[Cfound\"\u001b[11;3H└\u001b[11;17H┴\u001b[11;26H┴\u001b[11;52H┘\u001b[12;3H\u001b[K\nOn the frontend, the service menu shows E-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[14;3Hlinks.\u001b[CThe\u001b[Cheader\u001b[Csearch\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[15;3H\"Page not fou\u001b[15;18H\"\u001b[Cpage.\u001b[K\u001b[16;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[18;3H-\u001b[CThe\u001b[C\"Page\u001b[Cuids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[19;3H  claims the uids\u001b[Cstay\u001b[Cthe\u001b[Csame\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cinstall,\u001b[Cand\u001b[Cit\u001b[Cdescribes\u001b[Cthe\u001b[Clistener.\u001b[20;9Hcomm\u001b[Cnt above\u001b[20;28He\u001b[Ctings write\u001b[Cin \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now says the same.\u001b[21;5H\u001b[K\u001b[22;3HOne side effect: on\u001b[Ca fresh \u001b[22;33Hstall, the listener rewrites the committed \u001b[38;5;153mconfig/sites/main/config.yaml\u001b[23;3H\u001b[39mand\u001b[C\u001b[38;5;153msettings.yaml\u001b[C\u001b[39mto\u001b[Cthe\u001b[Cnew\u001b[Cuids,\u001b[Cso\u001b[Ca\u001b[Ccolleague's\u001b[Cworking\u001b[Ctree\u001b[Cshows\u001b[Cthem\u001b[Cas\u001b[Cchanged\u001b[Cafter\u001b[Csetup.\u001b[24;3HThat's \u001b[Cxpected,\u001b[Cbut they shouldn't commit thos\u001b[C changes back.\u001b[C\u001b[K\u001b[25;3H\u001b[K\u001b[3B"]
[15072.510956, "o", "\u001b[1d│   Setting   │ Before │          After          │\u001b[2;3H├─────────────┼────────┼─────────────────────────┤\u001b[3;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[4;3H├─────────────┼────────┼─────────────────────────┤\u001b[5;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[6;3H├─────────────┼────────┼─────────────────────────┤\u001b[7;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[9;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[10;3H└─────────────┴────────┴─────────────────────────┘\u001b[11;3H\u001b[K\nOn\u001b[Cthe\u001b[Cfrontend,\u001b[Cthe\u001b[Cservice\u001b[Cmenu\u001b[Cshows\u001b[CE-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[13;3Hlinks.\u001b[CThe h\u001b[Ca\u001b[Cer s\u001b[Carch go\u001b[Cs to \u001b[38;5;153m/search\u001b[39m (\"water\" gives 3\u001b[Cresults). \u001b[38;5;153m/does-not-exist\u001b[39m \u001b[Ceturn\u001b[13;95H404\u001b[Cwith\u001b[Cthe\u001b[14;3H\"Page not foun\u001b[C\" page.\u001b[K\u001b[15;3H\u001b[K\n\u001b[1mAlso changed:\u001b[17;3H\u001b(B\u001b[m- The \"Page uids\u001b[Cin\u001b[Cthe\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[18;3H \u001b[Cclaims the uids stay the sam\u001b[C on an empty i\u001b[Cstall, and it describes the listener.\u001b[K\u001b[19;3H-\u001b[CThe comment above the s\u001b[Cttings write in \u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[39m now\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[20;3H\u001b[K\nOne\u001b[Cside\u001b[Ceffect:\u001b[Con\u001b[Ca\u001b[Cfresh\u001b[Cinstall,\u001b[Cthe\u001b[Clistener\u001b[Crewrites\u001b[Cthe\u001b[Ccommitted\u001b[C\u001b[38;5;153mconfig/sites/main/config.yaml\u001b[22;3H\u001b[39ma\u001b[Cd\u001b[C\u001b[38;5;153msettings.yaml\u001b[39m to the new uids, so a colleague's \u001b[Corking tree shows them as changed after setup.\u001b[K\u001b[23;3HThat's expected, but\u001b[23;27Hy sho\u001b[Cl\u001b[Cn't commit those changes back.\u001b[K\u001b[24;3H\u001b[K\nThe\u001b[Cfresh-install\u001b[Csteps\u001b[C(the\u001b[C\u001b[38;5;153msetup --force\u001b[C\u001b[39mpart)\u001b[Care\u001b[Cstill\u001b[Cundocumented,\u001b[Cand\u001b[C\u001b[38;5;153mdemo-fresh\u001b[C\u001b[39mis\u001b[Cstill\u001b[28;3H"]
[15072.623027, "o", "\u001b[1d├─────────────┼────────┼─────────────────────────┤\u001b[2;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[3;3H├─────────────┼────────┼─────────────────────────┤\u001b[4;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[5;3H├─────────────┼────────┼─────────────────────────┤\u001b[6;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[7;3H└─────────────┴────────┴─────────────────────────┘\u001b[8;3H\u001b[K\nOn the frontend, the service menu shows E-services\u001b[Cportal\u001b[Cand\u001b[CContact,\u001b[Cand\u001b[Cthe\u001b[Cfooter\u001b[Cshows\u001b[Cits\u001b[Cfour\u001b[10;3Hlinks. The header search goes to \u001b[38;5;153m/search\u001b[39m (\"water\" gives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[11;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[12;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[14;3H- Th\u001b[14;9H\"Page \u001b[Ci\u001b[Cs\u001b[Cin the\u001b[Csite\u001b[Csettings\"\u001b[Csection\u001b[Cof\u001b[C\u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[15;5Hclaims\u001b[Cthe\u001b[Cuids\u001b[Cstay\u001b[Cthe\u001b[Csame\u001b[Con\u001b[Can\u001b[Cempty\u001b[Cinstall,\u001b[Cand\u001b[Cit\u001b[Cdescribes\u001b[Cthe\u001b[Clistener.\u001b[16;3H- The comment\u001b[Cabove\u001b[Cthe\u001b[Csettings\u001b[Cwrite\u001b[Cin\u001b[C\u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[C\u001b[39mnow\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[17;3H\u001b[K\nOne s\u001b[Cde\u001b[Ceffect: on \u001b[C fresh install, the listener rewrites th\u001b[C \u001b[Committed \u001b[38;5;153mconfig/sites/main/config.yaml\u001b[19;3H\u001b[39mand \u001b[38;5;153msettings.yaml\u001b[39m to the new uids, so a colleague's working tree shows them as cha\u001b[Cged \u001b[Cfter setup.\u001b[K\u001b[20;3HThat's\u001b[Cexpected,\u001b[Cbut\u001b[Cthey\u001b[Cshouldn't\u001b[Ccommit\u001b[Cthose\u001b[Cchanges\u001b[Cback.\u001b[21;3H\u001b[K\nThe\u001b[Cfresh-install\u001b[Csteps (the\u001b[C\u001b[38;5;153msetup --force\u001b[39m part) are still undocumented, and \u001b[38;5;153mdemo-fresh\u001b[39m is still\u001b[K\u001b[23;3Hrunning. Shoul\u001b[C I wri\u001b[Ce the README section, draft a commit message,\u001b[Cor\u001b[Cremove\u001b[C\u001b[38;5;153mdemo-fresh\u001b[39m?\u001b[25;1H\u001b[38;5;174m✽\u001b[CScurr\u001b(B\u001b[m\u001b[38;5;216myin\u001b(B\u001b[m\u001b[38;5;174mg… \u001b(B\u001b[m\u001b[38;5;246m(2m 3s · ↓\u001b[39m \u001b[38;5;246m11.9k tokens)\u001b[39m\u001b[K\u001b[28;3H"]
