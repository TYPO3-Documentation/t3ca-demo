[15253.148343, "o", "\u001b[1d│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[2;3H├─────────────┼────────┼─────────────────────────┤\u001b[3;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[4;3H├─────────────┼────────┼─────────────────────────┤\u001b[5;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[6;3H├─────────────┼────────┼─────────────────────────┤\u001b[7;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[8;3H└─────────────┴────────┴─────────────────────────┘\u001b[9;3H\u001b[K\nOn the\u001b[Cfront\u001b[Cn\u001b[C, th\u001b[C servic\u001b[C menu shows E-services portal\u001b[Cand Contact, and the foote\u001b[C show\u001b[10;95Hits\u001b[Cfour\u001b[C\u001b[K\u001b[11;3Hlinks. The hea\u001b[Cer search\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[12;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[13;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[15;3H-\u001b[CThe \"Page uids in the site s\u001b[Cttings\" sectio\u001b[C of \u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[16;3H \u001b[Cclaims the uids stay th\u001b[C same on an empty install, and it describes the listener.\u001b[K\u001b[17;3H-\u001b[CThe\u001b[Ccomment\u001b[Cabove\u001b[Cthe\u001b[Csettings\u001b[Cwrite\u001b[Cin\u001b[C\u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[C\u001b[39mnow\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[18;3H\u001b[K\nO\u001b[Ce\u001b[Cside effect: on a fresh install, the listener re\u001b[Crites the committed \u001b[38;5;153mconfig/sites/main/config.yaml\u001b[20;3H\u001b[39mand \u001b[38;5;153msettings.yaml\u001b[39m to\u001b[20;27H new \u001b[Ci\u001b[Cs, so a colleague's working tree\u001b[Cshows\u001b[Cthem\u001b[Cas\u001b[Cchanged\u001b[Cafter\u001b[Csetup.\u001b[21;3HThat's\u001b[Cexpected,\u001b[Cbut\u001b[Cthey\u001b[Cshouldn't\u001b[Ccommit\u001b[Cthose\u001b[Cchanges\u001b[Cback.\u001b[22;3H\u001b[K\nThe fresh-install\u001b[Csteps\u001b[C(the \u001b[38;5;153msetup --force\u001b[39m pa\u001b[Ct) are still\u001b[Cundocumented, and \u001b[38;5;153mdemo-fresh\u001b[39m is\u001b[Cstill\u001b[24;3Hrunning.\u001b[CShould\u001b[CI\u001b[Cwrite\u001b[Cthe\u001b[CREADME\u001b[Csection,\u001b[Cdraft\u001b[Ca\u001b[Ccommit\u001b[Cmessage,\u001b[Cor\u001b[Cremove\u001b[C\u001b[38;5;153mdemo-fresh\u001b[39m?\r\n\u001b[K\u001b[28;3H"]
[15253.160511, "o", "\u001b[H\u001b[38;5;231m\u001b[48;5;237m❯ fix the uids with a listener like the editor group\u001b[39m                                                      \u001b[25;40H\u001b[38;5;231m Jump to bottom (ctrl+End) ↓ \u001b[28;3H\u001b(B\u001b[m"]
[15253.17674, "o", "\u001b[2d│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[3;3H├─────────────┼────────┼─────────────────────────┤\u001b[4;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[5;3H├─────────────┼────────┼─────────────────────────┤\u001b[6;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[9;3H└─────────────┴────────┴─────────────────────────┘\u001b[10;3H\u001b[K\nOn the\u001b[Cfront\u001b[Cn\u001b[C, th\u001b[C servic\u001b[C menu shows E-services portal\u001b[Cand Contact, and the foote\u001b[C show\u001b[11;95Hits\u001b[Cfour\u001b[C\u001b[K\u001b[12;3Hlinks. The hea\u001b[Cer search\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[13;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[14;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[16;3H-\u001b[CThe \"Page uids in the site s\u001b[Cttings\" sectio\u001b[C of \u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[17;3H \u001b[Cclaims the uids stay th\u001b[C same on an empty install, and it describes the listener.\u001b[K\u001b[18;3H-\u001b[CThe\u001b[Ccomment\u001b[Cabove\u001b[Cthe\u001b[Csettings\u001b[Cwrite\u001b[Cin\u001b[C\u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[C\u001b[39mnow\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[19;3H\u001b[K\nO\u001b[Ce\u001b[Cside effect: on a fresh install, the listener re\u001b[Crites the committed \u001b[38;5;153mconfig/sites/main/config.yaml\u001b[21;3H\u001b[39mand \u001b[38;5;153msettings.yaml\u001b[39m to\u001b[21;27H new \u001b[Ci\u001b[Cs, so a colleague's working tree\u001b[Cshows\u001b[Cthem\u001b[Cas\u001b[Cchanged\u001b[Cafter\u001b[Csetup.\u001b[22;3HThat's\u001b[Cexpected,\u001b[Cbut\u001b[Cthey\u001b[Cshouldn't\u001b[Ccommit\u001b[Cthose\u001b[Cchanges\u001b[Cback.\u001b[23;3H\u001b[K\nThe fresh-install\u001b[Csteps\u001b[C(the \u001b[38;5;153msetup --force\u001b[39m pa\u001b[Ct) are still\u001b[Cundocumented, and \u001b[38;5;153mdemo-fresh\u001b[39m is\u001b[Cstill\u001b[25;3Hrunning.\u001b[CShould\u001b[CI\u001b[Cwrite\u001b[Cthe\u001b[CREADME\u001b[Cse\u001b[25;69H,\u001b[Cor\u001b[Cremove\u001b[C\u001b[38;5;153mdemo-fresh\u001b[39m?\u001b[28;3H"]
[15253.239573, "o", "\u001b[2d├─────────────┼────────┼─────────────────────────┤\u001b[3;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[4;3H├─────────────┼────────┼─────────────────────────┤\u001b[5;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[6;3H├─────────────┼────────┼─────────────────────────┤\u001b[7;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[8;3H├─────────────┼────────┼─────────────────────────┤\u001b[9;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[10;3H└─────────────┴────────┴─────────────────────────┘\u001b[11;3H\u001b[K\nOn the\u001b[Cfront\u001b[Cn\u001b[C, th\u001b[C servic\u001b[C menu shows E-services portal\u001b[Cand Contact, and the foote\u001b[C show\u001b[12;95Hits\u001b[Cfour\u001b[C\u001b[K\u001b[13;3Hlinks. The hea\u001b[Cer search\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[14;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[15;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[17;3H-\u001b[CThe \"Page uids in the site s\u001b[Cttings\" sectio\u001b[C of \u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[18;3H \u001b[Cclaims the uids stay th\u001b[C same on an empty install, and it describes the listener.\u001b[K\u001b[19;3H-\u001b[CThe\u001b[Ccomment\u001b[Cabove\u001b[Cthe\u001b[Csettings\u001b[Cwrite\u001b[Cin\u001b[C\u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[C\u001b[39mnow\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[20;3H\u001b[K\nO\u001b[Ce\u001b[Cside effect: on a fresh install, the listener re\u001b[Crites the committed \u001b[38;5;153mconfig/sites/main/config.yaml\u001b[22;3H\u001b[39mand \u001b[38;5;153msettings.yaml\u001b[39m to\u001b[22;27H new \u001b[Ci\u001b[Cs, so a colleague's working tree\u001b[Cshows\u001b[Cthem\u001b[Cas\u001b[Cchanged\u001b[Cafter\u001b[Csetup.\u001b[23;3HThat's\u001b[Cexpected,\u001b[Cbut\u001b[Cthey\u001b[Cshouldn't\u001b[Ccommit\u001b[Cthose\u001b[Cchanges\u001b[Cback.\u001b[24;3H\u001b[K\nThe fresh-install\u001b[Csteps\u001b[C(the \u001b[38;5;153msetup --\u001b[25;69H\u001b[39mented, and \u001b[38;5;153mdemo-fresh\u001b[39m is\u001b[Cstill\u001b[28;3H"]
[15253.404835, "o", "\u001b[2d│   Setting   │ Before │          After          │\u001b[3;3H├─────────────┼────────┼─────────────────────────┤\u001b[4;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[5;3H├─────────────┼────────┼─────────────────────────┤\u001b[6;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[7;3H├─────────────┼────────┼─────────────────────────┤\u001b[8;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[9;3H├─────────────┼────────┼─────────────────────────┤\u001b[10;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[11;3H└─────────────┴────────┴─────────────────────────┘\u001b[12;3H\u001b[K\nOn the\u001b[Cfront\u001b[Cn\u001b[C, th\u001b[C servic\u001b[C menu shows E-services portal\u001b[Cand Contact, and the foote\u001b[C show\u001b[13;95Hits\u001b[Cfour\u001b[C\u001b[K\u001b[14;3Hlinks. The hea\u001b[Cer search\u001b[Cgoes\u001b[Cto\u001b[C\u001b[38;5;153m/search\u001b[C\u001b[39m(\"water\"\u001b[Cgives\u001b[C3\u001b[Cresults).\u001b[C\u001b[38;5;153m/does-not-exist\u001b[C\u001b[39mreturns\u001b[C404\u001b[Cwith\u001b[Cthe\u001b[15;3H\"Page\u001b[Cnot\u001b[Cfound\"\u001b[Cpage.\u001b[16;3H\u001b[K\n\u001b[1mAlso changed:\u001b(B\u001b[m\u001b[K\u001b[18;3H-\u001b[CThe \"Page uids in the site s\u001b[Cttings\" sectio\u001b[C of \u001b[38;5;153mpackages/mtosafi_sitepackage/README.md\u001b[C\u001b[39mno\u001b[Clonger\u001b[19;3H \u001b[Cclaims the uids stay th\u001b[C same on an empty install, and it describes the listener.\u001b[K\u001b[20;3H-\u001b[CThe\u001b[Ccomment\u001b[Cabove\u001b[Cthe\u001b[Csettings\u001b[Cwrite\u001b[Cin\u001b[C\u001b[38;5;153mBuild/Initialisation/seed-page-tree.php\u001b[C\u001b[39mnow\u001b[Csays\u001b[Cthe\u001b[Csame.\u001b[21;3H\u001b[K\nO\u001b[Ce\u001b[Cside effect: on a fresh install, the listener re\u001b[Crites the committed \u001b[38;5;