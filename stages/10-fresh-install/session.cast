[15254.971841, "o", "\u001b[2d\u001b[1mNew file:\u001b(B\u001b[m\u001b[K\u001b[3;3H\u001b[38;5;153mpackages/mtosafi_sitepackage/Classes/Initialization/RemapSitePageUidsOnPackageInitialization.php\u001b[39m\u001b[4;3H\u001b[K\u001b[5;8Hrun\u001b[C after the core's\u001b[Cimport, like the edi\u001b[Cor group\u001b[Clistener.\u001b[K\u001b[6;3H-\u001b[CIt doesn't guess by page title. TYPO3's\u001b[Cimport keeps a map of old page uids to new\u001b[6;89Hne\u001b[C, and the\u001b[7;3H \u001b[Clistener uses that to correct\u001b[7;37He three menu/sea\u001b[Cch settings and the 404 page link of site \u001b[38;5;153mmain\u001b[39m.\u001b[C\u001b[K\u001b[8;3H-\u001b[CIt only acts in \u001b[Che\u001b[Csetup run\u001b[Cthat actually\u001b[Cimported\u001b[C\u001b[38;5;153mdata.xml\u001b[39m, and \u001b[Cnly if site \u001b[38;5;153mmai\u001b[C\u001b[39m's root page is\u001b[K\u001b[9;5Hone of the\u001b[Cimported pages. It works whether the s\u001b[Cte config came from\u001b[C\u001b[38;5;153mInitialisation/Site/main/\u001b[C\u001b[39mor\u001b[Cwas\u001b[10;3H \u001b[Calready in \u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wa\u001b[Cn't imported\u001b[Cstays as it is.\u001b[K\u001b[11;3H-\u001b[CYour\u001b[Clive \u001b[38;5;153mdemo\u001b[39m install isn't affected, becaus\u001b[C its import is\u001b[Calready r\u001b[Ccorde\u001b[11;83Hso the listener\u001b[Cnever\u001b[12;5Hruns\u001b[Cthere.\u001b[CAfter\u001b[Ca\u001b[Ccache\u001b[Cflush\u001b[Cit\u001b[Cstill\u001b[Canswers\u001b[C200\u001b[Con\u001b[Cboth\u001b[Cthe\u001b[Cfrontend\u001b[Cand\u001b[Cthe\u001b[Cbackend.\u001b[13;3H\u001b[K\n\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[15;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[17;3H│   Setting   │ Before │          After          │\u001b[18;3H├─────────────┼────────┼─────────────────────────┤\u001b[19;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[20;3H├─────────────┼────────┼─────────────────────────┤\u001b[21;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[22;3H├─────────────┼────────┼─────────────────────────┤\u001b[23;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[24;3H├─────────────┼────────┼─────────────────────────┤\u001b[25;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page\u001b[28;3H"]
[15258.879824, "o", "\u001b[2d\u001b[38;5;153mpackages/mtosafi_sitepackage/Classes/Initialization/RemapSitePageUidsOnPackageInitialization.php\u001b[39m\u001b[3;3H\u001b[K\n-\u001b[CIt\u001b[Cruns\u001b[Cafter\u001b[Cthe\u001b[Ccore's\u001b[Cimport,\u001b[Clike\u001b[Cthe\u001b[Ceditor\u001b[Cgroup\u001b[Clistener.\u001b[5;8Hdoe\u001b[Cn't guess by page\u001b[Ctitle. TYPO3's impor\u001b[C keeps a\u001b[Cmap of old\u001b[Cpage\u001b[Cuids\u001b[Cto\u001b[Cnew\u001b[Cones,\u001b[Cand\u001b[Cthe\u001b[6;3H \u001b[Clistener uses that to correct the three\u001b[Cmenu/search settings and the 404 page link\u001b[6;89Hf \u001b[Cite \u001b[38;5;153mmain\u001b[39m.\u001b[7;3H-\u001b[CIt only acts in the setup run\u001b[7;37Hat actually impo\u001b[Cted \u001b[38;5;153mdata.xml\u001b[39m, and only if site \u001b[38;5;153mmain\u001b[39m's root page\u001b[Cis\u001b[8;3H \u001b[Cone of the impor\u001b[Ced\u001b[Cpages. It\u001b[Cworks whether\u001b[Cthe site\u001b[Cconfig came fr\u001b[Cm \u001b[38;5;153mInitialisatio\u001b[C/Site/main/\u001b[39m or was\u001b[9;5Halready in\u001b[C\u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wasn't \u001b[Cmported stays as it\u001b[Cis.\u001b[K\u001b[10;3H-\u001b[CYour live \u001b[38;5;153mdemo\u001b[39m install isn't affected, becau\u001b[Ce its import\u001b[Cis already recorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[11;3H \u001b[Cruns\u001b[Cthere. After a cache flush it still answ\u001b[Crs 200 on both\u001b[Cthe front\u001b[Cnd an\u001b[11;83Hthe backend.\u001b[K\u001b[12;5H\u001b[K\u001b[13;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[14;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[16;3H│   Setting   │ Before │          After          │\u001b[17;3H├─────────────┼────────┼─────────────────────────┤\u001b[18;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[19;3H├─────────────┼────────┼─────────────────────────┤\u001b[20;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[21;3H├─────────────┼────────┼─────────────────────────┤\u001b[22;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[23;3H├─────────────┼────────┼─────────────────────────┤\u001b[24;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[25;3H└─────────────┴────────┴─────────────\u001b[28;3H"]
[15258.959402, "o", "\u001b[2d\u001b[K\n-\u001b[CIt\u001b[Cruns\u001b[Cafter\u001b[Cthe\u001b[Ccore's\u001b[Cimport,\u001b[Clike\u001b[Cthe\u001b[Ceditor\u001b[Cgroup\u001b[Clistener.\u001b[4;8Hdoe\u001b[Cn't guess by page\u001b[Ctitle. TYPO3's impor\u001b[C keeps a\u001b[Cmap of old\u001b[Cpage\u001b[Cuids\u001b[Cto\u001b[Cnew\u001b[Cones,\u001b[Cand\u001b[Cthe\u001b[5;3H \u001b[Clistener uses that to correct the three\u001b[Cmenu/search settings and the 404 page link\u001b[5;89Hf \u001b[Cite \u001b[38;5;153mmain\u001b[39m.\u001b[6;3H-\u001b[CIt only acts in the setup run\u001b[6;37Hat actually impo\u001b[Cted \u001b[38;5;153mdata.xml\u001b[39m, and only if site \u001b[38;5;153mmain\u001b[39m's root page\u001b[Cis\u001b[7;3H \u001b[Cone of the impor\u001b[Ced\u001b[Cpages. It\u001b[Cworks whether\u001b[Cthe site\u001b[Cconfig came fr\u001b[Cm \u001b[38;5;153mInitialisatio\u001b[C/Site/main/\u001b[39m or was\u001b[8;5Halready in\u001b[C\u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wasn't \u001b[Cmported stays as it\u001b[Cis.\u001b[K\u001b[9;3H-\u001b[CYour live \u001b[38;5;153mdemo\u001b[39m install isn't affected, becau\u001b[Ce its import\u001b[Cis already recorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[10;3H \u001b[Cruns\u001b[Cthere. After a cache flush it still answ\u001b[Crs 200 on both\u001b[Cthe front\u001b[Cnd an\u001b[10;83Hthe backend.\u001b[K\u001b[11;5H\u001b[K\u001b[12;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[13;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[15;3H│   Setting   │ Before │          After          │\u001b[16;3H├─────────────┼────────┼─────────────────────────┤\u001b[17;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[18;3H├─────────────┼────────┼─────────────────────────┤\u001b[19;3H│ \u001b[38;5;153mfooterMenu\u001b[39m  │ 23     │ 4 \"Footer navigation\"   │\u001b[20;3H├─────────────┼────────┼─────────────────────────┤\u001b[21;3H│ \u001b[38;5;153msearchPage\u001b[39m  │ 16     │ 20 \"Search\"             │\u001b[22;3H├─────────────┼────────┼─────────────────────────┤\u001b[23;3H│ 404 page    │ \u001b[38;5;153muid=33\u001b[39m │ \u001b[38;5;153muid=14\u001b[39m \"Page not found\" │\u001b[24;3H└─────────────┴────────┴─────────────────────────┘\u001b[25;3H                                     \u001b[28;3H"]
[15259.825553, "o", "\u001b[2d-\u001b[CIt\u001b[Cruns\u001b[Cafter\u001b[Cthe\u001b[Ccore's\u001b[Cimport,\u001b[Clike\u001b[Cthe\u001b[Ceditor\u001b[Cgroup\u001b[Clistener.\u001b[3;8Hdoe\u001b[Cn't guess by page\u001b[Ctitle. TYPO3's impor\u001b[C keeps a\u001b[Cmap of old\u001b[Cpage\u001b[Cuids\u001b[Cto\u001b[Cnew\u001b[Cones,\u001b[Cand\u001b[Cthe\u001b[4;3H \u001b[Clistener uses that to correct the three\u001b[Cmenu/search settings and the 404 page link\u001b[4;89Hf \u001b[Cite \u001b[38;5;153mmain\u001b[39m.\u001b[5;3H-\u001b[CIt only acts in the setup run\u001b[5;37Hat actually impo\u001b[Cted \u001b[38;5;153mdata.xml\u001b[39m, and only if site \u001b[38;5;153mmain\u001b[39m's root page\u001b[Cis\u001b[6;3H \u001b[Cone of the impor\u001b[Ced\u001b[Cpages. It\u001b[Cworks whether\u001b[Cthe site\u001b[Cconfig came fr\u001b[Cm \u001b[38;5;153mInitialisatio\u001b[C/Site/main/\u001b[39m or was\u001b[7;5Halready in\u001b[C\u001b[38;5;153mconfig/sites/main/\u001b[39m. A uid that wasn't \u001b[Cmported stays as it\u001b[Cis.\u001b[K\u001b[8;3H-\u001b[CYour live \u001b[38;5;153mdemo\u001b[39m install isn't affected, becau\u001b[Ce its import\u001b[Cis already recorded\u001b[Cso\u001b[Cthe\u001b[Clistener\u001b[Cnever\u001b[9;3H \u001b[Cruns\u001b[Cthere. After a cache flush it still answ\u001b[Crs 200 on both\u001b[Cthe front\u001b[Cnd an\u001b[9;83Hthe backend.\u001b[K\u001b[10;5H\u001b[K\u001b[11;3H\u001b[1mResult on a fresh install\u001b[C\u001b(B\u001b[m(database\u001b[Cemptied,\u001b[Ccommitted\u001b[Csite\u001b[Cconfig,\u001b[C\u001b[38;5;153mtypo3 setup --force -n\u001b[39m):\u001b[12;3H\u001b[K\n┌─────────────┬────────┬─────────────────────────┐\u001b[14;3H│   Setting   │ Before │          After          │\u001b[15;3H├─────────────┼────────┼─────────────────────────┤\u001b[16;3H│ \u001b[38;5;153mserviceMenu\u001b[39m │ 22     │ 9 \"Service navigation\"  │\u001b[17;3H├─────────────┼────────┼─────────────────────────┤\u001b[18;3H│ \u001b[38;5;153mfooterMenu\u