[15322.463671, "o", "\u001b[1;7H\u001b[38;5;77m\u001b[48;5;22m50\u001b[1;11H\u001b[38;5;231m### Starting \u001b[Cver \u001b[C   \u001b[C      \u001b[C   \u001b[C      \u001b[C    \u001b[C   \u001b[C   \u001b[C   \u001b[C    \u001b[C  \u001b[C    \u001b[C    \u001b[2;7H\u001b[38;5;77m51\u001b[2;11H\u001b[38;5;231m     \u001b[C    \u001b[C  \u001b[C   \u001b[C    \u001b[C         \u001b[C  \u001b[C                                          \u001b[3;7H\u001b[38;5;77m52\u001b[3;11H\u001b[38;5;231mTh\u001b[C setup refuses a databa\u001b[Ce th\u001b[3;44H holds tables already, so\u001b[Cit\u001b[Ccannot\u001b[Crun\u001b[Ctwice\u001b[4;7H\u001b[38;5;77m53\u001b[4;11H\u001b[38;5;231mon\u001b[Cthe\u001b[Csame\u001b[Cinstallation.\u001b[CRemove\u001b[Cthe\u001b[Cproject\u001b[Cwith\u001b[Cits\u001b[Cdatabase\u001b[Cand\u001b[Crun\u001b[Cthe\u001b[5;8H\u001b[38;5;77m4\u001b[5;11H\u001b[38;5;231msteps \u001b[Cga\u001b[5;22H:\u001b[C    \u001b[6;8H\u001b[38;5;77m5\u001b[7;8H6\u001b[7;11H\u001b[38;5;231m   \u001b[Cddev delete --omit-sn\u001b[Cpshot --yes  \u001b[C      \u001b[C        \u001b[C  \u001b[C  \u001b[C      \u001b[C   \u001b[C     \u001b[8;8H\u001b[38;5;77m7\u001b[8;11H\u001b[38;5;231m  \u001b[C git ch\u001b[Cckou\u001b[C conf\u001b[Cg/ \u001b[C      \u001b[C   \u001b[C       \u001b[C    \u001b[C   \u001b[C        \u001b[C   \u001b[C   \u001b[C   \u001b[9;8H\u001b[38;5;77m8\u001b[9;11H\u001b[38;5;231m     \u001b[C      \u001b[10;8H\u001b[38;5;77m9\u001b[10;11H\u001b[38;5;231m##\u001b[CSeed\u001b[Cscripts\u001b[11;7H\u001b[38;5;77m60\u001b[11;15H\u001b[38;5;231m    \u001b[C      \u001b[C               \u001b[C     \u001b[12;7H\u001b[38;5;77m61\u001b[12;11H\u001b[38;5;231mThe\u001b[Ccontent in `data.xml`\u001b[Cis\u001b[Cnot\u001b[Cedited\u001b[Cby\u001b[Chand.\u001b[CIt\u001b[Cis\u001b[Cwritten\u001b[Cby\u001b[Cthe\u001b[Cscripts\u001b[Cin\u001b[13;7H\u001b[38;5;77m62\u001b[13;11H\u001b[38;5;231m`Build/Initialisation/`\u001b[Cand\u001b[Cexported\u001b[Cfrom\u001b[Cthere;