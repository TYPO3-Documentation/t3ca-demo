[1777.691586, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[22B\u001b[38;2;177;185;249m❯ /\u001b[1me\u001b[22mxit                                     \u001b[1mE\u001b[22mxit the CLI\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mffort                                   S\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mt the model's effort level\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mxport                                   \u001b[39m\u001b[1mE\u001b[22m\u001b[38;2;153;153;153mxport this session to a file or clipboard\u001b[39m\u001b[K\r\u001b[12C\u001b[1B\u001b[38;2;153;153;153mistribution-\u001b[26Gont\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mnt       \u001b[47GShip th\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153m \u001b[57Gontent of a TYPO3 site inside an extension, as a\r\u001b[46C\u001b[1Bdistribu\u001b[56Gion — th\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153m initial cont\u001b[79Gnt a package carries, \u001b[102Ghe\r\u001b[3C\u001b[2B\u001b[39me\u001b[31;1H\u001b[29;5H\u001b[?25h"]
