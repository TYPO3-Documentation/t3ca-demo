[1613.220287, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 141 \u001b[12G\u001b[22m##\u001b[15GEvents\r\u001b[5C\u001b[1B\u001b[2m 142 \r\u001b[1B\u001b[22m\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe breadcrumb o\u001b[20G a detail page now ends with the title of the event or news item instead \u001b[94Gf \"Event\" or\r\u001b[2C\u001b[1B\"Article\":\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEvent: Hom\u001b[16G › Events › F\u001b[30Gstive market at the jetty\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNews: Home › New\u001b[22G › New fish market opens at\u001b[50Gthe\u001b[54Gjetty\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mHow it works:\u001b[22m the news extension\u001b[36Galready\u001b[44Ghas\u001b[48Ga\u001b[50Gdata\u001b[55Gprocessor\u001b[65Gthat\u001b[70Gadds\u001b[75Gthe\u001b[79Gnews\u001b[84Grecord\u001b[91Gto\u001b[94Ga\u001b[96Gmenu,\u001b[102Gbut\r\u001b[2C\u001b[1Bit\u001b[6Gadds it \u001b[3mafter\u001b[23m \u001b[21Ghe last item.\u001b[35GTha\u001b[39G would give Hom\u001b[55G › Events ›\u001b[67GEvent ›\u001b[75GFestive market, with\u001b[96G\"Event\"\r\u001b[2C\u001b[1Blinking to an empty page. A small subc\u001b[42Gass, \u001b[38;2;177;185;249mClasses/DataProcessing/NewsTitleInBreadcrumbProcessor.php\u001b[39m,\r\u001b[2C\u001b[1Breplaces\u001b[16Glast item instead. It's wired into\u001b[51Gthe bre\u001b[59Gdcrumb i\u001b[68G \u001b[38;2;177;185;249msetup.typoscript\u001b[86G\u001b[39m(entry\u001b[93G\u001b[38;2;177;185;249m41\u001b[39m).\u001b[98GPages\r\u001b[2C\u001b[1Bwithout an event or article in the address keep their normal breadcrumb.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChecked on this installation:\u001b[22m I loaded both detail pages above and got the expected breadcrumbs.\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/events\u001b[39m, \u001b[38;2;177;185;249m/revenue-payments/land-rates\u001b[39m and \u001b[38;2;177;185;249m/news/article\u001b[39m without an article are unchanged. The README's\r\u001b[2C\u001b[1BNews section mentions the new behaviour. This is configuration and code only, so \u001b[38;2;177;185;249mdata.xml\u001b[39m doesn't\u001b[101Gneed\u001b[106Ga\r\u001b[2C\u001b[1Bnew export.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill open\u001b[14Gfrom\u001b[19Gearlier:\u001b[28Gthe\u001b[32G\"Editors\"\u001b[42Ggroup\u001b[48Gon\u001b[51Gthis\u001b[56Ginstallation\u001b[69Gcan't\u001b[75Gedit\u001b[80Gthe\u001b[84Gevent\u001b[90Gfields\u001b[97Gyet,\u001b[102Gand\r\u001b[1B  the fresh-install proof\u001b[27Ghasn't\u001b[34Grun.\u001b[39GNothing\u001b[47Gis\u001b[50Gcommitted.\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3G\u001b[38;2;235;159;127mFro\u001b[38;2;215;119;87msting…\u001b[15G\u001b[38;2;153;153;153m9\u001b[24G7\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
