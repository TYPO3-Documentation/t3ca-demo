[259.639832, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gthe fixes matter for your multi-day events: an event now shows in every month it ru\u001b[89Gs\u001b[91Gthro\u001b[96Ggh, and\u001b[K\r\u001b[4C\u001b[1Bsearching\u001b[15Ga date\u001b[22Grange finds events\u001b[41Gthat \u001b[47Gpan it. Location records also\u001b[77Ggained addre\u001b[90Gs fields.\u001b[100GThe\r\u001b[4C\u001b[1Blast commit\u001b[17Gw\u001b[19Gs on 2026-10-09.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIssues:\u001b[22m that batch\u001b[24Gclosed long-standing\u001b[45Gissues\u001b[52Gtoo,\u001b[57Gsome\u001b[62Gof\u001b[65Gthem\u001b[70Gyears\u001b[76Gold\u001b[80G(#81,\u001b[86G#153,\u001b[92G#184,\u001b[98G#191,\r\u001b[2C\u001b[1B \u001b[5G#198). 29 issues are still \u001b[33Gpen.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRelease pattern:\u001b[23G\u001b[22mbout one\u001b[32Gmajor\u001b[38Gor\u001b[41Gminor\u001b[47Grelease\u001b[55Ga\u001b[57Gyear,\u001b[63Gfollowing\u001b[73Gthe\u001b[77GTYPO3\u001b[83Gversions:\u001b[93G6.0\u001b[97Gin\u001b[100G2023\r\u001b[2C\u001b[1B \u001b[5Gfor TYPO3 12, 7.0 in 2024 for 13, 7.1 in 2025, and 7.2 in\u001b[63G2026 for 14. The repository isn't\u001b[97Garchived.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat to keep in mind:\u001b[25G\u001b[22mwork\u001b[30Gcomes\u001b[36Gin\u001b[39Gbursts,\u001b[47Gand\u001b[51Geverything\u001b[62Gdepends\u001b[70Gon\u001b[73Gone\u001b[77Gmaintainer.\u001b[89GThat's\u001b[96Gthe\u001b[100Gsame\r\u001b[2C\u001b[1Brisk you already take\u001b[26Gith\u001b[30G\u001b[38;2;177;185;249mgeorgringer/news\u001b[39m, and even\u001b[57Gnews\u001b[62Gt\u001b[64Gnds to get its upd\u001b[83Gte soon \u001b[92Gfter n\u001b[99Gw\u001b[101G\u001b[K\r\u001b[2C\u001b[1Bsupports\u001b[13G n\u001b[16Gw TYPO3 version. If it were abandoned, the events would s\u001b[74Gill be ordinary news \u001b[96Gecords\u001b[103Gwith\r\u001b[2C\u001b[1Ba few extra columns,\u001b[24Gso moving them\u001b[39Gto pl\u001b[45Gin news or anoth\u001b[62Gr extension would be ma\u001b[87Ggeable.\u001b[95G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy\u001b[6Grecommendation\u001b[21Gstands.\u001b[29GShould\u001b[36GI\u001b[38Ggo\u001b[41Gahead\u001b[47Gwith\u001b[52Git?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 12s · done 7:14 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhat happens if we have events spanning multiple days?\u001b[39m                                                  \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1BReading\u001b[11Geventnews\u001b[21Gquery\u001b[27Glogic\u001b[33Gand\u001b[37Gtemplates\r\u001b[2C\u001b[1B⎿  $ cd\u001b[11G/tmp/claude-10\u001b[26G0/-hom\u001b[33G-lina-wolf-proj\u001b[49Gcts-typo3-t3ca-2026-demo/589de020-9581-425c-897d-80214a2ea\r\u001b[2C\u001b[1B \u001b[6Gfbb/scratchp\u001b[19Gd/src/eventnews && sed -n 40,190p\u001b[K\r\u001b[5C\u001b[1BClas\u001b[11Ges/EventListener/ModifyDemandRepositoryEv\u001b[53Gn\u001b[55GList\u001b[60Gn\u001b[62Gr.php;\u001b[69Ggrep -n 'EVENT_RESTRICTION'\u001b[K\r\u001b[5C\u001b[1BClasses/Domain/Model/Dto\u001b[31GD\u001b[33Gmand.php; gr\u001b[46Gp -rn 'eventEnd\\|eve…\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[11G\u001b[38;2;235;159;127mn\u001b[24G\u001b[38;2;153;153;153m72\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
