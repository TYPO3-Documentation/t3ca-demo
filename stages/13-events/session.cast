[1486.980103, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew pages:\u001b[16G\u001b[22man\u001b[19G\"Events\"\u001b[28Gpage\u001b[33Gafter\u001b[39G\"News\",\u001b[47Ghidden\u001b[54Gfrom\u001b[59Gthe\u001b[63Gmain\u001b[68Gnavigation\u001b[79Glike\u001b[84GNews,\u001b[90Gwith\u001b[95Gan\u001b[98G\"Event\"\r\u001b[4C\u001b[1Bdetail page b\u001b[19Glow it. Even\u001b[32Gs \u001b[35Gre at \u001b[38;2;177;185;249m/events/event/<event>\u001b[39m, and the breadcrumb\u001b[83Gis\u001b[86GHome\u001b[91G›\u001b[93GEvents\u001b[100G›\r\u001b[4C\u001b[1BEvent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEvents page:\u001b[22m lists every upcoming event with the same date badges as the home page. It uses a new\r\u001b[4C\u001b[1Btemplate layout, \"Events page: all upcoming events\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHome page:\u001b[22m the Events section now has an\u001b[46G\"All\u001b[51Gev\u001b[54Gnts\" link next to its heading, like \"All\u001b[95Gnews\"\u001b[101Gon\u001b[104Gthe\r\u001b[4C\u001b[1Bnews section. The e\u001b[26Gnt links go to\u001b[41Gthe\u001b[45GEvent pag\u001b[55G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEvent detail page:\u001b[22m shows \"Al\u001b[34G events\" a\u001b[45G the\u001b[50Gbottom,\u001b[58Gpointing\u001b[67Gto\u001b[70Gthe\u001b[74GEvents\u001b[81Gpage.\u001b[87GNews\u001b[92Garticles\u001b[101Gstill\r\u001b[4C\u001b[1Bshow \"All\u001b[15Gnews\".\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSearch:\u001b[22m ke_\u001b[18Garch indexed events with the news a\u001b[54Gd link\u001b[61Gd them to \u001b[72Ghe news Article page,\u001b[94Gso\u001b[97Gthe\r\u001b[4C\u001b[1Bbreadcrumb problem came back through search. A new listener, \u001b[38;2;177;185;249mClasses/Search/LinkEventsToEventPage.php\u001b[39m,\r\u001b[4C\u001b[1Bnow sends events to the Event page.\u001b[K\r\u001b[4C\u001b[1B- It re\u001b[13Gds the\u001b[20GEve\u001b[24Gt page from a new site s\u001b[49Gtting, \u001b[38;2;177;185;249mmtosafi.events.detailPage\u001b[39m (Site\u001b[88GManagement\u001b[99G>\r\u001b[5C\u001b[1B Settin\u001b[14Gs >\u001b[18GMto Safi > Events).\u001b[K\r\u001b[4C\u001b[1B- The\u001b[11Gexist\u001b[17Gng remap class\u001b[33Gdjusts that se\u001b[48Gting after the impo\u001b[68Gt, like the other page\u001b[91Gsettings.\r\u001b[4C\u001b[1B- The\u001b[11GEvent\u001b[17Gpage\u001b[22Gitself\u001b[29Gis\u001b[32Gexcluded\u001b[41Gfrom\u001b[46Gthe\u001b[50Gpage\u001b[55Gsearch,\u001b[63Glike\u001b[68GArticle.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22G\u001b[22mI restored the \u001b[38;2;177;185;249mbefore-events\u001b[39m snapshot, ran \u001b[38;2;177;185;249mseed-events.php\u001b[81G\u001b[39magain and\u001b[91Gre-exported\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata.xml\u001b[39m. It now has 33 pages and 45 content elements; the image files are unchanged. The current\r\u001b[4C\u001b[1Bstate is snapshot \u001b[38;2;177;185;249mafter-events-pages-2\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe README describes\u001b[26Gthe\u001b[30Gpages,\u001b[37Gthe\u001b[41Gsearch\u001b[48Gbehaviour\u001b[58Gand\u001b[62Gthe\u001b[66Gnew\u001b[70Gsetting.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mVerified on this installation:\u001b[34G\u001b[22mthe\u001b[38Ghome\u001b[43Gpage,\u001b[49G\u001b[38;2;177;185;249m/events\u001b[39m,\u001b[58Gtwo\u001b[62Gevent\u001b[68Gpages,\u001b[75G\u001b[38;2;177;185;249m/news\u001b[39m,\u001b[82Ga\u001b[84Gnews\u001b[89Garticle\u001b[97Gand\u001b[101Ga\r\u001b[1B \u001b[3Gsearch all return 200. The breadcrumb on an event shows Home\u001b[64G›\u001b[66GEvents\u001b[73G›\u001b[75GEvent,\u001b[82Gwith\u001b[87GEvents\u001b[94Glinking\u001b[102Gto\r\u001b[1B  \u001b[38;2;177;185;249m/events\u001b[39m. The search for \"market\" links the festive market to \u001b[38;2;177;185;249m/events/event/…\u001b[80G\u001b[39mand\u001b[84Gthe\u001b[88Gnews\u001b[93Gto\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1487.117184, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mNew pages:\u001b[16G\u001b[22man\u001b[19G\"Events\"\u001b[28Gpage\u001b[33Gafter\u001b[39G\"News\",\u001b[47Ghidden\u001b[54Gfrom\u001b[59Gthe\u001b[63Gmain\u001b[68Gnavigation\u001b[79Glike\u001b[84GNews,\u001b[90Gwith\u001b[95Gan\u001b[98G\"Event\"\r\u001b[2C\u001b[1B  detail page\u001b[17Gbelow\u001b[23Git.\u001b[27GEvents\u001b[34Gare\u001b[38Gat\u001b[41G\u001b[38;2;177;185;249m/events/event/<event>\u001b[39m,\u001b[64Gand\u001b[68Gthe\u001b[72Gbreadcrumb\u001b[83Gis\u001b[86GHome\u001b[91G›\u001b[93GEvents\u001b[100G›\r\u001b[2C\u001b[1B \u001b[5GEvent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEvents page:\u001b[22m lists every upcoming event with the same date\u001b[64Gba\u001b[67Gges as the ho\u001b[81Ge\u001b[83Gpage. It uses a new\r\u001b[4C\u001b[1Btemplate\u001b[14Glayout,\u001b[22G\"Events\u001b[30Gpage:\u001b[36Gall\u001b[40Gupcoming\u001b[49Gevents\".\r\u001b[4C\u001b[1B\u001b[1mHome page:\u001b[22m the Events section now\u001b[39Ghas an \"All events\"\u001b[59Glink\u001b[64Gnext to its heading, like \"All news\" on\u001b[104Gthe\r\u001b[4C\u001b[1Bn\u001b[7Gws section. The e\u001b[28G links go to the Event page.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mEvent detail page:\u001b[22m shows \"All\u001b[35Gevents\"\u001b[44Gt\u001b[46Gthe bottom, po\u001b[62Gti\u001b[65Gg \u001b[68Go the Events page. N\u001b[89Gws articles\u001b[101Gstill\u001b[K\r\u001b[4C\u001b[1Bshow\u001b[10G\"All news\".\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSearch:\u001b[22m ke_search indexed events with\u001b[43Gthe n\u001b[49Gws and linked them to the n\u001b[77Gws Article page, so the\u001b[101G\u001b[K\r\u001b[4C\u001b[1Bbreadcrumb problem\u001b[24Gcame\u001b[29Gback\u001b[34Gthrough\u001b[42Gsearch.\u001b[50GA\u001b[52Gnew\u001b[56Glistener,\u001b[66G\u001b[38;2;177;185;249mClasses/Search/LinkEventsToEventPage.php\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5Gnow sends ev\u001b[18Gnts to the Ev\u001b[32Gnt page.\u001b[K\r\u001b[4C\u001b[1B- It reads\u001b[16Gthe Event page from a new\u001b[43Gite setti\u001b[53Gg,\u001b[56G\u001b[38;2;177;185;249mmtosafi.event\u001b[70G.detailPage\u001b[39m (Site Management >\u001b[K\r\u001b[4C\u001b[1B  Settings > M\u001b[20Go\u001b[22GSafi >\u001b[34Gs).\u001b[K\r\u001b[6C\u001b[1BThe \u001b[12Gxi\u001b[15Gting\u001b[20Gremap\u001b[26Gclass adjusts that setting after the import, like the other page setti\u001b[97Ggs.\r\u001b[4C\u001b[1B-\u001b[7GThe Event page\u001b[22Gitself\u001b[29Gis excluded\u001b[41Gfrom\u001b[46Gthe\u001b[50Gpage\u001b[55Gsearch,\u001b[63Glike\u001b[68GArticle.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m I restored the \u001b[38;2;177;185;249mbefore-events\u001b[39m sn\u001b[54Gpshot, ran \u001b[38;2;177;185;249mseed-events.php\u001b[39m again \u001b[88Gnd\u001b[91Gr\u001b[93G-exported\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata.xml\u001b[39m. It now\u001b[22Gha\u001b[25G 33\u001b[29Gpag\u001b[33Gs an\u001b[38G 45 c\u001b[44Gntent\u001b[50Gelements; the \u001b[65Gmage f\u001b[72Gles are\u001b[80Gunchanged.\u001b[91GThe\u001b[95Gcurrent\r\u001b[2C\u001b[1B \u001b[5Gstate is snapshot \u001b[38;2;177;185;249mafter-events-pages-2\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe README describe\u001b[26Gthe pages, the search behaviour and the new\u001b[70Gsetting.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mVerified on this installation:\u001b[22m the \u001b[39Gome page, \u001b[38;2;177;185;249m/events\u001b[39m,\u001b[58Gtwo\u001b[62Gev\u001b[65Gnt pag\u001b[72Gs, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[82Ga\u001b[84Gnews\u001b[89Garticle\u001b[97Gand\u001b[101Ga\r\u001b[2C\u001b[1Bsearch\u001b[10Gall\u001b[14Greturn\u001b[21G200.\u001b[26GThe\u001b[30Gbreadcrumb\u001b[41Gon\u001b[44Gan\u001b[47Gevent\u001b[53Gshows\u001b[59GHome\u001b[64G›\u001b[66GEvents\u001b[73G›\u001b[75GEvent,\u001b[82Gwith\u001b[87GEvents\u001b[94Glinking\u001b[102Gto\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/events\u001b[39m. The search for \"market\" links the festive market to \u001b[38;2;177;185;249m/events/event/…\u001b[39m and\u001b[84Gthe news to\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/news/article/…\u001b[39m. After\u001b[26Gre-ind\u001b[33Gxing, all six\u001b[52Gs in the index point\u001b[73Gat the Even\u001b[85G pag\u001b[90G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
