[1778.495302, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe breadcrumb on a\u001b[23Gdetail\u001b[30Gpage\u001b[35Gnow\u001b[39Gends\u001b[44Gwith\u001b[49Gthe\u001b[53Gtitle\u001b[59Gof\u001b[62Gthe\u001b[66Gevent\u001b[72Gor\u001b[75Gnews\u001b[80Gitem\u001b[85Ginstead\u001b[93Gof\u001b[96G\"Event\"\u001b[104Gor\r\u001b[2C\u001b[1B\"Article\":\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEvent:\u001b[12GHome\u001b[17G›\u001b[19GEvents\u001b[26G›\u001b[28GFestive\u001b[36Gmarket\u001b[43Gat\u001b[46Gthe\u001b[50Gjetty\r\u001b[1B \u001b[3G- News: Home ›\u001b[18GNews\u001b[23G› New fish market opens at the jetty\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works:\u001b[17G\u001b[22mthe\u001b[21Gnews\u001b[26Gextension\u001b[36Galready\u001b[44Ghas\u001b[48Ga\u001b[50Gdata\u001b[55Gprocessor\u001b[65Gthat\u001b[70Gadds\u001b[75Gthe\u001b[79Gnews\u001b[84Grecord\u001b[91Gto\u001b[94Ga\u001b[96Gmenu,\u001b[102Gbut\r\u001b[2C\u001b[1Bit adds it \u001b[3mafter\u001b[23m the last item. Th\u001b[38Gt would\u001b[46Ggive Home\u001b[56G›\u001b[58GEvents\u001b[65G›\u001b[67GEvent\u001b[73G›\u001b[75GFestive\u001b[83Gmarket,\u001b[91Gwith\u001b[96G\"Event\"\r\u001b[2C\u001b[1Blinking\u001b[11Gt\u001b[13G an empty\u001b[23Gpag\u001b[27G.\u001b[29GA \u001b[32Gmall subclass,\u001b[47G\u001b[38;2;177;185;249mClasses/DataProcessing/NewsTitleInBreadcrumbProcessor.php\u001b[39m,\r\u001b[2C\u001b[1Breplaces\u001b[12Gthe\u001b[16Glast\u001b[21Gitem\u001b[26Ginstead.\u001b[35GIt's\u001b[40Gwired\u001b[46Ginto\u001b[51Gthe\u001b[55Gbreadcrumb\u001b[66Gin\u001b[69G\u001b[38;2;177;185;249msetup.typoscript\u001b[86G\u001b[39m(entry\u001b[93G\u001b[38;2;177;185;249m41\u001b[39m).\u001b[98GPages\r\u001b[2C\u001b[1Bwithout an event or articl\u001b[30G in the address keep their normal bre\u001b[68Gdcrumb.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChecked on this installation:\u001b[22m I \u001b[36Goaded both\u001b[47Gdetail pages above and got the expected breadcrumbs.\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/events\u001b[39m,\u001b[12G\u001b[38;2;177;185;249m/revenue-payments/land-rates\u001b[39m and \u001b[38;2;177;185;249m/news/article\u001b[39m without an article are unchanged.\u001b[93GThe README's\r\u001b[2C\u001b[1BNews section mentions \u001b[26Ghe new be\u001b[36Gaviou\u001b[42G. This is configu\u001b[60Gation an\u001b[69G code only,\u001b[81Gso\u001b[84G\u001b[38;2;177;185;249mdata.xml\u001b[93G\u001b[39mdoesn't\u001b[101Gneed\u001b[106Ga\r\u001b[2C\u001b[1Bnew\u001b[7Gexport.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill open from earlier: the \"Editors\" group on this installation c\u001b[71Gn't edit the eve\u001b[88Gt fields\u001b[97Gyet, and\r\u001b[2C\u001b[1Bthe fr\u001b[10Gsh-i\u001b[15Gstall proof hasn't run. Nothing is committed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 39s · done 7:38 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255m/exit\u001b[39m                                                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m*\u001b[3GEbbing… \u001b[47G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
