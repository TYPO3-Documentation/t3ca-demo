[700.951777, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1meventnews 7.2.0\u001b[22m is required in the root \u001b[38;2;177;185;249mcomposer.json\u001b[59G\u001b[39mand in the sitepackage's. Installing\u001b[96Git\u001b[99Galso\r\u001b[4C\u001b[1Badded\u001b[11Gan \u001b[38;2;177;185;249meventnews\u001b[24G\u001b[39mentry to\u001b[33G\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m. The extension has\u001b[79Gno site set,\u001b[92Gso\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msetup.typoscript\u001b[39m impor\u001b[28Gs its TypoScript. That makes\u001b[57Gevery\u001b[63Gexisting\u001b[72Gnews\u001b[77Gplugin\u001b[84Glist\u001b[89Gnews\u001b[94Gonly\u001b[99Gby\r\u001b[1B    default.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mBuild/Initialisation/seed-events.php\u001b[42G\u001b[22m\u001b[39m(new)\u001b[48Gwrites\u001b[55Gthe\u001b[59Gsix\u001b[63Gupcoming\u001b[72Gevents\u001b[79Gfrom\u001b[84Gthe\u001b[88Gdocx\u001b[93Ginto\u001b[98Gthe\u001b[102G\"News\r\u001b[1B \u001b[3G  records\" folder.\u001b[22GEach\u001b[27Ghas\u001b[31Gits\u001b[35Gstart,\u001b[42Gend,\u001b[47Gplace\u001b[53Gand\u001b[57Gcategory.\u001b[67GTime,\u001b[73Gcost\u001b[78Gand\u001b[82Gregistration\u001b[95Ggo\u001b[98Gin\u001b[101Gthe\r\u001b[1B    bo\u001b[8Gy text, b\u001b[18Gcaus\u001b[23G e\u001b[27Gntnews has\u001b[38Gno\u001b[41Gfields\u001b[48Gfor\u001b[52Gthem.\r\u001b[2C\u001b[1B-\u001b[5GIt also\u001b[13Ga\u001b[15Gds an \"Events\" plugin under the\u001b[47Gnews\u001b[52Gon the \u001b[60Gome page: events only, from today,\u001b[95Gsoonest\r\u001b[4C\u001b[1Bfirst,\u001b[12Glimit 3. An event that has started stays listed\u001b[60Guntil\u001b[66Gits\u001b[70Glast\u001b[75Gday.\r\u001b[2C\u001b[1B-\u001b[5GI left ou\u001b[15G the\u001b[20Gdocx's\u001b[27G\"Pas\u001b[32G events\". They would never be\u001b[62Gshown, and the health camp\u001b[89Gis\u001b[92Galready\u001b[100Ga\u001b[102Gnews\r\u001b[4C\u001b[1Bitem.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTemplates:\u001b[22m a new template layout \"events\" in \u001b[38;2;177;185;249mList.html\u001b[39m and a new partial \u001b[38;2;177;185;249mPartials/List/Event.html\u001b[39m.\u001b[104GA\r\u001b[4C\u001b[1Bone-day event keeps the design's \"22 / Nov\" badge; a range shows \"19 Dec –\" on the first line and\u001b[103G\"24\r\u001b[4C\u001b[1BDec\" on the second. Each title links to the detail page. There, \u001b[38;2;177;185;249mDetail.html\u001b[39m shows the date range\u001b[102Gand\r\u001b[4C\u001b[1Bthe place, and no \"All news\" link.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCSS:\u001b[22m the events list is now a grid, so all badges in the list are as wide as the widest one and\u001b[101Gline\r\u001b[4C\u001b[1Bup. \u001b[38;2;177;185;249mmain.css\u001b[39m is rebuilt; only the events rules changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdata.xml\u001b[39m:\u001b[22m re-exported and placed in \u001b[38;2;177;185;249mInitialisation/\u001b[39m. It has 6 more news records and 1 more content\r\u001b[4C\u001b[1Belement. The image files are the same 19 as b\u001b[51Gfore\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocs:\u001b[11G\u001b[22ma\u001b[13Gnew \"Ev\u001b[21Gnts\"\u001b[26Gs\u001b[28Gction in th\u001b[41Gsitepackage README, plus the\u001b[70Gseed-script li\u001b[85Gt and the\u001b[95Gexport\r\u001b[4C\u001b[1Bsteps.\u001b[12GThe roo\u001b[20G README now\u001b[32Gmen\u001b[36Gions the event\u001b[51G.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mWhat I checked on this installation\u001b[22m\u001b[K\r\u001b[1B  -\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[701.326721, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1meventnews 7.2.0\u001b[21G\u001b[22mis\u001b[24Grequired\u001b[33Gin\u001b[36Gthe\u001b[40Groot\u001b[45G\u001b[38;2;177;185;249mcomposer.json\u001b[59G\u001b[39mand\u001b[63Gin\u001b[66Gthe\u001b[70Gsitepackage's.\u001b[85GInstalling\u001b[96Git\u001b[99Galso\r\u001b[2C\u001b[1B  added an \u001b[38;2;177;185;249meventnews\u001b[24G\u001b[39mentry\u001b[30Gto\u001b[33G\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m.\u001b[61GThe\u001b[65Gextension\u001b[75Ghas\u001b[79Gno\u001b[82Gsite\u001b[87Gset,\u001b[92Gso\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249msetup.typoscript\u001b[39m imports its TypoSc\u001b[41Gip\u001b[44G. That makes every\u001b[63Gexisting n\u001b[74Gws plugin list news only\u001b[99Gby\u001b[K\r\u001b[4C\u001b[1Bdefault.\u001b[14G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mBuild/Initialisation/seed-events.php\u001b[22m\u001b[39m (new) writes th\u001b[58G six\u001b[63Gupcom\u001b[72Gevents from\u001b[84Gthe docx into the\u001b[102G\"News\r\u001b[4C\u001b[1Br\u001b[7Gcords\"\u001b[14Gfolder.\u001b[22GEach\u001b[27Ghas\u001b[31Gits\u001b[35Gstart,\u001b[42Gend,\u001b[47Gplace\u001b[53Gand\u001b[57Gcategory.\u001b[67GTime,\u001b[73Gcost\u001b[78Gand\u001b[82Gregistration\u001b[95Ggo\u001b[98Gin\u001b[101Gthe\r\u001b[2C\u001b[1B \u001b[5Gbody text, because eventnews has no fields\u001b[48Gfor them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt also adds an \"\u001b[23Gvents\" plugin under the\u001b[47Gnews on the home page: \u001b[71Gvent\u001b[76G only, from today,\u001b[95Gs\u001b[97Gones\u001b[102G\u001b[K\r\u001b[4C\u001b[1Bfirst, limit 3. An\u001b[29G that has starte\u001b[46G stays listed\u001b[60Guntil\u001b[66Gits\u001b[70Glast\u001b[75Gday.\r\u001b[5C\u001b[1B left out the docx's \"Past events\". They\u001b[47Gwould \u001b[54Gever\u001b[59Gbe shown, and the\u001b[77Ghealth ca\u001b[87Gp is already a news\r\u001b[4C\u001b[1Bitem.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTemplates:\u001b[16G\u001b[22ma new template layout \"events\"\u001b[47Gin \u001b[38;2;177;185;249mList.html\u001b[39m and a \u001b[67Gew par\u001b[74Gial \u001b[38;2;177;185;249mPartials/List/Event.html\u001b[39m. A\u001b[K\r\u001b[4C\u001b[1Bon\u001b[8G-day\u001b[13Gevent\u001b[19Gkeeps\u001b[25Gthe\u001b[29Gdesign's\u001b[38G\"22\u001b[42G/\u001b[44GNov\"\u001b[49Gbadge;\u001b[56Ga\u001b[58Grange\u001b[64Gshows\u001b[70G\"19\u001b[74GDec\u001b[78G–\"\u001b[81Gon\u001b[84Gthe\u001b[88Gfirst\u001b[94Gline\u001b[99Gand\u001b[103G\"24\r\u001b[2C\u001b[1B \u001b[5GDec\" on the second. Each title links to the detail page. There, \u001b[38;2;177;185;249mDetail.html\u001b[39m shows the date range and\r\u001b[4C\u001b[1Bth\u001b[8G plac\u001b[14G, and no \"All new\u001b[32G\" link.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCSS:\u001b[10G\u001b[22mthe events list is now a gr\u001b[38Gd, so all badges in the\u001b[62Glist are as wide as the wid\u001b[90Gst one \u001b[99Gd li\u001b[104Ge\r\u001b[4C\u001b[1Bup.\u001b[9G\u001b[38;2;177;185;249mmain.css\u001b[39m is rebui\u001b[27Gt; only the events\u001b[46Grules\u001b[52Gchanged.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mdata.xml\u001b[39m:\u001b[22m r\u001b[17G-exported and pl\u001b[34Gced in\u001b[41G\u001b[38;2;177;185;249mInitialisation/\u001b[39m.\u001b[58GIt has 6\u001b[67Gmore ne\u001b[75Gs records and 1 more co\u001b[99Gtent\u001b[K\r\u001b[4C\u001b[1Belement. The\u001b[19Gmag\u001b[23G f\u001b[27Ges\u001b[30Gare the sam\u001b[42G 19\u001b[46Gas before.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mDocs:\u001b[22m a new \"Events\" section in the\u001b[41Gsitepackage README,\u001b[61Gplus the seed-\u001b[76Gc\u001b[78Gipt list and\u001b[91Gthe export\u001b[K\r\u001b[4C\u001b[1Bst\u001b[8Gps. The root README now mentions the events.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked on this installation\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Ghome\u001b[14Gpage\u001b[19Gshows\u001b[25G22\u001b[28GNov,\u001b[33G5\u001b[35GDec\u001b[39Gand\u001b[43G12\u001b[46GDec.\u001b[51GThe\u001b[55G15\u001b[58GNov\u001b[62Gbeach\u001b[68Gclean-up\u001b[77Gis\u001b[80Galready\u001b[88Gpast\u001b[93Gand\u001b[97Gcorrectly\r\u001b[2C\u001b[1B  drops out.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[701.478506, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gadded an \u001b[38;2;177;185;249meventnews\u001b[24G\u001b[39mentry to\u001b[33G\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m. The ext\u001b[69Gn\u001b[72Gon has no \u001b[83Gite \u001b[88Get, so\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msetup.typoscript\u001b[39m imports\u001b[30Gits TypoScript. That makes every \u001b[64Gxis\u001b[68Gi\u001b[70Gg news plugin list new\u001b[93G only\u001b[99Gby\r\u001b[4C\u001b[1Bdefault.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mBuild/Initialisation/seed-events.php\u001b[42G\u001b[22m\u001b[39m(new)\u001b[48Gwrites\u001b[55Gthe\u001b[59Gsix\u001b[63Gupcoming\u001b[72Gevents\u001b[79Gfrom\u001b[84Gthe\u001b[88Gdocx\u001b[93Ginto\u001b[98Gthe\u001b[102G\"News\r\u001b[2C\u001b[1B \u001b[5Grecords\" folder. Each has its start,\u001b[42Ge\u001b[44Gd, place and category. T\u001b[69Gme, cos\u001b[77G and registration g\u001b[98Gin the\u001b[K\r\u001b[4C\u001b[1Bbody text, because eventnews has no fields for them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt also adds an \"Ev\u001b[25Gnts\" plugin u\u001b[39Gder the news\u001b[52Gon the\u001b[59Ghome\u001b[64Gpage:\u001b[70Gevents\u001b[77Gonly,\u001b[83Gfrom\u001b[88Gtoday,\u001b[95Gsoonest\r\u001b[2C\u001b[1B \u001b[5Gfirst, limit 3.\u001b[21GAn \u001b[25Gvent\u001b[30Gthat has star\u001b[44Ged\u001b[47Gstays list\u001b[58Gd until its\u001b[70Glast day.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI left\u001b[12Gout \u001b[17Ghe docx's \"Past events\". Th\u001b[45Gy\u001b[47Gwould\u001b[53Gnever be shown, and \u001b[74Ghe health\u001b[84Gcamp\u001b[89Gis\u001b[92Galready\u001b[100Ga\u001b[102Gnews\r\u001b[2C\u001b[1B \u001b[5Gitem.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTemplates:\u001b[16G\u001b[22ma\u001b[18Gnew\u001b[22Gtemplate\u001b[31Glayout\u001b[38G\"events\"\u001b[47Gin\u001b[50G\u001b[38;2;177;185;249mList.html\u001b[60G\u001b[39mand\u001b[64Ga\u001b[66Gnew\u001b[70Gpartial\u001b[78G\u001b[38;2;177;185;249mPartials/List/Event.html\u001b[39m.\u001b[104GA\r\u001b[2C\u001b[1B \u001b[5Gone-day event keeps the design's\u001b[39G22 / Nov\" badge; a range\u001b[64Gshows\u001b[70G\"19 Dec\u001b[78G–\" on the first line and \"24\r\u001b[4C\u001b[1BDec\" on\u001b[13Gth\u001b[16G second.\u001b[25GEach title links\u001b[42Gto the\u001b[49Gdetail\u001b[56Gpage. There, \u001b[38;2;177;185;249mDetail.html\u001b[81G\u001b[39mshows the date range and\u001b[K\r\u001b[4C\u001b[1Bthe place, and no \"All news\" link.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCSS:\u001b[22m the eve\u001b[18Gts list is now a grid,\u001b[41Gso\u001b[44Gall\u001b[48Gbadges\u001b[55Gin\u001b[58Gthe\u001b[62Glist\u001b[67Gare\u001b[71Gas\u001b[74Gwide\u001b[79Gas\u001b[82Gthe\u001b[86Gwidest\u001b[93Gone\u001b[97Gand\u001b[101Gline\r\u001b[2C\u001b[1B \u001b[5Gup. \u001b[38;2;177;185;249mmain.css\u001b[39m i\u001b[21Grebuilt; \u001b[31Gnly\u001b[35Gthe events rules changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdata.xml\u001b[39m:\u001b[22m re-exported and p\u001b[33Gaced in \u001b[38;2;177;185;249mInitialisation/\u001b[39m. It\u001b[61Ghas\u001b[65G6\u001b[67Gmore\u001b[72Gnews\u001b[77Grecords\u001b[85Gand\u001b[89G1\u001b[91Gmore\u001b[96Gcontent\r\u001b[2C\u001b[1B \u001b[5Gelement. Th\u001b[17G image files are the\u001b[38Gsame 19 as before.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocs:\u001b[22m a new \"Events\" s\u001b[28Gction\u001b[34Gin the sitep\u001b[47Gckage README,\u001b[61Gplus\u001b[66Gthe\u001b[70Gseed-script\u001b[82Glist\u001b[87Gand\u001b[91Gthe\u001b[95Gexport\r\u001b[2C\u001b[1B \u001b[5Gsteps. Th\u001b[15G root README now mentions\u001b[41Gthe events.\u001b[53G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked on this installation\r\u001b[2C\u001b[1B\u001b[22m- The home page shows 22 Nov, 5 Dec\u001b[39Gand\u001b[43G12\u001b[46GDec.\u001b[51GThe\u001b[55G15\u001b[58GNov\u001b[62Gbeach\u001b[68Gclean-up\u001b[77Gis\u001b[80Galready\u001b[88Gpast\u001b[93Gand\u001b[97Gcorrectly\r\u001b[2C\u001b[1B \u001b[5Gdrops out.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe news on\u001b[17Gthe\u001b[21Ghome\u001b[26Gpage\u001b[31Gand\u001b[35Gthe\u001b[39Gnews\u001b[44Glist\u001b[49Gpage\u001b[54Gshow\u001b[59Gno\u001b[62Gevents.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[702.077887, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249msetup.typoscript\u001b[39m imports\u001b[30Gits TypoScript. That makes every \u001b[64Gxis\u001b[68Gi\u001b[70Gg news plugin list new\u001b[93G only\u001b[99Gby\r\u001b[4C\u001b[1Bdefault.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mBuild/Initialisation/seed-events.php\u001b[42G\u001b[22m\u001b[39m(new)\u001b[48Gwrites\u001b[55Gthe\u001b[59Gsix\u001b[63Gupcoming\u001b[72Gevents\u001b[79Gfrom\u001b[84Gthe\u001b[88Gdocx\u001b[93Ginto\u001b[98Gthe\u001b[102G\"News\r\u001b[2C\u001b[1B \u001b[5Grecords\" folder. Each has its start,\u001b[42Ge\u001b[44Gd, place and category. T\u001b[69Gme, cos\u001b[77G and registration g\u001b[98Gin the\u001b[K\r\u001b[4C\u001b[1Bbody text, because eventnews has no fields for them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt also adds an \"Ev\u001b[25Gnts\" plugin u\u001b[39Gder the news\u001b[52Gon the\u001b[59Ghome\u001b[64Gpage:\u001b[70Gevents\u001b[77Gonly,\u001b[83Gfrom\u001b[88Gtoday,\u001b[95Gsoonest\r\u001b[2C\u001b[1B \u001b[5Gfirst, limit 3.\u001b[21GAn \u001b[25Gvent\u001b[30Gthat has star\u001b[44Ged\u001b[47Gstays list\u001b[58Gd until its\u001b[70Glast day.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI left\u001b[12Gout \u001b[17Ghe docx's \"Past events\". Th\u001b[45Gy\u001b[47Gwould\u001b[53Gnever be shown, and \u001b[74Ghe health\u001b[84Gcamp\u001b[89Gis\u001b[92Galready\u001b[100Ga\u001b[102Gnews\r\u001b[2C\u001b[1B \u001b[5Gitem.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTemplates:\u001b[16G\u001b[22ma\u001b[18Gnew\u001b[22Gtemplate\u001b[31Glayout\u001b[38G\"events\"\u001b[47Gin\u001b[50G\u001b[38;2;177;185;249mList.html\u001b[60G\u001b[39mand\u001b[64Ga\u001b[66Gnew\u001b[70Gpartial\u001b[78G\u001b[38;2;177;185;249mPartials/List/Event.html\u001b[39m.\u001b[104GA\r\u001b[2C\u001b[1B \u001b[5Gone-day event keeps the design's\u001b[39G22 / Nov\" badge; a range\u001b[64Gshows\u001b[70G\"19 Dec\u001b[78G–\" on the first line and \"24\r\u001b[4C\u001b[1BDec\" on\u001b[13Gth\u001b[16G second.\u001b[25GEach title links\u001b[42Gto the\u001b[49Gdetail\u001b[56Gpage. There, \u001b[38;2;177;185;249mDetail.html\u001b[81G\u001b[39mshows the date range and\u001b[K\r\u001b[4C\u001b[1Bthe place, and no \"All news\" link.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCSS:\u001b[22m the eve\u001b[18Gts list is now a grid,\u001b[41Gso\u001b[44Gall\u001b[48Gbadges\u001b[55Gin\u001b[58Gthe\u001b[62Glist\u001b[67Gare\u001b[71Gas\u001b[74Gwide\u001b[79Gas\u001b[82Gthe\u001b[86Gwidest\u001b[93Gone\u001b[97Gand\u001b[101Gline\r\u001b[2C\u001b[1B \u001b[5Gup. \u001b[38;2;177;185;249mmain.css\u001b[39m i\u001b[21Grebuilt; \u001b[31Gnly\u001b[35Gthe events rules changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdata.xml\u001b[39m:\u001b[22m re-exported and p\u001b[33Gaced in \u001b[38;2;177;185;249mInitialisation/\u001b[39m. It\u001b[61Ghas\u001b[65G6\u001b[67Gmore\u001b[72Gnews\u001b[77Grecords\u001b[85Gand\u001b[89G1\u001b[91Gmore\u001b[96Gcontent\r\u001b[2C\u001b[1B \u001b[5Gelement. Th\u001b[17G image files are the\u001b[38Gsame 19 as before.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocs:\u001b[22m a new \"Events\" s\u001b[28Gction\u001b[34Gin the sitep\u001b[47Gckage README,\u001b[61Gplus\u001b[66Gthe\u001b[70Gseed-script\u001b[82Glist\u001b[87Gand\u001b[91Gthe\u001b[95Gexport\r\u001b[2C\u001b[1B \u001b[5Gsteps. Th\u001b[15G root README now mentions\u001b[41Gthe events.\u001b[53G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked on this installation\r\u001b[2C\u001b[1B\u001b[22m- The home page shows 22 Nov, 5 Dec\u001b[39Gand\u001b[43G12\u001b[46GDec.\u001b[51GThe\u001b[55G15\u001b[58GNov\u001b[62Gbeach\u001b[68Gclean-up\u001b[77Gis\u001b[80Galready\u001b[88Gpast\u001b[93Gand\u001b[97Gcorrectly\r\u001b[2C\u001b[1B \u001b[5Gdrops out.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe news on\u001b[17Gthe\u001b[21Ghome\u001b[26Gpage\u001b[31Gand\u001b[35Gthe\u001b[39Gnews\u001b[44Glist\u001b[49Gpage\u001b[54Gshow\u001b[59Gno\u001b[62Gevents.\r\u001b[4C\u001b[1BWith the\u001b[14Glimit rais\u001b[25Gd to 6, bo\u001b[37G range\u001b[44Gbadges r\u001b[53Gnder.\u001b[59GScr\u001b[63Genshots\u001b[71Gat\u001b[74G1280\u001b[79Gand\u001b[83G375\u001b[87Gpx\u001b[90Glook\u001b[95Gright.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[702.375062, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25BWith\u001b[10G\"today\"\u001b[18Gtemporarily\u001b[30Gset\u001b[34Gto\u001b[37G1\u001b[39GFeb\u001b[43G2027,\u001b[49Gthe\u001b[53Glist\u001b[58Gshowed\u001b[65Gonly\u001b[70Gthe\u001b[74Gland\u001b[79Grates\u001b[85Ghelp\u001b[90Gdesk\u001b[95G(18\u001b[99GJan\u001b[103G–\u001b[105G31\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[702.527746, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mBuild/Initialisation/seed-events.php\u001b[22m\u001b[39m (new) writes th\u001b[58G six\u001b[63Gupcom\u001b[72Gevents from\u001b[84Gthe docx into the\u001b[102G\"News\r\u001b[4C\u001b[1Br\u001b[7Gcords\"\u001b[14Gfolder.\u001b[22GEach\u001b[27Ghas\u001b[31Gits\u001b[35Gstart,\u001b[42Gend,\u001b[47Gplace\u001b[53Gand\u001b[57Gcategory.\u001b[67GTime,\u001b[73Gcost\u001b[78Gand\u001b[82Gregistration\u001b[95Ggo\u001b[98Gin\u001b[101Gthe\r\u001b[2C\u001b[1B \u001b[5Gbody text, because eventnews has no fields\u001b[48Gfor them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt also adds an \"\u001b[23Gvents\" plugin under the\u001b[47Gnews on the home page: \u001b[71Gvent\u001b[76G only, from today,\u001b[95Gs\u001b[97Gones\u001b[102G\u001b[K\r\u001b[4C\u001b[1Bfirst, limit 3. An\u001b[29G that has starte\u001b[46G stays listed\u001b[60Guntil\u001b[66Gits\u001b[70Glast\u001b[75Gday.\r\u001b[5C\u001b[1B left out the docx's \"Past events\". They\u001b[47Gwould \u001b[54Gever\u001b[59Gbe shown, and the\u001b[77Ghealth ca\u001b[87Gp is already a news\r\u001b[4C\u001b[1Bitem.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTemplates:\u001b[16G\u001b[22ma new template layout \"events\"\u001b[47Gin \u001b[38;2;177;185;249mList.html\u001b[39m and a \u001b[67Gew par\u001b[74Gial \u001b[38;2;177;185;249mPartials/List/Event.html\u001b[39m. A\u001b[K\r\u001b[4C\u001b[1Bon\u001b[8G-day\u001b[13Gevent\u001b[19Gkeeps\u001b[25Gthe\u001b[29Gdesign's\u001b[38G\"22\u001b[42G/\u001b[44GNov\"\u001b[49Gbadge;\u001b[56Ga\u001b[58Grange\u001b[64Gshows\u001b[70G\"19\u001b[74GDec\u001b[78G–\"\u001b[81Gon\u001b[84Gthe\u001b[88Gfirst\u001b[94Gline\u001b[99Gand\u001b[103G\"24\r\u001b[2C\u001b[1B \u001b[5GDec\" on the second. Each title links to the detail page. There, \u001b[38;2;177;185;249mDetail.html\u001b[39m shows the date range and\r\u001b[4C\u001b[1Bth\u001b[8G plac\u001b[14G, and no \"All new\u001b[32G\" link.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCSS:\u001b[10G\u001b[22mthe events list is now a gr\u001b[38Gd, so all badges in the\u001b[62Glist are as wide as the wid\u001b[90Gst one \u001b[99Gd li\u001b[104Ge\r\u001b[4C\u001b[1Bup.\u001b[9G\u001b[38;2;177;185;249mmain.css\u001b[39m is rebui\u001b[27Gt; only the events\u001b[46Grules\u001b[52Gchanged.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mdata.xml\u001b[39m:\u001b[22m r\u001b[17G-exported and pl\u001b[34Gced in\u001b[41G\u001b[38;2;177;185;249mInitialisation/\u001b[39m.\u001b[58GIt has 6\u001b[67Gmore ne\u001b[75Gs records and 1 more co\u001b[99Gtent\u001b[K\r\u001b[4C\u001b[1Belement. The\u001b[19Gmag\u001b[23G f\u001b[27Ges\u001b[30Gare the sam\u001b[42G 19\u001b[46Gas before.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mDocs:\u001b[22m a new \"Events\" section in the\u001b[41Gsitepackage README,\u001b[61Gplus the seed-\u001b[76Gc\u001b[78Gipt list and\u001b[91Gthe export\u001b[K\r\u001b[4C\u001b[1Bst\u001b[8Gps. The root README now mentions the events.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked on this installation\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Ghome\u001b[14Gpage\u001b[19Gshows\u001b[25G22\u001b[28GNov,\u001b[33G5\u001b[35GDec\u001b[39Gand\u001b[43G12\u001b[46GDec.\u001b[51GThe\u001b[55G15\u001b[58GNov\u001b[62Gbeach\u001b[68Gclean-up\u001b[77Gis\u001b[80Galready\u001b[88Gpast\u001b[93Gand\u001b[97Gcorrectly\r\u001b[2C\u001b[1B  drops out.\u001b[K\r\u001b[8C\u001b[1Bnews\u001b[14Gon the home page and\u001b[35Gthe\u001b[39Gnews list page show no\u001b[62Gevents.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWith the limit\u001b[20Graised\u001b[27Gto\u001b[30G6,\u001b[33Gboth\u001b[38Grange\u001b[44Gbadges\u001b[51Grender.\u001b[59GScreenshots\u001b[71Gat\u001b[74G1280\u001b[79Gand\u001b[83G375\u001b[87Gpx\u001b[90Glook\u001b[95Gright.\r\u001b[4C\u001b[1BWith \"today\" t\u001b[20Gmp\u001b[23Grarily set to 1\u001b[39GF\u001b[41Gb 2027,\u001b[49Gthe list sh\u001b[61Gw\u001b[63Gd only\u001b[70Gthe\u001b[74Gland\u001b[79Grates\u001b[85Ghelp\u001b[90Gdesk\u001b[95G(18\u001b[99GJan\u001b[103G–\u001b[105G31\r\u001b[2C\u001b[1B \u001b[5GMar), so\u001b[14Ga running \u001b[25Gvent\u001b[30Gstays listed.\u001b[44G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
