[1102.833064, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  · Where should the registration button of the two events point? The docx names offices but no email \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153maddresses, and the site only has info@mtosafi.example and report@mtosafi.example. → Market fees page \r\u001b[5C\u001b[1B+ Contact (Recommended)\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m· Shou\u001b[13Gd\u001b[15Gthe button text be fixed or set per event? The festive market registration is for traders \r\u001b[5C\u001b[1Bapplying for a stall, not visitors signing up. → Per event, default Register (Recommended)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m· Where should the button show? → Detail page only (Recommended)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pat\u001b[22Gern, ran \u001b[1m3\u001b[22m shell\u001b[39Gcommands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm adding a link field and an optional button text to the event form, and the sitepackage will extend\r\u001b[2C\u001b[1Bthe news model to expose them to the templates. The detail page will then show the button.\u001b[38;2;153;153;153m · summary\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWriting\u001b[11Gthe\u001b[15GTCA\u001b[19Goverride,\u001b[29Gthe\u001b[33Gmodel\u001b[39Gextension,\u001b[50Gthe\u001b[54Glabels\u001b[61Gand\u001b[65Gthe\u001b[69Gregistration\u001b[82Gin\u001b[85G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m sh\u001b[17Gl command…\u001b[28G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ mkdir -p Classes/Domain/Model && cat > Configuration/TCA/Overrides/tx_news_domain_model_news.php \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m<<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m<?php\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mdeclare(strict_types=1);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153muse TYPO3\\CMS\\Core\\Utility\\ExtensionManagementUtility;\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mdefined('TYPO3') or die();…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
