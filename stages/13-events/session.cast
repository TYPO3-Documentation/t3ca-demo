[1281.427286, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOpen points\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mEditors on this installation can't see the event fields yet.\u001b[22m The \"Editors\" group here\u001b[91Gwas\u001b[95Gcreated\u001b[K\r\u001b[2C\u001b[1B  before eventnews\u001b[22Gwas installed,\u001b[37Gso\u001b[40Git\u001b[43Gallows\u001b[50Gnone\u001b[55Gof\u001b[58Gthe\u001b[62Gnew\u001b[66Gfields:\u001b[74Gneither\u001b[82G\"Is\u001b[86Gevent\"\u001b[93Gnor\u001b[97Gthe\r\u001b[4C\u001b[1Bregistration\u001b[18Gfields.\u001b[26GOn\u001b[29Ga\u001b[31Gfresh\u001b[37Ginstall\u001b[45Gthe\u001b[49Ggroup\u001b[55Gis\u001b[58Gcreated\u001b[66Gafter\u001b[72Gthe\u001b[76Gfields\u001b[83Gexist\u001b[89Gand\u001b[93Ggets\u001b[98Gthem\r\u001b[2C\u001b[1B  automatically.\u001b[20GHere,\u001b[26Gsomeone\u001b[34Ghas\u001b[38Gto\u001b[41Gtick\u001b[46Gthem\u001b[51Gin\u001b[54Gthe\u001b[58Ggroup\u001b[64G(System\u001b[72G>\u001b[74GBackend\u001b[82Gusers),\u001b[90Gor\u001b[93GI\u001b[95Gcan\u001b[99Gadd\u001b[103Gthem\r\u001b[2C\u001b[1B \u001b[5Gfor you.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe fresh-install proof still hasn't run.\u001b[22m The new\u001b[55G\u001b[38;2;177;185;249mdata.xml\u001b[39m hasn't bee\u001b[75G \u001b[77Gmpo\u001b[81Gted anywhere yet. It\u001b[102Gneeds\r\u001b[4C\u001b[1Bthe dat\u001b[13Gbase\u001b[18Gemptied, which auto mode blocked earl\u001b[56Ger, so it's your call. The\u001b[83Gfull fresh-in\u001b[97Gtall\u001b[K\r\u001b[4C\u001b[1Bsteps are in the \u001b[23Goot README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mI haven't opened the event form in the backend.\u001b[53G\u001b[22mI\u001b[55Gchecked\u001b[63Gthe\u001b[67Gdatabase\u001b[76Gcolumns,\u001b[85Gthe\u001b[89Gexport\u001b[96Gand\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gfrontend, but not how the fields look in the ev\u001b[53Gnt form.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Gis committed. Should I show\u001b[39Gyou\u001b[43Gthe\u001b[47Gdiff\u001b[52Gand\u001b[56Ga\u001b[58Gcommit\u001b[65Gmessage?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 2m 54s · done 7:32 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mthe events are on the news page and when you use de breadcrumb you only see news not events\u001b[39m             \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage && cat \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mConfiguration/Sets/Sitepackage/route-enhancers.yaml; grep -rn \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m\"route-enhancers\\|routeEnhancers\\|imports\" Configuration/Sets/Sitepackage/*.yaml \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m../../config/sites/main/config.yaml Initialisation/Site/main/config.y…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
