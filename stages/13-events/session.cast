[58.316296, "o", "\u001b[?25l\u001b[H\u001b[3Gsource\u001b[10Gdocument.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIn the design:\u001b[20G\u001b[22m\u001b[38;2;177;185;249mdesign/index.html:127-134\u001b[46G\u001b[39mhas\u001b[50Gan\u001b[53G\"Events\"\u001b[62Gsection\u001b[70Gon\u001b[73Gthe\u001b[77Ghome\u001b[82Gpage,\u001b[88Gright\u001b[94Gbelow\u001b[100Gthe\r\u001b[1B \u001b[3G  news cards.\u001b[17GIt's a\u001b[24G\u001b[38;2;177;185;249m<ul class=\"events\">\u001b[39m with\u001b[51Gree hard-coded entries (15 Nov beach\u001b[88Gclean-up, 22 Nov\r\u001b[2C\u001b[1B  budget forum, 5\u001b[21GDec\u001b[25Gjob\u001b[29Gfair).\u001b[36GEach\u001b[41Gentry\u001b[47Ghas\u001b[51Ga\u001b[53Gdate\u001b[58Gbadge.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe styling is already in the sitepackage:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_\u001b[24Gtepackage/Resources/Private/Scss/_components.scss:200\u001b[39m defines \u001b[38;2;177;185;249m.events\u001b[94G\u001b[39mand\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m.events__date\u001b[39m, and\u001b[24Gthat compiles into \u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m.\u001b[74G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe source data:\u001b[22m the \"Events\" part of \u001b[38;2;177;185;249mdesign/docs/news-and-events.docx\u001b[39m,\u001b[77Gafter\u001b[83Gthe\u001b[87Gnews\u001b[92Gentries.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat's missing:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNo Fluid template,\u001b[24GTypoS\u001b[30Gri\u001b[33Gt or\u001b[38Gsi\u001b[41Ge\u001b[43Gset in the sitepackage uses \u001b[38;2;177;185;249mevents\u001b[39m.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m contains no event records.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9GREADME's\u001b[18Ginitial-content\u001b[34Gsection\u001b[42Gonly\u001b[47Gsays\u001b[52Gthe\u001b[56Gnews\u001b[61Gwas\u001b[65Gimported\u001b[74G(list\u001b[80Gpage,\u001b[86Gdetail\u001b[93Gpage,\u001b[99Gnews\r\u001b[2C\u001b[1B  folder, home page\u001b[23Gplugins).\u001b[33GIt\u001b[36Gdoesn't\u001b[44Gmention\u001b[52Gevents.\r\u001b[4C\u001b[1BThere's no even\u001b[21Gs extension in \u001b[38;2;177;185;249mcomposer.json\u001b[39m, only \u001b[38;2;177;185;249mgeorgringer/news\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo the news from the do\u001b[27Gx was carried over,\u001b[47Gbut the ev\u001b[58Gnts weren't. If\u001b[74Gyou want them on the home page\u001b[105Gas\r\u001b[2C\u001b[1Bin the design,\u001b[18Gone way is to store them as \u001b[47Gews r\u001b[53Gcord\u001b[58G in\u001b[62Gtheir\u001b[68Gown\u001b[72Gcategory\u001b[81Gand\u001b[85Gadd\u001b[89Ga\u001b[91Gsecond\u001b[98Gnews\r\u001b[2C\u001b[1Bplugin under\u001b[16Gth\u001b[19G news on the home page. Should I prepare that?\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 22s · done 7:12 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhat technique should we use to display them?\u001b[39m                                                           \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✻\u001b[3GUnraveling… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
