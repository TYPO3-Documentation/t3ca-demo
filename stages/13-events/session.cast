[69.703431, "o", "\u001b[?25l\u001b[H\u001b[5Gnews cards. It's a \u001b[38;2;177;185;249m<ul class=\"events\">\u001b[39m wit\u001b[48G three hard-coded\u001b[66Gentries\u001b[74G(15\u001b[78GNov\u001b[82Gbeach\u001b[88Gclean-up,\u001b[98G22\u001b[101GNov\r\u001b[2C\u001b[1B \u001b[5Gbudget forum, 5 Dec job fair). Each entry has\u001b[51Ga\u001b[53Gdate\u001b[58Gbadge.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe styling is already in the sitepackage:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Resources/Privat\u001b[51G/Scss/_\u001b[59Gomponents\u001b[69Gsc\u001b[72Gs:200\u001b[78G\u001b[39mdefines\u001b[86G\u001b[38;2;177;185;249m.events\u001b[94G\u001b[39mand\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m.events__date\u001b[39m, and that compiles into\u001b[43G\u001b[38;2;177;185;249mR\u001b[46Gources/Public/Css/mai\u001b[68G.css\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe source data:\u001b[22G\u001b[22mthe\u001b[26G\"Events\"\u001b[35Gpart\u001b[40Gof\u001b[43G\u001b[38;2;177;185;249mdesign/docs/news-and-events.docx\u001b[39m,\u001b[77Gafter\u001b[83Gthe\u001b[87Gnews\u001b[92Gentries.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat's m\u001b[12Gssing:\u001b[K\r\u001b[4C\u001b[1BNo Fluid template, TypoS\u001b[30Gript or\u001b[38Gsit\u001b[42G se\u001b[47Gin the sitepackage\u001b[66Guses\u001b[71G\u001b[38;2;177;185;249mevents\u001b[39m.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m co\u001b[33Gains n\u001b[40G event\u001b[47Grecords.\u001b[56G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe README's\u001b[18Ginitia\u001b[25G-co\u001b[29Gtent sectio\u001b[41G only says\u001b[52Gth\u001b[55G news\u001b[61Gwas\u001b[65Gimported\u001b[74G(list\u001b[80Gpage,\u001b[86Gdetail\u001b[93Gpage,\u001b[99Gnews\r\u001b[2C\u001b[1B \u001b[5Gfold\u001b[10Gr,\u001b[13Gh\u001b[15Gm\u001b[17G page\u001b[23Gplugins).\u001b[33GIt\u001b[36Gdoesn't mention events.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThere's\u001b[13Gno\u001b[16Gevents\u001b[23Gextension\u001b[33Gin\u001b[36G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[51Gonly\u001b[56G\u001b[38;2;177;185;249mgeorgringer/news\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[10Gn\u001b[12Gws from the docx\u001b[29Gwas ca\u001b[36Gried over, but\u001b[51Gthe events\u001b[62Gweren't. If you want them on\u001b[91Gthe home page\u001b[105Gas\r\u001b[2C\u001b[1Bin the\u001b[10Gdesign, one \u001b[23Gay is to\u001b[32Gstore th\u001b[41Gm\u001b[43Gas news records in their\u001b[68Gown\u001b[72Gcategory\u001b[81Gand\u001b[85Gadd\u001b[89Ga\u001b[91Gsecond\u001b[98Gnews\r\u001b[2C\u001b[1Bplugin\u001b[10Gunder\u001b[16Gthe\u001b[20Gnews\u001b[25Gon\u001b[28Gthe\u001b[32Ghome\u001b[37Gpage.\u001b[43GShould\u001b[50GI\u001b[52Gprepare\u001b[60Gthat?\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 22s · done 7:12 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhat technique should we use to display them?\u001b[39m                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Calling typo3-dev-companion \u001b[1m2\u001b[22m times, running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \"event calendar\"\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
