[1778.240421, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[23B\u001b[38;2;177;185;249m\u001b[1mt\u001b[50Gt\r\u001b[11C\u001b[1B\u001b[39mex\u001b[22m\u001b[38;2;153;153;153mt\u001b[16Gns\u001b[39m\u001b[1mi\u001b[22m\u001b[38;2;153;153;153mon-documen\u001b[39m\u001b[1mt\u001b[22m\u001b[38;2;153;153;153mation \u001b[47GC\u001b[49Geate, update or r\u001b[67Gview documentation for a TYPO3 project\r\u001b[46C\u001b[1Bor \u001b[51Gxtension: Documentation/ manuals, README, configurati\r\u001b[5C\u001b[1Bcontext\u001b[47GShow what fills\u001b[63Gthe\u001b[67Gcontext\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;177;185;249m/exit\u001b[39m\u001b[31;1H\u001b[29;8H\u001b[?25h"]
