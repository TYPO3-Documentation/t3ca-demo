[156.653844, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gthen set to leave events out, so the two lis\u001b[52Gstay\u001b[57Gseparate.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOn the\u001b[10Ghome pag\u001b[19G, a\u001b[23Gsecond\u001b[30Gnews\u001b[35Gplugin\u001b[42Gunder the\u001b[52Gnews, set to upcoming\u001b[74Gevents\u001b[81Gwith\u001b[86Ga\u001b[88Glimit\u001b[94Gof\u001b[97G3,\u001b[100Grenders\r\u001b[2C\u001b[1Bthrough\u001b[11Ga\u001b[13Gsmall\u001b[19GFluid\u001b[25Gtemplate\u001b[34Goverride.\u001b[44GThat\u001b[49Gtemplate\u001b[58Goutputs\u001b[66Gthe\u001b[70Gdesign's\u001b[79G\u001b[38;2;177;185;249m<ul class=\"events\">\u001b[99G\u001b[39mwith\r\u001b[2C\u001b[1Bthe \u001b[38;2;177;185;249mevents__date\u001b[39m b\u001b[22Gdg\u001b[25G, and the\u001b[35GSCSS for it is alr\u001b[54Gady\u001b[58Gin the\u001b[65Gsitepackage.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo\u001b[7Galternatives\u001b[20GI'\u001b[23G rule ou\u001b[32G:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlain news with an \"Events\" category:\u001b[43G\u001b[22mno\u001b[46Gend\u001b[50Gdate,\u001b[56Gno\u001b[59Glocation,\u001b[69Gand\u001b[73Gshowing\u001b[81Gfuture\u001b[88Gdates\u001b[94Gin\u001b[97Gdate\u001b[102Gorder\r\u001b[2C\u001b[1B  wou\u001b[9Gd take workarounds.\u001b[29G\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mlochmueller/calendarize\u001b[39m (15.1.0, TYPO3 14 compatible):\u001b[22m a separate event model with\u001b[88Grecurre\u001b[96Gce and\u001b[K\r\u001b[4C\u001b[1Bcalendar views. That'\u001b[27G more\u001b[33Gthan\u001b[38Gsix\u001b[42Gone-off\u001b[50Gevents\u001b[57Gneed,\u001b[63Gand\u001b[67Geditors\u001b[75Gwould\u001b[81Ghave\u001b[86Gto\u001b[89Glearn\u001b[95Ga\u001b[97Gsecond\r\u001b[2C\u001b[1B \u001b[5Gsystem.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne thing\u001b[13GI\u001b[15Gstill\u001b[21Gneed\u001b[26Gto\u001b[29Gcheck\u001b[35Gbefore\u001b[42Gbuilding:\u001b[52Gthe\u001b[56Gexact\u001b[62Gplugin\u001b[69Gsetting\u001b[77Gnames\u001b[83Gin\u001b[86Geventnews\u001b[96G7.2\u001b[100Gfor\r\u001b[2C\u001b[1B\"upcoming\u001b[13Gonly\"\u001b[19Gand\u001b[23G\"exclude\u001b[32Gevents\".\u001b[41GI'll\u001b[46Gread\u001b[51Gthem\u001b[56Gfrom\u001b[61Gthe\u001b[65Gpackage\u001b[73Gonce\u001b[78Git's\u001b[83Ginstalled.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I g\u001b[14G ahead? That means adding the pack\u001b[49Gge, \u001b[54Gxtending \u001b[38;2;177;185;249mseed-news.php\u001b[39m w\u001b[80Gh the events from\u001b[98Gthe\u001b[102Gdocx,\r\u001b[2C\u001b[1Bre-exporting\u001b[16G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[26Gand\u001b[30Gadding\u001b[37Gthe\u001b[41Ghome\u001b[46Gpage\u001b[51Gplugin\u001b[58Gand\u001b[62Gtemplate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 30s · done 7:13 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mis it still actively maintained?\u001b[39m                                                                        \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m \u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
