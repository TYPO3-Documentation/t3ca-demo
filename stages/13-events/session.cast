[279.345462, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat to keep in mind:\u001b[22m work comes\u001b[37Gn\u001b[39Gbu\u001b[42Gsts, and \u001b[52Gverything depends on one maintainer. That's the same\u001b[K\r\u001b[2C\u001b[1Brisk you already take with \u001b[38;2;177;185;249mgeorgringer/news\u001b[39m,\u001b[48Gand event\u001b[58Gews tends to get its update soon after\u001b[97Gnews\r\u001b[2C\u001b[1Bsupports\u001b[12Ga\u001b[14Gnew\u001b[18GTYPO3\u001b[24Gversion.\u001b[33GIf\u001b[36Git\u001b[39Gwere\u001b[44Gabandoned,\u001b[55Gthe\u001b[59Gevents\u001b[66Gwould\u001b[72Gstill\u001b[78Gbe\u001b[81Gordinary\u001b[90Gnews\u001b[95Grecords\u001b[103Gwith\r\u001b[2C\u001b[1Ba few extra column\u001b[22G, so moving them to pl\u001b[45Gin news or\u001b[56Ganother\u001b[64Gextension\u001b[74Gwould\u001b[80Gbe\u001b[83Gmanageable.\r\u001b[2B \u001b[3GMy recommendation stands. Should\u001b[36GI\u001b[38Ggo\u001b[41Gahead\u001b[47Gwith\u001b[52Git?\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mBaked for 12s · done 7:14 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhat happens if we have events spanning multiple days?\u001b[39m                                                  \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gread\u001b[10Gthe\u001b[14Gquery\u001b[20Gcode\u001b[25Gof\u001b[28Geventnews\u001b[38G7.2.0\u001b[44Gto\u001b[47Gcheck\u001b[53Gthis.\u001b[59GMulti-day\u001b[69Gevents\u001b[76Gare\u001b[80Ghandled\u001b[88Gproperly.\u001b[98GYou'd\r\u001b[2C\u001b[1Bonly need to adjust\u001b[23Gthe\u001b[27Gtemplate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's stored\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[8G start goes in the normal\u001b[34Gnews\u001b[39Gdate\u001b[44Gfield\u001b[50G(\u001b[38;2;177;185;249mdatetime\u001b[39m).\r\u001b[4C\u001b[1Bev\u001b[8Gntnews adds \u001b[38;2;177;185;249mevent_end\u001b[39m, a date-and-time field, and a \"full day\" checkbox. These fields\u001b[94Gonly\u001b[99Gappear\r\u001b[4C\u001b[1Bwhen\u001b[10G\"is\u001b[14Gevent\"\u001b[21Gis\u001b[24Gticked.\r\u001b[2C\u001b[1B- The festive market becomes\u001b[32Gone\u001b[36Grecord:\u001b[44Gstart\u001b[50G19\u001b[53GDec\u001b[57G2026\u001b[62G16:00,\u001b[69Gend\u001b[73G24\u001b[76GDec\u001b[80G2026\u001b[85G22:00.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhich list it shows up in\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUpcoming events list:\u001b[22m for an events-only plugin, eventnews replaces the news time\u001b[87Grestric\u001b[95Gion with\u001b[K\r\u001b[4C\u001b[1B\"end \u001b[11Gate is still to\u001b[27Gcome, or \u001b[38Gar\u001b[70G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
