[1279.399278, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat I checked:\u001b[22m the\u001b[23Gfestive market page shows \"Apply for a\u001b[62Gstall\"\u001b[69Glinking\u001b[77Gto\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/revenue-payments/market-fees\u001b[39m,\u001b[34Gand\u001b[38Gthe\u001b[42Gjob\u001b[46Gfair\u001b[51Gpage\u001b[56Gshows\u001b[62G\"Register\"\u001b[73Glinking\u001b[81Gto\u001b[84G\u001b[38;2;177;185;249m/contact\u001b[39m.\u001b[94GEvents\r\u001b[2C\u001b[1Bwithout a link get no button, and the home page list\u001b[56Gstill\u001b[63Ghows the next\u001b[78Ghree\u001b[83Gevents.\u001b[91GThe\u001b[95Gscreenshot\r\u001b[2C\u001b[1Bof the detail page looks right.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOpen points\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEditors on this installation can't see the event fields yet.\u001b[66G\u001b[22mThe\u001b[70G\"Editors\"\u001b[80Ggroup\u001b[86Ghere\u001b[91Gwas\u001b[95Gcreated\r\u001b[2C\u001b[1B  before eventnews\u001b[22Gwas\u001b[26Ginstalled,\u001b[37Gso\u001b[40Git\u001b[43Gallows\u001b[50Gnone\u001b[55Gof\u001b[58Gthe\u001b[62Gnew\u001b[66Gfields:\u001b[74Gneither\u001b[82G\"Is\u001b[86Gevent\"\u001b[93Gnor\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gregistration fields. On a fresh install the group is created\u001b[66Gafter the fields exist and gets th\u001b[101Gm\r\u001b[4C\u001b[1Baut\u001b[9Gmatically. Here,\u001b[26Gsomeone has to \u001b[42Gick them i\u001b[53G the\u001b[58Ggroup (System >\u001b[74GBackend\u001b[82Gusers), or\u001b[93GI can add\u001b[103Gthem\r\u001b[4C\u001b[1Bfor you.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe fresh-install proof still hasn't run.\u001b[22m The\u001b[51Gnew \u001b[38;2;177;185;249mdata.xml\u001b[64G\u001b[39mhasn't been imported anywhe\u001b[92Ge yet.\u001b[99GIt needs\r\u001b[4C\u001b[1Bthe\u001b[9Gdatabase\u001b[18Gemptied,\u001b[27Gwhich\u001b[33Gauto\u001b[38Gmode\u001b[43Gblocked\u001b[51Gearlier,\u001b[60Gso\u001b[63Git's\u001b[68Gyour\u001b[73Gcall.\u001b[79GThe\u001b[83Gfull\u001b[88Gfresh-install\r\u001b[2C\u001b[1B \u001b[5Gsteps are in the root README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mI haven't opened the event form in the backend.\u001b[22m I checked\u001b[63Gthe database columns, the export and the\r\u001b[4C\u001b[1Bfrontend,\u001b[15Gbut not h\u001b[25Gw\u001b[27Gthe fields\u001b[38Glook\u001b[43Gin\u001b[46Gthe\u001b[50Gevent\u001b[56Gform.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothi\u001b[9Gg is committed. Should I show y\u001b[41Gu\u001b[43Gthe diff a\u001b[54Gd\u001b[56Ga commit\u001b[65Gmessage?\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 2m 54s · done 7:32 PM\u001b[39G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mthe events are on the news page and when you use de breadcrumb you only see news not events\u001b[39m             \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m*\u001b[3GMetamorphosi\u001b[38;2;235;159;127mng…\u001b[38;2;215;119;87m \u001b[21G\u001b[38;2;153;153;153m3\u001b[41Gthought for 12s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
