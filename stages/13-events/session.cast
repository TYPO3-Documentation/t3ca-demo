[1005.482452, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7GFestive\u001b[15Gmarket\u001b[22G(traders\u001b[31Gapply\u001b[37Gfor\u001b[41Ga\u001b[43Gstall):\u001b[51G\"Trade\u001b[58G&\u001b[60Gtourism\"\u001b[69G(\u001b[38;2;177;185;249m/trade-tourism\u001b[39m)\u001b[86Gor\u001b[89G\"Market\u001b[97Gfees\"\r\u001b[2C\u001b[1B  \u001b[6G (\u001b[38;2;177;185;249m/revenue-payments/market-fees\u001b[39m).\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GJob\u001b[11Gfair\u001b[16G(registration\u001b[30Gat\u001b[33Gthe\u001b[37GEducation\u001b[47GOffice):\u001b[56Gthere's\u001b[64Gno\u001b[67Geducation\u001b[77Gpage.\u001b[83G\"Contact\"\u001b[93G(\u001b[38;2;177;185;249m/contact\u001b[39m)\u001b[104Gis\r\u001b[2C\u001b[1B \u001b[5G  the nearest\u001b[19Gfit.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEmail addresses:\u001b[22G\u001b[22mthe site\u001b[31Gonly uses\u001b[41G\u001b[38;2;177;185;249minfo@mtosafi.example\u001b[39m (Contact page) and \u001b[38;2;177;185;249mreport@mtosafi.example\r\u001b[4C\u001b[1B\u001b[39m(\"Report a problem\"). The docx gives\u001b[42Gphone\u001b[48Gnumbers\u001b[56Gfor\u001b[60Gthe\u001b[64Goffices\u001b[72Gbut\u001b[76Gno\u001b[79Gemail\u001b[85Gaddresses.\u001b[96GI\u001b[98Gwouldn't\r\u001b[4C\u001b[1Binvent \u001b[13Gddresses for the\u001b[30GEducation Off\u001b[44Gce\u001b[47Gor th\u001b[53G Trad\u001b[59G & Markets Off\u001b[74Gce, because the municipality ha\r\u001b[4C\u001b[1Bto supply those.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo ways \u001b[13Go do it:\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mA link in the text (recommended):\u001b[40G\u001b[22mfor\u001b[44Gexample\u001b[52G\"Registration:\u001b[67GRecommended,\u001b[80Gat\u001b[83Gthe\u001b[87GEducation\u001b[97GOffice\r\u001b[5C\u001b[1B(…)\".\u001b[12GThe\u001b[16Gseed\u001b[21Gscript\u001b[28Gwrites\u001b[35Git\u001b[38Gthe\u001b[42Gway\u001b[46Gthe\u001b[50Gtext\u001b[55Geditor\u001b[62Gwould.\u001b[69GEach\u001b[74Gevent\u001b[80Gcan\u001b[84Guse\u001b[88Gwhatever\u001b[97Gfits,\u001b[103Gand\r\u001b[2C\u001b[1B   no template\u001b[18Gchange\u001b[25Gis\u001b[28Gneeded.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA separate registration link field\u001b[41G\u001b[22mshown\u001b[47Gas\u001b[50Ga\u001b[52Gbutton\u001b[59G(\"Register\")\u001b[72Gon\u001b[75Gthe\u001b[79Gdetail\u001b[86Gpage\u001b[91Gand\u001b[95Gmaybe\u001b[101Gin\u001b[104Gthe\r\u001b[2C\u001b[1B  \u001b[6Glist. That looks tidier, but eventnews h\u001b[47Gs no\u001b[52Gsuch field. The sitepackage\u001b[80Gwould have to add a column\r\u001b[5C\u001b[1Bto the n\u001b[15Gw\u001b[17G table and\u001b[28Grend\u001b[33Gr\u001b[37G. That's\u001b[46Gonly worth \u001b[59G if most events will\u001b[80Gh\u001b[82Gve r\u001b[87Ggistration.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTell me where the two registration lines should poin\u001b[56G, for \u001b[63Gxample \"market → Market fe\u001b[90Gs page, job fair\u001b[K\r\u001b[2C\u001b[1B→\u001b[5Ginfo@mtos\u001b[15Gfi.example\", and I'll add the\u001b[45Glinks to t\u001b[56Ge s\u001b[60Ge\u001b[62G and re-ex\u001b[73Gort \u001b[38;2;177;185;249mdata.xml\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 19s · done 7:27 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255moption 2 sounds good\u001b[39m                                                                                    \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✶\u001b[3G\u001b[38;2;235;159;127mCo\u001b[38;2;215;119;87mncocting… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
