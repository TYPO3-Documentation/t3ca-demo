[1203.633597, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m. Templa\u001b[31Ges can then\u001b[43Guse \u001b[38;2;177;185;249mregistrationLink\u001b[39m and \u001b[38;2;177;185;249mregistrationLabel\u001b[39m. I checked\u001b[97Gthat the\u001b[K\r\u001b[4C\u001b[1Bgen\u001b[9Grated class contains both getters.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe button:\u001b[22m \u001b[38;2;177;185;249mDetail.html\u001b[39m shows \u001b[36G \u001b[38;2;177;185;249mbutton\u001b[39m-\u001b[45Gtyled link when an\u001b[64Gevent has a registration\u001b[89Glink. The\u001b[K\r\u001b[4C\u001b[1B\"Regis\u001b[13Gr\" text\u001b[21Gis in \u001b[38;2;177;185;249mfrontend.xlf\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSe\u001b[8Gd and export:\u001b[22m \u001b[38;2;177;185;249mseed-events.php\u001b[39m now sets these targets, as you c\u001b[71Go\u001b[73Ge:\u001b[76G\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mFestive market:\u001b[22m l\u001b[26Gks to the \"Market\u001b[44Gfees\"\u001b[50Gpage,\u001b[56Gbutton\u001b[63Gtext\u001b[68G\"Apply\u001b[75Gfor\u001b[79Ga\u001b[81Gstall\".\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mJob fair:\u001b[22m links to the \"Contact\" pag\u001b[44G wi\u001b[49G the default\u001b[62G\"Register\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Grestored the \u001b[38;2;177;185;249mbefore-events\u001b[39m snapshot,\u001b[44Gran the s\u001b[54Ged agai\u001b[63Gand re-exported\u001b[79G\u001b[38;2;177;185;249mdata.xml\u001b[89G\u001b[39mThe\u001b[93Gtwo\u001b[97Gpage\u001b[102Glinks\r\u001b[4C\u001b[1Bare exported as \u001b[22Goft\u001b[26Greferences, so th\u001b[45Gimpor\u001b[51G will point them at the\u001b[75Gnew\u001b[79Gpage\u001b[84Guids.\u001b[90GThe\u001b[94Gstate\u001b[100Gafter\r\u001b[2C\u001b[1B \u001b[5Gthis run is saved as snapshot \u001b[38;2;177;185;249mafter-events-registration\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[22m the\u001b[23G