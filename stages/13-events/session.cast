[315.625503, "o", "\u001b[?25l\u001b[H\u001b[5G2026:\u001b[11Gbefore,\u001b[19Ga January to March event sh\u001b[47Gwe\u001b[51Gup in January\u001b[65Gonly.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mEvents without\u001b[20Gan end date\u001b[22m o\u001b[34Gly us\u001b[40G the start date. Once\u001b[62Gthat time\u001b[72Ghas passed, they drop \u001b[95Gff.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you'd have to build yourself\u001b[37G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDisplay:\u001b[14G\u001b[22mthe\u001b[18Gnews\u001b[23Glist\u001b[28Gand\u001b[32Gdetail\u001b[39Gtemplates\u001b[49Gdon't\u001b[55Gshow\u001b[60G\u001b[38;2;177;185;249meventEnd\u001b[69G\u001b[39mat\u001b[72Gall.\u001b[77GOnly\u001b[82Geventnews'\u001b[93Gown\u001b[97Gmonth\r\u001b[2C\u001b[1B  template does. Our home page template\u001b[43Goverride\u001b[52Ghas\u001b[56Gto\u001b[59Goutput\u001b[66Gthe\u001b[70Grange,\u001b[77Gfor\u001b[81Gexample\u001b[89G\"19–24\u001b[96GDec\".\u001b[102GThe\r\u001b[2C\u001b[1B \u001b[5Gdesign's\u001b[14Gdate badge (\u001b[38;2;177;185;249m.events__date\u001b[39m, a fix\u001b[47Gd\u001b[49G4rem width) only has room for a single day.\u001b[93GIt needs a\r\u001b[4C\u001b[1Brange variant,\u001b[20Gfo\u001b[24Gexample \"19 Dec – 24 Dec\" on two lines, or a wider badge. That's\u001b[89Ga decision for the\r\u001b[10C\u001b[1B.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRepeating opening hours:\u001b[22m there's no field for something like the help\u001b[75Gdesk's\u001b[82G\"Monday to Friday,\u001b[K\r\u001b[4C\u001b[1B9:00–15:00\".\u001b[18Geventnews\u001b[28Ghas\u001b[32Gone\u001b[36Gstart\u001b[42Gand\u001b[46Gone\u001b[50Gend\u001b[54Gand\u001b[58Gno\u001b[61Grecurrence.\u001b[73GThat\u001b[78Gtext\u001b[83Ggoes\u001b[88Gin\u001b[91Gthe\u001b[95Gteaser\u001b[102Gor\r\u001b[2C\u001b[1B \u001b[5Gbody text. If you ever need \u001b[35Gal\u001b[38Grecurring events with separa\u001b[67Ge dates, that's when calendarize would\r\u001b[4C\u001b[1Bbe worth it\u001b[18GFor \u001b[23Gh\u001b[25G events in\u001b[36Gthe docx,\u001b[46Gstart and end a\u001b[63G enough.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSorting:\u001b[22m the list\u001b[23Gis sort\u001b[33Gby start date in ascend\u001b[57Gng\u001b[60Gorde\u001b[65G. An ev\u001b[73Gnt\u001b[83Galready running\u001b[K\r\u001b[4C\u001b[1Btherefore appea\u001b[21Gs above events\u001b[38Gat start l\u001b[49Gter. For a\u001b[60G\"what's on\"\u001b[72Glist\u001b[77Gthat's\u001b[84Gusually\u001b[92Gwhat\u001b[97Gyou\u001b[101Gwant.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I go\u001b[16Ghead on that\u001b[29Gbasis?\u001b[36GBefore I build the template, I'd \u001b[70Geed one choice from \u001b[91Gou: how the date\r\u001b[2C\u001b[1Bbadge\u001b[9Gshould\u001b[16Gshow\u001b[21Ga\u001b[23Grange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 26s · done 7:16 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mgo ahead, show the range on two lines in the badge\u001b[39m                                                      \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[39m Calling typo3-dev-companion…\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mKneading…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
