b[38;2;117;113;94mnews.php)\u001b[38;2;248;248;242m                                                                                \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m18\u001b[11G\u001b[38;2;117;113;94m// reach the news model through the class extension of EXT:news, see Classes/Domain/Model\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[12G\u001b[38;2;117;113;94mNews.p\u001b[19Gp.\u001b[38;2;248;248;242m                                                                               \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m19\u001b[11G\u001b[38;2;248;248;242m$GLOBALS[\u001b[38;2;230;219;116m'TYPO3_CONF_VARS'\u001b[38;2;248;248;242m][\u001b[38;2;230;219;116m'EXT'\u001b[38;2;248;248;242m][\u001b[38;2;230;219;116m'news'\u001b[38;2;248;248;242m][\u001b[38;2;230;219;116m'classes'\u001b[38;2;248;248;242m][\u001b[38;2;230;219;116m'Domain/Model/News'\u001b[38;2;248;248;242m][]\u001b[88G=\u001b[90G\u001b[38;2;230;219;116m'mtosafi_s\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;230;219;116mitepackage'\u001b[38;2;248;248;242m;                                                                \u001b[88G \u001b[90G          \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mChecking\u001b[12Gcolumns\u001b[20Gand\u001b[24Gschema\u001b[31Gcommands\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ddev mysql -N -e \"SHOW COLUMNS FROM tx_news_domain_model_news\" | grep -iE \"mtosafi|registr\"; ddev \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mexec 'v\u001b[14Gndor/bi\u001b[22G/typo3 list 2>/dev/null | grep -iE \"\u001b[59Gchema|dat\u001b[69Gbase|upgrade\"'\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
