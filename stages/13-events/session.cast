[278.235512, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhich l\u001b[11Gst\u001b[14Git shows up in\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUpcoming events list:\u001b[27G\u001b[22mf\u001b[29Gr an events-only plugin, eventnews replaces\u001b[73Gthe\u001b[77Gnews\u001b[82Gtime\u001b[87Grestriction\u001b[99Gwith\r\u001b[4C\u001b[1B\"end date is still to come, or start date is still to come\"\u001b[K\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249mClasses/EventListener/ModifyDemandRepositoryEventListener.php\u001b[39m, around line 133). An event that has\r\u001b[4C\u001b[1Balready \u001b[14Gtarted stays\u001b[27Gin t\u001b[32Ge\u001b[34Glist u\u001b[41Gtil\u001b[45Git ends. The \"Land rates help\u001b[75Gdesk\"\u001b[81G(18\u001b[85GJan\u001b[89Gto\u001b[92G31\u001b[95GMar 2027)\r\u001b[2C\u001b[1B \u001b[5Gstays visible through\u001b[27GMarch. Pl\u001b[37Gin news would drop it\u001b[59Gon\u001b[62G18 January.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMonth and year views:\u001b[22m an event appears\u001b[44Gin every mo\u001b[56Gth it overlaps.\u001b[72GThat's\u001b[79Gthe\u001b[83G#198\u001b[88Gfix\u001b[92Gfrom\u001b[97GAugust\r\u001b[2C\u001b[1B \u001b[5G2026: before, a January to\u001b[32GMarch event showed\u001b[51Gup in\u001b[57GJanuary only.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEvents without an end date\u001b[32G\u001b[22monly\u001b[37Guse\u001b[41Gthe\u001b[45Gstart\u001b[51Gdate.\u001b[57GOnce\u001b[62Gthat\u001b[67Gtime\u001b[72Ghas\u001b[76Gpassed,\u001b[84Gthey\u001b[89Gdrop\u001b[94Goff.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you'd have to build yourself\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDisplay:\u001b[14G\u001b[22mth\u001b[17G news list and de\u001b[35Gail templates \u001b[50Gon't sh\u001b[58Gw \u001b[38;2;177;185;249meventEnd\u001b[39m at all.\u001b[77GOnly eventnews' own month\u001b[K\r\u001b[4C\u001b[1Bt\u001b[7Gmplate\u001b[15Goes. Our home page template\u001b[43Goverride has to output\u001b[66Gthe\u001b[71Gange, for\u001b[81Gexample \"19–24\u001b[96GD\u001b[98Gc\".\u001b[102GThe\r\u001b[4C\u001b[1Bdesign's d\u001b[16Gte badge (\u001b[38;2;177;185;249m.events__date\u001b[39m, a fix\u001b[47Gd 4rem \u001b[55Gidth) only h\u001b[68Gs room\u001b[75Gfor a single d\u001b[90Gy. It needs a\u001b[104G\u001b[K\r\u001b[4C\u001b[1Brange variant,\u001b[20Gfor\u001b[24Gexample\u001b[32G\"19\u001b[36GDec\u001b[40G–\u001b[42G24\u001b[45GDec\"\u001b[50Gon\u001b[53Gtwo\u001b[57Glines,\u001b[64Gor\u001b[67Ga\u001b[69Gwider\u001b[75Gbadge.\u001b[82GThat's\u001b[89Ga\u001b[91Gdecision\u001b[100Gfor\u001b[104Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRepeating opening hours:\u001b[22m ther\u001b[35G'\u001b[37G no field for somethi\u001b[59Gg\u001b[61Glike the help desk's \"M\u001b[85Gnday to Frid\u001b[98Gy,\u001b[K\r\u001b[4C\u001b[1B9:00–15:00\". eventnews\u001b[28Ghas on\u001b[35G start and on\u001b[49G \u001b[52Gd and no recurr\u001b[68Gnce. Tha\u001b[77G text\u001b[83Ggo\u001b[86Gs\u001b[88Gin the teaser or\u001b[K\r\u001b[5C\u001b[1Body text. If you ever need\u001b[33Greal recurring events with\u001b[60Gseparate dates,\u001b[76Gthat's\u001b[83Gwhen\u001b[88Gcalendarize\u001b[100Gwould\r\u001b[2C\u001b[1B \u001b[5Gbe worth\u001b[14Git.\u001b[18GFor the\u001b[26Gevents\u001b[33Gin\u001b[36Gthe docx, start and e\u001b[58Gd\u001b[60Ga\u001b[62Ge enough.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSorting:\u001b[22m the list\u001b[23Gis sorted by\u001b[36Gst\u001b[39Grt d\u001b[44Gte\u001b[47Gin ascending\u001b[60Gorder. An event that's alre\u001b[88Gdy running\u001b[K\r\u001b[4C\u001b[1Btherefore\u001b[15Gappears\u001b[23Gabove\u001b[29Gevents\u001b[36Gthat\u001b[41Gstart\u001b[47Glater.\u001b[54GFor\u001b[58Ga\u001b[60G\"what's\u001b[68Gon\"\u001b[72Glist\u001b[77Gthat's\u001b[84Gusually\u001b[92Gwhat\u001b[97Gyou\u001b[101Gwant.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I go ahead\u001b[21Gon that basis?\u001b[36GBefore\u001b[43GI\u001b[45Gbuild\u001b[51Gthe\u001b[55Gtemplate,\u001b[65GI'd\u001b[69Gneed\u001b[74Gone\u001b[78Gchoice\u001b[85Gfrom\u001b[90Gyou:\u001b[95Ghow\u001b[99Gthe\u001b[103Gdate\r\u001b[2C\u001b[1Bbadge\u001b[9Gshould\u001b[16Gshow\u001b[21Ga\u001b[23Grange.\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[278.249856, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ What happens if we have events spanning multiple days?\u001b[39m                                                  \r\u001b[2C\u001b[1B\u001b[49m\u001b[1mWhich l\u001b[11Gst\u001b[14Git shows up in\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUpcoming events list:\u001b[27G\u001b[22mf\u001b[29Gr an events-only plugin, eventnews replaces\u001b[73Gthe\u001b[77Gnews\u001b[82Gtime\u001b[87Grestriction\u001b[99Gwith\r\u001b[4C\u001b[1B\"end date is still to come, or start date is still to come\"\u001b[K\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249mClasses/EventListener/ModifyDemandRepositoryEventListener.php\u001b[39m, around line 133). An event that has\r\u001b[4C\u001b[1Balready \u001b[14Gtarted stays\u001b[27Gin t\u001b[32Ge\u001b[34Glist u\u001b[41Gtil\u001b[45Git ends. The \"Land rates help\u001b[75Gdesk\"\u001b[81G(18\u001b[85GJan\u001b[89Gto\u001b[92G31\u001b[95GMar 2027)\r\u001b[2C\u001b[1B \u001b[5Gstays visible through\u001b[27GMarch. Pl\u001b[37Gin news would drop it\u001b[59Gon\u001b[62G18 January.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMonth and year views:\u001b[22m an event appears\u001b[44Gin every mo\u001b[56Gth it overlaps.\u001b[72GThat's\u001b[79Gthe\u001b[83G#198\u001b[88Gfix\u001b[92Gfrom\u001b[97GAugust\r\u001b[2C\u001b[1B \u001b[5G2026: before, a January to\u001b[32GMarch event showed\u001b[51Gup in\u001b[57GJanuary only.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEvents without an end date\u001b[32G\u001b[22monly\u001b[37Guse\u001b[41Gthe\u001b[45Gstart\u001b[51Gdate.\u001b[57GOnce\u001b[62Gthat\u001b[67Gtime\u001b[72Ghas\u001b[76Gpassed,\u001b[84Gthey\u001b[89Gdrop\u001b[94Goff.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you'd have to build yourself\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDisplay:\u001b[14G\u001b[22mth\u001b[17G news list and de\u001b[35Gail templates \u001b[50Gon't sh\u001b[58Gw \u001b[38;2;177;185;249meventEnd\u001b[39m at all.\u001b[77GOnly eventnews' own month\u001b[K\r\u001b[4C\u001b[1Bt\u001b[7Gmplate\u001b[15Goes. Our home page template\u001b[43Goverride has to output\u001b[66Gthe\u001b[71Gange, for\u001b[81Gexample \"19–24\u001b[96GD\u001b[98Gc\".\u001b[102GThe\r\u001b[4C\u001b[1Bdesign's d\u001b[16Gte badge (\u001b[38;2;177;185;249m.events__date\u001b[39m, a fix\u001b[47Gd 4rem \u001b[55Gidth) only h\u001b[68Gs room\u001b[75Gfor a single d\u001b[90Gy. It needs a\u001b[104G\u001b[K\r\u001b[4C\u001b[1Brange variant,\u001b[20Gfor\u001b[24Gexample\u001b[32G\"19\u001b[36GDec\u001b[40G–\u001b[42G24\u001b[45GDec\"\u001b[50Gon\u001b[53Gtwo\u001b[57Glines,\u001b[64Gor\u001b[67Ga\u001b[69Gwider\u001b[75Gbadge.\u001b[82GThat's\u001b[89Ga\u001b[91Gdecision\u001b[100Gfor\u001b[104Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRepeating opening hours:\u001b[22m ther\u001b[35G'\u001b[37G no field for somethi\u001b[59Gg\u001b[61Glike the help desk's \"M\u001b[85Gnday to Frid\u001b[98Gy,\u001b[K\r\u001b[4C\u001b[1B9:00–15:00\". eventnews\u001b[28Ghas on\u001b[35G start and on\u001b[49G \u001b[52Gd and no recurr\u001b[68Gnce. Tha\u001b[77G text\u001b[83Ggo\u001b[86Gs\u001b[88Gin the teaser or\u001b[K\r\u001b[5C\u001b[1Body text. If you ever need\u001b[33Greal recurring events with\u001b[60Gseparate dates,\u001b[76Gthat's\u001b[83Gwhen\u001b[88Gcalendarize\u001b[100Gwould\r\u001b[2C\u001b[1B \u001b[5Gbe worth\u001b[14Git.\u001b[18GFor the\u001b[26Gevents\u001b[33Gin\u001b[36Gthe docx, start and e\u001b[58Gd\u001b[60Ga\u001b[62Ge enough.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSorting:\u001b[22m the list\u001b[23Gis sorted by\u001b[36Gst\u001b[39Grt d\u001b[44Gte\u001b[47Gin ascending\u001b[60Gorder. An event that's alre\u001b[88Gdy running\u001b[K\r\u001b[4C\u001b[1Btherefore\u001b[15Gappears\u001b[23Gabove\u001b[29Gevents\u001b[36Gthat\u001b[41Gstart\u001b[47Glater.\u001b[54GFor\u001b[58Ga\u001b[60G\"what's\u001b[68Gon\"\u001b[72Glist\u001b[77Gthat's\u001b[84Gusually\u001b[92Gwhat\u001b[97Gyou\u001b[101Gwant.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I go ahead\u001b[21Gon that basis?\u001b[36GBefore\u001b[43GI\u001b[45Gbuild\u001b[51Gthe\u001b[55Gtemplate,\u001b[65GI'd\u001b[69Gneed\u001b[74Gone\u001b[78Gchoice\u001b[85Gfrom\u001b[90Gyou:\u001b[95Ghow\u001b[99Gthe\u001b[103Gdate\r\u001b[2C\u001b[1Bbadge\u001b[9Gshould\u001b[16Gshow\u001b[21Ga\u001b[23Grange.\u001b[40G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
