3;153m❯ \u001b[38;2;255;255;255mis it still actively maintained?\u001b[39m                                                                        \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ gh api repos/georgringer/eventnews --jq '{archived,pushed_at,open_issues_count,stargazers_count}' ;\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mgh api 'repos/georgringer/eventnews/commits?per_page=10' --jq '.[]|.commit.author.date[:10]+\" \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m\"+.commit.author.name+\": \"+(.commit.message|split(\"\\n\")[0])'; echo ---; gh api \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m'repos/georgringer/event…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
