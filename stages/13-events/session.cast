[91.798318, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Blocation and an organizer.\u001b[32GTwo of the docx events span sev\u001b[64Gral days (\"Festiv\u001b[82G market\u001b[90Gat the jetty\",\r\u001b[4C\u001b[1B19–24\u001b[11GDec, and \"Land\u001b[26Grates help desk\", Jan–Mar), so they \u001b[63Geed a real \u001b[75Gnd dat\u001b[82G. Plain news records\u001b[K\r\u001b[4C\u001b[1Bcan't store one. The\u001b[26Gdocx\u001b[31Galso\u001b[36Glists\u001b[42GCost\u001b[47Gand\u001b[51GRegistration,\u001b[65Gwhich\u001b[71Ghave\u001b[76Gno\u001b[79Gfield.\u001b[86GThose\u001b[92Gcan\u001b[96Ggo\u001b[99Gin\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gteaser or body text.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt reuses what's already set up.\u001b[22m Editors\u001b[46Gke\u001b[49Gp wo\u001b[54Gking with news\u001b[69Gr\u001b[71Gcords in\u001b[84G\"N\u001b[87Gws records\" folder.\r\u001b[4C\u001b[1BThe news \u001b[15Getail page, \u001b[28Ghe categ\u001b[38Gies and\u001b[46Gthe search\u001b[57Gindexer\u001b[65Gfor\u001b[69Gnews\u001b[74Gcover\u001b[80Gthe\u001b[84Gevents\u001b[91Gas\u001b[94Gwell.\u001b[100GYou\r\u001b[2C\u001b[1B \u001b[5Gdon't need a second data model or plugin s\u001b[48Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPast events drop off by themselves.\u001b[22m The events list can show upcoming\u001b[75Gev\u001b[78Gnts only, sorted by start\r\u001b[4C\u001b[1Bdate, so\u001b[15Ghe \"Past events\" part of the docx needs no manu\u001b[63Gl handling.\u001b[75GThe\u001b[79Ghome\u001b[84Gpage\u001b[89Gnews\u001b[94Gplugin\u001b[101Gis\r\u001b[4C\u001b[1Bthen\u001b[10Gset\u001b[14Gto\u001b[17Gleave\u001b[23Gevents\u001b[30Gout,\u001b[35Gso\u001b[38Gthe\u001b[42Gtwo\u001b[46Glists\u001b[52Gstay\u001b[57Gseparate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOn the home page, a second news plug\u001b[40Gn under th\u001b[51G news,\u001b[58Gse\u001b[61G to upcoming events with a limit of 3, renders\r\u001b[4C\u001b[1Brough a small Fluid templa\u001b[32Ge override.\u001b[44GThat templ\u001b[55Gte\u001b[58Goutputs th\u001b[69G desi\u001b[75Gn's\u001b[79G\u001b[38;2;177;185;249m<ul class=\"events\">\u001b[99G\u001b[39mwith\r\u001b[2C\u001b[1Bthe\u001b[7G\u001b[38;2;177;185;249mevents__date\u001b[20G\u001b[39mbadge,\u001b[27Gand\u001b[31Gthe\u001b[35GSCSS\u001b[40Gfor\u001b[44Git\u001b[47Gis\u001b[50Galready\u001b[58Gin\u001b[61Gthe\u001b[65Gsitepackage.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo alternatives I'd rule out:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlain news with an \"Events\" category:\u001b[43G\u001b[22mno\u001b[46Gend\u001b[50Gdate,\u001b[56Gno\u001b[59Glocation,\u001b[69Gand\u001b[73Gshowing\u001b[81Gfuture\u001b[88Gdates\u001b[94Gin\u001b[97Gdate\u001b[102Gorder\r\u001b[2C\u001b[1B \u001b[5Gwould take workarounds.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mlochmueller/calendarize\u001b[39m (15.1.0, TYPO3 14 compatible):\u001b[22m a separate event mo\u001b[80Gel with recu\u001b[93Grence and\u001b[K\r\u001b[4C\u001b[1Bcalendar\u001b[14Gviews.\u001b[21GThat's\u001b[28Gmore\u001b[33Gthan\u001b[38Gsix\u001b[42Gone-off\u001b[50Gevents\u001b[57Gneed,\u001b[63Gand\u001b[67Geditors\u001b[75Gwould\u001b[81Ghave\u001b[86Gto\u001b[89Glearn\u001b[95Ga\u001b[97Gsecond\r\u001b[4C\u001b[1Bsystem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne th\u001b[13GI still need to check before building: the\u001b[56Gexact plugin setti\u001b[75Gg name\u001b[85G eventnews\u001b[96G7.2\u001b[100Gfor\r\u001b[2C\u001b[1B\"upcoming\u001b[13Gonly\"\u001b[19Gand\u001b[23G\"exclude\u001b[32Gevents\".\u001b[41GI'll\u001b[46Gread\u001b[51Gthem\u001b[56Gfrom\u001b[61Gthe\u001b[65Gpackage\u001b[73Gonce\u001b[78Git's\u001b[83Ginstalled.\r\u001b[2C\u001b[1B      \u001b[10G \u001b[12G  \u001b[15G      \u001b[22G    \u001b[27G     \u001b[33G      \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[91.870501, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe events fit its fields.\u001b[32G\u001b[22mA news\u001b[39Grecord gets an \"is event\" switch,\u001b[73Gan \u001b[77Gnd date, a full-day\u001b[97Gflag, a\r\u001b[4C\u001b[1Blocation and an organizer.\u001b[32GTwo of the docx events span sev\u001b[64Gral days (\"Festiv\u001b[82G market\u001b[90Gat the jetty\",\r\u001b[4C\u001b[1B19–24\u001b[11GDec, and \"Land\u001b[26Grates help desk\", Jan–Mar), so they \u001b[63Geed a real \u001b[75Gnd dat\u001b[82G. Plain news records\u001b[K\r\u001b[4C\u001b[1Bcan't store one. The\u001b[26Gdocx\u001b[31Galso\u001b[36Glists\u001b[42GCost\u001b[47Gand\u001b[51GRegistration,\u001b[65Gwhich\u001b[71Ghave\u001b[76Gno\u001b[79Gfield.\u001b[86GThose\u001b[92Gcan\u001b[96Ggo\u001b[99Gin\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gteaser or body text.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt reuses what's already set up.\u001b[22m Editors\u001b[46Gke\u001b[49Gp wo\u001b[54Gking with news\u001b[69Gr\u001b[71Gcords in\u001b[84G\"N\u001b[87Gws records\" folder.\r\u001b[4C\u001b[1BThe news \u001b[15Getail page, \u001b[28Ghe categ\u001b[38Gies and\u001b[46Gthe search\u001b[57Gindexer\u001b[65Gfor\u001b[69Gnews\u001b[74Gcover\u001b[80Gthe\u001b[84Gevents\u001b[91Gas\u001b[94Gwell.\u001b[100GYou\r\u001b[2C\u001b[1B \u001b[5Gdon't need a second data model or plugin s\u001b[48Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPast events drop off by themselves.\u001b[22m The events list can show upcoming\u001b[75Gev\u001b[78Gnts only, sorted by start\r\u001b[4C\u001b[1Bdate, so\u001b[15Ghe \"Past events\" part of the docx needs no manu\u001b[63Gl handling.\u001b[75GThe\u001b[79Ghome\u001b[84Gpage\u001b[89Gnews\u001b[94Gplugin\u001b[101Gis\r\u001b[4C\u001b[1Bthen\u001b[10Gset\u001b[14Gto\u001b[17Gleave\u001b[23Gevents\u001b[30Gout,\u001b[35Gso\u001b[38Gthe\u001b[42Gtwo\u001b[46Glists\u001b[52Gstay\u001b[57Gseparate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOn the home page, a second news plug\u001b[40Gn under th\u001b[51G news,\u001b[58Gse\u001b[61G to upcoming events with a limit of 3, renders\r\u001b[4C\u001b[1Brough a small Fluid templa\u001b[32Ge override.\u001b[44GThat templ\u001b[55Gte\u001b[58Goutputs th\u001b[69G desi\u001b[75Gn's\u001b[79G\u001b[38;2;177;185;249m<ul class=\"events\">\u001b[99G\u001b[39mwith\r\u001b[2C\u001b[1Bthe\u001b[7G\u001b[38;2;177;185;249mevents__date\u001b[20G\u001b[39mbadge,\u001b[27Gand\u001b[31Gthe\u001b[35GSCSS\u001b[40Gfor\u001b[44Git\u001b[47Gis\u001b[50Galready\u001b[58Gin\u001b[61Gthe\u001b[65Gsitepackage.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo alternatives I'd rule out:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlain news with an \"Events\" category:\u001b[43G\u001b[22mno\u001b[46Gend\u001b[50Gdate,\u001b[56Gno\u001b[59Glocation,\u001b[69Gand\u001b[73Gshowing\u001b[81Gfuture\u001b[88Gdates\u001b[94Gin\u001b[97Gdate\u001b[102Gorder\r\u001b[2C\u001b[1B \u001b[5Gwould take workarounds.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mlochmueller/calendarize\u001b[39m (15.1.0, TYPO3 14 compatible):\u001b[22m a separate event mo\u001b[80Gel with recu\u001b[93Grence and\u001b[K\r\u001b[4C\u001b[1Bcalendar\u001b[14Gviews.\u001b[21GThat's\u001b[28Gmore\u001b[33Gthan\u001b[38Gsix\u001b[42Gone-off\u001b[50Gevents\u001b[57Gneed,\u001b[63Gand\u001b[67Geditors\u001b[75Gwould\u001b[81Ghave\u001b[86Gto\u001b[89Glearn\u001b[95Ga\u001b[97Gsecond\r\u001b[4C\u001b[1Bsystem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne th\u001b[13GI still need to check before building: the\u001b[56Gexact plugin setti\u001b[75Gg name\u001b[85G eventnews\u001b[96G7.2\u001b[100Gfor\r\u001b[2C\u001b[1B\"upcoming\u001b[13Gonly\"\u001b[19Gand\u001b[23G\"exclude\u001b[32Gevents\".\u001b[69Gage\u001b[73Gonce\u001b[78Git's\u001b[83Ginstalled.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
