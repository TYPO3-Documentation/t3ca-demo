[1613.239008, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m0\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m##\u001b[15GEvents\r\u001b[1B     \u001b[2m 142 \u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe breadcrumb\u001b[18Gon\u001b[21Ga\u001b[23Gdetail\u001b[30Gpage\u001b[35Gnow\u001b[39Gends\u001b[44Gwith\u001b[49Gthe\u001b[53Gtitle\u001b[59Gof\u001b[62Gthe\u001b[66Gevent\u001b[72Gor\u001b[75Gnews\u001b[80Gitem\u001b[85Ginstead\u001b[93Gof\u001b[96G\"Event\"\u001b[104Gor\r\u001b[2C\u001b[1B\"Article\":\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BEvent: Home › Events › Festive market at the\u001b[50Gjetty\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNews:\u001b[11GHome\u001b[16G›\u001b[18GNews\u001b[23G›\u001b[25GNew\u001b[29Gfish\u001b[34Gmarket\u001b[41Gopens\u001b[47Gat\u001b[50Gthe\u001b[54Gjetty\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works:\u001b[22m the n\u001b[23Gws extension already has a data processor\u001b[65Gthat adds\u001b[75Gthe news record\u001b[91Gto a\u001b[96Gmenu, but\r\u001b[2C\u001b[1Bit adds\u001b[11Git\u001b[14G\u001b[3mafter\u001b[23m \u001b[21Ghe last\u001b[29Gite\u001b[33G. That would give Home › Events › Event › Festive market, with \"Event\"\u001b[K\r\u001b[2C\u001b[1Blinking to an empty page. A small subclass, \u001b[38;2;177;185;249mClasses/DataProcessing/NewsTitleInBreadcrumbProcessor.php\u001b[39m,\r\u001b[2C\u001b[1Breplaces th\u001b[15G last item \u001b[27Gnstead. It's wired\u001b[46Ginto\u001b[54G breadcrum\u001b[65G in \u001b[38;2;177;185;249msetup.typoscript\u001b[86G\u001b[39m(entry\u001b[93G\u001b[38;2;177;185;249m41\u001b[39m).\u001b[98GPages\r\u001b[2C\u001b[1Bwithout\u001b[11Gan\u001b[14Gevent\u001b[20Gor\u001b[23Garticle\u001b[31Gin\u001b[34Gthe\u001b[38Gaddress\u001b[46Gkeep\u001b[51Gtheir\u001b[57Gnormal\u001b[64Gbreadcrumb.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChecked on this installation:\u001b[22m I loaded both detail pages above and\u001b[70Ggo\u001b[73G th\u001b[78Gexpected br\u001b[90Gadcrumbs.\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/events\u001b[39m, \u001b[38;2;177;185;249m/revenue-payments/land-rates\u001b[39m and \u001b[38;2;177;185;249m/news/article\u001b[39m wi\u001b[62Gh\u001b[64Gut an\u001b[70Garticle are unchanged.\u001b[93GTh\u001b[96G README's\u001b[106G\u001b[K\r\u001b[2C\u001b[1BN\u001b[6Gs section\u001b[16Gmentions\u001b[25Gthe\u001b[29Gnew\u001b[33Gbehaviour.\u001b[44GThis\u001b[49Gis\u001b[52Gconfiguration\u001b[66Gand\u001b[70Gcode\u001b[75Gonly,\u001b[81Gso\u001b[84G\u001b[38;2;177;185;249mdata.xml\u001b[93G\u001b[39mdoesn't\u001b[101Gneed\u001b[106Ga\r\u001b[2C\u001b[1Bnew\u001b[7Gexport.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill open from earlier: the \"Editors\" group on this installation\u001b[69Gcan't\u001b[75Gedit\u001b[80Gthe\u001b[84Gevent\u001b[90Gfields\u001b[97Gyet,\u001b[102Gand\r\u001b[2C\u001b[1Bthe\u001b[7Gfresh-install\u001b[21Gproof\u001b[27Ghasn't\u001b[34Grun.\u001b[39GNothing\u001b[47Gis\u001b[50Gcommitted.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mCooked for 39s ·\u001b[20Gd\u001b[22Gne 7:38 PM\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
