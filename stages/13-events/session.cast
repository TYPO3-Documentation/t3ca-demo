[155.57694, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mPast events drop off by themselves.\u001b[41G\u001b[22mThe\u001b[45Gevents\u001b[52Glist\u001b[57Gcan\u001b[61Gshow\u001b[66Gupcoming\u001b[75Gevents\u001b[82Gonly,\u001b[88Gsorted\u001b[95Gby\u001b[98Gstart\r\u001b[2C\u001b[1B \u001b[5Gdate, so the \"Past events\" part of the docx needs no manual handling. The hom\u001b[84Gpage news plugin is\u001b[K\r\u001b[4C\u001b[1Bt\u001b[8Gn set\u001b[14Gto leave even\u001b[28Gs out, s\u001b[37G the\u001b[42Gtwo\u001b[46Glist\u001b[51G stay\u001b[57Gseparate.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOn the home page, a second news plugin und\u001b[46Gr the\u001b[52Gnews, set t\u001b[64G upcoming events with a\u001b[88Glimit of 3, renders\r\u001b[2C\u001b[1Bthrough\u001b[11Ga small Fluid t\u001b[27Gmplate override.\u001b[44GThat\u001b[49Gt\u001b[51Gmplate\u001b[58Goutputs the design's\u001b[79G\u001b[38;2;177;185;249m<ul class=\"events\">\u001b[39m with\r\u001b[2C\u001b[1Bthe \u001b[38;2;177;185;249mevents__date\u001b[39m badge, and the\u001b[35GSCSS for it \u001b[49G alre\u001b[55Gdy in the sitepackage.\r\u001b[2C\u001b[2BTwo alternatives I'd rule out:\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mPlain news with an \"Events\" category:\u001b[22m no end date, no loca\u001b[64Gion, and showing future dates in date order\r\u001b[2C\u001b[1B  would take workarounds.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mlochmueller/calendarize\u001b[39m (15.1.0, TYPO3 14 compatible):\u001b[60G\u001b[22ma\u001b[62Gseparate\u001b[71Gevent\u001b[77Gmodel\u001b[83Gwith\u001b[88Grecurrence\u001b[99Gand\r\u001b[2C\u001b[1B  calendar v\u001b[16Gew\u001b[19G. That's m\u001b[30Gre than\u001b[38Gsix\u001b[42Gone-off\u001b[50Gevents\u001b[57Gneed,\u001b[63Gand\u001b[67Geditors\u001b[75Gwould\u001b[81Ghave\u001b[86Gto\u001b[89Glearn\u001b[95Ga\u001b[97Gsecond\r\u001b[2C\u001b[1B \u001b[5Gsystem.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne thing I still need to check before building: the exact\u001b[62Gplugin setti\u001b[75Gg\u001b[77Gnam\u001b[81Gs\u001b[83Gin eventnews 7.2 for\r\u001b[2C\u001b[1B\"upcoming only\" and \"exclude events\". I'll read them from the package once it's ins\u001b[87Gal\u001b[91Gd.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Ggo\u001b[15Gahead?\u001b[22GThat\u001b[27Gmeans\u001b[33Gadding\u001b[40Gthe\u001b[44Gpackage,\u001b[53Gextending\u001b[63G\u001b[38;2;177;185;249mseed-news.php\u001b[77G\u001b[39mwith\u001b[82Gthe\u001b[86Gevents\u001b[93Gfrom\u001b[98Gthe\u001b[102Gdocx,\r\u001b[2C\u001b[1Bre-exporting \u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[26Gand adding the home page plugin \u001b[59Gnd\u001b[62Gtemplate.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 30s · done 7:13 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mis it still actively maintained?\u001b[39m                                                                        \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✻\u001b[3GL\u001b[38;2;235;159;127mevi\u001b[38;2;215;119;87mtating… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
