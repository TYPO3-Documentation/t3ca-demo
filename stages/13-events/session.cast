[278.659017, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gread\u001b[10Gthe\u001b[14Gquery\u001b[20Gcode\u001b[25Gof\u001b[28Geventnews\u001b[38G7.2.0\u001b[44Gto\u001b[47Gcheck\u001b[53Gthis.\u001b[59GMulti-day\u001b[69Gevents\u001b[76Gare\u001b[80Ghandled\u001b[88Gproperly.\u001b[98GYou'd\r\u001b[2C\u001b[1Bonly need to adjust\u001b[23Gthe\u001b[27Gtemplate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's stored\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[8G start goes in the normal\u001b[34Gnews\u001b[39Gdate\u001b[44Gfield\u001b[50G(\u001b[38;2;177;185;249mdatetime\u001b[39m).\r\u001b[4C\u001b[1Bev\u001b[8Gntnews adds \u001b[38;2;177;185;249mevent_end\u001b[39m, a date-and-time field, and a \"full day\" checkbox. These fields\u001b[94Gonly\u001b[99Gappear\r\u001b[4C\u001b[1Bwhen\u001b[10G\"is\u001b[14Gevent\"\u001b[21Gis\u001b[24Gticked.\r\u001b[2C\u001b[1B- The festive market becomes\u001b[32Gone\u001b[36Grecord:\u001b[44Gstart\u001b[50G19\u001b[53GDec\u001b[57G2026\u001b[62G16:00,\u001b[69Gend\u001b[73G24\u001b[76GDec\u001b[80G2026\u001b[85G22:00.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhich list it shows up in\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUpcoming events list:\u001b[22m for an events-only plugin, eventnews replaces the news time\u001b[87Grestric\u001b[95Gion with\u001b[K\r\u001b[4C\u001b[1B\"end \u001b[11Gate is still to\u001b[27Gcome, or \u001b[38Gart date is still to come\"\u001b[K\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249mClasses/EventListener/ModifyDemandRepositoryEventListener.php\u001b[39m, \u001b[71Gound\u001b[76Gline 133).\u001b[87GAn\u001b[90Gevent\u001b[96Gthat\u001b[101Ghas\r\u001b[2C\u001b[1B \u001b[5Galready started stays\u001b[27Gi\u001b[30Gth\u001b[33G list until it ends. The \"Land rates help de\u001b[78Gk\" (18 Jan to\u001b[92G31 Mar 2027)\r\u001b[4C\u001b[1Bstays\u001b[11Gvisible\u001b[19Gthrough March. Plain news w\u001b[47Gul\u001b[51Gdrop it on 18\u001b[65GJanuary.\r\u001b[4C\u001b[1B\u001b[1mMonth and year\u001b[20Gviews:\u001b[22m an eve\u001b[34Gt app\u001b[40Gars in every month it\u001b[62Goverlaps.\u001b[72GThat's the #198 fix fr\u001b[95Gm August\r\u001b[4C\u001b[1B2026:\u001b[11Gbefore,\u001b[19Ga\u001b[21GJanuary\u001b[29Gto\u001b[32GMarch\u001b[38Gevent\u001b[44Gshowed\u001b[51Gup\u001b[54Gin\u001b[57GJanuary\u001b[65Gonly.\r\u001b[2C\u001b[1B- \u001b[1mEvents without an end date\u001b[22m only\u001b[37Guse\u001b[41Gthe\u001b[45Gstart\u001b[51Gdate.\u001b[57GOnce\u001b[62Gthat\u001b[67Gtime\u001b[72Ghas\u001b[76Gpassed,\u001b[84Gthey\u001b[89Gdrop\u001b[94Goff.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you'd have to build yourself\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDisplay:\u001b[14G\u001b[22mthe news list and detail templat\u001b[47Gs\u001b[49Gdon't show \u001b[38;2;177;185;249meventEnd\u001b[39m at all. Only eventnews'\u001b[93Gown month\u001b[K\r\u001b[4C\u001b[1Btemplate does.\u001b[20GOu\u001b[24Ghome page template override has to output the range, for example\u001b[89G\"19–24 Dec\". The\u001b[K\r\u001b[10C\u001b[1B's\u001b[14Gdate\u001b[19Gbadge\u001b[25G(\u001b[38;2;177;185;249m.events__date\u001b[39m,\u001b[41Ga\u001b[43Gfixed\u001b[49G4rem\u001b[54Gwidth)\u001b[61Gonly\u001b[66Ghas\u001b[70Groom\u001b[75Gfor\u001b[79Ga\u001b[81Gsingle\u001b[88Gday.\u001b[93GIt\u001b[96Gneeds\u001b[102Ga\r\u001b[2C\u001b[1B \u001b[5Grange variant, for example \"19 Dec \u001b[69Gwider\u001b[75Gbadge.\u001b[82GThat's a decision for\u001b[104Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
