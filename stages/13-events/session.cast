[1294.412979, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mOpen points\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEdit\u001b[10Grs on this installation can't see the event fields yet.\u001b[66G\u001b[22mThe\u001b[70G\"Editors\"\u001b[80Ggroup\u001b[86Ghere\u001b[91Gwas\u001b[95Gcreated\r\u001b[2C\u001b[1B \u001b[5Gbefore eventnews was installed, so it allows none of the new\u001b[66Gfi\u001b[69Glds: neither \"Is\u001b[86Gevent\" nor the\u001b[K\r\u001b[4C\u001b[1Br\u001b[7Ggistration fields.\u001b[26GO\u001b[28G a fr\u001b[34Gsh\u001b[37Ginstall the gr\u001b[52Gup\u001b[55Gis\u001b[58Gcr\u001b[61Gat\u001b[64Gd\u001b[66Gafter the fields exist and\u001b[93Ggets them\r\u001b[4C\u001b[1Bautomatically. Here,\u001b[26Gsomeone has to tick them in the\u001b[58Gg\u001b[60Goup (Sys\u001b[70Gm\u001b[72G> Back\u001b[79Gn\u001b[81G user\u001b[87G), or\u001b[93GI can add\u001b[103Gthem\r\u001b[4C\u001b[1Bfor you.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe fresh-install proof still hasn't run.\u001b[47G\u001b[22mThe\u001b[51Gnew\u001b[55G\u001b[38;2;177;185;249mdata.xml\u001b[64G\u001b[39mhasn't\u001b[71Gbeen\u001b[76Gimported\u001b[85Ganywhere\u001b[94Gyet.\u001b[99GIt\u001b[102Gneeds\r\u001b[2C\u001b[1B \u001b[5Gthe database emptied, which auto mode blocked\u001b[51Gearlier, so it'\u001b[67G your call. The full fr\u001b[91Gsh-install\u001b[102G\u001b[K\r\u001b[4C\u001b[1Bst\u001b[8Gps are in\u001b[18Gthe root\u001b[27GREADME.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mI haven't opened the event form in the backend.\u001b[53G\u001b[22mI\u001b[55Gchecked\u001b[63Gthe\u001b[67Gdatabase\u001b[76Gcolumns,\u001b[85Gthe\u001b[89Gexport\u001b[96Gand\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gfrontend, but not how the fields look in the event form.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted.\u001b[25GShould\u001b[32GI\u001b[34Gshow\u001b[39Gyou\u001b[43Gthe\u001b[47Gdiff\u001b[52Gand\u001b[56Ga\u001b[58Gcommit\u001b[65Gmessage?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 2m 54s · done 7:32 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mthe events are on the news page and when you use de breadcrumb you only see news not events\u001b[39m             \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m I'm giving events their own pages that mirror the news setup, with a breadcrumb of Home › Events\u001b[100G›\u001b[102GEvent\r\u001b[2C\u001b[1Band an \"All events\" link on the home section.\u001b[38;2;153;153;153m · \u001b[52Gummary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[3GMetamor\u001b[38;2;235;159;127mpho\u001b[38;2;215;119;87msing… \u001b[42G\u001b[38;2;153;153;153mthought for 12s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
