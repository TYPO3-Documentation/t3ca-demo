current text is \u001b[58Gn\u001b[60Gugh.\u001b[65GIf\u001b[68Gthe\u001b[72Gjob\u001b[76Gfair\u001b[81Gor\u001b[84Gthe\u001b[88Gmarket\u001b[95Gshould\u001b[102Gtake\r\u001b[2C\u001b[1Bregistrations\u001b[17Gonline,\u001b[25GI'd\u001b[29Gstart\u001b[35Gwith\u001b[40Goption\u001b[47G1.\u001b[50GOption\u001b[57G2\u001b[59Gonly\u001b[64Gpays\u001b[69Goff\u001b[73Gonce\u001b[78Gthe\u001b[82Gmunicipality\u001b[95Gneeds\u001b[101Gseat\r\u001b[2C\u001b[1Blimits or parti\u001b[19Gip\u001b[22Gnt lists.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 11s · done 7:26 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mcan we link it to an email address or page?\u001b[39m                                                             \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m \u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
