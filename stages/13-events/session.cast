[1033.933172, "o", "\u001b[H\r\u001b[14B←  ☒ Targets \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Button text \r\u001b[2C\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mS\u001b[5Gould the bu\u001b[17Gton text be fixed or set per event? The festive\u001b[65Gmarket registration i\u001b[88Gfor\u001b[92Gtraders \u001b[22m\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;255;255;255m\u001b[1mpplying for a\u001b[18Gstall, not visitors signing up\u001b[49G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[2B\u001b[38;2;177;185;249mPe\u001b[9G \u001b[11Gvent, default\u001b[25GRegister (Reco\u001b[40Gmended)\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mA \u001b[9Gecond field\u001b[21Gnext to \u001b[30Ghe link sets the butto\u001b[53G text, e.g. \"Apply f\u001b[74Gr a stall\".\u001b[86GIf it is empty the \r\u001b[5C\u001b[1Bbutton says\u001b[18G\"Register\".\u001b[39m\u001b[K\r\u001b[5C\u001b[1BAlways\u001b[13G\"R\u001b[16Ggister\"\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mOnly the link field. Every button says \"Reg\u001b[50Gster\".\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;153;153;153m Type something.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39m4. Chat about this\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[2B\u001b[39m\u001b[K\u001b[31;1H\u001b[20;1H"]
[1041.630628, "o", "\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[1041.638234, "o", "\u001b[H\r\u001b[13C\u001b[14B ☒ Button text \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Placement \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mWhere should\u001b[14Gthe but\u001b[22Gon show?\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mDetail page only (Recommended)\r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;2;153;153;153mThe button sits under the event's text on its detail page. The home page list stays as in the design.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[39mDetail page and home list\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mAlso a\u001b[14Gmall link under the teaser in the home page events list.\r\u001b[2C\u001b[1B3\u001b[5G Type something.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39m4. Chat about this\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[2B\u001b[39m\u001b[K\u001b[31;1H\u001b[19;1H"]
[1044.309436, "o", "\u001b[H\r\u001b[13B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m←\u001b[4G☒\u001b[6GTargets\u001b[15G☒\u001b[17GButton\u001b[24Gtext\u001b[30G☒\u001b[32GPlacement\u001b[42G\u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ✔ Submit \u001b[49m\u001b[38;2;153;153;153m →\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u001b[1mReview your answers\r\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[4G\u001b[22m●\u001b[6GWhere should the registration button of the two events point? The docx names offices but no email\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[22m  \u001b[6Gaddresses, and t\u001b[23Ge site only\u001b[35Ghas\u001b[39Ginfo@mtosafi.example\u001b[60Gand\u001b[64Greport@mtosafi.example.\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Market fees page + Contact (Recommended)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[22m ● Should the button\u001b[24Gtext\u001b[29Gbe\u001b[32Gfixed\u001b[38Gor\u001b[41Gset\u001b[45Gper\u001b[49Gevent?\u001b[56GThe\u001b[60Gfestive\u001b[68Gmarket\u001b[75Gregistration\u001b[88Gis\u001b[91Gfor\u001b[95Gtraders\r\u001b[1B \u001b[2m│\u001b[22m   applying for a stall, not visitors signing up.\u001b[K\r\u001b[2C\u001b[1B \u001b[38;2;78;186;101m→ Per event, default Register (Recommended)\r\u001b[1C\u001b[1B\u001b[39m●\u001b[4GWhere\u001b[10Gshould\u001b[17Gthe\u001b[21Gbutton\u001b[28Gshow?\r\u001b[1B   \u001b[38;2;78;186;101m→ Detail page only (Recommended)\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1. \u001b[38;2;177;185;249mSubmit answers\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2. \u001b[39mCancel\u001b[31;1H\u001b[29;1H"]
