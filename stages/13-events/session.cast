0;80m\u001b[48;2;2;40;0m 136 +\u001b[38;2;248;248;242m`/news/page-2` (`Configuration/Sets/Sitepackage/route-enhancers.yaml`).\u001b[48;2;4;71;0m On the\u001b[48;2;2;40;0m          \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 137 +\u001b[38;2;248;248;242mdetail page, the breadcrumb ends with the title of the news instead of the page         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 138 +\u001b[38;2;248;248;242m\"Article\" (`Classes/DataProcessing/NewsTitleInBreadcrumbProcessor.php`, built on the    \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 139 +\u001b[38;2;248;248;242m`AddNewsToMenuProcessor` of EXT:news); on \"Event\" with the title of the event.          \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 140 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 141 \u001b[22m ## Events\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 142 \r\u001b[1B\u001b[22m\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
