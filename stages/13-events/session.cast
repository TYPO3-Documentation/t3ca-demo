[1201.538006, "o", "\u001b[?25l\u001b[H\r\u001b[12C\u001b[24B\u001b[38;2;235;159;127m…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1201.657603, "o", "\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;2;215;119;87m✻\u001b[44G\u001b[38;2;153;153;153mought for 7s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1201.748147, "o", "\u001b[?25l\u001b[H\u001b[3Gunchanged.\r\u001b[2B \u001b[3G\u001b[1mWhat I added\u001b[22m\u001b[K\r\u001b[1B  - \u001b[1mThe two fields:\u001b[21G\u001b[22m\u001b[38;2;177;185;249mConfiguration/TCA/Overrides/tx_news_domain_model_news.php\u001b[79G\u001b[39madds\u001b[84Gthem\u001b[89Gnext\u001b[94Gto\u001b[97Gthe\r\u001b[4C\u001b[1Bevent's place, and they\u001b[29Gonly \u001b[35Gppear\u001b[41Gw\u001b[44Gn \"I\u001b[49G event\" is ticked.\u001b[68GThe\u001b[72Glabels\u001b[79Gare\u001b[83Gin\u001b[86Ga\u001b[88Gnew\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mResources/Private/Language/news.xlf\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAccess in templates:\u001b[26G\u001b[22meventnews\u001b[36Ghas\u001b[40Gno\u001b[43Gsuch\u001b[48Gfields,\u001b[56Gso\u001b[59Gthe\u001b[63Gsitepackage\u001b[75Gadds\u001b[80Gthem\u001b[85Gto\u001b[88Gthe\u001b[92Gnews\u001b[97Gmodel\u001b[103Gthe\r\u001b[4C\u001b[1Bsame way eventnews adds its own. That's \u001b[38;2;177;185;249mClasses/Domain/Model/News.php\u001b[39m plus one line in\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m. Templates can then use \u001b[38;2;177;185;249mregistrationLink\u001b[39m and \u001b[38;2;177;185;249mregistrationLabel\u001b[39m. I checked that\u001b[102Gthe\r\u001b[4C\u001b[1Bgenerated class contains both getters.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe button:\u001b[22m \u001b[38;2;177;185;249mDetail.html\u001b[39m shows a \u001b[38;2;177;185;249mbutton\u001b[39m-styled link when an event has a registration link. The\u001b[K\r\u001b[4C\u001b[1B\"Register\" text is in \u001b[38;2;177;185;249mfrontend.xlf\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mseed-events.php\u001b[39m now sets these targets, as you chose:\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mFestive market:\u001b[22m links to the \"Market fees\" page, button text \"Apply for a stall\".\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mJob fair:\u001b[22m links to the \"Contact\" page with the default \"Register\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI restored the \u001b[38;2;177;185;249mbefore-events\u001b[39m snapshot, ran the seed again and re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m. The two page\u001b[102Glinks\r\u001b[4C\u001b[1Bare exported as\u001b[22Goft references, so the import will point \u001b[64Ghem at the\u001b[75Gnew page uids. The state\u001b[100Gafter\r\u001b[4C\u001b[1Bthis ru\u001b[13G is saved as snapshot \u001b[38;2;177;185;249mafter-events-registration\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[19G\u001b[22mthe\u001b[23Gfestive\u001b[31Gmarket\u001b[38Gpage\u001b[43Gshows\u001b[49G\"Apply\u001b[56Gfor\u001b[60Ga\u001b[62Gstall\"\u001b[69Glinking\u001b[77Gto\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249m/revenue-payments/market-fees\u001b[39m,\u001b[34Gand\u001b[38Gthe\u001b[42Gjob\u001b[46Gfair\u001b[51Gpage\u001b[56Gshows\u001b[62G\"Register\"\u001b[73Glinking\u001b[81Gto\u001b[84G\u001b[38;2;177;185;249m/contact\u001b[39m.\u001b[94GEvents\r\u001b[1B  without a link get no button, and the home page list still shows the next three events. The screenshot\r\u001b[2C\u001b[1Bof\u001b[6Gthe detail page looks right.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mOpen points\u001b[22m\u001b[K\r\u001b[1B  - \u001b[1mEditors on this installation can't see the event fields yet.\u001b[22m The \"Editors\"\u001b[80Ggroup\u001b[86Ghere\u001b[91Gwas\u001b[95Gcreated\u001b[31;1H\u001b[29;3H\u001b[?25h"]
