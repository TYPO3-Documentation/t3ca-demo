[312.48352, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gstays visible through\u001b[27GMa\u001b[30Gch.\u001b[34GPlain news would drop it on 18 January.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMonth and year views:\u001b[27G\u001b[22man \u001b[31Gvent\u001b[36Gappears in\u001b[47Gevery mon\u001b[57Gh\u001b[59Git overlaps.\u001b[72GThat's\u001b[79Gthe\u001b[83G#198\u001b[88Gfix\u001b[92Gfrom\u001b[97GAugust\r\u001b[4C\u001b[1B2026: before, a January to March event showed up in January only.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEvents without an end date\u001b[22m on\u001b[35Gy use \u001b[42Ghe\u001b[45Gs\u001b[47Gart date. Once that time has passed, they\u001b[89Gdrop off.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you'd have to build yourself\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDisplay:\u001b[22m th\u001b[17G news list and\u001b[32Gdetail t\u001b[41Gmplates \u001b[50Gon't show \u001b[38;2;177;185;249meventEnd\u001b[39m at\u001b[72Gall.\u001b[77GOnly\u001b[82Geventnews'\u001b[93Gown\u001b[97Gmonth\r\u001b[2C\u001b[1B \u001b[5Gtemplate does. Our home page template override has to output the range, for example\u001b[89G\"19–24 Dec\".\u001b[102GThe\r\u001b[4C\u001b[1Bdesign's\u001b[14Gdate\u001b[19Gbadge\u001b[25G(\u001b[38;2;177;185;249m.events__date\u001b[39m,\u001b[41Ga\u001b[43Gfixed\u001b[49G4rem\u001b[54Gwidth)\u001b[61Gonly\u001b[66Ghas\u001b[70Groom\u001b[75Gfor\u001b[79Ga\u001b[81Gsingle\u001b[88Gday.\u001b[93GIt\u001b[96Gneeds\u001b[102Ga\r\u001b[2C\u001b[1B  range variant, for example \"19 Dec\u001b[40G–\u001b[42G24\u001b[45GDec\"\u001b[50Gon\u001b[53Gtwo\u001b[57Glines,\u001b[64Gor\u001b[67Ga\u001b[69Gwider\u001b[75Gbadge.\u001b[82GThat's\u001b[89Ga\u001b[91Gdecision\u001b[100Gfor\u001b[104Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRepeating opening hours:\u001b[22m th\u001b[33Gre's no field for something like\u001b[70Ghelp desk's \"Monday to Friday,\u001b[K\r\u001b[4C\u001b[1B9:00–15:00\". eventnews has one start and one end\u001b[54Gan\u001b[57G no\u001b[61Grecurrence. That text goes\u001b[88Gin the teaser\u001b[102Gor\r\u001b[4C\u001b[1Bbody text. If you ever ne\u001b[31Gd real recurring eve\u001b[52Gts with separate\u001b[69Gdat\u001b[73Gs, that's when c\u001b[90Glendar\u001b[97Gze\u001b[100Gw\u001b[102Guld\u001b[K\r\u001b[4C\u001b[1Bb\u001b[7G worth\u001b[14Git.\u001b[18GFor\u001b[22Gthe\u001b[26Gevents\u001b[33Gin\u001b[36Gthe\u001b[40Gdocx,\u001b[46Gstart\u001b[52Gand\u001b[56Gend\u001b[60Gare\u001b[64Genough.\r\u001b[4C\u001b[1B\u001b[1mSorting:\u001b[22m the list is sorted by \u001b[37Gtart date\u001b[47Gin a\u001b[52Gcending order. An\u001b[70Gevent that's alre\u001b[88Gdy runn\u001b[96Gng\u001b[K\r\u001b[4C\u001b[1Btherefore app\u001b[19Gars above events\u001b[36Gth\u001b[39Gt start lat\u001b[51Gr.\u001b[54GFor\u001b[58Ga \"what's on\" list that's usually wha\u001b[96G you want.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I go ahead on that ba\u001b[32Gis?\u001b[36GBefore I build the t\u001b[57Gmpl\u001b[61Gt\u001b[63G, I'd need\u001b[74Gone\u001b[78Gchoice\u001b[85Gfrom\u001b[90Gyou:\u001b[95Ghow\u001b[99Gthe\u001b[103Gdate\r\u001b[2C\u001b[1Bbadge should show a\u001b[23Grange.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 26s · done 7:16 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mgo ahead, show the range on two lines in the badge\u001b[39m                                                      \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m*\u001b[3GKneading\u001b[38;2;235;159;127m…\u001b[38;2;215;119;87m \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
