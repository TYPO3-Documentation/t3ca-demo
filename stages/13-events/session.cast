[280.370571, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Ba few extra columns,\u001b[24Gso moving them\u001b[39Gto pl\u001b[45Gin news or anoth\u001b[62Gr extension would be ma\u001b[87Ggeable.\u001b[95G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy\u001b[6Grecommendation\u001b[21Gstands.\u001b[29GShould\u001b[36GI\u001b[38Ggo\u001b[41Gahead\u001b[47Gwith\u001b[52Git?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 12s · done 7:14 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhat happens if we have events spanning multiple days?\u001b[39m                                                  \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gread\u001b[10Gthe\u001b[14Gquery\u001b[20Gcode\u001b[25Gof\u001b[28Geventnews\u001b[38G7.2.0\u001b[44Gto\u001b[47Gcheck\u001b[53Gthis.\u001b[59GMulti-day\u001b[69Gevents\u001b[76Gare\u001b[80Ghandled\u001b[88Gproperly.\u001b[98GYou'd\r\u001b[1B \u001b[3Gonly need to adjust the t\u001b[29Gmplat\u001b[35G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's stored\r\u001b[2C\u001b[1B\u001b[22m- The start goes\u001b[20Gin\u001b[23Gthe\u001b[27Gnormal\u001b[34Gnews\u001b[39Gdate\u001b[44Gfield\u001b[50G(\u001b[38;2;177;185;249mdatetime\u001b[39m).\r\u001b[4C\u001b[1Bev\u001b[8Gntnews\u001b[15Gadd\u001b[20G\u001b[38;2;177;185;249mevent_end\u001b[39m, \u001b[32G date-and-time field, and a \"full\u001b[66Gday\"\u001b[71Gcheckbox.\u001b[81GThese\u001b[87Gfields\u001b[94Gonly\u001b[99Gappear\r\u001b[2C\u001b[1B \u001b[5Gwh\u001b[9G \"is event\" is ticked.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[8G festive market\u001b[24Gbe\u001b[27Gomes\u001b[32Gone\u001b[36Grecord:\u001b[44Gstart\u001b[50G19\u001b[53GDec\u001b[57G2026\u001b[62G16:00,\u001b[69Gend\u001b[73G24\u001b[76GDec\u001b[80G2026\u001b[85G22:00.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhich list it shows up in\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mUpcom\u001b[11Gng\u001b[14Gevents list:\u001b[22m for\u001b[31Gan\u001b[34Gevents-only\u001b[46Gplugin,\u001b[54Geventnews\u001b[64Greplaces\u001b[73Gthe\u001b[77Gnews\u001b[82Gtime\u001b[87Grestriction\u001b[99Gwith\r\u001b[2C\u001b[1B \u001b[5G\"end date is still to\u001b[27Gc\u001b[29Gme, or start date is still to come\"\u001b[K\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249mClasses/EventListener/ModifyDemandRepositoryEventListener.php\u001b[39m,\u001b[69Garound\u001b[76Gline 133).\u001b[87GAn\u001b[90Gevent\u001b[96Gthat\u001b[101Ghas\r\u001b[4C\u001b[1Balready started stays in the list until it ends. The \"Land rates help desk\" (18 Jan to 31 Mar 2027)\r\u001b[4C\u001b[1Bstays vi\u001b[14Gible through\u001b[27GMarc\u001b[32G.\u001b[34GPlain \u001b[69Gary.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
