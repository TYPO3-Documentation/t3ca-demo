b[2m 2592 \u001b[45G\u001b[22m<field\u001b[52G\u001b[38;2;166;226;46mindex\u001b[39m=\u001b[38;2;230;219;116m\"perms_group\"\u001b[72G\u001b[38;2;166;226;46mtype\u001b[39m=\u001b[38;2;230;219;116m\"integer\"\u001b[39m>31</field>\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +63 lines \u001b[45G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[45G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Next I'm documenting the\u001b[28Gregistration\u001b[41Gfields\u001b[48Gin\u001b[51Gthe\u001b[55Gsitepackage\u001b[67GREADME.\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=tvlavs;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/README.md\u0007packages/mtosafi_sitepackage/README.md\u001b]8;;\u0007)\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1189.82644, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[24B\u001b[38;2;230;149;117mConcocting…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1189.927926, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[24B\u001b[38;2;225;139;107mConcocting…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1189.989933, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 2592 \u001b[22m                                 <field \u001b[38;2;166;226;46mindex\u001b[39m=\u001b[38;2;230;219;116m\"perms_group\"\u001b[39m \u001b[38;2;166;226;46mtype\u001b[39m=\u001b[38;2;230;219;116m\"integer\"\u001b[39m>31</field>\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +63 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNext I'm documenting the registration fields in the sitepackage README.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=tvlavs;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/README.md\u0007packages/mtosafi_sitepackage/README.md\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m9\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 151 \u001b[22m place instead of the date of the news. The partial is\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 152 \u001b[22m `Resources/Private/Extensions/News/Partials/List/Event.html`.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 153 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 154 +\u001b[38;2;248;248;242mAn event can have a registration: on the tab \"Eventnews\", \"Registration\" takes a page,  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 155 +\u001b[38;2;248;248;242ma website or an email address, and \"Text of the registration button\" the text of the    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 156 +\u001b[38;2;248;248;242mbutton, \"Register\" where it is empty. The detail page shows the button below the text;  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 157 +\u001b[38;2;248;248;242mthe list on the home page does not. The two fields are the sitepackage's own            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 158 +\u001b[38;2;248;248;242m(`Configuration/TCA/Overrides/tx_news_domain_model_news.php`). They reach the           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 159 +\u001b[38;2;248;248;242mtemplates as `registrationLink` and `registrationLabel` through the class extension of  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 160 +\u001b[38;2;248;248;242mEXT:news, which merges `Classes/Domain/Model/News.php` into its news model, as          \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 161 +\u001b[38;2;248;248;242mEXT:eventnews does with its fields; after a change to that class, flush the caches.     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 162 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 163 \u001b[12G\u001b[22mThe site shows days, not times: PHP\u001b[48Gruns on th\u001b[59G installation's\u001b[75Gtime\u001b[80Gzone,\u001b[86Gwhich\u001b[92Gis\r\u001b[5C\u001b[1B\u001b[2m 164 \u001b[12G\u001b[22mnot\u001b[16Gnecessarily\u001b[28Gthe\u001b[32Gmunicipality's.\u001b[48GThe\u001b[52Gseeded\u001b[59Gevents\u001b[66Gcarry\u001b[72Gtheir\u001b[78Gtimes\u001b[84Gin\u001b[87Gthe\u001b[91Gtext,\r\u001b[1B \u001b[3G   \u001b[2m 165 \u001b[22m together with the cost and the registration,\u001b[57Gwhich\u001b[63Ghave\u001b[68Gno\u001b[71Gfield;\u001b[78Gthe\u001b[82Gteaser\u001b[89Grepeats\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1190.006142, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[24B\u001b[38;2;223;134;102mConcocting…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1190.833747, "o", "\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;2;215;119;87m·\u001b[3GCo\u001b[38;2;235;159;127mnco\u001b[38;2;215;119;87mcting…\u001b[19G\u001b[38;2;153;153;153m40\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1190.850824, "o", "\u001b[?25l\u001b[H\r\u001b[38C\u001b[24B\u001b[38;2;153;153;153m · \u001b[38;2;183;183;183mthinking\u001b[38;2;153;153;153m)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
