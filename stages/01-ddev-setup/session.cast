[2036.352808, "o", "\u001b[?25l\u001b[H\u001b[3Gchanges\u001b[11Gyour\u001b[16Gmachine's\u001b[26Gtrust\u001b[32Gsettings.\u001b[42GAfter\u001b[48Git\u001b[51Gfinishes,\u001b[61Gfully\u001b[67Gclose\u001b[73Gthe\u001b[77Gbrowser\u001b[85G(every\u001b[92Gwindow)\u001b[100Gand\u001b[104Greopen\u001b[111G\u001b]8;id=yno1gn;https://demo.ddev.site/typo3/\u0007\u001b[94mhttps://demo.ddev.site/typo3/\u001b]8;;\u0007\u001b[39m.\u001b[142GThe\r\u001b[2C\u001b[1Bwarning should be gone.\r\u001b[2B \u001b[3GIf you don't\u001b[16Gwant to change the\u001b[35Gtrust set\u001b[45Gings, you can click \u001b[1mAdvanced → Proceed to demo.ddev.site\u001b[22m for now. That\u001b[116Gonly\u001b[121Gaffects\u001b[129Gthis\u001b[134Glocal\u001b[140Gsite.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 9s · done 7:32 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mlina-wolf@lina-wolf-ThinkPad-T14s-Gen-3:~/projects/typo3/t3ca-2026/demo$ mkcert -install\u001b[39m                                                       \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the system trust store! 👍\u001b[39m                                                                                \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the Firefox and/or Chrome/Chromium trust store! 👍\u001b[39m                                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B  ⎿  1 action blocked by auto mode · /permissions to review\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m│\u001b[22m \u001b[38;2;153;153;153mAuto mode: No reason provided\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249mmkcert -install\u001b[19G\u001b[39mreported\u001b[28Gsuccess,\u001b[37Gbut\u001b[41Git\u001b[44Gdidn't\u001b[51Gactually\u001b[60Gfix\u001b[64GChrome.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYour\u001b[10Gdefault\u001b[18Gbrowser\u001b[26Gis\u001b[29GGoogle\u001b[36GChrome,\u001b[44Gwhich\u001b[50Greads\u001b[56Gtrusted\u001b[64Gcertificates\u001b[77Gfrom\u001b[82G\u001b[38;2;177;185;249m~/.pki/nssdb\u001b[39m.\u001b[96GThe\u001b[100Gmkcert\u001b[107Gauthority\u001b[117Gis\u001b[120G\u001b[1mnot\u001b[124G\u001b[22min\u001b[127Gthat\u001b[132Gstore.\r\u001b[1B \u001b[3G- It \u001b[1mis\u001b[22m in your Firefox profile.\u001b[36GThat's\u001b[43Gprobably\u001b[52Gwhy\u001b[56Gmkcert\u001b[63Greported\u001b[72G\"already\u001b[81Ginstalled\u001b[91Gin\u001b[94Gthe\u001b[98GFirefox\u001b[106Gand/or\u001b[113GChrome/Chromium\u001b[129Gtrust\u001b[135Gstore\":\u001b[143Git\r\u001b[4C\u001b[1Bfound\u001b[11Gthe\u001b[15GFirefox\u001b[23Gone\u001b[27Gand\u001b[31Gstopped\u001b[39Gthere.\r\u001b[1B\u001b[K\r\u001b[1B  I tried to add the authority to Chrome's store myself, but the permission system blocked it because it changes certificate trust. Run this\u001b[K\r\u001b[1B  yourself (no sudo needed):\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;177;185;249m! certutil -d sql:$HOME/.pki/nssdb -A -t \"C,,\" -n \"mkcert development CA\" -i \"$(mkcert -CAROOT)/rootCA.pem\"\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen\u001b[8Gfully quit Chrome (every window)\u001b[41Gand\u001b[45Greopen\u001b[52G\u001b]8;id=yno1gn;https://demo.ddev.site/typo3/\u0007\u001b[94mhttps://demo.ddev.site/typo3/\u001b]8;;\u0007\u001b[39m.\u001b[83GTo\u001b[86Gundo\u001b[91Git\u001b[94Glater,\u001b[101Grun\u001b[105G\u001b[38;2;177;185;249mcertutil -d sql:$HOME/.pki/nssdb -D -n \r\u001b[1B\u001b[39m  \u001b[38;2;177;185;249m\"mkcert development CA\"\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFirefox already\u001b[19Gtrusts\u001b[26Gthe\u001b[30Gauthority,\u001b[41Gso\u001b[44G\u001b]8;id=yno1gn;https://demo.ddev.site/typo3/\u0007\u001b[94mhttps://demo.ddev.site/typo