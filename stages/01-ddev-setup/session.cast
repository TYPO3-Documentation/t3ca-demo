01b[1B\u001b[38;2;80;200;80m29\u001b[12G\u001b[38;2;117;113;94m# doc\u001b[18Goot:\u001b[23G<relative_path> # Relative path to the directory containing index.php.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m30\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m31\u001b[14G\u001b[38;2;117;113;94mphp_vers\u001b[25G: \"8.4\"\u001b[33G # PHP versi\u001b[46Gn to\u001b[51Guse; see https://docs.ddev.com/en/stable/users/configuration/config/#php_version.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m32\r\u001b[7C\u001b[1B33\u001b[14G\u001b[38;2;117;113;94mY\u001b[16Gu can explicitly specify\u001b[41Gthe webimage but\u001b[60Gis\u001b[38;2;248;248;242m                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;117;113;94m# is not recommended, as the images are often closely tied to DDEV's behavior,\u001b[38;2;248;248;242m                                                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;117;113;94mso this ca\u001b[25G break upgrades.\u001b[38;2;248;248;242m                                                                                           \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\r\u001b[8C\u001b[1B7\u001b[14G\u001b[38;2;117;113;94mwebim\u001b[20Gge: <do\u001b[28Gker_image>\u001b[38;2;248;248;242m                        \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;117;113;94mIt’s unusual to change\u001b[39Gis option, and w\u001b[56G don’t recommend it without Docker experience and a good reason.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[14G\u001b[38;2;117;113;94mTypically, this means \u001b[38Gditions to the existing web image using a .ddev/web-build/Dockerfile.*\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m40\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;2;153;153;153m… 266 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;15