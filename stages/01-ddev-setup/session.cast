[1685.548622, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ Install it using ddev and composer\u001b[39m                                            \r\u001b[2C\u001b[1B\u001b[49m\u001b[1mSetup\u001b[22m \u001b[10G       \u001b[18G     \u001b[24G   \u001b[28G    \u001b[33G       \u001b[41G     \u001b[47G        \u001b[56G    \u001b[61G        \r\u001b[4C\u001b[1BDDEV project \u001b[38;2;177;185;249mdemo\u001b[39m: PHP 8.4, MariaDB 11.8, document\u001b[56Groot\u001b[61G\u001b[38;2;177;185;249mpublic/\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5GInstalled with \u001b[38;2;177;185;249md\u001b[22Gev composer create-project \u001b[39m            \u001b[62G         \u001b[72G    \r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\"typo3/cms-base-distribution:^14\"\u001b[39m,\u001b[40Gthen \u001b[38;2;177;185;249mddev typo3 setup\u001b[39m (database \u001b[38;2;177;185;249mdb\u001b[39m),\r\u001b[2C\u001b[1B \u001b[5Gwhich \u001b[12Glso created a \u001b[27Goot page and a si\u001b[45Ge at \u001b]8;id=datk3r;https://demo.ddev.site/\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site/\u001b]8;;\u0007\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5GI restarted DDEV after the Composer\u001b[41Ginstall so i\u001b[54G would\u001b[61Gwr\u001b[64Gte   \r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mconfig/system/additional.php\u001b[39m,\u001b[35Gwhich\u001b[41Gholds\u001b[47Gthe\u001b[51Gdatabase,\u001b[61Gmail\u001b[66Gand\r\u001b[4C\u001b[1Btrusted-hosts\u001b[19Gsettings.\r\u001b[2C\u001b[1B                  \r\u001b[2C\u001b[1B\u001b[1mTwo things to know\u001b[22m    \u001b[26G    \u001b[31G    \u001b[36G  \u001b[39G  \u001b[42G     \u001b[48G          \u001b[59G  \u001b[62G \u001b[64G   \u001b[68G    \r\u001b[2C\u001b[1B-\u001b[5GThe Composer install\u001b[26Gonly runs in an empty \u001b[49Gir\u001b[52Gc\u001b[54Gory, so I set your\u001b[73G   \u001b[77G    \r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mREADME.md\u001b[39m aside, put\u001b[26Git\u001b[29Gback\u001b[34Gafterwards,\u001b[46Gand\u001b[50Gkept\u001b[55Git\u001b[58Ginstead\u001b[66Gof\u001b[69Gthe\u001b[73Gone\u001b[77Gthat\r\u001b[2C\u001b[1B \u001b[5Gcomes\u001b[11Gwith TYPO3.   \u001b[26G       \u001b[34G       \u001b[42G    \u001b[47G     \u001b[53G      \u001b[60G         \u001b[70G          \r\u001b[2C\u001b[1B-\u001b[5GWhile I was\u001b[17Gworking,\u001b[27Gnother\u001b[34Gcommit,\u001b[42Galso named\u001b[53G\"Stage 00-start\" (\u001b[38;2;177;185;249m5d4cc80\u001b[39m),\r\u001b[4C\u001b[1Bappeared on \u001b[38;2;177;185;249mmain\u001b[39m and added a \u001b[35G\u001b[38;2;177;185;249mesign/\u001b[39m fol\u001b[46Ger. At one point git showed \r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdesign/docs/news-and-events.md\u001b[36G\u001b[39mas changed,\u001b[48Gbut\u001b[52Ga later\u001b[60Gdiff showed no      \r\u001b[4C\u001b[1Bchanges.\u001b[14GI\u001b[16Gdidn't\u001b[23Gtouch\u001b[29Gany\u001b[33Gof\u001b[36Git,\u001b[40Gbut\u001b[44Gyou\u001b[48Gmay\u001b[52Gwant\u001b[57Gto\u001b[60Gcheck\u001b[66Gwhat\u001b[71Ghappened.\r\u001b[2C\u001b[1B \u001b[5G       \u001b[13G         \u001b[23G         \u001b[33G       \u001b[41G              \u001b[56G              \u001b[71G       \r\u001b[2C\u001b[1BI haven't committed anything. \u001b[38;2;177;185;249m.ddev/\u001b[39m, \u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[56G\u001b[38;2;177;185;249mcomposer.lock\u001b[39m,\u001b[71G\u001b[38;2;177;185;249mconfig/\r\u001b[2C\u001b[1B\u001b[39mand\u001b[7G\u001b[38;2;177;185;249mpackages/\u001b[17G\u001b[39mare\u001b[21Gnew\u001b[25Gand\u001b[29Guntracked,\u001b[40Gready\u001b[46Gto\u001b[49Gcommit\u001b[56Gwhen\u001b[61Gyou\u001b[65Gwant.\r\u001b[1B \u001b[3G                                \r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 2m 17s · done 7:27 AM\r\u001b[1B\u001b[39m                                                                                \r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mDont look at sister projects, only work in here\u001b[39m                               \r\u001b[1B\u001b[49m \u001b[3G      \u001b[10G      \u001b[17G     \u001b[23G     \r\u001b[1C\u001b[1B Adding memory index entry                                                  \r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ echo\u001b[13G'- [Stay\u001b[22Gi\u001b[24G proj\u001b[30Gct dir](stay-in-pr\u001b[49Gject-dir.md)\u001b[62G— never inspect \r\u001b[5C\u001b[1Bsist\u001b[11Gr projects (no `\u001b[28Gdev list`, no n\u001b[44Gighbouring dirs)' >> \u001b[39m                \r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m/h\u001b[9Gme/lina-wolf/.claude/projects/-home-lina-wolf-projects-typo3-t3ca-2026-d\r\u001b[5C\u001b[1Bemo/memory/MEMORY.md\r\u001b[1B\u001b[39m \u001b[3G                   \u001b[23G    \u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[37;1H\u001b[35;3H\u001b[?25h"]
