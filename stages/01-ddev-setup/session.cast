[186.274674, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m25\u001b[12G\u001b[38;2;117;113;94m# type: <projecttype>  # asterios, backdrop, cakephp, codeigniter, craftcms, \u001b[90Grupal, drupal6, drupa\u001b[112G7, drupal8, drupal9, drupal\r\u001b[11C\u001b[1B10, d\u001b[18Gupal11, drupal12, generic, joomla, laravel, magento, magento2, maho, modx, php, shopware6, silverstripe, symfony, typo3, \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m  \u001b[12G\u001b[38;2;117;113;94mwordpress, wp-bedrock\u001b[38;2;248;248;242m                                           \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;117;113;94mSee https://docs.ddev.com/en/stable/users/quickstart/ for more\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;117;113;94m# information on the different project types\u001b[38;2;248;248;242m                                                                                   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m29\u001b[12G\u001b[38;2;117;113;94m# docroot: <relative_path> # Relative path to the directory containing index.php.\u001b[38;2;248;248;242m                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;117;113;94m# php_version: \"8.4\"  # PHP version to use; see https://docs.ddev.com/en/stable/users/configuration/config/#php_version.\u001b[38;2;248;248;242m       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[14G\u001b[38;2;117;113;94mYou can \u001b[23Gxplicitly specify\u001b[41Gthe webimage but\u001b[58Gthi\u001b[62G\u001b[38;2;248;248;242m                            \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[14G\u001b[38;2;117;113;94mis\u001b[17Gnot recommended, as the images are often closely tied to DDEV's behavior,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;117;113;94m# so this can break upgrades.\u001b[38;2;248;248;242m                                                                                                  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;117;113;94mwebimage: <docker_image>\u001b[38;2;248;248;242m                                                                                  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;117;113;94mIt’s unusual to\u001b[30Gch\u001b[34Gge th\u001b[40Gs \u001b[43Gption, and we do\u001b[60G’t reco\u001b[68Gmend it without Docker experienc\u001b[101G and a good reason.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m39\u001b[12G\u001b[38;2;117;113;94m# Typically, this means additions to the existing web image using a .ddev/web-build/Dockerfile.*\u001b[38;2;248;248;242m                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m  40 +\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;153;153;153m… 266 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  (files that changed while this command ran, by the command or by another process; a convenience view, not a review or audit of the \r\u001b[1B\u001b[39m     \