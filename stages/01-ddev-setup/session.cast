[2015.333799, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BLog in with the username \u001b[38;2;177;185;249madmin\u001b[39m. The password\u001b[48Gis\u001b[51Gin\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/tmp/claude-1000/-home-lina-wolf-projects-typo3-t3ca-2026-demo/35cca6d0-ad19-4ca1-9b7c-74f0f1c6ca26/scratchpad/admin-password.txt\u001b[39m.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 8s · done 7:31 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mYour connection is not private\u001b[39m                                                                                                                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYour browser shows that warning\u001b[35Gbecause\u001b[43Git\u001b[46Gdoesn't\u001b[54Gtrust\u001b[60Gthe\u001b[64Gcertificate\u001b[76GDDEV\u001b[81Guses\u001b[86Gfor\u001b[90G\u001b]8;id=fg1t4;https://demo.ddev.site\u0007\u001b[38;2;177;185;249mhttps://demo.ddev.site\u001b]8;;\u0007\u001b[39m.\r\u001b[2B  DDEV signs its certificates with a local certificate authority from \u001b[38;2;177;185;249mmkcert\u001b[39m. That authority already exists on your machine, in\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m~/.local/share/mkcert\u001b[39m,\u001b[26Gbut\u001b[30Git\u001b[33Gisn't\u001b[39Gin\u001b[42GChrome's\u001b[51Glist\u001b[56Gof\u001b[59Gtrusted\u001b[67Gcertificate\u001b[79Gauthorities.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTo\u001b[6Gfix\u001b[10Git,\u001b[14Grun\u001b[18Gthis\u001b[23Gin\u001b[26Gthe\u001b[30Gprompt:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m! mkcert -install\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BIt adds the authority to your\u001b[33Gsystem and browser trust s\u001b[60Gores and will probably ask for your\u001b[96Gsudo\u001b[101Gpassword.\u001b[111GI\u001b[113Ghaven't\u001b[121Grun\u001b[125Git\u001b[128Gmyself\u001b[135Gbecause\u001b[143Git\r\u001b[2C\u001b[1Bchanges\u001b[11Gyour\u001b[16Gmachine's\u001b[26Gtrust\u001b[32Gsettings.\u001b[42GAfter\u001b[48Git\u001b[51Gfinishes,\u001b[61Gfully\u001b[67Gclose\u001b[73Gthe\u001b[77Gbrowser\u001b[85G(every\u001b[92Gwindow)\u001b[100Gand\u001b[104Greopen\u001b[111G\u001b]8;id=yno1gn;https://demo.ddev.site/typo3/\u0007\u001b[94mhttps://demo.ddev.site/typo3/\u001b]8;;\u0007\u001b[39m.\u001b[142GThe\r\u001b[2C\u001b[1Bwarn\u001b[8Gng should\u001b[18Gbe gone.\u001b[K\r\u001b[2C\u001b[2BIf you don't want\u001b[21Gto\u001b[24Gchange\u001b[31Gthe\u001b[35Gtrust\u001b[41Gsettings,\u001b[51Gyou\u001b[55Gcan\u001b[59Gclick\u001b[65G\u001b[1mAdvanced → Proceed to demo.ddev.site\u001b[102G\u001b[22mfor\u001b[106Gnow.\u001b[111GThat\u001b[116Gonly\u001b[121Gaffects\u001b[129Gthis\u001b[134Glocal\u001b[140Gsite.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 9s · done 7:32 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mlina-wolf@lina-wolf-ThinkPad-T14s-Gen-3:~/projects/typo3/t3ca-2026/demo$ mkcert -install\u001b[39m                                                       \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the system trust store! 👍\u001b[39m                                                                                \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the Firefox and/or Chrome/Chromium trust store! 👍\u001b[39m                                                        \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m*\u001b[3GWrangli\u001b[38;2;235;159;127mng…\u001b[38;2;215;119;87m \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\u001b[37;1H\u001b[35;3H\u001b[?25h"]
