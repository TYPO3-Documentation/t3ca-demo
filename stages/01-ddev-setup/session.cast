[2100.995873, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 9s · done 7:32 AM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mlina-wolf@lina-wolf-ThinkPad-T14s-Gen-3:~/projects/typo3/t3ca-2026/demo$ mkcert -install\u001b[39m                                                       \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the system trust store! 👍\u001b[39m                                                                                \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the Firefox and/or Chrome/Chromium trust store! 👍\u001b[39m                                                        \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  1 action blocked by auto mode · /permissions to review\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m│\u001b[22m \u001b[38;2;153;153;153mAuto mode: No reason provided\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249mmkcert -install\u001b[39m reported\u001b[28Gsuccess,\u001b[37Gbut\u001b[41Git\u001b[44Gdidn't\u001b[51Gactually\u001b[60Gfix\u001b[64GChrome.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYour default browser is Google Chrome,\u001b[44Gwhich\u001b[50Greads\u001b[56Gtrusted\u001b[64Gcertificates\u001b[77Gfrom\u001b[82G\u001b[38;2;177;185;249m~/.pki/nssdb\u001b[39m.\u001b[96GThe\u001b[100Gmkcert\u001b[107Gauthority\u001b[117Gis\u001b[120G\u001b[1mnot\u001b[124G\u001b[22min\u001b[127Gthat\u001b[132Gstore.\r\u001b[2C\u001b[1B-\u001b[5GIt\u001b[8G\u001b[1mis\u001b[11G\u001b[22min\u001b[14Gyour\u001b[19GFirefox\u001b[27Gprofile.\u001b[36GThat's\u001b[43Gprobably\u001b[52Gwhy\u001b[56Gmkcert\u001b[63Greported\u001b[72G\"already\u001b[81Ginstalled\u001b[91Gin\u001b[94Gthe\u001b[98GFirefox\u001b[106Gand/or\u001b[113GChrome/Chromium\u001b[129Gtrust\u001b[135Gstore\":\u001b[143Git\r\u001b[1B \u001b[3G  found the Firefox on\u001b[26G and stopped \u001b[40Ghere.\u001b[K\r\u001b[2C\u001b[2BI\u001b[5Gtried to add\u001b[18Gthe authority to Chrome's\u001b[44Gstore\u001b[50Gmyself, bu\u001b[61G the perm\u001b[71Gssion\u001b[77Gsystem blocked it because it changes certificate trus\u001b[131G. Run this\r\u001b[2C\u001b[1Byourself (no sudo n\u001b[23Geded):\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m! certutil -d sql:$HOME/.pki/nssdb -A -t \"C,,\" -n \"mkcert development CA\" -i \"$(mkcert -CAROOT)/rootCA.pem\"\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen fully quit Chrome (every\u001b[33Gwindow)\u001b[41Gand\u001b[45Greopen\u001b[52G\u001b]8;id=yno1gn;https://demo.ddev.site/typo3/\u0007\u001b[94mhttps://demo.ddev.site/typo3/\u001b]8;;\u0007\u001b[39m.\u001b[83GTo\u001b[86Gundo\u001b[91Git\u001b[94Glater,\u001b[101Grun\u001b[105G\u001b[38;2;177;185;249mcertutil -d sql:$HOME/.pki/nssdb -D -n \r\u001b[2C\u001b[1B\"mkcert development CA\"\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFirefox\u001b[11Galready\u001b[19Gtrusts\u001b[26Gthe\u001b[30Gauthority,\u001b[41Gso\u001b[44G\u001b]8;id=yno1gn;https://demo.ddev.site/typo3/\u0007\u001b[94mhttps://demo.ddev.site/typo3/\u001b[74G\u001b]8;;\u0007\u001b[39mshould\u001b[81Gopen\u001b[86Gthere\u001b[92Gwithout\u001b[100Gthe\u001b[104Gwarning\u001b[112Gright\u001b[118Gnow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 21s · done 7:33 AM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255m/exit\u001b[39m                                                                                                                                          \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m·\u001b[3GC\u001b[38;2;235;159;127mook\u001b[38;2;215;119;87ming… \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[37;1H\u001b[35;3H\u001b[?25h"]
