ine's\u001b[26Gtrust\u001b[32Gsettings.\u001b[42GAfter\u001b[48Git\u001b[51Gfinishes,\u001b[61Gfully\u001b[67Gclose\u001b[73Gthe\u001b[77Gbrowser\u001b[85G(every\u001b[92Gwindow)\u001b[100Gand\u001b[104Greopen\u001b[111G\u001b]8;id=yno1gn;https://demo.ddev.site/typo3/\u0007\u001b[94mhttps://demo.ddev.site/typo3/\u001b]8;;\u0007\u001b[39m.\u001b[142GThe\r\u001b[2C\u001b[1Bwarning\u001b[11Gshould\u001b[18Gbe\u001b[21Ggone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you don't\u001b[16Gw\u001b[18Gnt to change th\u001b[34G \u001b[36Grust set\u001b[45Gings,\u001b[51Gyou can click \u001b[1mAdvanced → Proceed to demo.ddev.site\u001b[22m fo\u001b[105G now.\u001b[111GThat only affects this local site.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 9s · done 7:32 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mlina-wolf@lina-wolf-ThinkPad-T14s-Gen-3:~/projects/typo3/t3ca-2026/demo$ mkcert -install\u001b[39m                                                       \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the system trust store! 👍\u001b[39m                                                                                \r\u001b[1B  \u001b[38;2;255;255;255mThe local CA is already installed in the Firefox and/or Chrome/Chromium trust store! 👍\u001b[39m                                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ xdg-settings get default-web-browser 2>&1; ls -d ~/snap/*/ 2>/dev/null; for d in ~/.pki/nssdb ~/snap/chromium/current/.pki/nssdb; do echo \r\u001b[5C\u001b[1B\"== $d\"; certutil -d sql:$d -L 2>&1 | grep -i mkcert; done; find ~/snap/firefox/common/.mozilla/firefox ~/.mozilla/firefox -maxdepth 1 -name\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m'*.default*