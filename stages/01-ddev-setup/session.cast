[194.038958, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m4\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;117;113;94m# type: <projecttype>  # asterios, backdrop, cakephp, codeigniter, craftcms, drupal, drupal6, drupal7, drupal8, drupal9, drupal\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m  \u001b[12G\u001b[38;2;117;113;94m10, drupal11, drupal12, generic, joomla, laravel, magento, magento2, maho, mo\u001b[90Gx, php, shopware6, si\u001b[112Gverstripe, symfony, typo3, \r\u001b[11C\u001b[1Bwordp\u001b[18Gess, wp-bedrock\u001b[38;2;248;248;242m                                                                                                          \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m26\u001b[12G\u001b[38;2;117;113;94m# See https://docs.ddev.com/en/stable/users/quickstart/ for more\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;117;113;94minformation on the different project types\u001b[38;2;248;248;242m                    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;117;113;94m# docroot: <relative_path> # Relative path to the directory containing index.php.\u001b[38;2;248;248;242m                                              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m30\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;117;113;94m# php_version: \"8.4\"  # PHP version to use; see https://docs.ddev.com/en/stable/users/configuration/config/#php_version.\u001b[38;2;248;248;242m       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[12G\u001b[38;2;117;113;94m# You can explicitly specify the webimage but this\u001b[38;2;248;248;242m                                                                             \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[14G\u001b[38;2;117;113;94mis not r\u001b[23Gcommended, as the\u001b[41Gimages are often\u001b[58Gclo\u001b[62Gely tied to DDEV's behavior,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;117;113;94mso\u001b[17Gthis can break upgrades.\u001b[38;2;248;248;242m                                                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;117;113;94m# webimage: <docker_image>\u001b[38;2;248;248;242m                                                                                                     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;117;113;94mIt’s unusual to change this option, and we don’t recommend it without Docker experience and a good reason.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[14G\u001b[38;2;117;113;94mTypically, this\u001b[30Gme\u001b[34Gs add\u001b[40Gti\u001b[43Gns to the existi\u001b[60Gg web i\u001b[68Gage using a .ddev/web-build/Dock\u001b[101Grfile.*\u001b[38;2;248;248;242m            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m40\u001b[12G\u001b[38;2;248;248;242m                                                                                                                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;2;153;153;153m… 266 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  (files that changed while this command ran, by the command or by another process; a convenience view, not a review or audit of the \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mcommand)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowe\u001b[13G by auto mode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDDEV\u001b[8Gconfig\u001b[15Gcreated\u001b[23G(project\u001b[32G\u001b[38;2;177;185;249mdemo\u001b[39m,\u001b[38GPHP\u001b[42G8.4,\u001b[47GMariaDB\u001b[55G11.8).\u001b[62GNow\u001b[66Gstarting\u001b[75Gthe\u001b[79Gcontainers\u001b[90Gand\u001b[94Grunning\u001b[102G\u001b[38;2;177;185;249mcomposer create-project\u001b[126G\u001b[39mfor\u001b[130GTYPO3\u001b[136Gv14.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRemoving\u001b[12GREADME\u001b[19Gtemporarily\u001b[31G(backed\u001b[39Gup)\u001b[43Gand\u001b[47Gcreating\u001b[56Gproject\u001b[38;2;153;153;153m · 4s\r\u001b[1"]
