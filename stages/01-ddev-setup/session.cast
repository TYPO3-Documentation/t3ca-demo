[1633.422657, "o", "\u001b[H\u001b[7G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m19\u001b[11G\u001b[38;2;248;248;242m### Setup\u001b[21G \u001b[23G    \u001b[28G        \u001b[37G     \u001b[43G   \u001b[47G     \u001b[53G    \u001b[58G  \u001b[61G        \u001b[70G   \u001b[74G          \u001b[85G             \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m20\u001b[11G\u001b[38;2;248;248;242m  \u001b[14G  \u001b[17G     \u001b[23G   \u001b[27G    \u001b[32G  \u001b[35G       \u001b[43G   \u001b[47G         \u001b[57G       \u001b[65G   \u001b[69G          \u001b[80G   \u001b[84G         \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m21\u001b[11G\u001b[38;2;248;248;242mTo start an interactiv\u001b[34G installation, you\u001b[53Gcan\u001b[57Gdo\u001b[60Gso\u001b[63Gby\u001b[66Gexecuting\u001b[76Gthe\u001b[80Gfollowing\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m22\u001b[11G\u001b[38;2;248;248;242mcommand\u001b[19Gand\u001b[23Gthen\u001b[28Gfollow\u001b[35Gthe\u001b[39Gwizard:\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m23\u001b[11G\u001b[38;2;248;248;242m       \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m24\u001b[11G\u001b[38;2;248;248;242m```bash                               \u001b[50G   \u001b[54G                  \u001b[73G \u001b[75G            \u001b[88G \u001b[90G    \u001b[95G     \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m25\u001b[25G\u001b[38;2;248;248;242mtypo3 setup   \u001b[40G \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m26\u001b[11G\u001b[38;2;248;248;242m```\u001b[15G                \u001b[32G \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m27\u001b[15G\u001b[38;2;248;248;242m                   \u001b[35G \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m28\u001b[11G\u001b[38;2;248;248;242m###\u001b[15GSetup unattend\u001b[30Gd (optional)\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 29 -\u001b[38;2;248;248;242m                                                                                                                                \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;220;90;90m