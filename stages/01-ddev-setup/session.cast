[1642.98663, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 17 \u001b[22m room for the night's catch and running water at every stall.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m18\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 19 -\u001b[38;2;248;248;242mTraders who sold at the old market keep \u001b[48;2;92;2;0mtheir\u001b[48;2;61;1;0m stall number. New traders apply                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 19 +\u001b[38;2;248;248;242mTraders who sold at the \u001b[48;2;4;71;0mthe \u001b[48;2;2;40;0mold market keep \u001b[48;2;4;71;0mthere\u001b[48;2;2;40;0m stall number. New traders apply                                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 20 \u001b[22m for a stall at the trade office in the municipal office. The market opens\r\u001b[6C\u001b[1B\u001b[2m21\u001b[12G\u001b[22maily from 5:00 to 18:00.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m22\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 33 \u001b[22m drainage. The works start on 3 November and run for about six weeks.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 34 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5\u001b[11G\u001b[22mDuring the works, matatus and lorries take the diversion via Market Street.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 36 -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mPedestrians\u001b[48;2;61;1;0m and bicycles can pass at all times. Shops along Beach Road stay                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 36 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mPedestrains\u001b[48;2;2;40;0m and bicycles can pass at all times. Shops along Beach Road stay                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 37 \u001b[22m open.\r\u001b[6C\u001b[1B\u001b[2m3\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m3\u001b[11G\u001b[22mContact: Roads Department, +254 700 000 020\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 48 \u001b[22m and 26 October at Ward 3 Primary School, from 8:00 to 16:00.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 49 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m0\u001b[11G\u001b[22mOn offer: eye tests, blood pressure and diabetes screening, and vaccinations\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 51 -\u001b[38;2;248;248;242mfor children. Bring your \u001b[48;2;92;2;0mhealth\u001b[48;2;61;1;0m card if you have one. No appointment is                                                         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 51 +\u001b[38;2;248;248;242mfor children. Bring your \u001b[48;2;4;71;0mhelth\u001b[48;2;2;40;0m card if you have one. No appointment is                                                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 52 \u001b[22m needed.\r\u001b[6C\u001b[1B\u001b[2m53\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m54\u001b[11G\u001b[22mContact: Heal\u001b[25Gh Department, +254 700 000 030\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 67 \u001b[22m Payment at the cash office in the municipal office stays possible. The land\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 68 \u001b[22m rates calculator on our website shows what you owe before you pay.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m69\r\u001b[5