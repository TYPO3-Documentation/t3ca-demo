[1935.768867, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gt\u001b[7Gat come\u001b[15G with TYPO3.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GW\u001b[7Gile I was working, another\u001b[34Gcommit,\u001b[42Galso\u001b[47Gnamed\u001b[53G\"Stage\u001b[60G00-start\"\u001b[70G(\u001b[38;2;177;185;249m5d4cc80\u001b[39m),\u001b[81Gappeared\u001b[90Gon\u001b[93G\u001b[38;2;177;185;249mmain\u001b[98G\u001b[39mand\u001b[102Gadded\u001b[108Ga\u001b[110G\u001b[38;2;177;185;249mdesign/\u001b[118G\u001b[39mfolder.\u001b[126GAt\u001b[129Gone\u001b[133Gpoint\u001b[139Ggit\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[7Gow\u001b[10Gd \u001b[38;2;177;185;249mdesign/docs/news-and-events.md\u001b[39m a\u001b[45G ch\u001b[49Gnged, but a later diff showed no chang\u001b[88Gs. I\u001b[93Gdidn't touch any\u001b[110Gof it, but you may\u001b[129Gwant to check\r\u001b[4C\u001b[1Bw\u001b[7Gat happened.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gcommitted\u001b[23Ganything.\u001b[33G\u001b[38;2;177;185;249m.ddev/\u001b[39m,\u001b[41G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[56G\u001b[38;2;177;185;249mcomposer.lock\u001b[39m,\u001b[71G\u001b[38;2;177;185;249mconfig/\u001b[79G\u001b[39mand\u001b[83G\u001b[38;2;177;185;249mpackages/\u001b[93G\u001b[39mare\u001b[97Gnew\u001b[101Gand\u001b[105Guntracked,\u001b[116Gready\u001b[122Gto\u001b[125Gcommit\u001b[132Gwhen\u001b[137Gyou\u001b[141Gwant.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 2m 17s · done 7:27 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mDont look at sister projects, only work in here\u001b[39m                                                                                                \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command, wrote \u001b[1m1\u001b[22m memory \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;25