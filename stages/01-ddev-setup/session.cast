[1934.821794, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GThe\u001b[9GComposer\u001b[18Ginstall\u001b[26Gonly\u001b[31Gruns\u001b[36Gin\u001b[39Gan\u001b[42Gempty\u001b[48Gdirectory,\u001b[59Gso\u001b[62GI\u001b[64Gset\u001b[68Gyour\u001b[73G\u001b[38;2;177;185;249mREADME.md\u001b[83G\u001b[39maside,\u001b[90Gput\u001b[94Git\u001b[97Gback\u001b[102Gafterwards,\u001b[114Gand\u001b[118Gkept\u001b[123Git\u001b[126Ginstead\u001b[134Gof\u001b[137Gthe\u001b[141Gone\r\u001b[2C\u001b[1B  that comes with TYPO3.\r\u001b[4C\u001b[1BW\u001b[7Gile I was working,\u001b[26Ga\u001b[28Gother commit,\u001b[42Galso named \"Stage 00-start\" (\u001b[38;2;177;185;249m5d4cc80\u001b[39m), appear\u001b[88Gd\u001b[90Gon \u001b[38;2;177;185;249mmain\u001b[39m \u001b[99Gnd\u001b[103Gdd\u001b[106Gd \u001b[109G \u001b[38;2;177;185;249mdesign/\u001b[118G\u001b[39mfolder.\u001b[126GAt one p\u001b[135Gin\u001b[138G git\u001b[K\r\u001b[4C\u001b[1Bs\u001b[7Gowed \u001b[38;2;177;185;249mdesign/docs/news-and-events.md\u001b[43G\u001b[39mas\u001b[46Gchanged,\u001b[55Gbut\u001b[59Ga\u001b[61Glater\u001b[67Gdiff\u001b[72Gshowed\u001b[79Gno\u001b[82Gchanges.\u001b[91GI\u001b[93Gdidn't\u001b[100Gtouch\u001b[106Gany\u001b[110Gof\u001b[113Git,\u001b[117Gbut\u001b[121Gyou\u001b[125Gmay\u001b[129Gwant\u001b[134Gto\u001b[137Gcheck\r\u001b[2C\u001b[1B \u001b[5Gw\u001b[7Gat happened.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't committed\u001b[23Ganything.\u001b[33G\u001b[38;2;177;185;249m.ddev/\u001b[39m,\u001b[41G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[56G\u001b[38;2;177;185;249mcomposer.lock\u001b[39m,\u001b[71G\u001b[38;2;177;185;249mconfig/\u001b[79G\u001b[39mand\u001b[83G\u001b[38;2;177;185;249mpackages/\u001b[93G\u001b[39mare\u001b[97Gnew\u001b[101Gand\u001b[105Guntracked,\u001b[116Gready\u001b[122Gto\u001b[125Gcommit\u001b[132Gwhen\u001b[137Gyou\u001b[141Gwant.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 2m 17s · done 7:27 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mDont look at sister projects, only work in here\u001b[39m                                                                                                \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command, wrote \u001b[1m1\u001b[22m memory \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mUnderstood. I'll only work in \u001b[38;2;177;185;249m/home/lina-wolf/projects/typo3/t3ca-2026/demo\u001b[79G\u001b[39mfrom\u001b[84Gnow\u001b[88Gon.\r\u001b[2B \u001b[3GI \u001b[6Gid l\u001b[12Gk at your other projects twice, both times with \u001b[38;2;177;185;249mddev list\u001b[39m, which shows every DDEV\u001b[94Gproject\u001b[102Gon\u001b[105Gthe\u001b[109Gmachine.\u001b[118GI\u001b[120Gwas\u001b[124Gchecking\u001b[133Gwhether\u001b[141Gthe\r\u001b[2C\u001b[1Bproject\u001b[11Gname\u001b[16G\u001b[38;2;177;185;249mdemo\u001b[21G\u001b[39mwas\u001b[25Galready\u001b[33Gtaken.\u001b[40GThat\u001b[45Gcommand\u001b[53Gshowed\u001b[60Gyour\u001b[65G\u001b[38;2;177;185;249mtypo3-core-*\u001b[78G\u001b[39mprojects.\u001b[88GI\u001b[90Gdidn't\u001b[97Gread\u001b[102Gor\u001b[105Gchange\u001b[112Gany\u001b[116Gfiles\u001b[122Gin\u001b[125Gthem,\u001b[131Gand\u001b[135Geverything\r\u001b[2C\u001b[1Belse I did\u001b[14Gs\u001b[16Ga\u001b[18Ged in this dir\u001b[35Gory. If a name \u001b[51Gs ever taken in future, I'll just let\u001b[89G\u001b[38;2;177;185;249mddev config\u001b[39m or \u001b[38;2;177;185;249mddev start\u001b[39m report the conflict.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'v\u001b[8Gsave\u001b[14Gthis as a\u001b[24Gmemory, so it carries ov\u001b[49Gr to future sessions in this project.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 9s · done 7:27 AM\u001b[35G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mTYPO3 14.3.10 is now running with DDEV at https://demo.ddev