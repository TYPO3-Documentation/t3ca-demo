all so it would write \u001b[38;2;177;185;249mconfig/system/additional.php\u001b[39m, which holds \u001b[110Ghe database, mail and\u001b[132Gt\u001b[134Gus\u001b[139G-hosts\u001b[K\r\u001b[4C\u001b[1Bsettings.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo things to know\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GThe\u001b[9GComposer\u001b[18Ginstall\u001b[26Gonly\u001b[31Gruns\u001b[36Gin\u001b[39Gan\u001b[42Gempty\u001b[48Gdirectory,\u001b[59Gso\u001b[62GI\u001b[64Gset\u001b[68Gyour\u001b[73G\u001b[38;2;177;185;249mREADME.md\u001b[83G\u001b[39maside,\u001b[90Gput\u001b[94Git\u001b[97Gback\u001b[102Gafterwards,\u001b[114Gand\u001b[118Gkept\u001b[123Git\u001b[126Ginstead\u001b[134Gof\u001b[137Gthe\u001b[141Gone\r\u001b[2C\u001b[1B  that comes with TYPO3.\r\u001b[4C\u001b[1BW\u001b[7Gile I was working,\u001b[26Ga\u001b[28Gother commit,\u001b[42Galso named \"Stage 00-start\" (\u001b[38;2;177;185;249m5d4cc80\u001b[39m), appear\u001b[88Gd\u001b[90Gon \u001b[38;2;177;185;249mmain\u001b[39m \u001b[99Gnd\u001b[103Gdd\u001b[106Gd \u001b[109G \u001b[38;2;177;185;249mdesign/\u001b[118G\u001b[39mfolder.\u001b[126GAt one p\u001b[135Gin\u001b[138G git\u001b[K\r\u001b[4C\u001b[1Bs\u001b[7Gowed \u001b[38;2;177;185;249mdesign/docs/news-and-events.md\u001b[43G\u001b[39mas\u001b[46Gchanged,\u001b[55Gbut\u001b[59Ga\u001b[61Glater\u001b[67Gdiff\u001b[72Gshowed\u001b[79Gno\u001b[82Gchanges.\u001b[91GI\u001b[93Gdidn't\u001b[100Gtouch\u001b[106Gany\u001b[110Gof\u001b[113Git,\u001b[117Gbut\u001b[121Gyou\u001b[125Gmay\u001b[129Gwant\u001b[134Gto\u001b[137Gcheck\r\u001b[2C\u001b[1B \u001b[5Gw\u001b[7Gat happened.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't committed\u001b[23Ganything.\u001b[33G\u001b[38;2;177;185;249m.ddev/\u001b[39m,\u001b[41G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[56G\u001b[38;2;177;185;249mcomposer.lock\u001b[39m,\u001b[71G\u001b[38;2;177;185;249mconfig/\u001b[79G\u001b[39mand\u001b[83G\u001b[38;2;177;185;249mpa