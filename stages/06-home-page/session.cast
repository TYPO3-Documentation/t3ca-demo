[68.650604, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mAlready there:\u001b[18G\u001b[22mCSS\r\u001b[1B  ────────────────────────────────────────\r\u001b[1B  \u001b[1mSection:\u001b[12GEvents\u001b[22m\u001b[K\r\u001b[1B  \u001b[1mWhat you need:\u001b[22m Somewhere to store events:\u001b[45Gdate\u001b[50G(sometimes\u001b[61Ga\u001b[63Grange),\u001b[71Gtime,\u001b[77Gplace,\u001b[84Gcost,\u001b[90Gregistration.\r\u001b[4C\u001b[1BAlso\u001b[10Ga\u001b[12Glist\u001b[17Gfor\u001b[21Gthe\u001b[25Ghome\u001b[30Gpage\u001b[35Gthat\u001b[40Gshows\u001b[46Gonly\u001b[51Gupcoming\u001b[60Gevents,\u001b[68Gplus\u001b[73Ga\u001b[75Gdetail\u001b[82Gpage.\u001b[88GEXT:news\u001b[97Ghas\u001b[101Gno\r\u001b[4C\u001b[1Bdate\u001b[10Gfields\u001b[17Gfor\u001b[21Gevents,\u001b[29Gso\u001b[32Gthis\u001b[37Gneeds\u001b[43Ga\u001b[45Gdecision\u001b[54G(see\u001b[59Gbelow)\r\u001b[1B  \u001b[1mAlready there:\u001b[22m CSS; the content is in \u001b[38;2;177;185;249mdesign/docs/news-and-events.docx\u001b[39m\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mSection:\u001b[22m \u001b[1mNewsletter sign-up\r\u001b[2C\u001b[1BWhat you need:\u001b[18G\u001b[22mA\u001b[20Gform\u001b[25Gdefinition\u001b[36Gin\u001b[39GEXT:form\u001b[48G(email,\u001b[56Gtopics,\u001b[64Gconsent)\u001b[73Gand\u001b[77Gsomething\u001b[87Gthat\u001b[92Gactually\r\u001b[1B \u001b[3G  handl\u001b[11Gs th\u001b[17Gsubscription. The de\u001b[38Gign asks for double opt-in, whic\u001b[71G EXT:fo\u001b[79Gm d\u001b[83Gesn't do by itself.\r\u001b[2C\u001b[1B  You'd also need \u001b[38;2;177;185;249mdesign/js/forms.js\u001b[40G\u001b[39mfor the validation\u001b[59Gin the brows\u001b[72Gr\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAlready there:\u001b[22m EXT:form is\u001b[30Ginstalled; CSS\u001b[K\r\u001b[2B \u001b[3GAll of these are content elements\u001b[37Gstacked\u001b[45Gin\u001b[48Gthe\u001b[52Gexisting\u001b[61G\"main\"\u001b[68Gcolumn,\u001b[76Gso\u001b[79Gthe\u001b[83GHome\u001b[88Gbackend\u001b[96Glayout\u001b[103Gand\r\u001b[2C\u001b[1Btemplate\u001b[12Gdon't\u001b[18Gneed\u001b[23Gto\u001b[26Gchange.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mTwo decisions I need from you:\u001b[22m\u001b[K\r\u001b[2B \u001b[3G1. \u001b[1mHow to store events:\u001b[22m\u001b[K\r\u001b[1B     - Build them on top of news, with an \"is event\" flag and date fields. This reuses the news templates\r\u001b[5C\u001b[1B  and categories.\u001b[K\r\u001b[5C\u001b[1B- Or give the\u001b[20Gsitepackage\u001b[32Gits\u001b[36Gown\u001b[40Gevent\u001b[46Grecord\u001b[53Gtype\u001b[58Gand\u001b[62Gplugin.\u001b[70GThat's\u001b[77Gcleaner\u001b[85Gif\u001b[88Gevents\u001b[95Gwill\u001b[100Ggrow\r\u001b[7C\u001b[1B(registration,\u001b[23Gplaces).\r\u001b[1B \u001b[3G2. \u001b[1mWho handles newsletter subscriptions:\u001b[22m\u001b[K\r\u001b[1B     -\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[68.780578, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[25BEXT:form\u001b[17Gplus\u001b[22Ga\u001b[24Gsmall\u001b[30Gcustom\u001b[37Gstep\u001b[42Gthat\u001b[47Gstores\u001b[54Gthe\u001b[58Gsubscriber\u001b[69Gand\u001b[73Gsends\u001b[79Gthe\u001b[83Gconfirmation\u001b[96Gemail.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
