[455.108199, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[23B\u001b[38;2;177;185;249m\u001b[1mt\u001b[50Gt\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;153;153;153mcontext                       \u001b[47GShow what\u001b[57Gfills\u001b[63Gthe c\u001b[69Gnt\u001b[72Gx\u001b[74G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /typo3-\u001b[39m\u001b[1mex\u001b[22m\u001b[38;2;153;153;153mtens\u001b[39m\u001b[1mi\u001b[22m\u001b[38;2;153;153;153mon-asse\u001b[39m\u001b[1mt\u001b[22m\u001b[38;2;153;153;153m-build              The a\u001b[53Gset bu\u001b[60Gld of \u001b[67G TYPO3 ext\u001b[78Gnsion, sitepackage or\u001b[39m\u001b[K\r\u001b[2C\u001b[1B                                            \u001b[38;2;153;153;153mp\u001b[49Goject packa\u001b[62G: \u001b[65Gpm and package.json dependency updates,…\r\u001b[2C\u001b[2B\u001b[38;2;177;185;249m/exit\u001b[39m\u001b[31;1H\u001b[29;8H\u001b[?25h"]
