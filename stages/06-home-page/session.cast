[94.156765, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat you n\u001b[14Ged\u001b[18G\u001b[22mA custom\u001b[27Gcontent\u001b[35Gelement\u001b[43Gwith\u001b[48Gitems\u001b[54G(icon,\u001b[61Glabel,\u001b[68Glink\u001b[73Gto\u001b[76Ga\u001b[78Gpage).\u001b[85GAlternatively,\u001b[100Ga\r\u001b[2C\u001b[1B  menu of selected pages with an icon field\u001b[47Gon\u001b[50Geach\u001b[55Gpage\r\u001b[2C\u001b[1B\u001b[1mAlready there:\u001b[22m CSS\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSection:\u001b[12GEvents\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you need:\u001b[22m Som\u001b[22Gwhere to s\u001b[33Gore\u001b[37Gev\u001b[40Gnts:\u001b[46Gate (sometimes a range),\u001b[71Gtime,\u001b[77Gplace,\u001b[84Gcost,\u001b[90Gregistration.\r\u001b[2C\u001b[1B  Also a list for the home page\u001b[35Gthat shows only upcoming events, plus a\u001b[75Gdetail\u001b[82Gpage.\u001b[88GEXT:news\u001b[97Ghas\u001b[101Gno\r\u001b[2C\u001b[1B  date fields for events, so this needs a\u001b[45Gdecision\u001b[54G(see\u001b[59Gbelow)\r\u001b[2C\u001b[1B\u001b[1mAlready th\u001b[14Gre:\u001b[22m CSS; the content\u001b[35Gis\u001b[38Gin\u001b[41G\u001b[38;2;177;185;249mdesign/docs/news-and-events.docx\r\u001b[2C\u001b[1B\u001b[39m────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSection:\u001b[22m \u001b[1mNewsletter sign-up\u001b[31G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you need:\u001b[22m A form definition in EXT:form\u001b[48G(email, top\u001b[60Gcs, consent) and\u001b[77Gsomething\u001b[87Gthat\u001b[92Gactually\r\u001b[2C\u001b[1B  handles the subscription. The design asks\u001b[47Gfor\u001b[51Gdouble\u001b[58Gopt-in,\u001b[66Gwhich\u001b[72GEXT:form\u001b[81Gdoesn't\u001b[89Gdo\u001b[92Gby\u001b[95Gitself.\r\u001b[4C\u001b[1BYou'd\u001b[11Galso\u001b[16Gneed\u001b[21G\u001b[38;2;177;185;249mdesign/js/forms.js\u001b[40G\u001b[39mfor\u001b[44Gthe\u001b[48Gvalidation\u001b[59Gin\u001b[62Gthe\u001b[66Gbrowser\r\u001b[2C\u001b[1B\u001b[1mAlready there:\u001b[22m EXT:form is installed; CSS\u001b[45G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll\u001b[7Gof\u001b[10Gthese\u001b[16Gare\u001b[20Gcontent\u001b[28Gelements\u001b[37Gstacked\u001b[45Gin\u001b[48Gthe\u001b[52Gexisting\u001b[61G\"main\"\u001b[68Gcolumn,\u001b[76Gso\u001b[79Gthe\u001b[83GHome\u001b[88Gbackend\u001b[96Glayout\u001b[103Gand\r\u001b[2C\u001b[1Btemplate don't need to change.\r\u001b[2C\u001b[2B\u001b[1mTwo decisions I\u001b[19Gne\u001b[22Gd from you:\r\u001b[5C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mHow to store events:\r\u001b[7C\u001b[1B\u001b[22mBuild them on \u001b[23Go\u001b[25G of n\u001b[31Gws, with\u001b[40Gan \"is \u001b[48Gvent\" flag and date fields. This r\u001b[83Guses\u001b[88Gth\u001b[91G news templates\r\u001b[7C\u001b[1Band ca\u001b[15Gegories.\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- Or give the sitepackage its own \u001b[70GThat's\u001b[77Gcleaner\u001b[85Gif\u001b[88Gevents\u001b[95Gwill\u001b[100Ggrow\u001b[31;1H\u001b[29;3H\u001b[?25h"]
