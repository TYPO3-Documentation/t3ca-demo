[410.967517, "o", "\u001b[?25l\u001b[H \u001b[3G   \u001b[2m 32 \u001b[22m  \u001b[13G      --tabl\u001b[26G=\u001b[28Gx_news_domain_model_news --\u001b[56Gable=tx_news_domai\u001b[75G_model_link \\\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 31 -\u001b[38;2;248;248;242m        --table=tx_news_domain_model_tag --\u001b[48;2;92;2;0minclude-related\u001b[48;2;61;1;0m=\u001b[48;2;92;2;0msys_file\u001b[48;2;61;1;0m \\                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 33 +\u001b[38;2;248;248;242m        --table=tx_news_domain_model_tag --\u001b[48;2;4;71;0mtable\u001b[48;2;2;40;0m=\u001b[48;2;4;71;0mtx_mtosafisitepackage_tile\u001b[48;2;2;40;0m \\            \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 34 +\u001b[38;2;248;248;242m        --include-related=sys_file \\                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 35 \u001b[19G\u001b[22m--include-related=sys_file_reference\u001b[56G--include-related=sys_file_metadata\u001b[92G\\\r\u001b[1B \u001b[3G   \u001b[2m 36 \u001b[11G\u001b[22m        --s\u001b[23Gve-files-o\u001b[34Gtside-export-file data\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 37 \u001b[22m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  92 \u001b[22m plugi\u001b[18G's list page. The detail page uses the\u001b[57Gpage\u001b[62Glayout\u001b[69G\"Article\",\u001b[80Gwhich\u001b[86Gleaves\r\u001b[5C\u001b[1B\u001b[2m  93 \u001b[22m the heading to the n\u001b[33Gws. Addresses are `/news/artic\u001b[64Ge/<news>`\u001b[74Gand\r\u001b[5C\u001b[1B\u001b[2m \u001b[8G94\u001b[11G\u001b[22m `/news/page-2`\u001b[27G(`Configuration/Sets/Sitepackage/route-enhancers.yaml`).\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  95 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m  96 +\u001b[38;2;248;248;242m## Service tiles                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m  97 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  98 +\u001b[38;2;248;248;242mThe content element \"Service tiles\" (group \"Mto Safi\" in the content wizard)            \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  99 +\u001b[38;2;248;248;242mrenders the design's \"Popular services\": a heading and a grid of tiles, each            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 100 +\u001b[38;2;248;248;242mwith an emoji as icon, a label and a link. The tiles are records of                     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 101 +\u001b[38;2;248;248;242m`tx_mtosafisitepackage_tile` that belong to the element and are edited, sorted,         \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 102 +\u001b[38;2;248;248;242mhidden and translated inside its form. The heading is required, because the             \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 103 +\u001b[38;2;248;248;242msection is named by it; header type \"Hidden\" keeps it for screen readers only.          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 104 +\u001b[38;2;248;248;242mThe template is `Resources/Private/Templates/Content/Tiles.fluid.html`, the             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 105 +\u001b[38;2;248;248;242mpage module preview `Resources/Private/Templates/ContentPreviews/Tiles.fluid.html`.     \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  Allow\u001b[12Gd by auto\u001b[22Gmod\u001b[26G\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mRecombobulating…\u001b[39m\u001b[31;1H\u001b[29;3H\