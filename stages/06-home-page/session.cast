[318.213301, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[K\r\u001b[8C\u001b[1B    The heading is part of the sectio\u001b[47G rath\u001b[53Gr than\u001b[60Gthe\u001b[64Gframe's\u001b[72Gown\u001b[76Gheader,\u001b[84Gso\u001b[87Gthe\r\u001b[8C\u001b[1B    section can name it\u001b[33Gelf\u001b[37Gby\u001b[40Git.\u001b[44GHeader\u001b[51Gtype\u001b[56G\"Hidden\"\u001b[65Gkeeps\u001b[71Git\u001b[74Gfor\u001b[78Gscreen\u001b[85Greaders.\r\u001b[10C\u001b[1B  The icon is decoration:\u001b[37Gthe\u001b[41Glabel\u001b[47Galone\u001b[53Gnames\u001b[59Gthe\u001b[63Glink.\r\u001b[8C\u001b[1B</f:comment>\r\u001b[5C\u001b[1B\u001b[2m 9 \u001b[22m<f:layout\u001b[19G\u001b[38;2;166;226;46mname\u001b[39m=\u001b[38;2;230;219;116m\"Default\"\u001b[34G\u001b[39m/>\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153m… +19 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1d7w2oe;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Templates/ContentPreviews/Tiles.fluid.html\u0007~/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/…/Tiles.fluid.html\u001b]8;;\u0007)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m15\u001b[15G\u001b[22mlines to \u001b]8;id=1d7w2oe;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Templates/ContentPreviews/Tiles.fluid.html\u0007\u001b[1m~/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private\u001b]8;;\u0007\r\u001b[5C\u001b[1B\u001b]8;id=1d7w2oe;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Templates/ContentPreviews/Tiles.fluid.html\u0007/Templates/ContentPreviews/Tiles.fluid.html\u001b]8;;\u0007\r\u001b[6C\u001b[1B\u001b[22m\u001b[2m 1 \u001b[22m<html \u001b[38;2;166;226;46mxmlns:f\u001b[39m=\u001b[38;2;230;219;116m\"http://typo3.org/ns/TYPO3/CMS/Fluid/ViewHelpers\"\