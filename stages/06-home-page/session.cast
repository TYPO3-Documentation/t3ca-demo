.fluid.html\u0007/Templates/ContentPreviews/Tiles.fluid.html\u001b[22m\u001b]8;;\u0007\u001b[K\r\u001b[7C\u001b[1B\u001b[2m1\u001b[10G\u001b[22m<html \u001b[38;2;166;226;46mxmlns:f\u001b[39m=\u001b[38;2;230;219;116m\"http://typo3.org/ns/TYPO3/CMS/Fluid/ViewHelpers\"\u001b[74G\u001b[38;2;166;226;46mdata-namespace-typo3-fluid\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m \u001b[10G\u001b[22m=\u001b[38;2;230;219;116m\"true\"\u001b[39m>\u001b[K\r\u001b[7C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m<f:comm\u001b[18Gnt>\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[14G\u001b[22mPage module preview \u001b[35Gf\u001b[37G\"S\u001b[40Grvice tiles\": one line\u001b[63Gper\u001b[67Gtil\u001b[71G, with its icon, its\u001b[92Glabel\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m    and where\u001b[24Git\u001b[27Glinks\u001b[33Gto.\u001b[37GThe\u001b[41Gheader\u001b[48Gis\u001b[51Grendered\u001b[60Gby\u001b[63Gthe\u001b[67Gpage\u001b[72Gmodule\u001b[79Gabove\u001b[85Gthis.\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m/f:comment>\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m<ul>\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[14G\u001b[22m<f:for \u001b[38;2;166;226;46meach\u001b[39m=\u001b[38;2;230;219;116m\"{record.tx_mtosafisitepackage_tiles}\"\u001b[65G\u001b[38;2;166;226;46mas\u001b[39m=\u001b[38;2;230;219;116m\"tile\"\u001b[39m>\r\u001b[7C\u001b[1B\u001b[2m8\u001b[18G\u001b[22m<li>\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m       \u001b[22G<f:if\u001b[28G\u001b[38;2;166;226;46mcondition\u001b[39m=\u001b[38;2;230;219;116m\"{tile.icon}\"\u001b[39m>{tile.icon}\u001b[64G</f:if><strong>{tile.label}</strong>\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +6 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✶\u001b[39m \u001b[38;2;215;119;87mRecombobulating… \u001b[38;2;153;153;153m(2m 17s · ↓\u001b[39m \u001b[38;2;153;153;153m15.0k \u001b[39Gokens · \u001b[38;2;193;193;193mthinking\u001b[38;2;153;153;153m)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Tip