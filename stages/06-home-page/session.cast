[94.97909, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mCalled typo3-dev-companion, ran \u001b[1m4\u001b[22m shell commands \u001b[53G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mY\u001b[5Gur sitepackage already has the CSS for all four s\u001b[55Gctions. The SCSS was copied over from the design, so\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m.slider\u001b[39m, \u001b[38;2;177;185;249m.tiles\u001b[39m,\u001b[20G\u001b[38;2;177;185;249m.events\u001b[39m,\u001b[29G\u001b[38;2;177;185;249m.newsletter\u001b[39m and\u001b[45Gthe\u001b[49Gform\u001b[54Gstyles\u001b[61Gare\u001b[65Gall\u001b[69Gin\u001b[72G\u001b[38;2;177;185;249mmain.css\u001b[39m.\u001b[82GWhat's\u001b[89Gmissing\u001b[97Gis\u001b[100Gthe\r\u001b[2C\u001b[1Bcontent\u001b[11Gbehind\u001b[18Gthem,\u001b[24Gplus\u001b[29Gtwo\u001b[33Gscripts.\u001b[42GThe\u001b[46Ghome\u001b[51Gpage\u001b[56Grenders\u001b[64Gwhatever\u001b[73Gsits\u001b[78Gin\u001b[81Gits\u001b[85Gsingle\u001b[92G\"main\"\u001b[99Gcolumn,\r\u001b[2C\u001b[1Band today that's\u001b[20Gonly\u001b[25Gthe\u001b[29Gnews\u001b[34Gplugin.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSection:\u001b[22m \u001b[1mSlider\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you n\u001b[14Ged\u001b[18G\u001b[22mA custom\u001b[27Gcontent\u001b[35Gelement\u001b[43Gwith\u001b[48Gchild\u001b[54Gslides\u001b[61G(image,\u001b[69Gheading,\u001b[78Gtext,\u001b[84Gbutton\u001b[91Glink),\u001b[98Gits\r\u001b[2C\u001b[1B  Fluid template, and \u001b[38;2;177;185;249mdesign/js/slider.js\u001b[45G\u001b[39mcopied\u001b[52Ginto\u001b[57Gthe\u001b[61Gsitepackage\u001b[73Gand\u001b[77Gincluded\u001b[86Glike\u001b[91G\u001b[38;2;177;185;249mnavigation.js\r\u001b[2C\u001b[1B\u001b[39m\u001b[1mAlready th\u001b[15Ge:\u001b[22m CSS\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSection:\u001b[22m \u001b[1mService tiles\u001b[22m\u00