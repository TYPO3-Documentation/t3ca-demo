[412.091226, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 33 +\u001b[38;2;248;248;242m        --table=tx_news_domain_model_tag --\u001b[48;2;4;71;0mtable\u001b[48;2;2;40;0m=\u001b[48;2;4;71;0mtx_mtosafisitepackage_tile\u001b[48;2;2;40;0m \\            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 34 +\u001b[38;2;248;248;242m        --include-related=sys_file \\                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 35 \u001b[22m         --include-related=sys_file_reference --include-related=sys_file_metadata \\\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 36 \u001b[22m         --save-files-outside-export-file data\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[19G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 92 \u001b[12G\u001b[22mplugin's\u001b[21Glist\u001b[26Gpage.\u001b[32GThe\u001b[36Gdetail\u001b[43Gpage\u001b[48Guses\u001b[53Gthe\u001b[57Gpage\u001b[62Glayout\u001b[69G\"Article\",\u001b[80Gwhich\u001b[86Gleaves\r\u001b[5C\u001b[1B\u001b[2m  93 \u001b[12G\u001b[22mthe\u001b[16Gheading\u001b[24Gto\u001b[27Gthe\u001b[31Gnews.\u001b[37GAddresses\u001b[47Gare\u001b[51G`/news/article/<news>`\u001b[74Gand\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m`/news/page-2` (`Configura\u001b[39Gion/Sets/Sitepackage/route-enhancers.yaml`).\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  95 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m  96 +\u001b[38;2;248;248;242m## Service tiles                                                                        \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\r\u001b[8C\u001b[1B8\u001b[12G\u001b[38;2;248;248;242mThe content e\u001b[27Gment\u001b[32G\"Service\u001b[41Gtiles\"\u001b[48G(group\u001b[55G\"Mto\u001b[60GSafi\"\u001b[66Gin\u001b[69Gthe\u001b[73Gcontent\u001b[81Gwizard)\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242mrenders\u001b[20Gthe\u001b[24Gdesign's\u001b[33G\"Popular\u001b[42Gservices\":\u001b[53Ga\u001b[55Gheading\u001b[63Gand\u001b[67Ga\u001b[69Ggrid\u001b[74Gof\u001b[77Gtiles,\u001b[84Geach\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m100\u001b[12G\u001b[38;2;248;248;242mwith a\u001b[19G \u001b[21Gmoji as icon, a label and a link.\u001b[55GThe tiles are\u001b[69Grecords of \u001b[81G       \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m101\u001b[12G\u001b[38;2;248;248;242m`tx_mtosafisitepackage_tile` that belong\u001b[53Gto the element and are ed\u001b[79Gt\u001b[81Gd\u001b[84Gsorted,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[12G\u001b[38;2;248;248;242mh\u001b[14Gdden and tran\u001b[28Glated inside its form. The\u001b[55Gheading is \u001b[68Gquired, because\u001b[84Gthe\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[12G\u001b[38;2;248;248;242msection is nam\u001b[27Gd by it; header type \"Hidden\" k\u001b[59Geps it for scre\u001b[75Gn readers \u001b[86Gnly. \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242mThe template is `Resources/Pr\u001b[42Gvate/Templates/Content/Tiles.fluid.html`,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242mpage module pr\u001b[27Gview\u001b[32G`Resourc\u001b[41Gs/Private/Templat\u001b[59Gs/Con\u001b[65GentPrevi\u001b[74Gws/Tiles.fluid.html`.\r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[31;1H\u001b[29;3H\u001b[?25h"]
