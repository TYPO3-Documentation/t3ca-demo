[169.624906, "o", "\u001b[?25l\u001b[H\u001b[3G- The last news entry (\"Youth bursaries\")\u001b[45Gis\u001b[48Gcut\u001b[52Goff\u001b[56Gmid-sentence.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThes\u001b[9Gshould be f\u001b[21Gxed when the content goes in, not copied as\u001b[65Gth\u001b[68Gy are.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you answer\u001b[17Gthe\u001b[21Gtwo\u001b[25Gquestions,\u001b[36GI'll\u001b[41Gbuild\u001b[47Git\u001b[50Gin\u001b[53Gthis\u001b[58Gorder:\u001b[65Gslider\u001b[72Gand\u001b[76Gtiles\u001b[82Gfirst\u001b[88G(no\u001b[92Gopen\r\u001b[2C\u001b[1Bdecision\u001b[12G), then events, then\u001b[33Gthe newsletter.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 31s · done 11:31 AM\u001b[34G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mhat sounds like a lot. What should I start with, and why?\u001b[39m                                               \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mStart\u001b[9Gwith\u001b[14Gthe\u001b[18G\u001b[1mservice tiles\u001b[22m:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's the smallest piece.\u001b[30G\u001b[22mIt's\u001b[35Ga\u001b[37Glist\u001b[42Gof\u001b[45Glinks,\u001b[52Geach\u001b[57Gwith\u001b[62Gan\u001b[65Gicon\u001b[70Gand\u001b[74Ga\u001b[76Glabel.\u001b[83GThere's\u001b[91Gno\u001b[94GJavaScript,\r\u001b[1B    no new data model and nothing to decide first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt sets up the pattern for the slider.\u001b[44G\u001b[22mBoth\u001b[49Gare\u001b[53Gcustom\u001b[60Gcontent\u001b[68Gelements\u001b[77Gthat\u001b[82Ghold\u001b[87Ga\u001b[89Glist\u001b[94Gof\u001b[97Gitems.\r\u001b[1B \u001b[3G  Once the\u001b[15Giles work, the slider\u001b[37Gis\u001b[40Gthe\u001b[44Gsame\u001b[49Gshape\u001b[55Gwith\u001b[60Gan\u001b[63Gimage,\u001b[70Gtext\u001b[75Gand\u001b[79Ga\u001b[81Gbutton\u001b[88Gper\u001b[92Gitem,\u001b[98Gplus\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mslider.js\u001b[39m.\u001b[16GBuilding\u001b[25Gthe\u001b[29Gtiles\u001b[35Gfirst\u001b[41Gmeans\u001b[47Gthe\u001b[51Gslider\u001b[58Gis\u001b[61Gmostly\u001b[68Ga\u001b[70Gcopy\u001b[75Gof\u001b[78Ga\u001b[80Gpattern\u001b[88Gthat\u001b[93Galready\u001b[101Gworks.\r\u001b[4C\u001b[1B\u001b[1mThe links \u001b[16Gostly hav\u001b[26G somewhere to go.\u001b[22m \"La\u001b[48Gd rates\"\u001b[57Galready\u001b[65Ghas a design page\u001b[83G(\u001b[38;2;177;185;249mland-rates.html\u001b[39m). The\r\u001b[4C\u001b[1Bother tiles\u001b[17Gcan poi\u001b[25Gt\u001b[27Gt\u001b[29G placeh\u001b[37Gl\u001b[40Gr pages until\u001b[54Gthose\u001b[60Gpages\u001b[66Gexist.\r\u001b[4C\u001b[1B\u001b[1mYou'll see\u001b[16Git righ\u001b[24G away.\u001b[22m It's a full sec\u001b[47Gion on the home page\u001b[68Gthat matches t\u001b[83Ge \u001b[86Gesign, and\u001b[99G's done\r\u001b[4C\u001b[1Bi\u001b[7G one step.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAfter that:\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[170.070013, "o", "\u001b[?25l\u001b[H\u001b[3GThes\u001b[9Gshould be\u001b[19Gfixed\u001b[25Gwhen \u001b[32Ge content goes in, n\u001b[53Gt copied as th\u001b[68Gy\u001b[70Gare.\r\u001b[2C\u001b[2BIf you answer the two\u001b[25Gqu\u001b[28Gstions, I'll build\u001b[48Gt i\u001b[52G \u001b[54Ghis or\u001b[61Ger:\u001b[65Gslider and\u001b[76Gtiles\u001b[82Gfirst\u001b[88G(no\u001b[92Gopen\r\u001b[2C\u001b[1Bdecisions),\u001b[15Gthen\u001b[20Gevents,\u001b[28Gthen\u001b[33Gthe\u001b[37Gnewsletter.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 31s · done 11:31 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mhat sounds like a lot. What should I start with, and why?\u001b[39m                                               \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Start with the \u001b[1mservice tiles\u001b[22m:\u001b[K\r\u001b[2B \u001b[3G- \u001b[1mIt's the small\u001b[20Gst piece.\u001b[22m It's\u001b[35Ga\u001b[37Glist\u001b[42Gof\u001b[45Glinks,\u001b[52Geach\u001b[57Gwith\u001b[62Gan\u001b[65Gicon\u001b[70Gand\u001b[74Ga\u001b[76Glabel.\u001b[83GThere's\u001b[91Gno\u001b[94GJavaScript,\r\u001b[4C\u001b[1Bno\u001b[8Gnew\u001b[12Gdata\u001b[17Gmodel\u001b[23Gand\u001b[27Gnothing\u001b[35Gto\u001b[38Gdecide\u001b[45Gfirst.\r\u001b[6C\u001b[1B\u001b[1m \u001b[9Ge\u001b[11Gs up the pattern for the slider.\u001b[22m Both are custom content elements that hold a list\u001b[94Gof items.\u001b[K\r\u001b[4C\u001b[1BOnce the \u001b[15Giles work, the slider is the same shape\u001b[55Gwith\u001b[60Gan\u001b[63Gimage,\u001b[70Gtext\u001b[75Gand\u001b[79Ga\u001b[81Gbutton\u001b[88Gper\u001b[92Gitem,\u001b[98Gplus\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mslider.js\u001b[39m. Building the tiles first means the slider is mostly\u001b[68Ga copy of a pattern that already works.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe links mostly have somewhere to go.\u001b[44G\u001b[22m\"Land r\u001b[52Gt\u001b[54Gs\" already has a desig\u001b[77G p\u001b[80Gge (\u001b[38;2;177;185;249mland-rates.html\u001b[39m). The\r\u001b[4C\u001b[1Bother tiles can poin\u001b[26G to p\u001b[32Gaceholder p\u001b[44Gges unti\u001b[53G those pages exist.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mYou'\u001b[10Gl see it rig\u001b[23Gt away.\u001b[22m It's a full section on the home page that matches the design, and it's\u001b[102Gdone\r\u001b[4C\u001b[1Bin one st\u001b[15Gp.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAfter that:\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mSlider.\u001b[22m It's\u001b[19Gthe\u001b[23Gsame\u001b[28Gkind\u001b[33Gof\u001b[36Gelement\u001b[44Gas\u001b[47Gthe\u001b[51Gtiles\u001b[57Gplus\u001b[62Gone\u001b[66Gscript.\u001b[74GIt's\u001b[79Gthe\u001b[83Gmost\u001b[88Geye-catching\u001b[101Gpart\r\u001b[5C\u001b[1Bof\u001b[9Gthe\u001b[13Gdesign.\r\u001b[2C\u001b[1B2\u001b[31;1H\u001b[29;3H\u001b[?25h"]
