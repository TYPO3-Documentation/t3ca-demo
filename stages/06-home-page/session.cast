[422.564979, "o", "\u001b[?25l\u001b[H\u001b[3GFluid and label files show no errors.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mWhat I haven't seen:\u001b[22m the\u001b[28Gbackend\u001b[36Gform\u001b[41Gand\u001b[45Gthe\u001b[49GPage\u001b[54Gmodule\u001b[61Gpreview.\u001b[70GThere's\u001b[78Gno\u001b[81Gbrowser\u001b[89Gtool\u001b[94Ghere\u001b[99Gand\u001b[103GI\r\u001b[2C\u001b[1Bdon't\u001b[9Ghave\u001b[14Gthe\u001b[18Gadmin\u001b[24Gpassword.\u001b[34GIn\u001b[37Gthe\u001b[41GPage\u001b[46Gmodule\u001b[53Gyou\u001b[57Gshould\u001b[64Gsee\u001b[68Ga\u001b[70G\"Popular\u001b[79Gservices\"\u001b[89Gelement\u001b[97Glisting\r\u001b[1B \u001b[3Geach tile with its icon,\u001b[28Glabel an\u001b[37G link. T\u001b[46Gere are also no automated tests, because\u001b[87Gthe project has no\u001b[K\r\u001b[2C\u001b[1Btest setup y\u001b[16Gt.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors get:\u001b[22m a new \"Service tiles\" \u001b[44Glement in a \"Mto Safi\" group\u001b[73Gof\u001b[76Gthe\u001b[80Gnew-content\u001b[92Gwizard\u001b[99G(the\r\u001b[2C\u001b[1Bslider and events c\u001b[23Gn join that group la\u001b[44Ger). It\u001b[52Ghas a requir\u001b[65Gd\u001b[67Gheading\u001b[75Gand\u001b[79Ga\u001b[81Glist\u001b[86Gof\u001b[89Gtiles.\u001b[96GEach\u001b[101Gtile\r\u001b[2C\u001b[1Bhas an emoji icon,\u001b[22Ga\u001b[24Glabel\u001b[30Gand\u001b[34Ga\u001b[36Glink,\u001b[42Gand\u001b[46Geditors\u001b[54Gadd,\u001b[59Greorder,\u001b[68Ghide\u001b[73Gand\u001b[77Gtranslate\u001b[87Gtiles\u001b[93Ginside\u001b[100Gthe\r\u001b[1B  element. Setting the header type to \"Hidden\" keeps the heading\u001b[66Gfor\u001b[70Gscreen\u001b[77Greaders\u001b[85Gonly.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThree tiles point to stand-in pages,\u001b[22m b\u001b[42Gcause the page tree has\u001b[66Gno page\u001b[74Gfor th\u001b[81Gm yet:\r\u001b[2C\u001b[1B-\u001b[5G\"Water\u001b[12Gconnection\"\u001b[24Ggoes\u001b[29Gto\u001b[32G\"Environment\u001b[45G&\u001b[47Gwater\"\r\u001b[2C\u001b[1B-\u001b[5G\"Market stalls\" goes to \"Market fees\"\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\"Report a problem\" goes to \"Contact\"\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEditors can change these in the backend once the real pages exist.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges outside the element itself:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew seed script\u001b[21G\u001b[22m\u001b[38;2;177;185;249mBuild/Initialisation/seed-home.php\u001b[39m.\u001b[57GI\u001b[59Gran\u001b[63Git\u001b[66Gon\u001b[69Gyour\u001b[74Ginstallation\u001b[87Gand\u001b[91Gre-exported\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m,\u001b[30Gso\u001b[33Ga\u001b[35Gfresh\u001b[41Ginstall\u001b[49Ggets\u001b[54Gthe\u001b[58Gtiles\u001b[64Gtoo.\u001b[69GThe\u001b[73Gexport\u001b[80Gdiff\u001b[85Gis\u001b[88Gclean:\u001b[95Gthe\u001b[99Gnew\r\u001b[1B    element and tiles, plus\u001b[29Gone\u001b[33Gpage's\u001b[40G\"last\u001b[46Gchanged\"\u001b[55Gtimestamp.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22mI\u001b[15Gadded\u001b[21Gthe\u001b[25Gseed\u001b[30Gstep\u001b[35Gand\u001b[39Gthe\u001b[43Gnew\u001b[47Gtable\u001b[53Gto\u001b[56Gthe\u001b[60Gexport\u001b[67Gcommand\u001b[75G(without\u001b[84Gthat\u001b[89Gtable,\u001b[96Gthe\u001b[100Gtiles\r\u001b[1B \u001b[3G  would be left out of the export silently), plus a short section\u001b[69Gabout\u001b[75Gthe\u001b[79Gelement.\r\u001b[1B  -\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[422.696224, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mEditors group:\u001b[20G\u001b[22mnew\u001b[24Ginstallations\u001b[38Gget\u001b[42Gthe\u001b[46Gelement\u001b[54Gand\u001b[58Gthe\u001b[62Gtile\u001b[67Gtable\u001b[73Gautomatically.\u001b[88GYour\u001b[93Gexisting\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[422.953892, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat I haven't seen:\u001b[22m the backend form\u001b[41Gand\u001b[45Gthe\u001b[49GPage\u001b[54Gmodule\u001b[61Gpreview.\u001b[70GThere's\u001b[78Gno\u001b[81Gbrowser\u001b[89Gtool\u001b[94Ghere\u001b[99Gand\u001b[103GI\r\u001b[2C\u001b[1Bdon't\u001b[9Ghave\u001b[14Gthe\u001b[18Gadmin\u001b[24Gpassword.\u001b[34GIn\u001b[37Gthe\u001b[41GPage\u001b[46Gmodule\u001b[53Gyou\u001b[57Gshould\u001b[64Gsee\u001b[68Ga\u001b[70G\"Popular\u001b[79Gservices\"\u001b[89Gelement\u001b[97Glisting\r\u001b[2C\u001b[1Beach tile with its icon,\u001b[28Gl\u001b[30Gbel and link. There \u001b[51Gr\u001b[54Galso no automated test\u001b[77G, because the proj\u001b[96Gct\u001b[99Ghas\u001b[103Gno\r\u001b[2C\u001b[1Btest setup\u001b[14Gyet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat editors get:\u001b[21G\u001b[22ma\u001b[23Gnew\u001b[27G\"Service\u001b[36Gtiles\"\u001b[43Gelement\u001b[51Gin\u001b[54Ga\u001b[56G\"Mto\u001b[61GSafi\"\u001b[67Ggroup\u001b[73Gof\u001b[76Gthe\u001b[80Gnew-content\u001b[92Gwizard\u001b[99G(the\r\u001b[2C\u001b[1Bslider\u001b[10Gand\u001b[14Gevents\u001b[21Gcan\u001b[25Gjoin\u001b[30Gthat\u001b[35Ggroup\u001b[41Glater).\u001b[49GIt\u001b[52Ghas\u001b[56Ga\u001b[58Grequired\u001b[67Gheading\u001b[75Gand\u001b[79Ga\u001b[81Glist\u001b[86Gof\u001b[89Gtiles.\u001b[96GEach\u001b[101Gtile\r\u001b[2C\u001b[1Bhas an emoji icon, a label and a\u001b[36Gl\u001b[38Gnk, and edi\u001b[50Gors\u001b[55Gdd, reorder, hide\u001b[73Gand tra\u001b[81Gslate \u001b[88Giles \u001b[94Gnsi\u001b[98Ge \r\u001b[2C\u001b[1Be\u001b[5Gem\u001b[8Gnt. Setti\u001b[18Gg the header type t\u001b[38G \"Hidd\u001b[45Gn\" keeps the\u001b[58Gh\u001b[60Gad\u001b[63Gng for screen re\u001b[80Gder\u001b[84G only.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThree tiles point to stand-in pages,\u001b[22m because\u001b[48Gth\u001b[51G page tr\u001b[60Ge has\u001b[66Gn\u001b[68G page for them yet:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\"Water\u001b[12Gconnection\"\u001b[24Ggoes\u001b[29Gto\u001b[32G\"Environment\u001b[45G&\u001b[47Gwater\"\r\u001b[2C\u001b[1B- \"Market stalls\" goes to \"Market fees\"\u001b[K\r\u001b[5C\u001b[1BRepo\u001b[11Gt a problem\u001b[33GContact\"\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEditors can\u001b[15Gchang\u001b[21G thes\u001b[27G in the backend\u001b[43Gonce\u001b[48Gthe\u001b[52Greal\u001b[57Gpages\u001b[63Gexist.\r\u001b[2C\u001b[2B\u001b[1mChanges outside the element itself:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew seed script\u001b[21G\u001b[22m\u001b[38;2;177;185;249mBuild/Initialisation/seed-home.php\u001b[39m.\u001b[57GI\u001b[59Gran\u001b[63Git\u001b[66Gon\u001b[69Gyour\u001b[74Ginstallation\u001b[87Gand\u001b[91Gre-exported\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m, so a fresh\u001b[41Ginstall\u001b[49Ggets\u001b[54Gthe\u001b[58Gtiles\u001b[64Gtoo.\u001b[69GThe\u001b[73Gexport\u001b[80Gdiff\u001b[85Gis\u001b[88Gclean:\u001b[95Gthe\u001b[99Gnew\r\u001b[2C\u001b[1B \u001b[5Gelement and tiles, plus one page's \"last changed\" timestamp.\u001b[66G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m I added the seed\u001b[31Gtep\u001b[35Gand the new table to the export command (wi\u001b[79Ghout that table, the tiles\r\u001b[4C\u001b[1Bwould be lef\u001b[18G out of the export silently), plus a\u001b[55Gshort section\u001b[69Gabout\u001b[75Gthe\u001b[79Gelement.\r\u001b[4C\u001b[1B\u001b[1mEditors group:\u001b[22m new installations get th\u001b[45G element and th\u001b[61G tile\u001b[67Gtable automatically. Your \u001b[94Gxisting\u001b[K\r\u001b[4C\u001b[1B\"Editors\" group was creat\u001b[31Gd before this, so I updated it directly in the database\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[423.248898, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mDatabase backup\u001b[21G\u001b[22mfrom\u001b[26Gbefore\u001b[33Gthe\u001b[37Gseed:\u001b[31;1H\u001b[29;3H\u001b[?25h"]
