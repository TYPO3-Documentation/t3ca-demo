[401.90606, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRecords\u001b[11Gare\u001b[15Gin,\u001b[19Gin\u001b[22Gthe\u001b[26Gright\u001b[32Gorder.\u001b[39GNow\u001b[43Gthe\u001b[47Gfrontend:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe frontend markup\u001b[23Gmatches\u001b[31Gthe\u001b[35Gdesign.\u001b[43GNow\u001b[47Gthe\u001b[51Gbackend\u001b[59Gside:\u001b[65Gthe\u001b[69Gpreview\u001b[77Gand\u001b[81Gthe\u001b[85Gform\u001b[90Gneed\u001b[95Ga\u001b[97Glook\u001b[102Gin\u001b[105Ga\r\u001b[2C\u001b[1Breal\u001b[8Gbrowser.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion, ran \u001b[1m4\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Glocal \"Editors\" group predates the new\u001b[46Gelement, so editor\u001b[66Gcan't u\u001b[74Ge it\u001b[79Gy\u001b[81Gt. I'll add the element\r\u001b[2C\u001b[1Band\u001b[7Gthe\u001b[11Gtile\u001b[16Gtable\u001b[22Gto\u001b[25Gthat\u001b[30Ggroup,\u001b[37Gthe\u001b[41Gsame\u001b[46Gway\u001b[50Gthe\u001b[54Gsetup\u001b[60Gclass\u001b[66Gnow\u001b[70Gdoes\u001b[75Gfor\u001b[79Gnew\u001b[83Ginstallations:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNext,\u001b[9Gthe initial content\u001b[29Gexport. The README's\u001b[50Gexport\u001b[57Gcommand\u001b[65Ggets\u001b[70Gthe\u001b[74Gnew\u001b[78Gtable\u001b[84Gadded,\u001b[91Gotherwise\u001b[101Gthe\r\u001b[2C\u001b[1Btiles\u001b[9Gwould\u001b[15Gsilently\u001b[24Gmiss\u001b[29Gfrom\u001b[34G\u001b[38;2;177;185;249mdata.xml\u001b[39m:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Moving export into package and inspecting the diff\u001b[K\r\u