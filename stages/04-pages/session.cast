[368.618356, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mH\u001b[7Gader:\u001b[22m the service\u001b[25Glinks (E-\u001b[35Gervices portal, Contact) and the search f\u001b[77Grm\u001b[80Gappea\u001b[86G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFooter:\u001b[13G\u001b[22mthe \"Information\" column shows its four\u001b[53Glinks.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mLayouts:\u001b[22m Home uses the home layout, Search the sidebar-righ\u001b[65G layout and the E-se\u001b[86Gvices\u001b[92Gportal\u001b[99Gthe\r\u001b[2C\u001b[1B \u001b[5Gnarrow layout.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mP\u001b[7Gges:\u001b[22m all of\u001b[19Gth\u001b[22Gm\u001b[24Greturn 200 and non\u001b[43G is hidden. They have no c\u001b[70Gn\u001b[72Gent yet,\u001b[81Gand the \"Welcome to your\r\u001b[4C\u001b[1Bdefault website\"\u001b[22Gelement\u001b[30Gis\u001b[33Gdeleted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles (nothing committed):\u001b[30G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mBuild/Initialisation/seed-page-tree.php\u001b[39m:\u001b[46Gthe\u001b[50Gscript\u001b[57Gthat\u001b[62Gcreates\u001b[70Gthe\u001b[74Gtree.\u001b[80GTo\u001b[83Gchange\u001b[90Gthe\u001b[94Gtree,\u001b[100Gchange\r\u001b[2C\u001b[1B  this script, not the pages\u001b[32Gby\u001b[35Ghand.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mconfig/s\u001b[15Ges/main/settings.yaml\u001b[39m: points the serv\u001b[54Gce\u001b[57Gmenu, foo\u001b[68Gr\u001b[70Gmenu and sear\u001b[85G page s\u001b[93Gt\u001b[95Gings\u001b[100Gat\u001b[K\r\u001b[4C\u001b[1Bpages 22, 23\u001b[18Gand 16.\u001b[26G\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mpacka\u001b[11Ge\u001b[13G/mtosaf\u001b[21G_sitepackage/Initialisation/data.xml\u001b[39m: the\u001b[63Gexported tree, 26 pages.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Initialisation/Site/main/\u001b[39m:\u001b[61Ga\u001b[63Gcopy\u001b[68Gof\u001b[71Gthe\u001b[75Gsite\u001b[80Gconfig.\u001