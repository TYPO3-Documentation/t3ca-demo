[89.702389, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255mS\u001b[5Gow me th\u001b[15Gwebsite in\u001b[26Gmy browser.\u001b[39m                                                                     \r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThe website only shows a page called Home, and the menu is almost\u001b[39m                                       \r\u001b[1B  \u001b[38;2;255;255;255m       empty. What is missing, compared with the design?\u001b[39m                                                \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, called typo3-dev-companion, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTh\u001b[6G sit\u001b[12Gpackage\u001b[20Gitself is mos\u001b[34Gly\u001b[37Gfine: h\u001b[45Gader\u001b[51Gfooter, th\u001b[62G five page layouts and\u001b[85Gthe menu\u001b[94Gwiring are\u001b[105G\u001b[K\r\u001b[2C\u001b[1Ball there. What's missing is\u001b[32Galmost all c\u001b[45Gntent. The database\u001b[65Ghas\u001b[69Ga\u001b[71Gsingle\u001b[78Gpage,\u001b[84G\"Home\",\u001b[92Gwith\u001b[97Gone\r\u001b[2C\u001b[1B\"Welcome\u001b[12Gto\u001b[15Gyour\u001b[20Gdefault\u001b[28Gwebsite\"\u001b[37Gtext\u001b[42Gelement,\u001b[51Gand\u001b[55Gno\u001b[58Gfiles.\u001b[65GThe\u001b[69Gmenus\u001b[75Gare\u001b[79Gbuilt\u001b[85Gfrom\u001b[90Gthe\u001b[94Gpage\u001b[99Gtree,\u001b[105Gso\r\u001b[2C\u001b[1Bwith no pages\u001b[17Gunder Home the mai\u001b[36G menu shows only \"Home\".\r\u001b[2C\u001b[2BCompared\u001b[12Gwith\u001b[17G\u001b[38;2;177;185;249mdesign/README.md\u001b[34G\u001b[39mand\u001b[38G\u001b[38;2;177;185;249mdesign/index.html\u001b[39m:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPages\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMain m\u001b[12Gnu\u001b[15Gsection\u001b[23G:\u001b[22m Revenue & paymen\u001b[42Gs,\u001b[45GHealth, Environmen\u001b[64G & wat\u001b[71Gr, Trade\u001b[80G& tourism, Public\u001b[K\r\u001b[4C\u001b[1Bparticipation, Contact.\r\u001b[4C\u001b[1B\u001b[1mRevenue & payments subpages:\u001b[34G\u001b[22mLan\u001b[38G r\u001b[41Gtes s\u001b[47Gould sit under it, since it uses\u001b[80Gthe sidebar-left\u001b[97Glayout\r\u001b[2C\u001b[1B \u001b[5Gwith a sub-navigation.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mContact\u001b[22m (full width), \u001b[1mSearch\u001b[22m (sid\u001b[39Gbar right) and \u001b[1mLogin / e-services portal\u001b[22m (narrow).\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA folder\u001b[14Gfor the top service menu\u001b[22m (E-services portal,\u001b[59GC\u001b[61Gntact).\u001b[69G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA folder for the footer menu:\u001b[35G\u001b[22mAccessibility\u001b[49Gstatement,\u001b[60GPrivacy\u001b[68Gpolicy,\u001b[76GAccess\u001b[83Gto\u001b[86Ginformation,\u001b[99GTenders.\r\u001b[2C\u001b[1B- \u001b[1mThe Home page's l\u001b[23Gyout:\u001b[22m no backend\u001b[40Glayout\u001b[47Gis\u001b[50Gassigned\u001b[59Gto\u001b[62Git,\u001b[66Gso\u001b[69Git\u001b[72Gisn't\u001b[78Gusing\u001b[84Gthe\u001b[88G\"Home\"\u001b[95Glayout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSite settings that are still 0\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mmtosafi.navigation.serviceMenu\u001b[39m,\u001b[37G\u001b[38;2;177;185;249mfooterMenu\u001b[48G\u001b[39mand\u001b[52G\u001b[38;2;177;185;249msearchPage\u001b[39m.\u001b[64GUntil\u001b[70Gthese\u001b[76Gpoint\u001b[82Gat\u001b[85Greal\u001b[90Gpages,\u001b[97Gthe\u001b[101Gtop\r\u001b[2C\u001b[1B  service links, the\u001b[24Gfooter's\u001b[33G\"Inform\u001b[69Gsearch\u001b[76Gform\u001b[81Gstay\u001b[86Ghidden.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
