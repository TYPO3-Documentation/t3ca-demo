[149.931533, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[39m Very little can break, and all of it can be undone, as long as we take a database snapshot first.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mWhat could go wrong\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA second \"Home\" page.\u001b[27G\u001b[22mInitial\u001b[35Gcontent\u001b[43Gis\u001b[46Gimported\u001b[55Gas\u001b[58Ga\u001b[60Gnew\u001b[64Gpage\u001b[69Gtree.\u001b[75GThe\u001b[79Gexisting\u001b[88GHome\u001b[93Gpage\u001b[98G(uid 1)\r\u001b[2C\u001b[1B  stays, so you'd see\u001b[25Gtwo\u001b[29Groot\u001b[34Gpages,\u001b[41Gand\u001b[45Gthe\u001b[49Gsite\u001b[54Gwould\u001b[60Gkeep\u001b[65Gpointing\u001b[74Gat\u001b[77Gthe\u001b[81Gold\u001b[85Gone\u001b[89Guntil\u001b[95Gits\u001b[99Gconfig\r\u001b[2C\u001b[1B \u001b[5Gis changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong page IDs.\u001b[21G\u001b[22mTh\u001b[25Gimpo\u001b[30Gt gives pages new IDs. If the\u001b[60Gs\u001b[62Gttings (service m\u001b[80Gnu, f\u001b[86Goter menu, \u001b[98Gearch\u001b[K\r\u001b[4C\u001b[1Bpage) or the\u001b[18Gsite's\u001b[25Groot\u001b[30Gpage\u001b[35Grefer\u001b[41Gto\u001b[44Gfixed\u001b[50Gnumbers,\u001b[59Gthey\u001b[64Gcan\u001b[68Gpoint\u001b[74Gat\u001b[77Gthe\u001b[81Gwrong\u001b[87Gpage\u001b[92Gor\u001b[95Gnone.\u001b[101GThe\r\u001b[2C\u001b[1B \u001b[5Gmenus would then stay emp\u001b[31Gy or link to\u001b[44Gthe\u001b[48Gwrong plac\u001b[59G, bu\u001b[64G \u001b[66Gothing would crash.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe import runs only once.\u001b[22m TYPO3 marks\u001b[44Gthe initial con\u001b[60Gent\u001b[64Gas impor\u001b[73Ged.\u001b[77GIf I fix something i\u001b[98G it\u001b[K\r\u001b[4C\u001b[1Blater, setting up \u001b[24Ghe\u001b[28Gxtension again won't \u001b[50Ge-im\u001b[55Gort it, so to test it again we'd\u001b[88Ghave\u001b[93Gto\u001b[96Grestore\u001b[104Gthe\r\u001b[2C\u001b[1B \u001b[5Gdatabase first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour existing content:\u001b[22m th\u001b[31Gre's only the one\u001b[49G\"Welcome to your\u001b[66Gdefaul\u001b[74Gwebsite\"\u001b[83Gelement, so th\u001b[98Gre's\u001b[K\r\u001b[4C\u001b[1Bno\u001b[8Ghing o\u001b[15G value\u001b[22Gto\u001b[25Glose.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe desi\u001b[12Gn \u001b[15Giles, the\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[2B\u001b[1mHow to undo it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDatabase:\u001b[15G\u001b[22mbefore\u001b[22Gthe\u001b[26Gimport,\u001b[34Grun\u001b[38G\u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \r\u001b[2C\u001b[1B\u001b[39m  \u001b[38;2;177;185;249mbefore-page-tree\u001b[22G\u001b[39mbrings\u001b[29Gback\u001b[34Gexactly\u001b[42Gtoday's\u001b[50Gstate\u001b[56Gin\u001b[59Ga\u001b[61Gfew\u001b[65Gseconds.\u001b[74GThis\u001b[79Gis\u001b[82Gthe\u001b[86Gimportant\u001b[96Gone,\r\u001b[2C\u001b[1B \u001b[5Gbecause the databas\u001b[27Gsn't in git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFiles:\u001b[22m everything I add\u001b[29Ggoes\u001b[34Ginto the site pack\u001b[53Gg\u001b[56Ga\u001b[58Gd is vi\u001b[66Gible in\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[39m and\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[4C\u001b[1Bclean\u001b[39m on those paths\u001b[26Gremove it, or\u001b[40Gyou\u001b[44Gcan\u001b[48Gjust\u001b[53Gnot\u001b[57Gcommit\u001b[64Git.\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[150.181679, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mVery\u001b[8Glittle\u001b[15Gcan\u001b[19Gbreak,\u001b[26Gand\u001b[30Gall\u001b[34Gof\u001b[37Git\u001b[40Gcan\u001b[44Gbe\u001b[47Gundone,\u001b[55Gas\u001b[58Glong\u001b[63Gas\u001b[66Gwe\u001b[69Gtake\u001b[74Ga\u001b[76Gdatabase\u001b[85Gsnapshot\u001b[94Gfirst.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat could go wrong\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA secon\u001b[14G\"Home\" page.\u001b[27G\u001b[22mInitial\u001b[35Gcontent\u001b[43Gis\u001b[46Gimported\u001b[55Gas\u001b[58Ga\u001b[60Gnew\u001b[64Gpage\u001b[69Gtree.\u001b[75GThe\u001b[79Gexisting\u001b[88GHome\u001b[93Gpage\u001b[98G(uid 1)\r\u001b[2C\u001b[1B \u001b[5Gstays, so you'd see two root pages, and the si\u001b[53G would\u001b[60Gk\u001b[62Gep poin\u001b[70Ging at th\u001b[80G old one until its config\r\u001b[4C\u001b[1Bis changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong page IDs.\u001b[21G\u001b[22mThe\u001b[25Gimport\u001b[32Ggives\u001b[38Gpages\u001b[44Gnew\u001b[48GIDs.\u001b[53GIf\u001b[56Gthe\u001b[60Gsettings\u001b[69G(service\u001b[78Gmenu,\u001b[84Gfooter\u001b[91Gmenu,\u001b[97Gsearch\r\u001b[2C\u001b[1B \u001b[5Gpage) or the site's\u001b[25Groot pa\u001b[33Ge refer to\u001b[44Gfixed numbers, th\u001b[62Gy can point at th\u001b[80G wrong page or non\u001b[99G. T\u001b[103Ge\r\u001b[4C\u001b[1Bmenus\u001b[11Gwould then stay empty or link\u001b[44Gthe wrong place, but nothing would crash.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe import runs only once.\u001b[22m TYPO3 marks\u001b[48Ginitial content as imported. If I fix\u001b[86Gsomething\u001b[96Gin\u001b[99Git\r\u001b[2C\u001b[1B \u001b[5Glater, setting up the extension ag\u001b[40Gin won't re-\u001b[53Gmport it, so to tes\u001b[73G it\u001b[77Gagain we'd have to\u001b[96Grestore\u001b[104Gthe\r\u001b[4C\u001b[1Bd\u001b[8Gabase first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour existing content:\u001b[28G\u001b[22mthere's\u001b[36Gonly\u001b[41Gthe\u001b[45Gone\u001b[49G\"Welcome\u001b[58Gto\u001b[61Gyour\u001b[66Gdefault\u001b[74Gwebsite\"\u001b[83Gelement,\u001b[92Gso\u001b[95Gthere's\r\u001b[2C\u001b[1B \u001b[5Gnothing of value to lose.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gdesign\u001b[14Gfiles,\u001b[21Gthe\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mDa\u001b[8Gabase:\u001b[22m before\u001b[22Gthe\u001b[26Gimport,\u001b[34Grun\u001b[38G\u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mbefore-page-tree\u001b[22G\u001b[39mbrings back\u001b[34Gexactly today's state in a few seconds. This is the important one,\r\u001b[4C\u001b[1Bbecause the database i\u001b[28Gn't in git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFiles:\u001b[22m everything I add goes into the\u001b[43Gsite\u001b[48Gpackage\u001b[56Gand\u001b[60Gis\u001b[63Gvisible\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mclean\u001b[39m on those paths remov\u001b[32G it, \u001b[38Gr you can\u001b[48Gjust not commit \u001b[65Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSingle pages:\u001b[22m pages deleted\u001b[34Gn the\u001b[40Gbackend\u001b[48Gcan be brought back\u001b[68Gwith\u001b[73Gthe\u001b[77GRecycler.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
