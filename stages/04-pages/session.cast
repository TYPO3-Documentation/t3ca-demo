[181.416679, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mYour existing content:\u001b[22m th\u001b[31Gre's only the one\u001b[49G\"Welcome to your\u001b[66Gdefaul\u001b[74Gwebsite\"\u001b[83Gelement, so th\u001b[98Gre's\u001b[K\r\u001b[4C\u001b[1Bno\u001b[8Ghing o\u001b[15G value\u001b[22Gto\u001b[25Glose.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe desi\u001b[12Gn \u001b[15Giles, the\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[2B\u001b[1mHow to undo it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDatabase:\u001b[15G\u001b[22mbefore\u001b[22Gthe\u001b[26Gimport,\u001b[34Grun\u001b[38G\u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \r\u001b[2C\u001b[1B\u001b[39m  \u001b[38;2;177;185;249mbefore-page-tree\u001b[22G\u001b[39mbrings\u001b[29Gback\u001b[34Gexactly\u001b[42Gtoday's\u001b[50Gstate\u001b[56Gin\u001b[59Ga\u001b[61Gfew\u001b[65Gseconds.\u001b[74GThis\u001b[79Gis\u001b[82Gthe\u001b[86Gimportant\u001b[96Gone,\r\u001b[2C\u001b[1B \u001b[5Gbecause the databas\u001b[27Gsn't in git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFiles:\u001b[22m everything I add\u001b[29Ggoes\u001b[34Ginto the site pack\u001b[53Gg\u001b[56Ga\u001b[58Gd is vi\u001b[66Gible in\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[39m and\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[4C\u001b[1Bclean\u001b[39m on those paths\u001b[26Gremove it, or\u001b[40Gyou\u001b[44Gcan\u001b[48Gjust\u001b[53Gnot\u001b[57Gcommit\u001b[64Git.\r\u001b[4C\u001b[1B\u001b[1mS\u001b[7Gngle pages:\u001b[22m pa\u001b[22Ges\u001b[25Gdeleted in \u001b[37Ghe backend\u001b[48Gc\u001b[50Gn be brought\u001b[63Gback with the Recycler.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy plan is snapshot first, then the import. I'll\u001b[52Gcheck the result \u001b[70Gn the backend and\u001b[88Gthe\u001b[92Gbrowser,\u001b[101Gand\r\u001b[2C\u001b[1Bleave\u001b[9Git\u001b[12Guncommitted\u001b[24Gso\u001b[27Gyou\u001b[31Gcan\u001b[35Greview\u001b[42Gthe\u001b[46Gdiff.\u001b[52GShall\u001b[58GI\u001b[60Ggo\u001b[63Gahead?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 10s · done 8:55 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, take the snapshot and go ahead\u001b[39m                                                                     \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ddev snapshot --name before-page-tree 2>&1 | tail -3\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m \u001b[1mSkill\u001b[22m(typo3-distribution-content)\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
