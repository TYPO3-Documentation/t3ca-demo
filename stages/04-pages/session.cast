14Gfiles,\u001b[21Gthe\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mDa\u001b[8Gabase:\u001b[22m before\u001b[22Gthe\u001b[26Gimport,\u001b[34Grun\u001b[38G\u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mbefore-page-tree\u001b[22G\u001b[39mbrings back\u001b[34Gexactly today's state in a few seconds. This is the important one,\r\u001b[4C\u001b[1Bbecause the database i\u001b[28Gn't in git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFiles:\u001b[22m everything I add goes into the\u001b[43Gsite\u001b[48Gpackage\u001b[56Gand\u001b[60Gis\u001b[63Gvisible\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mclean\u001b[39m on those paths remov\u001b[32G it, \u001b[38Gr you can\u001b[48Gjust not commit \u001b[65Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSingle pages:\u001b[22m pages deleted\u001b[34Gn the\u001b[40Gbackend\u001b[48Gcan be brought back\u001b[68Gwith\u001b[73Gthe\u001b[77GRecycler.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy\u001b[6Gplan\u001b[11Gis\u001b[14Gsnapshot\u001b[23Gfirst,\u001b[30Gthen\u001b[35Gthe\u001b[39Gi\u001b[69Gin\u001b[72Gthe\u001b[76Gbackend\u001b[84Gand\u001b[88Gthe\u001b[92Gbrowser,\u001b[101Gand\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[155.641993, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat could go wrong\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA secon\u001b[14G\"Home\" page.\u001b[27G\u001b[22mInitial\u001b[35Gcontent\u001b[43Gis\u001b[46Gimported\u001b[55Gas\u001b[58Ga\u001b[60Gnew\u001b[64Gpage\u001b[69Gtree.\u001b[75GThe\u001b[79Gexisting\u001b[88GHome\u001b[93Gpage\u001b[98G(uid 1)\r\u001b[2C\u001b[1B \u001b[5Gstays, so you'd see two root pages, and the si\u001b[53G would\u001b[60Gk\u001b[62Gep poin\u001b[70Ging at th\u001b[80G old one until its config\r\u001b[4C\u001b[1Bis changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong page IDs.\u001b[21G\u001b[22mThe\u001b[25Gimport\u001b[32Ggives\u001b[38Gpages\u001b[44Gnew\u001b[48GIDs.\u001b[53GIf\u001b[56Gthe\u001b[60Gsettings\u001b[69G(service\u001b[78Gmenu,\u001b[84Gfooter\u001b[91Gmenu,\u001b[97Gsearch\r\u001b[2C\u001b[1B \u001b[5Gpage) or the site's\u001b[25Groot pa\u001b[33Ge refer to\u001b[44Gfixed numbers, th\u001b[62Gy can point at th\u001b[80G wrong page or non\u001b[99G. T\u001b[103Ge\r\u001b[4C\u001b[1Bmenus\u001b[11Gwould then stay empty or link\u001b[44Gthe wrong place, but nothing would crash.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe import runs only once.\u001b[22m TYPO3 marks\u001b[48Ginitial content as imported. If I fix\u001b[86Gsomething\u001b[96Gin\u001b[99Git\r\u001b[2C\u001b[1B \u001b[5Glater, setting up the extension ag\u001b[40Gin won't re-\u001b[53Gmport it, so to tes\u001b[73G it\u001b[77Gagain we'd have to\u001b[96Grestore\u001b[104Gthe\r\u001b[4C\u001b[1Bd\u001b[8Gabase first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour existing content:\u001b[28G\u001b[22mthere's\u001b[36Gonly\u001b[41Gthe\u001b[45Gone\u001b[49G\"Welcome\u001b[58Gto\u001b[61Gyour\u001b[66Gdefault\u001b[74Gwebsite\"\u001b[83Gelement,\u001b[92Gso\u001b[95Gthere's\r\u001b[2C\u001b[1B \u001b[5Gnothing of value to lose.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gdesign\u001b[14Gfiles,\u001b[21Gthe\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mDa\u001b[8Gabase:\u001b[22m before\u001b[22Gthe\u001b[26Gimport,\u001b[34Grun\u001b[38G\u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mbefore-page-tree\u001b[22G\u001b[39mbrings back\u001b[34Gexactly today's state in a few seconds. This is the important one,\r\u001b[4C\u001b[1Bbecause the database i\u001b[28Gn't in git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFiles:\u001b[22m everything I add goes into the\u001b[43Gsite\u001b[48Gpackage\u001b[56Gand\u001b[60Gis\u001b[63Gvisible\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mclean\u001b[39m on those paths remov\u001b[32G it, \u001b[38Gr you can\u001b[48Gjust not commit \u001b[65Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSingle pages:\u001b[22m pages deleted\u001b[34Gn the\u001b[40Gbackend\u001b[48Gcan be brought back\u001b[68Gwith\u001b[73Gthe\u001b[77GRecycler.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy\u001b[6Gplan\u001b[11Gis\u001b[14Gsnapshot\u001b[23Gfirst,\u001b[30Gthen\u001b[35Gthe\u001b[39Gimport.\u001b[47GI'll\u001b[52Gcheck\u001b[58Gthe\u001b[62Gresult\u001b[69Gin\u001b[72Gthe\u001b[76Gbackend\u001b[84Gand\u001b[88Gthe\u001b[92Gbrowser,\u001b[101Gand\r\u001b[2C\u001b[1Bleave it uncommitted so you ca\u001b[35Grevie\u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
