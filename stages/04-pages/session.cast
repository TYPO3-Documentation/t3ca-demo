[151.414456, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIs there anything I could break, and can I undo it?\u001b[39m                                                     \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mVery little can break,\u001b[26Gand\u001b[30Gall\u001b[34Gof\u001b[37Git\u001b[40Gcan\u001b[44Gbe\u001b[47Gundone,\u001b[55Gas\u001b[58Glong\u001b[63Gas\u001b[66Gwe\u001b[69Gtake\u001b[74Ga\u001b[76Gdatabase\u001b[85Gsnapshot\u001b[94Gfirst.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat could go wrong\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA second \"Home\" page.\u001b[27G\u001b[22mInitial\u001b[35Gcontent\u001b[43Gis\u001b[46Gimported\u001b[55Gas\u001b[58Ga\u001b[60Gnew\u001b[64Gpage\u001b[69Gtree.\u001b[75GThe\u001b[79Gexisting\u001b[88GHome\u001b[93Gpage\u001b[98G(uid 1)\r\u001b[2C\u001b[1B \u001b[5Gstays, so you'd\u001b[21Gse\u001b[25Gtwo \u001b[30Goot pages, and the site would\u001b[60Gk\u001b[62Gep pointing at th\u001b[80G old \u001b[86Gne until it\u001b[98G config\r\u001b[4C\u001b[1Bis changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong page IDs.\u001b[22m The impor\u001b[31G gives pages\u001b[44Gnew\u001b[48GIDs. If th\u001b[59G set\u001b[64Gi\u001b[66Ggs (service menu, footer\u001b[91Gmenu,\u001b[97Gsearch\r\u001b[2C\u001b[1B \u001b[5Gpage) or the site's root page refer to\u001b[44Gfixed numbers, \u001b[60Ghey\u001b[64Gcan poin\u001b[73G at\u001b[77Gthe wrong page or no\u001b[98Ge. The\r\u001b[4C\u001b[1Bmenus would then s\u001b[24Gay\u001b[28Gmpty or link to the w\u001b[50Gong \u001b[55Glace, but nothing would crash.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe import runs only once.\u001b[32G\u001b[22mTYPO3\u001b[38Gmarks\u001b[44Gthe\u001b[48Ginitial\u001b[56Gcontent\u001b[64Gas\u001b[67Gimported.\u001b[77GIf\u001b[80GI\u001b[82Gfix\u001b[86Gsomething\u001b[96Gin\u001b[99Git\r\u001b[2C\u001b[1B \u001b[5Glater, setting up the ext\u001b[31Gnsion again won't\u001b[49Gre-import it, so\u001b[66Gto tes\u001b[74Git again\u001b[83Gwe'd have to r\u001b[98Gstore\u001b[104Gthe\r\u001b[4C\u001b[1Bda\u001b[8Gabase \u001b[15Girst.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour existing content:\u001b[28G\u001b[22mthere's\u001b[36Gonly\u001b[41Gthe\u001b[45Gone\u001b[49G\"Welcome\u001b[58Gto\u001b[61Gyour\u001b[66Gdefault\u001b[74Gwebsite\"\u001b[83Gelement,\u001b[92Gso\u001b[95Gthere's\r\u001b[2C\u001b[1B  nothin\u001b[12G o\u001b[15G value to\u001b[25Glose.\u001b[K\r\u001b[2C\u001b[2BThe design files,\u001b[21Gthe\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDatabase:\u001b[22m before th\u001b[27Gmport, run \u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mbefore-page-tree\u001b[39m brings\u001b[29Gback\u001b[34Gexactly today's st\u001b[53Gt\u001b[56Gi\u001b[58G a few \u001b[66Geconds.\u001b[74GThis is the\u001b[86Gimportant one,\u001b[K\r\u001b[4C\u001b[1Bbecause the database\u001b[26Gisn't in git.\u001b[40G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mF\u001b[7Gles:\u001b[22m everythin\u001b[22G I\u001b[25Gadd goes in\u001b[37Go the site\u001b[48Gp\u001b[50Gckage and is\u001b[63Gvisible in \u001b[38;2;177;185;249mgit status\u001b[39m. \u001b[38;2;177;185;249mgit restore\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[4C\u001b[1Bclean\u001b[11G\u001b[39mon\u001b[14Gthose\u001b[20Gpaths\u001b[26Gremove\u001b[33Git,\u001b[37Gor\u001b[31;1H\u001b[29;3H\u001b[?25h"]
