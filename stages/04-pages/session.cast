[150.664762, "o", "\u001b[?25l\u001b[H \u001b[3G- \u001b[1mA second \"Home\" page.\u001b[22m Initial con\u001b[39Gent is import\u001b[53Gd\u001b[58Ga \u001b[61Gew pag\u001b[70Gre\u001b[73G. The exi\u001b[83Gting Home page (uid 1)\r\u001b[4C\u001b[1Bstays,\u001b[12Gso\u001b[15Gyou'd\u001b[21Gsee\u001b[25Gtwo\u001b[29Groot\u001b[34Gpages,\u001b[41Gand\u001b[45Gthe\u001b[49Gsite\u001b[54Gwould\u001b[60Gkeep\u001b[65Gpointing\u001b[74Gat\u001b[77Gthe\u001b[81Gold\u001b[85Gone\u001b[89Guntil\u001b[95Gits\u001b[99Gconfig\r\u001b[2C\u001b[1B  is changed.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWrong page IDs.\u001b[22m The impor\u001b[31G gives pages new IDs. If the\u001b[60Gs\u001b[62Gttin\u001b[67Gs\u001b[69G(s\u001b[72Grvice m\u001b[80Gnu, footer menu, search\u001b[K\r\u001b[4C\u001b[1Bpage) or the site's\u001b[25Gro\u001b[28Gt page refer\u001b[41Gto fix\u001b[48Gd numbers, th\u001b[62Gy can po\u001b[72Gt\u001b[81Gwrong page or\u001b[95Gnone. The\u001b[K\r\u001b[4C\u001b[1Bmenus would\u001b[17Gthen\u001b[22Gstay\u001b[27Gempty\u001b[33Gor\u001b[36Glink\u001b[41Gto\u001b[44Gthe\u001b[48Gwrong\u001b[54Gplace,\u001b[61Gbut\u001b[65Gnothing\u001b[73Gwould\u001b[79Gcrash.\r\u001b[4C\u001b[1B\u001b[1mThe im\u001b[12Gort\u001b[16Gruns only once.\u001b[32G\u001b[22mTYPO3\u001b[38Gm\u001b[40Grk\u001b[44Gthe\u001b[48Ginitial\u001b[56Gconten\u001b[63G as imported. If I fix somethi\u001b[94Gg in it\u001b[K\r\u001b[4C\u001b[1Bl\u001b[7Gt\u001b[9Gr, se\u001b[15Gting up the extension again won't re-import\u001b[59Git, so to tes\u001b[74Gi\u001b[77Gagain we'd have to restore the\r\u001b[4C\u001b[1Bdatabase first.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mYour exis\u001b[15Ging content:\u001b[22m there's only the one \"Welcome to your defaul\u001b[73G website\" element, so there's\r\u001b[4C\u001b[1Bno\u001b[8Ghing of value to lose.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe design files, the templat\u001b[33Gs and the back\u001b[48Gnd stay un\u001b[60Guched, and nothing l\u001b[81Gav\u001b[84Gs your machin\u001b[98G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mDatabase:\u001b[22m before the i\u001b[29Gor\u001b[32G, ru\u001b[37G \u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m. \u001b[38;2;177;185;249mddev snapshot restore \r\u001b[4C\u001b[1Bbefore-page-tree\u001b[22G\u001b[39mbrings\u001b[29Gback\u001b[34Gexactly\u001b[42Gtoday's\u001b[50Gstate\u001b[56Gin\u001b[59Ga\u001b[61Gfew\u001b[65Gseconds.\u001b[74GThis\u001b[79Gis\u001b[82Gthe\u001b[86Gimportant\u001b[96Gone,\r\u001b[2C\u001b[1B  because the database\u001b[26Gisn't\u001b[32Gin\u001b[35Ggit.\r\u001b[4C\u001b[1B\u001b[1mFiles:\u001b[22m everything I add goes\u001b[34Ginto the site package and is visible in \u001b[38;2;177;185;249mgit status\u001b[39m. \u001b[38;2;177;185;249mgit restore\u001b[39m and\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[4C\u001b[1Bclean\u001b[39m on those paths remove it, or \u001b[41Gou c\u001b[46Gn ju\u001b[52G not commit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSingle pages:\u001b[22m p\u001b[21Gge\u001b[24G deleted in the\u001b[40Gbackend\u001b[48Gcan\u001b[52Gbe\u001b[55Gbrought\u001b[63Gback\u001b[68Gwith\u001b[73Gthe\u001b[77GRecycler.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy plan\u001b[11Gis\u001b[14Gsnapshot first, then the import. I'll check the result\u001b[69Gin\u001b[72Gthe\u001b[76Gbackend\u001b[84Gand\u001b[88Gthe\u001b[92Gbrowser,\u001b[101Gand\r\u001b[2C\u001b[1Bleave it uncommitted so you can review th\u001b[45G \u001b[47Giff.\u001b[52GShall I go\u001b[63Gahead?\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 10s · done 8:55 AM\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
