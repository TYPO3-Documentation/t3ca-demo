[145.879696, "o", "\u001b[?25l\u001b[H\u001b[3GYour commits are \u001b[21Gt\u001b[23Gg\u001b[25Gs (\u001b[38;2;177;185;249mStage 00\u001b[39G\u001b[39m \u001b[38;2;177;185;249mStage 03\u001b[39m),\u001b[51Gso\u001b[54Gthis\u001b[59Glooks\u001b[65Glike\u001b[70Ga\u001b[72Gdemo\u001b[77Gthat\u001b[82Ghas\u001b[86Gto\u001b[89Gcome\u001b[94Gup\u001b[97Gthe\u001b[101Gsame\r\u001b[2C\u001b[1Bway\u001b[7Gon\u001b[10Ga\u001b[12Gfresh\u001b[18Ginstall.\u001b[27GIf\u001b[30Gthe\u001b[34Gpages\u001b[40Gexist\u001b[46Gonly\u001b[51Gin\u001b[54Gyour\u001b[59Glocal\u001b[65Gdatabase,\u001b[75Gthe\u001b[79Gnext\u001b[84Gstage\u001b[90Gcan't\u001b[96Gbe\u001b[99Grebuilt\r\u001b[2C\u001b[1Bfrom the repository. If they ship as initial\u001b[48Gcontent\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mmtosafi_sitepackage\u001b[39m,\u001b[80Ga\u001b[82Gfresh\u001b[88Ginstall\u001b[96Ggets\u001b[101Gthe\r\u001b[2C\u001b[1Bsame\u001b[8Gpage \u001b[14Gree, layout\u001b[27Gand settings\u001b[40Gevery time.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter that, in this order\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mThe home page content elements:\u001b[22m \u001b[39Glid\u001b[44G,\u001b[46Gservice\u001b[54Gtiles,\u001b[61Gnews\u001b[66Gand\u001b[70Gevents\u001b[77Gteasers.\u001b[86GThese\u001b[92Gare\u001b[96Gthe\u001b[100Gmost\r\u001b[5C\u001b[1Bvisible\u001b[14Gpart\u001b[19Gof\u001b[22Gthe\u001b[26Gdesign\u001b[33Gand\u001b[37Gneed\u001b[42Gthe\u001b[46Gpages\u001b[52Gin\u001b[55Gplace\u001b[61Gfirst.\r\u001b[2C\u001b[1B2. \u001b[1mThe in\u001b[13Geractive pa\u001b[25Gts:\u001b[29G\u001b[22mthe\u001b[33Gforms\u001b[39G(contact,\u001b[49Gnewsletter,\u001b[61Glogin),\u001b[69Gsearch,\u001b[77Gand\u001b[81Gthe\u001b[85Gland\u001b[90Grates\u001b[96Gcalculator.\r\u001b[2C\u001b[1B  \u001b[6GEach needs its own processing behin\u001b[42G it, so each \u001b[56Gs a separate piece of work.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mKiswahili:\u001b[22m add i\u001b[23G last. A second language m\u001b[50Gans translat\u001b[63Gng every\u001b[72Gpage\u001b[77Gand\u001b[81Gelement,\u001b[90Gso\u001b[93Git\u001b[96Gmakes\u001b[102Gsense\r\u001b[2C\u001b[1B  \u001b[6Gonce the content has se\u001b[30Gtled.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShall I start\u001b[17Gon the\u001b[24Gp\u001b[26Gge tree as initial cont\u001b[50Gnt?\u001b[54G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 7s · done 8:55 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIs there anything I could break, and can I undo it?\u001b[39m                                                     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mVery\u001b[8Glittle\u001b[15Gcan\u001b[19Gbreak,\u001b[26Gand\u001b[30Gall\u001b[34Gof\u001b[37Git\u001b[40Gcan\u001b[44Gbe\u001b[47Gundone,\u001b[55Gas\u001b[58Glong\u001b[63Gas\u001b[66Gwe\u001b[69Gtake\u001b[74Ga\u001b[76Gdatabase\u001b[85Gsnapshot\u001b[94Gfirst.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat could go wrong\r\u001b[1B\u001b[22m \u001b[3G- \u001b[1mA second \"Home\" page.\u001b[22m Initial con\u001b[39Gent is import\u001b[53Gd\u001b[58Ga \u001b[61Gew pag\u001b[70Gre\u001b[73G. The exi\u001b[83Gting Home page (uid 1)\r\u001b[4C\u001b[1Bstays,\u001b[12Gso\u001b[15Gyou'd\u001b[21Gsee\u001b[25Gtwo\u001b[29Groot\u001b[34Gpages,\u001b[41Gand\u001b[45Gthe\u001b[49Gsite\u001b[54Gwould\u001b[60Gkeep\u001b[65Gpointing\u001b[74Gat\u001b[77Gthe\u001b[81Gold\u001b[85Gone\u001b[89Guntil\u001b[95Gits\u001b[99Gconfig\r\u001b[2C\u001b[1B  is changed.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
