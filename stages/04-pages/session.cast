[236.274118, "o", "\u001b[?25l\u001b[H\u001b[3GMy plan is snapshot\u001b[23Gfirst, then the\u001b[39Gimport. I'll ch\u001b[55Gck the result in the backend and the browser, and\u001b[K\r\u001b[2C\u001b[1Bleave it uncommitted \u001b[25Go you can review the diff. Shall I go ahead?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 10s · done 8:55 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, take the snapshot and go ahead\u001b[39m                                                                     \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mR\u001b[5Gn \u001b[1m1\u001b[22m shell\u001b[15Gcomman\u001b[22G \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mSkill\u001b[22m(typo3-distribution-content)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoaded\u001b[13Gskill\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, called typo3-dev-companion \u001b[1m2\u001b[22m times, ran \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The snapshot \u001b[38;2;177;185;249mbefore-page-tree\u001b[33G\u001b[39mis\u001b[36Gsaved\u001b[42Gand\u001b[46Gthe\u001b[50Gpage\u001b[55Gstructure\u001b[65Gis\u001b[68Gworked\u001b[75Gout\u001b[79Gfrom\u001b[84Gthe\u001b[88Gdesign.\u001b[96GPages\u001b[102G2–4\r\u001b[2C\u001b[1Bhave\u001b[8Gunexpectedly\u001b[21Gappeared\u001b[30Gin\u001b[33Gthe\u001b[37Gdatabase,\u001b[47Gso\u001b[50GI'm\u001b[54Gtracing\u001b[62Gwhere\u001b[68Gthey\u001b[73Gcame\u001b[78Gfrom\u001b[83Gbefore\u001b[90Ggoing\u001b[96Gfurther.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunni\u001b[9Gg \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ date +%s && ddev mysql -e \"select uid,pid,title,doktype,hidden,backend_layout,from_unixtime(crdate)\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mc,from_unixtime(tstamp) t,cruser_id from pages order by uid; select \r\u001b[5C\u001b[1Buid,userid,tablename,recuid,action,from_unixtime(tstamp) t,details from sys_log where tstamp > \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153munix_timestamp()-3600 order by uid…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
