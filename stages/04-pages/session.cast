[283.328867, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPages\u001b[9G2–4\u001b[13Gwere\u001b[18Ga\u001b[20Gleftover\u001b[29Gfrom\u001b[34Gan\u001b[37Gearlier\u001b[45Gattempt,\u001b[54Gmade\u001b[59Gand\u001b[63Gdeleted\u001b[71Gat\u001b[74G08:37,\u001b[81Gand\u001b[85Gmy\u001b[88Gfirst\u001b[94Gquery\u001b[100Ghid\r\u001b[1B \u001b[3Gdeleted r\u001b[13Gws while the se\u001b[31Gd showed\u001b[40Gthem.\u001b[46GNothing\u001b[54Gis\u001b[57Gchanging\u001b[66Gthe\u001b[70Gdatabase\u001b[79Gnow,\u001b[84Gso\u001b[87GI'm\u001b[91Gcontinuing.\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m  \u001b[38;2;153;153;153m· summary\u001b[13G\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;153;153;153mS\u001b[6Grched for\u001b[16G\u001b[1m3\u001b[22m patterns \u001b[39m\u001b[K\r\u001b[2C\u001b[2BNow\u001b[7GI'm wri\u001b[15Ging the seed script.\u001b[36GIt lives in the project (\u001b[38;2;177;185;249mBuild/Initialisation/\u001b[39m), not in the\u001b[96Gp\u001b[98Gckage, so\r\u001b[2C\u001b[1Bthe tre\u001b[11G can be rebuilt from i\u001b[34G later.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1fno7p4;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/Build/Initialisation/seed-page-tree.php\u0007Build/Initialisation/seed-page-tree.php\u001b]8;;\u0007)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m153\u001b[22m lines to \u001b]8;id=1fno7p4;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/Build/Initialisation/seed-page-tree.php\u0007\u001b[1mBuild/Initialisation/seed-page-tree.php\u001b]8;;\u0007\r\u001b[5C\u001b[1B\u001b[22m\u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m<?php\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  2 \u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m  3 \u001b[22m\u001b[38;2;249;38;114mdeclare\u001b[39m(strict_types=\u001b[38;2;190;132;255m1\u001b[39m);\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m  4 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m/**\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  6 \u001b[22m * Seeds the page\u001b[28Gtree\u001b[33Gof\u001b[36Gthe\u001b[40GMto\u001b[44GSafi\u001b[49G\u001b[38;2;166;226;46mdesign\u001b[56G\u001b[39m(design/README.md)\u001b[75Gbelow\u001b[81Gthe\u001b[85Gexisting\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[11G\u001b[22m*\u001b[13Groot\u001b[18Gpage\u001b[23G\u001b[38;2;249;38;114mand\u001b[27G\u001b[39mpoints\u001b[34Gthe\u001b[38Gsite\u001b[43Gsettings\u001b[52Gat\u001b[55Gits\u001b[59Gmenu\u001b[64Gfolders\u001b[72G\u001b[38;2;249;38;114mand\u001b[76G\u001b[39msearch\u001b[83Gpage.\r\u001b[1B \u001b[3G   \u001b[2m  8 \u001b[11G\u001b[22m*\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m  9 \u001b[22m * The result is\u001b[27Gexported to packages/mtosafi_sitepackage/Initialisation/\u001b[84Gafterwards;\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[11G\u001b[22m*\u001b[13Gcorrect\u001b[21Gthis\u001b[26Gscript\u001b[33Grather\u001b[40Gthan\u001b[45Gthe\u001b[49Grecords,\u001b[58Git\u001b[61Gis\u001b[64Gwhat\u001b[69Gthe\u001b[73Gnext\u001b[78Gexport\u001b[85Gcomes\u001b[91G\u001b[38;2;249;38;114mfrom\u001b[39m.\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153m… +143 lines \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
