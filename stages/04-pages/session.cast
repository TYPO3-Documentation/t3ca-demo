01b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoaded skill\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mReading\u001b[11GDDEV\u001b[16Gconfig,\u001b[24GREADME,\u001b[32Glayout\u001b[39Glabels\u001b[46Gand\u001b[50Groot\u001b[55Gpage\u001b[60Gstate\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cat .ddev/config.yaml | grep -v '^#' | grep -v '^\\s*$'; cat README.md | head -60; cat \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mconfig/s\u001b[15Gtes/main/config.y\u001b[33Gml; fo\u001b[40G f\u001b[43Gin Default Narrow SidebarL\u001b[70Gft SidebarRight; do grep -m1 title \r\u001b[5C\u001b[1Bpackag\u001b[13Gs/mtosafi_sitepackage/Configu\u001b[43Gation/Sets/Sitepackage/Back\u001b[71GndLayouts/$f.tsconfig; done; cat \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mpackages/mtosa…\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
