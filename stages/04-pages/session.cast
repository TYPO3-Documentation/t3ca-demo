[367.432599, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWorking now\u001b[22m (reload \u001b]8;id=fg1t4;https://demo.ddev.site\u0007\u001b[94mhttps://demo.ddev.site\u001b]8;;\u0007\u001b[39m):\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMain menu:\u001b[16G\u001b[22mHome,\u001b[22GRevenue\u001b[30G&\u001b[32Gpayments,\u001b[42GHealth,\u001b[50GEnvironment\u001b[62G&\u001b[64Gwater,\u001b[71GTrade\u001b[77G&\u001b[79Gtourism,\u001b[88GPublic\r\u001b[4C\u001b[1Bparticipation,\u001b[20GContact.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRevenue & payments:\u001b[25G\u001b[22muses \u001b[31Ghe sidebar-l\u001b[44Gft\u001b[47Glayout. Its\u001b[59Gsub-navigation\u001b[74Gshows\u001b[80GLand\u001b[85Grates,\u001b[92GSingle\u001b[99Gbusiness\r\u001b[4C\u001b[1Bpermit,\u001b[13GParking\u001b[21Gfees,\u001b[27GMarket fees and Waiver of interest.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHeader:\u001b[13G\u001b[22mthe\u001b[17Gservice\u001b[25Glinks (E-services portal, Contact) and the search\u001b[75Gform\u001b[80Gappear.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFooter:\u001b[22m the \"Information\" column shows its four links.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLayouts:\u001b[22m Home uses the home layout, Search the sidebar-right layout and the E-services portal the\r\u001b[4C\u001b[1Bnarrow layout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPages:\u001b[22m all\u001b[16Gof\u001b[19Gthem\u001b[24Greturn\u001b[31G200\u001b[35Gand\u001b[39Gnone\u001b[44Gis\u001b[47Ghidden.\u001b[55GThey\u001b[60Ghave\u001b[65Gno\u001b[68Gcontent\u001b[76Gyet,\u001b[81Gand\u001b[85Gthe\u001b[89G\"Welcome\u001b[98Gto\u001b[101Gyour\r\u001b[4C\u001b[1Bdefault\u001b[13Gwebsite\"\u001b[22Gelement is\u001b[33Gdeleted.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mFiles (nothing committed):\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[38;2;177;185;249mBuild/Initialisation/seed-page-tree.php\u001b[39m:\u001b[46Gthe\u001b[50Gscript\u001b[57Gthat\u001b[62Gcreates\u001b[70Gthe\u001b[74Gtree.\u001b[80GTo\u001b[83Gchange\u001b[90Gthe\u001b[94Gtree,\u001b[100Gchange\r\u001b[1B \u001b[3G  this script, not the p\u001b[28Gges by hand.\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mconfig/sites/main/settings.yaml\u001b[39m: poin\u001b[43Gs the service menu, footer m\u001b[72Gnu and\u001b[79Gsearch page settings at\r\u001b[2C\u001b[1B  pages 22, 23 and 16.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Initialisation/data.xml\u001b[39m:\u001b[59Gthe\u001b[63Gexported\u001b[72Gtree,\u001b[78G26\u001b[81Gpages.\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Initialisation/Site/main/\u001b[39m:\u001b[61Ga\u001b[63Gcopy\u001b[68Gof\u001b[71Gthe\u001b[75Gsite\u001b[80Gconfig.\u001b[88GI\u001b[90Gchanged\u001b[98Gits\u001b[102Gbase\r\u001b[1B    to \u001b[38;2;177;185;249m/\u001b[39m so it works on any domain.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/README.md\u001b[39m: how the\u001b[53Gtree\u001b[58Gis\u001b[61Gmade,\u001b[67Gplus\u001b[72Ga\u001b[74Gwarning\u001b[82Gabout\u001b[88Gthe\u001b[92Gthree\u001b[98Gpage\u001b[103GIDs.\r\u001b[1B  - \u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/composer.json\u001b[39m and \u001b[38;2;177;185;249mcomposer.lock\u001b[39m: the package now requires\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mtypo3/cms-impexp\u001b[39m, without which the\u001b[41Gimport\u001b[48Gis\u001b[51Gsilently\u001b[60Gskipped.\r\u001b[2B \u001b[3G\u001b[1mNot proven yet:\u001b[22m whether a fresh installation gets the pages,\u001b[64Gthe\u001b[68Gsite\u001b[73Gand\u001b[77Gworking\u001b[85Gmenus.\u001b[92GIn\u001b[95Gparticular,\r\u001b[1B  I don't know whether the three page IDs in the settings come out the\u001b[72Gsame\u001b[77Gthere,\u001b[84Gso\u001b[87Gthat\u001b[92Gsentence\u001b[101Gin\u001b[104Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[367.718661, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mMa\u001b[9G menu:\u001b[22m Home, Revenue & payments, Health,\u001b[50GEnvironment\u001b[62G&\u001b[64Gwater,\u001b[71GTrade\u001b[77G&\u001b[79Gtourism,\u001b[88GPublic\r\u001b[2C\u001b[1B \u001b[5Gparticipation, Contact.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRevenue & payments:\u001b[22m uses\u001b[30Gthe\u001b[34Gsidebar-left\u001b[47Glayout.\u001b[55GIts\u001b[59Gsub-navigation\u001b[74Gshows\u001b[80GLand\u001b[85Grates,\u001b[92GSingle\u001b[99Gbusiness\r\u001b[2C\u001b[1B \u001b[5Gpermit, Parking fees, Market\u001b[34Gfees \u001b[40Gnd Waiver \u001b[51Gf intere\u001b[60Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHeader:\u001b[13G\u001b[22mthe servic\u001b[24G links (E-s\u001b[36Grvices\u001b[43Gportal, Contact) and\u001b[64Gthe\u001b[68Gsearch\u001b[75Gform\u001b[80Gappear.\r\u001b[4C\u001b[1B\u001b[1mFoot\u001b[17G\u001b[22m\"Informat\u001b[27Gon\"\u001b[31Gcolumn shows its four links.\u001b[60G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mLayouts:\u001b[22m Home uses the home \u001b[34Gayout, Search\u001b[48Gthe sidebar-right\u001b[66Glayout\u001b[73Gand\u001b[77Gthe\u001b[81GE-services\u001b[92Gportal\u001b[99Gthe\r\u001b[2C\u001b[1B \u001b[5Gnarrow lay\u001b[16Gut.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPages:\u001b[12G\u001b[22mall of them\u001b[24Greturn\u001b[31G200\u001b[35Gand\u001b[39Gnone\u001b[44Gis\u001b[47Ghidden.\u001b[55GThey\u001b[60Ghave\u001b[65Gno\u001b[68Gcontent\u001b[76Gyet,\u001b[81Gand\u001b[85Gthe\u001b[89G\"Welcome\u001b[98Gto\u001b[101Gyour\r\u001b[2C\u001b[1B \u001b[5Gdefault website\" element is deleted.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles (nothing committed):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249mBuild/Initialisation/seed-page-tree.php\u001b[39m:\u001b[46Gthe\u001b[50Gscript\u001b[57Gthat\u001b[62Gcreates\u001b[70Gthe\u001b[74Gtree.\u001b[80GTo\u001b[83Gchange\u001b[90Gthe\u001b[94Gtree,\u001b[100Gchange\r\u001b[2C\u001b[1B \u001b[5Gthis script, not the pages by hand.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mconfig/sites/main/settings.yaml\u001b[39m: points\u001b[45Gthe\u001b[49Gservice\u001b[57Gmenu,\u001b[63Gfooter\u001b[70Gmenu\u001b[75Gand\u001b[79Gsearch\u001b[86Gpage\u001b[91Gsettings\u001b[100Gat\r\u001b[2C\u001b[1B \u001b[5Gpages 22, 23 and 16.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Initialisation/data.xml\u001b[39m:\u001b[59Gthe\u001b[63Gexported\u001b[72Gtree,\u001b[78G26\u001b[81Gpages.\r\u001b[48C\u001b[1B\u001b[38;2;177;185;249mSi\u001b[52Ge/main/\u001b[39m: a\u001b[63Gco\u001b[66Gy of the site config\u001b[88GI\u001b[90Gchanged\u001b[98Gits\u001b[102Gbase\r\u001b[2C\u001b[1B \u001b[5Gto \u001b[38;2;177;185;249m/\u001b[39m so it works on any domain.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/README.md\u001b[39m:\u001b[45Ghow\u001b[49Gthe\u001b[53Gtree\u001b[58Gis\u001b[61Gmade,\u001b[67Gplus\u001b[72Ga\u001b[74Gwarning\u001b[82Gabout\u001b[88Gthe\u001b[92Gthree\u001b[98Gpage\u001b[103GIDs.\r\u001b[33C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m and \u001b[38;2;177;185;249mcomposer.lock\u001b[39m:\u001b[67Gthe p\u001b[73Gck\u001b[76Gge \u001b[80Gow requires\u001b[92G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mtypo3/cms-impexp\u001b[39m, without which the import\u001b[48Gis silently skipped.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot proven yet:\u001b[19G\u001b[22mwhether\u001b[27Ga\u001b[29Gfresh\u001b[35Ginstallation\u001b[48Ggets\u001b[53Gthe\u001b[57Gpages,\u001b[64Gthe\u001b[68Gsite\u001b[73Gand\u001b[77Gworking\u001b[85Gmenus.\u001b[92GIn\u001b[95Gparticular,\r\u001b[2C\u001b[1BI don't know whet\u001b[22Gr the th\u001b[32Ge page IDs in the set\u001b[54Gings come\u001b[64Gout\u001b[68Gthe s\u001b[74Gme\u001b[77Gthere, so that\u001b[92Gsentence in the\r\u001b[2C\u001b[1BREADME is untest