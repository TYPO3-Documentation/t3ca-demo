[480.627977, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gpages 22, 23 and 16.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Initialisation/data.xml\u001b[39m:\u001b[59Gthe\u001b[63Gexported\u001b[72Gtree,\u001b[78G26\u001b[81Gpages.\r\u001b[48C\u001b[1B\u001b[38;2;177;185;249mSi\u001b[52Ge/main/\u001b[39m: a\u001b[63Gco\u001b[66Gy of the site config\u001b[88GI\u001b[90Gchanged\u001b[98Gits\u001b[102Gbase\r\u001b[2C\u001b[1B \u001b[5Gto \u001b[38;2;177;185;249m/\u001b[39m so it works on any domain.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/README.md\u001b[39m:\u001b[45Ghow\u001b[49Gthe\u001b[53Gtree\u001b[58Gis\u001b[61Gmade,\u001b[67Gplus\u001b[72Ga\u001b[74Gwarning\u001b[82Gabout\u001b[88Gthe\u001b[92Gthree\u001b[98Gpage\u001b[103GIDs.\r\u001b[33C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m and \u001b[38;2;177;185;249mcomposer.lock\u001b[39m:\u001b[67Gthe p\u001b[73Gck\u001b[76Gge \u001b[80Gow requires\u001b[92G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mtypo3/cms-impexp\u001b[39m, without which the import\u001b[48Gis silently skipped.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot proven yet:\u001b[19G\u001b[22mwhether\u001b[27Ga\u001b[29Gfresh\u001b[35Ginstallation\u001b[48Ggets\u001b[53Gthe\u001b[57Gpages,\u001b[64Gthe\u001b[68Gsite\u001b[73Gand\u001b[77Gworking\u001b[85Gmenus.\u001b[92GIn\u001b[95Gparticular,\r\u001b[2C\u001b[1BI don't know whet\u001b[22Gr the th\u001b[32Ge page IDs in the set\u001b[54Gings come\u001b[64Gout\u001b[68Gthe s\u001b[74Gme\u001b[77Gthere, so that\u001b[92Gsentence in the\r\u001b[2C\u001b[1BREADME is untested. Checking it means emptying\u001b[50Gthe database,\u001b[64Gr\u001b[66Gnning\u001b[72G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m, checking th\u001b[97G site,\u001b[104G\u001b[K\r\u001b[2C\u001b[1Bthen restoring with\u001b[23G\u001b[38;2;177;185;249mddev snapshot restore after-page-tree\u001b[39m and \u001b[38;2;177;185;249mgit res\u001b[73Gore config/system/settings.php\u001b[39m.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mtypo3 setup --force\u001b[23G\u001b[39mrewrites that file, so it needs restori\u001b[63Gg\u001b[65Gtoo. Your current work is saved in that\r\u001b[2C\u001b[1Bsnapshot, and the original \u001b[31Gtate is still in \u001b[38;2;177;185;249mbefore-page-tree\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDo\u001b[6Gyou\u001b[10Gwant\u001b[15Gme\u001b[18Gto\u001b[21Grun\u001b[25Gthat\u001b[30Gtest,\u001b[36Gor\u001b[39Gleave\u001b[45Git\u001b[48Gunproven\u001b[57Gfor\u001b[61Gnow?\u001b[66GIf\u001b[69Gyou'd\u001b[75Grather\u001b[82Gdo\u001b[85Git\u001b[88Gyourself,\u001b[98Gtyping\r\u001b[2C\u001b[1Bthe comm\u001b[13Gds wi\u001b[19Gh\u001b[21G\u001b[38;2;177;185;249m! \u001b[39m in front runs th\u001b[41Gm in \u001b[47Ghis session.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 3m 10s · done 8:59 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mshow me the result in a browser\u001b[39m                                                                         \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ ddev launch /revenue-payments/land-rates 2>&1 | head -1\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
