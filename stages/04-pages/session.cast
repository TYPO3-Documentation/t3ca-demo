[151.344844, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat coul\u001b[14Ggo wrong\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA second \"Home\" page.\u001b[22m Initial content is impor\u001b[53Gd as a\u001b[60Gn\u001b[62Gw page \u001b[70Gree. The \u001b[80Gxisting Home page (uid 1)\r\u001b[4C\u001b[1Bstays, so you'd\u001b[21Gsee\u001b[25Gtwo\u001b[29Groot\u001b[34Gpages,\u001b[41Gand\u001b[45Gthe\u001b[49Gsite\u001b[54Gwould\u001b[60Gkeep\u001b[65Gpointing\u001b[74Gat\u001b[77Gthe\u001b[81Gold\u001b[85Gone\u001b[89Guntil\u001b[95Gits\u001b[99Gconfig\r\u001b[2C\u001b[1B \u001b[5Gis changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong page IDs.\u001b[22m The\u001b[25Gimport \u001b[33Gives pages\u001b[44Gnew IDs. If the s\u001b[62Gttings (service m\u001b[80Gnu, footer menu, s\u001b[99Garc\u001b[103G\u001b[K\r\u001b[4C\u001b[1Bpage)\u001b[11Gor the site's root page refer\u001b[44Gfixed numbers, they can point at the wrong\u001b[87Gpage\u001b[92Gor\u001b[95Gnone.\u001b[101GThe\r\u001b[2C\u001b[1B \u001b[5Gmenus would then stay empty or link to\u001b[48Gwrong place, but nothing would crash.\u001b[86G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe import runs only once.\u001b[22m TYPO3 m\u001b[40Grks the init\u001b[53Gal content as impor\u001b[73Ged.\u001b[77GIf I fix something\u001b[96Gin it\u001b[K\r\u001b[4C\u001b[1Bl\u001b[8Ger, setting up\u001b[23Gthe\u001b[27Gextension\u001b[37Gagain\u001b[43Gwon't\u001b[49Gre-import\u001b[59Git,\u001b[63Gso\u001b[66Gto\u001b[69Gtest\u001b[74Git\u001b[77Gagain\u001b[83Gwe'd\u001b[88Ghave\u001b[93Gto\u001b[96Grestore\u001b[104Gthe\r\u001b[2C\u001b[1B \u001b[5Gdatabase first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour existing content:\u001b[22m there's\u001b[36Gonly\u001b[41Gthe\u001b[45Gone\u001b[49G\"Welcome\u001b[58Gto\u001b[61Gyour\u001b[66Gdefault\u001b[74Gwebsite\"\u001b[83Gelement,\u001b[92Gso\u001b[95Gthere's\r\u001b[4C\u001b[1Bnothing\u001b[13Gof\u001b[16Gvalue\u001b[22Gto\u001b[25Glose.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gdesign\u001b[14Gfiles,\u001b[21Gthe\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow \u001b[8Go undo it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDatabase:\u001b[22m before\u001b[22Gthe import,\u001b[34Grun \u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m. \u001b[38;2;177;185;249mddev snapshot restore \u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mbefore-page-tree\u001b[39m bring\u001b[28G back exactly\u001b[42Gtoday's\u001b[50Gstate\u001b[56Gin\u001b[59Ga\u001b[61Gfew\u001b[65Gseconds.\u001b[74GThis\u001b[79Gis\u001b[82Gthe\u001b[86Gimportant\u001b[96Gone,\r\u001b[2C\u001b[1B \u001b[5Gbecause the database isn't in git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFiles:\u001b[22m everything I add go\u001b[32Gs int\u001b[38G the site\u001b[48Gpackage and is v\u001b[65Gsible\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mclean\u001b[39m on those paths remove\u001b[34Gt, or\u001b[40Gyou can\u001b[48Gjust not commit it.\u001b[68G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSingle pages:\u001b[19G\u001b[22mpages\u001b[25Gdeleted\u001b[33Gin\u001b[36Gthe\u001b[40Gbackend\u001b[48Gcan\u001b[52Gbe\u001b[55Gbrought\u001b[63Gback\u001b[68Gwith\u001b[73Gthe\u001b[77GRecycler.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy plan is snapshot first, the\u001b[35Gthe import. I'll\u001b[52Gc\u001b[54Geck\u001b[58Gthe result in\u001b[72Gthe\u001b[76Gbackend\u001b[84Gand\u001b[88Gthe\u001b[92Gbrowser,\u001b[101Gand\r\u001b[2C\u001b[1Bleave\u001b[9Git\u001b[12Guncommitted\u001b[24Gso\u001b[27Gyou\u001b[31Gcan\u001b[35Greview\u001b[42Gthe\u001b[46Gdiff.\u001b[52GShall\u001b[58GI\u001b[60Ggo\u001b[63Gahead?\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
