[235.965886, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mFiles:\u001b[22m everything I add\u001b[29Ggoes\u001b[34Ginto the site pack\u001b[53Gg\u001b[56Ga\u001b[58Gd is vi\u001b[66Gible in\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[39m and\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[4C\u001b[1Bclean\u001b[39m on those paths\u001b[26Gremove it, or\u001b[40Gyou\u001b[44Gcan\u001b[48Gjust\u001b[53Gnot\u001b[57Gcommit\u001b[64Git.\r\u001b[4C\u001b[1B\u001b[1mS\u001b[7Gngle pages:\u001b[22m pa\u001b[22Ges\u001b[25Gdeleted in \u001b[37Ghe backend\u001b[48Gc\u001b[50Gn be brought\u001b[63Gback with the Recycler.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy plan is snapshot first, then the import. I'll\u001b[52Gcheck the result \u001b[70Gn the backend and\u001b[88Gthe\u001b[92Gbrowser,\u001b[101Gand\r\u001b[2C\u001b[1Bleave\u001b[9Git\u001b[12Guncommitted\u001b[24Gso\u001b[27Gyou\u001b[31Gcan\u001b[35Greview\u001b[42Gthe\u001b[46Gdiff.\u001b[52GShall\u001b[58GI\u001b[60Ggo\u001b[63Gahead?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 10s · done 8:55 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, take the snapshot and go ahead\u001b[39m                                                                     \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(typo3-distribution-content)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoaded\u001b[13Gskill\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, called typo3-dev-companion \u001b[1m2\u001b[22m times, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe s\u001b[9Gapshot\u001b[16G\u001b[38;2;177;185;249mbefore-page-tree\u001b[39m is saved and\u001b[46Gthe\u001b[50Gpage\u001b[55Gstructure is\u001b[68Gworked\u001b[75Gout\u001b[79Gfrom\u001b[84Gthe\u001b[88Gdesign.\u001b[96GPages\u001b[102G2–4\r\u001b[1B  have unexpectedly appeared in the database, so I'm tracing where they came from before going\u001b[96Gfurther.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\r\u001b[41C\u001b[2B\u001b[38;2;153;153;153mthought for 4s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
