[179.28639, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gpage) or the site's root page\u001b[35Grefer \u001b[42Go fixed number\u001b[57G, th\u001b[62Gy\u001b[64Gc\u001b[66Gn point at th\u001b[80G wrong page or none. The\u001b[K\r\u001b[4C\u001b[1Bmenu\u001b[10G would then stay empty or link\u001b[41Gto the wrong\u001b[54Gplace, but\u001b[65Gn\u001b[67Gthing would crash.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe import runs only once.\u001b[32G\u001b[22mTYPO3\u001b[38Gmarks\u001b[44Gthe\u001b[48Ginitial\u001b[56Gcontent\u001b[64Gas\u001b[67Gimported.\u001b[77GIf\u001b[80GI\u001b[82Gfix\u001b[86Gsomething\u001b[96Gin\u001b[99Git\r\u001b[2C\u001b[1B \u001b[5Glater, setting up the extens\u001b[34Gon ag\u001b[40Gin won't re-import it, so to\u001b[69Gtest \u001b[75Gt again we'd have to restore\u001b[104Gthe\r\u001b[4C\u001b[1Bd\u001b[7Gtabase\u001b[14Gfirst.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour existing content:\u001b[22m there's\u001b[36Gonly\u001b[42Ghe one \"Welcome to\u001b[61Gyour default website\" element,\u001b[92Gso\u001b[95Gthere's\r\u001b[2C\u001b[1B \u001b[5Gnothing of value to lose.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe design\u001b[16Gles,\u001b[21Gthe\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDatabase:\u001b[15G\u001b[22mbefore\u001b[22Gthe\u001b[26Gimport,\u001b[34Grun\u001b[38G\u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \r\u001b[2C\u001b[1B\u001b[39m  \u001b[38;2;177;185;249mbefore-page-tree\u001b[39m brings b\u001b[31Gck exactly today's state\u001b[56Gi\u001b[58G a few seconds. This\u001b[79Gis the\u001b[86Gimport\u001b[93Gnt one,\r\u001b[4C\u001b[1Bbecause\u001b[13Gthe\u001b[17Gdatabase\u001b[26Gisn't\u001b[32Gin\u001b[35Ggit.\r\u001b[2C\u001b[1B- \u001b[1mFiles:\u001b[22m everything\u001b[23GI\u001b[25Gadd\u001b[29Ggoes\u001b[34Ginto\u001b[39Gthe\u001b[43Gsite\u001b[48Gpackage\u001b[56Gand\u001b[60Gis\u001b[63Gvisible\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249mgit status\u001b[39m.\u001b[86G\u001b[38;2;177;185;249mgit restore\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mclean\u001b[39m on those pa\u001b[24Gs\u001b[26Grem\u001b[30Gve it, or you can just not commit it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSingle pages:\u001b[22m pages deleted in the backend can be brought back with the Recycler.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy plan is snapshot\u001b[23Gfirst, then the\u001b[39Gimport. I'll ch\u001b[55Gck the result in the backend and the browser, and\u001b[K\r\u001b[2C\u001b[1Bleave it uncommitted \u001b[25Go you can review the diff. Shall I go ahead?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 10s · done 8:55 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, take the snapshot and go ahead\u001b[39m                                                                     \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m*\u001b[3GTopsy-t\u001b[38;2;235;159;127murv\u001b[38;2;215;119;87mying… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
