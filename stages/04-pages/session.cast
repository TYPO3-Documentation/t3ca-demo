[86.326963, "o", "\u001b[?25l\u001b[H  - \u001b[1mRevenue & payments subpages:\u001b[34G\u001b[22mLand\u001b[39Grates\u001b[45Gshould\u001b[52Gsit\u001b[56Gunder\u001b[62Git,\u001b[66Gsince\u001b[72Git\u001b[75Guses\u001b[80Gthe\u001b[84Gsidebar-left\u001b[97Glayout\r\u001b[1B    with a\u001b[12Gsub-navigation.\u001b[K\r\u001b[1B  - \u001b[1mContact\u001b[22m (full width), \u001b[1mSearch\u001b[22m (sidebar right)\u001b[50Gand\u001b[54G\u001b[1mLogin / e-services portal\u001b[80G\u001b[22m(narrow).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA folder for the top service menu\u001b[39G\u001b[22m(E-services\u001b[51Gportal,\u001b[59GContact).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA folder for the footer menu:\u001b[35G\u001b[22mAccessibility\u001b[49Gstatement,\u001b[60GPrivacy\u001b[68Gpolicy,\u001b[76GAccess\u001b[83Gto\u001b[86Ginformation,\u001b[99GTenders.\r\u001b[1B  - \u001b[1mThe Home page's layout:\u001b[22m no backend layout is assigned to it, so it isn't using the \"Home\" layout.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mSite settings that are still 0\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[38;2;177;185;249mmtosafi.navigation.serviceMenu\u001b[39m,\u001b[37G\u001b[38;2;177;185;249mfooterMenu\u001b[48G\u001b[39mand\u001b[52G\u001b[38;2;177;185;249msearchPage\u001b[39m.\u001b[64GUntil\u001b[70Gthese\u001b[76Gpoint\u001b[82Gat\u001b[85Greal\u001b[90Gpages,\u001b[97Gthe\u001b[101Gtop\r\u001b[1B \u001b[3G \u001b[5Gservice links, the footer's \"Information\" column and the header\u001b[69Gsea\u001b[73Gch form stay hidden.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHome page content\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gslider\u001b[16Gwith\u001b[21Gthree\u001b[27Gslides\u001b[34Gand\u001b[38Gits\u001b[42Gimages.\r\u001b[2C\u001b[1B- The \"Popular services\" tiles.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNews\u001b[10Gand\u001b[14Gevents:\u001b[22Gthree\u001b[28Gnews\u001b[33Gcards\u001b[39Gand\u001b[43Gthree\u001b[49Gevents.\u001b[57GThe\u001b[61Gtexts\u001b[67Gare\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249mdesign/docs/news-and-events.docx\u001b[39m.\r\u001b[1B \u001b[3G- The newsletter sign-up.\u001b[K\r\u001b[2B  \u001b[1mFeatures\u001b[22m\u001b[K\r\u001b[1B  - The site package only includes \u001b[38;2;177;185;249mnavigation.js\u001b[39m. The design's \u001b[38;2;177;185;249mslider.js\u001b[39m, \u001b[38;2;177;185;249mforms.js\u001b[39m, \u001b[38;2;177;185;249mcalculator.js\u001b[39m and\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msearch.js\u001b[15G\u001b[39maren't\u001b[22Gthere\u001b[28Gyet.\r\u001b[1B \u001b[3G- Nothing \u001b[14Gandles\u001b[21Gthe forms yet: con\u001b[40Gact, newsletter (double\u001b[64Gopt-in)\u001b[72Gand\u001b[76Glogin.\u001b[83GThe\u001b[87Gdesign\u001b[94Gsays\u001b[99Gthe\r\u001b[1B    website has to do the real processing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThere's no search and no land rates calculator element. The calculator's rules are\u001b[88Gin\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdesign/docs/land-rates-calculation.md\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gsite\u001b[14Ghas\u001b[18Gonly\u001b[23GEnglish.\u001b[32GThe\u001b[36Gdesign\u001b[43Ghas\u001b[47Ga\u001b[49GKiswahili\u001b[59Glanguage\u001b[68Gswitch.\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
