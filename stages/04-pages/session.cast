[478.84887, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mBuild/Initialisation/seed-page-tree.php\u001b[39m: t\u001b[48Ge script that creates th\u001b[73G \u001b[75Gre\u001b[78G. To change the tr\u001b[97Ge, change\r\u001b[4C\u001b[1Bthis script, not\u001b[22Gth\u001b[25G pages by hand.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mconfig/sites/main/settings.yaml\u001b[39m:\u001b[38Gpoints\u001b[45Gthe\u001b[49Gservice\u001b[57Gmenu,\u001b[63Gfooter\u001b[70Gmenu\u001b[75Gand\u001b[79Gsearch\u001b[86Gpage\u001b[91Gsettings\u001b[100Gat\r\u001b[2C\u001b[1B  pages 22, 23 and 16.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Initialisation/data.xml\u001b[39m: the exported tree, 26 pages.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/Initialisation/Site/main/\u001b[39m:\u001b[61Ga\u001b[63Gcopy\u001b[68Gof\u001b[71Gthe\u001b[75Gsite\u001b[80Gconfig.\u001b[88GI\u001b[90Gchanged\u001b[98Gits\u001b[102Gbase\r\u001b[2C\u001b[1B \u001b[5Gto \u001b[38;2;177;185;249m/\u001b[39m so it works on any domain.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/README.md\u001b[39m:\u001b[45Ghow\u001b[49Gthe\u001b[53Gtree\u001b[58Gis\u001b[61Gmade,\u001b[67Gplus\u001b[72Ga\u001b[74Gwarning\u001b[82Gabout\u001b[88Gthe\u001b[92Gthree\u001b[98Gpage\u001b[103GIDs.\r\u001b[33C\u001b[1B\u001b[38;2;177;185;249mcomposer.json\u001b[39m and \u001b[38;2;177;185;249mcomposer.lock\u001b[39m: th\u001b[70G package now r\u001b[85Gquires\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mtypo3/cms-impexp\u001b[39m, without which the import is silently skipped.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot proven yet:\u001b[22m whether a fresh installation gets\u001b[54Gh\u001b[56G pages, the site and working menus.\u001b[92GIn particular,\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdon't know whether the three page IDs in the settings come out the same there, so that\u001b[92Gsentence\u001b[101Gin\u001b[104Gthe\r\u001b[2C\u001b[1BREADME is untested.\u001b[23GChecking it means\u001b[41Ge\u001b[44Gtying the da\u001b[57Gaba\u001b[61Ge, running\u001b[72G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m,\u001b[85Gchecking\u001b[94Gthe\u001b[98Gsite,\r\u001b[2C\u001b[1Bthen\u001b[8Grestoring\u001b[18Gwith\u001b[23G\u001b[38;2;177;185;249mddev snapshot restore after-page-tree\u001b[61G\u001b[39mand\u001b[65G\u001b[38;2;177;185;249mgit restore config/system/settings.php\u001b[39m.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mtypo3 setup --force\u001b[39m r\u001b[25Gwrites t\u001b[34Gat file, so it needs restoring too. Your current work i\u001b[90G saved in that\u001b[K\r\u001b[2C\u001b[1Bsnapshot, and the o\u001b[23Giginal state is\u001b[39Gstill in \u001b[38;2;177;185;249mbefore-page-tree\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDo you want me\u001b[18Gto run that test, or leave it unproven for\u001b[61Gnow? If you'd rather do it yourself, typing\r\u001b[2C\u001b[1Bthe commands with \u001b[38;2;177;185;249m! \u001b[39m in front runs th\u001b[41Gm\u001b[43Gin\u001b[46Gthis se\u001b[54Gsion.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 3m 10s · done 8:59 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mshow me the result in a browser\u001b[39m                                                                         \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✽\u001b[3GSu\u001b[38;2;235;159;127mbli\u001b[38;2;215;119;87mmating… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
