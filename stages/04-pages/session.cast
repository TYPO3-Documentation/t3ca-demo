[148.382558, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BShall I\u001b[11Gstart\u001b[17Gon the page tree as in\u001b[40Gtial content?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 7s · done 8:55 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIs there anything I could break, and can I undo it?\u001b[39m                                                     \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mVery little can break, and all\u001b[34Gof\u001b[37Git\u001b[40Gcan\u001b[44Gbe\u001b[47Gundone,\u001b[55Gas\u001b[58Glong\u001b[63Gas\u001b[66Gwe\u001b[69Gtake\u001b[74Ga\u001b[76Gdatabase\u001b[85Gsnapshot\u001b[94Gfirst.\r\u001b[2B  \u001b[1mWhat could go wrong\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA second \"Home\" page.\u001b[27G\u001b[22mInitial\u001b[35Gcontent\u001b[43Gis\u001b[46Gimported\u001b[55Gas\u001b[58Ga\u001b[60Gnew\u001b[64Gpage\u001b[69Gtree.\u001b[75GThe\u001b[79Gexisting\u001b[88GHome\u001b[93Gpage\u001b[98G(uid 1)\r\u001b[1B \u001b[3G  stays, so\u001b[15Gyou'd see two root\u001b[34Gpages, \u001b[43Gd the sit\u001b[53G would keep poin\u001b[70Ging\u001b[75Gt the old\u001b[85Go\u001b[87Ge until \u001b[96Gt\u001b[98G config\r\u001b[4C\u001b[1Bis\u001b[8Gchanged.\r\u001b[2C\u001b[1B- \u001b[1mWrong page IDs.\u001b[22m The\u001b[25Gimport\u001b[32Ggives\u001b[38Gpages\u001b[44Gnew\u001b[48GIDs.\u001b[53GIf\u001b[56Gthe\u001b[60Gsettings\u001b[69G(service\u001b[78Gmenu,\u001b[84Gfooter\u001b[91Gmenu,\u001b[97Gsearch\r\u001b[2C\u001b[1B \u001b[5Gpage) or the site's root page\u001b[35Grefer \u001b[42Go fixed number\u001b[57G, th\u001b[62Gy\u001b[64Gc\u001b[66Gn point at th\u001b[80G wrong page or none. The\u001b[K\r\u001b[4C\u001b[1Bmenu\u001b[10G would then stay empty or link\u001b[41Gto the wrong\u001b[54Gplace, but\u001b[65Gn\u001b[67Gthing would crash.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe import runs only once.\u001b[32G\u001b[22mTYPO3\u001b[38Gmarks\u001b[44Gthe\u001b[48Ginitial\u001b[56Gcontent\u001b[64Gas\u001b[67Gimported.\u001b[77GIf\u001b[80GI\u001b[82Gfix\u001b[86Gsomething\u001b[96Gin\u001b[99Git\r\u001b[2C\u001b[1B \u001b[5Glater, setting up the extens\u001b[34Gon ag\u001b[40Gin won't re-import it, so to\u001b[69Gtest \u001b[75Gt again we'd have to restore\u001b[104Gthe\r\u001b[4C\u001b[1Bd\u001b[7Gtabase\u001b[14Gfirst.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour existing content:\u001b[22m there's\u001b[36Gonly\u001b[42Ghe one \"Welcome to\u001b[61Gyour default website\" element,\u001b[92Gso\u001b[95Gthere's\r\u001b[2C\u001b[1B \u001b[5Gnothing of value to lose.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe design\u001b[16Gles,\u001b[21Gthe\u001b[25Gtemplates\u001b[35Gand\u001b[39Gthe\u001b[43Gbackend\u001b[51Gstay\u001b[56Guntouched,\u001b[67Gand\u001b[71Gnothing\u001b[79Gleaves\u001b[86Gyour\u001b[91Gmachine.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[148.826594, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mDatabase:\u001b[15G\u001b[22mbefore\u001b[22Gthe\u001b[26Gimport,\u001b[34Grun\u001b[38G\u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m.\u001b[77G\u001b[38;2;177;185;249mddev snapshot restore \u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[149.22875, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIs there anything I could break, and can I undo it?\u001b[39m                                                     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mVery\u001b[8Glittle\u001b[15Gcan\u001b[19Gbreak,\u001b[26Gand\u001b[30Gall\u001b[34Gof\u001b[37Git\u001b[40Gcan\u001b[44Gbe\u001b[47Gundone,\u001b[55Gas\u001b[58Glong\u001b[63Gas\u001b[66Gwe\u001b[69Gtake\u001b[74Ga\u001b[76Gdatabase\u001b[85Gsnapshot\u001b[94Gfirst.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat could go wrong\r\u001b[1B\u001b[22m \u001b[3G- \u001b[1mA second \"Home\" page.\u001b[22m Initial con\u001b[39Gent is import\u001b[53Gd\u001b[58Ga \u001b[61Gew pag\u001b[70Gre\u001b[73G. The exi\u001b[83Gting Home page (uid 1)\r\u001b[4C\u001b[1Bstays,\u001b[12Gso\u001b[15Gyou'd\u001b[21Gsee\u001b[25Gtwo\u001b[29Groot\u001b[34Gpages,\u001b[41Gand\u001b[45Gthe\u001b[49Gsite\u001b[54Gwould\u001b[60Gkeep\u001b[65Gpointing\u001b[74Gat\u001b[77Gthe\u001b[81Gold\u001b[85Gone\u001b[89Guntil\u001b[95Gits\u001b[99Gconfig\r\u001b[2C\u001b[1B  is changed.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWrong page IDs.\u001b[22m The impor\u001b[31G gives pages new IDs. If the\u001b[60Gs\u001b[62Gttin\u001b[67Gs\u001b[69G(s\u001b[72Grvice m\u001b[80Gnu, footer menu, search\u001b[K\r\u001b[4C\u001b[1Bpage) or the site's\u001b[25Gro\u001b[28Gt page refer\u001b[41Gto fix\u001b[48Gd numbers, th\u001b[62Gy can po\u001b[72Gt\u001b[81Gwrong page or\u001b[95Gnone. The\u001b[K\r\u001b[4C\u001b[1Bmenus would\u001b[17Gthen\u001b[22Gstay\u001b[27Gempty\u001b[33Gor\u001b[36Glink\u001b[41Gto\u001b[44Gthe\u001b[48Gwrong\u001b[54Gplace,\u001b[61Gbut\u001b[65Gnothing\u001b[73Gwould\u001b[79Gcrash.\r\u001b[4C\u001b[1B\u001b[1mThe im\u001b[12Gort\u001b[16Gruns only once.\u001b[32G\u001b[22mTYPO3\u001b[38Gm\u001b[40Grk\u001b[44Gthe\u001b[48Ginitial\u001b[56Gconten\u001b[63G as imported. If I fix somethi\u001b[94Gg in it\u001b[K\r\u001b[4C\u001b[1Bl\u001b[7Gt\u001b[9Gr, se\u001b[15Gting up the extension again won't re-import\u001b[59Git, so to tes\u001b[74Gi\u001b[77Gagain we'd have to restore the\r\u001b[4C\u001b[1Bdatabase first.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mYour exis\u001b[15Ging content:\u001b[22m there's only the one \"Welcome to your defaul\u001b[73G website\" element, so there's\r\u001b[4C\u001b[1Bno\u001b[8Ghing of value to lose.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe design files, the templat\u001b[33Gs and the back\u001b[48Gnd stay un\u001b[60Guched, and nothing l\u001b[81Gav\u001b[84Gs your machin\u001b[98G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to undo it\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mDatabase:\u001b[22m before the i\u001b[29Gor\u001b[32G, ru\u001b[37G \u001b[38;2;177;185;249mddev snapshot --name before-page-tree\u001b[39m. \u001b[38;2;177;185;249mddev snapshot restore \r\u001b[4C\u001b[1Bbefore-page-tree\u001b[22G\u001b[39mbrings\u001b[29Gback\u001b[34Gexactly\u001b[42Gtoday's\u001b[50Gstate\u001b[56Gin\u001b[59Ga\u001b[61Gfew\u001b[65Gseconds.\u001b[74GThis\u001b[79Gis\u001b[82Gthe\u001b[86Gimportant\u001b[96Gone,\r\u001b[2C\u001b[1B  because the database\u001b[26Gisn't\u001b[32Gin\u001b[35Ggit.\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
