[120.520428, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249msearch.js\u001b[15G\u001b[39maren't\u001b[22Gthere\u001b[28Gyet.\r\u001b[2C\u001b[1B- Nothing\u001b[13Ghandles\u001b[21Gthe\u001b[25Gforms\u001b[31Gyet:\u001b[36Gcontact,\u001b[45Gnewsletter\u001b[56G(double\u001b[64Gopt-in)\u001b[72Gand\u001b[76Glogin.\u001b[83GThe\u001b[87Gdesign\u001b[94Gsays\u001b[99Gthe\r\u001b[2C\u001b[1B \u001b[5Gwebsite has to do the\u001b[27Grea\u001b[31G processing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThere's no s\u001b[18Garch and no land\u001b[35Grates\u001b[41Gcalculator\u001b[52Gelement.\u001b[61GThe\u001b[65Gcalculator's\u001b[78Grules\u001b[84Gare\u001b[88Gin\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdesign/docs/land-rates-calculation.md\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe site has \u001b[19Gnly\u001b[23GEnglish.\u001b[32GThe de\u001b[40Ggn has\u001b[47Ga\u001b[49GKiswahili\u001b[59Glanguage\u001b[68Gswitch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe obvious next step is to build the page\u001b[46Gtree,\u001b[52Gset\u001b[56Gthe\u001b[60Gthree\u001b[66Gsettings\u001b[75Gand\u001b[79Ggive\u001b[84GHome\u001b[89Gits\u001b[93Glayout;\u001b[101Gthat\r\u001b[2C\u001b[1Bgets the menu\u001b[17G, footer and search form working. I cou\u001b[57Gd\u001b[59Galso ship it as initial\u001b[83Gcontent\u001b[91Ginside\u001b[98Gthe\u001b[102Gsite\r\u001b[2C\u001b[1Bpackage\u001b[11Gso\u001b[14Git\u001b[17Gcomes\u001b[23Gup\u001b[26Gon\u001b[29Ga\u001b[31Gfresh\u001b[37Ginstall.\u001b[46GDo\u001b[49Gyou\u001b[53Gwant\u001b[58Gme\u001b[61Gto\u001b[64Gdo\u001b[67Geither?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 21s · done 8:54 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m What do you suggest I do first, and why?\u001b[39m                                                               \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mStart\u001b[9Gwith\u001b[14Gthe\u001b[18Gpage\u001b[23Gtree,\u001b[29Gand\u001b[33Gship\u001b[38Git\u001b[41Gwith\u001b[46Gthe\u001b[50Gsite\u001b[55Gpackage\u001b[63Gas\u001b[66Ginitial\u001b[74Gcontent\u001b[82Grather\u001b[89Gthan\u001b[94Gclicking\u001b[103Git\r\u001b[1B  together in the backend.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mWhy the page tree first\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mEverything else depends on it.\u001b[36G\u001b[22mThe\u001b[40Gmenus,\u001b[47Gthe\u001b[51Gthree\u001b[57Gsite\u001b[62Gsettings\u001b[71G(service\u001b[80Gmenu,\u001b[86Gfooter\u001b[93Gmenu,\u001b[99Gsearch\r\u001b[4C\u001b[1Bpage),\u001b[12Gthe\u001b[16Gsub-navigation\u001b[31Gon\u001b[34GLand\u001b[39Grates\u001b[45Gand\u001b[49Gthe\u001b[53Gbreadcrumb\u001b[64Gall\u001b[68Gneed\u001b[73Greal\u001b[78Gpages.\u001b[85GThe\u001b[89Gsettings\u001b[98Geven\u001b[103Gneed\r\u001b[2C\u001b[1B  their page IDs, which\u001b[27Gdon't\u001b[33Gexist\u001b[39Gyet.\r\u001b[4C\u001b[1B\u001b[1mIt's \u001b[12Ge fastest visible result.\u001b[22m With no new code, the main me\u001b[68Gu fills \u001b[77Gn,\u001b[80Gthe footer's\u001b[93G\"I\u001b[96Gformation\"\r\u001b[4C\u001b[1Bcolumn\u001b[12Gand\u001b[16Gthe service links\u001b[34Gshow\u001b[39Gup, the search form appears,\u001b[68Gand you can check all five layouts\u001b[103Gon\u001b[K\r\u001b[4C\u001b[1Breal pages.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[120.968535, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mIt tests the site package you just built.\u001b[47G\u001b[22mIf\u001b[50Ga\u001b[52Glayout\u001b[59Gor\u001b[62Gmenu\u001b[67Gis\u001b[70Gwrong,\u001b[77Gyou'll\u001b[84Gsee\u001b[88Git\u001b[91Gnow,\u001b[96Gbefore\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[121.121157, "o", "\u001b[?25l\u001b[H\u001b[5Gwebsite has to do the real processing.\r\u001b[4C\u001b[1BThere's\u001b[13Gno search and no land rates \u001b[42Galculator element. The calculator's rules are in\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdesign/docs/land-rates-calculation.md\r\u001b[7C\u001b[1B\u001b[39m site ha\u001b[17G only\u001b[23GE\u001b[25Gglish. The design has \u001b[48G Kiswahili language switch.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe obv\u001b[11Gous next step is to build the page tree, set the three sett\u001b[71Gngs and\u001b[79Ggive\u001b[84GHome\u001b[89Gits\u001b[93Glayout;\u001b[101Gthat\r\u001b[2C\u001b[1Bgets\u001b[8Gthe\u001b[12Gmenus,\u001b[19Gfooter\u001b[26Gand\u001b[30Gsearch\u001b[37Gform\u001b[42Gworking.\u001b[51GI\u001b[53Gcould\u001b[59Galso\u001b[64Gship\u001b[69Git\u001b[72Gas\u001b[75Ginitial\u001b[83Gcontent\u001b[91Ginside\u001b[98Gthe\u001b[102Gsite\r\u001b[2C\u001b[1Bpackage so it comes up on a\u001b[31Gfresh\u001b[37Ginstall.\u001b[46GDo you wan\u001b[57G me to do \u001b[68Gi\u001b[70Gher?\u001b[75G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 21s · done 8:54 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m What do you suggest I do first, and why?\u001b[39m                                                               \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Start with the page tree, and ship it with the site package as initial content rather than clicking it\u001b[K\r\u001b[2C\u001b[1Btogether\u001b[12Gin\u001b[15Gthe\u001b[19Gbackend.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy the page tree first\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEverything else depends on it.\u001b[36G\u001b[22mThe\u001b[40Gmenus,\u001b[47Gthe\u001b[51Gthree\u001b[57Gsite\u001b[62Gsettings\u001b[71G(service\u001b[80Gmenu,\u001b[86Gfooter\u001b[93Gmenu,\u001b[99Gsearch\r\u001b[2C\u001b[1B  page), the sub-navigation\u001b[31Gon\u001b[34GLand\u001b[39Grates\u001b[45Gand\u001b[49Gthe\u001b[53Gbreadcrumb\u001b[64Gall\u001b[68Gneed\u001b[73Greal\u001b[78Gpages.\u001b[85GThe\u001b[89Gsettings\u001b[98Geven\u001b[103Gneed\r\u001b[2C\u001b[1B \u001b[5Gtheir page IDs, which don't exist yet.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's the fastest visible result.\u001b[22m With no \u001b[47Gew code, the main menu fills in, the footer's \"Information\"\u001b[K\r\u001b[4C\u001b[1Bcolumn \u001b[13Gnd\u001b[16Gthe service links show\u001b[39Gup, the\u001b[47Gsearch\u001b[54Gform\u001b[59Gappears,\u001b[68Gand\u001b[72Gyou\u001b[76Gcan\u001b[80Gcheck\u001b[86Gall\u001b[90Gfive\u001b[95Glayouts\u001b[103Gon\r\u001b[2C\u001b[1B \u001b[5Greal pages.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt tests the site package you just built.\u001b[47G\u001b[22mIf a lay\u001b[56Gut\u001b[59Gor menu is wrong, you'll see it now, before\u001b[103G\u001b[K\r\u001b[4C\u001b[1Bcontent \u001b[14Glements\u001b[22Gare\u001b[26Glayered\u001b[34Gon\u001b[37Gtop.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[121.419921, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GThere's\u001b[13Gno search\u001b[23Gand\u001b[27Gno \u001b[31Gand rates calculator\u001b[52Gelement.\u001b[61GThe\u001b[65Gcalculator's\u001b[78Grules\u001b[84Gare\u001b[88Gin\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdesign/docs/land-rates-calculation.md\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe site has only English. The design has\u001b[47Ga\u001b[49GKiswahili\u001b[59Glanguage\u001b[68Gswitch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gobvious\u001b[15Gnext\u001b[20Gstep\u001b[25Gis\u001b[28Gto\u001b[31Gbuild\u001b[37Gthe\u001b[41Gpage\u001b[46Gtree,\u001b[52Gset\u001b[56Gthe\u001b[60Gthree\u001b[66Gsettings\u001b[75Gand\u001b[79Ggive\u001b[84GHome\u001b[89Gits\u001b[93Glayout;\u001b[101Gthat\r\u001b[2C\u001b[1Bgets the menus, footer and search\u001b[37Gform working. I could also ship it a\u001b[75Gi\u001b[77Gitial cont\u001b[88Gnt inside \u001b[99Ghe si\u001b[105Ge\r\u001b[2C\u001b[1Bpackage so it comes up\u001b[26Go\u001b[28G a fres\u001b[37Ginstall. Do you\u001b[53Gwant me t\u001b[64Gdo either?\u001b[75G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 21s · done 8:54 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m What do you suggest I do first, and why?\u001b[39m                                                               \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mStart\u001b[9Gwith\u001b[14Gthe\u001b[18Gpage\u001b[23Gtree,\u001b[29Gand\u001b[33Gship\u001b[38Git\u001b[41Gwith\u001b[46Gthe\u001b[50Gsite\u001b[55Gpackage\u001b[63Gas\u001b[66Ginitial\u001b[74Gcontent\u001b[82Grather\u001b[89Gthan\u001b[94Gclicking\u001b[103Git\r\u001b[1B \u001b[3Gtoge\u001b[8Gher in the backend.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy the page tree first\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEverything\u001b[16Gels\u001b[21Gdepends on it.\u001b[36G\u001b[22mThe\u001b[40Gmenus,\u001b[47Gthe\u001b[51Gthree\u001b[57Gsite\u001b[62Gsettings\u001b[71G(service\u001b[80Gmenu,\u001b[86Gfooter\u001b[93Gmenu,\u001b[99Gsearch\r\u001b[2C\u001b[1B \u001b[5Gpage), the sub-navigation on Land rates and the br\u001b[56Gadcrumb all need real pag\u001b[82Gs. The s\u001b[91Gttings ev\u001b[101Gn need\r\u001b[4C\u001b[1Btheir pag\u001b[16GIDs, wh\u001b[24Gch d\u001b[30G't exist\u001b[39Gye\u001b[42G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's the fastest visible result.\u001b[22m With no\u001b[46Gnew\u001b[50Gcode,\u001b[56Gthe\u001b[60Gmain\u001b[65Gmenu\u001b[70Gfills\u001b[76Gin,\u001b[80Gthe\u001b[84Gfooter's\u001b[93G\"Information\"\r\u001b[2C\u001b[1B \u001b[5Gcolumn and the service links show up,\u001b[43Gthe search form appears, and you\u001b[76Gcan\u001b[80Gc\u001b[83Gck all five layouts \u001b[105G\u001b[K\r\u001b[4C\u001b[1Breal pages.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt tests the site package you just built.\u001b[47G\u001b[22mIf\u001b[50Ga\u001b[52Glayout\u001b[59Gor\u001b[62Gmenu\u001b[67Gis\u001b[70Gwrong,\u001b[77Gyou'll\u001b[84Gsee\u001b[88Git\u001b[91Gnow,\u001b[96Gbefore\r\u001b[2C\u001b[1B \u001b[5Gcontent elements are layered on top.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy as initial content in the package\u001b[22m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
