[220.724276, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7GTYPO3\u001b[13Gdev-companion\u001b[27Gis\u001b[30Ginstalled\u001b[40Gas\u001b[43Ga\u001b[45Gdev\u001b[49Gdependency\u001b[60Gand\u001b[64Gset\u001b[68Gup\u001b[71Gfor\u001b[75GClaude\u001b[82GCode.\u001b[88GI\u001b[90Gstarted\u001b[98Gthe\r\u001b[1B \u001b[3Gserver the same way Claude\u001b[30GCode will\u001b[41Gnd it answere\u001b[55G correctly, b\u001b[69Gt\u001b[71Gthe\u001b[75Gtools won't appear in Claude\r\u001b[2C\u001b[1Buntil you restart the session.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I did\r\u001b[2C\u001b[1B\u001b[22m1. I ran \u001b[38;2;177;185;249mddev composer require --dev \"typo3/dev-companion:@dev\"\u001b[39m.\u001b[68GThat\u001b[73Gadded\u001b[79G\u001b[38;2;177;185;249m\"typo3/dev-companion\": \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249m\"@dev\"\u001b[39m to \u001b[38;2;177;185;249mrequire-dev\u001b[39m in \u001b[38;2;177;185;249mcompos\u001b[38Gr.json\u001b[39m and updated \u001b[38;2;177;185;249mc\u001b[59Gmpos\u001b[64Gr.lock\u001b[39m. The package has no tagged releases\r\u001b[5C\u001b[1Byet, so \u001b[38;2;177;185;249mdev-ma\u001b[21Gn\u001b[39m (comm\u001b[29Gt\u001b[31G\u001b[38;2;177;185;249m0be1006\u001b[39m) is the only version you can install.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GI ran \u001b[38;2;177;185;249mddev exec vendor/bin/typo3-dev-companion install --agent=claude\u001b[39m,\u001b[77Gwhich\u001b[83Gdid\u001b[87Gtwo\u001b[91Gthings:\r\u001b[2C\u001b[1B  \u001b[6G-\u001b[8G\u001b[1mCreated \u001b[38;2;177;185;249m.mcp.json\u001b[22m\u001b[39m, which registers the server. Claude Code starts it\u001b[78Gith \u001b[38;2;177;185;249msh \u001b[39m\u001b[K\r\u001b[5C\u001b[1B \u001b[8G\u001b[38;2;177;185;249mvendor/bin/typo3-dev-companion-ddev vendor/bin/typo3