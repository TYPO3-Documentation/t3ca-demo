[274.464098, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhich icon identifier is the right one for a delete button in the\u001b[39m                                       \r\u001b[1B  \u001b[38;2;255;255;255m     \u001b[9G TYPO3 backend?\u001b[39m                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mUse\u001b[7G\u001b[38;2;177;185;249m\u001b[1mactions-delete\u001b[22G\u001b[22m\u001b[39m(the\u001b[27Gtrash\u001b[33Gcan\u001b[37Gicon).\u001b[44GI\u001b[46Glooked\u001b[53Git\u001b[56Gup\u001b[59Gin\u001b[62Gthis\u001b[67Ginstallation's\u001b[82Gbackend\u001b[90Gicon\u001b[95Gregistry\u001b[104Gand\r\u001b[1B \u001b[3Git is registered there.\u001b[27G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[90m<\u001b[94mcore:icon\u001b[90m \u001b[36midentifier\u001b[90m=\u001b[31m\"actions-delete\"\u001b[90m \u001b[36msize\u001b[90m=\u001b[31m\"small\"\u001b[90m />\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BOr\u001b[6Gin\u001b[9GPHP:\u001b[14G\u001b[38;2;177;185;249m$iconFactory->getIcon('actions-delete', IconSize::SMALL)\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIdentifiers\u001b[15Gto\u001b[18Gavoid:\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mactions-edit-delete\u001b[39m and \u001b[38;2;177;185;249mactions-selection-delete\u001b[54G\u001b[22m\u001b[39mare\u001b[58Gonly\u001b[63Golder\u001b[69Galiases\u001b[77Gthat\u001b[82Gpoint\u001b[88Gto\u001b[91G\u001b[38;2;177;185;249mactions-delete\u001b[39m.\r\u001b[2C\u001b[1B \u001b[5GUse the main name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mactions-delete-restore\u001b[28G\u001b[22m\u001b[39mis\u001b[31Gfor\u001b[35Gundoing\u001b[43Ga\u001b[45Gdelete,\u001b[53Gnot\u001b[57Gfor\u001b[61Gdeleting.\r\u001b[12C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mclose\u001b[39m and \u001b[38;2;177;185;249mactions-minus\u001b[22m\u001b[39m also c\u001b[44Gme up in\u001b[53Gthe\u001b[57Gsearch. They mean\u001b[75G\"close\"\u001b[83Gand\u001b[87G\"remove\u001b[95Gfrom\u001b[100Glist\",\r\u001b[2C\u001b[1B \u001b[5Gnot \"delete the record\".\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 6s · done 8:18 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhich tools did you call?\u001b[39m                                                                               \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gmade\u001b[10Gtwo\u001b[14Gcalls:\r\u001b[1B\u001b[K\r\u001b[1B  1.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[274.753776, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[38;2;177;185;249m\u001b[1mToolSearch\u001b[17G\u001b[22m\u001b[39mloaded\u001b[24Gthe\u001b[28Gschemas\u001b[36Gfor\u001b[40G\u001b[38;2;177;185;249mtypo3_icon_lookup\u001b[58G\u001b[39mand\u001b[62G\u001b[38;2;177;185;249mtypo3_project_describe\u001b[85G\u001b[39mfrom\u001b[90Gthe\u001b[94GTYPO3\u001b[100Gdev\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[274.897752, "o", "\u001b]0;◐ TYPO3 backend delete button icon\u0007"]
[275.052788, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mCalled typo3-dev-companion \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mUse \u001b[38;2;177;185;249m\u001b[1mactions-delete\u001b[22m\u001b[39m (the trash\u001b[33Gcan\u001b[37Gicon).\u001b[44GI\u001b[46Glooked\u001b[53Git\u001b[56Gup\u001b[59Gin\u001b[62Gthis\u001b[67Ginstallation's\u001b[82Gbackend\u001b[90Gicon\u001b[95Gregistry\u001b[104Gand\r\u001b[2C\u001b[1Bit\u001b[6Gis\u001b[9Gregistered\u001b[20Gthere.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[90m<\u001b[94mcore:icon\u001b[90m \u001b[36midentifier\u001b[90m=\u001b[31m\"actions-delete\"\u001b[90m \u001b[36msize\u001b[90m=\u001b[31m\"small\"\u001b[90m />\r\u001b[2C\u001b[2B\u001b[39mOr in PHP: \u001b[38;2;177;185;249m$iconFactory->getIcon('actions-delete', IconSize::SMALL)\u001b[39m.\r\u001b[2C\u001b[2BIdentifiers to avoid:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mactions-edit-delete\u001b[39m and \u001b[38;2;177;185;249mactions-selection-delete\u001b[54G\u001b[22m\u001b[39mare\u001b[58Gonly\u001b[63Golder\u001b[69Galiases\u001b[77Gthat\u001b[82Gpoint\u001b[88Gto\u001b[91G\u001b[38;2;177;185;249mactions-delete\u001b[39m.\r\u001b[2C\u001b[1B  Use th\u001b[12G main\u001b[18Gname.\u001b[K\r\u001b[12C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mdelete-r\u001b[22Gstore\u001b[22m\u001b[39m is for undoing a delete, not f\u001b[59Gr deleting.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mactions-close\u001b[39m and \u001b[38;2;177;185;249mactions-minus\u001b[37G\u001b[22m\u001b[39malso\u001b[42Gcame\u001b[47Gup\u001b[50Gin\u001b[53Gthe\u001b[57Gsearch.\u001b[65GThey\u001b[70Gmean\u001b[75G\"close\"\u001b[83Gand\u001b[87G\"remove\u001b[95Gfrom\u001b[100Glist\",\r\u001b[2C\u001b[1B \u001b[5Gnot \"delete the record\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 6s · done 8:18 AM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mWhich tools did you call?\u001b[39m                                                                               \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m I made two calls:\u001b[K\r\u001b[2B \u001b[3G1. \u001b[38;2;177;185;249m\u001b[1mToolSearch\u001b[22m\u001b[39m \u001b[18Goaded\u001b[24Gthe\u001b[28Gschemas\u001b[36Gfor\u001b[40G\u001b[38;2;177;185;249mtypo3_icon_lookup\u001b[58G\u001b[39mand\u001b[62G\u001b[38;2;177;185;249mtypo3_project_describe\u001b[85G\u001b[39mfrom\u001b[90Gthe\u001b[94GTYPO3\u001b[100Gdev\r\u001b[5C\u001b[1Bcompanion\u001b[16GMCP\u001b[20Gserver.\u001b[28GThey\u001b[33Garen't\u001b[40Gavailable\u001b[50Guntil\u001b[56Gthey're\u001b[64Gloaded.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[275.403171, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[38;2;177;185;249m\u001b[1mtypo3_icon_lookup\u001b[24G\u001b[22m\u001b[39mwith\u001b[29G\u001b[38;2;177;185;249mquery: \"delete\"\u001b[39m,\u001b[46Glimit 15.\u001b[56GIt\u001b[59Gsearched\u001b[68Gthis\u001b[73Ginstallation's\u001b[88Gbackend\u001b[96Gicon\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[275.703906, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mUse\u001b[7G\u001b[38;2;177;185;249m\u001b[1mactions-delete\u001b[22G\u001b[22m\u001b[39m(the\u001b[27Gtrash\u001b[33Gcan\u001b[37Gicon).\u001b[44GI\u001b[46Glooked\u001b[53Git\u001b[56Gup\u001b[59Gin\u001b[62Gthis\u001b[67Ginstallation's\u001b[82Gbackend\u001b[90Gicon\u001b[95Gregistry\u001b[104Gand\r\u001b[2C\u001b[1Bit is registered there.\u001b[K\r\u001b[2B \u001b[3G\u001b[90m<\u001b[94mcore:icon\u001b[90m \u001b[36midentifier\u001b[90m=\u001b[31m\"actions-delete\"\u001b[90m \u001b[36msize\u001b[90m=\u001b[31m\"small\"\u001b[90m />\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOr\u001b[6Gin\u001b[9GPHP:\u001b[14G\u001b[38;2;177;185;249m$iconFactory->getIcon('actions-delete', IconSize::SMALL)\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIdentifiers\u001b[15Gto\u001b[18Gavoid:\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mactions-edit-delete\u001b[39m and \u001b[38;2;177;185;249mactions-selection-delete\u001b[22m\u001b[39m are only older aliases\u001b[77Gthat\u001b[82Gpoint\u001b[88Gto\u001b[91G\u001b[38;2;177;185;249mactions-delete\u001b[39m.\r\u001b[4C\u001b[1BUse\u001b[9Gthe\u001b[13Gmain\u001b[18Gname.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mactions-delete-restore\u001b[28G\u001b[22m\u001b[39mis\u001b[31Gfor\u001b[35Gundoing\u001b[43Ga\u001b[45Gdelete,\u001b[53Gnot\u001b[57Gfor\u001b[61Gdeleting.\r\u001b[12C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mclose\u001b[39m and \u001b[38;2;177;185;249mactions-m\u001b[33Gnu\u001b[36G\u001b[22m\u001b[39m also came up in the search. They me\u001b[73Gn \"close\" and \"remove from list\",\r\u001b[4C\u001b[1Bnot\u001b[9G\"d\u001b[12Glete the record\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 6s · done 8:18 AM\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhich tools did you call?\u001b[39m                                                                               \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gmade\u001b[10Gtwo\u001b[14Gcalls:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249m\u001b[1mToolSearch\u001b[17G\u001b[22m\u001b[39mloaded\u001b[24Gthe\u001b[28Gschemas\u001b[36Gfor\u001b[40G\u001b[38;2;177;185;249mtypo3_icon_lookup\u001b[58G\u001b[39mand\u001b[62G\u001b[38;2;177;185;249mtypo3_project_describe\u001b[85G\u001b[39mfrom\u001b[90Gthe\u001b[94GTYPO3\u001b[100Gdev\r\u001b[1B \u001b[3G \u001b[5G companion MCP server.\u001b[28GThey\u001b[33Garen't\u001b[40Gavailable\u001b[50Guntil\u001b[56Gthey're\u001b[64Gloaded.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[38;2;177;185;249m\u001b[1mtypo3_icon_lookup\u001b[24G\u001b[22m\u001b[39mwith\u001b[29G\u001b[38;2;177;185;249mquery: \"delete\"\u001b[39m,\u001b[46Glimit 15.\u001b[56GIt\u001b[59Gsearched\u001b[68Gthis\u001b[73Ginstallation's\u001b[88Gbackend\u001b[96Gicon\r\u001b[2C\u001b[1B  \u001b[6Gregistry and returned\u001b[28G\u001b[38;2;177;185;249mactions-dele\u001b[41Ge\u001b[39m as the top match, along with its aliases and the related\u001b[100Gicons\u001b[106GI\r\u001b[5C\u001b[1Blisted.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
