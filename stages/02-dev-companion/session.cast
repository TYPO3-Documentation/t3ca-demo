[205.199536, "o", "\u001b[?25l\u001b[H  1. I r\u001b[10Gn \u001b[38;2;177;185;249mddev composer require --dev \"typo3/dev-companion:@dev\"\u001b[39m.\u001b[68GThat\u001b[73Gadded\u001b[79G\u001b[38;2;177;185;249m\"typo3/dev-companion\": \r\u001b[5C\u001b[1B\"@dev\"\u001b[39m to \u001b[38;2;177;185;249mrequire-dev\u001b[39m in \u001b[38;2;177;185;249mcomposer.json\u001b[39m and updated \u001b[38;2;177;185;249mcomposer.lock\u001b[39m. The package has no tagged releases\r\u001b[5C\u001b[1Byet, so \u001b[38;2;177;185;249mdev-main\u001b[39m (commit \u001b[38;2;177;185;249m0be1006\u001b[39m) is the only version you can install.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GI ran \u001b[38;2;177;185;249mddev exec vendor/bin/typo3-dev-companion install --agent=claude\u001b[39m, which did two things:\u001b[K\r\u001b[5C\u001b[1B- \u001b[1mCreated \u001b[38;2;177;185;249m.mcp.json\u001b[22m\u001b[39m, which registers the server. Claude Code starts it with \u001b[38;2;177;185;249msh \u001b[39m\u001b[K\r\u001b[5C\u001b[1B  \u001b[38;2;177;185;249mvendor/bin/typo3-dev-companion-ddev vendor/bin/typo3-dev-companion\u001b[39m, and that wrapper runs the\r\u001b[5C\u001b[1B  server with the PHP inside the DDEV container.\u001b[K\r\u001b[5C\u001b[1B- \u001b[1mAdded 15 TYPO3 skills to \u001b[38;2;177;185;249m.claude/skills/\u001b[22m\u001b[39m, such as sitepackage development, content elements,\r\u001b[5C\u001b[1B  extension upgrade and core patch review. These folders ignore themselves in git, so each person\u001b[104Gwho\r\u001b[5C\u001b[1B  clones the project needs to run the install command too.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mChecked the server:\u001b[22m from the host it accepted the startup request and reported \u001b[38;2;177;185;249mtypo3-dev-companion\r\u001b[5C\u001b[1B\u001b[39mversion 0.3.0.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mWhat you need to do\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRestart Claude Code in this project.\u001b[42G\u001b[22mIt\u001b[45Greads\u001b[51G\u001b[38;2;177;185;249m.mcp.json\u001b[61G\u001b[39monly\u001b[66Gwhen\u001b[71Ga\u001b[73Gsession\u001b[81Gstarts.\u001b[89GApprove\u001b[97Gthe\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249mtypo3-dev-companion\u001b[32G\u001b[39mwhen it ask\u001b[44G, or\u001b[49Gapp\u001b[53Gove \u001b[58Gt\u001b[60Glater in\u001b[69G\u001b[38;2;177;185;249m/mcp\u001b[39m.\u001b[75G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mCheck it works:\u001b[21G\u001b[22mask\u001b[25G\"Which\u001b[32Gicon\u001b[37Gidentifier\u001b[48Gis\u001b[51Gthe\u001b[55Gright\u001b[61Gone\u001b[65Gfor\u001b[69Ga\u001b[71Gdelete\u001b[78Gbutton\u001b[85Gin\u001b[88Gthe\u001b[92GTYPO3\u001b[98Gbackend?\"\r\u001b[4C\u001b[1BIt\u001b[8Gshould\u001b[15Ganswer\u001b[22Gby\u001b[25Gcalling\u001b[33G\u001b[38;2;177;185;249mtypo3_icon_lookup\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe package is experimental (0.x). Its names changed as recently as August 2026, so expect breaking\u001b[K\r\u001b[4C\u001b[1Bchanges.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAfter updating the package with \u001b[38;2;177;185;249mddev composer update\u001b[39m, run \u001b[38;2;177;185;249mddev exec vendor/bin/typo3-dev-companion \r\u001b[4C\u001b[1Bupdate\u001b[12G\u001b[39mand\u001b[16Grestart\u001b[24Gthe\u001b[28Gsession.\u001b[37GThe\u001b[41Gserver\u001b[48Gkeeps\u001b[54Grunning\u001b[62Gthe\u001b[66Gcode\u001b[71Git\u001b[74Gstarted\u001b[82Gwith\u001b[87Guntil\u001b[93Gthen.\r\u001b[1B \u001b[3G- DDEV has to be running for the server to start.\u001b[K\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[205.483299, "o", "\u001b[?25l\u001b[H\u001b[3G  \u001b[6G\u001b[38;2;177;185;249m\"@dev\"\u001b[39m to \u001b[38;2;177;185;249mrequire-dev\u001b[39m in \u001b[38;2;177;185;249mcompos\u001b[38Gr.json\u001b[39m and updated \u001b[38;2;177;185;249mc\u001b[59Gmpos\u001b[64Gr.lock\u001b[39m. The package has no tagged releases\r\u001b[5C\u001b[1Byet, so \u001b[38;2;177;185;249mdev-ma\u001b[21Gn\u001b[39m (comm\u001b[29Gt\u001b[31G\u001b[38;2;177;185;249m0be1006\u001b[39m) is the only version you can install.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GI ran \u001b[38;2;177;185;249mddev exec vendor/bin/typo3-dev-companion install --agent=claude\u001b[39m,\u001b[77Gwhich\u001b[83Gdid\u001b[87Gtwo\u001b[91Gthings:\r\u001b[2C\u001b[1B  \u001b[6G-\u001b[8G\u001b[1mCreated \u001b[38;2;177;185;249m.mcp.json\u001b[22m\u001b[39m, which registers the server. Claude Code starts it\u001b[78Gith \u001b[38;2;177;185;249msh \u001b[39m\u001b[K\r\u001b[5C\u001b[1B \u001b[8G\u001b[38;2;177;185;249mvendor/bin/typo3-dev-companion-ddev vendor/bin/typo3-dev-companion\u001b[39m, and that wrapper\u001b[93Gruns\u001b[98Gthe\r\u001b[7C\u001b[1Bserver with the PHP inside the DDEV container.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mAdded 15 TYPO3 skills to \u001b[38;2;177;185;249m.claude/skills/\u001b[22m\u001b[39m, such\u001b[55Gas\u001b[58Gsitepackage\u001b[70Gdevelopment,\u001b[83Gcontent\u001b[91Gelements,\r\u001b[5C\u001b[1B \u001b[8Gextension upgrade and core patch review. These\u001b[55Gfolders ignor\u001b[70Gthemselv\u001b[79Gs in gi\u001b[87G, so each person\u001b[104Gwho\r\u001b[7C\u001b[1Bclone\u001b[14G the \u001b[20Groject \u001b[28Geeds to run th\u001b[43G \u001b[45Gnstall comman\u001b[59G too.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mChecked the server:\u001b[22m from the host\u001b[40Git accepted\u001b[52Gthe star\u001b[61Gup request\u001b[72Gand\u001b[76Greported\u001b[85G\u001b[38;2;177;185;249mtypo3-dev-companion\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gversion 0.3.0.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you need to do\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mRestart Claude\u001b[20GC\u001b[22Gde in this project.\u001b[42G\u001b[22mIt\u001b[45Greads\u001b[51G\u001b[38;2;177;185;249m.mcp.json\u001b[61G\u001b[39monly\u001b[66Gwhen\u001b[71Ga\u001b[73Gsession\u001b[81Gstarts.\u001b[89GApprove\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mtypo3-dev-companion\u001b[39m server when it asks, or approve it later\u001b[66Gin \u001b[38;2;177;185;249m/mcp\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCheck it works:\u001b[22m ask\u001b[25G\"Which\u001b[32Gico\u001b[38Gdentifier is the right on\u001b[64G for\u001b[69Ga delete\u001b[78Gbutton\u001b[85Gin\u001b[88Gthe\u001b[92GTYPO3\u001b[98Gbackend?\"\r\u001b[2C\u001b[1B \u001b[5GIt should answer by\u001b[25Gcalling \u001b[38;2;177;185;249mtypo3_icon_lookup\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\r\u001b[2C\u001b[1B\u001b[22m- The package is\u001b[20Gexperimental\u001b[33G(0.x).\u001b[40GIts\u001b[44Gnames\u001b[50Gchanged\u001b[58Gas\u001b[61Grecently\u001b[70Gas\u001b[73GAugust\u001b[80G2026,\u001b[86Gso\u001b[89Gexpect\u001b[96Gbreaking\r\u001b[2C\u001b[1B \u001b[5Gc\u001b[7Ganges.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAfter updating\u001b[20Gthe\u001b[24Gpackage\u001b[32Gwith\u001b[37G\u001b[38;2;177;185;249mddev composer update\u001b[39m,\u001b[59Grun\u001b[63G\u001b[38;2;177;185;249mddev exec vendor/bin/typo3-dev-companion \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mupdate\u001b[39m and restart\u001b[24Gthe session.\u001b[37GThe server keeps running the code it started with until then.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GDDEV has to be running\u001b[28Gfor the server to start.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gcommitted\u001b[23Ganything.\u001b[33GThe\u001b[37Gpending\u001b[45Gchanges\u001b[53Gare\u001b[57G\u001b[38;