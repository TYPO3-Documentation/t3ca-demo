[266.113835, "o", "\u001b[?25l\u001b[H\r\u001b[9B \u001b[3G\u001b[38;2;153;153;153mCalled typo3-dev-companion \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mUse\u001b[7G\u001b[38;2;177;185;249m\u001b[1mactions-delete\u001b[22G\u001b[22m\u001b[39m(the\u001b[27Gtrash\u001b[33Gcan\u001b[37Gicon).\u001b[44GI\u001b[46Glooked\u001b[53Git\u001b[56Gup\u001b[59Gin\u001b[62Gthis\u001b[67Ginstallation's\u001b[82Gbackend\u001b[90Gicon\u001b[95Gregistry\u001b[104Gand\r\u001b[2C\u001b[1Bit\u001b[6Gis\u001b[9Gregistered\u001b[20Gthere.\r\u001b[2C\u001b[2B\u001b[90m<\u001b[94mcore:icon\u001b[90m \u001b[36midentifier\u001b[90m=\u001b[31m\"actions-delete\"\u001b[90m \u001b[36msize\u001b[90m=\u001b[31m\"small\"\u001b[90m />\r\u001b[2C\u001b[2B\u001b[39mOr\u001b[6Gin\u001b[9GPHP:\u001b[14G\u001b[38;2;177;185;249m$iconFactory->getIcon('actions-delete', IconSize::SMALL)\u001b[39m.\r\u001b[2C\u001b[2BIdentifiers\u001b[15Gto\u001b[18Gavoid:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mactions-edit-delete\u001b[39m and \u001b[38;2;177;185;249mactions-selection-delete\u001b[54G\u001b[22m\u001b[39mare\u001b[58Gonly\u001b[63Golder\u001b[69Galiases\u001b[77Gthat\u001b[82Gpoint\u001b[88Gto\u001b[91G\u001b[38;2;177;185;249mactions-delete\u001b[39m.\r\u001b[4C\u001b[1BUse\u001b[9Gthe\u001b[13Gmain\u001b[18Gname.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mactions-delete-restore\u001b[28G\u001b[22m\u001b[39mis\u001b[31Gfor\u001b[35Gundoing\u001b[43Ga\u001b[45Gdelete,\u001b[53Gnot\u001b[57Gfor\u001b[61Gdeleting.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mactions-close\u001b[39m and \u001b[38;2;177;185;249mactions-minus\u001b[37G\u001b[22m\u001b[39malso\u001b[42Gcame\u001b[47Gup\u001b[50Gin\u001b[53Gthe\u001b[57Gsearch.\u001b[65GThey\u001b[70Gmean\u001b[75G\"close\"\u001b[83Gand\u001b[87G\"remove\u001b[95Gfrom\u001b[100Glist\",\r\u001b[4C\u001b[1Bnot\u001b[9G\"delete\u001b[17Gthe\u001b[21Grecord\".\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GChurned for \u001b[20Gdone 8:18 AM\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
