[272.949399, "o", "\u001b]0;◐ TYPO3 backend delete button icon\u0007"]
[272.952417, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhich icon identifier is the right one for a delete button in the\u001b[39m                                       \r\u001b[1B  \u001b[38;2;255;255;255m       TYPO3 backend?\u001b[39m                                                                                   \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[39m Use \u001b[38;2;177;185;249m\u001b[1mactions-delete\u001b[22m\u001b[39m (the trash can icon). I looked it up in this installation's backend icon registry and\r\u001b[1B  it is registered there.\u001b[K\r\u001b[2C\u001b[2B\u001b[90m<\u001b[94mcore:icon\u001b[90m \u001b[36midentifier\u001b[90m=\u001b[31m\"actions-delete\"\u001b[90m \u001b[36msize\u001b[90m=\u001b[31m\"small\"\u001b[90m />\r\u001b[2B\u001b[39m \u001b[3GOr in PHP: \u001b[38;2;177;185;249m$iconFactory->getIcon('actions-delete', IconSize::SMALL)\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIdentifiers\u001b[15Gto\u001b[18Gavoid:\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mactions-edit-delete\u001b[39m and \u001b[38;2;177;185;249mactions-selection-delete\u001b[22m\u001b[39m are\u001b[58Gonly\u001b[63Golder\u001b[69Galiases\u001b[77Gthat\u001b[82Gpoint\u001b[88Gto\u001b[91G\u001b[38;2;177;185;249mactions-delete\u001b[39m.\r\u001b[4C\u001b[1BUse\u001b[9Gthe\u001b[13Gmain\u001b[18Gname.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mactions-delete-restore\u001b[22m\u001b[39m is for undoing a delete, not for deleting.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mactions-close\u001b[39m and \u001b[38;2;177;185;249mactions-minus\u001b[37G\u001b[22m\u001b[39malso\u001b[42Gcame\u001b[47Gup\u001b[50Gin\u001b[53Gthe\u001b[57Gsearch.\u001b[65GThey\u001b[70Gmean\u001b[75G\"close\"\u001b[83Gand\u001b[87G\"remove\u001b[95Gfrom\u001b[100Glist\",\r\u001b[2C\u001b[1B  no\u001b[8G \"d\u001b[12Glete the record\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 6s · done 8:18 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhich tools did you call?\u001b[39m                                                                               \r\u001b[4C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[3GComputing… \r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Tip:\u001b[11GUse\u001b[15G/voice for push-to-talk dictation\r\u001b[3B❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
