ompanion\u001b[25G\u001b[39mserver\u001b[32Gwhe\u001b[38Gt asks, or approve it lat\u001b[64Gr in\u001b[69G\u001b[38;2;177;185;249m/mcp\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCheck it works:\u001b[22m ask\u001b[25G\"Which icon identifier is the\u001b[55Gright\u001b[61Gone\u001b[65Gfor\u001b[69Ga\u001b[71Gdelete\u001b[78Gbutton\u001b[85Gin\u001b[88Gthe\u001b[92GTYPO3\u001b[98Gbackend?\"\r\u001b[4C\u001b[1BIt\u001b[8Gshould\u001b[15Ganswer\u001b[22Gby\u001b[25Gcalling\u001b[33G\u001b[38;2;177;185;249mtypo3_icon_lookup\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[7Ge package\u001b[17Gis\u001b[20Gexperimental\u001b[33G(0.x).\u001b[40GIts\u001b[44Gnames\u001b[50Gchanged\u001b[58Gas\u001b[61Grecently\u001b[70Gas\u001b[73GAugust\u001b[80G2026,\u001b[86Gso\u001b[89Gexpect\u001b[96Gbreaking\r\u001b[2C\u001b[1B \u001b[5Gchanges.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAfter updating the\u001b[24Gpackage with\u001b[37G\u001b[38;2;177;185;249mddev composer update\u001b[39m, run \u001b[38;2;177;185;249mddev exec vendor/bin/typo3-dev-companion \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249mupdate\u001b[39m and restart the\u001b[28Gsession. The server keeps\u001b[54Grunning\u001b[62Gthe\u001b[66Gcode\u001b[71Git\u001b[74Gstarted\u001b[82Gwith\u001b[87Guntil\u001b[93Gthen.\r\u001b[2C\u001b[1B-\u001b[5GDDEV\u001b[10Ghas\u001b[14Gto\u001b[17Gbe\u001b[20Grunning\u001b[28Gfor\u001b[32Gthe\u001b[36Gserver\u001b[43Gto\u001b[46Gstart.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI haven't committed anything. The pending\u001b[45Gchanges are\u001b[57G\u001b[38;2;177;185;249mcomposer.json\u001b[39m,\u001b[72G\u001b[38;2;177;185;249mcomposer.lock\u001b[86G\u001b[39mand\u001b[90Gthe\u001b[94Gnew\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m.mcp.json\u001b[39m;\u001b[14Gsay\u001b[18Gif\u001b[21Gyou\u001b[25Gwant\u001b[30Gthem\u001b[35Gcommitted\u001b[45Gas\u001b[48Ga\u001b