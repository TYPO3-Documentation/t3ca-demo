[157.422178, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(typo3-content-element-development)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoaded\u001b[13Gskill\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm building\u001b[16Gthe\u001b[20Gland\u001b[25Grates\u001b[31Gcalculator\u001b[42Gfrom\u001b[47G\u001b[38;2;177;185;249mdesign/land-rates.html\u001b[70G\u001b[39mas\u001b[73Ga\u001b[75Gcontent\u001b[83Gelement\u001b[91Gin\u001b[94Gthe\u001b[98Gsitepackage.\u001b[111GFirst\u001b[117GI'm\r\u001b[2C\u001b[1Breading\u001b[11Gthe\u001b[15Gproject\u001b[23Gand\u001b[27Gthe\u001b[31Gextension.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, called typo3-dev-companion \u001b[1m3\u001b[22m times, ran \u001b[1m6\u001b[22m shell commands \r\u001b[1B  ⎿  1 action not run · auto mode's check had no usable answer\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m I've read the design, the existing Slider and Service tiles elements\u001b[72Gand\u001b[76Gthe\u001b[80Gseed\u001b[85Gscripts.\u001b[94GNext\u001b[99GI'm\u001b[103Gchecking\u001b[112Gthe\u001b[116GTYPO3\r\u001b[2C\u001b[1B14\u001b[6Gconventions,\u001b[19Gthen\u001b[24GI'll\u001b[29Gwrite\u001b[35Gthe\u001b[39Gelement.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion \u001b[1m6\u001b[22m times, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLand uses become child records of the element, and the rates\u001b[64Gand\u001b[68Ginterest\u001b[77Gstay\u001b[82Gas\u001b[85Gfields\u001b[92Gon\u001b[95Git,\u001b[99Gsince\u001b[105Gtranslations\r\u001b[2C\u001b[1Bcan't\u001b[9Gchange\u001b[16Gthem.\u001b[22GI'm\u001b[26Gwriting\u001b[34Gthe\u001b[38Gfiles\u001b[44Gnow.\u001b[38;2;153;15