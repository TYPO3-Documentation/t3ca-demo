[470.927442, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAn existing \"Edit\u001b[23Grs\"\u001b[27Ggroup won't ge\u001b[42G the new table. O\u001b[60Gly\u001b[63Ggroups\u001b[70Gcreated\u001b[78Gby\u001b[81Ga\u001b[83Gnew\u001b[87Gsetup\u001b[93Gdo,\u001b[97Gso\u001b[100Gon\u001b[103Gan\u001b[106Ginstallation\r\u001b[2C\u001b[1B \u001b[5Gt\u001b[7Gat alre\u001b[15Gdy has\u001b[22Gone, add the \u001b[36Gable to the group by hand.\u001b[K\r\u001b[4C\u001b[1BThe d\u001b[11Ge\u001b[13Gd\u001b[15Gte, 31 March, i\u001b[31G written into the label texts, not stored as\u001b[76Ga\u001b[78Gfield.\r\u001b[4C\u001b[1BWithout\u001b[13GJavaScript\u001b[24Gthe resul\u001b[34Gs stay emp\u001b[45Gy, the same as \u001b[62G the design.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI rou\u001b[11Gd the\u001b[17Gannual rate\u001b[29Gand the intere\u001b[44Gt to whole shillings separately, so the\u001b[84Glines add\u001b[94Gup\u001b[97Gto\u001b[100Gthe\u001b[104Gtotal\u001b[110Gshown.\u001b[117GThe\r\u001b[2C\u001b[1B \u001b[5Gdesign\u001b[12Gonly\u001b[17Grounded for display, so its lines could\u001b[57Gdiffer\u001b[64Gfrom\u001b[69Gthe\u001b[73Gtotal\u001b[79Gby\u001b[82Ga\u001b[84Gshilling.\r\u001b[4C\u001b[1BPleas\u001b[12Ghave a native speaker ch\u001b[37Gck the Kiswahili.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GBefore\u001b[12Gseeding\u001b[20GI\u001b[22Gtook\u001b[27Ga\u001b[29Gdatabase\u001b[38Gsnapshot:\u001b[48G\u001b[38;2;177;185;249mddev snapshot restore before-land-rates-calculator\u001b[99G\u001b[39mputs\u001b[104Git\u001b[107Gback.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFil\u001b[7Gs\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew:\u001b[22m the land use table, \u001b[38;2;177;185;249mtt_content_landrates.php\u001b[39m, the TypoScript, the\u001b[77Gempla\u001b[84G, the preview,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mland-rates-calculator.js\u001b[39m, the icon and \u001b[38;2;177;185;249mConfigu\u001b[52Gation/Icons.php\u001b[39m,\u001b[69Gall\u001b[73Gin\u001b[76Gthe\u001b[80Gsitepackage.\u001b[93GAlso\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mBuild/Initialisation/seed-land-rates-calculator.ph\u001b[56G\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[22m the label files\u001b[30G(English\u001b[39Gand\u001b[43GKiswahili),\u001b[55G\u001b[38;2;177;185;249mpage.tsconfig\u001b[39m,\u001b[70Gthe\u001b[74Geditor\u001b[81Ggroup\u001b[87Gsetup,\u001b[94G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[104Gand\u001b[108Gthe\r\u001b[4C\u001b[1Bsitepackage\u001b[17GREADME.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you w\u001b[12Gn\u001b[14G a\u001b[17Gcommit, your\u001b[30Ghi\u001b[34Gory uses\u001b[43Gstage\u001b[49Gnames,\u001b[56Gso\u001b[59Git\u001b[62Gwould\u001b[68Gbe\u001b[71G\u001b[38;2;177;185;249mStage 15-land-rates-calculator\u001b[39m.\u001b[103GThe\u001b[107GTYPO3\u001b[113Gcommit\r\u001b[2C\u001b[1Bguide drafted this message instead:\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m[FEATURE] Add the land rates calculator content element\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mEditors maintain the rates in the element,\u001b[47Gs l\u001b[51Gnd use records with a\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mshare of\u001b[12Gth\u001b[15G rateable value\u001b[31Gplus a minimum and a monthly interest, so a\r\u001b[3C\u001b[1Bew rate needs no change\u001b[29Go the script. Translations tr\u001b[59Gnslate only the\r\u001b[2C\u001b[1Bnames and calculate with the rates of the default language.\r\u001b[1B\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
