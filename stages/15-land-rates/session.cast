[501.761708, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G\u001b[38;2;177;185;249mland-rates-calculator.js\u001b[39m, the icon and \u001b[38;2;177;185;249mConfiguration/Icons.php\u001b[39m, all in\u001b[77Ghe si\u001b[84Gpackage. Also\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mBuild/Initialisation/seed-land-rates-calculato\u001b[52G.php\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[22m the label files (English and Kiswahili), \u001b[56G\u001b[38;2;177;185;249mage.tsconfig\u001b[39m,\u001b[70Gthe\u001b[74Geditor\u001b[81Ggroup\u001b[87Gsetup,\u001b[94G\u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[104Gand\u001b[108Gthe\r\u001b[2C\u001b[1B \u001b[5Gsitepackage README.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gwant\u001b[15Ga\u001b[17Gcommit,\u001b[25Gyour\u001b[30Ghistory\u001b[38Guses\u001b[43Gstage\u001b[49Gnames,\u001b[56Gso\u001b[59Git\u001b[62Gwould\u001b[68Gbe\u001b[71G\u001b[38;2;177;185;249mStage 15-land-rates-calculator\u001b[39m.\u001b[103GThe\u001b[107GTYPO3\u001b[113Gcommit\r\u001b[2C\u001b[1Bguide dr\u001b[12Gf\u001b[14Ged\u001b[17Gthis message\u001b[30Gin\u001b[34Gead:\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m[FEATURE] Add the land rates calculator content element\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mEditors maintain the rates in the element, as land use records with a\r\u001b[2C\u001b[1Bshare of the rateable value plus a minimum\u001b[47Gnd \u001b[51G monthly interest, so a\r\u001b[2C\u001b[1Bnew rate\u001b[12Gne\u001b[15Gds no change to\u001b[31Gthe script. Translations translate only the\r\u001b[3C\u001b[1Bames and calculate with\u001b[29Ghe rates of the default langu\u001b[59Gge.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 6m 11s · done 3:48 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m The rates change every year. Who changes them, and how?\u001b[39m                                                               \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAn\u001b[6Geditor\u001b[13Gchanges\u001b[21Gthem\u001b[26Gin\u001b[29Gthe\u001b[33Gbackend\u001b[41Gby\u001b[44Gediting\u001b[52Gthe\u001b[56Gcalculator\u001b[67Gon\u001b[70Gthe\u001b[74G\"Land\u001b[80Grates\"\u001b[87Gpage.\u001b[93GNo\u001b[96Gdeveloper\u001b[106Gis\u001b[109Gneeded\u001b[116Gfor\r\u001b[1B \u001b[3Gthe ra\u001b[10Ges\u001b[13Gt\u001b[15Gems\u001b[19Glves, but\u001b[29Ga few other\u001b[41Gplaces o\u001b[50G the site a\u001b[62Gso state them \u001b[80Gh\u001b[82Gv\u001b[84G to be updated a\u001b[102Gngside.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWho\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BAnyone\u001b[10Gin\u001b[13Gthe\u001b[17G\"Editors\"\u001b[27Ggroup,\u001b[34Gor\u001b[37Gan\u001b[40Gadministrator.\u001b[55GOne\u001b[59Gcatch:\u001b[66Gonly\u001b[71Ga\u001b[73Ggroup\u001b[79Gcreated\u001b[87Gby\u001b[90Ga\u001b[92Gnew\u001b[96Gsetup\u001b[102Gcan\u001b[106Gedit\u001b[111Gland\u001b[116Guses.\r\u001b[2C\u001b[1BO\u001b[5G a\u001b[8G installation whose \"Editors\" group already exist\u001b[58Gd, an administrat\u001b[76Gr must first add \"Land \u001b[100Gse\" to the\u001b[111Ggroup'\u001b[118G\u001b[K\r\u001b[2C\u001b[1Btables (System > Backend\u001b[28Gusers > the group > Access lists). Otherw\u001b[71Ge editors can open the c\u001b[96Glculator bu\u001b[108G can't change\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[501.880907, "o", "\u001b[?25l\u001b[H\u001b[3GIf you want a commit, your history uses stage names, so it would be \u001b[38;2;177;185;249mStage 15-land-rates-calculator\u001b[39m.\u001b[103GThe\u001b[107GTYPO3\u001b[113Gcommit\r\u001b[2C\u001b[1Bguide drafted this message instead:\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m[FEATURE] Add the land rates calculator content element\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mEditors maintain the rates in the element, as land use records with a\r\u001b[2C\u001b[1Bshare of the rateable value plus a minimum and a monthly interest, so \u001b[74G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mnew rate needs no change to the script. Translations translate only the\r\u001b[2C\u001b[1Bnames and\u001b[13Gcalculate with \u001b[29Ghe\u001b[32Gr\u001b[34Gtes of the default language.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 6m 11s · done 3:48 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m The rates change every year. Who changes them, and how?\u001b[39m                                                               \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAn\u001b[6Geditor\u001b[13Gchanges\u001b[21Gthem\u001b[26Gin\u001b[29Gthe\u001b[33Gbackend\u001b[41Gby\u001b[44Gediting\u001b[52Gthe\u001b[56Gcalculator\u001b[67Gon\u001b[70Gthe\u001b[74G\"Land\u001b[80Grates\"\u001b[87Gpage.\u001b[93GNo\u001b[96Gdeveloper\u001b[106Gis\u001b[109Gneeded\u001b[116Gfor\r\u001b[1B \u001b[3Gthe rates themselves, but a few\u001b[35Gother\u001b[41Gplaces\u001b[48Gon\u001b[51Gthe\u001b[55Gsite\u001b[60Galso\u001b[65Gstate\u001b[71Gthem\u001b[76Gand\u001b[80Ghave\u001b[85Gto\u001b[88Gbe\u001b[91Gupdated\u001b[99Galongside.\r\u001b[2B  \u001b[1mWho\u001b[22m\u001b[K\r\u001b[2B \u001b[5Gyone in\u001b[13Gt\u001b[15Ge \"Edi\u001b[22Gors\" group, or a\u001b[39G adminis\u001b[48Grator. One \u001b[60Gatch: only a group c\u001b[81Geated\u001b[87Gby a new\u001b[96Gs\u001b[98Gtup can\u001b[106Gedit lan\u001b[116Guses.\r\u001b[2C\u001b[1BOn an in\u001b[12Gtallation whose \"Editors\" g\u001b[40Goup already exi\u001b[56Gted, an adminis\u001b[72Grator must first add \"Lan\u001b[99Guse\" to the\u001b[111Ggroup's\r\u001b[2C\u001b[1Btables\u001b[10G(System\u001b[18G>\u001b[20GBackend\u001b[28Gusers\u001b[34G>\u001b[36Gthe\u001b[40Ggroup\u001b[46G>\u001b[48GAccess\u001b[55Glists).\u001b[63GOtherwise\u001b[73Geditors\u001b[81Gcan\u001b[85Gopen\u001b[90Gthe\u001b[94Gcalculator\u001b[105Gbut\u001b[109Gcan't\u001b[115Gchange\r\u001b[2C\u001b[1Bthe\u001b[7Gland\u001b[12Guses.\r\u001b[2C\u001b[2B\u001b[1mHow\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[502.031762, "o", "\u001b[?25l\u001b[H\u001b[3Gguide dr\u001b[12Gf\u001b[14Ged\u001b[17Gthis message\u001b[30Gin\u001b[34Gead:\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m[FEATURE] Add the land rates calculator content element\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mEditors maintain the rates in the element, as land use records with a\r\u001b[2C\u001b[1Bshare of the rateable value plus a minimum\u001b[47Gnd \u001b[51G monthly interest, so a\r\u001b[2C\u001b[1Bnew rate\u001b[12Gne\u001b[15Gds no change to\u001b[31Gthe script. Translations translate only the\r\u001b[3C\u001b[1Bames and calculate with\u001b[29Ghe rates of the default langu\u001b[59Gge.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 6m 11s · done 3:48 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m The rates change every year. Who changes them, and how?\u001b[39m                                                               \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAn\u001b[6Geditor\u001b[13Gchanges\u001b[21Gthem\u001b[26Gin\u001b[29Gthe\u001b[33Gbackend\u001b[41Gby\u001b[44Gediting\u001b[52Gthe\u001b[56Gcalculator\u001b[67Gon\u001b[70Gthe\u001b[74G\"Land\u001b[80Grates\"\u001b[87Gpage.\u001b[93GNo\u001b[96Gdeveloper\u001b[106Gis\u001b[109Gneeded\u001b[116Gfor\r\u001b[1B \u001b[3Gthe ra\u001b[10Ges\u001b[13Gt\u001b[15Gems\u001b[19Glves, but\u001b[29Ga few other\u001b[41Gplaces o\u001b[50G the site a\u001b[62Gso state them \u001b[80Gh\u001b[82Gv\u001b[84G to be updated a\u001b[102Gngside.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWho\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BAnyone\u001b[10Gin\u001b[13Gthe\u001b[17G\"Editors\"\u001b[27Ggroup,\u001b[34Gor\u001b[37Gan\u001b[40Gadministrator.\u001b[55GOne\u001b[59Gcatch:\u001b[66Gonly\u001b[71Ga\u001b[73Ggroup\u001b