[515.057837, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAn\u001b[6Geditor\u001b[13Gchanges\u001b[21Gthem\u001b[26Gin\u001b[29Gthe\u001b[33Gbackend\u001b[41Gby\u001b[44Gediting\u001b[52Gthe\u001b[56Gcalculator\u001b[67Gon\u001b[70Gthe\u001b[74G\"Land\u001b[80Grates\"\u001b[87Gpage.\u001b[93GNo\u001b[96Gdeveloper\u001b[106Gis\u001b[109Gneeded\u001b[116Gfor\r\u001b[1B \u001b[3Gthe ra\u001b[10Ges\u001b[13Gt\u001b[15Gems\u001b[19Glves, but\u001b[29Ga few other\u001b[41Gplaces o\u001b[50G the site a\u001b[62Gso state them \u001b[80Gh\u001b[82Gv\u001b[84G to be updated a\u001b[102Gngside.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWho\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BAnyone\u001b[10Gin\u001b[13Gthe\u001b[17G\"Editors\"\u001b[27Ggroup,\u001b[34Gor\u001b[37Gan\u001b[40Gadministrator.\u001b[55GOne\u001b[59Gcatch:\u001b[66Gonly\u001b[71Ga\u001b[73Ggroup\u001b[79Gcreated\u001b[87Gby\u001b[90Ga\u001b[92Gnew\u001b[96Gsetup\u001b[102Gcan\u001b[106Gedit\u001b[111Gland\u001b[116Guses.\r\u001b[2C\u001b[1BO\u001b[5G a\u001b[8G installation whose \"Editors\" group already exist\u001b[58Gd, an administrat\u001b[76Gr must first add \"Land \u001b[100Gse\" to the\u001b[111Ggroup'\u001b[118G\u001b[K\r\u001b[2C\u001b[1Btables (System > Backend\u001b[28Gusers > the group > Access lists). Otherw\u001b[71Ge editors can open the c\u001b[96Glculator bu\u001b[108G can't change\r\u001b[3C\u001b[1Bhe land u\u001b[14Ges.\u001b[18G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6GOpen\u001b[11Gthe\u001b[15GPage\u001b[20Gmodule\u001b[27Gand\u001b[31Gthe\u001b[35G\"Land\u001b[41Grates\"\u001b[48Gpage.\r\u001b[2C\u001b[1B2\u001b[6GEdit\u001b[15G\"Land rates\u001b[27Gcalculator\" element:\u001b[48G\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- Under \"Land uses\",\u001b[28Ghange each\u001b[39G\"Rat\u001b[44G (%\u001b[48Gof\u001b[51Gthe\u001b[55Grateable\u001b[64Gvalue\u001b[70Gper\u001b[74Gyear)\".\u001b[82GThis\u001b[87Gis\u001b[90Galso\u001b[95Gwhere\u001b[101Ga\u001b[103Gland\u001b[108Guse\u001b[112Gis\u001b[115Gadded,\r\u001b[5C\u001b[1B \u001b[8Gremoved or reordered.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GChang\u001b[14G \"Minimum rate (KES\u001b[34Gper\u001b[38Gplot\u001b[43Gand\u001b[47Gyear)\"\u001b[54Gand\u001b[58G\"Interest\u001b[68Gwhen\u001b[73Gpaid\u001b[78Glate\u001b[83G(%\u001b[86Gper\u001b[90Gmonth)\"\u001b[98Gif\u001b[101Gthey\u001b[106Gchange\u001b[113Gtoo.\r\u001b[2C\u001b[1B3.\u001b[6GSave. Saving the elem\u001b[28Gnt clears\u001b[38Gtha\u001b[43Gpage's cache, so th\u001b[63G new\u001b[68Grates show on the\u001b[86Gn\u001b[88Gxt visit.\u001b[98G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Geditor\u001b[14Gonly\u001b[19Gchanges\u001b[27Gthe\u001b[31GEnglish\u001b[39Gelement.\u001b[48GThe\u001b[52GKiswahili\u001b[62Gpage\u001b[67Gcalculates\u001b[78Gwith\u001b[83Gthe\u001b[87GEnglish\u001b[95Grates,\u001b[102Gso\u001b[105Gthere\u001b[111Gis\u001b[114Gnothing\r\u001b[2C\u001b[1Bto change there, unles\u001b[27Ga land use is added\u001b[50Gat one needs \u001b[64G Kiswahi\u001b[73Gi name on\u001b[87Gtranslation, otherwise it appears\u001b[K\r\u001b[2C\u001b[1Bin\u001b[6GEnglish on the Kiswahili page. I haven't actually tested\u001b[65Grate change followed by \u001b[90G look at the Kiswahili\u001b[113Gpag\u001b[117G; I\r\u001b[2C\u001b[1Bcan run t\u001b[13Gat test.\u001b[K\r\u001b[2C\u001b[1B   \u001b[7G   \u001b[11G    \u001b[16G     \u001b[31;1H\u001b[29;3H\u001b[?25h"]
