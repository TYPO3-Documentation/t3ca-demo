[388.08294, "o", "\u001b[?25l\u001b[H\u001b[5G(12,500 / 30,900\u001b[22G/\u001b[24G1,500,\u001b[31Gthe\u001b[35Glast\u001b[40Gone\u001b[44Gbeing\u001b[50Gthe\u001b[54Gminimum\u001b[62Grate).\u001b[69GBoth\u001b[74Gwarnings\u001b[83Gappear\u001b[90Gwhen\u001b[95Gthey\u001b[100Gshould,\u001b[108Gmonths\u001b[115Gover\u001b[120G36\r\u001b[2C\u001b[1B \u001b[5Gcount as 36, and ther\u001b[28Gare no script errors. The layout matches the design on desktop and at phone width. Amounts\r\u001b[4C\u001b[1Bshow as\u001b[13G\"KES\" in\u001b[22GEnglish and as \"Ksh\" on the\u001b[50GKiswahili page.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent export:\u001b[22m the page and its records are\u001b[50Gin \u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m, and th\u001b[85G diff\u001b[91Go\u001b[93Gly adds them.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I couldn't check\u001b[25G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEditor side:\u001b[18G\u001b[22mI\u001b[20Gwasn't\u001b[27Gallowed\u001b[35Gto\u001b[38Gcreate\u001b[45Ga\u001b[47Gtemporary\u001b[57Gbackend\u001b[65Gadmin,\u001b[72Gso\u001b[75GI\u001b[77Ghaven't\u001b[85Gseen\u001b[90Gthe\u001b[94Gcontent\u001b[102Gwizard\u001b[109Gentry,\u001b[116Gthe\r\u001b[2C\u001b[1B  form or the page module\u001b[29Gpreview.\u001b[38GThe\u001b[42Gicon\u001b[47Gand\u001b[51Gthe\u001b[55Gelement\u001b[63Gare\u001b[67Gregistered,\u001b[79Gbut\u001b[83Gplease\u001b[90Gopen\u001b[95Gone\u001b[99Gin\u001b[102Gthe\u001b[106Gbackend.\r\u001b[4C\u001b[1B\u001b[1mFresh install:\u001b[20G\u001b[22mI didn't test importing \u001b[38;2;177;185;249mdata.xml\u001b[39m into \u001b[59G n\u001b[62Gw installation.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTests:\u001b[22m the package has non\u001b[32G, so non\u001b[42Gwere\u001b[48Gd\u001b[50Ged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAn\u001b[8Gexisting\u001b[17G\"Editors\"\u001b[27Ggroup\u001b[33Gwon't\u001b[39Gget\u001b[43Gthe\u001b[47Gnew\u001b[51Gtable.\u001b[58GOnly\u001b[63Ggroups\u001b[70Gcreated\u001b[78Gby\u001b[81Ga\u001b[83Gnew\u001b[87Gsetup\u001b[93Gdo,\u001b[97Gso\u001b[100Gon\u001b[103Gan\u001b[106Ginstallation\r\u001b[2C\u001b[1B  that already\u001b[18Ghas\u001b[22Gone,\u001b[27Gadd\u001b[31Gthe\u001b[35Gtable\u001b[41Gto\u001b[44Gthe\u001b[48Ggroup\u001b[54Gby\u001b[57Ghand.\r\u001b[4C\u001b[1BThe due date, 31 March, is written into the label texts, not stored \u001b[74Gs a\u001b[78Gfield.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWithout J\u001b[15GvaScript the results stay\u001b[41Gemp\u001b[45Gy,\u001b[48Gthe same\u001b[57Gas in\u001b[63Gthe\u001b[67Gdesign.\r\u001b[4C\u001b[1BI round\u001b[13Gthe annual \u001b[25Gate\u001b[29Gand the i\u001b[39Gterest to\u001b[49Gwhole\u001b[55Gshillings sepa\u001b[70Gately, so the lines\u001b[90Gadd\u001b[94Gup\u001b[97Gto\u001b[100Gthe\u001b[104Gtotal\u001b[110Gshown.\u001b[117GThe\r\u001b[2C\u001b[1B \u001b[5Gdesign only rounded for display, so\u001b[41Gits lines could\u001b[57Gdiffer from the total\u001b[79Gby\u001b[82Ga\u001b[84Gshilling.\r\u001b[4C\u001b[1BPlease hav\u001b[18G \u001b[20Gative spe\u001b[30Gker check th\u001b[43G Kiswahili.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GB\u001b[7Gfore\u001b[12Gseeding I took a\u001b[30Gatab\u001b[35Gse\u001b[39Gnapshot: \u001b[38;2;177;185;249mddev snapshot restore before-land-rates-calculator\u001b[99G\u001b[39mputs\u001b[104Git\u001b[107Gback.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew:\u001b[10G\u001b[22mthe\u001b[14Gland\u001b[19Guse\u001b[23Gtable,\u001b[30G\u001b[38;2;177;185;249mtt_content_landrates.php\u001b[39m,\u001b[56Gthe\u001b[60GTypoScript,\u001b[72Gthe\u001b[76Gtemplate,\u001b[86Gthe\u001b[90Gpreview,\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mland-rates-calculator.js\u001b[39m,\u001b[31Gthe\u001b[35Gicon\u001b[40Gand\u001b[44G\u0