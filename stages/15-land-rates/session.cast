[389.608266, "o", "\u001b[?25l\u001b[H\u001b[5GAn exis\u001b[13Ging \"Editors\" gr\u001b[30Gup won't g\u001b[41Gt th\u001b[47Gnew table.\u001b[58GOnly\u001b[63Ggroups\u001b[70Gcreated\u001b[78Gby\u001b[81Ga\u001b[83Gnew\u001b[87Gsetup\u001b[93Gdo,\u001b[97Gso\u001b[100Gon\u001b[103Gan\u001b[106Ginstallation\r\u001b[4C\u001b[1Bthat\u001b[10Galready\u001b[18Ghas\u001b[22Gone,\u001b[27Gadd\u001b[31Gthe\u001b[35Gtable\u001b[41Gto\u001b[44Gthe\u001b[48Ggroup\u001b[54Gby\u001b[57Ghand.\r\u001b[2C\u001b[1B- The due date,\u001b[19G31\u001b[22GMarch,\u001b[29Gis\u001b[32Gwritten\u001b[40Ginto\u001b[45Gthe\u001b[49Glabel\u001b[55Gtexts,\u001b[62Gnot\u001b[66Gstored\u001b[73Gas\u001b[76Ga\u001b[78Gfield.\r\u001b[4C\u001b[1BWithout JavaScr\u001b[21Gpt the \u001b[29Gesults s\u001b[38Gay empty, the sam\u001b[56G as in\u001b[63Gthe design.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI round the annual rate and the interes\u001b[45G to whole shillings\u001b[65Gseparately,\u001b[77Gso\u001b[80Gthe\u001b[84Glines\u001b[90Gadd\u001b[94Gup\u001b[97Gto\u001b[100Gthe\u001b[104Gtotal\u001b[110Gshown.\u001b[117GThe\r\u001b[2C\u001b[1B \u001b[5Gdesign only rounded for\u001b[29Gdisplay, so i\u001b[43Gs\u001b[45Glines could differ from the\u001b[73Gtot\u001b[77Gl by a shilling.\r\u001b[4C\u001b[1BPlease have a native speaker check the Kiswa\u001b[50Gili.\u001b[K\r\u001b[4C\u001b[1BBef\u001b[9Gre seeding I took a\u001b[29Gdatabase snapshot: \u001b[38;2;177;185;249mddev snapshot restore before-land-rates-calculator\u001b[39m puts\u001b[104Git back.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNew:\u001b[22m the land use table, \u001b[38;2;177;185;249mtt_content_landrates.php\u001b[39m, the TypoScript, the template, the preview,\u001b[99G\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mland-rates-calculator.js\u001b[39m,\u001b[31Gthe\u001b[35Gicon\u001b[40Gand\u001b[44G\u001b[38;2;177;185;249mConfiguration/Icons.php\u001b[39m,\u001b[69Gall\u001b[73Gin\u001b[76Gthe\u001b[80Gsitepackage.\u001b[93GAlso\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mBuild/Initialisation/seed-land-rates-calculator.php\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mChanged:\u001b[14G\u001b[22mthe lab\u001b[22Gl fi\u001b[28Gs\u001b[30G(English and Kiswahili), \u001b[38;2;177;185;249mpage.tsconfig\u001b[39m, the \u001b[75Gditor group s\u001b[89Gtup, \u001b[38;2;177;185;249mdata.xml\u001b[39m,\u001b[104Gand\u001b[108Gthe\r\u001b[4C\u001b[1Bsitepackage README.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you want a commit, your\u001b[30Ghistory uses\u001b[43Gstage names, so it would be \u001b[38;2;177;185;249mStage 15-land-rates-calcul\u001b[98Gtor\u001b[39m. The TYPO3\u001b[113Gcommit\r\u001b[2C\u001b[1Bguide drafted\u001b[17Gthis message\u001b[30Ginstead:\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m[FEATURE] Add the land rates calculator content element\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mEditors maintain the rates in the element, as land use records with a\r\u001b[2C\u001b[1Bshare of the rat\u001b[20Gable valu\u001b[30G plus a minimum and a monthly interest, so a\r\u001b[2C\u001b[1Bnew rate needs no change to the script. Translations translate only the\r\u001b[2C\u001b[1Bnames and calcula\u001b[21Ge with the rat\u001b[36Gs of the default language.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m·\u001b[3GComposing… \u001b[38;2;153;153;153m(6m 11s · ↓\u001b[39m \u001b[38;2;153;153;153m37.4k tokens)\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
