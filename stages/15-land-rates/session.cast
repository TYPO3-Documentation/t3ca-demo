2m \u001b[12G  line per land use, then the minimum rate and the interest. The header is rendered\u001b[K\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m    by the page module above this.\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22m/f:co\u001b[17Gment>\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m<ul>\u001b[K\r\u001b[7C\u001b[1B\u001b[2m8\u001b[14G\u001b[22m<f:for \u001b[38;2;166;226;46meach\u001b[39m=\u001b[38;2;230;219;116m\"{record.tx_mtosafisitepackage_landuses}\"\u001b[39m \u001b[38;2;166;226;46mas\u001b[39m=\u001b[38;2;230;219;116m\"landUse\"\u001b[39m>\u001b[K\r\u001b[7C\u001b[1B\u001b[2m9\u001b[14G\u001b[22m  \u001b[17G <li><strong>{landUs\u001b[38G.label}</strong>:\u001b[56G{landUse.percent}\u001b[74G%</li>\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m    </f:for\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +6 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1xuto3n;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Language/content_elements.xlf\u0007Resources/Private/Language/content_elements.xlf\u001b]8;;\u0007)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\u001b[31;1H\u001b[29;3H\u001b[?25h"]
