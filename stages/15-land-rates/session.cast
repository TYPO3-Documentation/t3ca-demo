[606.271889, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mShow me the calculator in my browser.\u001b[39m                                                                                  \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[39m I tried to open the \"Land rates\" page in your default browser with \u001b[38;2;177;185;249mddev launch\u001b[39m, but I can't tell whether a tab opened.\u001b[K\r\u001b[2C\u001b[1BChrome\u001b[10Gprinted\u001b[18Gtwo\u001b[22G\"Broken\u001b[30Gpipe\"\u001b[36Gerrors\u001b[43Gwhile\u001b[49Gstarting,\u001b[59Gwhich\u001b[65Gcan\u001b[69Gbe\u001b[72Gharmless\u001b[81Gbut\u001b[85Gcan\u001b[89Galso\u001b[94Gmean\u001b[99Git\u001b[102Gfailed\u001b[109Gto\u001b[112Gstart.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gno\u001b[9Gtab\u001b[13Gopened,\u001b[21Ghere\u001b[26Gare\u001b[30Gthe\u001b[34Glinks:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- English: \u001b]8;id=trtsjf;https://demo.ddev.site/revenue-payments/land-rates\u0007\u001b[94mhttps://demo.ddev.site/revenue-payments/land-rates\u001b[65G\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GKiswahili:\u001b[16G\u001b]8;id=26uxz1;https://demo.ddev.site/sw/mapato-malipo/kodi-ya-ardhi\u0007\u001b[94mhttps://demo.ddev.site/sw/mapato-malipo/kodi-ya-ardhi\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcalculator\u001b[18Gis\u001b[21Gbelow\u001b[27Gthe\u001b[31G\"Rates\u001b[38Gfor\u001b[42G2026\"\u001b[48Gtable.\u001b[55GIt\u001b[58Gopens\u001b[64Gwith\u001b[69GResidential\u001b[81Gand\u001b[85GKES\u001b[89G2,500,000,\u001b[100Gwhich\u001b[106Ggives\u001b[112GKES\r\u001b[2C\u001b[1B12,500. To\u001b[14Gcheck the second example from the rates document, choose\u001b[71GCommercial\u001b[82Gand\u001b[86Genter\u001b[92G3\u001b[94Gmonths\u001b[101Glate:\u001b[107Gthe\u001b[111Gtotal\r\u001b[2C\u001b[1Bshould be KES 30,900, with the interest warning below it.\u001b[K\r\u001b[2C\u001b[2BIf you open the backend\u001b[27Gw\u001b[29Gile you're there, pleas\u001b[53G also look\u001b[64Gat the editor side, which I couldn't see.\u001b[106GCheck\u001b[112Gthe\u001b[116G\"Land\r\u001b[2C\u001b[1Brates calculator\" entry i\u001b[29G the content wizard under \"Mto Safi\" and its icon. In the Page\u001b[92Gmodule, its previ\u001b[110Gw should\r\u001b[2C\u001b[1Blist the land\u001b[17Guses with \u001b[29Geir rates, the mi\u001b[48Gmum and the interest.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 7s · done 3:50 PM\u001b[33G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m/exit\u001b[39m                                                                                                                  \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[3GBloviating… \u001b[49G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
