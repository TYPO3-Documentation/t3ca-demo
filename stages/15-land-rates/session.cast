[389.096991, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mEdi\u001b[9Gor side:\u001b[22m I wasn't allowed \u001b[36Go\u001b[38Gcreate a t\u001b[49Gmporary backend admin, so I h\u001b[79Gven't seen the content wizard\u001b[109Gentry,\u001b[116Gthe\r\u001b[4C\u001b[1Bform\u001b[10Gor\u001b[13Gthe\u001b[17Gpage\u001b[22Gmodule\u001b[29Gpreview.\u001b[38GThe\u001b[42Gicon\u001b[47Gand\u001b[51Gthe\u001b[55Gelement\u001b[63Gare\u001b[67Gregistered,\u001b[79Gbut\u001b[83Gplease\u001b[90Gopen\u001b[95Gone\u001b[99Gin\u001b[102Gthe\u001b[106Gbackend.\r\u001b[2C\u001b[1B- \u001b[1mFresh install:\u001b[22m I didn't\u001b[29Gtest\u001b[34Gimporting\u001b[44G\u001b[38;2;177;185;249mdata.xml\u001b[53G\u001b[39minto\u001b[58Ga\u001b[60Gnew\u001b[64Ginstallation.\r\u001b[4C\u001b[1B\u001b[1mTes\u001b[9Gs:\u001b[22m the package has none, so non\u001b[41G w\u001b[44Gre\u001b[47Gadded.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThing\u001b[9G to know\u001b[22m\u001b[K\r\u001b[4C\u001b[1BAn exis\u001b[13Ging \"Editors\" gr\u001b[30Gup won't g\u001b[41Gt th\u001b[47Gnew table.\u001b[58GOnly\u001b[63Ggroups\u001b[70Gcreated\u001b[78Gby\u001b[81Ga\u001b[83Gnew\u001b[87Gsetup\u001b[93Gdo,\u001b[97Gso\u001b[100Gon\u001b[103Gan\u001b[106Ginstallation\r\u001b[4C\u001b[1Bthat\u001b[10Galready\u001b[18Ghas\u001b[22Gone,\u001b[27Gadd\u001b[31Gthe\u001b[35Gtable\u001b[41Gto\u001b[44Gthe\u001b[48Ggroup\u001b[54Gby\u001b[57Ghand.\r\u001b[2C\u001b[1B- The due date,\u001b[19G31\u001b[22GMarch,\u001b[29Gis\u001b[32Gwritten\u001b[40Ginto\u001b[45Gthe\u001b[49Glabel\u001b[55Gtexts,\u001b[62Gnot\u001b[66Gstored\u001b[73Gas\u001b[76Ga\u001b[78Gfield.\r\u001b[4C\u001b[1BWithout JavaScr\u001b[21Gpt the \u001b[29Gesults s\u001b[38Gay empty, the sam\u001b[56G as in\u001b[63Gthe design.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI round the annual rate and the interes\u001b[45G to whole shillings\u001b[65Gseparately,\u001b[77Gso\u001b[80Gthe\u001b[84Glines\u001b[90Gadd\u001b[94Gup\u001b[97Gto\u00