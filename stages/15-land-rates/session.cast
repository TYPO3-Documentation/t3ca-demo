[504.290337, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAn\u001b[6Geditor\u001b[13Gchanges\u001b[21Gthem\u001b[26Gin\u001b[29Gthe\u001b[33Gbackend\u001b[41Gby\u001b[44Gediting\u001b[52Gthe\u001b[56Gcalculator\u001b[67Gon\u001b[70Gthe\u001b[74G\"Land\u001b[80Grates\"\u001b[87Gpage.\u001b[93GNo\u001b[96Gdeveloper\u001b[106Gis\u001b[109Gneeded\u001b[116Gfor\r\u001b[1B \u001b[3Gthe rates themselves, but a few\u001b[35Gother\u001b[41Gplaces\u001b[48Gon\u001b[51Gthe\u001b[55Gsite\u001b[60Galso\u001b[65Gstate\u001b[71Gthem\u001b[76Gand\u001b[80Ghave\u001b[85Gto\u001b[88Gbe\u001b[91Gupdated\u001b[99Galongside.\r\u001b[2B  \u001b[1mWho\u001b[22m\u001b[K\r\u001b[2B \u001b[5Gyone in\u001b[13Gt\u001b[15Ge \"Edi\u001b[22Gors\" group, or a\u001b[39G adminis\u001b[48Grator. One \u001b[60Gatch: only a group c\u001b[81Geated\u001b[87Gby a new\u001b[96Gs\u001b[98Gtup can\u001b[106Gedit lan\u001b[116Guses.\r\u001b[2C\u001b[1BOn an in\u001b[12Gtallation whose \"Editors\" g\u001b[40Goup already exi\u001b[56Gted, an adminis\u001b[72Grator must first add \"Lan\u001b[99Guse\" to the\u001b[111Ggroup's\r\u001b[2C\u001b[1Btables\u001b[10G(System\u001b[18G>\u001b[20GBackend\u001b[28Gusers\u001b[34G>\u001b[36Gthe\u001b[40Ggroup\u001b[46G>\u001b[48GAccess\u001b[55Glists).\u001b[63GOtherwise\u001b[73Geditors\u001b[81Gcan\u001b[85Gopen\u001b[90Gthe\u001b[94Gcalculator\u001b[105Gbut\u001b[109Gcan't\u001b[115Gchange\r\u001b[2C\u001b[1Bthe\u001b[7Gland\u001b[12Guses.\r\u001b[2C\u001b[2B\u001b[1mHow\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1. Open the Page\u001b[20Gmodule and the \"Land \u001b[42Gates\"\u001b[48Gpag\u001b[52G.\u001b[K\r\u001b[2C\u001b[1B2. Edit the \"Land\u001b[21Grates\u001b[27Gcalculator\"\u001b[39Gelement:\r\u001b[5C\u001b[1B-\u001b[8GUnder\u001b[14G\"Land\u001b[20Guses\",\u001b[27Gchange\u001b[34Geach\u001b[39G\"Rate\u001b[45G(%\u001b[48Gof\u001b[51Gthe\u001b[55Grateable\u001b[64Gvalue\u001b[70Gper\u001b[74Gyear)\".\u001b[82GThis\u001b[87Gis\u001b[90Galso\u001b[95Gwhere\u001b[101Ga\u001b[103Gland\u001b[108Guse\u001b[112Gis\u001b[115Gadded,\r\u001b[2C\u001b[1B   \u001b[8Gremoved\u001b[16Gor\u001b[19Greordered.\r\u001b[5C\u001b[1B-\u001b[8GChange\u001b[15G\"Minimum\u001b[24Grate\u001b[29G(KES\u001b[34Gper\u001b[38Gplot\u001b[43Gand\u001b[47Gyear)\"\u001b[54Gand\u001b[58G\"Interest\u001b[68Gwhen\u001b[73Gpaid\u001b[78Glate\u001b[83G(%\u001b[86Gper\u001b[90Gmonth)\"\u001b[98Gif\u001b[101Gthey\u001b[106Gchange\u001b[113Gtoo.\r\u001b[2C\u001b[1B3\u001b[6GSave. Savin\u001b[18G the e\u001b[26Gme\u001b[29Gt\u001b[31Gcl\u001b[34Gars that page's cache,\u001b[57Gso\u001b[60Gthe\u001b[64Gnew\u001b[68Grates\u001b[74Gshow\u001b[79Gon\u001b[82Gthe\u001b[86Gnext\u001b[91Gvisit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe edito\u001b[14Gonly changes\u001b[27Gt\u001b[29Ge Englis\u001b[39Gelem\u001b[44Gnt.\u001b[48GThe Kisw\u001b[57Ghili page calculat\u001b[76Gs with the\u001b[87GEngli\u001b[93Gh\u001b[95Grates, so there is nothing\r\u001b[2C\u001b[1Bto\u001b[6Gchange there, unless a land\u001b[34Guse\u001b[38Gis\u001b[41Gadded.\u001b[48GThat\u001b[53Gone\u001b[57Gneeds\u001b[63Ga\u001b[65GKiswahili\u001b[75Gname\u001b[80Gon\u001b[83Gthe\u001b[87Gtranslation,\u001b[100Gotherwise\u001b[110Git\u001b[113Gappears\r\u001b[2C\u001b[1Bin\u001b[6GEnglish on the Kisw\u001b[26Ghili page. I haven't\u001b[47Gactually tested a rate change followed\u001b[86Gby a look at the Kiswahili\u001b[113Gpage;\u001b[119GI\r\u001b[2C\u001b[1Bcan run th\u001b[14Gt tes\u001b[20G.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhat else states the rates\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
