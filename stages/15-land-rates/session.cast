[605.229121, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[23B\u001b[38;2;177;185;249m\u001b[1mi\u001b[51Gi\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;153;153;153mty\u001b[10G3-development-installation\u001b[49GBring the local devel\u001b[71Gpment instal\u001b[84Gati\u001b[88Gn of a TYPO3 extension,\r\u001b[2C\u001b[1B\u001b[39m                                              \u001b[38;2;153;153;153msitepackage or\u001b[64Gp\u001b[66Goj\u001b[69Gct package into \u001b[39m\u001b[1mexi\u001b[22m\u001b[38;2;153;153;153mstence, or boot and\u001b[108Grepair the …\r\u001b[2C\u001b[1B  /verify                                     Try your change a\u001b[67Gd report if it works\u001b[39m\u001b[K\r\u001b[5C\u001b[2Bi\u001b[31;1H\u001b[29;7H\u001b[?25h"]
