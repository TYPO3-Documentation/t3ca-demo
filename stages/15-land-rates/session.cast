1b[80Gsame\u001b[85Gsession:\r\u001b[2C\u001b[1B- \u001b[1mThe rates table\u001b[22m o\u001b[23G \u001b[25Ghe s\u001b[30Gm\u001b[33Gpage, \"Rates for 2026\": i\u001b[59Gs\u001b[61Ghe\u001b[64Gding and\u001b[73Gevery row.\u001b[K\r\u001b[8C\u001b[1B\u001b[1mtext above it,\u001b[24G\u001b[22m\"How your land\u001b[39Grates are calculated\", which n\u001b[70Gmes the interest\u001b[87Gof\u001b[90G1\u001b[92G%.\r\u001b[8C\u001b[1B\u001b[1mdue d\u001b[15Gte, 31 March,\u001b[29G\u001b[22min the calculator's\u001b[49Ghints \u001b[56Gnd in\u001b[62Gt\u001b[64Ge slider text\u001b[78Go\u001b[80G th\u001b[84G home\u001b[90Gpage.\u001b[96GThe\u001b[100Ghints\u001b[106Gare\u001b[110Gin\u001b[113Gthe\u001b[117Glabel\r\u001b[2C\u001b[1B \u001b[5Gfiles, not in a field, so a different due date needs a developer.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTiming\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gchange\u001b[12Gis\u001b[15Glive\u001b[20Gas\u001b[23Gsoon\u001b[28Gas\u001b[31Git's\u001b[36Gsaved;\u001b[43Gyou\u001b[47Gcan't\u001b[53Gschedule\u001b[62Git\u001b[65Gfor\u001b[69G1\u001b[71GJanuary.\u001b[80GAn\u001b[83Geditor\u001b[90Gcan\u001b[94Gwork\u001b[99Garound\u001b[106Gthat:\u001b[112Gcopy\u001b[117Gthe\r\u001b[2C\u001b[1Beleme\u001b[9Gt,\u001b[12Genter the new rates, and set the copy's \"Publish da\u001b[64Ge\" to 1 January\u001b[80Ga\u001b[82Gd the old one's \"Expiration date\" to the\r\u001b[2C\u001b[1Bsame day. Th\u001b[16G rat\u001b[21Gs table needs the same treatment.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gtable\u001b[13Gand\u001b[17Gthe\u001b[21Gcalculator\u001b[32Gcan\u001b[36Gdisagree,\u001b[46Ga\u001b[76Ghis\u001b[80Gsetup.\u001b[87GI\u001b[89Gcould\u001b[95Gmake\u001b[100Gthe\u001b[104Gcalculator\u001b[115Gelement\u001b[31;1H\u001b[29;3H\u001b[?25h"]
