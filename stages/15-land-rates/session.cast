[504.770956, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWho\u001b[7G\u001b[22m\u001b[K\r\u001b[2C\u001b[2BAnyone\u001b[10Gin\u001b[13Gthe\u001b[17G\"Editors\"\u001b[27Ggroup,\u001b[34Gor\u001b[37Gan\u001b[40Gadministrator.\u001b[55GOne\u001b[59Gcatch:\u001b[66Gonly\u001b[71Ga\u001b[73Ggroup\u001b[79Gcreated\u001b[87Gby\u001b[90Ga\u001b[92Gnew\u001b[96Gsetup\u001b[102Gcan\u001b[106Gedit\u001b[111Gland\u001b[116Guses.\r\u001b[2C\u001b[1BOn\u001b[6Gan\u001b[9Ginstallation\u001b[22Gwhose\u001b[28G\"Editors\"\u001b[38Ggroup\u001b[44Galready\u001b[52Gexisted,\u001b[61Gan\u001b[64Gadministrator\u001b[78Gmust\u001b[83Gfirst\u001b[89Gadd\u001b[93G\"Land\u001b[99Guse\"\u001b[104Gto\u001b[107Gthe\u001b[111Ggroup's\r\u001b[2C\u001b[1Btables\u001b[10G(Syst\u001b[16Gm > Backend users\u001b[34G> the\u001b[40Ggroup > Access\u001b[55Glists). Otherwise\u001b[73Geditors c\u001b[83Gn open\u001b[90Gthe calculator but can't change\r\u001b[2C\u001b[1Bthe land uses.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow\u001b[7G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. Open\u001b[11Gthe\u001b[15GPage\u001b[20Gmodule\u001b[27Gand\u001b[31Gthe\u001b[35G\"Land\u001b[41Grates\"\u001b[48Gpage.\r\u001b[2C\u001b[1B2.\u001b[6GEdit\u001b[11Gthe\u001b[15G\"Land\u001b[21Grates\u001b[27Gcalculator\"\u001b[39Gelement:\r\u001b[2C\u001b[1B  \u001b[6G- U\u001b[10Gder \"L\u001b[17Gnd\u001b[20Guses\",\u001b[27Gchange each \"Rate (%\u001b[48Gof the\u001b[55Grateable\u001b[64Gvalue\u001b[70Gper\u001b[74Gyear)\".\u001b[82GThis\u001b[87Gis\u001b[90Galso\u001b[95Gwhere\u001b[101Ga\u001b[103Gland\u001b[108Guse\u001b[112Gis\u001b[115Gadded,\r\u001b[2C\u001b[1B  \u001b[6G  remov\u001b[14Gd or reord\u001b[25Gred.\u001b[K\r\u001b[7C\u001b[1BChange \"Minimum rate (KES\u001b[34Gper plot and year)\" and \"Int\u001b[63Grest when paid late (% per\u001b[90Gmonth)\" if\u001b[101Gthey change too.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GSav\u001b[10G. Saving\u001b[19Gthe element\u001b[31Gclears\u001b[38Gthat\u001b[43Gpage's\u001b[50Gcache,\u001b[57Gso\u001b[60Gthe\u001b[64Gnew\u001b[68Grates\u001b[74Gshow\u001b[79Gon\u001b[82Gthe\u001b[86Gnext\u001b[91Gvisit.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe editor only\u001b[19Gc\u001b[21Ganges the\u001b[31GEngli\u001b[37Gh element. The Kiswahili pag\u001b[66G calculates with the English rates,\u001b[102Gso\u001b[105Gthere\u001b[111Gis\u001b[114Gnothing\r\u001b[2C\u001b[1Bto\u001b[6Gchange\u001b[13Gthere,\u001b[20Gunless\u001b[27Ga\u001b[29Gland\u001b[34Guse\u001b[38Gis\u001b[41Gadded.\u001b[48GThat\u001b[53Gone\u001b[57Gneeds\u001b[63Ga\u001b[65GKiswahili\u001b[75Gname\u001b[80Gon\u001b[83Gthe\u001b[87Gtranslation,\u001b[100Gotherwise\u001b[110Git\u001b[113Gappears\r\u001b[2C\u001b[1Bin English\u001b[16G the Kiswahili\u001b[31Gpa\u001b[34Ge. I\u001b[39Ghaven'\u001b[46G actually tested \u001b[64G rate \u001b[71Ghang\u001b[76G followed by a look \u001b[98G the Kiswahil\u001b[112G page; I\u001b[K\r\u001b[2C\u001b[1Bcan ru\u001b[10G that t\u001b[18Gst.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat else states the rates\r\u001b[2C\u001b[2B\u001b[22mThe calculator doesn't update\u001b[33Gthese,\u001b[40Gso\u001b[43Gthe\u001b[47Geditor\u001b[54Ghas\u001b[58Gto\u001b[61Gchange\u001b[68Gthem\u001b[73Gin\u001b[76Gthe\u001b[80Gsame\u001b[85Gsession:\r\u001b[2C\u001b[1B-\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[505.020564, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWho\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BAnyone\u001b[10Gin\u001b[13Gthe\u001b[17G\"Editors\"\u001b[27Ggroup,\u001b[34Gor\u001b[37Gan\u001b[40Gadministrator.\u001b[55GOne\u001b[59Gcatch:\u001b[66Gonly\u001b[71Ga\u001b[73Ggroup\u001b[79Gcreated\u001b[87Gby\u001b[90Ga\u001b[92Gnew\u001b[96Gsetup\u001b[102Gcan\u001b[106Gedit\u001b[111Gland\u001b[116Guses.\r\u001b[2C\u001b[1BO\u001b[5G a\u001b[8G installation whose \"Editors\" group already exist\u001b[58Gd, an administrat\u001b[76Gr must first add \"Land \u001b[100Gse\" to the\u001b[111Ggroup'\u001b[118G\u001b[K\r\u001b[2C\u001b[1Btables (System > Backend\u001b[28Gusers > the group > Access lists). Otherw\u001b[71Ge editors can open the c\u001b[96Glculator bu\u001b[108G can't change\r\u001b[3C\u001b[1Bhe land u\u001b[14Ges.\u001b[18G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6GOpen\u001b[11Gthe\u001b[15GPage\u001b[20Gmodule\u001b[27Gand\u001b[31Gthe\u001b[35G\"Land\u001b[41Grates\"\u001b[48Gpage.\r\u001b[2C\u001b[1B2\u001b[6GEdit\u001b[15G\"Land rates\u001b[27Gcalculator\" element:\u001b[48G\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- Under \"Land uses\",\u001b[28Ghange each\u001b[39G\"Rat\u001b[44G (%\u001b[48Gof\u001b[51Gthe\u001b[55Grateable\u001b[64Gvalue\u001b[70Gper\u001b[74Gyear)\".\u001b[82GThis\u001b[87Gis\u001b[90Galso\u001b[95Gwhere\u001b[101Ga\u001b[103Gland\u001b[108Guse\u001b[112Gis\u001b[115Gadded,\r\u001b[5C\u001b[1B \u001b[8Gremoved or reordered.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GChang\u001b[14G \"Minimum rate (KES\u001b[34Gper\u001b[38Gplot\u001b[43Gand\u001b[47Gyear)\"\u001b[54Gand\u001b[58G\"Interest\u001b[68Gwhen\u001b[73Gpaid\u001b[78Glate\u001b[83G(%\u001b[86Gper\u001b[90Gmonth)\"\u001b[98Gif\u001b[101Gthey\u001b[106Gchange\u001b[113Gtoo.\r\u001b[2C\u001b[1B3.\u001b[6GSave. Saving the elem\u001b[28Gnt clears\u001b[38Gtha\u001b[43Gpage's cache, so th\u001b[63G new\u001b[68Grates show on the\u001b[86Gn\u001b[88Gxt visit.\u001b[98G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Geditor\u001b[14Gonly\u001b[19Gchanges\u001b[27Gthe\u001b[31GEnglish\u001b[39Gelement.\u001b[48GThe\u001b[52GKiswahili\u001b[62Gpage\u001b[67Gcalculates\u001b[78Gwith\u001b[83Gthe\u001b[87GEnglish\u001b[95Grates,\u001b[102Gso\u001b[105Gthere\u001b[111Gis\u001b[114Gnothing\r\u001b[2C\u001b[1Bto change there, unles\u001b[27Ga land use is added\u001b[50Gat one needs \u001b[64G Kiswahi\u001b[73Gi name on\u001b[87Gtranslation, otherwise it appears\u001b[K\r\u001b[2C\u001b[1Bin\u001b[6GEnglish on the Kiswahili page. I haven't actually tested\u001b[65Grate change followed by \u001b[90G look at the Kiswahili\u001b[113Gpag\u001b[117G; I\r\u001b[2C\u001b[1Bcan run t\u001b[13Gat test.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat else states the rates\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcalculator\u001b[18Gdoesn't\u001b[26Gupdate\u001b[33Gthese,\u001b[40Gso\u001b[43Gthe\u001b[47Geditor\u001b[54Ghas\u001b[58Gto\u001b[61Gchange\u001b[68Gthem\u001b[73Gin\u001b[76Gthe\u001b[80Gsame\u001b[85Gsession:\r\u001b[2C\u001b[1B- \u001b[1mThe rates table\u001b[22m o\u001b[23G \u001b[25Ghe s\u001b[30Gm\u001b[33Gpage, \"Rates for 2026\": i\u001b[59Gs\u001b[61Ghe\u001b[64Gding and\u001b[73Gevery row.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[505.037582, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ The rates change every year. Who changes them, and how?\u001b[39m                                                                \r\u001b[2C\u001b[1B\u001b[49m\u001b[1mWho\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gyo\u001b[8Ge in the \"Editors\" group, or an administrator. On\u001b[58G catch: only a gr\u001b[76Gup created by a new set\u001b[100Gp can edit\u001b[111Gland u\u001b[118Ges.\r\u001b[2C\u001b[1BOn an installation whose\u001b[28G\"Editors\" group already existed, an admin\u001b[71Gtrator must first add \"L\u001b[96Gnd use\" to \u001b[108Ghe group's\u001b[K\r\u001b[3C\u001b[1Bables (Sy\u001b[14Gtem\u001b[18G>\u001b[20GBackend\u001b[28Gusers\u001b[34G>\u001b[36Gthe\u001b[40Ggroup\u001b[46G>\u001b[48GAccess\u001b[55Glists).\u001b[63GOtherwise\u001b[73Geditors\u001b[81Gcan\u001b[85Gopen\u001b[90Gthe\u001b[94Gcalculator\u001b[105Gbut\u001b[109Gcan't\u001b[115Gchange\r\u001b[2C\u001b[1Bthe\u001b[7Gland\u001b[12Guses.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1\u001b[6GOpen\u001b[15GPage module\u001b[27Gand the \"Land rates\"\u001b[48Gpage.\r\u001b[2C\u001b[1B2.\u001b[6GEdit the \"Land rates\u001b[28Galculator\"\u001b[39Gelem\u001b[44Gnt:\u001b[48G\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GUnder \"Land uses\", change\u001b[34Geach\u001b[39G\"Rate\u001b[45G(%\u001b[48Gof\u001b[51Gthe\u001b[55Grateable\u001b[64Gvalue\u001b[70Gper\u001b[74Gyear)\".\u001b[82GThis\u001b[87Gis\u001b[90Galso\u001b[95Gwhere\u001b[101Ga\u001b[103Gland\u001b[108Guse\u001b[112Gis\u001b[115Gadded,\r\u001b[5C\u001b[1B \u001b[8Gremov\u001b[14Gd or reordered.\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- Change \"Minimum rat\u001b[28G (KES per\u001b[38Gplo\u001b[43Gand year)\" and \"Int\u001b[63Grest\u001b[68Gwhen paid late (%\u001b[86Gp\u001b[88Gr month)\"\u001b[98Gif\u001b[101Gthey\u001b[106Gchange\u001b[113Gtoo.\r\u001b[2C\u001b[1B3.\u001b[6GSave.\u001b[12GSaving\u001b[19Gthe\u001b[23Gelement\u001b[31Gclears\u001b[38Gthat\u001b[43Gpage's\u001b[50Gcache,\u001b[57Gso\u001b[60Gthe\u001b[64Gnew\u001b[68Grates\u001b[74Gshow\u001b[79Gon\u001b[82Gthe\u001b[86Gnext\u001b[91Gvisit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe editor only change\u001b[27Gthe English element\u001b[50Ge Kiswahili p\u001b[64Gge calcu\u001b[73Gates with\u001b[87GEnglish rates, so there is nothing\r\u001b[2C\u001b[1Bto\u001b[6Gchange there, unless a land use is added. That one needs\u001b[65GKiswahili name on the tr\u001b[90Gnslation, otherwise it\u001b[113Gapp\u001b[117Gars\r\u001b[2C\u001b[1Bin Englis\u001b[13G on the Kiswahili\u001b[31Gpage.\u001b[37GI\u001b[39Ghaven't\u001b[47Gactually\u001b[56Gtested\u001b[63Ga\u001b[65Grate\u001b[70Gchange\u001b[77Gfollowed\u001b[86Gby\u001b[89Ga\u001b[91Glook\u001b[96Gat\u001b[99Gthe\u001b[103GKiswahili\u001b[113Gpage;\u001b[119GI\r\u001b[2C\u001b[1Bcan\u001b[7Grun\u001b[11Gthat\u001b[16Gtest.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat else states the rates\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe calculator does\u001b[23G'\u001b[25G upd\u001b[30Gt\u001b[33Gthese, so the editor has \u001b[59Go\u001b[61Gch\u001b[64Gnge them\u001b[73Gin the same\u001b[85Gsession:\r\u001b[4C\u001b[1B\u001b[1mThe rates table\u001b[21G\u001b[22mon\u001b[24Gthe\u001b[28Gsame\u001b[33Gpage,\u001b[39G\"Rates\u001b[46Gf\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49mry\u001b[79Grow.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
