[358.486161, "o", "\u001b[?25l\u001b[H\u001b[3G  moved\u001b[11Gor \u001b[15Ghe\u001b[18Gaddress\u001b[26Gmay\u001b[30Gbe\u001b[33Gmistyped,\u001b[43Gwith\u001b[48Glinks\u001b[54Gto\u001b[57Gthe\u001b[61Ghome\u001b[66Gpage\u001b[71Gand\u001b[75Gto\u001b[78GSearch.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mError handling:\u001b[21G\u001b[22m\u001b[38;2;177;185;249mconfig/sites/main/config.yaml\u001b[51G\u001b[39mnow\u001b[55Gsends\u001b[61G404\u001b[65Gerrors\u001b[72Gto\u001b[75Gthat\u001b[80Gpage.\r\u001b[2C\u001b[1B- \u001b[1mChecked:\u001b[22m \u001b[38;2;177;185;249m/apple-tree\u001b[39m and\u001b[30G\u001b[38;2;177;185;249m/revenue-payments/apple-tree\u001b[59G\u001b[39mboth\u001b[64Greturn\u001b[71G404\u001b[75Gand\u001b[79Gshow\u001b[84Gthe\u001b[88Gnew\u001b[92Gpage.\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m/search?q=x\u001b[39m still retur\u001b[29Gs 200.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor fresh installs\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSeed script:\u001b[22m \u001b[38;2;177;185;249mBuild/Initiali\u001b[33Gatio\u001b[39Gseed-not-found.php\u001b[39m writes\u001b[65Gthe page and \u001b[79Ghe 404\u001b[86Gsetting,\u001b[95Gthe\u001b[99Gsame\u001b[104Gway\r\u001b[2C\u001b[1B \u001b[5Gearlier stages did. It runs after \u001b[38;2;177;185;249mseed-home.\u001b[50Ghp\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPackage content:\u001b[22m I re-exported\u001b[36G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m.\u001b[61GCompared\u001b[70Gwith\u001b[75Gthe\u001b[79Gold\u001b[83Gfile,\u001b[89Gonly\u001b[94Gthe\u001b[98Gnew\u001b[102Gpage\r\u001b[4C\u001b[1Band\u001b[9Gits\u001b[13Gtext\u001b[18Gelement\u001b[26Gwere\u001b[31Gadded,\u001b[38Gplus\u001b[43Ga\u001b[45Gtimestamp\u001b[55Gon\u001b[58Gthe\u001b[62Ghome\u001b[67Gpage.\u001b[73GThe\u001b[77Gimage\u001b[83Gfiles\u001b[89Gare\u001b[93Gunchanged.\r\u001b[2C\u001b[1B- \u001b[1mShipped\u001b[13Gsite config:\u001b[26G\u001b[22m\u001b[38;2;177;185;249mInitialisation/Site/main/config.yaml\u001b[63G\u001b[39mhas\u001b[67Gthe\u001b[71Gsame\u001b[76G404\u001b[80Gsetting.\r\u001b[4C\u001b[1B\u001b[1mREADME:\u001b[22m it now lists the fourth script, and it notes\u001b[58Gtha\u001b[62G the 404 s\u001b[73Gtting points\u001b[86Gat page uid 33. That\u001b[K\r\u001b[4C\u001b[1Buid \u001b[10Gs only right on an empty installation, the same\u001b[58Glimit\u001b[64Gthe\u001b[68Gsearch\u001b[75Gand\u001b[79Gmenu\u001b[84Gsettings\u001b[93Galready\u001b[101Ghave.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot tested:\u001b[22m installi\u001b[24Gg\u001b[26Gthe p\u001b[32Gckage\u001b[38Gon a\u001b[43Gfresh installation. I couldn't do\u001b[77Gth\u001b[80Gt here, and the proj\u001b[101Gct\u001b[104Ghas\r\u001b[2C\u001b[1Bno tests that import the file.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing is comm\u001b[19Gtted yet.\u001b[29GTha\u001b[33G includes \u001b[44Ghe search fix\u001b[58Gin \u001b[38;2;177;185;249mext_localconf.php\u001b[79G\u001b[39mfrom\u001b[84Gearl\u001b[89Ger.\u001b[93GBefore running\r\u001b[2C\u001b[1Bthe\u001b[7Gseed\u001b[12Gscript\u001b[19GI\u001b[21Gtook\u001b[26Ga\u001b[28GDDEV\u001b[33Gdatabase\u001b[42Gsnapshot\u001b[51Gnamed\u001b[57G\u001b[38;2;177;185;249mbefore-not-found\u001b[39m,\u001b[75Gso\u001b[78Gyou\u001b[82Gcan\u001b[86Groll\u001b[91Gback\u001b[96Gto\u001b[99Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 1m 35s · done 12:07 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255m/exit\u001b[39m                                                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✶\u001b[3GH\u001b[38;2;235;159;127matc\u001b[38;2;215;119;87mhing… \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Tip: Drag and drop images into your terminal\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \