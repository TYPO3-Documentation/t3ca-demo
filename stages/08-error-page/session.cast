53m · summary\u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe exclusion belongs\u001b[25Gin\u001b[28Gthe\u001b[32Gsitepackage's\u001b[46Gext_localconf.php,\u001b[65Gsince\u001b[71Gadditional.php\u001b[86Gis\u001b[89GDDEV-generated\u001b[104Gand\r\u001b[2C\u001b[1Buntracked,\u001b[14Gso\u001b[17GI'm\u001b[21Greverting\u001b[31Gthe\u001b[35Gsettings.php\u001b[48Gchange.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[13C\u001b[2B\u001b[38;2;153;153;153m6\u001b[35Gthought for 3s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
