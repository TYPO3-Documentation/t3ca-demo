[240.52473, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's on your site now\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew page:\u001b[15G\u001b[22m\"Page not\u001b[25Gfound\" (uid 33) under Hom\u001b[51G. It's h\u001b[61Gden from the menu\u001b[79Gand\u001b[83Gmarked\u001b[90G\u001b[38;2;177;185;249mnoindex\u001b[39m/\u001b[38;2;177;185;249mnofollow\r\u001b[4C\u001b[1B\u001b[39mso search\u001b[15Gengines skip it. It uses the Narrow layout and has one text\u001b[75Gelement\u001b[83Gsaying\u001b[90Gthe\u001b[94Gpage\u001b[99Gmay\u001b[103Ghave\r\u001b[4C\u001b[1Bmoved\u001b[11Gor\u001b[14Gthe\u001b[18Gaddress may b\u001b[32G mistyped, with links to th\u001b[60G home page and to S\u001b[80Garch.\u001b[K\r\u001b[1B  - \u001b[1mError handling:\u001b[22m \u001b[38;2;177;185;249mconfig/sites/main/config.yaml\u001b[51G\u001b[39mnow\u001b[55Gsends\u001b[61G404\u001b[65Gerrors\u001b[72Gto\u001b[75Gthat\u001b[80Gpage.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChecked:\u001b[14G\u001b[22m\u001b[38;2;177;185;249m/apple-tree\u001b[26G\u001b[39mand\u001b[30G\u001b[38;2;177;185;249m/revenue-payments/apple-tree\u001b[59G\u001b[39mboth\u001b[64Greturn\u001b[71G404\u001b[75Gand\u001b[79Gshow\u001b[84Gthe\u001b[88Gnew\u001b[92Gpage.\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249m/search?q=x\u001b[39m still returns 200.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor fresh installs\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed script:\u001b[22m \u001b[38;2;177;185;249mBuild/Initialisation/seed-not-found.php\u001b[39m writes\u001b[65Gthe\u001b[69Gpage\u001b[74Gand\u001b[78Gthe\u001b[82G404\u001b[86Gsetting,\u001b[95Gthe\u001b[99Gsame\u001b[104Gway\r\u001b[4C\u001b[1Bearlier\u001b[13Gstages\u001b[20Gdid.\u001b[25GIt\u001b[28Gruns\u001b[33Gafter\u001b[39G\u001b[38;2;177;185;249mseed-home.php\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPackage content:\u001b[22m I re-exported \u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m. Compared with the old file, only the new\u001b[102Gpage\r\u001b[4C\u001b[1Band its text element were added, plus a timestamp on the home page. The image files are unchanged.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mShipped site config:\u001b[22m \u001b[38;2;177;185;249mInitialisation/Site/main/config.yaml\u001b[39m has the same 404 setting.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mREADME:\u001b[22m it now lists the fourth script, and it notes that the 404 setting points at page uid 33.\u001b[102GThat\r\u001b[4C\u001b[1Buid is only right on an e\u001b[31Gpty installation, th\u001b[52G \u001b[54Game limit the search and menu settings\u001b[93Galready\u001b[101Ghave.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot tested:\u001b[15G\u001b[22minstalling\u001b[26Gthe\u001b[30Gpackage\u001b[38Gon\u001b[41Ga\u001b[43Gfresh\u001b[49Ginstallation.\u001b[63GI\u001b[65Gcouldn't\u001b[74Gdo\u001b[77Gthat\u001b[82Ghere,\u001b[88Gand\u001b[92Gthe\u001b[96Gproject\u001b[104Ghas\r\u001b[2C\u001b[1Bno\u001b[6Gtests\u001b[12Gthat\u001b[17Gimport\u001b[24Gthe\u001b[28Gfile.\r\u001b[1B\u001b[K\r\u001b[1B  Nothing is committed yet. That includes the search fix in \u001b[38;2;177;185;249mext_localconf.php\u001b[39m from earlier. Before\u001b[100Grunning\r\u001b[2C\u001b[1Bthe seed script I took a DDEV database snapshot named\u001b[57G\u001b[38;2;177;185;249mbefore-not-found\u001b[39m,\u001b[75Gso\u001b[78Gyou\u001b[82Gcan\u001b[86Groll\u001b[91Gback\u001b[96Gto\u001b[99Git.\r\u001b[2C\u001b[2B\u001b[38;2;235;159;127mNuc\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
