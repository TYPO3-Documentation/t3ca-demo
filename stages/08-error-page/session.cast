[119.851225, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThat\u001b[8Gone isn'\u001b[18Gthe same\u001b[27Gbug.\u001b[32G\u001b[38;2;177;185;249m/apple-tree\u001b[44G\u001b[39misn't\u001b[50Ga\u001b[52Gpage\u001b[57Gon\u001b[60Gyour\u001b[65Gsite:\u001b[71Gthe\u001b[75Gtree\u001b[80Ghas\u001b[84Gno\u001b[87Gpage\u001b[92Gwith\u001b[97Gthat\u001b[102Gslug,\r\u001b[2C\u001b[1Bso\u001b[6Ga\u001b[8G404\u001b[12Gis\u001b[15Gthe\u001b[19Gright\u001b[25Ganswer.\u001b[33GWhat\u001b[38Gyou're\u001b[45Gseeing\u001b[52Gis\u001b[55GTYPO3's\u001b[63Gbuilt-in\u001b[72Gerror\u001b[78Gpage.\u001b[84GIt\u001b[87Gappears\u001b[95Gbecause\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mconfig/sites/main/config.yaml\u001b[39m (and the\u001b[42Gcopy in\u001b[K\r\u001b[31C\u001b[1B\u001b[38;2;177;185;249mInitialisation/Site/main/config.yaml\u001b[39m) has \u001b[38;2;177;185;249merrorHandling: {  }\u001b[39m, so the\u001b[102Gsite\r\u001b[2C\u001b[1Bhas no 404 page of \u001b[23Gts\u001b[26Gown.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gsearch\u001b[14Gbug\u001b[18Gonly\u001b[23Glooked\u001b[30Gthe\u001b[34Gsame\u001b[39Gbecause\u001b[47Git\u001b[50Gended\u001b[56Gin\u001b[59Gthat\u001b[64Gsame\u001b[69Gbuilt-in\u001b[78Gpage.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BT\u001b[5G get a\u001b[12Gstyled \"Page not\u001b[29Gfound\"\u001b[36Gpage\u001b[41Gins\u001b[45Gde\u001b[48Gyour site l\u001b[60Gyout, I'd do this:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mAdd the page:\u001b[20G\u001b[22mcreate\u001b[27Ga\u001b[29G\"Page\u001b[35Gnot\u001b[39Gfound\"\u001b[46Gpage\u001b[51Gunder\u001b[57GHome,\u001b[63Ghidden\u001b[70Gfrom\u001b[75Gthe\u001b[79Gmenu,\u001b[85Gwith\u001b[90Ga\u001b[92Gshort\u001b[98Gtext\u001b[103Gand\r\u001b[5C\u001b[1Blinks\u001b[12Gto\u001b[15GHome\u001b[20Gand\u001b[24GSearch.\r\u001b[1B \u001b[3G2. \u001b[1mPoint the site at it:\u001b[22m a