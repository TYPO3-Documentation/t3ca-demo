   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242m     \u001b[17G                   \u001b[37G   \u001b[41G     \u001b[47G   \u001b[51G      \u001b[58G     \u001b[64G  \u001b[67G   \u001b[71G     \u001b[77G             \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 65 \u001b[22m The news plugins name their pages (the news folder, the list and the detail\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 66 \u001b[22m page) in FlexForm fields the import remaps, so they need no site setting.\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mCalling\u001b[11Gtypo3-dev-companion,\u001b[32Grunning\u001b[40G\u001b[1m1\u001b[42G\u001b[22mshell\u001b[48Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ddev exec php -l Build/Initialisation/seed-not-found.php; git status --short; ls Tests \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mpackages/mtosafi_sitepackage/Tests 2>&1 | head -3\u001b[39m\u001b[K\r\u001b[42C\u001b[2B\u001b[38;2;153;153;153mought for 1s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
