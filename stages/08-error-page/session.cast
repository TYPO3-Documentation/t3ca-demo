[78.753327, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m    \u001b[22m \u001b[38;2;230;219;116mguration/RTE/Mtosafi.yaml'\u001b[39m;\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  8 +\u001b[38;2;248;248;242m                                                                                         \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  9 +\u001b[38;2;117;113;94m// The search form in the page header submits \"q\" without a cHash; with\u001b[38;2;248;248;242m                  \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 10 +\u001b[38;2;117;113;94m// FE.cacheHash.enforceValidation the request would otherwise end in a 404.\u001b[38;2;248;248;242m              \u001b[39m\u001b[49m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 11 +\u001b[38;2;248;248;242m$GLOBALS[\u001b[38;2;230;219;116m'TYPO3_CONF_VARS'\u001b[38;2;248;248;242m][\u001b[38;2;230;219;116m'FE'\u001b[38;2;248;248;242m][\u001b[38;2;230;219;116m'cacheHash'\u001b[38;2;248;248;242m][\u001b[38;2;230;219;116m'excludedParameters'\u001b[38;2;248;248;242m][] = \u001b[38;2;230;219;116m'q'\u001b[38;2;248;248;242m;            \u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gsearch\u001b[14Gbutton\u001b[21Gworks\u001b[27Gnow.\u001b[32G\u001b[38;2;177;185;249m/search?q=test\u001b[47G\u001b[39mreturns\u001b[55G200\u001b[59Ginstead\u001b[67Gof\u001b[70Gthe\u001b[74G404\u001b[78Gerror\u001b[84Gpage,\u001b[90Gand\u001b[94G\u001b[38;2;177;185;249m/search\u001b[102G\u001b[39mand\u001b[106G\u001b[38;2;177;185;249m/\r\u001b[1B\u001b[39m \u001b[3Gstill load normally.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCause:\u001b[22m The\u001b[14Gheader\u001b[21Gsearch\u001b[28Gform\u001b[33Gsends\u001b[39Gthe\u001b[43Gsearch\u001b[50Gterm\u001b[55Gas\u001b[58Ga\u001b[60G\u001b[38;2;177;185;249mq\u001b[62G\u001b[39mparameter\u001b[72Gin\u001b[75Gthe\u001b[79GURL.\u001b[84GYour\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[30G\u001b[39mhas\u001b[34G\u001b[38;2;177;185;249mFE.cacheHash.enforceValidation = true\u001b[39m,\u001b[73Gso\u001b[76GTYPO3\u001b[82Grejects\u001b[90Gany\u001b[94GURL\u001b[98Gthat\u001b[103Ghas\r\u001b[2C\u001b[1Ban\u001b[6Gunknown para\u001b[19Geter but no \u001b[38;2;177;185;249mcHash\u001b[39m (a security checksum\u001b[58Gon\u001b[61GURL\u001b[65Gparameters).\u001b[78GIt\u001b[81Ganswers\u001b[89Gthose\u001b[95Grequests\r\u001b[1B  with \"Page\u001b[14GNot Found\".\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[22m I added\u001b[16G\u001b[38;2;177;185;249mq\u001b[18G\u001b[39mto\u001b[21Gthe\u001b[25Gparameters\u001b[36GTYPO3\u001b[42Gleaves\u001b[49Gout\u001b[53Gof\u001b[56Gthat\u001b[61Gcheck,\u001b[68Gin\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/ext_localconf.php\u001b[39m. I appended it to\u001b[68Gthe existing list so the defaults\u001b[102G(\u001b[38;2;177;185;249mL\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mutm_*\u001b[39m and so on) still apply. I put\u001b[39Git\u001b[42Gin\u001b[45Gthe\u001b[49Gsitepackage\u001b[61Gbecause\u001b[69Gthat's\u001b[76Gwhere\u001b[82Gthe\u001b[86Gsearch\u001b[93Gform\u001b[98Glives,\u001b[105Gso\r\u001b[2C\u001b[1Bthe setting goes wherever the sitepackage is installed. The change isn't committed yet.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill missing:\u001b[22m The Search page (uid 16) has no content elements, and no search extension is installed.\r\u001b[2C\u001b[1BYou land on an empty page rather than seeing results. Real search needs something like \u001b[38;2;177;185;249mindexed_search\u001b[105G\u001b[39mor\r\u001b[1B  \u001b[38;2;177;185;249mke_search\u001b[39m, and its results\u001b[30Gplugin\u001b[37Ghas\u001b[41Gto\u001b[44Gbe\u001b[47Gnon-cacheable,\u001b[62Gbecause\u001b[70G\u001b[38;2;177;185;249mq\u001b[72G\u001b[39mis\u001b[75Gnow\u001b[79Gignored\u001b[87Gwhen\u001b[92GTYPO3\u001b[98Gcaches\r\u001b[2C\u001b[1Bthe\u001b[7Gpage.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mBaked for 58s · done 12:04 PM\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
