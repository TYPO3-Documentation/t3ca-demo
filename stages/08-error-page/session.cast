[106.174643, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe search button works now. \u001b[38;2;177;185;249m/search?q=test\u001b[39m returns 200 instead of the 404 error page, and \u001b[38;2;177;185;249m/search\u001b[102G\u001b[39mand\u001b[106G\u001b[38;2;177;185;249m/\r\u001b[2C\u001b[1B\u001b[39mstill load normally.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mCause:\u001b[22m The header search\u001b[28Gform\u001b[33Gsends\u001b[39Gthe\u001b[43Gsearch\u001b[50Gterm\u001b[55Gas\u001b[58Ga\u001b[60G\u001b[38;2;177;185;249mq\u001b[62G\u001b[39mparameter\u001b[72Gin\u001b[75Gthe\u001b[79GURL.\u001b[84GYour\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[30G\u001b[39mhas\u001b[34G\u001b[38;2;177;185;249mFE.cacheHash.enforceValidation = true\u001b[39m,\u001b[73Gso\u001b[76GTYPO3\u001b[82Grejects\u001b[90Gany\u001b[94GURL\u001b[98Gthat\u001b[103Ghas\r\u001b[1B \u001b[3Gan unknown\u001b[14Gparameter but no \u001b[38;2;177;185;249mcHash\u001b[39m (a security checksum on URL paramet\u001b[73Grs).\u001b[78GIt answers those requests\u001b[K\r\u001b[2C\u001b[1Bwith \"Page\u001b[14GN\u001b[16Gt Found\".\r\u001b[2C\u001b[2B\u001b[1mFix:\u001b[22m I\u001b[10Gadded \u001b[38;2;177;185;249mq\u001b[39m to\u001b[21Gthe parameters TYPO3 leaves out of th\u001b[59Gt check, in\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpacka\u001b[9Ge\u001b[11G/m\u001b[14Gosafi_s\u001b[22Gtepackage/ext_localconf.php\u001b[39m. I appended it to the existing list so the defaults (\u001b[38;2;177;185;249mL\u001b[39m,\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mutm_*\u001b[39m and so on) still apply. I put it in the\u001b[49Gsitepackage\u001b[61Gbecause that'\u001b[75G where the search fo\u001b[96Gm live\u001b[103G,\u001b[105Gso\r\u001b[2C\u001b[1Bthe setting goes wherever\u001b[29Gthe\u001b[33Gsitepackage\u001b[45Gis\u001b[48Ginstalled.\u001b[59GThe\u001b[63Gchange\u001b[70Gisn't\u001b[76Gcommitted\u001b[86Gyet.\r\u001b[2C\u001b[2B\u001b[1mStill missing:\u001b[18G\u001b[22mThe S\u001b[24Garch pag\u001b[33G (uid 16) h\u001b[45Gs no conten\u001b[57G elements\u001b[68Ga\u001b[70Gd\u001b[72Gno\u001b[75Gsearch\u001b[82Gextension\u001b[92Gis\u001b[95Ginstalled.\r\u001b[2C\u001b[1BYou land on an empty page rather than seeing results. Real\u001b[62Gsearch n\u001b[71Geds \u001b[76Gomething like \u001b[38;2;177;185;249mindexed_search\u001b[39m or\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mke_search\u001b[39m, and it\u001b[21G results plugin has to be non-cacheabl\u001b[60G, because \u001b[38;2;177;185;249mq\u001b[39m is now ignor\u001b[85Gd when TYPO3\u001b[98Gcaches\u001b[105G\u001b[K\r\u001b[6C\u001b[1Bpage.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 58s · done 12:04 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mhttps://demo.ddev.site/apple-tree gives me the same error page\u001b[39m                                          \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✽\u001b[3G\u001b[38;2;235;159;127mH\u001b[38;2;215;119;87monking… \r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Tip: Run /install-github-app to tag @claude in your GitHub issues and PRs\r\u001b[3B❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
