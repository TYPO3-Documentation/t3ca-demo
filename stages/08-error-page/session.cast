[112.625107, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m has \u001b[38;2;177;185;249mFE.cacheHash.enforceValidation = true\u001b[39m, so TYPO3 rejects\u001b[90Gany\u001b[94GURL\u001b[98Gthat\u001b[103Ghas\r\u001b[2C\u001b[1Ban unknown parameter but no \u001b[38;2;177;185;249mcHash\u001b[39m (a security checksum on URL parameters). It answ\u001b[86Grs those reques\u001b[102Gs\u001b[K\r\u001b[2C\u001b[1Bwith \"Page\u001b[14GNot Found\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mI\u001b[10Gadded\u001b[16G\u001b[38;2;177;185;249mq\u001b[18G\u001b[39mto\u001b[21Gthe\u001b[25Gparameters\u001b[36GTYPO3\u001b[42Gleaves\u001b[49Gout\u001b[53Gof\u001b[56Gthat\u001b[61Gcheck,\u001b[68Gin\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpackages/mtosafi_sitepackage/ext_localconf.php\u001b[39m. I\u001b[53Gappended it to\u001b[68Gthe\u001b[72Gexisting\u001b[81Glist\u001b[86Gso\u001b[89Gthe\u001b[93Gdefaults\u001b[102G(\u001b[38;2;177;185;249mL\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mutm_*\u001b[39m and so on) still apply. I put it in the sitepackag\u001b[60G because that's where the\u001b[87Gearch\u001b[93Gform \u001b[99Gives, so\r\u001b[2C\u001b[1Bthe setting g\u001b[17Ges\u001b[20Gwherever the\u001b[33Gsitepackage\u001b[45Gis ins\u001b[52Galled. The \u001b[64Ghange isn\u001b[74Gt\u001b[76Gcommit\u001b[83Ged\u001b[86Gy\u001b[88Gt.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill missing:\u001b[18G\u001b[22mThe\u001b[22GSearch\u001b[29Gpage\u001b[34G(uid\u001b[39G16)\u001b[43Ghas\u001b[47Gno\u001b[50Gcontent\u001b[58Gelements,\u001b[68Gand\u001b[72Gno\u001b[75Gsearch\u001b[82Gextension\u001b[92Gis\u001b[95Ginstalled.\r\u001b[2C\u001b[1BYou land on an\u001b[18Gempty page\u001b[29Gr\u001b[31Gther than seeing resul\u001b[54Gs. R\u001b[59Gal search \u001b[70Geeds\u001b[76Gomet\u001b[81Ging like \u001b[38;2;177;185;249mindexed_search\u001b[39m or\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mke_search\u001b[39m, and\u001b[18Gits results plugin \u001b[39Gs\u001b[41Gto be non-cacheable,\u001b[62Gb\u001b[64Gcause \u001b[38;2;177;185;249mq\u001b[39m i\u001b[75Gn\u001b[77Gw ignored when TYPO3 caches\u001b[105G\u001b[K\r\u001b[2C\u001b[1Bthe page.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 58s · done 12:04 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mhttps://demo.ddev.site/apple-tree gives me the same error page\u001b[39m                                          \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mListing\u001b[11Gpage\u001b[16Gtree\u001b[21Gand\u001b[25Gexisting\u001b[34G404\u001b[38Ghandling\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ ddev exec 'mysql -e \"select uid,pid,title,slug,doktype,nav_hide from pages where deleted=0 order by\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mpid,sorting\"'; grep -n -i 'errorHandling\u001b[47G|404\\|not found' -r \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mpackages/mtosafi_sit\u001b[27Gpackage/Initialisation Build \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mpackages/mtosafi_sitepackage/Resources/Pr\u001b[48Gvate/Language 2>/dev/null | head\r\u001b[20C\u001b[2B75\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
