[329.402027, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\u001b[3G├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[1B\u001b[K\u001b[3G│\u001b[22G│\u001b[24G✅\u001b[27Gwhile\u001b[35G│\u001b[38G \u001b[37G⚠️\r\u001b[40Gonly\u001b[45Gdetail\u001b[56G│\u001b[70G│\u001b[72G❌\u001b[75Gno\u001b[81G│\u001b[101G│\r\u001b[1B\u001b[K\u001b[3G│\u001b[5Gindexed_search\u001b[22G│\u001b[24Gpages\u001b[35G│\u001b[37Gpages\u001b[43Ga\u001b[45Gvisitor\u001b[53Gor\u001b[56G│\u001b[59G \u001b[58G⚠️\r\u001b[61Gexternal\u001b[70G│\u001b[72Greal\u001b[81G│\u001b[83GMedium\u001b[101G│\r\u001b[2C\u001b[1B│ (core)           │ render     │  crawler has       │  tools      │ facets   │                   │\r\u001b[36C\u001b[1Bopened\u001b[83G    \u001b[88G      \u001b[95G \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[82C\u001b[1BHigh (needs a    \r\u001b[4C\u001b[1BSolr\u001b[24G✅\u001b[37G✅\u001b[58G✅\u001b[72G✅\u001b[83GSolr server)\u001b[96G—\r\u001b[2C\u001b[1B│                  │            │                    │             │          │ too much for this │\r\u001b[4C\u001b[1B      \u001b[12G       \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83G site  \u001b[91G   \u001b[95G  \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[2C\u001b[1B│ Custom Extbase   │ ✅         │ ✅                 │ ❌          │ ✅       │ Medium, and no    │\r\u001b[2C\u001b[1B│\u001b[5GSQL\u001b[9G\u001b[38;2;177;185;249mLIKE\u001b[22G\u001b[39m│\u001b[35G│\u001b[56G│\u001b[70G│\u001b[81G│\u001b[83Granking\u001b[101G│\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[2B\u001b[1mWhy ke_s\u001b[12Garch\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt index\u001b[14Gs\u001b[16Gfrom\u001b[21Gthe databa\u001b[32Ge, not from rendered pages.\u001b[22m News records get indexed without a crawler,\u001b[104Gand\r\u001b[4C\u001b[1Bt\u001b[8G index do\u001b[18Gsn't\u001b[23Gdep\u001b[27Gnd on someon\u001b[40G opening a page first.\r\u001b[8C\u001b[1B\u001b[1mfilter\u001b[16Gmaps onto facets.\u001b[34G\u001b[22mGive each indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\u001b[K\r\u001b[4C\u001b[1Bcheckboxes b\u001b[18Gcome a ke_search filter of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[26G\u001b[22mYou\u001b[30Gcan\u001b[34Goverride\u001b[43Gthe\u001b[47Gtemplates\u001b[57Gin\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[4C\u001b[1Bfor\u001b[9GNews\u001b[14Gunder\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
