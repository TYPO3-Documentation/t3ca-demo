[1004.332941, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m4 \u001b[22m</f:comment>\r\u001b[6C\u001b[1B\u001b[2m5 \u001b[22m<f:render \u001b[38;2;166;226;46msection\u001b[39m=\u001b[38;2;230;219;116m\"content\"\u001b[39m />\u001b[K\r\u001b[6C\u001b[1B\u001b[2m6 \u001b[22m</html>\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=dnog6o;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Extensions/KeSearch/Templates/SearchForm.html\u0007Resources/Private/Extensions/KeSearch/Templates/SearchForm.html\u001b]8;;\u0007)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m28\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b]8;id=dnog6o;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Extensions/KeSearch/Templates/SearchForm.html\u0007\u001b[1mResources/Private/Extensions/KeSearch/Templates/SearchForm.html\u001b]8;;\u0007\r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m  1 \u001b[22m<html \u001b[38;2;166;226;46mxmlns:f\u001b[39m=\u001b[38;2;230;219;116m\"http://typo3.org/ns/TYPO3/CMS/Fluid/ViewHelpers\"\u001b[74G\u001b[38;2;166;226;46mdata-namespace-typo3-fluid\r\u001b[1B\u001b[39m     \u001b[2m    \u001b[22m=\u001b[38;2;230;219;116m\"true\"\u001b[39m>\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 2 \u001b[22m<f:comment>\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3 \u001b[22m    The\u001b[18Gsearch\u001b[25Gbox\u001b[29Gplugin,\u001b[37Gwhich\u001b[43Gon\u001b[46Gthis\u001b[51Gsite\u001b[56Grenders\u001b[64Gthe\u001b[68Gfilter\u001b[75Gbeside\u001b[82Gthe\u001b[86Gresults:\r\u001b[6C\u001b[1B\u001b[2m 4 \u001b[22m    th\u001b[17G search\u001b[25Gfield\u001b[31Gis\u001b[34Gthe\u001b[38Gone\u001b[42Gin\u001b[45Gthe\u001b[49Gpage\u001b[54Gheader.\u001b[62GThe\u001b[66Gsearch\u001b[73Gword\u001b[78Gtravels\u001b[86Galong\u001b[92Gas\r\u001b[6C\u001b[1B\u001b[2m 5 \u001b[13G\u001b[22m a \u001b[17Gidden field, so applying \u001b[43Ghe filter keeps\u001b[59Git.\u001b[63GA change of\u001b[75Gfilter\u001b[82Gstarts\u001b[89Gover\u001b[94Gon\r\u001b[6C\u001b[1B\u001b[2m 6 \u001b[22m    the first\u001b[24Gpage\u001b[29Gof\u001b[32Gresults.\r\u001b[6C\u001b[1B\u001b[2m 7 \u001b[22m</f:comment>\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 8 \u001b[22m<f:layout\u001b[20G\u001b[38;2;166;226;46mname\u001b[39m=\u001b[38;2;230;219;116m\"General\"\u001b[35G\u001b[39m/>\r\u001b[5C\u001b[1B\u001b[2m  9 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;153;153;153m… +19 lines \u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
