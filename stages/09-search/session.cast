[662.053952, "o", "\u001b[?25l\u001b[H\u001b[3G│ EXT:tika (text\u001b[20Gfrom\u001b[25GPDFs)\u001b[34G│\u001b[36G14.0\u001b[76G│\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GEXT:solrfa\u001b[16G (indexing files)\u001b[34G│ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m  \u001b[74G  │\u001b[K\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf\u001b[8Gthey're\u001b[16Gon\u001b[19GEXT:solr\u001b[28G13\u001b[31Gor\u001b[34Golder,\u001b[41Gtheir\u001b[47GSolr\u001b[52Gserver\u001b[59Gis\u001b[62Gmost\u001b[67Glikely\u001b[74G\u001b[1mversion 9\u001b[22m.\u001b[85GThat\u001b[90Gserver\u001b[97Gcan't\u001b[103Ghost\r\u001b[2C\u001b[1B  a core for this\u001b[21Gsite.\u001b[27GYou'd\u001b[33Gneed\u001b[38Ga\u001b[40GSolr\u001b[45G10\u001b[48Ginstance,\u001b[58Gor\u001b[61Gupgrade\u001b[69Gthe\u001b[73Gshared\u001b[80Gserver\u001b[87Galong\u001b[93Gwith\u001b[98Gall\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gother sites, which also means a\u001b[37Gschema\u001b[44Gupdate and a\u001b[57Gfull re-ind\u001b[69Gx.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they're already on TYPO3 14\u001b[36Gwith\u001b[41GEXT:solr\u001b[50G14,\u001b[54Gyou\u001b[58Gcan\u001b[62Gadd\u001b[66Ga\u001b[68Gcore\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou can ask the existing \u001b[32Grver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[2B\u001b[1mCorrection to my last answer:\u001b[22m I\u001b[35Gsaid Solr\u001b[45Gcovers PDFs\u001b[57Gt\u001b[59Groug\u001b[64G Tika. That's only half right.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but th\u001b[19Gextension\u001b[29Gthat\u001b[34Gputs\u001b[39Gfiles\u001b[45Gfrom\u001b[50Gfileadmin\u001b[60Ginto\u001b[65Gthe\u001b[69Gindex,\u001b[76G\u001b[1mEXT:solrfal\u001b[22m,\u001b[89Gis\u001b[92Ga\u001b[94Gpaid\r\u001b[2C\u001b[1Bfunding-contribution\u001b[24Gextension.\u001b[35GPages\u001b[41Gand\u001b[45Gnews\u001b[50Gare\u001b[54Gfree\u001b[59Gwith\u001b[64GSolr.\u001b[70GFor\u001b[74Gthe\u001b[78G\"Documents\"\u001b[90Gresults\u001b[98Gin\u001b[101Gthe\r\u001b[1B \u001b[3Gdesign you'd need solrfal, unless\u001b[37Gyour\u001b[42Gother\u001b[48Gsites\u001b[54Galready\u001b[62Ghave\u001b[67Ga\u001b[69Gfunding\u001b[77Gpartnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree\u001b[8Gke_search\u001b[18Gdoes\u001b[23Gindex\u001b[29GPDFs.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\r\u001b[1B \u001b[3G- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[1B  - \u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m-\u001b[5G\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007\u001b[94mEXT:solr 14.0.2 release\u001b]8;;\u0007\r\u001b[1B\u001b[39m \u001b[3G- \u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007\u001b[94mEXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
