[2522.277815, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\"new\" finds nothing bec\u001b[27Guse\u001b[31Gof how\u001b[38GMySQL/MariaDB's full-text search is set up, not\u001b[86Gbecause of ke_search\r\u001b[2C\u001b[1Bor our temp\u001b[15Gates. ke_s\u001b[26Garch stores its index in a\u001b[53GMyISAM table\u001b[66G(\u001b[38;2;177;185;249mENGINE = MyISAM\u001b[83G\u001b[39min\u001b[86Gits\u001b[90G\u001b[38;2;177;185;249mext_tables.sql\u001b[39m).\r\u001b[2C\u001b[1BMyISAM's\u001b[12Gfull-text\u001b[22Gindex\u001b[28Gleaves\u001b[35Gout\u001b[39G\"new\"\u001b[45Gfor\u001b[49Gtwo\u001b[53Greasons:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWord length.\u001b[22m \u001b[38;2;177;185;249mft_min_word_len\u001b[39m is \u001b[1m4\u001b[22m on this server, so words of 1 to 3 letters never\u001b[89Ggo into the\u001b[K\r\u001b[5C\u001b[1Bfull-text index. Lowering \u001b[38;2;177;185;249msearchWordLength\u001b[39m to 3\u001b[54Gin ke_search only stopped\u001b[80Gthe\u001b[84G\"too\u001b[89Gshort\"\u001b[96Gmessage;\r\u001b[2C\u001b[1B  \u001b[6Gthe database still drops those words.\u001b[44G\"tax\" and \"fee\" fail\u001b[65Gthe same way.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mStopwords.\u001b[22m MyISAM's\u001b[26Gbuilt-in s\u001b[37Gopword list includes \u001b[1m\"new\"\u001b[22m, so it would be ignored even wi\u001b[96Gh a \u001b[101Gower\r\u001b[5C\u001b[1Bminimum \u001b[16Gngth.\u001b[22GThe\u001b[26GInnoDB\u001b[33Gsettings\u001b[42Gyou\u001b[46Gmay\u001b[50Ghave\u001b[55Gseen\u001b[60G(\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m)\u001b[91Gdon't\u001b[97Gapply\u001b[103Gto\r\u001b[5C\u001b[1Bthis\u001b[11Gtable.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat I checked: \u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[39m returns 0 rows, whil\u001b[68G a plain \u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries.\u001b[12GThe\u001b[16Gwords\u001b[22Gare\u001b[26Gin\u001b[29Gthe\u001b[33Gindex\u001b[39Gtable,\u001b[46Gbut\u001b[50Gthe\u001b[54Gfull-text\u001b[64Gindex\u001b[70Gskips\u001b[76Gthem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\r\u001b[2C\u001b[1B\u001b[39m[mysqld]\u001b[K\r\u001b[5C\u001b[1B\u001b[36mmin_\u001b[15Glen\u001b[39m = \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[20G\u001b[39m=\u001b[22G\u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen \u001b[38;2;177;185;249mddev restart\u001b[39m, followed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[2522.309739, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\"new\" finds nothing bec\u001b[27Guse\u001b[31Gof how\u001b[38GMySQL/MariaDB's full-text search is set up, not\u001b[86Gbecause of ke_search\r\u001b[2C\u001b[1Bor our temp\u001b[15Gates. ke_s\u001b[26Garch stores its index in a\u001b[53GMyISAM table\u001b[66G(\u001b[38;2;177;185;249mENGINE = MyISAM\u001b[83G\u001b[39min\u001b[86Gits\u001b[90G\u001b[38;2;177;185;249mext_tables.sql\u001b[39m).\r\u001b[2C\u001b[1BMyISAM's\u001b[12Gfull-text\u001b[22Gindex\u001b[28Gleaves\u001b[35Gout\u001b[39G\"new\"\u001b[45Gfor\u001b[49Gtwo\u001b[53Greasons:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWord length.\u001b[22m \u001b[38;2;177;185;249mft_min_word_len\u001b[39m is \u001b[1m4\u001b[22m on this server, so words of 1 to 3 letters never\u001b[89Ggo into the\u001b[K\r\u001b[5C\u001b[1Bfull-text index. Lowering \u001b[38;2;177;185;249msearchWordLength\u001b[39m to 3\u001b[54Gin ke_search only stopped\u001b[80Gthe\u001b[84G\"too\u001b[89Gshort\"\u001b[96Gmessage;\r\u001b[2C\u001b[1B  \u001b[6Gthe database still drops those words.\u001b[44G\"tax\" and \"fee\" fail\u001b[65Gthe same way.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mStopwords.\u001b[22m MyISAM's\u001b[26Gbuilt-in s\u001b[37Gopword list includes \u001b[1m\"new\"\u001b[22m, so it would be ignored even wi\u001b[96Gh a \u001b[101Gower\r\u001b[5C\u001b[1Bminimum \u001b[16Gngth.\u001b[22GThe\u001b[26GInnoDB\u001b[33Gsettings\u001b[42Gyou\u001b[46Gmay\u001b[50Ghave\u001b[55Gseen\u001b[60G(\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m)\u001b[91Gdon't\u001b[97Gapply\u001b[103Gto\r\u001b[5C\u001b[1Bthis\u001b[11Gtable.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat I checked: \u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[39m returns 0 rows, whil\u001b[68G a plain \u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries.\u001b[12GThe\u001b[16Gwords\u001b[22Gare\u001b[26Gin\u001b[29Gthe\u001b[33Gindex\u001b[39Gtable,\u001b[46Gbut\u001b[50Gthe\u001b[54Gfull-text\u001b[64Gindex\u001b[70Gskips\u001b[76Gthem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\r\u001b[2C\u001b[1B\u001b[39m[mysqld]\u001b[K\r\u001b[5C\u001b[1B\u001b[36mmin_\u001b[15Glen\u001b[39m = \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[20G\u001b[39m=\u001b[22G\u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen \u001b[38;2;177;185;249mddev restart\u001b[39m, followed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR\u001b[69GK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[2522.691179, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhy does \"new\" not find anything?\u001b[39m                                                                       \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\"new\" finds nothing bec\u001b[27Guse\u001b[31Gof how\u001b[38GMySQL/MariaDB's full-text search is set up, not\u001b[86Gbecause of ke_search\r\u001b[2C\u001b[1Bor our temp\u001b[15Gates. ke_s\u001b[26Garch stores its index in a\u001b[53GMyISAM table\u001b[66G(\u001b[38;2;177;185;249mENGINE = MyISAM\u001b[83G\u001b[39min\u001b[86Gits\u001b[90G\u001b[38;2;177;185;249mext_tables.sql\u001b[39m).\r\u001b[2C\u001b[1BMyISAM's\u001b[12Gfull-text\u001b[22Gindex\u001b[28Gleaves\u001b[35Gout\u001b[39G\"new\"\u001b[45Gfor\u001b[49Gtwo\u001b[53Greasons:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWord length.\u001b[22m \u001b[38;2;177;185;249mft_min_word_len\u001b[39m is \u001b[1m4\u001b[22m on this server, so words of 1 to 3 letters never\u001b[89Ggo into the\u001b[K\r\u001b[5C\u001b[1Bfull-text index. Lowering \u001b[38;2;177;185;249msearchWordLength\u001b[39m to 3\u001b[54Gin ke_search only stopped\u001b[80Gthe\u001b[84G\"too\u001b[89Gshort\"\u001b[96Gmessage;\r\u001b[2C\u001b[1B  \u001b[6Gthe database still drops those words.\u001b[44G\"tax\" and \"fee\" fail\u001b[65Gthe same way.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mStopwords.\u001b[22m MyISAM's\u001b[26Gbuilt-in s\u001b[37Gopword list includes \u001b[1m\"new\"\u001b[22m, so it would be ignored even wi\u001b[96Gh a \u001b[101Gower\r\u001b[5C\u001b[1Bminimum \u001b[16Gngth.\u001b[22GThe\u001b[26GInnoDB\u001b[33Gsettings\u001b[42Gyou\u001b[46Gmay\u001b[50Ghave\u001b[55Gseen\u001b[60G(\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m)\u001b[91Gdon't\u001b[97Gapply\u001b[103Gto\r\u001b[5C\u001b[1Bthis\u001b[11Gtable.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat I checked: \u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[39m returns 0 rows, whil\u001b[68G a plain \u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries.\u001b[12GThe\u001b[16Gwords\u001b[22Gare\u001b[26Gin\u001b[29Gthe\u001b[33Gindex\u001b[39Gtable,\u001b[46Gbut\u001b[50Gthe\u001b[54Gfull-text\u001b[64Gindex\u001b[70Gskips\u001b[76Gthem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\r\u001b[2C\u001b[1B\u001b[39m[mysqld]\u001b[K\r\u001b[5C\u001b[1B\u001b[36mmin_\u001b[15Glen\u001b[39m = \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[20G\u001b[39m=\u001b[22G\u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m    \u001b[8G             \u001b[22G        \u001b[31G  \u001b[34G      \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
