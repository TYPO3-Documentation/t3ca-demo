001b[6Gswitching becomes a one-line change. The cHash exclusion in \u001b[38;2;177;185;249mext_localconf.php\u001b[39m has to follow i\u001b[100G too.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mWrite the result markup as partials of our own\u001b[22m:\u001b[54Gthe resul\u001b[64G item, the\u001b[75Gbadge and the filter list. These\r\u001b[5C\u001b[1Bare the \u001b[38;2;177;185;249mol.search-results\u001b[33G.badge\u001b[40G\u001b[39mand \u001b[38;2;177;185;249mdata-type\u001b[39m parts of the de\u001b[70Gign. Keep the ke_search template\u001b[104G\u001b[K\r\u001b[5C\u001b[1Bthin\u001b[11Gwrappers\u001b[20Garound\u001b[27Gthem,\u001b[33Gso\u001b[36Gthe\u001b[40GSolr\u001b[45Gtemplates\u001b[55Gcan\u001b[59Greuse\u001b[65Gthe\u001b[69Gsame\u001b[74Gpartials\u001b[83Gand\u001b[87Gthe\u001b[91GCSS\u001b[95Gstays\u001b[101Gas\u001b[104Git\r\u001b[2C\u001b[1B  \u001b[6Gis.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mUse the same type keys everywhere.\u001b[22m Name the k\u001b[52G_search\u001b[60Gtags \u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m and \u001b[38;2;177;185;249mdocument\u001b[39m,\u001b[93Gand\u001b[97Guse\u001b[101Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame values for the Solr facet later. Then the\u001b[53Gbadges and filters don't ch\u001b[82Gge.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mUse free ke_search features only.\u001b[40G\u001b[22mNothing\u001b[48Gfrom\u001b[53Gpremium,\u001b[62Gso\u001b[65Gyou\u001b[69Gdon't\u001b[75Gmiss\u001b[80Ganything\u001b[89Gafter\u001b[95Gthe\u001b[99Gswitch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets thrown away when you switch\u001b[22m\u001b[K\r\u001b[8C\u001b[1Bindexe\u001b[16G and filt\u001b[28Gr\u001b[30Gcor\u001b[34Gs, both in t\u001b[48G database and in \u001b[38;2;177;185;249mInitialisa\u001b[76Gion/data.xml\u001b[39m.\u001b[K\r\u001b[4C\u001b[1BThe ke_search composer depend\u001b[35Gncy, the scheduler task and the \u001b[38;2;177;185;249mpdftotext\u001b[39m package in\u001b[88GDDEV.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GO\u001b[7G existing installations,\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mtx_k\u001b[70G\u001b[39mwith\u001b[75Gthe\u001b[79Gdatabase\u001b[88Ganalyzer\u001b[97Gafter\u001b[31;1H\u001b[29;3H\u001b[?25h"]
