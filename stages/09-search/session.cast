[638.052896, "o", "\u001b[?25l\u001b[H\u001b[5GThis site needs its own Solr core on your Solr server, plus Tika if you want PDF text.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLocal development\u001b[23Gneeds\u001b[29GSolr\u001b[34Gin\u001b[37GDDEV,\u001b[43Gfor\u001b[47Gexample\u001b[55Gthe\u001b[59G\u001b[38;2;177;185;249mddev/ddev-solr\u001b[74G\u001b[39madd-on\u001b[81Gwith\u001b[86Gthe\u001b[90Gconfigsets\u001b[101Gfrom\r\u001b[4C\u001b[1BEXT:solr.\r\u001b[2C\u001b[1B- Setup is heavier\u001b[22Gthan\u001b[27Gke_search:\u001b[38Gconnection\u001b[49Gsettings\u001b[58Gper\u001b[62Gsite,\u001b[68Gan\u001b[71Gindex\u001b[77Gqueue,\u001b[84Gand\u001b[88Gscheduler\u001b[98Gtasks.\u001b[105GA\r\u001b[2C\u001b[1B \u001b[5Gfre\u001b[9Gh \u001b[12Gnstall from the dist\u001b[33Gibution also only gets working search if Solr is\u001b[82Greachable.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to decide:\r\u001b[4C\u001b[1BUse Solr\u001b[14G\u001b[22mif this\u001b[22Gsite\u001b[27Ggoe\u001b[31G live on th\u001b[43G same\u001b[49Ghos\u001b[56G as your other\u001b[71Gsit\u001b[75Gs, or if\u001b[84Gsearch should\u001b[98Gbehave\u001b[105G\u001b[K\r\u001b[4C\u001b[1Bth\u001b[8G same across all of\u001b[28Gthem.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUse ke_search\u001b[19G\u001b[22mif\u001b[22Gthis\u001b[27Gis\u001b[30Ga\u001b[32Gstandalone\u001b[43Gdemo,\u001b[49Gfor\u001b[53Gexample\u001b[61Ga\u001b[63Gconference\u001b[74Gdemo\u001b[79Gthat\u001b[84Ghas\u001b[88Gto\u001b[91Gcome\u001b[96Gup\u001b[99Gwith\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mddev start\u001b[39m and\u001b[20Gnothing\u001b[28Gelse.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCan you confi\u001b[17Gm the other sites\u001b[35Guse\u001b[39GSolr,\u001b[45Gand\u001b[49Gtell\u001b[54Gme\u001b[57Gwhat\u001b[62Gthis\u001b[67Gsite\u001b[72Gis\u001b[75Gfor?\u001b[80GThen\u001b[85GI'll\u001b[90Gplan\u001b[95Gthe\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m09-search\u001b[39m stage\u001b[19Gthe r\u0