[1322.037438, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat I changed\u001b[19G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDependency:\u001b[17G\u001b[22m\u001b[38;2;177;185;249mtpwd/ke_search\u001b[39m ^7.5 is required by the project and the s\u001b[74Gtepackage, and\u001b[89Gadded\u001b[95Gto\u001b[98Gthe\u001b[102Gsite\r\u001b[4C\u001b[1Bset.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHeader search form unchanged:\u001b[22m I \u001b[38Ge\u001b[40G ke_search to read\u001b[59Gthe\u001b[63Gsearch\u001b[70Gword\u001b[75Gfrom\u001b[80G\u001b[38;2;177;185;249mq\u001b[39m,\u001b[83Gso\u001b[86Gthe\u001b[90Gform\u001b[95Gstill\u001b[101Gsends\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mq\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSearch page (16):\u001b[22m the result list is in the main area. The sidebar holds the search-box plugin,\u001b[101Gwhich\r\u001b[4C\u001b[1Bhere shows\u001b[16Gonly the \"Show only\" filter, because\u001b[53Gthe\u001b[57Gsearch\u001b[64Gfield\u001b[70Gis\u001b[73Gthe\u001b[77Gone\u001b[81Gin\u001b[84Gthe\u001b[88Gheader.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTemplates:\u001b[16G\u001b[22moverr\u001b[22Gdes in \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[39m produce the d\u001b[82Gsign's m\u001b[91Grkup\u001b[96Gand\u001b[100Guse\u001b[104Gthe\r\u001b[4C\u001b[1BCSS you\u001b[13Galready h\u001b[25G. Each result goes through\u001b[52G\u001b[38;2;177;185;249mExtensions/Search/Partials/Search/Result.html\u001b[39m,\u001b[99Gwhich\r\u001b[4C\u001b[1Bhas nothing\u001b[17Gke_search-specific\u001b[36Gin\u001b[39Git,\u001b[43Gso\u001b[46GSolr\u001b[51Gcan\u001b[55Greuse\u001b[61Git\u001b[64Glater.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo small PHP classes:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mTagIndexEntryWithResultType\u001b[39m tags each index entry wi\u001b[60Gh its type (\u001b[38;2;177;185;249mservice\u001b[39m or \u001b[38;2;177;185;249mnews\u001b[39m).\u001b[90GI\u001b[92Gdid\u001b[96Git\u001b[99Gin\u001b[102Gcode\r\u001b[5C\u001b[1B because ke_search's\u001b[27Gown indexer setting points at the filt\u001b[66Gr option by recor\u001b[84G ID, and\u001b[93Gthe\r\u001b[5C\u001b[1B fresh-install test showed those IDs change on import.\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[33G\u001b[39mpasses\u001b[40Gthe\u001b[44Gsearch\u001b[51Gword\u001b[56Gto\u001b[59Gthe\u001b[63Gresult\u001b[70Glist,\u001b[76Gwhich\u001b[82Gke_search\u001b[92Gonly\u001b[97Ggives\u001b[103Gto\r\u001b[1B      the search box. That's\u001b[30Gwhat\u001b[35Gmakes\u001b[41G\"3\u001b[44Gresults\u001b[52Gfor\u001b[56G“water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mBuild/Initialisation/seed-search.php\u001b[59G\u001b[39mcreates\u001b[67Gthe\u001b[71G\"Search\u001b[79Gindex\"\u001b[86Gfolder,\u001b[94Gthe\u001b[98Gfilter,\r\u001b[1B \u001b[3G  two indexers a\u001b[20Gd both plugins. I r\u001b[40G-exported \u001b[38;2;177;185;249mdata.xml\u001b[59G\u001b[39mwith\u001b[64Gthe\u001b[68Gthree\u001b[74Gke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[4C\u001b[1Bupdated\u001b[13Gthe\u001b[17GREADME.\r\u001b[1B \u001b[3G- \u001b[1mMinimum word length:\u001b[22m lowered\u001b[34Gfrom\u001b[39G4\u001b[41Gto\u001b[44G3\u001b[46Gin\u001b[49G\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m,\u001b[77Gso\u001b[80Gwords\u001b[86Glike\u001b[91G\"tax\"\u001b[97Gand\u001b[101G\"fee\"\r\u001b[1B    can be searched.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[1B \u001b[3G  filter.\u001b[K\r\u001b[1B  -\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1322.321358, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mDependency:\u001b[22m \u001b[38;2;177;185;249mtpwd/ke_search\u001b[32G\u001b[39m^7.5\u001b[37Gis\u001b[40Grequired\u001b[49Gby\u001b[52Gthe\u001b[56Gproject\u001b[64Gand\u001b[68Gthe\u001b[72Gsitepackage,\u001b[85Gand\u001b[89Gadded\u001b[95Gto\u001b[98Gthe\u001b[102Gsite\r\u001b[2C\u001b[1B \u001b[5Gset.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHeader search form unchanged:\u001b[35G\u001b[22mI\u001b[37Gset\u001b[41Gke_search\u001b[51Gto\u001b[54Gread\u001b[59Gthe\u001b[63Gsearch\u001b[70Gword\u001b[75Gfrom\u001b[80G\u001b[38;2;177;185;249mq\u001b[39m,\u001b[83Gso\u001b[86Gthe\u001b[90Gform\u001b[95Gstill\u001b[101Gsends\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSearch page (16):\u001b[23G\u001b[22mthe\u001b[27Gresult\u001b[34Glist\u001b[39Gis\u001b[42Gin\u001b[45Gthe\u001b[49Gmain\u001b[54Garea.\u001b[60GThe\u001b[64Gsidebar\u001b[72Gholds\u001b[78Gthe\u001b[82Gsearch-box\u001b[93Gplugin,\u001b[101Gwhich\r\u001b[2C\u001b[1B \u001b[5Ghere shows only the \"Show only\" filter,\u001b[45Gbecause the search\u001b[64Gf\u001b[66Geld is the one in the header.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTemplates:\u001b[17G\u001b[22mverrid\u001b[24Gs in \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[39m produce the design's m\u001b[91Grkup\u001b[96Gand\u001b[100Guse\u001b[104Gthe\r\u001b[2C\u001b[1B \u001b[5GCSS you already have. Each result goes through \u001b[38;2;177;185;249mExtensions/Search/Partials/Search/Result.html\u001b[39m, which\u001b[K\r\u001b[4C\u001b[1Bhas\u001b[9Gn\u001b[11Gthing ke_se\u001b[23Grch-specific in\u001b[39Git, so S\u001b[48Glr can reuse it later.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo small PHP classes:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mTagIndexEntryWithResultType\u001b[35G\u001b[39mtags\u001b[40Geach\u001b[45Gindex\u001b[51Gentry\u001b[57Gwith\u001b[62Gits\u001b[66Gtype\u001b[71G(\u001b[38;2;177;185;249mservice\u001b[80G\u001b[39mor\u001b[83G\u001b[38;2;177;185;249mnews\u001b[39m).\u001b[90GI\u001b[92Gdid\u001b[96Git\u001b[99Gin\u001b[102Gcode\r\u001b[4C\u001b[1B \u001b[7Gbecause ke_search's own indexer s\u001b[41Gtting points at\u001b[57Gthe f\u001b[63Glter option by record ID, and the\u001b[K\r\u001b[6C\u001b[1Bfresh-install test showed those\u001b[39GIDs change on import.\u001b[61G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[33G\u001b[39mpas\u001b[38Gs the search word to the\u001b[63Gresult\u001b[70Glist,\u001b[76Gwhich\u001b[82Gke_search\u001b[92Gonly\u001b[97Ggives\u001b[103Gto\r\u001b[4C\u001b[1B \u001b[7Gthe search box. That's what makes \"3\u001b[44Gr\u001b[46Gsults for\u001b[56G“wa\u001b[60Ger”\" possible.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Initialisation/seed-search.php\u001b[39m creates the \"Search\u001b[79Gindex\"\u001b[86Gfolder,\u001b[94Gthe\u001b[98Gfilter,\r\u001b[2C\u001b[1B \u001b[5Gtwo indexers and\u001b[22Gboth plugins. I re-exported \u001b[38;2;177;185;249mdata\u001b[55Gxml\u001b[59G\u001b[39mwith the three ke_search tables added,\u001b[98Gand\u001b[K\r\u001b[4C\u001b[1Bupdate\u001b[12G the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[26G\u001b[22mlowered\u001b[34Gfrom\u001b[39G4\u001b[41Gto\u001b[44G3\u001b[46Gin\u001b[49G\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m,\u001b[77Gso\u001b[80Gwords\u001b[86Glike\u001b[91G\"tax\"\u001b[97Gand\u001b[101G\"fee\"\r\u001b[2C\u001b[1B \u001b[5Gcan be searched.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\r\u001b[2C\u001b[1B\u001b[22m- On this installation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B \u001b[5Gfil\u001b[9Ger.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI also checked\u001b[20Gthat\u001b[25Ga\u001b[27Gsearch\u001b[34Gword\u001b[39Gcontaining\u001b[50GHTML\u001b[55Gis\u001b[58Gescaped.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1322.619822, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25BOn\u001b[8Gan\u001b[11Gempty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1322.873649, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mH\u001b[7Gader search form unchanged:\u001b[22m I\u001b[37Gset ke_search to read the search word from \u001b[38;2;177;185;249mq\u001b[39m, so the form\u001b[95Gstill sends\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mq\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mS\u001b[8Grch\u001b[12Gpage (16):\u001b[22m the result list is in the main\u001b[54Garea. The sidebar holds the searc\u001b[88G-box plug\u001b[98Gn,\u001b[101Gwhich\r\u001b[4C\u001b[1Bhere\u001b[10Gshows\u001b[16Gonly\u001b[21Gthe\u001b[25G\"Show\u001b[31Gonly\"\u001b[37Gfilter,\u001b[45Gbecause\u001b[53Gthe\u001b[57Gsearch\u001b[64Gfield\u001b[70Gis\u001b[73Gthe\u001b[77Gone\u001b[81Gin\u001b[84Gthe\u001b[88Gheader.\r\u001b[4C\u001b[1B\u001b[1mT\u001b[7Gmplates:\u001b[22m overrides in \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[39m produce the de\u001b[83Gign's markup and use t\u001b[106Ge\r\u001b[4C\u001b[1BCSS you alread\u001b[21Ghave. Each result go\u001b[42Gs through \u001b[38;2;177;185;249mExtensions/Search/Partials/Search/Result.html\u001b[39m,\u001b[99Gwhich\r\u001b[2C\u001b[1B \u001b[5Ghas nothing k\u001b[19G_search-specific in it, so Solr can reuse it later.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo small PHP classes:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mTagIndexEntryWithResultType\u001b[39m tags each index\u001b[51Gentry with its \u001b[67Gype\u001b[71G(\u001b[38;2;177;185;249mservice\u001b[80G\u001b[39mor\u001b[83G\u001b[38;2;177;185;249mnews\u001b[39m).\u001b[90GI\u001b[92Gdid\u001b[96Git\u001b[99Gin\u001b[102Gcode\r\u001b[2C\u001b[1B \u001b[5G  because ke_search's own\u001b[31Gindexer\u001b[39Gsetting\u001b[47Gpoints\u001b[54Gat\u001b[57Gthe\u001b[61Gfilter\u001b[68Goption\u001b[75Gby\u001b[78Grecord\u001b[85GID,\u001b[89Gand\u001b[93Gthe\r\u001b[4C\u001b[1B \u001b[7Gfresh-install test showed those IDs cha\u001b[47Gg\u001b[49G on import.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[39m passes the search word to the result l\u001b[72Gst, which ke_search only\u001b[97Ggives\u001b[103Gto\r\u001b[6C\u001b[1Bth\u001b[10G search box. That's wha\u001b[34G makes \"3 results for “water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Ini\u001b[32Gialisation/seed-search.php\u001b[59G\u001b[39mcr\u001b[62Gat\u001b[66G the \"Searc\u001b[78G index\" folder, the filter,\r\u001b[4C\u001b[1Btwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1323.122744, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mS\u001b[8Grch\u001b[12Gpage (16):\u001b[22m the result list is in the main\u001b[54Garea. The sidebar holds the searc\u001b[88G-box plug\u001b[98Gn,\u001b[101Gwhich\r\u001b[4C\u001b[1Bhere\u001b[10Gshows\u001b[16Gonly\u001b[21Gthe\u001b[25G\"Show\u001b[31Gonly\"\u001b[37Gfilter,\u001b[45Gbecause\u001b[53Gthe\u001b[57Gsearch\u001b[64Gfield\u001b[70Gis\u001b[73Gthe\u001b[77Gone\u001b[81Gin\u001b[84Gthe\u001b[88Gheader.\r\u001b[4C\u001b[1B\u001b[1mT\u001b[7Gmplates:\u001b[22m overrides in \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[39m produce the de\u001b[83Gign's markup and use t\u001b[106Ge\r\u001b[4C\u001b[1BCSS you alread\u001b[21Ghave. Each result go\u001b[42Gs through \u001b[38;2;177;185;249mExtensions/Search/Partials/Search/Result.html\u001b[39m,\u001b[99Gwhich\r\u001b[2C\u001b[1B \u001b[5Ghas nothing k\u001b[19G_search-specific in it, so Solr can reuse it later.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo small PHP classes:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mTagIndexEntryWithResultType\u001b[39m tags each index\u001b[51Gentry with its \u001b[67Gype\u001b[71G(\u001b[38;2;177;185;249mservice\u001b[80G\u001b[39mor\u001b[83G\u001b[38;2;177;185;249mnews\u001b[39m).\u001b[90GI\u001b[92Gdid\u001b[96Git\u001b[99Gin\u001b[102Gcode\r\u001b[2C\u001b[1B \u001b[5G  because ke_search's own\u001b[31Gindexer\u001b[39Gsetting\u001b[47Gpoints\u001b[54Gat\u001b[57Gthe\u001b[61Gfilter\u001b[68Goption\u001b[75Gby\u001b[78Grecord\u001b[85GID,\u001b[89Gand\u001b[93Gthe\r\u001b[4C\u001b[1B \u001b[7Gfresh-install test showed those IDs cha\u001b[47Gg\u001b[49G on import.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[39m passes the search word to the result l\u001b[72Gst, which ke_search only\u001b[97Ggives\u001b[103Gto\r\u001b[6C\u001b[1Bth\u001b[10G search box. That's wha\u001b[34G makes \"3 results for “water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Ini\u001b[32Gialisation/seed-search.php\u001b[59G\u001b[39mcr\u001b[62Gat\u001b[66G the \"Searc\u001b[78G index\" folder, the filter,\r\u001b[4C\u001b[1Btwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I put your database snapshot and config\u001b[56Gback. I also\u001b[69Gdelet\u001b[75Gd a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[39m that the\u001b[K\r\u001b[5C\u001b[1Best setup\u001b[16Gha\u001b[20Gwri\u001b[24Gten.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1323.274944, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mT\u001b[7Gmplates:\u001b[22m overrides in \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[39m produce the de\u001b[83Gign's markup and use t\u001b[106Ge\r\u001b[4C\u001b[1BCSS you alread\u001b[21Ghave. Each result go\u001b[42Gs through \u001b[38;2;177;185;249mExtensions/Search/Partials/Search/Result.html\u001b[39m,\u001b[99Gwhich\r\u001b[2C\u001b[1B \u001b[5Ghas nothing k\u001b[19G_search-specific in it, so Solr can reuse it later.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo small PHP classes:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mTagIndexEntryWithResultType\u001b[39m tags each index\u001b[51Gentry with its \u001b[67Gype\u001b[71G(\u001b[38;2;177;185;249mservice\u001b[80G\u001b[39mor\u001b[83G\u001b[38;2;177;185;249mnews\u001b[39m).\u001b[90GI\u001b[92Gdid\u001b[96Git\u001b[99Gin\u001b[102Gcode\r\u001b[2C\u001b[1B \u001b[5G  because ke_search's own\u001b[31Gindexer\u001b[39Gsetting\u001b[47Gpoints\u001b[54Gat\u001b[57Gthe\u001b[61Gfilter\u001b[68Goption\u001b[75Gby\u001b[78Grecord\u001b[85GID,\u001b[89Gand\u001b[93Gthe\r\u001b[4C\u001b[1B \u001b[7Gfresh-install test showed those IDs cha\u001b[47Gg\u001b[49G on import.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[39m passes the search word to the result l\u001b[72Gst, which ke_search only\u001b[97Ggives\u001b[103Gto\r\u001b[6C\u001b[1Bth\u001b[10G search box. That's wha\u001b[34G makes \"3 results for “water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Ini\u001b[32Gialisation/seed-search.php\u001b[59G\u001b[39mcr\u001b[62Gat\u001b[66G the \"Searc\u001b[78G index\" folder, the filter,\r\u001b[4C\u001b[1Btwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I put your database snapshot and config\u001b[56Gback. I also\u001b[69Gdelet\u001b[75Gd a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[39m that the\u001b[K\r\u001b[5C\u001b[1Best setup\u001b[16Gha\u001b[20Gwri\u001b[24Gten.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1323.572586, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mOnly news shows up for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1323.722395, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Ghas nothing k\u001b[19G_search-specific in it, so Solr can reuse it later.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo small PHP classes:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mTagIndexEntryWithResultType\u001b[39m tags each index\u001b[51Gentry with its \u001b[67Gype\u001b[71G(\u001b[38;2;177;185;249mservice\u001b[80G\u001b[39mor\u001b[83G\u001b[38;2;177;185;249mnews\u001b[39m).\u001b[90GI\u001b[92Gdid\u001b[96Git\u001b[99Gin\u001b[102Gcode\r\u001b[2C\u001b[1B \u001b[5G  because ke_search's own\u001b[31Gindexer\u001b[39Gsetting\u001b[47Gpoints\u001b[54Gat\u001b[57Gthe\u001b[61Gfilter\u001b[68Goption\u001b[75Gby\u001b[78Grecord\u001b[85GID,\u001b[89Gand\u001b[93Gthe\r\u001b[4C\u001b[1B \u001b[7Gfresh-install test showed those IDs cha\u001b[47Gg\u001b[49G on import.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[39m passes the search word to the result l\u001b[72Gst, which ke_search only\u001b[97Ggives\u001b[103Gto\r\u001b[6C\u001b[1Bth\u001b[10G search box. That's wha\u001b[34G makes \"3 results for “water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Ini\u001b[32Gialisation/seed-search.php\u001b[59G\u001b[39mcr\u001b[62Gat\u001b[66G the \"Searc\u001b[78G index\" folder, the filter,\r\u001b[4C\u001b[1Btwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I put your database snapshot and config\u001b[56Gback. I also\u001b[69Gdelet\u001b[75Gd a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[39m that the\u001b[K\r\u001b[5C\u001b[1Best setup\u001b[16Gha\u001b[20Gwri\u001b[24Gten.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly news shows up for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[2C\u001b[1B  pages are still empty.\u001b[28GThey'll\u001b[36Gappear\u001b[43Gonce\u001b[48Gthey\u001b[53Ghave\u001b[58Gtext.\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1324.020242, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mNothing builds the index automatically.\u001b[45G\u001b[22mRun\u001b[49G\u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[84G\u001b[39mafter\u001b[90Gsetup\u001b[96Gand\u001b[100Gafter\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1324.273429, "o", "\u001b[?25l\u001b[H\u001b[5G- \u001b[38;2;177;185;249mTagIndexEntryWithResultType\u001b[39m tags each index\u001b[51Gentry with its \u001b[67Gype\u001b[71G(\u001b[38;2;177;185;249mservice\u001b[80G\u001b[39mor\u001b[83G\u001b[38;2;177;185;249mnews\u001b[39m).\u001b[90GI\u001b[92Gdid\u001b[96Git\u001b[99Gin\u001b[102Gcode\r\u001b[2C\u001b[1B \u001b[5G  because ke_search's own\u001b[31Gindexer\u001b[39Gsetting\u001b[47Gpoints\u001b[54Gat\u001b[57Gthe\u001b[61Gfilter\u001b[68Goption\u001b[75Gby\u001b[78Grecord\u001b[85GID,\u001b[89Gand\u001b[93Gthe\r\u001b[4C\u001b[1B \u001b[7Gfresh-install test showed those IDs cha\u001b[47Gg\u001b[49G on import.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[39m passes the search word to the result l\u001b[72Gst, which ke_search only\u001b[97Ggives\u001b[103Gto\r\u001b[6C\u001b[1Bth\u001b[10G search box. That's wha\u001b[34G makes \"3 results for “water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Ini\u001b[32Gialisation/seed-search.php\u001b[59G\u001b[39mcr\u001b[62Gat\u001b[66G the \"Searc\u001b[78G index\" folder, the filter,\r\u001b[4C\u001b[1Btwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I put your database snapshot and config\u001b[56Gback. I also\u001b[69Gdelet\u001b[75Gd a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[39m that the\u001b[K\r\u001b[5C\u001b[1Best setup\u001b[16Gha\u001b[20Gwri\u001b[24Gten.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly news shows up for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[2C\u001b[1B  pages are still empty.\u001b[28GThey'll\u001b[36Gappear\u001b[43Gonce\u001b[48Gthey\u001b[53Ghave\u001b[58Gtext.\r\u001b[4C\u001b[1B\u001b[1mNothi\u001b[11Gg builds the\u001b[24Gindex automatically.\u001b[22m Run\u001b[49G\u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[39m after setup and after\r\u001b[4C\u001b[1Bcontent changes. There's no schedule\u001b[43Gext\u001b[47Gnsion\u001b[53Ginstalled,\u001b[64Gso\u001b[67Ga\u001b[69Glive\u001b[74Gsite\u001b[79Gwould\u001b[85Gneed\u001b[90Ga\u001b[92Gcron\u001b[97Gjob.\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1324.581928, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mThe search page heading still reads \"Search\".\u001b[51G\u001b[22mThe\u001b[55Gdesign\u001b[62Ghas\u001b[66G\"Search\u001b[74Gresults\u001b[82Gfor\u001b[86G“…”\"\u001b[91Gas\u001b[94Gthe\u001b[98Gheading;\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1324.825745, "o", "\u001b[?25l\u001b[H\u001b[5G \u001b[7Gfresh-install test showed those IDs cha\u001b[47Gg\u001b[49G on import.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mAddSearchWordToResultList\u001b[39m passes the search word to the result l\u001b[72Gst, which ke_search only\u001b[97Ggives\u001b[103Gto\r\u001b[6C\u001b[1Bth\u001b[10G search box. That's wha\u001b[34G makes \"3 results for “water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Ini\u001b[32Gialisation/seed-search.php\u001b[59G\u001b[39mcr\u001b[62Gat\u001b[66G the \"Searc\u001b[78G index\" folder, the filter,\r\u001b[4C\u001b[1Btwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I put your database snapshot and config\u001b[56Gback. I also\u001b[69Gdelet\u001b[75Gd a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[39m that the\u001b[K\r\u001b[5C\u001b[1Best setup\u001b[16Gha\u001b[20Gwri\u001b[24Gten.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly news shows up for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[2C\u001b[1B  pages are still empty.\u001b[28GThey'll\u001b[36Gappear\u001b[43Gonce\u001b[48Gthey\u001b[53Ghave\u001b[58Gtext.\r\u001b[4C\u001b[1B\u001b[1mNothi\u001b[11Gg builds the\u001b[24Gindex automatically.\u001b[22m Run\u001b[49G\u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[39m after setup and after\r\u001b[4C\u001b[1Bcontent changes. There's no schedule\u001b[43Gext\u001b[47Gnsion\u001b[53Ginstalled,\u001b[64Gso\u001b[67Ga\u001b[69Glive\u001b[74Gsite\u001b[79Gwould\u001b[85Gneed\u001b[90Ga\u001b[92Gcron\u001b[97Gjob.\r\u001b[4C\u001b[1B\u001b[1mThe search page \u001b[23Gading still reads \"Search\".\u001b[22m The design has \"Search results for “…”\" as the he\u001b[101Gding;\r\u001b[4C\u001b[1Bf\u001b[7Gr now\u001b[13Gt\u001b[16Gt wording appears in the line above the results.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1325.270045, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mThe search-box plugin's \"Filters\" field still refers to the filter by record ID.\u001b[86G\u001b[22mIt's\u001b[91Gcorrect\u001b[99Gafter\u001b[105Ga\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1325.420873, "o", "\u001b[?25l\u001b[H\u001b[7Gth\u001b[10G search box. That's wha\u001b[34G makes \"3 results for “water”\"\u001b[65Gpossible.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed and export:\u001b[22m \u001b[38;2;177;185;249mBuild/Ini\u001b[32Gialisation/seed-search.php\u001b[59G\u001b[39mcr\u001b[62Gat\u001b[66G the \"Searc\u001b[78G index\" folder, the filter,\r\u001b[4C\u001b[1Btwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I put your database snapshot and config\u001b[56Gback. I also\u001b[69Gdelet\u001b[75Gd a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[39m that the\u001b[K\r\u001b[5C\u001b[1Best setup\u001b[16Gha\u001b[20Gwri\u001b[24Gten.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly news shows up for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[2C\u001b[1B  pages are still empty.\u001b[28GThey'll\u001b[36Gappear\u001b[43Gonce\u001b[48Gthey\u001b[53Ghave\u001b[58Gtext.\r\u001b[4C\u001b[1B\u001b[1mNothi\u001b[11Gg builds the\u001b[24Gindex automatically.\u001b[22m Run\u001b[49G\u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[39m after setup and after\r\u001b[4C\u001b[1Bcontent changes. There's no schedule\u001b[43Gext\u001b[47Gnsion\u001b[53Ginstalled,\u001b[64Gso\u001b[67Ga\u001b[69Glive\u001b[74Gsite\u001b[79Gwould\u001b[85Gneed\u001b[90Ga\u001b[92Gcron\u001b[97Gjob.\r\u001b[4C\u001b[1B\u001b[1mThe search page \u001b[23Gading still reads \"Search\".\u001b[22m The design has \"Search results for “…”\" as the he\u001b[101Gding;\r\u001b[4C\u001b[1Bf\u001b[7Gr now\u001b[13Gt\u001b[16Gt wording appears in the line above the results.\u001b[K\r\u001b[14C\u001b[1B\u001b[1m-box plugin's\u001b[29G\"F\u001b[33Gte\u001b[36Gs\" field still refers to the filter by record ID.\u001b[86G\u001b[22mIt's\u001b[91Gcorrect after a\r\u001b[5C\u001b[1Bresh impor\u001b[17G, where it's the\u001b[34Go\u001b[36Gly fi\u001b[42Gter, and the README \u001b[63Gays\u001b[67Gso.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1325.572588, "o", "\u001b[?25l\u001b[H\u001b[5Gtwo ind\u001b[13Gxers\u001b[18Gand both plugins. I re-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m with the thre\u001b[73G ke_search\u001b[84Gtables\u001b[91Gadded,\u001b[98Gand\r\u001b[2C\u001b[1B \u001b[5Gupdated the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[22m lowered from 4 to 3 in \u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m, \u001b[78Go words like\u001b[91G\"tax\" and \"fee\"\r\u001b[4C\u001b[1Bcan b\u001b[11G searched.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8Gthis\u001b[13Ginstallation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B  filter.\u001b[K\r\u001b[4C\u001b[1BI also checked that a\u001b[33G word containing\u001b[50GHTML\u001b[55Gis \u001b[59Gscaped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn an empty\u001b[17Gdatabase\u001b[26Grebuilt\u001b[34Gfrom\u001b[39Gthe\u001b[43Gpackage\u001b[51Gwith\u001b[56G\u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe \u001b[10Gearch an\u001b[20Gfil\u001b[24Gers wo\u001b[31Gked, and \u001b[38;2;177;185;249m/\u001b[39m, \u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I put your database snapshot and config\u001b[56Gback. I also\u001b[69Gdelet\u001b[75Gd a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[39m that the\u001b[K\r\u001b[5C\u001b[1Best setup\u001b[16Gha\u001b[20Gwri\u001b[24Gten.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly news shows up for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[2C\u001b[1B  pages are still empty.\u001b[28GThey'll\u001b[36Gappear\u001b[43Gonce\u001b[48Gthey\u001b[53Ghave\u001b[58Gtext.\r\u001b[4C\u001b[1B\u001b[1mNothi\u001b[11Gg builds the\u001b[24Gindex automatically.\u001b[22m Run\u001b[49G\u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[39m after setup and after\r\u001b[4C\u001b[1Bcontent changes. There's no schedule\u001b[43Gext\u001b[47Gnsion\u001b[53Ginstalled,\u001b[64Gso\u001b[67Ga\u001b[69Glive\u001b[74Gsite\u001b[79Gwould\u001b[85Gneed\u001b[90Ga\u001b[92Gcron\u001b[97Gjob.\r\u001b[4C\u001b[1B\u001b[1mThe search page \u001b[23Gading still reads \"Search\".\u001b[22m The design has \"Search results for “…”\" as the he\u001b[101Gding;\r\u001b[4C\u001b[1Bf\u001b[7Gr now\u001b[13Gt\u001b[16Gt wording appears in the line above the results.\u001b[K\r\u001b[14C\u001b[1B\u001b[1m-box plugin's\u001b[29G\"F\u001b[33Gte\u001b[36Gs\" field still refers to the filter by record ID.\u001b[86G\u001b[22mIt's\u001b[91Gcorrect after a\r\u001b[5C\u001b[1Bresh impor\u001b[17G, where it's the\u001b[34Go\u001b[36Gly fi\u001b[42Gter, and the README \u001b[63Gays\u001b[67Gso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo bugs from earlier stages, not fixed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1325.968124, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mThe page IDs in the site settings are wrong on a fresh install.\u001b[70G\u001b[22mThe\u001b[74GREADME\u001b[81Gsays\u001b[86Ga\u001b[88Gfresh\u001b[94Gimport\u001b[101Gkeeps\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1326.271663, "o", "\u001b[?25l\u001b[H\u001b[5Gupdate\u001b[12G the README.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMinimum word length:\u001b[26G\u001b[22mlowered\u001b[34Gfrom\u001b[39G4\u001b[41Gto\u001b[44G3\u001b[46Gin\u001b[49G\u001b[38;2;177;185;249mconfig/system/settings.php\u001b[39m,\u001b[77Gso\u001b[80Gwords\u001b[86Glike\u001b[91G\"tax\"\u001b[97Gand\u001b[101G\"fee\"\r\u001b[2C\u001b[1B \u001b[5Gcan be searched.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\r\u001b[2C\u001b[1B\u001b[22m- On this installation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B \u001b[5Gfil\u001b[9Ger.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI also checked\u001b[20Gthat\u001b[25Ga\u001b[27Gsearch\u001b[34Gword\u001b[39Gcontaining\u001b[50GHTML\u001b[55Gis\u001b[58Gescaped.\r\u001b[4C\u001b[1BOn an empty datab\u001b[23Gse rebuilt\u001b[34Gfrom\u001b[39Gthe packa\u001b[49Ge with \u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe search and filt\u001b[25Grs worked, and \u001b[38;2;177;185;249m/\u001b[39m,\u001b[43G\u001b[38;2;177;185;249m/news\u001b[39m, \u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[39m all returned 200.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAfterw\u001b[13Gds\u001b[16GI put you\u001b[26G database\u001b[36Gs\u001b[38Gapshot and config back. I also deleted a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[96G\u001b[39mthat\u001b[101Gthe\r\u001b[2C\u001b[1B \u001b[5Gtest setup\u001b[16Ghad written.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mO\u001b[7Gly\u001b[10Gnews shows\u001b[21Gup for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[2C\u001b[1B \u001b[5Gpages are still empty. They'll appear\u001b[43Gonce they have \u001b[59Gext.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNothing builds the index automatically.\u001b[22m Run \u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[84G\u001b[39mafter\u001b[90Gsetup\u001b[96Gand\u001b[100Gafter\r\u001b[2C\u001b[1B \u001b[5Gcontent changes. There's no scheduler exte\u001b[48Gsion installed, so a live site would ne\u001b[88Gd\u001b[90Ga cron job.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe search page heading still reads \"Search\".\u001b[22m The design ha\u001b[65G \"Search\u001b[74Gresults for “…”\" as the heading;\r\u001b[2C\u001b[1B \u001b[5Gfor now that wording appears in the line above the results.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe search-box plugin's \"Filters\" field still refers to the filter by record ID.\u001b[86G\u001b[22mIt's\u001b[91Gcorrect\u001b[99Gafter\u001b[105Ga\r\u001b[2C\u001b[1B \u001b[5Gfresh import, where it's the only filter, and the README says so.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo bugs from earlier stages, not fixed:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mThe page IDs in the sit\u001b[30G settings are wrong on a fresh install.\u001b[70G\u001b[22mThe\u001b[74GREADME\u001b[81Gsays\u001b[86Ga\u001b[88Gfresh\u001b[94Gimport\u001b[101Gkeeps\r\u001b[2C\u001b[1B  \u001b[6Gthe same IDs, but it doesn't. Search landed on 20 instead of 16, so\u001b[74Gthe header search for\u001b[96G sent\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1326.570251, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn this installation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[4C\u001b[1Bfilter.\r\u001b[2C\u001b[1B- I also checked\u001b[20Gthat\u001b[25Ga\u001b[27Gsearch\u001b[34Gword\u001b[39Gcontaining\u001b[50GHTML\u001b[55Gis\u001b[58Gescaped.\r\u001b[7C\u001b[1Ban empty dat\u001b[21Gbase rebuilt from the package with \u001b[38;2;177;185;249mtypo3 setup\u001b[39m: the\u001b[73Grec\u001b[77Grd\u001b[80G a\u001b[83Grived, the index\u001b[100Gbuilt,\r\u001b[4C\u001b[1Bthe search\u001b[16Gand\u001b[20Gfilters\u001b[28Gworked,\u001b[36Gand\u001b[40G\u001b[38;2;177;185;249m/\u001b[39m,\u001b[43G\u001b[38;2;177;185;249m/news\u001b[39m,\u001b[50G\u001b[38;2;177;185;249m/contact\u001b[59G\u001b[39mand\u001b[63G\u001b[38;2;177;185;249m/search\u001b[71G\u001b[39mall\u001b[75Greturned 200.\r\u001b[4C\u001b[1BAfterwards I pu\u001b[21G your\u001b[27Gdatabase snapshot and config back. I also\u001b[69Gdeleted\u001b[77Ga\u001b[79G\u001b[38;2;177;185;249mpublic/.htaccess\u001b[96G\u001b[39mthat\u001b[101Gthe\r\u001b[2C\u001b[1B \u001b[5Gtest s\u001b[12Gtup had written.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly news shows up for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[4C\u001b[1Bpages\u001b[11Gare\u001b[15Gstill\u001b[21Gempty.\u001b[28GThey'll\u001b[36Gappear\u001b[43Gonce\u001b[48Gthey\u001b[53Ghave\u001b[58Gtext.\r\u001b[2C\u001b[1B- \u001b[1mNothing builds the index automatically.\u001b[45G\u001b[22mRun\u001b[49G\u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[84G\u001b[39mafter\u001b[90Gsetup\u001b[96Gand\u001b[100Gafter\r\u001b[2C\u001b[1B \u001b[5Gcontent changes. There's no\u001b[33Gscheduler\u001b[43Gextension inst\u001b[58Glled, so a live site would need a cron job.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe search page heading still reads \"Search\".\u001b[22m The d\u001b[57Gsign has\u001b[66G\"Search\u001b[74Gresults\u001b[82Gfor\u001b[86G“…”\"\u001b[91Gas\u001b[94Gthe\u001b[98Gheading;\r\u001b[2C\u001b[1B \u001b[5Gfor now that wording appears in the line above the results.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe search-box plugin's \"Filters\" field still refers to the filter by record ID.\u001b[22m It's co\u001b[94Grect after\u001b[105Ga\r\u001b[2C\u001b[1B \u001b[5Gfresh import, where it's the only filter, and\u001b[51Gt\u001b[55GREADME\u001b[62Gs\u001b[64Gys so.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo bugs from earlier stages, not fixed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mThe page IDs in the site settings are wrong on a fresh install.\u001b[22m The\u001b[74GREADME\u001b[81Gsays\u001b[86Ga\u001b[88Gfresh\u001b[94Gimport\u001b[101Gkeeps\r\u001b[5C\u001b[1Bthe\u001b[10Gsame\u001b[15GIDs,\u001b[20Gbut\u001b[24Git\u001b[27Gdoesn't.\u001b[36GSearch\u001b[43Glanded\u001b[50Gon\u001b[53G20\u001b[56Ginstead\u001b[64Gof\u001b[67G16,\u001b[71Gso\u001b[74Gthe\u001b[78Gheader\u001b[85Gsearch\u001b[92Gform\u001b[97Gsent\r\u001b[2C\u001b[1B   people to \"Access to information\". The\u001b[45Gservice\u001b[53Gand\u001b[57Gfooter\u001b[64Gmenus\u001b[70G(22/23)\u001b[78Gand\u001b[82Gthe\u001b[86G404\u001b[90Gpage\u001b[95G(33)\u001b[100Gare\r\u001b[2C\u001b[1B  \u001b[6Galso off.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1326.872006, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mHow I tested it\r\u001b[2C\u001b[1B\u001b[22m- On this installation:\u001b[27Gsearches\u001b[36Gwith\u001b[41Gresults,\u001b[50Gwith\u001b[55Gnone,\u001b[61Gempty,\u001b[68Gwith\u001b[73Ga\u001b[75Gtoo-short\u001b[85Gword,\u001b[91Gand\u001b[95Gwith\u001b[100Geach\r\u001b[2C\u001b[1B \u001b[5Gfil\u001b[9Ger.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI also checked\u001b[20Gthat\u001b[25Ga\u001b[27Gsearch\u001b[34Gword\u001b[39Gcontaining\u001b[50GHTML\u001b[55Gis\u001b[58Gescaped.\r\u001b[4C\u001b[1BOn an empty datab\u001b[23Gse rebuilt\u001b[34Gfrom\u001b[39Gthe packa\u001b[49Ge with \u001b[38;2;177;185;249mtypo3 setup\u001b[39m:\u001b[69Gthe\u001b[73Grecords\u001b[81Garrived,\u001b[90Gthe\u001b[94Gindex\u001b[100Gbuilt,\r\u001b[2C\u001b[1B \u001b[5Gthe search and filt\u001b[25Grs worked, and \u001b[38;2;177;185;249m/\u001b[39m,\u001b[43G\u001b[38;2;177;185;249m/news\u001b[39m, \u001b[38;2;177;185;249m/contact\u001b[39m and \u001b[38;2;177;185;249m/search\u001b[39m all returned 200.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAfterw\u001b[13Gds\u001b[16GI put you\u001b[26G database\u001b[36Gs\u001b[38Gapshot and config back. I also deleted a \u001b[38;2;177;185;249mpublic/.htaccess\u001b[96G\u001b[39mthat\u001b[101Gthe\r\u001b[2C\u001b[1B \u001b[5Gtest setup\u001b[16Ghad written.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings you should know\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mO\u001b[7Gly\u001b[10Gnews shows\u001b[21Gup for now.\u001b[33G\u001b[22mke_search\u001b[43Gskips\u001b[49Gpages\u001b[55Gthat\u001b[60Ghave\u001b[65Gno\u001b[68Gindexable\u001b[78Gcontent,\u001b[87Gand\u001b[91Gthe\u001b[95Gservice\r\u001b[2C\u001b[1B \u001b[5Gpages are still empty. They'll appear\u001b[43Gonce they have \u001b[59Gext.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNothing builds the index automatically.\u001b[22m Run \u001b[38;2;177;185;249mddev exec typo3 ke_search:indexing\u001b[84G\u001b[39mafter\u001b[90Gsetup\u001b[96Gand\u001b[100Gafter\r\u001b[2C\u001b[1B \u001b[5Gcontent changes. There's no scheduler exte\u001b[48Gsion installed, so a live site would ne\u001b[88Gd\u001b[90Ga cron job.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe search page heading still reads \"Search\".\u001b[22m The design ha\u001b[65G \"Search\u001b[74Gresults for “…”\" as the heading;\r\u001b[2C\u001b[1B \u001b[5Gfor now that wording appears in the line above the results.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe search-box plugin's \"Filters\" field still refers to the filter by record ID.\u001b[86G\u001b[22mIt's\u001b[91Gcorrect\u001b[99Gafter\u001b[105Ga\r\u001b[2C\u001b[1B \u001b[5Gfresh import, where it's the only filter, and the README says so.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo bugs from earlier stages, not fixed:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mThe page IDs in the sit\u001b[30G settings are wrong on a fresh install.\u001b[70G\u001b[22mThe\u001b[74GREADME\u001b[81Gsays\u001b[86Ga\u001b[88Gfresh\u001b[94Gimport\u001b[101Gkeeps\r\u001b[2C\u001b[1B  \u001b[6Gthe same IDs, but it doesn't. Search landed on 20 instead of 16, so\u001b[74Gthe header search for\u001b[96G sent\u001b[K\r\u001b[5C\u001b[1Bpeople to \"Access\u001b[24Gto\u001b[27Ginformation\". The service\u001b[53Gand footer\u001b[64Gmenus (22/23)\u001b[78Gand the 404 page (33) are\r\u001b[5C\u001b[1Balso off.\u001b[16G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mEvery news item gets the \"Education\" category on a fresh install,\u001b[72G\u001b[22mon\u001b[75Gtop\u001b[79Gof\u001b[82Gits\u001b[86Greal\u001b[91Gone.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
