2C\u001b[1BWhat\u001b[8GI\u001b[10Gchecked:\u001b[19G\u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[47G\u001b[39mreturns\u001b[55G0\u001b[57Grows,\u001b[63Gwhile\u001b[69Ga\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries. The words are in the index table, but the full-text ind\u001b[68Gx skips them.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\r\u001b[2C\u001b[1B\u001b[39m[mysqld]\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_min_word_len\u001b[19G\u001b[39m=\u001b[21G\u001b[32m3\r\u001b[5C\u001b[1B\u001b[36mstop\u001b[15Gfile\u001b[39m = \u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen\u001b[8G\u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR\u001b[69GK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
