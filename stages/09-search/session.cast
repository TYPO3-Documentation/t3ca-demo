36mmin_\u001b[15Glen\u001b[39m = \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[20G\u001b[39m=\u001b[22G\u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen \u001b[38;2;177;185;249mddev restart\u001b[39m, followed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe catch is th\u001b[19Gt this is\u001b[30G server setting. The\u001b[51Glive database server needs\u001b[78Gthe same two lines or\u001b[100Gthe\u001b[K\r\u001b[2C\u001b[1Bproblem comes back there, and on\u001b[36Gshar\u001b[41Gd hosti\u001b[49Gg you of\u001b[58Gen can't change\u001b[74Git. Turning off stopwo\u001b[97Gds\u001b[100Galso\r\u001b[2C\u001b[1Blets\u001b[8Gwords\u001b[14Glike\u001b[19G\"the\"\u001b[25Gmatch,\u001b[32Gbut\u001b[36Gke_search\u001b[46Granks\u001b[52Gresults\u001b[60Gby\u001b[63Grelevance,\u001b[74Gso\u001b[77Gthat\u001b[82Gdoes\u001b[87Glittle\u001b[94Gharm.\r\u001b[2C\u001b[1B      \u001b[10G \u001b[12G   \u001b[16G   \u001b[20G    \u001b[25G       \u001b[33G       \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
