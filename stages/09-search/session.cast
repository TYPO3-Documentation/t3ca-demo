[735.039416, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[4G\u001b[38;2;255;255;255mnce cores\u001b[14Gbecome\u001b[21Gavailabl\u001b[30G?\u001b[39m                                                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Gthat\u001b[13Gworks\u001b[19Gwell.\u001b[25Gke_search\u001b[35Gand\u001b[39GEXT:solr\u001b[48Ghave\u001b[53Gthe\u001b[57Gsame\u001b[62Goverall\u001b[70Gshape:\u001b[77Ga\u001b[79Gsearch\u001b[86Gpage,\u001b[92Gindexers\u001b[101Gor\r\u001b[1B \u001b[3Gindex queues, fac\u001b[21Gts,\u001b[25Gand Fluid\u001b[35Gtemplate\u001b[44G. Most of what w\u001b[62Gbuild can stay\u001b[77Gwhen you\u001b[86Gswitch. S\u001b[96Gt up\u001b[101Ga few\r\u001b[2C\u001b[1Bthings now to\u001b[17Gkeep the switch cheap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mKeep the search\u001b[22Gpage\u001b[27G(\u001b[29Gid 16)\u001b[22m and the \u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[2C\u001b[1B  \u001b[6Gpage changes.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mMake the query parameter a setting.\u001b[42G\u001b[22mke_search\u001b[52Guses\u001b[57G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[80G\u001b[39mand\u001b[84GSolr\u001b[89Guses\u001b[94G\u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\r\u001b[2C\u001b[1B  \u001b[6GIf the header form takes the field name from a \u001b[54Gite setting such as \u001b[38;2;177;185;249mmtosafi.search.queryParameter\u001b[39m,\u001b[K\r\u001b[5C\u001b[1Bswi\u001b[10Gching b\u001b[18Gcomes a on\u001b[29G-lin\u001b[35Gchange. The cHash\u001b[53Gexclu\u001b[59Gion in\u001b[66G\u001b[38;2;177;185;249mext_localc\u001b[77Gnf.php\u001b[39m has to follow it too.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mWrite the result markup as partials of our own\u001b[22m: the result item, the badge and the filter lis\u001b[100G. These\r\u001b[2C\u001b[1B  \u001b[6Gare the \u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m and \u001b[38;2;177;185;249mdata-type\u001b[54G\u001b[39mparts of \u001b[64Ghe design.\u001b[75GKeep the ke_search templates\u001b[K\r\u001b[5C\u001b[1Bthin wrappers around them\u001b[33Gso the\u001b[40GSolr templates can reuse the \u001b[70Game partials and the CSS stays a\u001b[104Git\r\u001b[5C\u001b[1Bis.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mUse the same type keys everywhere.\u001b[41G\u001b[22mName\u001b[46Gthe\u001b[50Gke_search\u001b[60Gtags\u001b[65G\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mnews\u001b[79G\u001b[39mand\u001b[83G\u001b[38;2;177;185;249mdocument\u001b[39m,\u001b[93Gand\u001b[97Guse\u001b[101Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame values for the Solr facet later. Then th\u001b[52G badges\u001b[60Gand filters don't change.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mUse free ke_search features only.\u001b[22m Nothing from\u001b[53Gpremium, so you don't miss \u001b[82Gything\u001b[89Gafter\u001b[95Gthe\u001b[99Gswitch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets thrown away when you switch\r\u001b[2C\u001b[1B\u001b[22m- The indexer and filter records, both\u001b[42Gin\u001b[45Gthe\u001b[49Gdatabase\u001b[58Gand\u001b[62Gin\u001b[65G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m.\r\u001b[8C\u001b[1Bke_sea\u001b[16Gch compos\u001b[28Gd\u001b[30Gpen\u001b[34Gency, the sc\u001b[48Gduler task and the \u001b[38;2;177;185;249mpdftotex\u001b[76G\u001b[39m package in DDEV.\r\u001b[4C\u001b[1BOn existing installations, th\u001b[35G \u001b[38;2;177;185;249mtx_k\u001b[69G