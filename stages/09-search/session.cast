[672.254193, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│ Configset                    │ \u001b[38;2;177;185;249mext_solr_14_0_0\u001b[39m                         │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\r\u001b[2C\u001b[1B\u001b[22m- If they're on EXT:solr 13 or older,\u001b[41Gtheir\u001b[47GSolr\u001b[52Gserver\u001b[59Gis\u001b[62Gmost\u001b[67Glikely\u001b[74G\u001b[1mversion 9\u001b[22m.\u001b[85GThat\u001b[90Gserver\u001b[97Gcan't\u001b[103Ghost\r\u001b[2C\u001b[1B \u001b[5Ga cor\u001b[11G for\u001b[16Gthis site. You'd nee\u001b[37G a Solr 10 instance, or upgrade the shared server \u001b[88Glong with \u001b[99Gll t\u001b[104Ge\u001b[K\r\u001b[4C\u001b[1Bothe\u001b[10G sites, which also means a schema update and a full re-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they'r\u001b[15G already\u001b[24Gon TYPO3 14 wit\u001b[40G EXT:solr 14, you can\u001b[62Gadd a core\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou can\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[33G\u001b[22mI\u001b[35Gsaid\u001b[40GSolr\u001b[45Gcovers\u001b[52GPDFs\u001b[57Gthrough\u001b[65GTika.\u001b[71GThat's\u001b[78Gonly\u001b[83Ghalf\u001b[88Gright.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom fileadmin into\u001b[65Gthe index, \u001b[1mEXT:solrfal\u001b[22m, \u001b[90Gs a pa\u001b[97Gd\u001b[K\r\u001b[2C\u001b[1Bfunding-contribution extension. Pages and\u001b[45Gnews\u001b[50Gare free w\u001b[61Gth Solr. For the \"Documents\" results in\u001b[101Gthe\r\u001b[2C\u001b[1Bdesig\u001b[9G you'd need solrfal, unless your other \u001b[49Gites\u001b[54Galr\u001b[58Gady \u001b[63Gave a funding partnership that includes it.\r\u001b[2C\u001b[1BFree ke_search doe\u001b[22G index PDFs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\r\u001b[2C\u001b[1B- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007EXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b]8;;\u0007\u001b[39m      \u001b[31;1H\u001b[29;5H\u001b[?25h"]
[672.277274, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\r\u001b[2C\u001b[1B\u001b[22m- If they're on EXT:solr 13 or older,\u001b[41Gtheir\u001b[47GSolr\u001b[52Gserver\u001b[59Gis\u001b[62Gmost\u001b[67Glikely\u001b[74G\u001b[1mversion 9\u001b[22m.\u001b[85GThat\u001b[90Gserver\u001b[97Gcan't\u001b[103Ghost\r\u001b[2C\u001b[1B \u001b[5Ga cor\u001b[11G for\u001b[16Gthis site. You'd nee\u001b[37G a Solr 10 instance, or upgrade the shared server \u001b[88Glong with \u001b[99Gll t\u001b[104Ge\u001b[K\r\u001b[4C\u001b[1Bothe\u001b[10G sites, which also means a schema update and a full re-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they'r\u001b[15G already\u001b[24Gon TYPO3 14 wit\u001b[40G EXT:solr 14, you can\u001b[62Gadd a core\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou can\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[33G\u001b[22mI\u001b[35Gsaid\u001b[40GSolr\u001b[45Gcovers\u001b[52GPDFs\u001b[57Gthrough\u001b[65GTika.\u001b[71GThat's\u001b[78Gonly\u001b[83Ghalf\u001b[88Gright.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom fileadmin into\u001b[65Gthe index, \u001b[1mEXT:solrfal\u001b[22m, \u001b[90Gs a pa\u001b[97Gd\u001b[K\r\u001b[2C\u001b[1Bfunding-contribution extension. Pages and\u001b[45Gnews\u001b[50Gare free w\u001b[61Gth Solr. For the \"Documents\" results in\u001b[101Gthe\r\u001b[2C\u001b[1Bdesig\u001b[9G you'd need solrfal, unless your other \u001b[49Gites\u001b[54Galr\u001b[58Gady \u001b[63Gave a funding partnership that includes it.\r\u001b[2C\u001b[1BFree ke_search doe\u001b[22G index PDFs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\r\u001b[2C\u001b[1B- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007EXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007\u001b[94mEXT:solr README\u001b]8;;\u0007\u001b[39m        \u001b[31;1H\u001b[29;5H\u001b[?25h"]
[672.294435, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\r\u001b[2C\u001b[1B\u001b[22m- If they're on EXT:solr 13 or older,\u001b[41Gtheir\u001b[47GSolr\u001b[52Gserver\u001b[59Gis\u001b[62Gmost\u001b[67Glikely\u001b[74G\u001b[1mversion 9\u001b[22m.\u001b[85GThat\u001b[90Gserver\u001b[97Gcan't\u001b[103Ghost\r\u001b[2C\u001b[1B \u001b[5Ga cor\u001b[11G for\u001b[16Gthis site. You'd nee\u001b[37G a Solr 10 instance, or upgrade the shared server \u001b[88Glong with \u001b[99Gll t\u001b[104Ge\u001b[K\r\u001b[4C\u001b[1Bothe\u001b[10G sites, which also means a schema update and a full re-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they'r\u001b[15G already\u001b[24Gon TYPO3 14 wit\u001b[40G EXT:solr 14, you can\u001b[62Gadd a core\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou can\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[33G\u001b[22mI\u001b[35Gsaid\u001b[40GSolr\u001b[45Gcovers\u001b[52GPDFs\u001b[57Gthrough\u001b[65GTika.\u001b[71GThat's\u001b[78Gonly\u001b[83Ghalf\u001b[88Gright.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom fileadmin into\u001b[65Gthe index, \u001b[1mEXT:solrfal\u001b[22m, \u001b[90Gs a pa\u001b[97Gd\u001b[K\r\u001b[2C\u001b[1Bfunding-contribution extension. Pages and\u001b[45Gnews\u001b[50Gare free w\u001b[61Gth Solr. For the \"Documents\" results in\u001b[101Gthe\r\u001b[2C\u001b[1Bdesig\u001b[9G you'd need solrfal, unless your other \u001b[49Gites\u001b[54Galr\u001b[58Gady \u001b[63Gave a funding partnership that includes it.\r\u001b[2C\u001b[1BFree ke_search doe\u001b[22G index PDFs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\r\u001b[2C\u001b[1B- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007EXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007\u001b[94mEXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B \u001b[5G               \u001b[31;1H\u001b[29;5H\u001b[?25h"]
[672.330939, "o", "\u001b[?25l\u001b[H  │ EXT:tika (text from PDFs)    │ 14.0                                    │\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\r\u001b[2C\u001b[1B\u001b[22m- If they're on EXT:solr 13 or older,\u001b[41Gtheir\u001b[47GSolr\u001b[52Gserver\u001b[59Gis\u001b[62Gmost\u001b[67Glikely\u001b[74G\u001b[1mversion 9\u001b[22m.\u001b[85GThat\u001b[90Gserver\u001b[97Gcan't\u001b[103Ghost\r\u001b[2C\u001b[1B \u001b[5Ga cor\u001b[11G for\u001b[16Gthis site. You'd nee\u001b[37G a Solr 10 instance, or upgrade the shared server \u001b[88Glong with \u001b[99Gll t\u001b[104Ge\u001b[K\r\u001b[4C\u001b[1Bothe\u001b[10G sites, which also means a schema update and a full re-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they'r\u001b[15G already\u001b[24Gon TYPO3 14 wit\u001b[40G EXT:solr 14, you can\u001b[62Gadd a core\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou can\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[33G\u001b[22mI\u001b[35Gsaid\u001b[40GSolr\u001b[45Gcovers\u001b[52GPDFs\u001b[57Gthrough\u001b[65GTika.\u001b[71GThat's\u001b[78Gonly\u001b[83Ghalf\u001b[88Gright.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom