[719.938201, "o", "\u001b[?25l\u001b[H\u001b[5Gothe\u001b[10G sites, which also means a schema update and a full re-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they'r\u001b[15G already\u001b[24Gon TYPO3 14 wit\u001b[40G EXT:solr 14, you can\u001b[62Gadd a core\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou can\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[33G\u001b[22mI\u001b[35Gsaid\u001b[40GSolr\u001b[45Gcovers\u001b[52GPDFs\u001b[57Gthrough\u001b[65GTika.\u001b[71GThat's\u001b[78Gonly\u001b[83Ghalf\u001b[88Gright.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom fileadmin into\u001b[65Gthe index, \u001b[1mEXT:solrfal\u001b[22m, \u001b[90Gs a pa\u001b[97Gd\u001b[K\r\u001b[2C\u001b[1Bfunding-contribution extension. Pages and\u001b[45Gnews\u001b[50Gare free w\u001b[61Gth Solr. For the \"Documents\" results in\u001b[101Gthe\r\u001b[2C\u001b[1Bdesig\u001b[9G you'd need solrfal, unless your other \u001b[49Gites\u001b[54Galr\u001b[58Gady \u001b[63Gave a funding partnership that includes it.\r\u001b[2C\u001b[1BFree ke_search doe\u001b[22G index PDFs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\r\u001b[2C\u001b[1B- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007EXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007\u001b[94mEXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[4G\u001b[38;2;255;255;255mnce cores\u001b[14Gbecome\u001b[21Gavailabl\u001b[30G?\u001b[39m                                                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Gthat\u001b[13Gworks\u001b[19Gwell.\u001b[25Gke_search\u001b[35Gand\u001b[39GEXT:solr\u001b[48Ghave\u001b[53Gthe\u001b[57Gsame\u001b[62Goverall\u001b[70Gshape:\u001b[77Ga\u001b[79Gsearch\u001b[86Gpage,\u001b[92Gindexers\u001b[101Gor\r\u001b[1B \u001b[3Gindex queues, fac\u001b[21Gts,\u001b[25Gand Fluid\u001b[35Gtemplate\u001b[44G. Most of what w\u001b[62Gbuild can stay\u001b[77Gwhen you\u001b[86Gswitch. S\u001b[96Gt up\u001b[101Ga few\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[720.033, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[24Bthings\u001b[10Gnow\u001b[14Gto\u001b[17Gkeep\u001b[22Gthe\u001b[26Gswitch\u001b[33Gcheap.\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[720.3283, "o", "\u001b[?25l\u001b[H\u001b[5Gserver.\u001b[K\r\u001b[4C\u001b[1BYou can ask th\u001b[20G existing server for\u001b[41Gits version in the Solr admin UI \u001b[77Gat \u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[22m I said Solr\u001b[45Gcovers PDFs through\u001b[65GTika.\u001b[71GThat's only half right. Tika is open\r\u001b[2C\u001b[1Bsource,\u001b[11Gbut\u001b[15Gthe\u001b[19Gextension\u001b[29Gthat\u001b[34Gputs\u001b[39Gfiles\u001b[45Gfrom\u001b[50Gfileadmin\u001b[60Ginto\u001b[65Gthe\u001b[69Gindex,\u001b[76G\u001b[1mEXT:solrfal\u001b[22m,\u001b[89Gis\u001b[92Ga\u001b[94Gpaid\r\u001b[2C\u001b[1Bfunding-contribution extension.\u001b[35GP\u001b[37Gges and\u001b[45Gnews are free with Solr. For \u001b[75Ghe\u001b[78G\"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign yo\u001b[13G'd n\u001b[18Ged solrfal, unless your othe\u001b[47G sites \u001b[55Glready have a\u001b[69Gfunding partnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree ke_search does index PDFs\u001b[35G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m- \u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007EXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255monce cores become available?\u001b[39m                                                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Yes, that works well. ke_search and EXT:solr have the same overall shape: a search page, indexers or\u001b[K\r\u001b[2C\u001b[1Bindex\u001b[9Gqueues,\u001b[17Gfacets,\u001b[25Gand\u001b[29GFluid\u001b[35Gtemplates.\u001b[46GMost\u001b[51Gof\u001b[54Gwhat\u001b[59Gwe\u001b[62Gbuild\u001b[68Gcan\u001b[72Gstay\u001b[77Gwhen\u001b[82Gyou\u001b[86Gswitch.\u001b[94GSet\u001b[98Gup\u001b[101Ga\u001b[103Gfew\r\u001b[1B \u001b[3Gthings now to keep the switch cheap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\r\u001b[2C\u001b[1B\u001b[22m1.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[720.562204, "o", "\u001b]0;◑ Search implementation approach\u0007"]
[720.683641, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[22m I said Solr\u001b[45Gcovers PDFs through\u001b[65GTika.\u001b[71GThat's only half right. Tika is open\r\u001b[2C\u001b[1Bsource,\u001b[11Gbut\u001b[15Gthe\u001b[19Gextension\u001b[29Gthat\u001b[34Gputs\u001b[39Gfiles\u001b[45Gfrom\u001b[50Gfileadmin\u001b[60Ginto\u001b[65Gthe\u001b[69Gindex,\u001b[76G\u001b[1mEXT:solrfal\u001b[22m,\u001b[89Gis\u001b[92Ga\u001b[94Gpaid\r\u001b[2C\u001b[1Bfunding-contribution extension.\u001b[35GP\u001b[37Gges and\u001b[45Gnews are free with Solr. For \u001b[75Ghe\u001b[78G\"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign yo\u001b[13G'd n\u001b[18Ged solrfal, unless your othe\u001b[47G sites \u001b[55Glready have a\u001b[69Gfunding partnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree ke_search does index PDFs\u001b[35G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m- \u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007EXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255monce cores become available?\u001b[39m                                                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Yes, that works well. ke_search and EXT:solr have the same overall shape: a search page, indexers or\u001b[K\r\u001b[2C\u001b[1Bindex\u001b[9Gqueues,\u001b[17Gfacets,\u001b[25Gand\u001b[29GFluid\u001b[35Gtemplates.\u001b[46GMost\u001b[51Gof\u001b[54Gwhat\u001b[59Gwe\u001b[62Gbuild\u001b[68Gcan\u001b[72Gstay\u001b[77Gwhen\u001b[82Gyou\u001b[86Gswitch.\u001b[94GSet\u001b[98Gup\u001b[101Ga\u001b[103Gfew\r\u001b[1B \u001b[3Gthings now to keep the switch cheap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\r\u001b[2C\u001b[1B\u001b[22m1.\u001b[6G\u001b[1mKeep the search page (uid 16)\u001b[36G\u001b[22mand\u001b[40Gthe\u001b[44G\u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[2C\u001b[1B   page changes.\u001b[K\r\u001b[2C\u001b[1B2\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[721.036799, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mMake the query parameter a setting.\u001b[42G\u001b[22mke_search\u001b[52Guses\u001b[57G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[80G\u001b[39mand\u001b[84GSolr\u001b[89Guses\u001b[94G\u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[721.443029, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mCorrection to my last answer:\u001b[33G\u001b[22mI\u001b[35Gsaid\u001b[40GSolr\u001b[45Gcovers\u001b[52GPDFs\u001b[57Gthrough\u001b[65GTika.\u001b[71GThat's\u001b[78Gonly\u001b[83Ghalf\u001b[88Gright.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom fileadmin into\u001b[65Gthe index, \u001b[1mEXT:solrfal\u001b[22m, \u001b[90Gs a pa\u001b[97Gd\u001b[K\r\u001b[2C\u001b[1Bfunding-contribution extension. Pages and\u001b[45Gnews\u001b[50Gare free w\u001b[61Gth Solr. For the \"Documents\" results in\u001b[101Gthe\r\u001b[2C\u001b[1Bdesig\u001b[9G you'd need solrfal, unless your other \u001b[49Gites\u001b[54Galr\u001b[58Gady \u001b[63Gave a funding partnership that includes it.\r\u001b[2C\u001b[1BFree ke_search doe\u001b[22G index PDFs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\r\u001b[2C\u001b[1B- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007EXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007\u001b[94mEXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[4G\u001b[38;2;255;255;255mnce cores\u001b[14Gbecome\u001b[21Gavailabl\u001b[30G?\u001b[39m                                                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Gthat\u001b[13Gworks\u001b[19Gwell.\u001b[25Gke_search\u001b[35Gand\u001b[39GEXT:solr\u001b[48Ghave\u001b[53Gthe\u001b[57Gsame\u001b[62Goverall\u001b[70Gshape:\u001b[77Ga\u001b[79Gsearch\u001b[86Gpage,\u001b[92Gindexers\u001b[101Gor\r\u001b[1B \u001b[3Gindex queues, fac\u001b[21Gts,\u001b[25Gand Fluid\u001b[35Gtemplate\u001b[44G. Most of what w\u001b[62Gbuild can stay\u001b[77Gwhen you\u001b[86Gswitch. S\u001b[96Gt up\u001b[101Ga few\r\u001b[2C\u001b[1Bthings now to\u001b[17Gkeep the switch cheap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mKeep the search\u001b[22Gpage\u001b[27G(\u001b[29Gid 16)\u001b[22m and the \u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[2C\u001b[1B  \u001b[6Gpage changes.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mMake the query parameter a setting.\u001b[42G\u001b[22mke_search\u001b[52Guses\u001b[57G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[80G\u001b[39mand\u001b[84GSolr\u001b[89Guses\u001b[94G\u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\r\u001b[2C\u001b[1B  \u001b[6GIf the header form takes the field name from a \u001b[54Gite setting such as \u001b[38;2;177;185;249mmtosafi.search.queryParameter\u001b[39m,\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
