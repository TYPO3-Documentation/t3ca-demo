01b[34G\u001b[22mGive\u001b[39Geach\u001b[44Gindexer\u001b[52Ga\u001b[54Gtag\u001b[58G(\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[4C\u001b[1Bcheckboxes\u001b[16Gbecome\u001b[23Ga\u001b[25Gke_search\u001b[35Gfilter\u001b[42Gof\u001b[45Gtype\u001b[50Gcheckbox.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[26G\u001b[22mYou\u001b[30Gcan\u001b[34Goverride\u001b[43Gthe\u001b[47Gtemplates\u001b[57Gin\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[4C\u001b[1Bfor\u001b[9GNews\u001b[14Gunder\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\r\u001b[2C\u001b[2B\u001b[1mImplementation steps\r\u001b[2C\u001b[2B\u001b[22m1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[5C\u001b[1Bextension:setup\u001b[39m.\r\u001b[1B \u001b[3G2.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[50.440173, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25BAdd\u001b[10Ga\u001b[12G\"Search\u001b[20Gindexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[50.84287, "o", "\u001b[?25l\u001b[H\u001b[5GSolr\u001b[24G✅\u001b[37G✅    \u001b[58G✅\u001b[72G✅\u001b[83GSolr\u001b[88Gserver)\u001b[96G—\r\u001b[2C\u001b[1B│                  │            │                    │             │          │ too much for this │\r\u001b[82C\u001b[1B site      \u001b[95G \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[4C\u001b[1BCustom\u001b[12GExtbase\u001b[24G✅\u001b[37G✅\u001b[58G❌\u001b[72G✅\u001b[83GMedium, and no   \r\u001b[4C\u001b[1BSQL\u001b[9G\u001b[38;2;177;185;249mLIKE\u001b[83G\u001b[39mranking\r\u001b[2C\u001b[1B└\u001b[22G┴\u001b[35G┴\u001b[56G┴\u001b[70G┴\u001b[81G┴\u001b[101G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\u001b[22G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B  the index doesn't\u001b[23Gdepend\u001b[30Gon\u001b[33Gsomeone\u001b[41Gopening\u001b[49Ga\u001b[51Gpage\u001b[56Gfirst.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[34G\u001b[22mGive\u001b[39Geach\u001b[44Gindexer\u001b[52Ga\u001b[54Gtag\u001b[58G(\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filter of type checkbox.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You\u001b[30Gcan \u001b[35Gv\u001b[37Grride the templ\u001b[53Gt\u001b[55Gs \u001b[58Gn \u001b[61Ghe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce the markup: \u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[16G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd\u001b[10Ga\u001b[12G\"Search\u001b[20Gindexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tree), news (pointing a\u001b[46G the \"News records\" folder) and files\u001b[84G(fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds\u001b[24Gits\u001b[28Gtag.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[51.143718, "o", "\u001b[?25l\u001b[H\u001b[5G    \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Gt\u001b[85Go much for\u001b[96Gthis\r\u001b[82C\u001b[1B site   \u001b[92G   \u001b[96G    \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[2C\u001b[1B│ Custom Extbase   │ ✅         │ ✅                 │ ❌          │ ✅       │ Medium, and no    │\r\u001b[4C\u001b[1BSQL \u001b[38;2;177;185;249mLIKE\u001b[39m      \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Granking\u001b[91G   \u001b[95G  \r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tre\u001b[26G),\u001b[29Gnews (pointing at the \"News reco\u001b[62Gds\" fold\u001b[72G)\u001b[74Gand files (fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\" with\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[51.740066, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25BOn\u001b[9Gpage\u001b[14G16,\u001b[18Gplace\u001b[24Gthe\u001b[28G\u001b[1msearch box + results\u001b[49G\u001b[22mplugin\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[52.10191, "o", "\u001b[?25l\u001b[H\u001b[3G├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[4C\u001b[1BCustom\u001b[12GExtbase\u001b[24G✅\u001b[37G✅\u001b[58G❌\u001b[72G✅\u001b[83GMedium,\u001b[91Gand\u001b[95Gno\r\u001b[2C\u001b[1B│ SQL \u001b[38;2;177;185;249mLIKE\u001b[39m         │            │                    │             │          │ ranking           │\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mIt ind\u001b[12Gxes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[4C\u001b[1Bthe\u001b[9Gindex\u001b[15Gdoesn't\u001b[23Gdepend\u001b[30Gon\u001b[33Gsomeone\u001b[41Gopening\u001b[49Ga\u001b[51Gpage\u001b[56Gfirst.\r\u001b[4C\u001b[1B\u001b[1mThe filt\u001b[14Gr\u001b[16Gmaps\u001b[21Gonto facet\u001b[32G.\u001b[22m Give each indexer a tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\u001b[104G\u001b[K\r\u001b[4C\u001b[1Bc\u001b[8Gckboxes b\u001b[18Gcome\u001b[23Ga k\u001b[27G_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[8C\u001b[1B\u001b[1moutput\u001b[16Gis Fluid.\u001b[22m You can\u001b[34Goverride the templ\u001b[53Gtes in the sitepackage, the same way you already do\r\u001b[4C\u001b[1Bfor News und\u001b[18Gr \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[2B\u001b[22m1. \u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[5C\u001b[1Bextension:setup\u001b[39m.\r\u001b[2C\u001b[1B2\u001b[6GAdd a \"Search indexes\" storage fold\u001b[42Gr,\u001b[45Gand\u001b[49Gc\u001b[51Gnfigu\u001b[57Ge three indexers there: pages (limited to the\r\u001b[5C\u001b[1Bservice/content tree),\u001b[29Gnews\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach ind\u001b[15Gxer adds it\u001b[27G tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter\u001b[22G\"Type\"\u001b[29Gwith\u001b[34Gthree options whose tags match the indexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place\u001b[24Gthe\u001b[28G\u001b[1msearch box + results\u001b[49G\u001b[22mplugin\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Grigh\u001b[11G\"\u001b[13Glayou\u001b[19G),\u001b[22Gor r\u001b[27Gnder the facets \u001b[44Gnside your re\u001b[58Gult template.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[52.34838, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mConnect the header form.\u001b[31G\u001b[22mke_search\u001b[41Greads\u001b[47G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m,\u001b[71Gnot\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[52.793119, "o", "\u001b[?25l\u001b[H\u001b[3G│ Custom Extbase   │ ✅         │ ✅                 │ ❌          │ ✅       │ Medium, and no    │\r\u001b[4C\u001b[1BSQL \u001b[38;2;177;185;249mLIKE\u001b[39m      \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Granking\u001b[91G   \u001b[95G  \r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tre\u001b[26G),\u001b[29Gnews (pointing at the \"News reco\u001b[62Gds\" fold\u001b[72G)\u001b[74Gand files (fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\" with\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe filter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or r\u001b[27Gnder the facets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_sear\u001b[39Gh read\u001b[46G \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), o\u001b[86G keep\u001b[92G\u001b[38;2;177;185;249mq\u001b[39m and add\u001b[102Ga\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[53.202485, "o", "\u001b[?25l\u001b[H\u001b[5GSQL \u001b[38;2;177;185;249mLIKE\u001b[39m      \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Granking\u001b[91G   \u001b[95G  \r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u