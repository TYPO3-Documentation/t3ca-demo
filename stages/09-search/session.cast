             │             │          │ ranking           │\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[22m News\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someon\u001b[40G opening a p\u001b[53Gge first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer a tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filter of typ\u001b[49G checkbox.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the templates in the sit\u001b[68Gpackage,\u001b[77Gthe same way you already do\r\u001b[4C\u001b[1Bfor News under\u001b[20G\u001b[38;2;177;185;249mResources/Private/Ex\u001b[69G\u001b[39mmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[31;1H\u001b[29;3H\u001b[?25h"]
