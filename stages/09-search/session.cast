\u001b[5C\u001b[1Bis.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mUse the same type keys everywhere.\u001b[41G\u001b[22mName\u001b[46Gthe\u001b[50Gke_search\u001b[60Gtags\u001b[65G\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mnews\u001b[79G\u001b[39mand\u001b[83G\u001b[38;2;177;185;249mdocument\u001b[39m,\u001b[93Gand\u001b[97Guse\u001b[101Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame values for the Solr facet later. Then th\u001b[52G badges\u001b[60Gand filters don't change.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mUse free ke_search features only.\u001b[22m Nothing from\u001b[53Gpremium, so you don't miss \u001b[82Gything\u001b[89Gafter\u001b[95Gthe\u001b[99Gswitch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets thrown away when you switch\r\u001b[2C\u001b[1B\u001b[22m- The indexer and filter records, both\u001b[42Gin\u001b[45Gthe\u001b[49Gdatabase\u001b[58Gand\u001b[62Gin\u001b[65G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m.\r\u001b[8C\u001b[1Bke_sea\u001b[16Gch compos\u001b[28Gd\u001b[30Gpen\u001b[34Gency, the sc\u001b[48Gduler task and the \u001b[38;2;177;185;249mpdftotex\u001b[76G\u001b[39m package in DDEV.\r\u001b[4C\u001b[1BOn existing installations, th\u001b[35G \u001b[38;2;177;185;249mtx_kesearch_*\u001b[39m tables: remove them with the database\u001b[88Ganalyzer\u001b[97Gafter\r\u001b[2C\u001b[1B \u001b[5Gu\u001b[7Ginstalling.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPlan the PDFs now.\u001b[22G\u001b[22mWith\u001b[27GSolr,\u001b[33Gthe\u001b[37G\"Documents\"\u001b[49Gresults\u001b[57Gneed\u001b[62GEXT:solrfal,\u001b[75Gwhich\u001b[81Gis\u001b[84Gpaid.\u001b[90GBefore\u001b[97Gyou\r\u001b[2C\u001b[1Bswitch, check whether your other site\u001b[69Gnership that covers it. Otherwise\u001b[103Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
