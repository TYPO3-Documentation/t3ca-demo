[329.778856, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B         \u001b[24G  \u001b[27G       \u001b[37G✅ built-in\u001b[49Gnews\u001b[58G✅ needs \u001b[72G✅    \u001b[83G   \r\u001b[4C\u001b[1B\u001b[1mke_search\u001b[24G\u001b[22m✅\u001b[27Gindexer\u001b[37Gindexer\u001b[58G\u001b[38;2;177;185;249mpdftotext\u001b[72G\u001b[39mface\u001b[77Gs  \u001b[83GLow\r\u001b[2C\u001b[1B│                  │            │                    │             │ via tags │                   │\r\u001b[1B\u001b[K\u001b[3G├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[1B\u001b[K\u001b[3G│\u001b[22G│\u001b[24G✅\u001b[27Gwhile\u001b[35G│\u001b[38G \u001b[37G⚠️\r\u001b[40Gonly\u001b[45Gdetail\u001b[56G│\u001b[70G│\u001b[72G❌\u001b[75Gno\u001b[81G│\u001b[101G│\r\u001b[1B\u001b[K\u001b[3G│\u001b[5Gindexed_search\u001b[22G│\u001b[24Gpages\u001b[35G│\u001b[37Gpages\u001b[43Ga\u001b[45Gvisitor\u001b[53Gor\u001b[56G│\u001b[59G \u001b[58G⚠️\r\u001b[61Gexternal\u001b[70G│\u001b[72Greal\u001b[81G│\u001b[83GMedium\u001b[101G│\r\u001b[4C\u001b[1B(core)\u001b[24Grender\u001b[37G crawler\u001b[46Ghas\u001b[59Gtools\u001b[72Gfacets\r\u001b[2C\u001b[1B│                  │            │ opened             │             │          │                   │\r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[4C\u001b[1B    \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83GHigh\u001b[88G(needs a \r\u001b[4C\u001b[1BSolr\u001b[24G✅\u001b[37G✅\u001b[58G✅\u001b[72G✅\u001b[83GS\u001b[85Glr server)\u001b[96G—   \r\u001b[82C\u001b[1Btoo much\u001b[92Gfor\u001b[96Gthis\r\u001b[2C\u001b[1B│                  │            │                    │             │          │  site             │\r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[4C\u001b[1BCustom Extbase\u001b[24G✅\u001b[37G✅\u001b[58G❌\u001b[72G✅\u001b[83GMedium,\u001b[91Gand\u001b[95Gno\r\u001b[2C\u001b[1B│ SQL \u001b[38;2;177;185;249mLIKE\u001b[39m         │            │                    │             │          │ ranking           │\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[22m News\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someon\u001b[40G opening a p\u001b[53Gge first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer a tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filter of typ\u001b[49G checkbox.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can overri\u001b[69Gackage,\u001b[77Gthe same way you already do\u001b[31;1H\u001b[29;3H\u001b[?25h"]
