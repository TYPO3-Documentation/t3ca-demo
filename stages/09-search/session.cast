[388.091868, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe registries I ch\u001b[23Gcked don'\u001b[33G name a maintainer, so most of this answ\u001b[74Gr is from memory and I haven't\u001b[K\r\u001b[2C\u001b[1Bverifi\u001b[10Gd it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mConfirmed from TER and Packagist:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe current package is \u001b[38;2;177;185;249m\u001b[1mtpwd/ke_search\u001b[22m\u001b[39m.\u001b[44GVersion\u001b[52G7.5.0\u001b[58Gcame\u001b[63Gout\u001b[67Gon\u001b[70G2026-11-13\u001b[81Gand\u001b[85Gsupports\u001b[94GTYPO3\u001b[100G13\r\u001b[4C\u001b[1Band 14.\r\u001b[2C\u001b[1B-\u001b[5GIt has about 1.3 M downloads on TER and\u001b[45Gabout 1.2 M on Packagist.\u001b[K\r\u001b[2C\u001b[1B- An\u001b[8Golder\u001b[14Gpackage,\u001b[23G\u001b[38;2;177;185;249m\u001b[1mteaminmedias-pluswerk/ke_search\u001b[22m\u001b[39m, is still\u001b[65Glisted\u001b[72Gon\u001b[75GPackagist\u001b[85Gwith\u001b[90Gabout\u001b[96G400\u001b[100Gk\r\u001b[4C\u001b[1Bdownloads.\u001b[16GThat\u001b[21Gfits\u001b[26Gthe\u001b[30Gpackage\u001b[38Ghaving\u001b[45Gmoved\u001b[51Gfrom\u001b[56Gone\u001b[60Gvendor\u001b[67Gto\u001b[70Ganother.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFrom memory:\r\u001b[1B\u001b[22m \u001b[3G- The lead developer for many years has been \u001b[1mChristian Bülter\u001b[22m.\u001b[K\r\u001b[2C\u001b[1B- \"ke\" stands for \u001b[1mKennziffer\u001b[22m, the agency that first built the extension. It then moved to team+medias\u001b[105G/\r\u001b[2C\u001b[1B  +Pluswerk, and is now with\u001b[32G\u001b[1mtpwd\u001b[22m,\u001b[38Gthe\u001b[42Gvendor\u001b[49Gin\u001b[52Gthe\u001b[56Gcurrent\u001b[64Gpackage\u001b[72Gname.\r\u001b[2C\u001b[1B-\u001b[5GIt's\u001b[10Gopen\u001b[15Gsource\u001b[22Gon\u001b[25GGitHub,\u001b[33Gand\u001b[37Gthere's\u001b[45Ga\u001b[47Gpaid\u001b[52Gsupport\u001b[60Gand\u001b[64Gsponsoring\u001b[75Goption\u001b[82G(ke_search\u001b[93Gpremium).\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTo\u001b[6Gconfirm,\u001b[15Gcheck\u001b[21Gthe\u001b[25G\u001b[38;2;177;185;249mauthors\u001b[33G\u001b[39mfield\u001b[39Gin\u001b[42G\u001b[38;2;177;185;249mcomposer.json\u001b[56G\u001b[39mand\u001b[60Gthe\u001b[64GTER\u001b[68Gpage:\r\u001b[1B \u001b[3G\u001b]8;id=mflfvs;https://extensions.typo3.org/extension/ke_search\u0007\u001b[94mhttps://extensions.typo3.org/extension/ke_search\u001b]8;;\u0007\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BSince\u001b[9Greleases\u001b[18Gcame\u001b[23Gout\u001b[27Gon\u001b[30G2026-10-09,\u001b[42G2026-11-06\u001b[53Gand\u001b[57G2026-11-13,\u001b[69Git's\u001b[74Gclearly\u001b[82Gactively\u001b[91Gmaintained.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mSautéed\u001b[11Gfor 11s · done 12:32 PM\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[38C\u001b[2B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[389.232871, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwho maintains ke_search?\u001b[39m                                                                                \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled typo3-dev-companion \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe registries\u001b[18GI\u001b[20Gchecked\u001b[28Gdon't\u001b[34Gname\u001b[39Ga\u001b[41Gmaintainer,\u001b[53Gso\u001b[56Gmost\u001b[61Gof\u001b[64Gthis\u001b[69Ganswer\u001b[76Gis\u001b[79Gfrom\u001b[84Gmemory\u001b[91Gand\u001b[95GI\u001b[97Ghaven't\r\u001b[2C\u001b[1Bverified\u001b[12Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mConfirmed from TER and Packagist:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe current\u001b[17Gpackage\u001b[25Gis\u001b[28G\u001b[38;2;177;185;249m\u001b[1mtpwd/ke_search\u001b[22m\u001b[39m.\u001b[44GVersion\u001b[52G7.5.0\u001b[58Gcame\u001b[63Gout\u001b[67Gon\u001b[70G2026-11-13\u001b[81Gand\u001b[85Gsupports\u001b[94GTYPO3\u001b[100G13\r\u001b[2C\u001b[1B \u001b[5Gand 14.\u001b[K\r\u001b[4C\u001b[1BIt\u001b[8Ghas about 1.3 M downloads on TER and about 1.2 M on Packag\u001b[69G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAn o\u001b[10Gder pack\u001b[19Gge, \u001b[38;2;177;185;249m\u001b[1mteaminmedias-pluswerk/ke_search\u001b[22m\u001b[39m,\u001b[56Gis still listed \u001b[73Gn Packagist\u001b[85Gwith\u001b[90Gabout\u001b[96G400\u001b[100Gk\r\u001b[4C\u001b[1Bdownloads.\u001b[16GThat\u001b[21Gfits\u001b[26Gthe\u001b[30Gpackage\u001b[38Ghaving\u001b[45Gmoved\u001b[51Gfrom\u001b[56Gone\u001b[60Gvendor\u001b[67Gto\u001b[70Ganother.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFrom memory:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BTh\u001b[8G lead \u001b[15Geveloper for many\u001b[33Gyears has been \u001b[1mChristian Bülter\u001b[22m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\"ke\" stands for \u001b[