[2555.389617, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3Gor our templates. ke_se\u001b[27Grch\u001b[31Gstores\u001b[38Gits index in a MyISAM table (\u001b[38;2;177;185;249mENGINE = MyISAM\u001b[39m in\u001b[86Gits \u001b[38;2;177;185;249mext_tables.sql\u001b[39m).\r\u001b[2C\u001b[1BMyISAM's fu\u001b[15Gl-text ind\u001b[26Gx leaves out \"new\" for two\u001b[53Greasons:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWord length.\u001b[19G\u001b[22m\u001b[38;2;177;185;249mft_min_word_len\u001b[35G\u001b[39mis\u001b[38G\u001b[1m4\u001b[40G\u001b[22mon\u001b[43Gthis\u001b[48Gserver,\u001b[56Gso\u001b[59Gwords\u001b[65Gof\u001b[68G1\u001b[70Gto\u001b[73G3\u001b[75Gletters\u001b[83Gnever\u001b[89Ggo\u001b[92Ginto\u001b[97Gthe\r\u001b[2C\u001b[1B  \u001b[6Gfull-text index. Lowering \u001b[38;2;177;185;249msearchWordLength\u001b[39m to 3 in ke_search only stopped the \"too\u001b[89Gshort\" message;\r\u001b[5C\u001b[1Bthe database still drops those words. \"tax\" and\u001b[54G\"fee\" fail the same way.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mStopwords.\u001b[22m MyISAM's built-in stopword\u001b[44Glist includes \u001b[1m\"new\"\u001b[22m,\u001b[65Gso it would be\u001b[80Gignored\u001b[88Geven\u001b[93Gwith\u001b[98Ga\u001b[100Glower\r\u001b[2C\u001b[1B  \u001b[6Gminimum length. The\u001b[26GInnoDB set\u001b[37Gings you may have seen (\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m) don'\u001b[96G app\u001b[101Gy to\r\u001b[5C\u001b[1Bthis tab\u001b[16G.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat\u001b[8GI\u001b[10Gchecked:\u001b[19G\u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[47G\u001b[39mreturns\u001b[55G0\u001b[57Grows,\u001b[63Gwhile\u001b[69Ga\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries. The words are in the index table, but the full-text ind\u001b[68Gx skips them.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\r\u001b[2C\u001b[1B\u001b[39m[mysqld]\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_min_word_len\u001b[19G\u001b[39m=\u001b[21G\u001b[32m3\r\u001b[5C\u001b[1B\u001b[36mstop\u001b[15Gfile\u001b[39m = \u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen\u001b[8G\u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcatch\u001b[13Gis\u001b[16Gthat\u001b[21Gthis\u001b[26Gis\u001b[29Ga\u001b[31Gserver\u001b[38Gsetting.\u001b[47GThe\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[2C\u001b[1Bproblem comes b\u001b[19Gck there,\u001b[30Gnd on shar\u001b[69Gange it.\u001b[78GTurning off stopwords\u001b[100Galso\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[2555.412825, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BMyISAM's fu\u001b[15Gl-text ind\u001b[26Gx leaves out \"new\" for two\u001b[53Greasons:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWord length.\u001b[19G\u001b[22m\u001b[38;2;177;185;249mft_min_word_len\u001b[35G\u001b[39mis\u001b[38G\u001b[1m4\u001b[40G\u001b[22mon\u001b[43Gthis\u001b[48Gserver,\u001b[56Gso\u001b[59Gwords\u001b[65Gof\u001b[68G1\u001b[70Gto\u001b[73G3\u001b[75Gletters\u001b[83Gnever\u001b[89Ggo\u001b[92Ginto\u001b[97Gthe\r\u001b[2C\u001b[1B  \u001b[6Gfull-text index. Lowering \u001b[38;2;177;185;249msearchWordLength\u001b[39m to 3 in ke_search only stopped the \"too\u001b[89Gshort\" message;\r\u001b[5C\u001b[1Bthe database still drops those words. \"tax\" and\u001b[54G\"fee\" fail the same way.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mStopwords.\u001b[22m MyISAM's built-in stopword\u001b[44Glist includes \u001b[1m\"new\"\u001b[22m,\u001b[65Gso it would be\u001b[80Gignored\u001b[88Geven\u001b[93Gwith\u001b[98Ga\u001b[100Glower\r\u001b[2C\u001b[1B  \u001b[6Gminimum length. The\u001b[26GInnoDB set\u001b[37Gings you may have seen (\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m) don'\u001b[96G app\u001b[101Gy to\r\u001b[5C\u001b[1Bthis tab\u001b[16G.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat\u001b[8GI\u001b[10Gchecked:\u001b[19G\u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[47G\u001b[39mreturns\u001b[55G0\u001b[57Grows,\u001b[63Gwhile\u001b[69Ga\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries. The words are in the index table, but the full-text ind\u001b[68Gx skips them.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\r\u001b[2C\u001b[1B\u001b[39m[mysqld]\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_min_word_len\u001b[19G\u001b[39m=\u001b[21G\u001b[32m3\r\u001b[5C\u001b[1B\u001b[36mstop\u001b[15Gfile\u001b[39m = \u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen\u001b[8G\u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcatch\u001b[13Gis\u001b[16Gthat\u001b[21Gthis\u001b[26Gis\u001b[29Ga\u001b[31Gserver\u001b[38Gsetting.\u001b[47GThe\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[2C\u001b[1Bproblem comes b\u001b[19Gck there,\u001b[30Gnd on shared hosting\u001b[51Gyou often can't change it.\u001b[78GTurning off stopwords\u001b[100Galso\r\u001b[2C\u001b[1Blets words like \"the\" match, but\u001b[36Gke_s\u001b[69Gnce,\u001b[74Gso that does little ha\u001b[97Gm.\u001b[100G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[2555.714401, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWord length.\u001b[19G\u001b[22m\u001b[38;2;177;185;249mft_min_word_len\u001b[35G\u001b[39mis\u001b[38G\u001b[1m4\u001b[40G\u001b[22mon\u001b[43Gthis\u001b[48Gserver,\u001b[56Gso\u001b[59Gwords\u001b[65Gof\u001b[68G1\u001b[70Gto\u001b[73G3\u001b[75Gletters\u001b[83Gnever\u001b[89Ggo\u001b[92Ginto\u001b[97Gthe\r\u001b[2C\u001b[1B  \u001b[6Gfull-text index. Lowering \u001b[38;2;177;185;249msearchWordLength\u001b[39m to 3 in ke_search only stopped the \"too\u001b[89Gshort\" message;\r\u001b[5C\u001b[1Bthe database still drops those words. \"tax\" and\u001b[54G\"fee\" fail the same way.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mStopwords.\u001b[22m MyISAM's built-in stopword\u001b[44Glist includes \u001b[1m\"new\"\u001b[22m,\u001b[65Gso it would be\u001b[80Gignored\u001b[88Geven\u001b[93Gwith\u001b[98Ga\u001b[100Glower\r\u001b[2C\u001b[1B  \u001b[6Gminimum length. The\u001b[26GInnoDB set\u001b[37Gings you may have seen (\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m) don'\u001b[96G app\u001b[101Gy to\r\u001b[5C\u001b[1Bthis tab\u001b[16G.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat\u001b[8GI\u001b[10Gchecked:\u001b[19G\u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[47G\u001b[39mreturns\u001b[55G0\u001b[57Grows,\u001b[63Gwhile\u001b[69Ga\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries. The words are in the index table, but the full-text ind\u001b[68Gx skips them.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\r\u001b[2C\u001b[1B\u001b[39m[mysqld]\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_min_word_len\u001b[19G\u001b[39m=\u001b[21G\u001b[32m3\r\u001b[5C\u001b[1B\u001b[36mstop\u001b[15Gfile\u001b[39m = \u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen\u001b[8G\u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcatch\u001b[13Gis\u001b[16Gthat\u001b[21Gthis\u001b[26Gis\u001b[29Ga\u001b[31Gserver\u001b[38Gsetting.\u001b[47GThe\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[2C\u001b[1Bproblem comes b\u001b[19Gck there,\u001b[30Gnd on shared hosting\u001b[51Gyou often can't change it.\u001b[78GTurning off stopwords\u001b[100Galso\r\u001b[2C\u001b[1Blets words like \"the\" match, but\u001b[36Gke_s\u001b[41Garch ra\u001b[49Gks resul\u001b[58Gs by relevance,\u001b[74Gso that does little ha\u001b[97Gm.\u001b[100G\u001b[K\r\u001b[2C\u001b[1B    \u001b[8G     \u001b[14G    \u001b[19G     \u001b[25G      \u001b[32G   \u001b[36G    \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
