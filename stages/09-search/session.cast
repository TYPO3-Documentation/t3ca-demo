[381.91257, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│\u001b[5GSQL\u001b[9G\u001b[38;2;177;185;249mLIKE\u001b[22G\u001b[39m│\u001b[35G│\u001b[56G│\u001b[70G│\u001b[81G│\u001b[83Granking\u001b[101G│\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[2B\u001b[1mWhy ke_s\u001b[12Garch\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt index\u001b[14Gs\u001b[16Gfrom\u001b[21Gthe databa\u001b[32Ge, not from rendered pages.\u001b[22m News records get indexed without a crawler,\u001b[104Gand\r\u001b[4C\u001b[1Bt\u001b[8G index do\u001b[18Gsn't\u001b[23Gdep\u001b[27Gnd on someon\u001b[40G opening a page first.\r\u001b[8C\u001b[1B\u001b[1mfilter\u001b[16Gmaps onto facets.\u001b[34G\u001b[22mGive each indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\u001b[K\r\u001b[4C\u001b[1Bcheckboxes b\u001b[18Gcome a ke_search filter of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[26G\u001b[22mYou\u001b[30Gcan\u001b[34Goverride\u001b[43Gthe\u001b[47Gtemplates\u001b[57Gin\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[4C\u001b[1Bfor\u001b[9GNews\u001b[14Gunder\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[39m (ch\u001b[42Gck\u001b[45Gthe\u001b[49GC\u001b[51Gmpose\u001b[57G name with \u001b[38;2;177;185;249mcomposer show\u001b[39m), then run \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"S\u001b[15Garch indexe\u001b[27G\" storage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content\u001b[22Gtree),\u001b[29Gnews\u001b[34G(pointing at the \"News records\" folder) and files\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds\u001b[24Gits\u001b[28Gtag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCrea\u001b[11Ge\u001b[13Ga fil\u001b[19Ger\u001b[22G\"Typ\u001b[27G\" with three opt\u001b[44Gons whose tag\u001b[58G match the indexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place the \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (\u001b[96G\"Sidebar\r\u001b[5C\u001b[1Bright\" layout), or render \u001b[33Ghe\u001b[36Gfacets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m k\u001b[33G_searc\u001b[40G reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either\u001b[85Grename the input in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.f\u001b[15Guid.html\u001b[24G\u001b[39m(and\u001b[29Gs\u001b[31Gitch\u001b[36Gthe\u001b[69G\u001b[38;2;177;185;249mh_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[381.926431, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B   \u001b[9G    \u001b[83G site  \r\u001b[2C\u001b[1B├\u001b[22G┼\u001b[35G┼\u001b[56G┼\u001b[70G┼\u001b[81G┼\u001b[101G┤\r\u001b[2C\u001b[1B│\u001b[5GCustom\u001b[12GExtbase\u001b[22G│\u001b[24G✅\u001b[35G│\u001b[37G✅\u001b[56G│\u001b[58G❌\u001b[70G│\u001b[72G✅\u001b[81G│\u001b[83GMedium,\u001b[91Gand\u001b[95Gno\u001b[101G│\r\u001b[2C\u001b[1B│ SQL \u001b[38;2;177;185;249mLIKE\u001b[39m   \u001b[22G│\u001b[35G│\u001b[56G│\u001b[70G│\u001b[81G│\u001b[83Granking\u001b[101G│\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend\u001b[30Gon s\u001b[35Gm\u001b[37Gone opening a p\u001b[53Gg\u001b[55G f\u001b[58Grs\u001b[61G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give each indexer a tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\r\u001b[4C\u001b[1Bcheckboxes\u001b[16Gbecome\u001b[23Ga\u001b[25Gke_search\u001b[35Gfilter\u001b[42Gof\u001b[45Gtype\u001b[50Gcheckbox.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[26G\u001b[22mYou\u001b[30Gcan\u001b[34Goverride\u001b[43Gthe\u001b[47Gtemplates\u001b[57Gin\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B  for News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[39m (check \u001b[46Ghe Composer name with \u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen run \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2\u001b[6GAdd a \"Search indexes\u001b[29Gstorage folder, and c\u001b[51Gnfigure\u001b[59Gthree\u001b[65Gindexers there:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservic\u001b[13G/content tree), news (pointing at the \"News records\" folder) and files (fileadmin docum\u001b[101Gnts).\r\u001b[5C\u001b[1BEac\u001b[10G indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6GCreate a filter \"Type\" with three options whose tags match the indexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place\u001b[24Gthe \u001b[1msearch box +\u001b[69G\u001b[22mthe filter in \u001b[38;2;177;185;249msidebar\u001b[39m (the \"Si\u001b[100Geb\u001b[103Gr\u001b[31;1H\u001b[29;3H\u001b[?25h"]
