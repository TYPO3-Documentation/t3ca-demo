[673.04999, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│ Configset                    │ \u001b[38;2;177;185;249mext_solr_14_0_0\u001b[39m                         │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf th\u001b[11Gy're\u001b[16Gon EXT:solr 13 or ol\u001b[37Ger, their Solr server is most likely \u001b[1mversion 9\u001b[22m. Th\u001b[88Gt server c\u001b[99Gn't \u001b[104Gost\r\u001b[4C\u001b[1Ba co\u001b[10Ge for this site. You'd need a Solr 10 instance, or upgrade the\u001b[73Gshared\u001b[80Gserver\u001b[87Galong\u001b[93Gwith\u001b[98Gall\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gother sit\u001b[15Gs, which\u001b[24Galso means a sc\u001b[40Gema update and a full\u001b[62Gre-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they're\u001b[16Galready\u001b[24Gon\u001b[27GTYPO3\u001b[33G14\u001b[36Gwith\u001b[41GEXT:solr\u001b[50G14,\u001b[54Gyou\u001b[58Gcan\u001b[62Gadd\u001b[66Ga\u001b[68Gcore\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou\u001b[9Gcan\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[22m I said Solr\u001b[45Gcovers PDFs through\u001b[65GTika. That's only half r\u001b[90Gght. T\u001b[97Gka\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom\u001b[50Gfileadmin \u001b[61Gnto the index, \u001b[1mEXT:solrfal\u001b[22m, is a paid\u001b[K\r\u001b[2C\u001b[1Bfundi\u001b[9Gg-contribution extension. Pages and new\u001b[49G are\u001b[54Gfre\u001b[58G wit\u001b[63G Solr. For the \"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign you'd need \u001b[22Golrfal, unless\u001b[37Gyour\u001b[42Gother\u001b[48Gsites\u001b[54Galready\u001b[62Ghave\u001b[67Ga\u001b[69Gfunding\u001b[77Gpartnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree\u001b[8Gke_search\u001b[18Gdoes\u001b[23Gindex\u001b[29GPDFs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b[39m\u001b]8;;\u0007\u001b[31;1H\u001b[29;5H\u001b[?25h"]
[673.262204, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Configset                    │ \u001b[38;2;177;185;249mext_solr_14_0_0\u001b[39m                         │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf th\u001b[11Gy're\u001b[16Gon EXT:solr 13 or ol\u001b[37Ger, their Solr server is most likely \u001b[1mversion 9\u001b[22m. Th\u001b[88Gt server c\u001b[99Gn't \u001b[104Gost\r\u001b[4C\u001b[1Ba co\u001b[10Ge for this site. You'd need a Solr 10 instance, or upgrade the\u001b[73Gshared\u001b[80Gserver\u001b[87Galong\u001b[93Gwith\u001b[98Gall\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gother sit\u001b[15Gs, which\u001b[24Galso means a sc\u001b[40Gema update and a full\u001b[62Gre-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they're\u001b[16Galready\u001b[24Gon\u001b[27GTYPO3\u001b[33G14\u001b[36Gwith\u001b[41GEXT:solr\u001b[50G14,\u001b[54Gyou\u001b[58Gcan\u001b[62Gadd\u001b[66Ga\u001b[68Gcore\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou\u001b[9Gcan\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[22m I said Solr\u001b[45Gcovers PDFs through\u001b[65GTika. That's only half r\u001b[90Gght. T\u001b[97Gka\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom\u001b[50Gfileadmin \u001b[61Gnto the index, \u001b[1mEXT:solrfal\u001b[22m, is a paid\u001b[K\r\u001b[2C\u001b[1Bfundi\u001b[9Gg-contribution extension. Pages and new\u001b[49G are\u001b[54Gfre\u001b[58G wit\u001b[63G Solr. For the \"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign you'd need \u001b[22Golrfal, unless\u001b[37Gyour\u001b[42Gother\u001b[48Gsites\u001b[54Galready\u001b[62Ghave\u001b[67Ga\u001b[69Gfunding\u001b[77Gpartnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree\u001b[8Gke_search\u001b[18Gdoes\u001b[23Gindex\u001b[29GPDFs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b[39m\u001b]8;;\u0007\u001b[31;1H\u001b[29;5H\u001b[?25h"]
[673.301565, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│ Apache Solr server           │ \u001b[1m10.0.0\u001b[22m, a hard requirement since 14.0.0 │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Configset                    │ \u001b[38;2;177;185;249mext_solr_14_0_0\u001b[39m                         │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf th\u001b[11Gy're\u001b[16Gon EXT:solr 13 or ol\u001b[37Ger, their Solr server is most likely \u001b[1mversion 9\u001b[22m. Th\u001b[88Gt server c\u001b[99Gn't \u001b[104Gost\r\u001b[4C\u001b[1Ba co\u001b[10Ge for this site. You'd need a Solr 10 instance, or upgrade the\u001b[73Gshared\u001b[80Gserver\u001b[87Galong\u001b[93Gwith\u001b[98Gall\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gother sit\u001b[15Gs, which\u001b[24Galso means a sc\u001b[40Gema update and a full\u001b[62Gre-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they're\u001b[16Galready\u001b[24Gon\u001b[27GTYPO3\u001b[33G14\u001b[36Gwith\u001b[41GEXT:solr\u001b[50G14,\u001b[54Gyou\u001b[58Gcan\u001b[62Gadd\u001b[66Ga\u001b[68Gcore\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou\u001b[9Gcan\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[22m I said Solr\u001b[45Gcovers PDFs through\u001b[65GTika. That's only half r\u001b[90Gght. T\u001b[97Gka\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom\u001b[50Gfileadmin \u001b[61Gnto the index, \u001b[1mEXT:solrfal\u001b[22m, is a paid\u001b[K\r\u001b[2C\u001b[1Bfundi\u001b[9Gg-contribution extension. Pages and new\u001b[49G are\u001b[54Gfre\u001b[58G wit\u001b[63G Solr. For the \"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign you'd need \u001b[22Golrfal, unless\u001b[37Gyour\u001b[42Gother\u001b[48Gsites\u001b[54Galready\u001b[62Ghave\u001b[67Ga\u001b[69Gfunding\u001b[77Gpartnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree\u001b[8Gke_search\u001b[18Gdoes\u001b[23Gindex\u001b[29GPDFs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\u001b[39m      \u001b[31;1H\u001b[29;5H\u001b[?25h"]
[673.316611, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Apache Solr server           │ \u001b[1m10.0.0\u001b[22m, a hard requirement since 14.0.0 │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Configset                    │ \u001b[38;2;177;185;249mext_solr_14_0_0\u001b[39m                         │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf th\u001b[11Gy're\u001b[16Gon EXT:solr 13 or ol\u001b[37Ger, their Solr server is most likely \u001b[1mversion 9\u001b[22m. Th\u001b[88Gt server c\u001b[99Gn't \u001b[104Gost\r\u001b[4C\u001b[1Ba co\u001b[10Ge for this site. You'd need a Solr 10 instance, or upgrade the\u001b[73Gshared\u001b[80Gserver\u001b[87Galong\u001b[93Gwith\u001b[98Gall\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gother sit\u001b[15Gs, which\u001b[24Galso means a sc\u001b[40Gema update and a full\u001b[62Gre-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they're\u001b[16Galready\u001b[24Gon\u001b[27GTYPO3\u001b[33G14\u001b[36Gwith\u001b[41GEXT:solr\u001b[50G14,\u001b[54Gyou\u001b[58Gcan\u001b[62Gadd\u001b[66Ga\u001b[68Gcore\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GYou\u001b[9Gcan\u001b[13Gask\u001b[17Gthe\u001b[21Gexisting\u001b[30Gserver\u001b[37Gfor\u001b[41Gits\u001b[45Gversion\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[22m I said Solr\u001b[45Gcovers PDFs through\u001b[65GTika. That's only half r\u001b[90Gght. T\u001b[97Gka\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom\u001b[50Gfileadmin \u001b[61Gnto the index, \u001b[1mEXT:solrfal\u001b[22m, is a paid\u001b[K\r\u001b[2C\u001b[1Bfundi\u001b[9Gg-contribution extension. Pages and new\u001b[49G are\u001b[54Gfre\u001b[58G wit\u001b[63G Solr. For the \"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign you'd need \u001b[22Golrfal, unless\u001b[37Gyour\u001b[42Gother\u001b[48Gsites\u001b[54Galready\u001b[62Ghave\u001b[67Ga\u001b[69Gfunding\u001b[77Gpartnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree\u001b[8Gke_search\u001b[18Gdoes\u001b[23Gindex\u001b[29GPDFs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:                 \u001b[31;1H\u001b[29;5H\u001b[?25h"]
[673.333086, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│ EXT:solr                     │ 14.0.x (latest is 14.0.2)               │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Apache Solr server           │ \u001b[1m10.0.0\u001b[22m, a hard requirement since 14.0.0 │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Configset                    │ \u001b[38;2;177;185;249mext_solr_14_0_0\u001b[39m                         │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:tika (text from PDFs)    │ 14.0                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ EXT:solrfal (indexing files) │ 14.0, \u001b[1mfunding contribution, so paid\u001b[22m     │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf th\u001b[11Gy're\u001b[16Gon EXT:solr 13 or ol\u001b[37Ger, their Solr server is most likely \u001b[1mversion 9\u001b[22m. Th\u001b[88Gt server c\u001b[99Gn't \u001b[104Gost\r\u001b[4C\u001b[1Ba co\u001b[10Ge for this site. You'd need a Solr 10 instance, or upgrade the\u001b[73Gshared\u001b[80Gserver\u001b[87Galong\u001b[93Gwith\u001b[98Gall\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gother sit\u001b[15Gs, which\u001b[24Galso means a sc\u001b[40Gema update and a full\u001b[62Gre-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf they're\u001b[16Galready\u001b[24Gon\u001b[27GTYPO3\u001b[33G14\u001b[36Gwith\u001b[41GEXT:solr\u001b[50G14,\u001b[54Gyou\u001b[58Gcan\u001b[62Gadd\u001b[66Ga\u001b[68Gcore\u001b[73Gfor\u001b[77Gthis\u001b[82Gsite\u001b[87Gto\u001b[90Gthe\u001b[94Gexisting\r\u001b[