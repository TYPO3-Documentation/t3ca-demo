[653.954909, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat it costs:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThis site\u001b[15Gneeds\u001b[21Gits\u001b[25Gown\u001b[29GSolr\u001b[34Gcore\u001b[39Gon\u001b[42Gyour\u001b[47GSolr\u001b[52Gserver,\u001b[60Gplus\u001b[65GTika\u001b[70Gif\u001b[73Gyou\u001b[77Gwant\u001b[82GPDF\u001b[86Gtext.\r\u001b[4C\u001b[1BLocal\u001b[11Gdevelopm\u001b[20Gnt needs Solr in DDEV, for example the \u001b[38;2;177;185;249mddev/ddev-solr\u001b[39m add-on with the configse\u001b[99Gs from\u001b[K\r\u001b[4C\u001b[1BEXT:solr.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSetup\u001b[11Gis\u001b[14Gheavier\u001b[22Gthan\u001b[27Gke_search:\u001b[38Gconnection\u001b[49Gsettings\u001b[58Gper\u001b[62Gsite,\u001b[68Gan\u001b[71Gindex\u001b[77Gqueue,\u001b[84Gand\u001b[88Gscheduler\u001b[98Gtasks.\u001b[105GA\r\u001b[2C\u001b[1B  fresh install\u001b[19Gfrom\u001b[24Gthe\u001b[28Gdistribution\u001b[41Galso\u001b[46Gonly\u001b[51Ggets\u001b[56Gworking\u001b[64Gsearch\u001b[71Gif\u001b[74GSolr\u001b[79Gis\u001b[82Greachable.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to decide:\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[1mSolr\u001b[22m if th\u001b[20Gs\u001b[22Gsite\u001b[27Ggoes\u001b[32Glive on the same\u001b[49Gh\u001b[51Gsting as your other sites, or if\u001b[84Gsearch\u001b[91Gshould behave\r\u001b[4C\u001b[1Bthe same across all of\u001b[28Gthem\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUse ke_search\u001b[19G\u001b[22mif\u001b[22Gthis\u001b[27Gis\u001b[30Ga\u001b[32Gstandalone\u001b[43Gdemo,\u001b[49Gfor\u001b[53Gexample\u001b[61Ga\u001b[63Gconference\u001b[74Gdemo\u001b[79Gthat\u001b[84Ghas\u001b[88Gto\u001b[91Gcome\u001b[96Gup\u001b[99Gwith\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mddev start\u001b[39m and nothing else.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCan\u001b[7Gyou\u001b[11Gconfirm\u001b[19Gthe\u001b[23Gother\u001b[29Gsites\u001b[35Guse\u001b[39GSolr,\u001b[45Gand\u001b[49Gtell\u001b[54Gme\u001b[57Gwhat\u001b[62Gthis\u001b[67Gsite\u001b[72Gis\u001b[75Gfor?\u001b[80GThen\u001b[85GI'll\u001b[90Gplan\u001b[95Gthe\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249m09-search\u001b[39m stage the right way.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mCrunched for 9s · done 12:35 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhat core version would we need\u001b[39m                                                                         \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mFetch\u001b[22m(https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mReceived\u001b[15G\u001b[1m148 bytes\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m›\u001b[3GMessage from @web-fetch (ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✽\u001b[39m \u001b[38;2;223;134;102mHarmonizing…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(21s · ↓\u001b[25G2.6k tokens)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;153;153;153m❯ \r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;2;255;193;7m⏵⏵ auto mode on\u001b[38;2;153;153;153m (shift+tab to cycle) · esc to interrupt\u001b[85G\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
