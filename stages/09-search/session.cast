n\u001b[53Gin\u001b[56Gthe\u001b[60GSolr\u001b[65Gadmin\u001b[71GUI\u001b[74Gor\u001b[77Gat\u001b[80G\u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[33G\u001b[22mI\u001b[35Gsaid\u001b[40GSolr\u001b[45Gcovers\u001b[52GPDFs\u001b[57Gthrough\u001b[65GTika.\u001b[71GThat's\u001b[78Gonly\u001b[83Ghalf\u001b[88Gright.\u001b[95GTika\u001b[100Gis\u001b[103Gopen\r\u001b[2C\u001b[1Bsource, but the extension that puts files\u001b[45Gfrom fileadmin into\u001b[65Gthe index, \u001b[1mEXT:solrfal\u001b[22m, \u001b[90Gs a pa\u001b[97Gd\u001b[K\r\u001b[2C\u001b[1Bfunding-contribution extension. Pages and\u001b[45Gnews\u001b[50Gare free w\u001b[61Gth Solr. For the \"Documents\" results in\u001b[101Gthe\r\u001b[2C\u001b[1Bdesig\u001b[9G you'd need solrfal, unless your other \u001b[49Gites\u001b[54Galr\u001b[58Gady \u001b[63Gave a funding partnership that includes it.\r\u001b[2C\u001b[1BFree ke_search doe\u001b[22G index PDFs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[31;1H\u001b[29;5H\u001b[?25h"]
[672.047171, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[2BConfigset  \u001b[17G      \u001b[36G\u001b[38;2;177;185;249mext_solr_14_0_0\u001b[39m           \u001b[63G     \u001b[69G      \r\u001b[4C\u001b[2BEXT:tika (text\u001b[20Gfrom\u001b[25GPDFs)\u001b[36G14.0           \r\u001b[8C\u001b[2Bsolrfal (indexing files)\u001b[40G,\u001b[42G\u001b[1mfunding contribution, so paid\r\u001b[2C\u001b[1B\u001b[22m└\u001b[34G┴\u001b[76G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means for your other sites:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf\u001b[8Gthey're\u001b[16Gon\u001b[19GEXT:solr\u001b[28G13\u001b[31Gor\u001b[34Golder,\u001b[41Gtheir\u001b[47GSolr\u001b[52Gserver\u001b[59Gis\u001b[62Gmost\u001b[67Glikely\u001b[74G\u001b[1mversion 9\u001b[22m.\u001b[85GThat\u001b[90Gserver\u001b[97Gcan't\u001b[103Ghost\r\u001b[2C\u001b[1B  a core for this site. You'd need a Solr\u001b[45G10\u001b[48Ginstance,\u001b[58Gor\u001b[61Gupgrade\u001b[69Gthe\u001b[73Gshared\u001b[80Gserver\u001b[87Galong\u001b[93Gwith\u001b[98Gall\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gother sit\u001b[15Gs, which a\u001b[26Gso means a schema update and a full\u001b[62Gre-index.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIf th\u001b[11Gy're\u001b[16Galready on\u001b[27GTYPO3\u001b[33G14 with EXT:solr 14, you\u001b[58Gcan add a cor\u001b[73Gfor thi\u001b[81G site\u001b[87Gto the existing\u001b[K\r\u001b[4C\u001b[1Bserver.\u001b[K\r\u001b[4C\u001b[1BYou can ask th\u001b[20G existing server for\u001b[41Gits version in the Solr admin UI \u001b[77Gat \u001b[38;2;177;185;249m/solr/admin/info/system\u001b[39m.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCorrection to my last answer:\u001b[22m I said Solr\u001b[45Gcovers PDFs through\u001b[65GTika.\u001b[71GThat's only half right. Tika is open\r\u001b[2C\u001b[1Bsource,\u001b[11Gbut\u001b[15Gthe\u001b[19Gextension\u001b[29Gthat\u001b[34Gputs\u001b[39Gfiles\u001b[45Gfrom\u001b[50Gfileadmin\u001b[60Ginto\u001b[65Gthe\u001b[69Gindex,\u001b[76G\u001b[1mEXT:solrfal\u001b[22m,\u001b[89Gis\u001b[92Ga\u001b[94Gpaid\r\u001b[2C\u001b[1Bfunding-contribution extension.\u001b[35GP\u001b[37Gges and\u001b[45Gnews are free with Solr. For \u001b[75Ghe\u001b[78G\"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign yo\u001b[13G'd n\u001b[18Ged solrfal, unless your othe\u001b[47G sites \u001b[55Glready have a\u001b[69Gfunding partnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree ke_search does index PDFs\u001b[35G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m- \u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b[39m\u001b]8;;\u0007\u001b[31;1H\u001b[29;5H\u001b[?25h"]
