249mResources/Private/Extensions/\u001b[39m, and reproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[2B\u001b[22m1. \u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[5C\u001b[1Bextension:setup\u001b[39m.\r\u001b[2C\u001b[1B2\u001b[6GAdd a \"Search indexes\" storage fold\u001b[42Gr,\u001b[45Gand\u001b[49Gc\u001b[51Gnfigu\u001b[57Ge three indexers there: pages (limited to the\r\u001b[5C\u001b[1Bservice/content tree),\u001b[29Gnews\u001b[34G(point\u001b[68Glder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\u001b[31;1H\u001b[29;3H\u001b[?25h"]
