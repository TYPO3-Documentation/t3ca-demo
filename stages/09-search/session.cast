[1963.438025, "o", "\u001b[?25l\u001b[H\u001b[5Gfresh import, where it\u001b[30Gthe only filt\u001b[44Gr, and the README says\u001b[67Gso.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo bugs from earlier stages, not fixed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mThe p\u001b[12Gge IDs in the site se\u001b[34Gtings are wrong on a fresh\u001b[61Ginstal\u001b[68G.\u001b[22m The README says\u001b[86Ga fresh import k\u001b[103Geps\r\u001b[4C\u001b[1B the sa\u001b[13Ge IDs, but it doesn't. Search landed on 20 instead of\u001b[67G16,\u001b[71Gso\u001b[74Gthe\u001b[78Gheader\u001b[85Gsearch\u001b[92Gform\u001b[97Gsent\r\u001b[5C\u001b[1Bpeople\u001b[13Gto\u001b[16G\"Access\u001b[24Gto\u001b[27Ginformation\".\u001b[41GThe\u001b[45Gservice\u001b[53Gand\u001b[57Gfooter\u001b[64Gmenus\u001b[70G(22/23)\u001b[78Gand\u001b[82Gthe\u001b[86G404\u001b[90Gpage\u001b[95G(33)\u001b[100Gare\r\u001b[2C\u001b[1B   also off.\u001b[K\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mEv\u001b[9Gry n\u001b[14Gws item\u001b[22Ggets th\u001b[31G\"Education\" category on\u001b[55Ga fresh install,\u001b[22m on top of it\u001b[86Greal one.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I fix\u001b[16Gthos\u001b[21G two next? Otherwise I can commit this as \"Stage\u001b[70G09-search\" now.\u001b[86G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 9m 33s · done 12:48 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mSite search now works with the free ke_search, tested on a fresh install, and is ready to commit \r\u001b[2C\u001b[1Bas \"Stage 09-search\". Your call: should I commit it now, or first fix two earlier-stage bugs that break \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mthe header search on fresh installs? (turn off recaps in /config)\r\u001b[2B\u001b[23m\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mWhy does \"new\" not find anything?\u001b[39m                                                                       \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ddev mysql -e \"select engine from information_schema.tables where table_schema='db' and \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mtable_name='tx_kesearch_index'; show variables where Variable_name in ('ft_min_word_len','innodb_ft_m\r\u001b[5C\u001b[1Bin_token_size','innodb_ft_enable_stopword','ft_stopword_file','innodb_ft_server_stopword_table'); \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mselect cou…\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
