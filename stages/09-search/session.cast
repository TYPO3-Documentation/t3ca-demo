[381.353803, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[2B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[39m (ch\u001b[42Gck\u001b[45Gthe\u001b[49GC\u001b[51Gmpose\u001b[57G name with \u001b[38;2;177;185;249mcomposer show\u001b[39m), then run \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"S\u001b[15Garch indexe\u001b[27G\" storage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content\u001b[22Gtree),\u001b[29Gnews\u001b[34G(pointing at the \"News records\" folder) and files\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds\u001b[24Gits\u001b[28Gtag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCrea\u001b[11Ge\u001b[13Ga fil\u001b[19Ger\u001b[22G\"Typ\u001b[27G\" with three opt\u001b[44Gons whose tag\u001b[58G match the indexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place the \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (\u001b[96G\"Sidebar\r\u001b[5C\u001b[1Bright\" layout), or render \u001b[33Ghe\u001b[36Gfacets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m k\u001b[33G_searc\u001b[40G reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either\u001b[85Grename the input in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.f\u001b[15Guid.html\u001b[24G\u001b[39m(and\u001b[29Gs\u001b[31Gitch\u001b[36Gthe\u001b[40GcHash\u001b[46Gexclusion\u001b[56Gto\u001b[59G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\r\u001b[2C\u001b[1B  \u001b[6Gsmall route enhancer/m\u001b[30Gdlewar\u001b[37G that maps it. I'd rename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes\u001b[29Gaway.\r\u001b[2C\u001b[1B6\u001b[6GPut the template overr\u001b[29Gdes under \u001b[38;2;177;185;249mR\u001b[41Gsources/Pr\u001b[52Gvate/Extensions/KeSearch/\u001b[39m and wire them th\u001b[96Gugh the\u001b[K\r\u001b[5C\u001b[1Bsit\u001b[10G set's\u001b[17GTypoScript.\u001b[K\r\u001b[2C\u001b[1B7\u001b[6GSchedule the indexer with\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe scheduler or as a DDEV\u001b[93Gcron job.\u001b[103GFor\r\u001b[5C\u001b[1Ba demo you can also run it by hand after im\u001b[51Grt.\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add\u001b[32Gthe\u001b[36Gindexer\u001b[44Gand\u001b[48Gfilter\u001b[55Grecords\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[5C\u001b[1Binstall\u001b[14Ghas\u001b[18Gsearch\u001b[25Gworking.\u001b[34GAdd\u001b[38G\u001b[38;2;177;185;249mpdftotext\u001b[48G\u001b[39m(poppler-utils)\u001b[64Gto\u001b[67G\u001b[38;2;177;185;249m.ddev/config.yaml\u001b[85G\u001b[39mwith\r\u001b[2C\u001b[1B \u001b[5G \u001b[38;2;177;185;249mwebimage_extra_packages\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gchecked\u001b[13GTER\u001b[17Gfor\u001b[21Gke_search's\u001b[33Gversions;\u001b[43GI\u001b[45Ghaven't\u001b[53Ginstalled\u001b[63Git\u001b[66Gor\u001b[69Gtested\u001b[76Gany\u001b[80Gof\u001b[83Gthese\u001b[89Gsteps\u001b[95Ghere\u001b[100Gyet.\r\u001b[1B \u001b[3GWant me to go ahead with it as the\u001b[38Gne\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[381.381313, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bfor\u001b[9GNews\u001b[14Gunder\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[39m (ch\u001b[42Gck\u001b[45Gthe\u001b[49GC\u001b[51Gmpose\u001b[57G name with \u001b[38;2;177;185;249mcomposer show\u001b[39m), then run \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"S\u001b[15Garch indexe\u001b[27G\" storage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content\u001b[22Gtree),\u001b[29Gnews\u001b[34G(pointing at the \"News records\" folder) and files\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds\u001b[24Gits\u001b[28Gtag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCrea\u001b[11Ge\u001b[13Ga fil\u001b[19Ger\u001b[22G\"Typ\u001b[27G\" with three opt\u001b[44Gons whose tag\u001b[58G match the indexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place the \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (\u001b[96G\"Sidebar\r\u001b[5C\u001b[1Bright\" layout), or render \u001b[33Ghe\u001b[36Gfacets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m k\u001b[33G_searc\u001b[40G reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either\u001b[85Grename the input in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.f\u001b[15Guid.html\u001b[24G\u001b[39m(and\u001b[29Gs\u001b[31Gitch\u001b[36Gthe\u001b[40GcHash\u001b[46Gexclusion\u001b[56Gto\u001b[59G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\r\u001b[2C\u001b[1B  \u001b[6Gsmall route enhancer/m\u001b[30Gdlewar\u001b[37G that maps it. I'd rename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes\u001b[29Gaway.\r\u001b[2C\u001b[1B6\u001b[6GPut the template overr\u001b[29Gdes under \u001b[38;2;177;185;249mR\u001b[41Gsources/Pr\u001b[52Gvate/Extensions/KeSearch/\u001b[39m and wire them th\u001b[96Gugh the\u001b[K\r\u001b[5C\u001b[1Bsit\u001b[10G set's\u001b[17GTypoScript.\u001b[K\r\u001b[2C\u001b[1B7\u001b[6GSchedule the indexer with\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe scheduler or as a DDEV\u001b[93Gcron job.\u001b[103GFor\r\u001b[5C\u001b[1Ba demo you can also run it by hand after im\u001b[51Grt.\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add\u001b[32Gthe\u001b[36Gindexer\u001b[44Gand\u001b[48Gfilter\u001b[55Grecords\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[5C\u001b[1Binstall\u001b[14Ghas\u001b[18Gsearch\u001b[25Gworking.\u001b[34GAdd\u001b[38G\u001b[38;2;177;185;249mpdftotext\u001b[48G\u001b[39m(poppler-utils)\u001b[64Gto\u001b[67G\u001b[38;2;177;185;249m.ddev/config.yaml\u001b[85G\u001b[39mwith\r\u001b[2C\u001b[1B \u001b[5G \u001b[38;2;177;185;249mwebimage_extra_packages\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B    \u001b[8G  \u001b[11G  \u001b[14G  \u001b[17G     \u001b[23G    \u001b[28G  \u001b[31G  \u001b[34G   \u001b[38G  \u001b[31;1H\u001b[29;3H\u001b[?25h"]
[381.604432, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the templates in the sit\u001b[68Gpackage,\u001b[77Gthe same way you already do\r\u001b[4C\u001b[1Bfor News under\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcompo\u001b[12Ger require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search index\u001b[26Gs\"\u001b[29Gstorage folder, and configure th\u001b[62Gee index\u001b[72Gs\u001b[74Gthere: pages (limited to the\u001b[K\r\u001b[5C\u001b[1Bservice/content tree), news\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6GCreate a filter \"Typ\u001b[27G\" with three options whose tags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or render the fa\u001b[39Gets in\u001b[46Gide your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either \u001b[86Gename\u001b[92Gthe input\u001b[102Gin\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion\u001b[56Gto \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), or keep \u001b[38;2;177;185;249mq\u001b[39m and add a\r\u001b[5C\u001b[1Bsmall route enhancer/middleware\u001b[38Gthat\u001b[43Gmaps\u001b[48Git.\u001b[52GI'd\u001b[56Grename\u001b[63Git:\u001b[67Git's\u001b[72Gsimpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPu\u001b[9G th\u001b[13G template overrides\u001b[33Gunder\u001b[39G\u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsit\u001b[10G set's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSch\u001b[10Gdule the indexer with the\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe\u001b[70Gscheduler\u001b[80Gor\u001b[83Gas\u001b[86Ga\u001b[88GDDEV\u001b[93Gcron\u001b[98Gjob.\u001b[103GFor\r\u001b[2C\u001b[1B  \u001b[6Ga demo you can also run it by\u001b[36Ghand after import.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add the indexer and\u001b[48Gfilter \u001b[56Gecord\u001b[62G to \u001b[38;2;177;185;249mInitialisat\u001b[78Gon/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[5C\u001b[1Binstall has search working.\u001b[34GAdd\u001b[38G\u001b[38;2;177;185;249mpdftotext\u001b[48G\u001b[39m(poppler-utils)\u001b[64Gto\u001b[67G\u001b[38;2;177;185;249m.ddev/config.yaml\u001b[85G\u001b[39mwith\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mwebimage_extra_packages\u001b[39m.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[381.620525, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filter of typ\u001b[49G checkbox.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the templates in the sit\u001b[68Gpackage,\u001b[77Gthe same way you already do\r\u001b[4C\u001b[1Bfor News under\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcompo\u001b[12Ger require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search index\u001b[26Gs\"\u001b[29Gstorage folder, and configure th\u001b[62Gee index\u001b[72Gs\u001b[74Gthere: pages (limited to the\u001b[K\r\u001b[5C\u001b[1Bservice/content tree), news\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6GCreate a filter \"Typ\u001b[27G\" with three options whose tags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or render the fa\u001b[39Gets in\u001b[46Gide your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either \u001b[86Gename\u001b[92Gthe input\u001b[102Gin\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion\u001b[56Gto \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), or keep \u001b[38;2;177;185;249mq\u001b[39m and add a\r\u001b[5C\u001b[1Bsmall route enhancer/middleware\u001b[38Gthat\u001b[43Gmaps\u001b[48Git.\u001b[52GI'd\u001b[56Grename\u001b[63Git:\u001b[67Git's\u001b[72Gsimpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPu\u001b[9G th\u001b[13G template overrides\u001b[33Gunder\u001b[39G\u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsit\u001b[10G set's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSch\u001b[10Gdule the indexer with the\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe\u001b[70Gscheduler\u001b[80Gor\u001b[83Gas\u001b[86Ga\u001b[88GDDEV\u001b[93Gcron\u001b[98Gjob.\u001b[103GFor\r\u001b[2C\u001b[1B  \u001b[6Ga demo you can also run it by\u001b[36Ghand after import.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add the indexer and\u001b[48Gfilter \u001b[56Gecord\u001b[62G to \u001b[38;2;177;185;249mInitialisat\u001b[78Gon/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[5C\u001b[1Binstall has search working.\u001b[34GAdd\u001b[38G\u001b[38;2;177;185;249mpd\u001b[69Gdev/config.yaml\u001b[85G\u001b[39mwith\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[381.63478, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bt\u001b[8G index do\u001b[18Gsn't\u001b[23Gdep\u001b[27Gnd on someon\u001b[40G opening a page first.\r\u001b[8C\u001b[1B\u001b[1mfilter\u001b[16Gmaps onto facets.\u001b[34G\u001b[22mGive each indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\u001b[K\r\u001b[4C\u001b[1Bcheckboxes b\u001b[18Gcome a ke_search filter of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[26G\u001b[22mYou\u001b[30Gcan\u001b[34Goverride\u001b[43Gthe\u001b[47Gtemplates\u001b[57Gin\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[4C\u001b[1Bfor\u001b[9GNews\u001b[14Gunder\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[39m (ch\u001b[42Gck\u001b[45Gthe\u001b[49GC\u001b[51Gmpose\u001b[57G name with \u001b[38;2;177;185;249mcomposer show\u001b[39m), then run \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"S\u001b[15Garch indexe\u001b[27G\" storage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content\u001b[22Gtree),\u001b[29Gnews\u001b[34G(pointing at the \"News records\" folder) and files\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds\u001b[24Gits\u001b[28Gtag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCrea\u001b[11Ge\u001b[13Ga fil\u001b[19Ger\u001b[22G\"Typ\u001b[27G\" with three opt\u001b[44Gons whose tag\u001b[58G match the indexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place the \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (\u001b[96G\"Sidebar\r\u001b[5C\u001b[1Bright\" layout), or render \u001b[33Ghe\u001b[36Gfacets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m k\u001b[33G_searc\u001b[40G reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either\u001b[85Grename the input in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.f\u001b[15Guid.html\u001b[24G\u001b[39m(and\u001b[29Gs\u001b[31Gitch\u001b[36Gthe\u001b[40GcHash\u001b[46Gexclusion\u001b[56Gto\u001b[59G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\r\u001b[2C\u001b[1B  \u001b[6Gsmall route enhancer/m\u001b[30Gdlewar\u001b[37G that maps it. I'd rename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes\u001b[29Gaway.\r\u001b[2C\u001b[1B6\u001b[6GPut the template overr\u001b[29Gdes under \u001b[38;2;177;185;249mR\u001b[41Gsources/Pr\u001b[52Gvate/Extensions/KeSearch/\u001b[39m and wire them th\u001b[96Gugh the\u001b[K\r\u001b[5C\u001b[1Bsit\u001b[10G set's\u001b[17GTypoScript.\u001b[K\r\u001b[2C\u001b[1B7\u001b[6GSchedule the indexer with\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe scheduler or as a DDEV\u001b[93Gcron job.\u001b[103GFor\r\u001b[5C\u001b[1Ba demo you can also run it by hand\u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[381.650704, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt index\u001b[14Gs\u001b[16Gfrom\u001b[21Gthe databa\u001b[32Ge, not from rendered pages.\u001b[22m News records get indexed without a crawler,\u001b[104Gand\r\u001b[4C\u001b[1Bt\u001b[8G index do\u001b[18Gsn't\u001b[23Gdep\u001b[27Gnd on someon\u001b[40G opening a page first.\r\u001b[8C\u001b[1B\u001b[1mfilter\u001b[16Gmaps onto facets.\u001b[34G\u001b[22mGive each indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\u001b[K\r\u001b[4C\u001b[1Bcheckboxes b\u001b[18Gcome a ke_search filter of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[26G\u001b[22mYou\u001b[30Gcan\u001b[34Goverride\u001b[43Gthe\u001b[47Gtemplates\u001b[57Gin\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[4C\u001b[1Bfor\u001b[9GNews\u001b[14Gunder\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[39m (ch\u001b[42Gck\u001b[45Gthe\u001b[49GC\u001b[51Gmpose\u001b[57G name with \u001b[38;2;177;185;249mcomposer show\u001b[39m), then run \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"S\u001b[15Garch indexe\u001b[27G\" storage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content\u001b[22Gtree),\u001b[29Gnews\u001b[34G(pointing at the \"News records\" folder) and files\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds\u001b[24Gits\u001b[28Gtag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCrea\u001b[11Ge\u001b[13Ga fil\u001b[19Ger\u001b[22G\"Typ\u001b[27G\" with three opt\u001b[44Gons whose tag\u001b[58G match the indexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place the \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (\u001b[96G\"Sidebar\r\u001b[5C\u001b[1Bright\" layout), or render \u001b[33Ghe\u001b[36Gfacets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m k\u001b[33G_searc\u001b[40G reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either\u001b[85Grename the input in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.f\u001b[15Guid.html\u001b[24G\u001b[39m(and\u001b[29Gs\u001b[31Gitch\u001b[36Gthe\u001b[40GcHash\u001b[46Gexclusion\u001b[56Gto\u001b[59G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\r\u001b[2C\u001b[1B  \u001b[6Gsmall route enhancer/m\u001b[30Gdlewar\u001b[37G that maps it. I'd rename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes\u001b[29Gaway.\r\u001b[2C\u001b[1B6\u001b[6GPut the template overr\u001b[29Gdes under \u001b[38;2;177;185;249mR\u001b[41Gsources/Pr\u001b[52Gvate/Extensions/KeSearch/\u001b[39m and wire them th\u001b[96Gugh the\u001b[K\r\u001b[5C\u001b[1Bsit\u001b[10G set's\u001b[17GTypoScript. \u001b[30G  \u001b[33G  \u001b[36G    \u001b[31;1H\u001b[29;3H\u001b[?25h"]
[381.691793, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[22m News\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someon\u001b[40G opening a p\u001b[53Gge first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer a tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filter of typ\u001b[49G checkbox.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the templates in the sit\u001b[68Gpackage,\u001b[77Gthe same way you already do\r\u001b[4C\u001b[1Bfor News under\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcompo\u001b[12Ger require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search index\u001b[26Gs\"\u001b[29Gstorage folder, and configure th\u001b[62Gee index\u001b[72Gs\u001b[74Gthere: pages (limited to the\u001b[K\r\u001b[5C\u001b[1Bservice/content tree), news\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6GCreate a filter \"Typ\u001b[27G\" with three options whose tags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or render the fa\u001b[39Gets in\u001b[46Gide your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either \u001b[86Gename\u001b[92Gthe input\u001b[102Gin\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion\u001b[56Gto \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), or keep \u001b[38;2;177;185;249mq\u001b[39m and add a\r\u001b[5C\u001b[1Bsmall route enhancer/middleware\u001b[38Gthat\u001b[43Gmaps\u001b[48Git.\u001b[52GI'd\u001b[56Grename\u001b[63Git:\u001b[67Git's\u001b[72Gsimpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPu\u001b[9G th\u001b[13G template overrides\u001b[33Gunder\u001b[39G\u001b[38;2;177;185;249mR\u001b[69GeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
