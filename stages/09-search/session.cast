[383.843852, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\u001b[3G│\u001b[22G│\u001b[35G│\u001b[37Gopened\u001b[56G│\u001b[70G│\u001b[81G│\u001b[101G│\r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[36C\u001b[1B      \u001b[83GHigh\u001b[88G(needs\u001b[95Ga\r\u001b[2C\u001b[1B│ Solr             │ ✅         │ ✅                 │ ✅          │ ✅       │ Solr server) —    │\r\u001b[82C\u001b[1Btoo much for this\r\u001b[4C\u001b[1B    \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83G site       \u001b[96G \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[4C\u001b[1BCustom\u001b[12GExtbase\u001b[24G✅\u001b[37G✅\u001b[58G❌\u001b[72G✅\u001b[83GMedium,\u001b[91Gand\u001b[95Gno\r\u001b[2C\u001b[1B│ SQL \u001b[38;2;177;185;249mLIKE\u001b[39m         │            │                    │             │          │ ranking           │\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mIt ind\u001b[12Gxes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[4C\u001b[1Bthe\u001b[9Gindex\u001b[15Gdoesn't\u001b[23Gdepend\u001b[30Gon\u001b[33Gsomeone\u001b[41Gopening\u001b[49Ga\u001b[51Gpage\u001b[56Gfirst.\r\u001b[4C\u001b[1B\u001b[1mThe filt\u001b[14Gr\u001b[16Gmaps\u001b[21Gonto facet\u001b[32G.\u001b[22m Give each indexer a tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\u001b[104G\u001b[K\r\u001b[4C\u001b[1Bc\u001b[8Gckboxes b\u001b[18Gcome\u001b[23Ga k\u001b[27G_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[8C\u001b[1B\u001b[1moutput\u001b[16Gis Fluid.\u001b[22m You can\u001b[34Goverride the templ\u001b[53Gtes in the sitepackage, the same way you already do\r\u001b[4C\u001b[1Bfor News und\u001b[18Gr \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[2B\u001b[22m1. \u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[5C\u001b[1Bextension:setup\u001b[39m.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
