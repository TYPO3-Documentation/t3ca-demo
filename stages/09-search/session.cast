[328.200281, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the templates in the sit\u001b[68Gpackage,\u001b[77Gthe same way you already do\r\u001b[4C\u001b[1Bfor News under\u001b[20G\u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand\u001b[55Greproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcompo\u001b[12Ger require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search index\u001b[26Gs\"\u001b[29Gstorage folder, and configure th\u001b[62Gee index\u001b[72Gs\u001b[74Gthere: pages (limited to the\u001b[K\r\u001b[5C\u001b[1Bservice/content tree), news\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6GCreate a filter \"Typ\u001b[27G\" with three options whose tags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or render the fa\u001b[39Gets in\u001b[46Gide your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either \u001b[86Gename\u001b[92Gthe input\u001b[102Gin\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion\u001b[56Gto \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), or keep \u001b[38;2;177;185;249mq\u001b[39m and add a\r\u001b[5C\u001b[1Bsmall route enhancer/middleware\u001b[38Gthat\u001b[43Gmaps\u001b[48Git.\u001b[52GI'd\u001b[56Grename\u001b[63Git:\u001b[67Git's\u001b[72Gsimpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPu\u001b[9G th\u001b[13G template overrides\u001b[33Gunder\u001b[39G\u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsit\u001b[10G set's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSch\u001b[10Gdule the indexer with the\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe\u001b[70Gscheduler\u001b[80Gor\u001b[83Gas\u001b[86Ga\u001b[88GDDEV\u001b[93Gcron\u001b[98Gjob.\u001b[103GFor\r\u001b[2C\u001b[1B  \u001b[6Ga demo you can also run it by\u001b[36Ghand after import.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add the indexer and\u001b[48Gfilter \u001b[56Gecord\u001b[62G to \u001b[38;2;177;185;249mInitialisat\u001b[78Gon/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[5C\u001b[1Binstall has search working.\u001b[34GAdd\u001b[38G\u001b[38;2;177;185;249mpdftotext\u001b[48G\u001b[39m(poppler-utils)\u001b