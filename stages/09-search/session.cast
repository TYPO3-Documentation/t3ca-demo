[364.970576, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tre\u001b[26G),\u001b[29Gnews (pointing at the \"News reco\u001b[62Gds\" fold\u001b[72G)\u001b[74Gand files (fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\" with\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe filter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or r\u001b[27Gnder the facets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_sear\u001b[39Gh read\u001b[46G \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), o\u001b[86G keep\u001b[92G\u001b[38;2;177;185;249mq\u001b[39m and add\u001b[102Ga\u001b[K\r\u001b[5C\u001b[1Bsmall route enhancer/middleware that maps it. I'd\u001b[56Grename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPut the template overrides under\u001b[39G\u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsi\u001b[9Ge s\u001b[13Gt's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSch\u001b[10Gdule the indexer with\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mke_s\u001b[70G\u001b[39mscheduler\u001b[80Gor\u001b[83Gas\u001b[86Ga\u001b[88GDDEV\u001b[93Gcron\u001b[98Gjob.\u001b[103GFor\u001b[31;1H\u001b[29;3H\u001b[?25h"]
