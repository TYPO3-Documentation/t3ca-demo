[381.005598, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or render the fa\u001b[39Gets in\u001b[46Gide your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either \u001b[86Gename\u001b[92Gthe input\u001b[102Gin\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion\u001b[56Gto \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), or keep \u001b[38;2;177;185;249mq\u001b[39m and add a\r\u001b[5C\u001b[1Bsmall route enhancer/middleware\u001b[38Gthat\u001b[43Gmaps\u001b[48Git.\u001b[52GI'd\u001b[56Grename\u001b[63Git:\u001b[67Git's\u001b[72Gsimpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPu\u001b[9G th\u001b[13G template overrides\u001b[33Gunder\u001b[39G\u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsit\u001b[10G set's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSch\u001b[10Gdule the indexer with the\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe\u001b[70Gscheduler\u001b[80Gor\u001b[83Gas\u001b[86Ga\u001b[88GDDEV\u001b[93Gcron\u001b[98Gjob.\u001b[103GFor\r\u001b[2C\u001b[1B  \u001b[6Ga demo you can also run it by\u001b[36Ghand after import.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B8.\u