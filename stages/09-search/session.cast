[2155.751861, "o", "\u001b[?25l\u001b[H\u001b[6Gthis \u001b[12Gable.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat I checked: \u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[39m returns 0 rows, while a\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[39m finds 4 index\u001b[K\r\u001b[2C\u001b[1Bentr\u001b[8Ges. The words\u001b[22Gar\u001b[26Gi\u001b[28G the\u001b[33Gindex table,\u001b[46Gbut\u001b[50Gthe full-text index skips them.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[8G\u001b[22mchange\u001b[15Gthe\u001b[19Gdatabase\u001b[28Gserver\u001b[35Gsettings\u001b[44Gin\u001b[47GDDEV\u001b[52Gand\u001b[56Grebuild\u001b[64Gthe\u001b[68Gfull-text\u001b[78Gindex:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[32m# .ddev/mysql/fulltext.cnf\u001b[39m\u001b[K\r\u001b[2C\u001b[1B[mysqld]\r\u001b[2C\u001b[1B\u001b[36mft_min_word_len\u001b[19G\u001b[39m= \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[20G\u001b[39m=\u001b[22G\u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen \u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcatch\u001b[13Gis\u001b[16Gthat\u001b[21Gthis\u001b[26Gis\u001b[29Ga\u001b[31Gserver\u001b[38Gsetting.\u001b[47GThe\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[2C\u001b[1Bproblem comes back\u001b[22Gthere, and on shared hosting you often can't change\u001b[74Git. Turning off stopwords also\u001b[K\r\u001b[2C\u001b[1Blets words like \"the\"\u001b[25Gmatch,\u001b[32Gbut\u001b[36Gke_search\u001b[46Granks\u001b[52Gresults\u001b[60Gby\u001b[63Grelevance,\u001b[74Gso\u001b[77Gthat\u001b[82Gdoes\u001b[87Glittle\u001b[94Gharm.\r\u001b[2C\u001b[2BS\u001b[5Gould I add\u001b[18Ge DDEV config, \u001b[34Gebuild \u001b[42Ghe index\u001b[51Gand note the hosting\u001b[72Gr\u001b[74Gquirem\u001b[81Gnt in\u001b[88Ghe\u001b[91GREADME?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 17s · done 12:59 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mSite search with free ke_search is working and verified, but uncommitted, and \"new\" finds nothing\r\u001b[2C\u001b[1Bbecause the database skips short and common words. Next step: say whether I should add the DDEV \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mdatabase fix and rebuild the index. (turn off recaps in /config)\u001b[23m\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
