[383.568102, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[1mke_search\u001b[24G\u001b[22m✅\u001b[27Gindexer\u001b[37Gindexer    \u001b[49G    \u001b[58G\u001b[38;2;177;185;249mpdftotext\u001b[72G\u001b[39mfacets\u001b[83GLow\r\u001b[4C\u001b[1B         \u001b[24G  \u001b[27G       \u001b[37G       \u001b[58G         \u001b[72Gvia \u001b[77Gags\u001b[83G   \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[1B\u001b[K\u001b[3G│\u001b[22G│\u001b[24G✅\u001b[27Gwhile\u001b[35G│\u001b[38G \u001b[37G⚠️\r\u001b[40Gonly\u001b[45Gdetail\u001b[56G│\u001b[70G│\u001b[72G❌\u001b[75Gno\u001b[81G│\u001b[101G│\r\u001b[1B\u001b[K\u001b[3G│\u001b[5Gindexed_search\u001b[22G│\u001b[24Gpages\u001b[35G│\u001b[37Gpages\u001b[43Ga\u001b[45Gvisitor\u001b[53Gor\u001b[56G│\u001b[59G \u001b[58G⚠️\r\u001b[61Gexternal\u001b[70G│\u001b[72Greal\u001b[81G│\u001b[83GMedium\u001b[101G│\r\u001b[1B\u001b[K\u001b[3G│\u001b[5G(core)\u001b[22G│\u001b[24Grender\u001b[35G│\u001b[38Gcrawler\u001b[46Ghas\u001b[56G│\u001b[59Gtools\u001b[70G│\u001b[72Gfacets\u001b[81G│\u001b[101G│\r\u001b[4C\u001b[1B      \u001b[24G      \u001b[37Gopened  \u001b[46G   \u001b[59G     \u001b[72G      \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[2C\u001b[1B│                  │            │                    │             │          │ High (needs a     │\r\u001b[4C\u001b[1BSolr\u001b[24G✅\u001b[37G✅\u001b[58G✅\u001b[72G✅\u001b[83GSolr\u001b[88Gserver) —\r\u001b[4C\u001b[1B    \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Gt\u001b[85Go much for\u001b[96Gthis\r\u001b[82C\u001b[1B site   \u001b[92G   \u001b[96G    \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[2C\u001b[1B│ Custom Extbase   │ ✅         │ ✅                 │ ❌          │ ✅       │ Medium, and no    │\r\u001b[4C\u001b[1BSQL \u001b[38;2;177;185;249mLIKE\u001b[39m      \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Granking\u001b[91G   \u001b[95G  \r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Ex\u001b[68G\u001b[39m markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[383.584386, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[1B\u001b[K\u001b[3G│\u001b[22G│\u001b[24G✅\u001b[27Gwhile\u001b[35G│\u001b[38G \u001b[37G⚠️\r\u001b[40Gonly\u001b[45Gdetail\u001b[56G│\u001b[70G│\u001b[72G❌\u001b[75Gno\u001b[81G│\u001b[101G│\r\u001b[1B\u001b[K\u001b[3G│\u001b[5Gindexed_search\u001b[22G│\u001b[24Gpages\u001b[35G│\u001b[37Gpages\u001b[43Ga\u001b[45Gvisitor\u001b[53Gor\u001b[56G│\u001b[59G \u001b[58G⚠️\r\u001b[61Gexternal\u001b[70G│\u001b[72Greal\u001b[81G│\u001b[83GMedium\u001b[101G│\r\u001b[1B\u001b[K\u001b[3G│\u001b[5G(core)\u001b[22G│\u001b[24Grender\u001b[35G│\u001b[38Gcrawler\u001b[46Ghas\u001b[56G│\u001b[59Gtools\u001b[70G│\u001b[72Gfacets\u001b[81G│\u001b[101G│\r\u001b[1B\u001b[K\u001b[3G│\u001b[22G│\u001b[35G│\u001b[37Gopened\u001b[56G│\u001b[70G│\u001b[81G│\u001b[101G│\r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[36C\u001b[1B      \u001b[83GHigh\u001b[88G(needs\u001b[95Ga\r\u001b[2C\u001b[1B│ Solr             │ ✅         │ ✅                 │ ✅          │ ✅       │ Solr server) —    │\r\u001b[82C\u001b[1Btoo much for this\r\u001b[4C\u001b[1B    \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83G site       \u001b[96G \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[4C\u001b[1BCustom\u001b[12GExtbase\u001b[24G✅\u001b[37G✅\u001b[58G❌\u001b[72G✅\u001b[83GMedium,\u001b[91Gand\u001b[95Gno\r\u001b[2C\u001b[1B│ SQL \u001b[38;2;177;185;249mLIKE\u001b[39m         │            │                    │             │          │ ranking           │\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mIt ind\u001b[12Gxes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[4C\u001b[1Bthe\u001b[9Gindex\u001b[15Gdoesn't\u001b[23Gdepend\u001b[30Gon\u001b[33Gsomeone\u001b[41Gopening\u001b[49Ga\u001b[51Gpage\u001b[56Gfirst.\r\u001b[4C\u001b[1B\u001b[1mThe filt\u001b[14Gr\u001b[16Gmaps\u001b[21Gonto facet\u001b[32G.\u001b[22m Give each indexer a tag (\u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m, \u001b[38;2;177;185;249mdocument\u001b[39m) and the \"Show only\"\u001b[104G\u001b[K\r\u001b[4C\u001b[1Bc\u001b[8Gckboxes b\u001b[18Gcome\u001b[23Ga k\u001b[27G_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[8C\u001b[1B\u001b[1moutput\u001b[16Gis Fluid.\u001b[22m You can\u001b[34Goverride the templ\u001b[53Gtes in the sitepackage, the same way you already do\r\u001b[4C\u001b[1Bfor News und\u001b[18Gr \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B   \u001b[9G    \u001b[14G     \u001b[20G                    \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
