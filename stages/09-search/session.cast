01b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m and \u001b[38;2;177;185;249mdocument\u001b[39m,\u001b[93Gand\u001b[97Guse\u001b[101Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame values for the Solr facet later. Then the\u001b[53Gbadges and filters don't ch\u001b[82Gge.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mUse free ke_search features only.\u001b[40G\u001b[22mNothing\u001b[48Gfrom\u001b[53Gpremium,\u001b[62Gso\u001b[65Gyou\u001b[69Gdon't\u001b[75Gmiss\u001b[80Ganything\u001b[89Gafter\u001b[95Gthe\u001b[99Gswitch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets thrown away when you switch\u001b[22m\u001b[K\r\u001b[8C\u001b[1Bindexe\u001b[16G and filt\u001b[28Gr\u001b[30Gcor\u001b[34Gs, both in t\u001b[48G database and in \u001b[38;2;177;185;249mInitialisa\u001b[76Gion/data.xml\u001b[39m.\u001b[K\r\u001b[4C\u001b[1BThe ke_search composer depend\u001b[35Gncy, the scheduler task and the \u001b[38;2;177;185;249mpdftotext\u001b[39m package in\u001b[88GDDEV.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GO\u001b[7G existing installations,\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mtx_kesearch_*\u001b[50G\u001b[39mtables:\u001b[58Gremove\u001b[65Gthem\u001b[70Gwith\u001b[75Gthe\u001b[79Gdatabase\u001b[88Ganalyzer\u001b[97Gafter\r\u001b[4C\u001b[1Buninstalling.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPlan the PDFs now.\u001b[22m With Solr, the \"Documents\" results\u001b[57Gnee\u001b[61G EXT:solrfal, which is paid. Before you\u001b[K\r\u001b[8C\u001b[1B, ch\u001b[14Gck whethe\u001b[24G your\u001b[30Gother\u001b[36Gsites\u001b[42Galready\u001b[50Ghave\u001b[55Ga\u001b[57Gfunding\u001b[65Gpartnership\u001b[77Gthat\u001b[82Gcovers\u001b[89Git.\u001b[93GOtherwise\u001b[103Gthe\r\u001b[2C\u001b[1Bswitch\u001b[10Gloses\u001b[16GPDF\u001b[20Gsearch.\r\u001b[2C\u001b[1B     \u001b[9G \u001b[11G     \u001b[17G   \u001b[21G         \u001b[31G     \u001b[37G   \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
