[365.74575, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tre\u001b[26G),\u001b[29Gnews (pointing at the \"News reco\u001b[62Gds\" fold\u001b[72G)\u001b[74Gand files (fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\" with\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe filter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or r\u001b[27Gnder the facets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_sear\u001b[39Gh read\u001b[46G \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), o\u001b[86G keep\u001b[92G\u001b[38;2;177;185;249mq\u001b[39m and add\u001b[102Ga\u001b[K\r\u001b[5C\u001b[1Bsmall route enhancer/middleware that maps it. I'd\u001b[56Grename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPut the template overrides under\u001b[39G\u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsi\u001b[9Ge s\u001b[13Gt's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSch\u001b[10Gdule the indexer with\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe\u001b[70Gscheduler\u001b[80Gor\u001b[83Gas\u001b[86Ga\u001b[88GDDEV\u001b[93Gcron\u001b[98Gjob.\u001b[103GFor\r\u001b[2C\u001b[1B  \u001b[6Ga d\u001b[10Gmo you can also run it by\u001b[36Ghand after import.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add the\u001b[36Gindexer and filter\u001b[55Grecords\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[2C\u001b[1B  \u001b[6Ginstall has search working. Add \u001b[38;2;177;185;249mpdftotext\u001b[48G\u001b[39m(popple\u001b[56G-util\u001b[62G) to \u001b[38;2;177;185;249m.ddev/conf\u001b[78Gg.yaml\u001b[39m with\u001b[90G\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mwebimage_extra_packages\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gchecked\u001b[13GTER\u001b[17Gfor\u001b[21Gke_search's\u001b[33Gversions;\u001b[43GI\u001b[45Ghaven't\u001b[53Ginstalled\u001b[63Git\u001b[66Gor\u001b[69Gtested\u001b[76Gany\u001b[80Gof\u001b[83Gthese\u001b[89Gsteps\u001b[95Ghere\u001b[100Gyet.\r\u001b[2C\u001b[1BWant me to go\u001b[17Gahead with it as the next\u001b[43Gstage (\u001b[38;2;177;185;249m09-search\u001b[39m)