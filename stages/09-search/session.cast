[726.36268, "o", "\u001b[?25l\u001b[H\u001b[3G1.\u001b[6G\u001b[1mKeep the search page (uid 16)\u001b[36G\u001b[22mand\u001b[40Gthe\u001b[44G\u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[2C\u001b[1B  \u001b[6Gpage changes.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mMake the query parameter a setting.\u001b[22m ke_search u\u001b[54Ges \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m and Solr uses \u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\r\u001b[5C\u001b[1BIf \u001b[10Ghe head\u001b[18Gr form tak\u001b[29Gs th\u001b[35Gfield name from a\u001b[53Gsite \u001b[59Getting\u001b[66Gsuch as \u001b[38;2;177;185;249mmt\u001b[77Gsafi.search.queryParameter\u001b[39m,\u001b[K\r\u001b[2C\u001b[1B  \u001b[6Gswitching becomes a one-line change. The cHash exclusion in \u001b[38;2;177;185;249mext_localconf.php\u001b[39m has to follow i\u001b[100G too.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mWrite the result markup as partials of our own\u001b[22m:\u001b[54Gthe resul\u001b[64G item, the\u001b[75Gbadge and the filter list. These\r\u001b[5C\u001b[1Bare the \u001b[38;2;177;185;249mol.search-results\u001b[33G.badge\u001b[40G\u001b[39mand \u001b[38;2;177;185;249mdata-type\u001b[39m parts of the de\u001b[70Gign. Keep the ke_search template\u001b[104G\u001b[K\r\u001b[5C\u001b[1Bthin\u001b[11Gwrappers\u001b[20Garound\u001b[27Gthem,\u001b[33Gso\u001b[36Gthe\u001b[40GSolr\u001b[45Gtemplates\u001b[55Gcan\u001b[59Greuse\u001b[65Gthe\u001b[69Gsame\u001b[74Gpartials\u001b[83Gand\u001b[87Gthe\u001b[91GCSS\u001b[95Gstays\u001b[101Gas\u001b[104Git\r\u001b[2C\u001b[1B  \u001b[6Gis.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mUse the same type keys everywhere.\u001b[22m Name the k\u001b[52G_search\u001b[60Gtags \u001b[38;2;177;185;249mservice\u001b[39m, \u001b[38;2;177;185;249mnews\u001b[39m and \u001b[38;2;177;185;249mdocument\u001b[39m,\u001b[93Gand\u001b[97Guse\u001b[101Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame values for the Solr facet later. Then the\u001b[53Gbadges and filters don't ch\u001b[82Gge.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mUse free ke_search features only.\u001b[40G\u001b[22mNothing\u001b[48Gfrom\u001b[53Gpremium,\u001b[62Gso\u001b[65Gyou\u001b[69Gdon't\u001b[75Gmiss\u001b[80Ganything\u001b[89Gafter\u001b[95Gthe\u001b[99Gswitch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets thrown away when you switch\u001b[22m\u001b[K\r\u001b[8C\u001b[1Bindexe\u001b[16G and filt\u001b[28Gr\u001b[30Gcor\u001b[34Gs, both in t\u001b[48G database and in \u001b[38;2;177;185;249mInitialisa\u001b[76Gion/data.xml\u001b[39m.\u001b[K\r\u001b[4C\u001b[1BThe ke_search composer depend\u001b[35Gncy, the scheduler task and the \u001b[38;2;177;185;249mpdftotext\u001b[39m package in\u001b[88GDDEV.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GO\u001b[7G existing installations,\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mtx_kesearch_*\u001b[50G\u001b[39mtables:\u001b[58Gremove\u001b[65Gthem\u001b[70Gwith\u001b[75Gthe\u001b[79Gdatabase\u001b[88Ganalyzer\u001b[97Gafter\r\u001b[4C\u001b[1Buninstalling.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPlan the PDFs now.\u001b[22m With Solr, the \"Documents\" results\u001b[57Gnee\u001b[61G EXT:solrfal, which is paid. Before you\u001b[K\r\u001b[8C\u001b[1B, ch\u001b[14Gck whethe\u001b[24G your\u001b[30Gother\u001b[36Gsites\u001b[42Galready\u001b[50Ghave\u001b[55Ga\u001b[57Gfunding\u001b[65Gpartnership\u001b[77Gthat\u001b[82Gcovers\u001b[89Git.\u001b[93GOtherwise\u001b[103Gthe\r\u001b[2C\u001b[1Bswitch\u001b[10Gloses\u001b[16GPDF\u001b[20Gsearch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BS\u001b[5Gall I start\u001b[17Gthe \u001b[38;2;177;185;249m09-search\u001b[31G\u001b[39mstage this way? I'd begin with the dep\u001b[70Gn\u001b[72Gency and the i\u001b[87Gd\u001b[89Gxer\u001b[93Gsetup,\u001b[100Gthen\r\u001b[2C\u001b[1Bthe\u001b[7Gtemplates\u001b[17Gin\u001b[20Gthe\u001b[24Gdesign\u001b[31Gmarkup,\u001b[39Gthe\u001b[43Gheader\u001b[50Gform\u001b[55Gsetting\u001b[63Gand\u001b[67Gthe\u001b[71Gdistribution\u001b[84Gcontent.\r\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[726.393823, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ oh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr on…\u001b[39m \r\u001b[39C\u001b[25B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
