m.badge\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[2B\u001b[22m1. \u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[5C\u001b[1Bextension:setup\u001b[39m.\r\u001b[2C\u001b[1B2\u001b[6GAdd a \"Search indexes\" storage fold\u001b[42Gr,\u001b[45Gand\u001b[49Gc\u001b[51Gnfigu\u001b[57Ge three indexers there: pages (limited to the\r\u001b[5C\u001b[1Bservice/content tree),\u001b[29Gnews\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach ind\u001b[15Gxer adds it\u001b[27G tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter\u001b[22G\"Type\"\u001b[29Gwith\u001b[34Gthree \u001b[68G indexers.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[383.889421, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1BSQL\u001b[9G\u001b[38;2;177;185;249mLIKE\u001b[83G\u001b[39mranking \u001b[92G   \u001b[96G    \r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mIt indexes from the database, not from rendered pages.\u001b[22m News records get indexed without a crawler,\u001b[104Gand\r\u001b[4C\u001b[1Bthe\u001b[9Gindex\u001b[15Gdoesn't\u001b[23Gdepend\u001b[30Gon\u001b[33Gsomeone\u001b[41Gopening\u001b[49Ga\u001b[51Gpage\u001b[56Gfirst.\r\u001b[2C\u001b[1B- \u001b[1mThe filter maps onto facets.\u001b[34G\u001b[22mGive\u001b[39Geach\u001b[44Gindexer\u001b[52Ga\u001b[54Gtag\u001b[58G(\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[4C\u001b[1Bcheckboxes\u001b[16Gbecome\u001b[23Ga\u001b[25Gke_search\u001b[35Gfilter\u001b[42Gof\u001b[45Gtype\u001b[50Gcheckbox.\r\u001b[4C\u001b[1B\u001b[1mThe output\u001b[16Gis Fluid.\u001b[22m You can override the templates in\u001b[60Gthe sitepacka\u001b[75G,\u001b[77Gthe same way you al\u001b[97Geady do\u001b[K\r\u001b[4C\u001b[1Bfor\u001b[9GNews und\u001b[18Gr \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m,\u001b[51Gand rep\u001b[59Goduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImpl\u001b[8Gmen\u001b[12Gation steps\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1. \u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[5C\u001b[1Bextension:setup\u001b[39m.\r\u001b[2C\u001b[1B2. Add a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[5C\u001b[1Bservice/content\u001b[22Gtree),\u001b[29Gnews\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\"\u001b[29Gwith\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn p\u001b[11Gge 16, place the \u001b[1msearch box + results\u001b[49G\u001b[22mplug\u001b[54Gn in\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (\u001b[93Ghe\u001b[96G\"Sidebar\r\u001b[5C\u001b[1Bright\" layout),\u001b[22Go\u001b[24G render the facets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search\u001b[41Greads\u001b[47G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m,\u001b[71Gnot\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and\u001b[29Gswitch th\u001b[68G\u001b[38;2;177;185;249mch_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.117959, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tre\u001b[26G),\u001b[29Gnews (pointing at the \"News reco\u001b[62Gds\" fold\u001b[72G)\u001b[74Gand files (fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\" with\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe filter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or r\u001b[27Gnder the facets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_sear\u001b[39Gh read\u001b[46G \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), o\u001b[86G keep\u001b[92G\u001b[38;2;177;185;249mq\u001b[39m and add\u001b[102Ga\u001b[K\r\u001b[5C\u001b[1Bsmall route enhancer/middleware th\u001b[68Gt's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.133221, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tre\u001b[26G),\u001b[29Gnews (pointing at the \"News reco\u001b[62Gds\" fold\u001b[72G)\u001b[74Gand files (fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\" with\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe filter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or r\u001b[27Gnder the facets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_sear\u001b[39Gh read\u001b[46G \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), o\u001b[86G keep\u001b[92G\u001b[38;2;177;185;249mq\u001b[39m and add\u001b[102Ga\u001b[K\r\u001b[5C\u001b[1Bsmall route enhancer/middleware that maps it. I'd\u001b[56Grename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.   \u001b[38G  \u001b[68G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.14828, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhy ke_search\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd a \"Search indexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tre\u001b[26G),\u001b[29Gnews (pointing at the \"News reco\u001b[62Gds\" fold\u001b[72G)\u001b[74Gand files (fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds its tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter \"Type\" with\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place th\u001b[27G \u001b[1msearch box + results\u001b[22m plugin in\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe filter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or r\u001b[27Gnder the facets inside your result template.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_sear\u001b[39Gh read\u001b[46G \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not\u001b[75G\u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GEither\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and switch the cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), o\u001b[86G keep\u001b[92G\u001b[38;2;177;185;249mq\u001b[39m and add\u001b[102Ga\u001b[K\r\u001b[5C\u001b[1Bsmall route enhancer/middleware that maps it. I'd\u001b[56Grename it: it's simpler, and the \u001b[38;2;177;185;249mq\u001b[39m exclusion in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPut the template overrides under\u001b[39G\u001b[38;2;177;185;249mR\u001b[68GKeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.1636, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  checkboxes become\u001b[23Ga\u001b[25Gke_search\u001b[35Gfilter\u001b[42Gof\u001b[45Gtype\u001b[50Gcheckbox.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[26G\u001b[22mYou\u001b[30Gcan\u001b[34Goverride\u001b[43Gthe\u001b[47Gtemplates\u001b[57Gin\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce\u001b[65Gthe markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[104G\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1. \u001b[38;2;177;185;249mcomposer requir\u001b[22G tpwd/ke_search\u001b[39m (check the Composer name wi\u001b[67G \u001b[38;2;177;185;249mcomposer show\u001b[39m), then run \u001b[38;2;177;185;249mtypo3 \u001b[39m\u001b[K\r\u001b[4C\u001b[1B \u001b[38;2;177;185;249mextension:setup\u001b[39m.\r\u001b[2C\u001b[1B2.\u001b[6GAdd\u001b[10Ga\u001b[12G\"Search\u001b[20Gindexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B   service/content tree),\u001b[29Gnews\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[5C\u001b[1BEach\u001b[11Gindexer\u001b[19Gadds\u001b[24Gits\u001b[28Gtag.\r\u001b[2C\u001b[1B3\u001b[6GCreate a filter \"Type\" with three options wh\u001b[51Gse tags match \u001b[67Ge indexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place\u001b[24Gthe\u001b[28G\u001b[1msearch box + results\u001b[49G\u001b[22mplugin\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Gright\" layout), or render the facets insi\u001b[48Ge your result t\u001b[64Gmplate.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads\u001b[47G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m.\u001b[78GE\u001b[80Gther rename the input in\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[24G\u001b[39m(and switch\u001b[36Gthe\u001b[40GcHash\u001b[46Gexclusion\u001b[56Gto\u001b[59G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\r\u001b[2C\u001b[1B  \u001b[6Gsmall route enhancer/middleware that map\u001b[48Git. I'd rename it: it's simpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[24G\u001b[39mgo\u001b[27Gs away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPut \u001b[11Ghe template overrides under \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[78G\u001b[39mand\u001b[82Gwire\u001b[87Gthem\u001b[92Gthrough\u001b[100Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsite set's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSchedule the indexer with \u001b[33Ghe\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[39m command in the scheduler or as a DDEV cron\u001b[98Gjob. For\r\u001b[5C\u001b[1Ba demo you ca\u001b[20G \u001b[22Glso run it by hand after import.\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add the\u001b[36Gindexer\u001b[44Gand\u001b[48Gfilter\u001b[55Grecords\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[2C\u001b[1B  \u001b[6Ginstall\u001b[14Ghas search wo\u001b[28Gking. A\u001b[36Gd \u001b[38;2;177;185;249mpd\u001b[68Gddev/config.yaml\u001b[39m wi\u001b[89G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.17197, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bfor News und\u001b[18Gr \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce\u001b[65Gthe\u001b[69Gmarkup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m,\u001b[96G\u001b[38;2;177;185;249m.badge\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[2B\u001b[22m1. \u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[5C\u001b[1Bextension:setup\u001b[39m.\r\u001b[2C\u001b[1B2\u001b[6GAdd a \"Search indexes\" storage fold\u001b[42Gr,\u001b[45Gand\u001b[49Gc\u001b[51Gnfigu\u001b[57Ge three indexers there: pages (limited to the\r\u001b[5C\u001b[1Bservice/content tree),\u001b[29Gnews\u001b[34G(pointing\u001b[44Gat\u001b[47Gthe\u001b[51G\"News\u001b[57Grecords\"\u001b[66Gfolder)\u001b[74Gand\u001b[78Gfiles\u001b[84G(fileadmin\u001b[95Gdocuments).\r\u001b[2C\u001b[1B  \u001b[6GEach ind\u001b[15Gxer adds it\u001b[27G tag.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GCreate a filter\u001b[22G\"Type\"\u001b[29Gwith\u001b[34Gthree options whose tags match the indexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn page 16, place\u001b[24Gthe\u001b[28G\u001b[1msearch box + results\u001b[49G\u001b[22mplugin\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mmain\u001b[39m.\u001b[65GPut\u001b[69Gthe\u001b[73Gfilter\u001b[80Gin\u001b[83G\u001b[38;2;177;185;249msidebar\u001b[91G\u001b[39m(the\u001b[96G\"Sidebar\r\u001b[2C\u001b[1B  \u001b[6Grigh\u001b[11G\"\u001b[13Glayou\u001b[19G),\u001b[22Gor r\u001b[27Gnder the facets \u001b[44Gnside your re\u001b[58Gult template.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either rename \u001b[96Ginput in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and swi\u001b[33Gch\u001b[36Gthe cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m),\u001b[84Gor\u001b[87Gkeep\u001b[92G\u001b[38;2;177;185;249mq\u001b[94G\u001b[39mand\u001b[98Gadd\u001b[102Ga\r\u001b[2C\u001b[1B  \u001b[6Gsmall route enhancer/middl\u001b[33Gware t\u001b[40Gat maps it. I'd rename it: it's simpler, and\u001b[85Gthe \u001b[38;2;177;185;249mq\u001b[39m exclusion in\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mext_loca\u001b[15Gconf.php\u001b[24G\u001b[39mgoes\u001b[29Ga\u001b[31Gay.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPut the template overr\u001b[30Ges und\u001b[37Gr \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[39m and wire them through the\r\u001b[5C\u001b[1Bsite set's TypoScript.\u001b[29G\u001b[K\r\u001b[2C\u001b[1B7\u001b[6GSchedule the indexer w\u001b[29Gth the \u001b[38;2;177;185;249mke_s\u001b[41Garch:index\u001b[52Gng\u001b[39m command in the scheduler or as a DDEV c\u001b[96Gn job. For\r\u001b[5C\u001b[1Ba d\u001b[10Gmo you\u001b[17Gcan also run\u001b[30Git\u001b[33Gby\u001b[36Ghand\u001b[41Gafter\u001b[47Gimport.\r\u001b[2C\u001b[1B8\u001b[6G\u001b[1mDistribution content:\u001b[22m add\u001b[36Gindexer and filter\u001b[55Grecords\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m so\u001b[93Ga fresh\u001b[K\r\u001b[5C\u001b[1Binstall has search working. Add \u001b[38;2;177;185;249mpdftotext\u001b[39m (\u001b[51Gppler-utils)\u001b[64Gto\u001b[67G\u001b[38;2;177;185;249m.ddev/config.yaml\u001b[85G\u001b[39mwith\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mwebimage_extra_packages\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B       \u001b[14G   \u001b[18G      \u001b[25G        \u001b[34G   \u001b[38G  \u001b[68G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.178599, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;177;185;249mextension:setup\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GAdd\u001b[10Ga\u001b[12G\"Search\u001b[20Gindexes\"\u001b[29Gstorage\u001b[37Gfolder,\u001b[45Gand\u001b[49Gconfigure\u001b[59Gthree\u001b[65Gindexers\u001b[74Gthere:\u001b[81Gpages\u001b[87G(limited\u001b[96Gto\u001b[99Gthe\r\u001b[2C\u001b[1B  \u001b[6Gservice/content tree), news (pointing a\u001b[46G the \"News records\" folder) and files\u001b[84G(fileadmin documents).\r\u001b[5C\u001b[1BEach indexer adds\u001b[24Gits\u001b[28Gtag.\r\u001b[2C\u001b[1B3\u001b[6GCreate a filter \"Type\u001b[29Gwith three options wh\u001b[51Gse tags\u001b[59Gmatch\u001b[65Gthe indexers.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GOn pag\u001b[13G 16, place the \u001b[1msearch box + results\u001b[22m plugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (the \"Sid\u001b[101Gbar\u001b[K\r\u001b[5C\u001b[1Brig\u001b[10Gt\" layout), or render the\u001b[36Gfacets\u001b[43Ginside\u001b[50Gyour\u001b[55Gresult\u001b[62Gtemplate.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_search reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either\u001b[85Grename\u001b[92Gthe\u001b[96Ginput\u001b[102Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[24G\u001b[39m(and switch the cHash exclusio\u001b[56Gto\u001b[59G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m), or keep \u001b[38;2;177;185;249mq\u001b[39m and a\u001b[100Gd \u001b[103G\u001b[K\r\u001b[5C\u001b[1Bsmall route enhance\u001b[26G/middleware that\u001b[43Gmaps it. I'd rename it: i\u001b[69G's\u001b[72Gsimpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m goes away.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GPut the template overrides under \u001b[38;2;177;185;249mResources/Private/Ex\u001b[60Gensions/KeSearch/\u001b[39m and wire\u001b[87Gth\u001b[90Gm\u001b[92Gthrough the\r\u001b[6C\u001b[1Bite set's TypoScript.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6GSchedule the indexer with the\u001b[36G\u001b[38;2;177;185;249mke_search:indexing\u001b[55G\u001b[39mcommand\u001b[63Gin\u001b[66Gthe\u001b[70Gscheduler\u001b[80Gor\u001b[83Gas\u001b[86Ga\u001b[88GDDEV\u001b[93Gcron\u001b[98Gjob.\u001b[103GFor\r\u001b[2C\u001b[1B  \u001b[6Ga demo you can also \u001b[27Gun it\u001b[33Gby hand after import.\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m add\u001b[32Gthe\u001b[36Gindexer\u001b[44Gand\u001b[48Gfilter\u001b[55Grecords\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mInitialisation/data.xml\u001b[90G\u001b[39mso\u001b[93Ga\u001b[95Gfresh\r\u001b[2C\u001b[1B  \u001b[6Ginstal\u001b[13G has search working. Add \u001b[38;2;177;185;249mpdftotext\u001b[39m (poppler-utils) to \u001b[38;2;177;185;249m.ddev/config.yaml\u001b[39m with\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mwebimage_extra_packages\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gchecked TER for ke_sea\u001b[28Gch's versions; I haven't installed i\u001b[65G or tested any of these steps\u001b[95Ghere\u001b[100Gyet.\r\u001b[2C\u001b[1BWant me to go ahead with it\u001b[31Gas\u001b[34Gthe\u001b[38Gnext\u001b[43Gstage\u001b[49G(\u001b[38;2;177;185;249m09-search\u001b[39m)?\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.193398, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   Each indexer adds\u001b[24Gits\u001b[28Gtag.\r\u001b[2C\u001b[1B3.\u001b[6GCreate\u001b[13Ga\u001b[15Gfilter\u001b[22G\"Type\"\u001b[29Gwith\u001b[34Gthree\u001b[40Goptions\u001b[48Gwhose\u001b[54Gtags\u001b[59Gmatch\u001b[65Gthe\u001b[69Gindexers.\r\u001b[2C\u001b[1B4\u001b[6GOn page 16, place the \u001b[1msearch box + results\u001b[49G\u001b[22mplugin in \u001b[38;2;177;185;249mmain\u001b[39m. Put the filter in \u001b[38;2;177;185;249msidebar\u001b[39m (the \"Sidebar\r\u001b[5C\u001b[1Bright\" layout), or\u001b[25Grender\u001b[32Gthe\u001b[36Gfacets\u001b[43Ginside\u001b[50Gyour\u001b[55Gresult\u001b[62Gtemplate.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mConnect the header form.\u001b[22m ke_s\u001b[36Garch reads \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m, not \u001b[38;2;177;185;249mq\u001b[39m. Either rename \u001b[93Ghe\u001b[96Ginput in\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m (and\u001b[29Gswitch the cHash exclusion to \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m),\u001b[84Gor k\u001b[89Gep \u001b[38;2;177;185;249mq\u001b[39m and add a\u001b[K\r\u001b[5C\u001b[1Bsmall rout\u001b[17G enhancer/middleware\u001b[38Gthat\u001b[43Gmaps\u001b[48Git.\u001b[52GI'd\u001b[56Grename\u001b[63Git:\u001b[67Git's\u001b[72Gsimpler,\u001b[81Gand\u001b[85Gthe\u001b[89G\u001b[38;2;177;185;249mq\u001b[91G\u001b[39mexclusion\u001b[101Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m go\u001b[27Gs\u001b[29Gaway.\u001b[K\r\u001b[2C\u001b[1B6\u001b[6GPut th\u001b[14Gtemplate overrides under \u001b[38;2;177;185;249mResources/Private/Extensions/KeSearch/\u001b[39m and wire them \u001b[94Grough the\u001b[K\r\u001b[5C\u001b[1Bs\u001b[8Gte set's TypoSc\u001b[24Gipt.\u001b[K\r\u001b[2C\u001b[1B7\u001b[6GSchedule the indexer with the \u001b[38;2;177;185;249mke_search:indexing\u001b[39m command in the scheduler or as a DDEV cron job. For\r\u001b[5C\u001b[1Ba demo you can also run it by\u001b[36Ghand after import.\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mDistribution content:\u001b[22m a\u001b[31G the indexer \u001b[45Gnd\u001b[48Gfilter records\u001b[63Gto \u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m so a fresh\u001b[101G\u001b[K\r\u001b[5C\u001b[1Binstall has search working. Add\u001b[38G\u001b[38;2;177;185;249mpdftotext\u001b[48G\u001b[39m(poppler-utils)\u001b[64Gto\u001b[67G\u001b[38;2;177;185;249m.ddev/config.yaml\u001b[85G\u001b[39mwith\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mwebimage_extra_packages\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI checked TER for k\u001b[23G_search's v\u001b[35Grsions; I haven't installe\u001b[64Gt\u001b[66Gor test\u001b[75G any\u001b[81Gf\u001b[83Gthese steps here yet.\u001b[K\r\u001b[2C\u001b[1BWant\u001b[8Gm\u001b[10G to go\u001b[17Gahead with it as the \u001b[39Gext stage (\u001b[38;2;177;185;249m09-search\u001b[39m)?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 32s · done 12:27 PM\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mYou're adding site search to the demo, and I recommended ke_search to index pages, news and PDFs \r\u001b[2C\u001b[1Bwith a type filter matching the design. Next: say whether I should implement it as stage 09-search. \u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m\u001b[3m(turn off recaps in /config)\u001b[23m\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
