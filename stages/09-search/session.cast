[637.93537, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mFeatures ke_search only ha\u001b[33Gin p\u001b[39Gmium come free:\u001b[22m autocompl\u001b[65Gte, \"Did you mean…?\", synonyms and better\r\u001b[4C\u001b[1Branking.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it costs:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GThis\u001b[10Gsite\u001b[15Gneeds\u001b[21Gits\u001b[25Gown\u001b[29GSolr\u001b[34Gcore\u001b[39Gon\u001b[42Gyour\u001b[47GSolr\u001b[52Gserver,\u001b[60Gplus\u001b[65GTika\u001b[70Gif\u001b[73Gyou\u001b[77Gwant\u001b[82GPDF\u001b[86Gtext.\r\u001b[2C\u001b[1B- Local development\u001b[23Gneeds\u001b[29GSolr\u001b[34Gin\u001b[37GDDEV,\u001b[43Gfor\u001b[47Gexample\u001b[55Gthe\u001b[59G\u001b[38;2;177;185;249mddev/ddev-solr\u001b[74G\u001b[39madd-on\u001b[81Gwith\u001b[86Gthe\u001b[90Gconfigsets\u001b[101Gfrom\r\u001b[2C\u001b[1B \u001b[5GEXT:solr.\u001b[15G\u001b[K\r\u001b[4C\u001b[1BSetup\u001b[11Gis heavi\u001b[20Gr than ke_search: connection settings per site, an index queue, and scheduler \u001b[99Gasks. A\r\u001b[4C\u001b[1Bfresh install\u001b[19Gfrom\u001b[24Gthe\u001b[28Gdistribution\u001b[41Galso\u001b[46Gonly\u001b[51Ggets\u001b[56Gworking\u001b[64Gsearch\u001b[71Gif\u001b[74GSolr\u001b[79Gis\u001b[82Greachable.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow to decide:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUse Solr\u001b[14G\u001b[22mif\u001b[17Gthis\u001b[22Gsite\u001b[27Ggoes\u001b[32Glive\u001b[37Gon\u001b[40Gthe\u001b[44Gsame\u001b[49Ghosting\u001b[57Gas\u001b[60Gyour\u001b[65Gother\u001b[71Gsites,\u001b[78Gor\u001b[81Gif\u001b[84Gsearch\u001b[91Gshould\u001b[98Gbehave\r\u001b[2C\u001b[1B  the same across\u001b[21Gall\u001b[25Gof\u001b[28Gthem.\r\u001b[8C\u001b[1B\u001b[1mke_search\u001b[22m \u001b[20Gf\u001b[22Gthis\u001b[27Gis a\u001b[32Gstandalone demo,\u001b[49Gf\u001b[51Gr example a conference demo that\u001b[84Ghas to\u001b[91Gcome up with\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;18