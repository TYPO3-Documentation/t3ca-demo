.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcatch\u001b[13Gis\u001b[16Gthat\u001b[21Gthis\u001b[26Gis\u001b[29Ga\u001b[31Gserver\u001b[38Gsetting.\u001b[47GThe\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[2C\u001b[1Bproblem comes b\u001b[19Gck there,\u001b[30Gnd on shared hosting\u001b[51Gyou often can't change it.\u001b[78GTurning off stopwords\u001b[100Galso\r\u001b[2C\u001b[1Blets words like \"the\" match, but\u001b[36Gke_s\u001b[41Garch ra\u001b[49Gks resul\u001b[58Gs by relevance,\u001b[74Gso that does little ha\u001b[97Gm.\u001b[100G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gadd\u001b[16Gthe\u001b[20GDDEV\u001b[25Gconfig,\u001b[33Grebuild\u001b[41Gthe\u001b[45Gindex\u001b[51Gand\u001b[55Gnote\u001b[60Gthe\u001b[64Ghosting\u001b[72Grequirement\u001b[84Gin\u001b[87Gthe\u001b[91GREADME?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 17s · done 12:59 PM\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[2555.789167, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1Bminimum length. The InnoDB settings you may\u001b[50Ghave s\u001b[58Gn\u001b[60G(\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m)\u001b[91Gdon't\u001b[97Gapply\u001b[103Gto\r\u001b[2C\u001b[1B  \u001b[6Gthis table.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWha\u001b[7G I check\u001b[16Gd:\u001b[19G\u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[47G\u001b[39mreturns\u001b[55G0\u001b[57Grows,\u001b[63Gwhile\u001b[69Ga\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries.\u001b[12GThe\u001b[16Gwords\u001b[22Gare\u001b[26Gin\u001b[29Gthe\u001b[33Gindex\u001b[39Gtable,\u001b[46Gbut\u001b[50Gthe\u001b[54Gfull-text\u001b[64Gindex\u001b[70Gskips\u001b[76Gthem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[22m change the \u001b[20Gat\u001b[23Gbase server s\u001b[37Gttings in DDEV and rebuild\u001b[64Gthe full-tex\u001b[77G index:\r\u001b[2C\u001b[2B\u001b[32m# .ddev/mysql/fulltext.cnf\u001b[39m\u001b[K\r\u001b[2C\u001b[1B[mysqld]\r\u001b[2C\u001b[1B\u001b[36mft_min_word_len\u001b[39m = \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[20G\u001b[39m=\u001b[22G\u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen \u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe catch is that this\u001b[26Gis\u001b[29Ga\u001b[31Gserver\u001b[38Gsetting.\u001b[47GThe\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[2C\u001b[1Bproblem\u001b[11Gcomes\u001b[17Gback\u001b[22Gthere,\u001b[29Gand\u001b[33Gon\u001b[36Gshared\u001b[43Ghosting\u001b[51Gyou\u001b[55Goften\u001b[61Gcan't\u001b[67Gchange\u001b[74Git.\u001b[78GTurning\u001b[86Goff\u001b[90Gstopwords\u001b[100Galso\r\u001b[2C\u001b[1Blets words like \"the\" match, but ke_search ranks results \u001b[61Gy rel\u001b[67Gvance, so that\u001b[82Gdoes\u001b[87Glitt\u001b[92Ge harm.\u001b[100G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I add the DDEV\u001b[25Gconfig, rebuild the index and no\u001b[58Ge\u001b[60Gthe hosti\u001b[70Gg requirement in\u001b[87Gthe README?\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 17s · done 12:59 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mSite search with free ke_searc\u001b[69Gt uncommitted, and \"new\" finds nothing\u001b[23m\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[2555.816718, "o", "\u001b[?25l\u001b[H     this table.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWha\u001b[7G I check\u001b[16Gd:\u001b[19G\u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[47G\u001b[39mreturns\u001b[55G0\u001b[57Grows,\u001b[63Gwhile\u001b[69Ga\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries.\u001b[12GThe\u001b[16Gwords\u001b[22Gare\u001b[26Gin\u001b[29Gthe\u001b[33Gindex\u001b[39Gtable,\u001b[46Gbut\u001b[50Gthe\u001b[54Gfull-text\u001b[64Gindex\u001b[70Gskips\u001b[76Gthem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix:\u001b[22m change the \u001b[20Gat\u001b[23Gbase server s\u001b[37Gttings in DDEV and rebuild\u001b[64Gthe full-tex\u001b[77G index:\r\u001b[2C\u001b[2B\u001b[32m# .ddev/mysql/fulltext.cnf\u001b[39m\u001b[K\r\u001b[2C\u001b[1B[mysqld]\r\u001b[2C\u001b[1B\u001b[36mft_min_word_len\u001b[39m = \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[20G\u001b[39m=\u001b[22G\u001b[31m''\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1BThen \u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[2C\u001b[1Bke_search:indexing\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe catch is that this\u001b[26Gis\u001b[29Ga\u001b[31Gserver\u001b[38Gsetting.\u001b[47GThe\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[2C\u001b[1Bproblem\u001b[11Gcomes\u001b[17Gback\u001b[22Gthere,\u001b[29Gand\u001b[33Gon\u001b[36Gshared\u001b[43Ghosting\u001b[51Gyou\u001b[55Goften\u001b[61Gcan't\u001b[67Gchange\u001b[74Git.\u001b[78GTurning\u001b[86Goff\u001b[90Gstopwords\u001b[100Galso\r\u001b[2C\u001b[1Blets words like \"the\" match, but ke_search ranks results \u001b[61Gy rel\u001b[67Gvance, so that\u001b[82Gdoes\u001b[87Glitt\u001b[92Ge harm.\u001b[100G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I add the DDEV\u001b[25Gconfig, rebuild the index and no\u001b[58Ge\u001b[60Gthe hosti\u001b[70Gg requirement in\u001b[87Gthe README?\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 17s · done 12:59 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mSite search with free ke_search is working and verified, but uncommitted, and \"new\" finds nothing\r\u001b[2C\u001b[1Bbecause the database skips short and common words. Next step: say whether I should add the DDEV \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mdatabase fix and rebuild th\u001b[32Gindex. (turn off recaps in /config)\u001b[23m\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
