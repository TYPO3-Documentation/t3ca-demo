[721.69337, "o", "\u001b[?25l\u001b[H\u001b[3Gfunding-contribution extension.\u001b[35GP\u001b[37Gges and\u001b[45Gnews are free with Solr. For \u001b[75Ghe\u001b[78G\"Documents\" results in the\u001b[K\r\u001b[2C\u001b[1Bdesign yo\u001b[13G'd n\u001b[18Ged solrfal, unless your othe\u001b[47G sites \u001b[55Glready have a\u001b[69Gfunding partnership\u001b[89Gthat\u001b[94Gincludes\u001b[103Git.\r\u001b[2C\u001b[1BFree ke_search does index PDFs\u001b[35G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m- \u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007EXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255monce cores become available?\u001b[39m                                                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Yes, that works well. ke_search and EXT:solr have the same overall shape: a search page, indexers or\u001b[K\r\u001b[2C\u001b[1Bindex\u001b[9Gqueues,\u001b[17Gfacets,\u001b[25Gand\u001b[29GFluid\u001b[35Gtemplates.\u001b[46GMost\u001b[51Gof\u001b[54Gwhat\u001b[59Gwe\u001b[62Gbuild\u001b[68Gcan\u001b[72Gstay\u001b[77Gwhen\u001b[82Gyou\u001b[86Gswitch.\u001b[94GSet\u001b[98Gup\u001b[101Ga\u001b[103Gfew\r\u001b[1B \u001b[3Gthings now to keep the switch cheap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\r\u001b[2C\u001b[1B\u001b[22m1.\u001b[6G\u001b[1mKeep the search page (uid 16)\u001b[36G\u001b[22mand\u001b[40Gthe\u001b[44G\u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[2C\u001b[1B   page changes.\u001b[K\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mMake\u001b[15Gque\u001b[19Gy parameter a setting.\u001b[22m ke_search uses \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m and Solr uses \u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\r\u001b[5C\u001b[1BIf the header\u001b[20Gform\u001b[25Gtakes\u001b[31Gthe\u001b[35Gfield\u001b[41Gname\u001b[46Gfrom\u001b[51Ga\u001b[53Gsite\u001b[58Gsetting\u001b[66Gsuch\u001b[71Gas\u001b[74G\u001b[38;2;177;185;249mmtosafi.search.queryParameter\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[6Gswitching becomes a one-line change. The cHash exclusion in \u001b[38;2;177;185;249mext_localconf.php\u001b[84G\u001b[39mhas to follow it too\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[722.139765, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mWrite the result markup as partials of our own\u001b[22m:\u001b[54Gthe\u001b[58Gresult\u001b[65Gitem,\u001b[71Gthe\u001b[75Gbadge\u001b[81Gand\u001b[85Gthe\u001b[89Gfilter\u001b[96Glist.\u001b[102GThese\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[722.443511, "o", "\u001b[?25l\u001b[H\u001b[3Gdesig\u001b[9G you'd need solrfal, unless your other \u001b[49Gites\u001b[54Galr\u001b[58Gady \u001b[63Gave a funding partnership that includes it.\r\u001b[2C\u001b[1BFree ke_search doe\u001b[22G index PDFs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSources:\r\u001b[2C\u001b[1B- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007EXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007\u001b[94mEXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[4G\u001b[38;2;255;255;255mnce cores\u001b[14Gbecome\u001b[21Gavailabl\u001b[30G?\u001b[39m                                                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Gthat\u001b[13Gworks\u001b[19Gwell.\u001b[25Gke_search\u001b[35Gand\u001b[39GEXT:solr\u001b[48Ghave\u001b[53Gthe\u001b[57Gsame\u001b[62Goverall\u001b[70Gshape:\u001b[77Ga\u001b[79Gsearch\u001b[86Gpage,\u001b[92Gindexers\u001b[101Gor\r\u001b[1B \u001b[3Gindex queues, fac\u001b[21Gts,\u001b[25Gand Fluid\u001b[35Gtemplate\u001b[44G. Most of what w\u001b[62Gbuild can stay\u001b[77Gwhen you\u001b[86Gswitch. S\u001b[96Gt up\u001b[101Ga few\r\u001b[2C\u001b[1Bthings now to\u001b[17Gkeep the switch cheap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mKeep the search\u001b[22Gpage\u001b[27G(\u001b[29Gid 16)\u001b[22m and the \u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[2C\u001b[1B  \u001b[6Gpage changes.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mMake the query parameter a setting.\u001b[42G\u001b[22mke_search\u001b[52Guses\u001b[57G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[80G\u001b[39mand\u001b[84GSolr\u001b[89Guses\u001b[94G\u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\r\u001b[2C\u001b[1B  \u001b[6GIf the header form takes the field name from a \u001b[54Gite setting such as \u001b[38;2;177;185;249mmtosafi.search.queryParameter\u001b[39m,\u001b[K\r\u001b[5C\u001b[1Bswi\u001b[10Gching b\u001b[18Gcomes a on\u001b[29G-lin\u001b[35Gchange. The cHash\u001b[53Gexclu\u001b[59Gion in\u001b[66G\u001b[38;2;177;185;249mext_localc\u001b[77Gnf.php\u001b[39m has to follow it too.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mWrite the result markup as partials of our own\u001b[22m: the result item, the badge and the filter lis\u001b[100G. These\r\u001b[2C\u001b[1B  \u001b[6Gare the \u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m and \u001b[38;2;177;185;249mdata-type\u001b[54G\u001b[39mparts of \u001b[64Ghe design.\u001b[75GKeep the ke_search templates\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[722.482886, "o", "\u001b]0;◑ Search implementation approach\u0007"]
[722.699738, "o", "\u001b[?25l\u001b[H\u001b[3GSources:\u001b[K\r\u001b[2C\u001b[1B- \u001b]8;id=2yy8pf;https://docs.typo3.org/p/apache-solr-for-typo3/solr/main/en-us/Appendix/VersionMatrix.html\u0007\u001b[94mEXT:solr version matrix\u001b[29G\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m- \u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007\u001b[94mEXT:solr 14.0.2 release\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007EXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255monce cores become available?\u001b[39m                                                                            \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Yes, that works well. ke_search and EXT:solr have the same overall shape: a search page, indexers or\u001b[K\r\u001b[1B  index queues, facets, and Fluid templates. Most of what we build can stay when you switch. Set up a few\u001b[K\r\u001b[2C\u001b[1Bthings\u001b[10Gnow\u001b[14Gto\u001b[17Gkeep\u001b[22Gthe\u001b[26Gswitch\u001b[33Gcheap.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mKeep the search page (uid 16)\u001b[22m \u001b[37Gnd\u001b[40Gthe\u001b[44G\u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[5C\u001b[1Bpage\u001b[11Gchanges.\r\u001b[2C\u001b[1B2. \u001b[1mMake the query parameter a setting.\u001b[22m ke_search\u001b[52Guses\u001b[57G\u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[80G\u001b[39mand\u001b[84GSolr\u001b[89Guses\u001b[94G\u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\r\u001b[2C\u001b[1B  \u001b[6GIf the header form takes the field name from a site setting such as\u001b[74G\u001b[38;2;177;185;249mmtosafi.search.queryParameter\u001b[39m,\u001b[K\r\u001b[5C\u001b[1Bswitching becomes\u001b[24Ga\u001b[26Gone-line\u001b[35Gchange.\u001b[43GThe\u001b[47GcHash\u001b[53Gexclusion\u001b[63Gin\u001b[66G\u001b[38;2;177;185;249mext_localconf.php\u001b[84G\u001b[39mhas\u001b[88Gto\u001b[91Gfollow\u001b[98Git\u001b[101Gtoo.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mWrite the r\u001b[18Gsult m\u001b[25Grkup as\u001b[33Gpar\u001b[38Gals of our own\u001b[22m: the result item, the badge and the\u001b[89Gfilter list. These\r\u001b[5C\u001b[1Bare the \u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m a\u001b[42Gd \u001b[38;2;177;185;249mdata-type\u001b[39m part\u001b[59G of the design. Keep the ke_search templates\u001b[K\r\u001b[5C\u001b[1Bth\u001b[9Gn wrappers around them, so the Solr templates \u001b[56Gan reuse the same partials and the\u001b[91GCSS stays\u001b[101Gas it\r\u001b[2C\u001b[1B  \u001b[6Gis.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[722.943864, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[25B\u001b[1mUse the same type keys everywhere.\u001b[41G\u001b[22mName\u001b[46Gthe\u001b[50Gke_search\u001b[60Gtags\u001b[65G\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mnews\u001b[79G\u001b[39mand\u001b[83G\u001b[38;2;177;185;249mdocument\u001b[39m,\u001b[93Gand\u001b[97Guse\u001b[101Gthe\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[723.34585, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b]8;id=fcsicj;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.0\u0007\u001b[94mEXT:solr 14.0.0 release notes\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=fcsicl;https://github.com/TYPO3-Solr/ext-solr/releases/tag/14.0.2\u0007EXT:solr 14.0.2 release\u001b]8;;\u0007\r\u001b[4C\u001b[1B\u001b]8;id=y3g043;https://github.com/TYPO3-Solr/ext-solr\u0007EXT:solr README\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 29s · done 12:37 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255moh we dont have a solr core version 10.0 yet. Can we go with ke_search now and replace it with solr \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255monce cores become available?\u001b[39m                                                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Yes, that works well. ke_search and EXT:solr have the same overall shape: a search page, indexers or\u001b[K\r\u001b[2C\u001b[1Bindex\u001b[9Gqueues,\u001b[17Gfacets,\u001b[25Gand\u001b[29GFluid\u001b[35Gtemplates.\u001b[46GMost\u001b[51Gof\u001b[54Gwhat\u001b[59Gwe\u001b[62Gbuild\u001b[68Gcan\u001b[72Gstay\u001b[77Gwhen\u001b[82Gyou\u001b[86Gswitch.\u001b[94GSet\u001b[98Gup\u001b[101Ga\u001b[103Gfew\r\u001b[1B \u001b[3Gthings now to keep the switch cheap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to build so they outlive ke_search\r\u001b[2C\u001b[1B\u001b[22m1.\u001b[6G\u001b[1mKeep the search page (uid 16)\u001b[36G\u001b[22mand\u001b[40Gthe\u001b[44G\u001b[38;2;177;185;249mmtosafi.navigation.searchPage\u001b[74G\u001b[39msetting.\u001b[83GOnly\u001b[88Gthe\u001b[92Gplugin\u001b[99Gon\u001b[102Gthe\r\u001b[2C\u001b[1B   page changes.\u001b[K\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mMake\u001b[15Gque\u001b[19Gy parameter a setting.\u001b[22m ke_search uses \u001b[38;2;177;185;249mtx_kesearch_pi1[sword]\u001b[39m and Solr uses \u001b[38;2;177;185;249mtx_solr[q]\u001b[39m.\r\u001b[5C\u001b[1BIf the header\u001b[20Gform\u001b[25Gtakes\u001b[31Gthe\u001b[35Gfield\u001b[41Gname\u001b[46Gfrom\u001b[51Ga\u001b[53Gsite\u001b[58Gsetting\u001b[66Gsuch\u001b[71Gas\u001b[74G\u001b[38;2;177;185;249mmtosafi.search.queryParameter\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[6Gswitching becomes a one-line change. The cHash exclusion in \u001b[38;2;177;185;249mext_localconf.php\u001b[84G\u001b[39mhas to follow it too\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mWrite the result markup as partials of our own\u001b[22m: th\u001b[58Gr\u001b[60Gsult item,\u001b[71Gthe badge and the filter list. These\r\u001b[5C\u001b[1Bare t\u001b[12Ge \u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m and \u001b[38;2;177;185;249mdata-type\u001b[39m part\u001b[59G \u001b[61Gf\u001b[63Gthe design. Keep the\u001b[84Gke_search templates\u001b[K\r\u001b[2C\u001b[1B  \u001b[6Gthin wrappers around them, so the Solr templates can re\u001b[62Gse\u001b[65Gth\u001b[68G same partials and the CSS stays as it\u001b[K\r\u001b[5C\u001b[1Bis.\u001b[10G\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mUse the same type keys everywhere.\u001b[22m Name the ke_\u001b[54Gearch tags\u001b[65G\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mnews\u001b[39m \u001b[80Gnd\u001b[83G\u001b[38;2;177;185;249mdocument\u001b[39m, and use\u001b[101Gthe\u001b[K\r\u001b[5C\u001b[1Bsame\u001b[11Gvalues\u001b[18Gfor\u001b[22Gthe\u001b[26GSolr\u001b[31Gfacet\u001b[37Glater.\u001b[44GThen\u001b[49Gthe\u001b[53Gbadges\u001b[60Gand\u001b[64Gfilters\u001b[72Gdon't\u001b[78Gchange.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
