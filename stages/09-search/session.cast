[363.878599, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B      \u001b[24G      \u001b[37Gopened  \u001b[46G   \u001b[59G     \u001b[72G      \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[2C\u001b[1B│                  │            │                    │             │          │ High (needs a     │\r\u001b[4C\u001b[1BSolr\u001b[24G✅\u001b[37G✅\u001b[58G✅\u001b[72G✅\u001b[83GSolr\u001b[88Gserver) —\r\u001b[4C\u001b[1B    \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Gt\u001b[85Go much for\u001b[96Gthis\r\u001b[82C\u001b[1B site   \u001b[92G   \u001b[96G    \r\u001b[2C\u001b[1B├──────────────────┼────────────┼────────────────────┼─────────────┼──────────┼───────────────────┤\r\u001b[2C\u001b[1B│ Custom Extbase   │ ✅         │ ✅                 │ ❌          │ ✅       │ Medium, and no    │\r\u001b[4C\u001b[1BSQL \u001b[38;2;177;185;249mLIKE\u001b[39m      \u001b[24G  \u001b[37G  \u001b[58G  \u001b[72G  \u001b[83Granking\u001b[91G   \u001b[95G  \r\u001b[2C\u001b[1B└──────────────────┴────────────┴────────────────────┴─────────────┴──────────┴───────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy \u001b[48;2;38;79;120mke_search\r\u001b[2C\u001b[1B\u001b[49m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt indexes from the database, not from rendered pages.\u001b[60G\u001b[22mNews\u001b[65Grecords\u001b[73Gget\u001b[77Gindexed\u001b[85Gwithout\u001b[93Ga\u001b[95Gcrawler,\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5Gthe index doesn't depend on someone opening a page first.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe filter maps onto facets.\u001b[22m Give \u001b[40Gach indexer \u001b[53G tag (\u001b[38;2;177;185;249mservice\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mnews\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mdocument\u001b[39m)\u001b[84Gand\u001b[88Gthe\u001b[92G\"Show\u001b[98Gonly\"\r\u001b[2C\u001b[1B \u001b[5Gcheckboxes become a ke_search filt\u001b[40Gr of type checkbox.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe output is Fluid.\u001b[22m You can override the t\u001b[49Gmplates in\u001b[60Gthe\u001b[64Gsitepackage,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gyou\u001b[94Galready\u001b[102Gdo\r\u001b[2C\u001b[1B \u001b[5Gfor News under \u001b[38;2;177;185;249mResources/Private/Extensions/\u001b[39m, and reproduce th\u001b[68G markup:\u001b[77G\u001b[38;2;177;185;249mol.search-results\u001b[39m, \u001b[38;2;177;185;249m.badge\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata-type\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImplementation steps\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249mcomposer require tpwd/ke_search\u001b[38G\u001b[39m(check\u001b[45Gthe\u001b[49GComposer\u001b[58Gname\u001b[63Gwith\u001b[68G\u001b[38;2;177;185;249mcomposer show\u001b[39m),\u001b[84Gthen\u001b[89Grun\u001b[93G\u001b[38;2;177;185;249mtypo3 \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;177;185;249mexten\u001b[12Gion:setup\u001b[39m.\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
