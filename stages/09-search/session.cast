[1974.112551, "o", "\u001b[?25l\u001b[H\u001b[5G full-text index. Lowering \u001b[38;2;177;185;249msearchWordLength\u001b[39m to 3 in ke_search\u001b[67Gonly\u001b[72Gstopped\u001b[80Gthe\u001b[84G\"too\u001b[89Gshort\"\u001b[96Gmessage;\r\u001b[5C\u001b[1Bthe\u001b[10Gdatabase\u001b[19Gstill\u001b[25Gdrops\u001b[31Gthose\u001b[37Gwords.\u001b[44G\"tax\"\u001b[50Gand\u001b[54G\"fee\"\u001b[60Gfail\u001b[65Gthe\u001b[69Gsame\u001b[74Gway.\r\u001b[2C\u001b[1B2. \u001b[1mStopwords.\u001b[22m MyISAM's built-in stopword\u001b[44Glist\u001b[49Gincludes\u001b[58G\u001b[1m\"new\"\u001b[22m,\u001b[65Gso\u001b[68Git\u001b[71Gwould\u001b[77Gbe\u001b[80Gignored\u001b[88Geven\u001b[93Gwith\u001b[98Ga\u001b[100Glower\r\u001b[2C\u001b[1B  \u001b[6Gminimum length. The InnoDB settings you may have seen (\u001b[38;2;177;185;249minnodb_ft_min_token_size = 3\u001b[39m) don't apply to\u001b[K\r\u001b[7C\u001b[1Bis table.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat I checked:\u001b[19G\u001b[38;2;177;185;249mMATCH(...) AGAINST('+new*')\u001b[47G\u001b[39mreturns\u001b[55G0\u001b[57Grows,\u001b[63Gwhile\u001b[69Ga\u001b[71Gplain\u001b[77G\u001b[38;2;177;185;249mLIKE '%new %'\u001b[91G\u001b[39mfinds\u001b[97G4\u001b[99Gindex\r\u001b[2C\u001b[1Bentries. The words are in the index table, but the full-text index skips them.\u001b[82G\u001b[K\r\u001b[2C\u001b[2B\u001b[1mFix:\u001b[22m change the database server settings\u001b[44Gin DDEV and rebuild the full\u001b[73Gt\u001b[75Gxt index:\u001b[K\r\u001b[2B \u001b[3G\u001b[32m# .ddev/mysql/fulltext.cnf\u001b[39m\u001b[K\r\u001b[2C\u001b[1B[mysqld]\r\u001b[1B \u001b[3G\u001b[36mft_min_word_len\u001b[39m = \u001b[32m3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[36mft_stopword_file\u001b[39m = \u001b[31m''\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThen\u001b[8G\u001b[38;2;177;185;249mddev restart\u001b[39m,\u001b[22Gfollowed\u001b[31Gby\u001b[34G\u001b[38;2;177;185;249mREPAIR TABLE tx_kesearch_index QUICK\u001b[71G\u001b[39mor\u001b[74Gsimply\u001b[81Gre-running\u001b[92G\u001b[38;2;177;185;249mddev exec typo3\r\u001b[1B\u001b[39m  \u001b[38;2;177;185;249mke_search:indexing\u001b[39m.\u001b[K\r\u001b[2B \u001b[3GT\u001b[6G catch is \u001b[17Gha\u001b[21Gthis is\u001b[29Ga s\u001b[33Grver setting. The\u001b[51Glive\u001b[56Gdatabase\u001b[65Gserver\u001b[72Gneeds\u001b[78Gthe\u001b[82Gsame\u001b[87Gtwo\u001b[91Glines\u001b[97Gor\u001b[100Gthe\r\u001b[1B  problem comes back there, and on shared hosting you often can't change it. Turning off stopwords\u001b[100Galso\r\u001b[2C\u001b[1Blets words like \"the\" match, but ke_search ranks results by relevance, so that does little harm.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I add the\u001b[20GDDEV\u001b[25Gconfig,\u001b[33Grebuild\u001b[41Gthe\u001b[45Gindex\u001b[51Gand\u001b[55Gnote\u001b[60Gthe\u001b[64Ghosting\u001b[72Grequirement\u001b[84Gin\u001b[87Gthe\u001b[91GREADME?\r\u001b[13C\u001b[2B\u001b[38;2;153;153;153m7\u001b[21G1.5k tokens · \u001b[38;2;183;183;183mthinking\u001b[38;2;153;153;153m)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
