[431.178319, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1m\"Slider\" content element\u001b[30G\u001b[22m(\u001b[38;2;177;185;249mmtosafi_slider\u001b[39m, group \"Mto Safi\"). Each slide has\u001b[81Gan\u001b[84Gimage,\u001b[91Ga\u001b[93Gheading,\u001b[102Ga\r\u001b[4C\u001b[1Btext, and\u001b[15Ga\u001b[17Gbutton\u001b[24Gmade\u001b[29Gof\u001b[32Ga\u001b[34Gbutton\u001b[41Gtext and a link. Slides are \u001b[70Gdited,\u001b[77Gsorted,\u001b[85Ghidden\u001b[92Gand\u001b[96Gtranslated\r\u001b[4C\u001b[1Binside\u001b[12Gthe\u001b[16Gelement's\u001b[26Gform.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe element's header\u001b[26G\u001b[22mis\u001b[29Grequired and isn'\u001b[48Gshown on the\u001b[61Gpage. Screen readers\u001b[82Guse\u001b[86Git\u001b[89Gas\u001b[92Gthe\u001b[96Gcarousel's\r\u001b[4C\u001b[1Bname: \"Highlights\"\u001b[24Gon\u001b[27Gthe\u001b[31Ghome\u001b[36Gpage,\u001b[42Gas\u001b[45Gin the\u001b[52Gdesign.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mImages\u001b[22m are\u001b[16Gdecoration\u001b[27Gbehind\u001b[34Gthe\u001b[38Gcaption, so they render with \u001b[38;2;177;185;249malt=\"\"\u001b[39m,\u001b[75Gas\u001b[78Gin\u001b[81Gthe\u001b[85Gdesign.\u001b[93GThey\u001b[98Gare\r\u001b[4C\u001b[1Bcropped to 1600×560.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe button\u001b[22m only appears when a slide has both a button text and a link.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mslider.js\u001b[15G\u001b[22m\u001b[39mis\u001b[18Gthe\u001b[22Gdesign's\u001b[31Gscript,\u001b[39Gloaded only on pages that have a slider. Its \u001b[85Gcre\u001b[89Gn-rea\u001b[96Gr l\u001b[100Gbels\r\u001b[4C\u001b[1Bnow come \u001b[15Granslated from\u001b[30G\u001b[38;2;177;185;249mfrontend.xlf\u001b[43G\u001b[39minstead\u001b[51Gof\u001b[54Gbeing\u001b[60Ghard-coded\u001b[71Gin\u001b[74Gthe\u001b[78Gscript.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPage-module preview:\u001b[26G\u001b[22mone\u001b[30Gline\u001b[35Gper\u001b[39Gslide, w\u001b[48Gth a thumbnail, the heading and where the button links.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent and setup:\u001b[45G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mseed-home.php\u001b[39m now seeds the design's\u001b[42Gthree\u001b[48Gslides.\u001b[56GThe\u001b[60Gbuttons\u001b[68Glink\u001b[73Gto\u001b[76GTrade\u001b[82G&\u001b[84Gtourism,\u001b[93GLand\u001b[98Grates\u001b[104Gand\r\u001b[4C\u001b[1BPublic participation,\u001b[27Gwhich\u001b[33Gstand\u001b[39Gin\u001b[42Gfor th\u001b[49G \u001b[51Gesign's \u001b[38;2;177;185;249m#\u001b[39m links. It now skips whichever\u001b[91Gelement\u001b[99Gthe\r\u001b[4C\u001b[1Bhome page\u001b[15Galready\u001b[23Ghas,\u001b[28Ginstead\u001b[36Gof\u001b[39Grefusing to run at all.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdata.xml\u001b[14G\u001b[39mis\u001b[17Gre-exported,\u001b[30Gand\u001b[34Gfor\u001b[38Gthe\u001b[42Gfirst time it ships files: the three SVGs in\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mInitialisation/data.xml.files/\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5GThe Editors group now gets the slide table and a second file mount, \"Slider images\"\u001b[K\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249mfileadmin/user_upload/slides/\u001b[39m).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI updated the README.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mFixed along the way:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gimage\u001b[15Gfirst\u001b[21Greached\u001b[29Gthe\u001b[33Gtemplate\u001b[42Gas\u001b[45Ga\u001b[47Glist,\u001b[53Gwhich\u001b[59Gcrashed\u001b[67Gthe\u001b[71Gpage.\u001b[77GA\u001b[79Gsingle\u001b[86Gimage\u001b[92Gneeds\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249m'relationship' => 'manyToOne'\u001b[39m in the TCA; limiting it\u001b[59Gto\u001b[62Gone\u001b[66Gitem\u001b[71Gisn't\u001b[77Genough.\r\u001b[1B  - TYPO3 cleans up SVG files when it imports them, and it rewrote the\u001b[72Goriginal\u001b[81Gfiles\u001b[87Gin\u001b[90G\u001b[38;2;177;185;249mdesign/images/\u001b[39m.\u001b[106GI\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[431.610814, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gtext, and a button made of a button text and a link.\u001b[59Glides are edite\u001b[75G,\u001b[77Gsorted, hidden and transl\u001b[103Gted\r\u001b[4C\u001b[1Binside the element's form.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe element's header\u001b[26G\u001b[22mis required\u001b[38Gand\u001b[42Gisn't\u001b[48Gshown\u001b[54Gon\u001b[57Gthe\u001b[61Gpage.\u001b[67GScreen\u001b[74Greaders\u001b[82Guse\u001b[86Git\u001b[89Gas\u001b[92Gthe\u001b[96Gcarousel's\r\u001b[2C\u001b[1B \u001b[5Gname: \"Highlights\" on the home page,\u001b[42Ga\u001b[44G in\u001b[48Gt\u001b[50Ge design.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mImages\u001b[22m are decorati\u001b[27Gbehind the caption, so they re\u001b[58Gder\u001b[62Gwith\u001b[67G\u001b[38;2;177;185;249malt=\"\"\u001b[39m,\u001b[75Gas\u001b[78Gin\u001b[81Gthe\u001b[85Gdesign.\u001b[93GThey\u001b[98Gare\r\u001b[2C\u001b[1B \u001b[5Gcropped to\u001b[16G1600×560.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe button\u001b[16G\u001b[22monly appears\u001b[29Gwhen\u001b[34Ga\u001b[36Gslide\u001b[42Ghas\u001b[46Gboth\u001b[51Ga\u001b[53Gbutton\u001b[60Gtext\u001b[65Gand\u001b[69Ga\u001b[71Glink.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mslider.js\u001b[22m\u001b[39m is the design's script, loaded\u001b[46Gonly\u001b[51Gon pages\u001b[61Gha\u001b[65Ghave a slider.\u001b[80GIts\u001b[84Gscreen-reader\u001b[98Glabels\r\u001b[2C\u001b[1B \u001b[5Gnow come translated from \u001b[38;2;177;185;249mfrontend.xlf\u001b[39m instead\u001b[52Gf\u001b[54Gbeing\u001b[60Ghard-cod\u001b[69Gd in th\u001b[77G script.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPage-module preview:\u001b[22m one\u001b[30Gline per slide, with\u001b[51Ga thumbnail, the heading and where\u001b[86Gthe\u001b[90Gbutton\u001b[97Glinks.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent and setup:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249mseed-home.php\u001b[39m now\u001b[23Gseeds\u001b[29Gthe\u001b[33Gdesign's\u001b[42Gthree\u001b[48Gslides.\u001b[56GThe\u001b[60Gbuttons\u001b[68Glink\u001b[73Gto\u001b[76GTrade\u001b[82G&\u001b[84Gtourism,\u001b[93GLand\u001b[98Grates\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5GPublic participation, which\u001b[33Gstand in\u001b[42Gfo\u001b[45G the design's \u001b[38;2;177;185;249m#\u001b[39m links.\u001b[68GIt now skips whichever element th\u001b[102G\u001b[K\r\u001b[4C\u001b[1Bhome page already has, instead of\u001b[39Grefusing to run at all.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdata.xml\u001b[39m is \u001b[19G-exported, and for th\u001b[41G first\u001b[49Gime it ships files:\u001b[69Gthe\u001b[73Gthree\u001b[79GSVGs\u001b[84Gin\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mInitialisation/data.xml.files/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe Editors group now gets the slide\u001b[42Gtable\u001b[48Gand\u001b[52Ga\u001b[54Gsecond\u001b[61Gfile\u001b[66Gmount,\u001b[73G\"Slider\u001b[81Gimages\"\r\u001b[2C\u001b[1B \u001b[5G(\u001b[38;2;177;185;249mfileadmin/user_upload/slides/\u001b[39m).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI updated the README.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFixed along the way:\r\u001b[2C\u001b[1B\u001b[22m- The image first reached\u001b[29Gthe\u001b[33Gtemplate\u001b[42Gas\u001b[45Ga\u001b[47Glist,\u001b[53Gwhich\u001b[59Gcrashed\u001b[67Gthe\u001b[71Gpage.\u001b[77GA\u001b[79Gsingle\u001b[86Gimage\u001b[92Gneeds\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m'relationship' => 'manyToOne'\u001b[39m in th\u001b[42GTCA;\u001b[49Gmiting it\u001b[59Gto on\u001b[65G i\u001b[68Gem\u001b[71Gisn't\u001b[77Genough.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GTYPO3 cleans up SVG files when it imports\u001b[47Gthem, and it rewrote the original files\u001b[87Gin\u001b[90G\u001b[38;2;177;185;249mdesign/images/\u001b[39m.\u001b[106GI\r\u001b[2C\u001b[1B \u001b[5Grestored them from git. The seed now gives TYPO3 a tempora\u001b[64Gy copy,\u001b[72Gand a rerun left \u001b[38;2;177;185;249mdesign/\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[431.76105, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mImages\u001b[22m are decoration behind\u001b[34Gthe cap\u001b[42Gion, so\u001b[50Gthey render with \u001b[38;2;177;185;249malt=\"\"\u001b[39m, as in the\u001b[85Gdesig\u001b[91G. They \u001b[99Gre\u001b[K\r\u001b[4C\u001b[1Bcropp\u001b[11Gd to\u001b[16G1600×560.\u001b[26G\u001b[K\r\u001b[8C\u001b[1B\u001b[1mbutto\u001b[15G\u001b[22m only appear\u001b[29Gwhen a slide\u001b[42Ghas bot\u001b[50G a button text and a link.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mslider.js\u001b[22m\u001b[39m is t\u001b[20Ge design's\u001b[31Gscript, loaded only on pa\u001b[57Ges\u001b[60Gthat\u001b[65Ghave\u001b[70Ga\u001b[72Gslider.\u001b[80GIts\u001b[84Gscreen-reader\u001b[98Glabels\r\u001b[2C\u001b[1B \u001b[5Gnow come translated from \u001b[38;2;177;185;249mfrontend.xlf\u001b[39m i\u001b[45Gstead of bei\u001b[58Gg hard-coded in the\u001b[78Gscript.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPage-module preview:\u001b[26G\u001b[22mone\u001b[30Gline\u001b[35Gper\u001b[39Gslide,\u001b[46Gwith\u001b[51Ga\u001b[53Gthumbnail,\u001b[64Gthe\u001b[68Gheading\u001b[76Gand\u001b[80Gwhere\u001b[86Gthe\u001b[90Gbutton\u001b[97Glinks.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mContent and setup:\u001b[22G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mseed-home.php\u001b[39m now seeds the design's three slides. The\u001b[60Gbuttons link to Trade & tourism,\u001b[93GLand\u001b[98Grates\u001b[104Gand\r\u001b[2C\u001b[1B \u001b[5GPublic participation, which stand\u001b[39Gin for\u001b[46Gthe design's \u001b[38;2;177;185;249m#\u001b[39m \u001b[62Ginks.\u001b[68GIt now skips whichev\u001b[89Gr element the\u001b[K\r\u001b[4C\u001b[1Bhome\u001b[10Gpage\u001b[15Galready\u001b[23Ghas,\u001b[28Ginstead\u001b[36Gof\u001b[39Grefusing\u001b[48Gto\u001b[51Grun\u001b[55Gat\u001b[58Gall.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mdata.xml\u001b[39m is re-exported,\u001b[30Gand\u