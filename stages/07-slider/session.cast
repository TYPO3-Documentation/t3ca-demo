[403.682254, "o", "\u001b[?25l\u001b[H\u001b[14G\u001b[1mBuild/Initiali\u001b[29Gation/seed-home.php\u001b[22m \u001b[38;2;56;166;96m+9\u001b[53G\u001b[38;2;179;89;107m3\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(a git step in this command can move the working tree, so these may be its changes, not edits) \r\u001b[5C\u001b[1BAllowed by auto mode\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Re-running the seed from\u001b[28Gthe\u001b[32Gpre-slider\u001b[43Gsnapshot\u001b[52Gto\u001b[55Gprove\u001b[61Gthat\u001b[66Gpath,\u001b[72Gand\u001b[76Gchecking\u001b[85Gthat\u001b[90Gthe\u001b[94Gdesign\u001b[101Gfiles\r\u001b[2C\u001b[1Bstay\u001b[8Guntouched:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe rerun died with an\u001b[26Gerror,\u001b[33Gyet\u001b[37Gthe\u001b[41Gslider\u001b[48Gexists.\u001b[56GI\u001b[58Gneed\u001b[63Gthe\u001b[67Gwhole\u001b[73Goutput,\u001b[81Gso\u001b[84GI'm\u001b[88Grestoring\u001b[98Gand\r\u001b[2C\u001b[1Brunning\u001b[11Git\u001b[14Gagain:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe snapshot predates\u001b[25Gthe\u001b[29Gslide\u001b[35Gtable\u001b[41Gthat\u001b[46G\u001b[38;2;177;185;249mextension:setup\u001b[62G\u001b[39mcreates,\u001b[71Gwhich\u001b[77Galso\u001b[82Gexplains\u001b[91Gthe\u001b[95Gearlier\r\u001b[2C\u001b[1Bslider\u001b[10Grow\u001b[14Gfailure.\u001b[23GSetting\u001b[31Gup\u001b[34Gthe\u001b[38Gextension,\u001b[49Gthen\u001b[54Gseeding.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mResto\u001b[9Ge, set up schema, seed, verify\u001b[38;2;153;153;153m · 2s\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ddev snapshot restore before-slider 2>&1 | tail -1 && rm -rf public/fileadmin/user_upload/slides &&\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mddev exec typo3 extension:setup -e mtosafi_sitepackage 2>&1 | tail -1 && ddev exec typo3 cache:flush\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m>/\u001b[9Gev/null && ddev exec\u001b[30Gphp Build/Initialisation/seed-home.php\u001b[69G2>&1 | head; g\u001b[84Gt status --short \u001b[102G… \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(ctrl+b to\u001b[17Grun in background)\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
