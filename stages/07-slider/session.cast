[101.707989, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThe tiles look good. Lets do the slides next\u001b[39m                                                            \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSlides = the home page slider content element.\u001b[50GStarting\u001b[59Gwith\u001b[64Gthe\u001b[68Gproject\u001b[76Gdescription\u001b[88Gand\u001b[92Gthe\r\u001b[2C\u001b[1Bcontent-element\u001b[19Gskill.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(\u001b[10Gypo3-content-element-development)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoaded\u001b[13Gskill\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mCalled typo3-dev-companion \u001b[1m4\u001b[22m times, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mReading the design's slider and the existing Tiles element\u001b[62Gas\u001b[65Gthe\u001b[69Gpattern;\u001b[78Gthen\u001b[83GI'll\u001b[88Gbuild\u001b[94G\"Slides\"\u001b[103Gthe\r\u001b[2C\u001b[1Bsame\u001b[8Gway\u001b[12G(inline\u001b[20Gchild\u001b[26Gtable,\u001b[33GFluid,\u001b[40GAssetCollector\u001b[55GJS).\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, called typo3-dev-companion, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe v14 deprecation sweep doesn't touch this change, so I'm building the\u001b[76Gslider\u001b[83Gfollowing\u001b[93Gthe\u001b[97GTiles\r\u001b[2C\u001b[1Bpattern:\u001b[12Ga\u001b[14Gslider\u001b[21Gcontent\u001b[29Gtype\u001b[34Gwith\u001b[39Ginline\u001b[46Gslides,\u001b[54Gthe\u001b[58Gslide\u001b[64Gfields,\u001b[72Gthe\u001b[76GJS\u001b[79Gfrom\u001b[84Gthe\u001b[88Gdesign,\u001b[96Gand