[394.935848, "o", "\u001b[?25l\u001b[H\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(git checkout -- \u001b[26Gsign/images/slide-coast.svg design/images/slide-community.svg\r\u001b[6C\u001b[1Bdesign/images/s\u001b[24Gde-rate\u001b[32G.svg &&\u001b[40Gpython3\u001b[48G-\u001b[50G<<'EOF'\r\u001b[1B      p='Build/Initialisation/seed-…)\u001b[K\r\u001b[5C\u001b[1BNo syntax errors detected in Build/Initialisation/seed-home.php\r\u001b[35C\u001b[1B\u001b[1mast.svg\u001b[22m \u001b[38;2;56;166;96m+12\u001b[48G\u001b[38;2;179;89;107m-13\u001b[52G\u001b[39m\u001b[K\r\u001b[33C\u001b[1B\u001b[1mcommunity.svg\u001b[48G\u001b[22m\u001b[38;2;56;166;96m+12\u001b[52G\u001b[38;2;179;89;107m-13\r\u001b[13C\u001b[1B\u001b[39m\u001b[1mdesign/images/\u001b[29Glide-rat\u001b[38Gs.svg\u001b[22m \u001b[38;2;56;166;96m+14\u001b[39m \u001b[38;2;179;89;107m-15\u001b[52G\u001b[39m\u001b[K\r\u001b[5C\u001b[1BUpdated \u001b[1mBuild/Initialisation/seed-home.php\u001b[22m \u001b[38;2;56;166;96m+9\u001b[39m \u001b[38;2;179;89;107m-3\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(a git step in this command can move the working tree, so these may be its changes, not edits) \r\u001b[1B  ⎿  Allowed by auto mode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRe-run\u001b[10Ging the seed\u001b[23Gfrom\u001b[28Gthe\u001b[32Gpre-slider\u001b[43Gsnapshot\u001b[52Gto\u001b[55Gprove\u001b[61Gthat\u001b[66Gpath,\u001b[72Gand\u001b[76Gchecking\u001b[85Gthat\u001b[90Gthe\u001b[94Gdesign\u001b[101Gfiles\r\u001b[2C\u001b[1Bstay\u001b[8Guntouched:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe rerun died with\u001b[23Gan\u001b[26Gerror,\u001b[33Gyet\u001b[37Gthe\u001b[41Gslider\u001b[48Gexists.\u001b[56GI\u001b[58Gneed\u001b[63Gthe\u001b[67Gwhole\u001b[73Goutput,\u001b[81Gso\u001b[84GI'm\u001b[88Grestoring\u001b[98Gand\r\u001b[2C\u001b[1Brunning\u001b[11Git\u001b[14Gagain:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Reseed from snapshot capturing full output\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ddev snapsh\u001b[20Gt\u001b[22Grestore before-slider 2>\u001b[47G1 | tail -1 &&\u001b[62Grm -rf public/fileadmin/user_upload/slides &&\r\u001b[5C\u001b[1Bddev\u001b[11Gexec\u001b[16Gtypo3 cache:flush >\u001b[36Gdev/nu\u001b[43Gl && ddev \u001b[54Gxec php Build/Initia\u001b[76Gsation/seed-home.php 2>&1 | \r\u001b[5C\u001b[1Bhead -30; sed -n 45,55p B\u001b[32Gild/Initialisation/seed-home.php\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
