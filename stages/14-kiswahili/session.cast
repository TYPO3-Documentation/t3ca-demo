[2257.392742, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1m1. Register a translation file\u001b[34G\u001b[22min\u001b[37G\u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m,\u001b[81Gso\u001b[84Git\u001b[87Gapplies\u001b[95Gto\u001b[98Gevery\u001b[104Gform\u001b[109Gof\u001b[112Gthe\u001b[116Gsite:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[36mprototypes:\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[36mstandard:\r\u001b[1B\u001b[39m \u001b[3G    \u001b[36mformElementsDefinition:\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[36mForm:\r\u001b[2C\u001b[1B\u001b[39m        \u001b[36mrenderingOptions:\u001b[29G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B    \u001b[8G    \u001b[13G\u001b[36mtranslation:\u001b[39m\u001b[K\r\u001b[14C\u001b[1B\u001b[36mtranslationFiles:\r\u001b[2C\u001b[1B\u001b[39m        \u001b[12G \u001b[14G   \u001b[36m20:\u001b[39m \u001b[31m'EXT:mtosafi_sitepackage/Resources/Private/Language/form.xlf'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Write \u001b[38;2;177;185;249mform.xlf\u001b[39m and \u001b[38;2;177;185;249msw.form.xlf\u001b[22m\u001b[39m, with keys\u001b[48Gbu\u001b[51Glt\u001b[54Gfrom the form'\u001b[70Gidentifi\u001b[79Gr \u001b[38;2;177;185;249mcontact\u001b[89G\u001b[39mand each\u001b[98Gelement's identifier:\r\u001b[2C\u001b[2B┌────────────────────────────┬────────────────────────────────────────────────────────────────────────────────────────────────────────┐\u001b[139G\u001b[K\r\u001b[2C\u001b[1B│      \u001b[11G   \u001b[15G What  \u001b[23G       \u001b[31G │\u001b[34G       \u001b[42G    \u001b[47G     \u001b[53G   \u001b[57G       \u001b[65G      \u001b[72G     \u001b[78G     Key \u001b[88G    \u001b[93G \u001b[95G       \u001b[103G   \u001b[107G       \u001b[137G│\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Field label   \u001b[20G   \u001b[24G    \u001b[29G   │ \u001b[38;2;177;185;249mcontact.element.name.properties.label\u001b[72G\u001b[39m    \u001b[77G  \u001b[80G  \u001b[83G   \u001b[87G         \u001b[97G       \u001b[105G   \u001b[109G      \u001b[116G   \u001b[120G    \u001b[125G     \u001b[137G│\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Hint,\u001b[11Gpla\u001b[15Geholder \u001b[24G    \u001b[29G   │ \u001b[38;2;177;185;249mcontact.element.message.properties.elementDescription\u001b[39m, \u001b[38;2;177;185;249mcontact\u001b[97Gelement.phone.properties.placeholder\u001b[39m    │\u001b[K\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GSelect\u001b[12Goptions\u001b[32G│\u001b[34G\u001b[38;2;177;185;249mcontact.element.topic.properties.options.revenue\u001b[39m,\u001b[84G\u001b[38;2;177;185;249mcontact.element.topic.properties.prependOptionLabel\u001b[137G\u001b[39m│\r\u001b[1B \u001b[3G├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GStatic\u001b[12Gtext\u001b[32G│\u001b[34G\u001b[38;2;177;185;249mcontact.element.required-hint.properties.text\u001b[137G\u001b[39m│\r\u001b[1B \u001b[3G├────────────────────────────┼─────────────────────"]
[2257.392923, "o", "───────────────────────────────────────────────────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│ Submit button              │ \u001b[38;2;177;185;249mcontact.element.contact.renderingOptions.submitButtonLabel\u001b[39m    \u001b[137G│\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[1B  │ Confirmation, mail subject │ \u001b[38;2;177;185;249mcontact.finisher.Confirmation.message\u001b[39m, \u001b[38;2;177;185;249mcontact.finisher.EmailToReceiver.subject\u001b[39m                        │\u001b[K\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Error message     \u001b[32G│\u001b[34G\u001b[38;2;177;185;249mcontact.validation.error.phone.1221565130\u001b[39m,\u001b[77Gor\u001b[80G\u001b[38;2;177;185;249mvalidation.error.1221560910\u001b[108G\u001b[39mfor\u001b[112Gone\u001b[116Gshared\u001b[123Gby\u001b[126Gall\u001b[130Gfields\u001b[137G│\r\u001b[2C\u001b[1B└────────────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GEnglish\u001b[15Gtext\u001b[20Gin\u001b[23Gthe\u001b[27Gform's\u001b[34GYAML\u001b[39Gstays\u001b[45Gas\u001b[48Gthe\u001b[52Gsource.\u001b[60GAny\u001b[64Gkey\u001b[68Gmissing\u001b[76Gfrom\u001b[81Gthe\u001b[85G\u001b[38;2;177;185;249msw\u001b[88G\u001b[39mfile\u001b[93Gfalls\u001b[99Gback\u001b[104Gto\u001b[107Gthat\u001b[112GEnglish\u001b[120Gtext.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mTwo things the YAML can't keep as they are:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCustom error messages:\u001b[22m the messages written directly into the YAML (the phone number and the two \"I'm not a robot\"\u001b[120Gmessages)\u001b[130Gare\u001b[134Greturned\u001b[143Gas\u001b[146Gthey\u001b[151Gare\u001b[155Gand\r\u001b[4C\u001b[1Bnever\u001b[11Gtranslated.\u001b[23GThey\u001b[28Ghave\u001b[33Gto\u001b[36Gmove\u001b[41Ginto\u001b[46Gthe\u001b[50GXLF\u001b[54Gunder\u001b[60Gthe\u001b[64Gkeys\u001b[69Gabove.\r\u001b[1B \u001b[3G-\u001b[K\u001b[42;1H\u001b[40;3H\u001b[?25h"]
[2257.781833, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[36B\u001b[1mStandard error messages:\u001b[30G\u001b[22mthe\u001b[34Gdefault\u001b[42Gmessages\u001b[51G(\"This\u001b[58Gfield\u001b[64Gis\u001b[67Gmandatory\",\u001b[79G\"invalid\u001b[88Gemail\u001b[94Gaddress\")\u001b[104Gcome\u001b[109Gfrom\u001b[114GEXT:form's\u001b[125Gown\u001b[129Glabels.\u001b[137GTYPO3\u001b[143Ghas\u001b[147Gno\u001b[150GKiswahili\u001b[42;1H\u001b[40;3H\u001b[?25h"]
[2258.325888, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[36mprototypes:\r\u001b[2C\u001b[1B\u001b[39m  \u001b[36ms\u001b[7Gandard\r\u001b[4C\u001b[1B\u001b[39m  \u001b[36mformElementsDefinition:\r\u001b[6C\u001b[1B\u001b[39m  \u001b[36mForm:\u001b[39m\u001b[K\r\u001b[8C\u001b[1B  \u001b[12G\u001b[36menderingOptions:\r\u001b[10C\u001b[1B\u001b[39m  \u001b[36mtranslation:\u001b[39m\u001b[K\r\u001b[12C\u001b[1B  \u001b[36mtranslationFiles:\r\u001b[14C\u001b[1B\u001b[39m  \u001b[36m20:\u001b[39m \u001b[31m'EXT:mtosafi_sitepackage/Resources/Private/Language/form.xlf'\r\u001b[16C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Write \u001b[38;2;177;185;249mform.xlf\u001b[39m and \u001b[38;2;177;185;249msw.form.xlf\u001b[22m\u001b[39m,\u001b[38Gwith\u001b[43Gkeys\u001b[48Gbuilt\u001b[54Gfrom\u001b[59Gthe\u001b[63Gform's\u001b[70Gidentifier\u001b[81G\u001b[38;2;177;185;249mcontact\u001b[89G\u001b[39mand\u001b[93Geach\u001b[98Gelement's\u001b[108Gidentifier:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌────────────────────────────┬────────────────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│            What            │                                                  Key                                                   │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Field label                │ \u001b[38;2;177;185;249mcontact.element.name.properties.label\u001b[39m                                                                  │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Hint, placeholder          │ \u001b[38;2;177;185;249mcontact.element.message.properties.elementDescription\u001b[39m, \u001b[38;2;177;185;249mcontact.element.phone.properties.placeholder\u001b[39m    │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Select options             │ \u001b[38;2;177;185;249mcontact.element.topic.properties.options.revenue\u001b[39m, \u001b[38;2;177;185;249mcontact.element.topic.properties.prependOptionLabel\u001b[39m  │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Static text                │ \u001b[38;2;177;185;249mcontact.element.required-hint.properties.text\u001b[39m                                                          │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Submit button              │ \u001b[38;2;177;185;249mcontact."]
[2258.325935, "o", "element.contact.renderingOptions.submitButtonLabel\u001b[39m                                             │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Confirmation, mail subject │ \u001b[38;2;177;185;249mcontact.finisher.Confirmation.message\u001b[39m, \u001b[38;2;177;185;249mcontact.finisher.EmailToReceiver.subject\u001b[39m                        │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Error message              │ \u001b[38;2;177;185;249mcontact.validation.error.phone.1221565130\u001b[39m, or \u001b[38;2;177;185;249mvalidation.error.1221560910\u001b[39m for one shared by all fields │\r\u001b[2C\u001b[1B└────────────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GEnglish\u001b[15Gtext\u001b[20Gin\u001b[23Gthe\u001b[27Gform's\u001b[34GYAML\u001b[39Gstays\u001b[45Gas\u001b[48Gthe\u001b[52Gsource.\u001b[60GAny\u001b[64Gkey\u001b[68Gmissing\u001b[76Gfrom\u001b[81Gthe\u001b[85G\u001b[38;2;177;185;249msw\u001b[88G\u001b[39mfile\u001b[93Gfalls\u001b[99Gback\u001b[104Gto\u001b[107Gthat\u001b[112GEnglish\u001b[120Gtext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo things the YAML can't keep as they are:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mCustom error\u001b[18Gmessages:\u001b[22m the messages written\u001b[49Gdirectly\u001b[58Ginto\u001b[63Gthe\u001b[67GYAML\u001b[72G(the\u001b[77Gphone\u001b[83Gnumber\u001b[90Gand\u001b[94Gthe\u001b[98Gtwo\u001b[102G\"I'm\u001b[107Gnot\u001b[111Ga\u001b[113Grobot\"\u001b[120Gmessages)\u001b[130Gare\u001b[134Greturned\u001b[143Gas\u001b[146Gthey\u001b[151Gare\u001b[155Gand\r\u001b[2C\u001b[1B \u001b[5Gnever translated. They\u001b[28Ghave to move\u001b[41Ginto the XLF under \u001b[61Ghe k\u001b[66Gys above.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStandard error messages:\u001b[22m the default messag\u001b[49Gs (\"This field\u001b[64Gis mandatory\",\u001b[79G\"invalid\u001b[88Gemail\u001b[94Gaddress\")\u001b[104Gcome\u001b[109Gfrom\u001b[114GEXT:form's\u001b[125Gown\u001b[129Glabels.\u001b[137GTYPO3\u001b[143Ghas\u001b[147Gno\u001b[150GKiswahili\r\u001b[2C\u001b[1B \u001b[5Gfor them (it doesn't even know the language, whic\u001b[55G is why the\u001b[67Gsitepackage\u001b[79Gregisters \u001b[38;2;177;185;249msw\u001b[39m).\u001b[94GSo \u001b[38;2;177;185;249msw.form.xlf\u001b[109G\u001b[39mneeds them too,\u001b[125Gas \u001b[38;2;177;185;249mvalidation.error.<code>\u001b[39m for the\u001b[42;1H\u001b[40;3H\u001b[?25h"]
[2258.576404, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[36mstandard:\r\u001b[2C\u001b[1B\u001b[39m    \u001b[36mformElementsDefinition:\r\u001b[4C\u001b[1B\u001b[39m    \u001b[36mFo\u001b[12Gm\r\u001b[6C\u001b[1B\u001b[39m    \u001b[36mrend\u001b[16GringOptions:\u001b[39m\u001b[K\r\u001b[8C\u001b[1B    \u001b[36mtranslation:\r\u001b[10C\u001b[1B\u001b[39m    \u001b[36mt\u001b[17Ga\u001b[19Gsla\u001b[26GFiles:\r\u001b[12C\u001b[1B\u001b[39m    \u001b[36m20:\u001b[39m \u001b[31m'EXT:mtosafi_sitepackage/Resources/Private/Language/form.xlf'\r\u001b[14C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Write \u001b[38;2;177;185;249mform.xlf\u001b[39m and \u001b[38;2;177;185;249msw.form.xlf\u001b[22m\u001b[39m, with keys built from the form's identifier \u001b[38;2;177;185;249mcontact\u001b[89G\u001b[39mand\u001b[93Geach\u001b[98Gelement's\u001b[108Gidentifier:\r\u001b[2C\u001b[2B┌────────────────────────────┬────────────────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[16GWhat\u001b[32G│\u001b[83GKey\u001b[137G│\r\u001b[2C\u001b[1B├\u001b[32G┼\u001b[137G┤\r\u001b[4C\u001b[1BField\u001b[11Glabel    \u001b[34G\u001b[38;2;177;185;249mcontact.element.name.properties.label\u001b[83G\u001b[39m   \r\u001b[4C\u001b[2BH\u001b[7Gnt,\u001b[11Gplaceholder\u001b[50G\u001b[38;2;177;185;249mmessage.\u001b[59Groperties.\u001b[71GementDescription\u001b[39m,\u001b[89G\u001b[38;2;177;185;249mcontact.element.phone.properties.placeholder\r\u001b[4C\u001b[2B\u001b[39mSelect options   \u001b[50G\u001b[38;2;177;185;249mtopic.properties.options.revenue\u001b[39m, \u001b[38;2;177;185;249mc\u001b[87Gta\u001b[90Gt.element.topic.properties.pr\u001b[120GpendOpti\u001b[129GnLabel\r\u001b[5C\u001b[2B\u001b[39mtatic\u001b[12Gtext   \u001b[50G\u001b[38;2;177;185;249mrequired-hin\u001b[63G.propertie\u001b[75Gt\u001b[77Gxt\u001b[39m    \u001b[84G                                                   \r\u001b[5C\u001b[2Bubm\u001b[10Gt