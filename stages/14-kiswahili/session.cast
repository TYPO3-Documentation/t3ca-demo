0GKiswahili:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe widget ships a Kiswahili\u001b[32Gbundle\u001b[39G(\"sw\")\u001b[46Gand\u001b[50Greads\u001b[56Gthe\u001b[60Glanguage\u001b[69Gfrom\u001b[74G\u001b[38;2;177;185;249m<html lang>\u001b[39m.\u001b[87GChecking\u001b[96Gthat\u001b[101Git\u001b[104Gmaps\u001b[109Gour\u001b[113G\u001b[38;2;177;185;249msw-KE\u001b[119G\u001b[39mto\u001b[122G\u001b[38;2;177;185;249msw\u001b[39m:\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe widget maps \u001b[38;2;177;185;249msw-KE\u001b[25G\u001b[39mto\u001b[28Gits\u001b[32G\u001b[38;2;177;185;249msw\u001b[35G\u001b[39mbundle\u001b[42Gby\u001b[45Gitself,\u001b[53Gso\u001b[56GAltcha\u001b[63Gneeds\u001b[69Gno\u001b[72Gwork.\u001b[78GNext,\u001b[84Gchecking\u001b[93Ghow\u001b[97Gthe\u001b[101Gmail\u001b[106Gfinisher\u001b[115Gchooses\u001b[123Gits\u001b[127Glanguage,\u001b[137Gso\u001b[140Gthe\u001b[144Goffice\u001b[151Gmail\u001b[156Gcan\r\u001b[2C\u001b[1Bstay\u001b[8GEnglish:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mS\u001b[5Gtt\u001b[11G\u001b[38;2;177;185;249mtranslation.language: default\u001b[39m on EmailToReceiver\u001b[60Gkeeps\u001b[66Gthe\u001b[70Goffice\u001b[77Gmail\u001b[82GEnglish.\u001b[91GNow\u001b[95Gthe\u001b[99Gcontent\u001b[107Gof\u001b[110Gthe\u001b[114GContact\u001b[122Gpage,\u001b[128Gfor\u001b[132Gthe\u001b[136Gseed\u001b[141Gscript:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[39C\u001b[2B\u001b[38;2;153;153;153mthought for 2s)\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
