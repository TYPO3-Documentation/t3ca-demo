[313.943722, "o", "\u001b[H\r\u001b[22B\u001b[48;2;55;55;55m\u001b[38;2;177;185;249m❯\u001b[39m \u001b[38;2;153;153;153m1.\u001b[39m \u001b[38;2;177;185;249mKiswahili, /sw/ (Recommended)\u001b[39m                        \u001b[49m\u001b[31;1H\u001b[23;1H"]
[318.194484, "o", "\u001b[H\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwe still need the language menu\u001b[39m                                                                         \r\u001b[2C\u001b[2B\u001b[49m\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(typo3-sitepackage-development)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoaded skill\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe header already h\u001b[24Gs a languag\u001b[36G menu;\u001b[43Git\u001b[46Gshows\u001b[52Gnothing\u001b[60Gbecause\u001b[68Gthe\u001b[72Gsite\u001b[77Ghas\u001b[81Gonly\u001b[86Gone\u001b[90Glanguage.\u001b[100GI'm\r\u001b[1B  checking the rendered\u001b[25Gpage\u001b[30Gto\u001b[33Gconfirm\u001b[41Gthat.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m←\u001b[4G☒\u001b[6GLanguage\u001b[15G\u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Content \u001b[27G\u001b[39m\u001b[49m✔\u001b[29GSubmit\u001b[37G→\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[2m│\u001b[22m \u001b[38;2;255;255;255m\u001b[1mWhich pages should have a Kiswahili version? The menu links only to pages that have one.\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mTranslate pages via seed (Recommended)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mA new seed script in Build/Initialisation/ translates the page titles and the home page content into \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mKiswahili, then I export data.xml again. Every page gets a link in the menu.\u001b[39m\u001b[K\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153m2.\u001b[39m Fallback to English\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mNo translations are made. Untranslated pages show their English content under /sw/ (fallbackType: \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mfallback). Less work, but the Kiswahili site is English.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[39mOnly page titles\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;153;153;153mTranslates the page records only, so the menus and URLs are in Kiswahili and the content falls back \r\u001b[5C\u001b[1Bto Englis\u001b[16G.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m4\r\u001b[2C\u001b[2B\u001b[39m5\u001b[31;1H\u001b[18;1H"]
[318.853097, "o", "\u001b[H\r\u001b[20B\u001b[48;2;55;55;55m  \u001b[38;2;153;153;153m2.\u001b[39m Fallback to English                                                                                  \u001b[49m\u001b[31;1H\u001b[18;1H"]
