[2737.312877, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1BSelect options\u001b[50G\u001b[38;2;177;185;249mtopic.properties.options.revenue\u001b[39m,\u001b[84G\u001b[38;2;177;185;249mcontact.element.topic.properties.prependOptionLabel\r\u001b[4C\u001b[2B\u001b[39mSta\u001b[9Gic text      \u001b[50G\u001b[38;2;177;185;249mr\u001b[52Gquir\u001b[57Gd-hint.properties.\u001b[76Gext\u001b[39m         \u001b[89G                                            \r\u001b[5C\u001b[2Bubmi\u001b[12Gbu\u001b[15Gt\u001b[18G \u001b[50G\u001b[38;2;177;185;249mc\u001b[52Gntact.renderingO\u001b[75GsubmitButt\u001b[87GL\u001b[89Gbel\u001b[39m                                           \r\u001b[4C\u001b[2BConf\u001b[10Grmation,\u001b[19Gmail\u001b[24Gsubject\u001b[42G\u001b[38;2;177;185;249mfinisher.Confirmat\u001b[61Gon\u001b[64Gmessage\u001b[39m, \u001b[38;2;177;185;249mcontact.finisher.EmailToReceiver.subject\r\u001b[4C\u001b[2B\u001b[39mError message\u001b[42G\u001b[38;2;177;185;249mvalida\u001b[49Gion.error.phone.1221565130\u001b[39m, or \u001b[38;2;177;185;249mvalidation.error.1221560910\u001b[108G\u001b[39mfor\u001b[112Gone\u001b[116Gshared\u001b[123Gby\u001b[126Gall\u001b[130Gfields\r\u001b[2C\u001b[1B└\u001b[32G┴\u001b[137G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe English text in the form's YAML stays as the source. Any key missing from the \u001b[38;2;177;185;249msw\u001b[39m file falls back to that English text.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo things the YAML can't keep as they are:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCustom error messages:\u001b[28G\u001b[22mthe\u001b[32Gmessages\u001b[41Gwritten\u001b[49Gdirectly\u001b[58Ginto\u001b[63Gthe\u001b[67GYAML\u001b[72G(the\u001b[77Gphone\u001b[83Gnumber\u001b[90Gand\u001b[94Gthe\u001b[98Gtwo\u001b[102G\"I'm\u001b[107Gnot\u001b[111Ga\u001b[113Grobot\"\u001b[120Gmessages)\u001b[130Gare\u001b[134Greturned\u001b[143Gas\u001b[146Gthey\u001b[151Gare\u001b[155Gand\r\u001b[2C\u001b[1B  never transla\u001b[19Ged.\u001b[23GT\u001b[26Gy have to move into the XLF \u001b[55Gnd\u001b[58Gr\u001b[60Gthe\u001b[67Gs above.\u001b[76G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStandard error messages:\u001b[30G\u001b[22mthe\u001b[34Gdefault\u001b[42Gmessages\u001b[51G(\"This\u001b[58Gfield\u001b[64Gis\u001b[67Gmandatory\",\u001b[79G\"invalid\u001b[88Gemail\u001b[94Gaddress\")\u001b[104Gcome\u001b[109Gfrom\u001b[114GEXT:form's\u001b[125Gown\u001b[129Glabels.\u001b[137GTYPO3\u001b[143Ghas\u001b[147Gno\u001b[150GKiswahili\r\u001b[2C\u001b[1B  for them (it doesn't even know the language,\u001b[50Gwhich\u001b[56Gis\u001b[59Gwhy\u001b[63Gthe\u001b[67Gsitepackage\u001b[79Gregisters\u001b[89G\u001b[38;2;177;185;249msw\u001b[39m).\u001b[94GSo\u001b[97G\u001b[38;2;177;185;249msw.form.xlf\u001b[109G\u001b[39mneeds\u001b[115Gthem\u001b[120Gtoo,\u001b[125Gas\u001b[128G\u001b[38;2;177;185;249mvalidation.error.<code>\u001b[152G\u001b[39mfor\u001b[156Gthe\r\u001b[2C\u001b[1B \u001b[5Gvalidators the form uses: NotEmpty,\u001b[41GStringLength, Ema\u001b[59GlAddress, RegularExpression.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOutside the form:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gheader \"Write to\u001b[26Gus\" and the sidebar t\u001b[48Gxts are\u001b[56Gordinary content elem\u001b[78Gnts. Th\u001b[86Gy stay English until the Contact page gets Kiswahili content, which the\u001b[K\r\u001b[4C\u001b[1Bseed script could do like\u001b[31Git does for the home page.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gmail\u001b[14Gto\u001b[17Gthe\u001b[21Gmunicipality\u001b[34Gwould\u001b[40Gshow\u001b[45Gits\u001b[49Gfield\u001b[55Glabels\u001b[62Gin\u001b[65GKiswahili\u001b[75Gwhen\u001b[80Gsomeone\u001b[88Gwrites\u001b[95Gfrom\u001b[100G\u001b[38;2;177;185;249m/sw/\u001b[39m,\u001b[106Gbecause\u001b[114Gthe\u001b[118Gmail\u001b[123Gtemplate\u001b[132Gtranslates\u001b[143Gthem\u001b[148Gtoo.\u001b[153GIf\u001b[156Gthe\r\u001b[2C\u001b[1B  office should always\u001b[26Gget\u001b[30GEnglish\u001b[38Gmails,\u001b[45Gthe\u001b[49Gtemplate\u001b[58Gcan\u001b[62Gbe\u001b[65Gpinned\u001b[72Gto\u001b[75GEnglish.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShoul\u001b[10GI build it: the\u001b[26Gtranslati\u001b[36Gn file\u001b[43Gfor\u001b[47Gthe whol\u001b[56G form,\u001b[63Gthe\u001b[67Gerror\u001b[73Gmessages\u001b[82Gmoved\u001b[88Gout\u001b[92Gof\u001b[95Gthe\u001b[99GYAML,\u001b[105Gand\u001b[109Gthe\u001b[113GContact\u001b[121Gpage\u001b[126Gcontent\u001b[134Gadded\u001b[140Gto\u001b[143Gthe\u001b[147Gseed\u001b[152Gscript?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 24s · done 7:02 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe site now has a Kiswahili version with a working language menu and search, all still uncommitted. I explained how to translate the contact form, \u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m\u001b[3mand next I'm waiting for your go to build that translation. (turn off recaps in /config)\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mgo\u001b[39m                                                                                                                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m*\u001b[3GCogitating… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
