[2242.193794, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m42\u001b[12G\u001b[38;2;248;248;242mEnglish only\u001b[25Gand are\u001b[33Gnot found \u001b[44Grom the Kiswahili search.  \u001b[72G    \u001b[77G     \u001b[83G    \u001b[88G  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[12G\u001b[38;2;248;248;242m        \u001b[21G                                                           \u001b[81G     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 144 \u001b[22m ## Editors\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 145 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 146 \u001b[22m The setup creates the backend user group \"Editors\", after the import, on every\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSearching for \"ardhi\" now works. \u001b[38;2;177;185;249m/sw/tafuta?q=ardhi\u001b[39m re\u001b[58Gu\u001b[60Gns \"Kodi ya ardhi\", and the \u001b[89Gesult\u001b[95Glinks\u001b[101Gto\u001b[104G\u001b[38;2;177;185;249m/sw/mapato-malipo/kodi-ya-ardhi\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it found nothing:\u001b[25G\u001b[22mthe\u001b[29Gsearch\u001b[36Gextension\u001b[46G(ke_search)\u001b[58Gonly\u001b[63Gindexes\u001b[71Ga\u001b[73Gpage\u001b[78Gtranslation\u001b[90Gthat\u001b[95Ghas\u001b[99Gcontent\u001b[107Gelements\u001b[116Gin\u001b[119Gits\u001b[123Gown\u001b[127Glanguage.\u001b[137GThe\u001b[141GKiswahili\u001b[151Gpages\r\u001b[1B \u001b[3Ghave no\u001b[11Ge\u001b[13Gof their own; they show the English content instead. So\u001b[69Geven t\u001b[76Geir\u001b[80GKiswa\u001b[86Gili titles \u001b[98Gever reached the index.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mT\u001b[5Ge\u001b[7Gfix:\u001b[22m a new hook class, \u001b[38;2;177;185;249mClasses/Search/IndexFallbackContentOfPageTranslations.php\u001b[39m, is registered i\u001b[105G \u001b[38;2;177;185;249mext_localconf.php\u001b[39m. When a site\u001b[137Glanguage fa\u001b[149Gls back\u001b[157Gto\r\u001b[2C\u001b[1BEnglish and a page\u001b[22Gtranslation has no\u001b[41Gcontent\u001b[49Gof its ow\u001b[59G, the ho\u001b[68Gk gives that translation the\u001b[97GEnglish conten\u001b[112G. ke_s\u001b[119Garch\u001b[124Gthen\u001b[129Gstores\u001b[136Git\u001b[139Gunder\u001b[145Gthe\u001b[149GKiswahili\r\u001b[2C\u001b[1Btitle.\u001b[10G\u001b[38;2;177;185;249mServices.yaml\u001b[24G\u001b[39mmarks\u001b[30Gthe\u001b[34Gclass\u001b[40Gpublic,\u001b[48Gwhich\u001b[54Gke_search\u001b[64Gneeds\u001b[70Gto\u001b[73Gcreate\u001b[80Gthe\u001b[84Ghook\u001b[89Gwith\u001b[94Gits\u001b[98Gdependency.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[22m afte\u001b[24G re-indexing,\u001b[38Gthe i\u001b[44Gd\u001b[46Gx h\u001b[50Glds 16 Kiswa\u001b[63Gili pages nex\u001b[77G to\u001b[82Ghe 16 Englis\u001b[95G ones. In\u001b[105GKiswahili, \"ardhi\"\u001b[124Ggives 1 \u001b[135Gul\u001b[139Ga\u001b[142G \"land\" gives 4,\r\u001b[2C\u001b[1Bbecause the English content is\u001b[34Gindexed with them. Th\u001b[56G English s\u001b[67Garch still gives\u001b[84Gthe same 6 results for \"land\".\r\u001b[2C\u001b[2B\u001b[1mOne gap r\u001b[13Gmains:\u001b[22m th\u001b[23G news ar\u001b[32G \u001b[35Gdexed in English only, so t\u001b[63Gey don't show up in the Kiswahili s\u001b[99Garch.\u001b[105GThe README\u001b[116Gnow says thi\u001b[129G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted\u001b[24Gyet.\u001b[29GThe\u001b[33Gnew\u001b[37Gfiles\u001b[43Gare\u001b[47Gthe\u001b[51Ghook\u001b[56Gclass,\u001b[63G\u001b[38;2;177;185;249mseed-kiswahili.php\u001b[82G\u001b[39mand\u001b[86Gthe\u001b[90Gtwo\u001b[94G\u001b[38;2;177;185;249msw.*.xlf\u001b[103G\u001b[39mfiles;\u001b[110Gthe\u001b[114GREADME\u001b[121Gsection\u001b[129G\"Languages\"\u001b[141Gcovers\u001b[148Gthe\u001b[152Gsearch\r\u001b[2C\u001b[1Bbehaviour. Tell me if you\u001b[29Gwant me to prepare a \"Stage 14-languages\" commit.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 1m 6s · done 6:51 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mWe added Kiswahili as a second language so the header's language menu works, and the Kiswahili search now finds pages such as \"ardhi\". Nothing is \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mcommitted yet; say go if you want a \"Stage 14-languages\" commit. (turn off recaps in /config)\r\u001b[2B\u001b[23m\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mHow to translate the contact form?\u001b[39m                                                                                                                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage && cat Configuration/Form/Sitepackage/config.yaml; cat \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mResources/Private/Forms/contact.form.yaml; grep -n \"translate\\|f:\" Resources/Private/Extensions/Form/Templates/Form.fluid.html \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mResources/Private/Extensions/Form/Tem…\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
