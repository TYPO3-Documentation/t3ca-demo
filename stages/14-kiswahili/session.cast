[1518.177441, "o", "\u001b[?25l\u001b[H\u001b[3G  page has no\u001b[17Gtr\u001b[20Gnslated\u001b[28Gcontent,\u001b[37Git\u001b[40Gshows\u001b[46Gthe\u001b[50GEnglish\u001b[58Gcontent.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRegister \u001b[38;2;177;185;249msw\u001b[39m with TYPO3:\u001b[29G\u001b[22mTYPO3\u001b[35G14\u001b[38Gdoesn't\u001b[46Gknow\u001b[51GKiswahili\u001b[61Gas\u001b[64Ga\u001b[66Glabel\u001b[72Glanguage,\u001b[82Gso\u001b[85Gwithout\u001b[93Gthis\u001b[98Gall\u001b[102Glabels\u001b[109Gstay\u001b[114GEnglish.\u001b[123G\u001b[38;2;177;185;249mext_localconf.php\u001b[141G\u001b[39mnow\u001b[145Gregisters\u001b[155G\u001b[38;2;177;185;249msw\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mLab\u001b[9Gls:\u001b[22m \u001b[38;2;177;185;249msw.frontend.xlf\u001b[39m and \u001b[38;2;177;185;249msw.news.xlf\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed script:\u001b[22m \u001b[38;2;177;185;249mBuild/Initialisation/seed-kiswahili.php\u001b[58G\u001b[39mtranslates\u001b[69Gthe\u001b[73G29\u001b[76Gpages\u001b[82Gand\u001b[86Gshortcuts\u001b[96G(Kiswahili\u001b[107Gtitles\u001b[114Gand\u001b[118GURLs)\u001b[124Gand\u001b[128Gthe\u001b[132Ghome\u001b[137Gpage:\u001b[143Gheaders,\u001b[152Gslides\r\u001b[2C\u001b[1B \u001b[5Gand service tiles. TYPO3 creates\u001b[38Gth\u001b[42Ge \u001b[45Gra\u001b[48Gslat\u001b[53Gons hidden, so the\u001b[72Gscript makes\u001b[85Gthem visible.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mExport\u001b[13G\u001b[22m\u001b[38;2;177;185;249mdata.xml\u001b[39m is exported again, and the\u001b[49GREADME\u001b[56Ghas\u001b[60Gthe\u001b[64Gnew\u001b[68Gseed\u001b[73Gstep\u001b[78Gand\u001b[82Ga\u001b[84G\"Languages\"\u001b[96Gsection.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill English on the Kiswahili pages:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BThe content of pages other th\u001b[35Gn the\u001b[41Ghome page, plus the n\u001b[63Gws and \u001b[71Gven\u001b[75Gs.\u001b[78G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gtop-bar\u001b[17Gnotice,\u001b[25Gthe\u001b[29Gopening\u001b[37Ghours\u001b[43Gand\u001b[47Gthe\u001b[51Gfooter\u001b[58Gnote.\u001b[64GThese\u001b[70Gare\u001b[74Gsite\u001b[79Gsettings,\u001b[89Gwhich\u001b[95Ghold\u001b[100Gone\u001b[104Gvalue\u001b[110Gfor\u001b[114Gall\u001b[118Glanguages.\r\u001b[2C\u001b[1B- The search filter \"Show only\".\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe Kiswahili search finds nothing.\u001b[41G\u001b[22mThe se\u001b[48Grch\u001b[52Gextension (ke_search) only\u001b[79Gindexes\u001b[87Ga\u001b[89Gpage\u001b[94Gtranslation\u001b[106Gthat\u001b[111Ghas\u001b[115Gcontent\u001b[123Gof\u001b[126Gits\u001b[130Gown,\u001b[135Gso\u001b[138Gthe\u001b[142Gindex\u001b[148Ghas\u001b[152Gno\r\u001b[2C\u001b[1B \u001b[5GKiswahili pages. It\u001b[25Gwill start working once those pages get Ki\u001b[68Gwahili conten\u001b[82G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gnative speaker should check the Kiswa\u001b[43Gili wording; I wrote it myself.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BYour\u001b[8Glocal\u001b[14Gdatabase\u001b[23Gnow\u001b[27Ghas\u001b[31Gthe\u001b[35Gtranslations.\u001b[49GA\u001b[51Gsnapshot\u001b[60Gfrom\u001b[65Gbefore\u001b[72Gthem\u001b[77Gexists:\u001b[85G\u001b[38;2;177;185;249mddev snapshot restore before-kiswahili\u001b[39m.\u001b[125GNothing\u001b[133Gis\u001b[136Gcommitted.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mseed-kiswahili.php\u001b[39m and the two \u001b[38;2;177;185;249msw.*.xlf\u001b[39m files are new and untracked. Tell\u001b[77Gme\u001b[80Gif\u001b[83Gyou\u001b[87Gwant\u001b[92Ga\u001b[94G\"Stage\u001b[101G14-languages\"\u001b[115Gcommit.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 4m 57s · done 6:35 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe goal was a working language menu, and it now works: the site has Kiswahili at /sw/, with translated pages, home page and labels. Nothing is \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mcommitted yet, so the next step is your go for a \"Stage 14-languages\" commit. (turn off recaps in /config)\r\u001b[2B\u001b[23m\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255msearching for ardhi there is no result\u001b[39m                                                                                                                       \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLet\u001b[7Gme\u001b[10Gfind\u001b[15Gout\u001b[19Gwhy\u001b[23Gthe\u001b[27Gindexer\u001b[35Gskips\u001b[41Gthe\u001b[45GKiswahili\u001b[55Gpages.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gindexer\u001b[15Gskips\u001b[21GKiswahili\u001b[31Gpages\u001b[37Gbecause\u001b[45Gthey\u001b[50Ghave\u001b[55Gno\u001b[58Gcontent\u001b[66Gelements\u001b[75Gof\u001b[78Gtheir\u001b[84Gown,\u001b[89Gso\u001b[92Gtheir\u001b[98Gtitles\u001b[105Gnever\u001b[111Greach\u001b[117Gthe\u001b[121Gindex.\u001b[128GI'm\u001b[132Glooking\u001b[140Gat\u001b[143Gwhich\u001b[149Gke_search\r\u001b[1B \u001b[3Gextension points\u001b[22Guld fix that.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[33C\u001b[2B\u001b[38;2;153;153;153mthought for 7s)\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
