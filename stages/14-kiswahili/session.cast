[2247.336395, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 145 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22mThe se\u001b[19Gup creates\u001b[30Gthe\u001b[34Gbackend\u001b[42Guser\u001b[47Ggroup\u001b[53G\"Editors\",\u001b[64Gafter\u001b[70Gthe\u001b[74Gimport,\u001b[82Gon\u001b[85Gevery\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Searching for \"ardhi\" now\u001b[29Gworks.\u001b[36G\u001b[38;2;177;185;249m/sw/tafuta?q=ardhi\u001b[55G\u001b[39mreturns\u001b[63G\"Kodi\u001b[69Gya\u001b[72Gardhi\",\u001b[80Gand\u001b[84Gthe\u001b[88Gresult\u001b[95Glinks\u001b[101Gto\u001b[104G\u001b[38;2;177;185;249m/sw/mapato-malipo/kodi-ya-ardhi\u001b[39m.\r\u001b[2B \u001b[3G\u001b[1mWhy it found nothing:\u001b[25G\u001b[22mthe\u001b[29Gsearch\u001b[36Gextension (ke_search) only\u001b[63Gindexes a page tr\u001b[82Gslation tha\u001b[95Ghas content elements in its own language\u001b[137GThe\u001b[141GKiswahili\u001b[151Gpages\r\u001b[2C\u001b[1Bhave\u001b[8Gnone\u001b[13Gof\u001b[16Gtheir\u001b[22Gown;\u001b[27Gthey\u001b[32Gshow\u001b[37Gthe\u001b[41GEnglish\u001b[49Gcontent\u001b[57Ginstead.\u001b[66GSo\u001b[69Geven\u001b[74Gtheir\u001b[80GKiswahili\u001b[90Gtitles\u001b[97Gnever\u001b[103Greached\u001b[111Gthe\u001b[115Gindex.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[22m a new hook class, \u001b[38;2;177;185;249mClasses/Search/IndexFallbackContentOfPageTranslations.php\u001b[39m, is regist\u001b[99Gr\u001b[101Gd\u001b[103Gin \u001b[38;2;177;185;249mext_localconf.php\u001b[39m.\u001b[125GWhen\u001b[130Ga\u001b[132Gsite\u001b[137Glanguage\u001b[146Gfalls\u001b[152Gback\u001b[157Gto\r\u001b[2C\u001b[1BEnglish\u001b[11Gand\u001b[15Ga\u001b[17Gpage\u001b[22Gtranslation\u001b[34Ghas\u001b[38Gno\u001b[41Gcontent\u001b[49Gof\u001b[52Gits\u001b[56Gown,\u001b[61Gthe\u001b[65Ghook\u001b[70Ggives\u001b[76Gthat\u001b[81Gtranslation\u001b[93Gthe\u001b[97GEnglish\u001b[105Gcontent.\u001b[114Gke_search\u001b[124Gthen\u001b[129Gstores\u001b[136Git\u001b[139Gunder\u001b[145Gthe\u001b[149GKiswahili\r\u001b[2C\u001b[1Btitle. \u001b[38;2;177;185;249mServices.yaml\u001b[39m m\u001b[26Grks\u001b[30Gthe class public, which ke_search needs to create the hook\u001b[89Gwith it\u001b[97G dependency.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[22m after re-indexing, the index\u001b[48Gholds\u001b[54G16 Kiswa\u001b[63Gili pages\u001b[73Gnext to the 16 English ones. In Kiswahili,\u001b[116G\"ardhi\"\u001b[124Ggives\u001b[130G1\u001b[132Gresult\u001b[139Gand\u001b[143G\"land\"\u001b[150Ggives\u001b[156G4,\r\u001b[2C\u001b[1Bbecause\u001b[11Gthe\u001b[15GEnglish\u001b[23Gcontent\u001b[31Gis\u001b[34Gindexed\u001b[42Gwith\u001b[47Gthem.\u001b[53GThe\u001b[57GEnglish\u001b[65Gsearch\u001b[72Gstill\u001b[78Ggives\u001b[84Gthe\u001b[88Gsame\u001b[93G6\u001b[95Gresults\u001b[103Gfor\u001b[107G\"land\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne gap remains:\u001b[22m t\u001b[22Ge news are indexed in English only, so they don't\u001b[73Ghow up in the Kiswahili \u001b[98Gearch. The README\u001b[116Gnow\u001b[120Gsays\u001b[125Gthis.\r\u001b[2C\u001b[2BNothing is commit\u001b[21Ged\u001b[24Gy\u001b[26Gt.\u001b[29GTh\u001b[33Gnew files are the h\u001b[53Gok class, \u001b[38;2;177;185;249mseed-kiswahili.php\u001b[39m and the two \u001b[38;2;177;185;249msw.*.xlf\u001b[39m files; the README section \"Languages\"\u001b[141Gcovers\u001b[148Gthe\u001b[152Gsearch\r\u001b[2C\u001b[1Bbehaviour.\u001b[14GTell\u001b[19Gme\u001b[22Gif\u001b[25Gyou\u001b[29Gwant\u001b[34Gme\u001b[37Gto\u001b[40Gprepare\u001b[48Ga\u001b[50G\"Stage\u001b[57G14-languages\"\u001b[71Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 1m 6s · done 6:51 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mWe added Kiswahili as a second language so the header's language menu works, and the Kiswahili search now finds pages such as \"ardhi\". Nothing is \r\u001b[2C\u001b[1Bcommitted yet; say go if you want a \"Stage 14-languages\" commit. (turn off recaps in /config)\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow to translate the contact form?\u001b[39m                                                                                                                           \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBefore answering, I'm\u001b[25Gchecking\u001b[34Gthe\u001b[38Gkey\u001b[42Gformat\u001b[49GTYPO3\u001b[55G14's\u001b[60Gform\u001b[65Gframework\u001b[75Guses\u001b[80Gto\u001b[83Glook\u001b[88Gup\u001b[91Gtranslations:\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo && T=vendor/typo3/cms-form/Classes/Service/TranslationService.php; grep -n \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m\"sprintf\\|translationKeyChain\\[\\] =\\|'%s\\.\\|function translate\\|translationFiles\\|translationFile'\" $T | head -60\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
