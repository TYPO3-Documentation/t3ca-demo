[3096.517241, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[34B\u001b[38;2;177;185;249m❯ /typo3-distribution-content                 Ship the content of a TYPO3 site inside an extension, as a distribution — the initial content a package\r\u001b[48C\u001b[1Bcarries, the export artifact and the files beside it, and the site configuration that travels with them. Use…\r\u001b[1B\u001b[39m \u001b[3G\u001b[38;2;153;153;153m  /typo3-docs:typo3-docs-style-check          (TYPO3 Docs) Check TYPO3 documentation (.rst files) against the current rules of the TYPO3 \"How to document\"\r\u001b[48C\u001b[1Bguide and report each violation with the rule and a fix. Use after writing or editing TYPO3 .rst files and b…\r\u001b[2C\u001b[2B\u001b[39m/\u001b[42;1H\u001b[40;4H\u001b[?25h"]
[3096.969624, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[32B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m❯ /\u001b[1me\u001b[22mxit                                       \u001b[1mE\u001b[22mxit the CLI\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mffort                                     S\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mt the model's effort level\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mxport                                     \u001b[39m\u001b[1mE\u001b[22m\u001b[38;2;153;153;153mxport this session to a file or clipboard\u001b[39m\u001b[K\r\u001b[12C\u001b[1B\u001b[38;2;153;153;153mistribution-\u001b[26Gont\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mnt       \u001b[49GShip th\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153m \u001b[59Gontent of a TYPO3 site inside an extension, \u001b[104Gs a distribution\u001b[121G— the\u001b[127Gini\u001b[131Gial content a\u001b[145Gpackage\u001b[39m\u001b[K\r\u001b[48C\u001b[1B\u001b[38;2;153;153;153mcarri\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153ms, th\u001b[61G export art\u001b[73Gfac\u001b[77G a\u001b[80Gd the\u001b[86Gfiles b\u001b[94Gside\u001b[99Git, and the site\u001b[116Gconf\u001b[121Gguration \u001b[131Ghat\u001b[135Gtravels with them. Use\r\u001b[3C\u001b[2B\u001b[39me\u001b[42;1H\u001b[40;5H\u001b[?25h"]
[3097.249917, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[33B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m❯ /\u001b[1mex\u001b[22mit                                       \u001b[1mEx\u001b[22mit the CLI\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[1mx\u001b[50Gx\r\u001b[11C\u001b[1Bex\u001b[22m\u001b[38;2;153;153;153mtension-documenta\u001b[32Gion\u001b[49GCreate, upda\u001b[63G or review documentation for\u001b[92Ga TYPO3 project\u001b[108Gor \u001b[39m\u001b[1mex\u001b[22m\u001b[38;2;153;153;153mtens\u001b[120G: Docume\u001b[129Gtation/ manuals, README,\r\u001b[49C\u001b[1Bonf\u001b[54Ggura\u001b[59Gion and integration guides, \u001b[39m\u001b[1mex\u001b[22m\u001b[38;2;153;153;153mampl\u001b[95G, migration\u001b[107Gnote\u001b[112G, screenshots and\u001b[130Guser-facing XLF labels\u001b[154G(pr\r\u001b[4C\u001b[2B\u001b[39mx\u001b[42;1H\u001b[40;6H\u001b[?25h"]
[3097.262846, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[32B-\u001b[5G\u001b[1mREADME:\u001b[13G\u001b[22ma\u001b[15Gnew\u001b[19Gsection,\u001b[28G\"The\u001b[33Gform\u001b[38Gin\u001b[41GKiswahili\",\u001b[53Gexplains\u001b[62Gthe\u001b[66Gkey\u001b[70Gformat.\u001b[78GAny\u001b[82Gnew\u001b[86Gfield\u001b[92Gneeds\u001b[98Gits\u001b[102Gkey\u001b[106Gadded\u001b[112Gin\u001b[115Gboth\u001b[120GXLF\u001b[124Gfiles.\u001b[42;1H\u001b[40;6H\u001b[?25h"]
[3097.377894, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[34B\u001b[38;2;177;185;249m\u001b[1mi\u001b[51Gi\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;153;153;153mty\u001b[10G3-development-installation\u001b[49GBring the local devel\u001b[71Gpment instal\u001b[84Gati\u001b[88Gn of a TYPO3 extension, sitepackage or project package into \u001b[39m\u001b[1mexi\u001b[22m\u001b[38;2;153;153;153mstence,\r\u001b[2C\u001b[1B\u001b[39m                                              \u001b[38;2;153;153;153mo\u001b[51G boot\u001b[57Gan\u001b[60G r\u001b[63Gpair the one the repository declares: the \u001b[106Gontainer, DDEV where it declares one, the unattende…\r\u001b[2C\u001b[1B  /verify                                     Try yo\u001b[57G cha\u001b[62Gge and r\u001b[71Gpor\u001b[75G if\u001b[79Git works\u001b[39m\u001b[K\r\u001b[5C\u001b[2Bi\u001b[42;1H\u001b[40;7H\u001b[?25h"]
[3097.505875, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[34B\u001b[38;2;177;185;249m\u001b[1mt\u001b[52Gt\r\u001b[11C\u001b[1B\u001b[39mex\u001b[22m\u001b[38;2;153;153;153mt\u001b[16Gns\u001b[39m\u001b[1mi\u001b[22m\u001b[38;2;153;153;153mon-documen\u001b[39m\u001b[1mt\u001b[22m\u001b[38;2;153;153;153mation \u001b[49GC\u001b[51Geate, update or r\u001b[69Gview documentation for a TYPO3 proj\u001b[105Gct \u001b[109Gr extension: Documentation/ manuals, README,\u001b[39m\u001b[K\r\u001b[48C\u001b[1B\u001b[38;2;153;153;153mconfigur\u001b[58Gtion and int\u001b[71Ggration guide\u001b[85G, examples, migration \u001b[108Gotes, screenshots and\u001b[130Guser-facing XLF labels. (pr\r\u001b[5C\u001b[1Bcontext\u001b[49GShow what fills\u001b[65Gthe\u001b[69Gcontext\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;177;185;249m/exit\u001b[39m\u001b[42;1H\u001b[40;8H\u001b[?25h"]
