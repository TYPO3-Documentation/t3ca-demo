[2757.477138, "o", "\u001b[?25l\u001b[H\u001b[3G├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Error message              │ \u001b[38;2;177;185;249mcontact.validation.error.phone.1221565130\u001b[39m, or \u001b[38;2;177;185;249mvalidation.error.1221560910\u001b[39m for one shared by all fields │\r\u001b[2C\u001b[1B└────────────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GEnglish\u001b[15Gtext\u001b[20Gin\u001b[23Gthe\u001b[27Gform's\u001b[34GYAML\u001b[39Gstays\u001b[45Gas\u001b[48Gthe\u001b[52Gsource.\u001b[60GAny\u001b[64Gkey\u001b[68Gmissing\u001b[76Gfrom\u001b[81Gthe\u001b[85G\u001b[38;2;177;185;249msw\u001b[88G\u001b[39mfile\u001b[93Gfalls\u001b[99Gback\u001b[104Gto\u001b[107Gthat\u001b[112GEnglish\u001b[120Gtext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo things the YAML can't keep as they are:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mCustom error\u001b[18Gmessages:\u001b[22m the messages written\u001b[49Gdirectly\u001b[58Ginto\u001b[63Gthe\u001b[67GYAML\u001b[72G(the\u001b[77Gphone\u001b[83Gnumber\u001b[90Gand\u001b[94Gthe\u001b[98Gtwo\u001b[102G\"I'm\u001b[107Gnot\u001b[111Ga\u001b[113Grobot\"\u001b[120Gmessages)\u001b[130Gare\u001b[134Greturned\u001b[143Gas\u001b[146Gthey\u001b[151Gare\u001b[155Gand\r\u001b[2C\u001b[1B \u001b[5Gnever translated. They\u001b[28Ghave to move\u001b[41Ginto the XLF under \u001b[61Ghe k\u001b[66Gys above.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStandard error messages:\u001b[22m the default messag\u001b[49Gs (\"This field\u001b[64Gis mandatory\",\u001b[79G\"invalid\u001b[88Gemail\u001b[94Gaddress\")\u001b[104Gcome\u001b[109Gfrom\u001b[114GEXT:form's\u001b[125Gown\u001b[129Glabels.\u001b[137GTYPO3\u001b[143Ghas\u001b[147Gno\u001b[150GKiswahili\r\u001b[2C\u001b[1B \u001b[5Gfor them (it doesn't even know the language, whic\u001b[55G is why the\u001b[67Gsitepackage\u001b[79Gregisters \u001b[38;2;177;185;249msw\u001b[39m).\u001b[94GSo \u001b[38;2;177;185;249msw.form.xlf\u001b[109G\u001b[39mneeds them too,\u001b[125Gas \u001b[38;2;177;185;249mvalidation.error.<code>\u001b[39m for the\r\u001b[4C\u001b[1Bvalidators \u001b[17Ghe form uses:\u001b[31GNotEmpty, Strin\u001b[47GLength, EmailAddress, R\u001b[71GgularExp\u001b[81Gssion.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOutside the form:\r\u001b[2C\u001b[1B\u001b[22m- The header \"Write\u001b[23Gto\u001b[26Gus\"\u001b[30Gand\u001b[34Gthe\u001b[38Gsidebar\u001b[46Gtexts\u001b[52Gare\u001b[56Gordinary\u001b[65Gcontent\u001b[73Gelements.\u001b[83GThey\u001b[88Gstay\u001b[93GEnglish\u001b[101Guntil\u001b[107Gthe\u001b[111GContact\u001b[119Gpage\u001b[124Ggets\u001b[129GKiswahili\u001b[139Gcontent,\u001b[148Gwhich\u001b[154Gthe\r\u001b[2C\u001b[1B \u001b[5Gse\u001b[8Gd script could\u001b[23Gd\u001b[26Glike it\u001b[34Gdo\u001b[37Gs for the home\u001b[52Gpage.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GTh\u001b[8G mail to\u001b[17Gthe municipality\u001b[34Gw\u001b[36Guld show its field labels\u001b[62Gin\u001b[65GKiswahili\u001b[75Gwhen\u001b[80Gsomeone\u001b[88Gwrites\u001b[95Gfrom\u001b[100G\u001b[38;2;177;185;249m/sw/\u001b[39m,\u001b[106Gbecause\u001b[114Gthe\u001b[118Gmail\u001b[123Gtemplate\u001b[132Gtranslates\u001b[143Gthem\u001b[148Gtoo.\u001b[153GIf\u001b[156Gthe\r\u001b[2C\u001b[1B \u001b[5Goffice should always get English mails,\u001b[45Gthe\u001b[49Gtemplate can\u001b[62Gbe\u001b[65Gp\u001b[67Gnned to\u001b[75GEngli\u001b[81Gh.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gbuild\u001b[18Git:\u001b[22Gthe\u001b[26Gtranslation\u001b[38Gfile\u001b[43Gfor\u001b[47Gthe\u001b[51Gwhole\u001b[57Gform,\u001b[63Gthe\u001b[67Gerror\u001b[73Gmessages\u001b[82Gmoved\u001b[88Gout\u001b[92Gof\u001b[95Gthe\u001b[99GYAML,\u001b[105Gand\u001b[109Gthe\u001b[113GContact\u001b[121Gpage\u001b[126Gcontent\u001b[134Gadded\u001b[140Gto\u001b[143Gthe\u001b[147Gseed\u001b[152Gscript?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 24s · done 7:02 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe site now has a Kiswahili version with a working language menu and search, all still uncommitted. I explained how to translate the contact form, \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mand next I'm waiting for your go to\u001b[39Gbuild that tr\u001b[53Gnslat\u001b[59Gon. (turn off rec\u001b[77Gps\u001b[80Gin /\u001b[85Gonfig)\u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mgo\u001b[39m                                                                                                 "]
[2757.477171, "o", "                                                          \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBuilding\u001b[12Git.\u001b[16GFirst\u001b[22Gthe\u001b[26Gerror\u001b[32Gcodes\u001b[38Gand\u001b[42Gthe\u001b[46Gtexts\u001b[52GEXT:form\u001b[61Guses\u001b[66Gby\u001b[69Gdefault:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Our file at key 20 is read before the core's (10). Now checking where the Altcha widget gets its own texts (\"I'm not a robot\"):\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\u001b[42;1H\u001b[40;3H\u001b[?25h"]
