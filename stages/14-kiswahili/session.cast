[2941.635307, "o", "\u001b[?25l\u001b[H\r\u001b[35B\u001b[38;2;215;119;87m✽\u001b[42G\u001b[38;2;168;168;168mthinking\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
