[1508.331713, "o", "\u001b[?25l\u001b[H\u001b[3Gnothing.\u001b[12GWhat\u001b[17GI\u001b[19Gadded:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mSite language:\u001b[22m Kiswahili\u001b[30G(language\u001b[40G1,\u001b[43G\u001b[38;2;177;185;249m/sw/\u001b[39m,\u001b[49Glocale\u001b[56G\u001b[38;2;177;185;249msw_KE\u001b[39m)\u001b[63Gin\u001b[66G\u001b[38;2;177;185;249mconfig/sites/main/config.yaml\u001b[96G\u001b[39mand\u001b[100Gin\u001b[103G\u001b[38;2;177;185;249mInitialisation/Site/main/config.yaml\u001b[39m.\u001b[141GWhere\u001b[147Ga\u001b[149GKiswahili\r\u001b[4C\u001b[1Bpage\u001b[10Ghas\u001b[14Gno\u001b[17Gtranslated\u001b[28Gcontent,\u001b[37Git\u001b[40Gshows\u001b[46Gthe\u001b[50GEnglish\u001b[58Gcontent.\r\u001b[4C\u001b[1B\u001b[1mRegister \u001b[38;2;177;185;249msw\u001b[39m with TYPO3:\u001b[22m TYPO3 14 doesn't know Kiswahili as a\u001b[66Glabel language, so without this all labels stay English. \u001b[38;2;177;185;249mext_localconf.php\u001b[141G\u001b[39mnow registers \u001b[38;2;177;185;249msw\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLabels:\u001b[22m \u001b[38;2;177;185;249msw.frontend.xlf\u001b[39m a\u001b[31Gd \u001b[38;2;177;185;249msw.news.xlf\u001b[39m.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mS\u001b[7Ged sc\u001b[13Gipt:\u001b[22m \u001b[38;2;177;185;249mBuild/Initialisation/seed-kiswahili.php\u001b[39m tran\u001b[63Gl\u001b[65Gtes the 29 p\u001b[80Gs\u001b[82Gand shortcu\u001b[94Gs (Kiswahili titles\u001b[114Ga\u001b[116Gd URLs) and the home page: header\u001b[150G, slides\r\u001b[2C\u001b[1B \u001b[5Gand service tiles. TYPO3 creates these translations\u001b[57Ghidden,\u001b[65Gso\u001b[68Gthe\u001b[72Gscript\u001b[79Gmakes\u001b[85Gthem\u001b[90Gvisible.\r\u001b[4C\u001b[1B\u001b[1mExport:\u001b[22m \u001b[38;2;177;185;249mdata.xml\u001b[39m is exported again, and the README has the new seed\u001b[73Gste\u001b[77G and\u001b[83G \"Languages\"\u001b[96Gsection.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill English on the Kiswahili pages:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcontent\u001b[17Gof\u001b[20Gpages\u001b[26Gother\u001b[32Gthan\u001b[37Gthe\u001b[41Ghome\u001b[46Gpage,\u001b[52Gplus\u001b[57Gthe\u001b[61Gnews\u001b[66Gand\u001b[70Gevents.\r\u001b[2C\u001b[1B- The top-bar notice, the opening hours\u001b[43Gand\u001b[47Gthe\u001b[51Gfooter\u001b[58Gnote.\u001b[64GThese\u001b[70Gare\u001b[74Gsite\u001b[79Gsettings,\u001b[89Gwhich\u001b[95Ghold\u001b[100Gone\u001b[104Gvalue\u001b[110Gfor\u001b[114Gall\u001b[118Glanguages.\r\u001b[8C\u001b[1Bsearch filter \"Sh\u001b[27Gw only\".\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe Kiswahili search finds nothing.\u001b[22m The search ex\u001b[56Gnsi\u001b[60Gn (ke_search)\u001b[74Gonly\u001b[79Gindexes a\u001b[89Gpage translation that has conte\u001b[121Gt of its\u001b[130Gown,\u001b[135Gso\u001b[138Gthe\u001b[142Gindex\u001b[148Ghas\u001b[152Gno\r\u001b[2C\u001b[1B \u001b[5GKiswahili pages. It will start\u001b[36Gworking\u001b[44Gonce\u001b[49Gthose\u001b[55Gpages\u001b[61Gget\u001b[65GKiswahili\u001b[75Gcontent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gnative speaker should check the Kiswahili wording; I wrot\u001b[63G it myself.\u001b[75G\u001b[K\r\u001b[2C\u001b[2BYour local d\u001b[16Gtaba\u001b[21Ge now\u001b[27Ghas the tran\u001b[40Gl\u001b[42Gt\u001b[44Gons. A s\u001b[53Gapshot from befor\u001b[71G them\u001b[77Gexists:\u001b[85G\u001b[38;2;177;185;249mddev snapshot restore before-kiswahili\u001b[39m.\u001b[125GNothing\u001b[133Gis\u001b[136Gcommitted.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mseed-kiswahili.php\u001b[22G\u001b[39mand\u001b[26Gthe\u001b[30Gtwo\u001b[34G\u001b[38;2;177;185;249msw.*.xlf\u001b[43G\u001b[39mfiles\u001b[49Gare\u001b[53Gnew\u001b[57Gand\u001b[61Guntracked.\u001b[72GTell\u001b[77Gme\u001b[80Gif\u001b[83Gyou\u001b[87Gwant\u001b[92Ga\u001b[94G\"Stage\u001b[101G14-languages\"\u001b[115Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 4m 57s · done 6:35 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe goal was a working language menu, and it now works: the site has Kiswahili at /sw/, with translated pages, home page and labels. Nothing is \r\u001b[2C\u001b[1Bcommitted yet, so the next step is your go for a \"Stage 14-languages\" commit. (turn off recaps in /config)\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255msearching for ardhi there is no result\u001b[39m                                                                                                                       \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Let me find out why the indexer skips the Kiswahili pages.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ P=$(find vendor -path '*ke_search/Classes/Indexer/Types/Page.php'); echo $P; grep -n \"sys_language_uid\\|languageUid\\|function \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m\\|cachedPageRecords\\[\\|fallback\\|indexedContent\\|if (empty\\|strlen\\|continue\" $P | head -90\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
