[612.95196, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat I checked:\u001b[22m I loaded the English and Kiswahili versions of the home page, \"Land rates\", News,\r\u001b[2C\u001b[1BEvents,\u001b[11GContact and\u001b[23GSearch.\u001b[31GEvery\u001b[37Gpage\u001b[42Ganswers\u001b[50G200,\u001b[55Ghas\u001b[59G\u001b[38;2;177;185;249m<html lang=\"sw-KE\">\u001b[79G\u001b[39mon\u001b[82Gthe\u001b[86GKiswahili\u001b[96Gside,\u001b[102Ghas\r\u001b[2C\u001b[1Bone \u001b[38;2;177;185;249m<body>\u001b[39m,\u001b[15Gand\u001b[19Glists\u001b[25Gboth\u001b[30Glanguages\u001b[40Gin\u001b[43Gits\u001b[47Ghreflang\u001b[56Glinks.\u001b[63GThe\u001b[67Gmenu\u001b[72Glink\u001b[77Galways\u001b[84Gpoints\u001b[91Gto\u001b[94Gthe\u001b[98Gsame\u001b[103Gpage\r\u001b[2C\u001b[1Bin\u001b[6Gthe other language\u001b[25G(\u001b[38;2;177;185;249m/revenue-payments/land-rates\u001b[39m ↔ \u001b[38;2;177;185;249m/sw/mapato-malipo/kodi-ya-ardhi\u001b[39m).\u001b[91GI\u001b[93Ghave\u001b[98Gnot\u001b[102Grun\r\u001b[2C\u001b[1Ba\u001b[5Gfresh\u001b[11Ginstall\u001b[19Gfrom\u001b[24Gthe\u001b[28Gnew\u001b[32G\u001b[38;2;177;185;249mdata.xml\u001b[39m.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe menu itself didn't need changing.\u001b[22m The menu code was \u001b[60Glready in \u001b[38;2;177;185;249msetup.typoscript\u001b[87G\u001b[39mand\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m, but the s\u001b[32Gte had on\u001b[42Gy English, so it showed\u001b[66Gnothing.\u001b[75GWhat\u001b[80GI\u001b[82Gadded:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite language:\u001b[20G\u001b[22mKiswahili (languag\u001b[39G 1, \u001b[38;2;177;185;249m/sw/\u001b[39m, locale\u001b[56G\u001b[38;2;177;185;249msw_KE\u001b[39m) in \u001b[38;2;177;185;249mconfig/sites/main/config.yaml\u001b[96G\u001b[39mand\u001b[100Gin\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mInitialisation/Site/main/config.yaml\u001b[39m. Where a Kisw\u001b[56Ghili page has no\u001b[73Gtranslated\u001b[84Gcontent,\u001b[93Git\u001b[96Gshows\u001b[102Gthe\r\u001b[4C\u001b[1BEnglish\u001b[13Gcontent.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRegister \u001b[38;2;177;185;249msw\u001b[39m with TYPO3:\u001b[29G\u001b[22mTYPO3\u001b[35G14\u001b[38Gdoesn't\u001b[46Gknow\u001b[51GKiswahili\u001b[61Gas\u001b[64Ga\u001b[66Glabel\u001b[72Glanguage,\u001b[82Gso\u001b[85Gwithout\u001b[93Gthis\u001b[98Gall\r\u001b[4C\u001b[1Blabels\u001b[12Gstay English. \u001b[38;2;177;185;249mext_localconf.php\u001b[39m now registers \u001b[38;2;177;185;249msw\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLabels:\u001b[13G\u001b[22m\u001b[38;2;177;185;249msw.frontend.xlf\u001b[39m and \u001b[38;2;177;185;249msw.news.xlf\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed script:\u001b[22m \u001b[38;2;177;185;249mBuild/Initialisation/seed-kiswahili.php\u001b[58G\u001b[39mtranslates\u001b[69Gthe\u001b[73G29\u001b[76Gpages\u001b[82Gand\u001b[86Gshortcuts\u001b[96G(Kiswahili\r\u001b[4C\u001b[1Btitles\u001b[12Gand\u001b[16GURLs)\u001b[22Gand\u001b[26Gthe\u001b[30Ghome\u001b[35Gpage:\u001b[41Gheaders,\u001b[50Gslides\u001b[57Gand\u001b[61Gservice\u001b[69Gtiles.\u001b[76GTYPO3\u001b[82Gcreates\u001b[90Gthese\r\u001b[4C\u001b[1Btranslations hidden, so the script makes them visible.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExport:\u001b[22m \u001b[38;2;177;185;249mdata.xml\u001b[39m is exported again, and the README has the new seed step and a \"Languages\" section.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill English on the Kiswahili pages:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe content of\u001b[20Gpages\u001b[26Gother\u001b[32Gthan\u001b[37Gthe\u001b[41Ghome\u001b[46Gpage,\u001b[52Gplus\u001b[57Gthe\u001b[61Gnews\u001b[66Gand\u001b[70Gevents.\r\u001b[1B  - The top-bar notice, the\u001b[29Gopening\u001b[37Ghours\u001b[43Gand\u001b[47Gthe\u001b[51Gfooter\u001b[58Gnote.\u001b[64GThese\u001b[70Gare\u001b[74Gsite\u001b[79Gsettings,\u001b[89Gwhich\u001b[95Ghold\u001b[100Gone\r\u001b[4C\u001b[1Bvalue\u001b[11Gfor\u001b[15Gall\u001b[19Glanguages.\r\u001b[1B \u001b[3G- The search filter \"Show only\".\u001b[K\r\u001b[1B  - \u001b[1mThe Kiswahili search finds nothing.\u001b[22m The search extension (ke_search)\u001b[74Gonly\u001b[79Gindexes\u001b[87Ga\u001b[89Gpage\u001b[94Gtranslation\u001b[31;1H\u001b[29;3H\u001b[?25h"]
