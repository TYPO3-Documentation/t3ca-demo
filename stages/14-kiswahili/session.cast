[1504.060623, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[19G\u001b[22mI\u001b[21Gloaded\u001b[28Gthe\u001b[32GEnglish\u001b[40Gand\u001b[44GKiswahili\u001b[54Gversions\u001b[63Gof\u001b[66Gthe\u001b[70Ghome\u001b[75Gpage,\u001b[81G\"Land\u001b[87Grates\",\u001b[95GNews,\u001b[101GEvents,\u001b[109GContact\u001b[117Gand\u001b[121GSearch.\u001b[129GEvery\u001b[135Gpage\u001b[140Ganswers\u001b[148G200,\u001b[153Ghas\r\u001b[1B  \u001b[38;2;177;185;249m<html lang=\"sw-KE\">\u001b[39m on the\u001b[30GKiswahili\u001b[40Gside,\u001b[46Ghas\u001b[50Gone\u001b[54G\u001b[38;2;177;185;249m<body>\u001b[39m,\u001b[62Gand\u001b[66Glists\u001b[72Gboth\u001b[77Glanguages\u001b[87Gin\u001b[90Gits\u001b[94Ghreflang\u001b[103Glinks.\u001b[110GThe\u001b[114Gmenu\u001b[119Glink\u001b[124Galways\u001b[131Gpoints\u001b[138Gto\u001b[141Gthe\u001b[145Gsame\u001b[150Gpage\u001b[155Gin\r\u001b[2C\u001b[1Bthe\u001b[7Gother\u001b[13Glanguage\u001b[22G(\u001b[38;2;177;185;249m/revenue-payments/land-rates\u001b[52G\u001b[39m↔\u001b[54G\u001b[38;2;177;185;249m/sw/mapato-malipo/kodi-ya-ardhi\u001b[39m).\u001b[88GI\u001b[90Ghave\u001b[95Gnot\u001b[99Grun\u001b[103Ga\u001b[105Gfresh\u001b[111Ginstall\u001b[119Gfrom\u001b[124Gthe\u001b[128Gnew\u001b[132G\u001b[38;2;177;185;249mdata.xml\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe menu itself didn't need changing.\u001b[41G\u001b[22mThe\u001b[45Gmenu\u001b[50Gcode\u001b[55Gwas\u001b[59Galready\u001b[67Gin\u001b[70G\u001b[38;2;177;185;249msetup.typoscript\u001b[87G\u001b[39mand\u001b[91G\u001b[38;2;177;185;249mHeader.fluid.html\u001b[39m,\u001b[110Gbut\u001b[114Gthe\u001b[118Gsite\u001b[123Ghad\u001b[127Gonly\u001b[132GEnglish,\u001b[141Gso\u001b[144Git\u001b[147Gshowed\r\u001b[2C\u001b[1Bnothing. What I\u001b[19Gadded:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mSite language:\u001b[22m Kiswahili (language 1, \u001b[38;2;177;185;249m/sw/\u001b[39m, locale \u001b[38;2;177;185;249msw_KE\u001b[39m) in \u001b[38;2;177;185;249mconfig/sites/m\u001b[81Gin/config.yaml\u001b[39m and i\u001b[103G\u001b[38;2;177;185;249mInitialisation/Site/main/config.yaml\u001b[39m. Where\u001b[147Ga\u001b[149GKiswahili\r\u001b[4C\u001b[1Bpage\u001b[10Ghas\u001b[14Gno\u001b[17Gtranslated\u001b[28Gcontent,\u001b[37Git\u001b[40Gshows\u001b[46Gthe\u001b[50GEnglish\u001b[58Gcontent.\r\u001b[2C\u001b[1B- \u001b[1mRegister \u001b[38;2;177;185;249msw\u001b[39m with TYPO3:\u001b[22m TYPO3 14 doesn't k\u001b[48Gow Kiswahili as a label language, so without this all labels stay\u001b[114GEnglish.\u001b[123G\u001b[38;2;177;185;249mext_localconf.php\u001b[141G\u001b[39mn\u001b[143Gw regist\u001b[152Grs\u001b[155G\u001b[38;2;177;185;249msw\u001b[39m.\r\u001b[2C\u001b[1B- \u001b[1mLabels:\u001b[22m \u001b[38;2;177;185;249msw.frontend.xlf\u001b[29G\u001b[39mand\u001b[33G\u001b[38;2;177;185;249msw.news.xlf\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeed script:\u001b[18G\u001b[22m\u001b[38;2;177;185;249mBuild/Initialisation/seed-kiswahili.php\u001b[58G\u001b[39mtranslates\u001b[69Gthe\u001b[73G29\u001b[76Gpages\u001b[82Gand\u001b[86Gshortcuts\u001b[96G(Kiswahili\u001b[107Gtitles\u001b[114Gand\u001b[118GURLs)\u001b[124Gand\u001b[128Gthe\u001b[132Ghome\u001b[137Gpage:\u001b[143Gheaders,\u001b[152Gslides\r\u001b[2C\u001b[1B \u001b[5Gand service tiles. TYPO3\u001b[30Gcreates these trans\u001b[50Gations hidden, so the script makes them visible.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExport:\u001b[22m \u001b[38;2;177;185;249mdata.xml\u001b[39m is \u001b[26Gxported aga\u001b[38Gn, and the R\u001b[51GADME \u001b[57Gas th\u001b[63G new\u001b[68Gseed\u001b[73Gstep\u001b[78Gand\u001b[82Ga\u001b[84G\"Languages\"\u001b[96Gsection.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill English on the Kiswahili pages:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BThe content of pages other than the home page, plus the \u001b[62Gews and events.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gtop-bar\u001b[17Gnotice, the opening hour\u001b[42G and the fo\u001b[54Gter not\u001b[62G. These are s\u001b[76Gte\u001b[79Gsettings, wh\u001b[92Gch hold\u001b[100Gone\u001b[104Gvalue\u001b[110Gfor\u001b[114Gall\u001b[118Glanguages.\r\u001b[4C\u001b[1BThe search filter \"Show only\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe Kiswahili search finds nothing.\u001b[41G\u001b[22mThe\u001b[45Gsearch\u001b[52Gextension\u001b[62G(ke_search)\u001b[74Gonly\u001b[79Gindexes\u001b[87Ga\u001b[89Gpage\u001b[94Gtranslation\u001b[106Gthat\u001b[111Ghas\u001b[115Gcontent\u001b[123Gof\u001b[126Gits\u001b[130Gown,\u001b[135Gso\u001b[138Gthe\u001b[142Gindex\u001b[148Ghas\u001b[152Gno\r\u001b[2C\u001b[1B  Kiswahili pages. It will start working\u001b[44Gonce\u001b[49Gthose\u001b[55Gpages\u001b[61Gget\u001b[65GKiswahili\u001b[75Gcontent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gnative speaker should check the\u001b[37GKiswahili\u001b[47Gwording; I\u001b[58Gwrote\u001b[64Git myself.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BYour local database now has the translations. A snapshot from befo\u001b[70Ge them ex\u001b[80Gsts: \u001b[38;2;177;185;249mddev snapshot restore before-kiswahili\u001b[39m. No\u001b[128Ghing is committe\u001b[145G.\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mseed-kiswahili.php\u001b[22G\u001b[39mand the\u001b[30Gtwo \u001b[38;2;177;185;249msw.*.xlf\u001b[39m files\u001b[49Gare new and\u001b[61Gun\u001b[64Gracked. Tell me if you\u001b[87Gwant\u001b[92Ga\u001b[94G\"Stage\u001b[101G14-languages\"\u001b[115Gcommit.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 4m 57s · done 6:35 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe goal was a working language menu, and i"]
