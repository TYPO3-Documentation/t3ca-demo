[2245.882727, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m3\u001b[12G\u001b[38;2;248;248;242m       \u001b[20G    \u001b[25G   \u001b[29G   \u001b[33G   \u001b[37G     \u001b[43G    \u001b[48G   \u001b[52G         \u001b[62G       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 144 \u001b[22m ## Editors\u001b[K\r\u001b[8C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22mThe\u001b[16Gsetup\u001b[22Gcreates\u001b[30Gthe\u001b[34Gbackend\u001b[42Guser\u001b[47Ggroup\u001b[53G\"Editors\",\u001b[64Gafter\u001b[70Gthe\u001b[74Gimport,\u001b[82Gon\u001b[85Gevery\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\"ardhi\"\u001b[25Gnow\u001b[29Gworks.\u001b[36G\u001b[38;2;177;185;249m/sw/tafuta?q=ardhi\u001b[55G\u001b[39mreturns\u001b[63G\"Kodi\u001b[69Gya\u001b[72Gardhi\",\u001b[80Gand\u001b[84Gthe\u001b[88Gresult\u001b[95Glinks\u001b[101Gto\u001b[104G\u001b[38;2;177;185;249m/sw/mapato-malipo/kodi-ya-ardhi\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it found nothing:\u001b[25G\u001b[22mthe\u001b[29Gsearch\u001b[36Gextension\u001b[46G(ke_search)\u001b[58Gonly\u001b[63Gindexes\u001b[71Ga\u001b[73Gpage\u001b[78Gtranslation\u001b[90Gthat\u001b[95Ghas\u001b[99Gcontent\u001b[107Gelements\u001b[116Gin\u001b[119Gits\u001b[123Gown\u001b[127Glanguage.\u001b[137GThe\u001b[141GKiswahili\u001b[151Gpages\r\u001b[2C\u001b[1Bhave none of their own; they show th\u001b[40G English content instead. So even th\u001b[77Gir Ki\u001b[83Gw\u001b[85Gh\u001b[87Gli\u001b[91Gitles never reached the index.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[12G\u001b[22ma\u001b[14Gnew\u001b[18Ghook\u001b[23Gclass,\u001b[30G\u001b[38;2;177;185;249mClasses/Search/IndexFallbackContentOfPageTranslations.php\u001b[39m,\u001b[89Gis\u001b[92Gregistered\u001b[103Gin\u001b[106G\u001b[38;2;177;185;249mext_localconf.php\u001b[39m.\u001b[125GWhen\u001b[130Ga\u001b[132Gsite\u001b[137Glanguage\u001b[146Gfalls\u001b[152Gback\u001b[157Gto\r\u001b[2C\u001b[1BEnglish and a page tran\u001b[27Glation has no content of its own, the hook gives that translat\u001b[90Gon the English content. ke_search then stores it under the Kisw\u001b[154Ghili\u001b[K\r\u001b[2C\u001b[1Btit\u001b[7Ge. \u001b[38;2;177;185;249mServices.yaml\u001b[39m marks the\u001b[34Gclass public, which ke_searc\u001b[63G needs\u001b[70Gto create the hook with its dependency.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[19G\u001b[22mafter\u001b[25Gre-indexing,\u001b[38Gthe\u001b[42Gindex\u001b[48Gholds\u001b[54G16\u001b[57GKiswahili\u001b[67Gpages\u001b[73Gnext\u001b[78Gto\u001b[81Gthe\u001b[85G16\u001b[88GEnglish\u001b[96Gones.\u001b[102GIn\u001b[105GKiswahili,\u001b[116G\"ardhi\"\u001b[124Ggives\u001b[130G1\u001b[132Gresult\u001b[139Gand\u001b[143G\"land\"\u001b[150Ggives\u001b[156G4,\r\u001b[2C\u001b[1Bbecause the English content is indexed\u001b[42Gwith t\u001b[49Gem. The\u001b[57GEnglish search still\u001b[78Ggives the\u001b[88Gsame 6 results for \"l\u001b[110Gnd\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne gap remains:\u001b[20G\u001b[22mthe\u001b[24Gnews\u001b[29Gare\u001b[33Gindexed\u001b[41Gin\u001b[44GEnglish\u001b[52Gonly,\u001b[58Gso\u001b[61Gthey\u001b[66Gdon't\u001b[72Gshow\u001b[77Gup\u001b[80Gin\u001b[83Gthe\u001b[87GKiswahili\u001b[97Gsearch.\u001b[105GThe\u001b[109GREADME\u001b[116Gnow\u001b[120Gsays\u001b[125Gthis.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted\u001b[24Gyet.\u001b[29GThe\u001b[33Gnew\u001b[37Gfiles\u001b[43Gare\u001b[47Gthe\u001b[51Ghook\u001b[56Gclass,\u001b[63G\u001b[38;2;177;185;249mseed-kiswahili.php\u001b[82G\u001b[39mand\u001b[86Gthe\u001b[90Gtwo\u001b[94G\u001b[38;2;177;185;249msw.*.xlf\u001b[103G\u001b[39mfiles;\u001b[110Gthe\u001b[114GREADME\u001b[121Gsection\u001b[129G\"Languages\"\u001b[141Gcovers\u001b[148Gthe\u001b[152Gsearch\r\u001b[2C\u001b[1Bbehaviour.\u001b[14GTell me if you\u001b[29Gwant me\u001b[37Gto prepare a \"Stage 14-languages\" commit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 1m 6s · done 6:51 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mWe added Kiswahili as a second language so the header's language menu works, and the Kiswahili search now finds pages such as \"ardhi\". Nothing is \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mcommitted\u001b[13Gyet; say go \u001b[26Gf you\u001b[32Gwant a \"St\u001b[43Gge 14-languages\" commit. (t\u001b[71Grn off recaps in /config)\u001b[23m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow to translate the contact form?\u001b[39m                                                                                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Before answering, I'm checking the key format TYPO3 14's form framework uses to look up translations:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[35C\u001b[2B\u001b[38;2;153;153;153mthought for 3s)\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
