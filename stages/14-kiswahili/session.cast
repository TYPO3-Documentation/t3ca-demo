[1543.359798, "o", "\u001b[?25l\u001b[H\u001b[3GA\u001b[5Gnative speaker should check the\u001b[37GKiswahili\u001b[47Gwording; I\u001b[58Gwrote\u001b[64Git myself.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BYour local database now has the translations. A snapshot from befo\u001b[70Ge them ex\u001b[80Gsts: \u001b[38;2;177;185;249mddev snapshot restore before-kiswahili\u001b[39m. No\u001b[128Ghing is committe\u001b[145G.\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mseed-kiswahili.php\u001b[22G\u001b[39mand the\u001b[30Gtwo \u001b[38;2;177;185;249msw.*.xlf\u001b[39m files\u001b[49Gare new and\u001b[61Gun\u001b[64Gracked. Tell me if you\u001b[87Gwant\u001b[92Ga\u001b[94G\"Stage\u001b[101G14-languages\"\u001b[115Gcommit.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 4m 57s · done 6:35 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe goal was a working language menu, and it now works: the site has Kiswahili at /sw/, with translated pages, home page and labels. Nothing is \r\u001b[2C\u001b[1Bcommitted yet, so the next step is your go for a \"Stage 14-languages\" commit. (turn off recaps in /config)\u001b[23m\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255msearching for ardhi there is no result\u001b[39m                                                                                                                       \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLet me find out why the indexer skips the Kiswahili pages.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gindexer\u001b[15Gskips\u001b[21GKiswahili\u001b[31Gpages\u001b[37Gbecause\u001b[45Gthey\u001b[50Ghave\u001b[55Gno\u001b[58Gcontent\u001b[66Gelements\u001b[75Gof\u001b[78Gtheir\u001b[84Gown,\u001b[89Gso\u001b[92Gtheir\u001b[98Gtitles\u001b[105Gnever\u001b[111Greach\u001b[117Gthe\u001b[121Gindex.\u001b[128GI'm\u001b[132Glooking\u001b[140Gat\u001b[143Gwhich\u001b[149Gke_search\r\u001b[1B \u001b[3Gex\u001b[6Gension poin\u001b[18Gs could f\u001b[28Gx that.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[6C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m1\u001b[22G\u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[2Bke_sea\u001b[14Gch \u001b[18Gndex can take \u001b[33G modifyPag\u001b[44GsIndexEntry hook \u001b[62Gha\u001b[66Gswaps in\u001b[75Gthe English content each Kiswahili page shows, so \"ardhi\" will match. I'm\u001b[149Gchecking\u001b[K\r\u001b[2C\u001b[1Bthat ho\u001b[11Gk's signature next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m p\u001b[20Gttern \r\u001b[2B●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=dydwfq;file:///home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Classes/Search/IndexFallbackContentOfPageTranslations.php\u0007packages/mtosafi_sitepackage/Classes/Search/IndexFallbackContentOfPageTranslations.php\u001b]8;;\u0007)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3\u001b[16G-\u001b[18G<<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mp='packages/mtosafi_sitepackage/ext_localconf.php'; s=open(p).read()\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153ma=\"\"\" \\\\Mtosafi\\\\Sitepackage\\\\Search\\\\AddSearchWordToResultList::class;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m\"\"\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mb=a+\"\"\"…\u001b[39m\u001b[K\u001b[42;1H\u001b[40;3H\u001b[?25h"]
