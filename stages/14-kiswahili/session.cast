[1531.515272, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mExport:\u001b[22m \u001b[38;2;177;185;249mdata.xml\u001b[39m is exported again, and the README has the new seed\u001b[73Gste\u001b[77G and\u001b[83G \"Languages\"\u001b[96Gsection.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill English on the Kiswahili pages:\u001b[41G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcontent\u001b[17Gof\u001b[20Gpages\u001b[26Gother\u001b[32Gthan\u001b[37Gthe\u001b[41Ghome\u001b[46Gpage,\u001b[52Gplus\u001b[57Gthe\u001b[61Gnews\u001b[66Gand\u001b[70Gevents.\r\u001b[2C\u001b[1B- The top-bar notice, the opening hours\u001b[43Gand\u001b[47Gthe\u001b[51Gfooter\u001b[58Gnote.\u001b[64GThese\u001b[70Gare\u001b[74Gsite\u001b[79Gsettings,\u001b[89Gwhich\u001b[95Ghold\u001b[100Gone\u001b[104Gvalue\u001b[110Gfor\u001b[114Gall\u001b[118Glanguages.\r\u001b[8C\u001b[1Bsearch filter \"Sh\u001b[27Gw only\".\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe Kiswahili search finds nothing.\u001b[22m The search ex\u001b[56Gnsi\u001b[60Gn (ke_search)\u001b[74Gonly\u001b[79Gindexes a\u001b[89Gpage translation that has conte\u001b[121Gt of its\u001b[130Gown,\u001b[135Gso\u001b[138Gthe\u001b[142Gindex\u001b[148Ghas\u001b[152Gno\r\u001b[2C\u001b[1B \u001b[5GKiswahili pages. It will start\u001b[36Gworking\u001b[44Gonce\u001b[49Gthose\u001b[55Gpages\u001b[61Gget\u001b[65GKiswahili\u001b[75Gcontent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gnative speaker should check the Kiswahili wording; I wrot\u001b[63G it myself.\u001b[75G\u001b[K\r\u001b[2C\u001b[2BYour local d\u001b[16Gtaba\u001b[21Ge now\u001b[27Ghas the tran\u001b[40Gl\u001b[42Gt\u001b[44Gons. A s\u001b[53Gapshot from befor\u001b[71G them\u001b[77Gexists:\u001b[85G\u001b[38;2;177;185;249mddev snapshot restore before-kiswahili\u001b[39m.\u001b[125GNothing\u001b[133Gis\u001b[136Gcommitted.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mseed-kiswahili.php\u001b[22G\u001b[39mand\u001b[26Gthe\u001b[30Gtwo\u001b[34G\u001b[38;2;177;185;249msw.*.xlf\u001b[43G\u001b[39mfiles\u001b[49Gare\u001b[53Gnew\u001b[57Gand\u001b[61Guntracked.\u001b[72GTell\u001b[77Gme\u001b[80Gif\u001b[83Gyou\u001b[87Gwant\u001b[92Ga\u001b[94G\"Stage\u001b[101G14-languages\"\u001b[115Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 4m 57s · done 6:35 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe goal was a working language menu, and it now works: the site has Kiswahili at /sw/, with translated pages, home page and labels. Nothing is \r\u001b[2C\u001b[1Bcommitted yet, so the next step is your go for a \"Stage 14-languages\" commit. (turn off recaps in /config)\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255msearching for ardhi there is no result\u001b[39m                                                                                                                       \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Let me find out why the indexer skips the Kiswahili pages.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe indexer skips Kiswahili\u001b[31Gpages\u001b[37Gbecause\u001b[45Gthey\u001b[50Ghave\u001b[55Gno\u001b[58Gcontent\u001b[66Gelements\u001b[75Gof\u001b[78Gtheir\u001b[84Gown,\u001b[89Gso\u001b[92Gtheir\u001b[98Gtitles\u001b[105Gnever\u001b[111Greach\u001b[117Gthe\u001b[121Gindex.\u001b[128GI'm\u001b[132Glooking\u001b[140Gat\u001b[143Gwhich\u001b[149Gke_search\r\u001b[2C\u001b[1Bextension\u001b[13Gpoints\u001b[20Gcould\u001b[26Gfix\u001b[30Gthat.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe ke_search index can t\u001b[29Gke\u001b[32Ga mod\u001b[38GfyPagesIndexEntry\u001b[56Ghook\u001b[61Gthat\u001b[66Gswaps\u001b[72Gin\u001b[75Gthe\u001b[79GEnglish\u001b[87Gcontent\u001b[95Geach\u001b[100GKiswahili\u001b[110Gpage\u001b[115Gshows,\u001b[122Gso\u001b[125G\"ardhi\"\u001b[133Gwill\u001b[138Gmatch.\u001b[145GI'm\u001b[149Gchecking\r\u001b[1B  that hook's signature next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[3GStewing… \u001b[35G\u001b[38;2;153;153;153mthought for 12s)\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
