rExpression.\u001b[88G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOutside the form:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gheader\u001b[16G\"Write\u001b[23Gto\u001b[26Gus\"\u001b[30Gand\u001b[34Gthe\u001b[38Gsidebar\u001b[46Gtexts\u001b[52Gare\u001b[56Gordinary\u001b[65Gcontent\u001b[73Gelements.\u001b[83GThey\u001b[88Gstay\u001b[93GEnglish\u001b[101Guntil\u001b[107Gthe\u001b[111GContact\u001b[119Gpage\u001b[124Ggets\u001b[129GKiswahili\u001b[139Gcontent,\u001b[148Gwhich\u001b[154Gthe\r\u001b[2C\u001b[1B  seed script could\u001b[23Gdo\u001b[26Glike\u001b[31Git\u001b[34Gdoes\u001b[39Gfor\u001b[43Gthe\u001b[47Ghome\u001b[52Gpage.\r\u001b[8C\u001b[1Bmail to the municipality\u001b[34Gwould show i\u001b[47Gs field labels in\u001b[65GKiswahili wh\u001b[79G \u001b[81Gomeone\u001b[88Gwrites from \u001b[38;2;177;185;249m/sw/\u001b[39m, because \u001b[115Ghe mail template translates them\u001b[148Gtoo. If the\r\u001b[4C\u001b[1Boffice should a\u001b[21Gways\u001b[26Gget English mails, the t\u001b[51Gm\u001b[53Glate\u001b[58Gcan\u001b[62Gbe\u001b[65Gpinned\u001b[72Gto\u001b[75GEnglish.\r\u001b[2C\u001b[1B\u001b[K\u001b[42;1H\u001b[40;3H\u001b[?25h"]
[2260.440304, "o", "\u001b[?25l\u001b[H\u001b[17G\u001b[K\r\u001b[2C\u001b[1B┌────────────────────────────┬────────────────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│            What            │    \u001b[38G    \u001b[43G    \u001b[48G     \u001b[54G    \u001b[59G   \u001b[63G      \u001b[70G          \u001b[81G  Key  \u001b[89G   \u001b[93G    \u001b[98G         \u001b[108G           \u001b[137G│\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Field label                │ \u001b[38;2;177;185;249mcontact.element.name.properties.label\u001b[39m                                                                  │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Hint, placeholder          │ \u001b[38;2;177;185;249mcontact.element.message.properties.elementDescription\u001b[39m, \u001b[38;2;177;185;249mcontact.element.phone.properties.placeholder\u001b[39m    │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Select options             │ \u001b[38;2;177;185;249mcontact.element.topic.properties.options.revenue\u001b[39m, \u001b[38;2;177;185;249mcontact.element.topic.properties.prependOptionLabel\u001b[39m  │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Static text                │ \u001b[38;2;177;185;249mcontact.element.required-hint.properties.text\u001b[39m                                                          │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Submit button              │ \u001b[38;2;177;185;249mcontact.element.contact.renderingOptions.submitButtonLabel\u001b[39m                                             │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Confirmation, mail subject │ \u001b[38;2;177;185;249mcontact.fini"]
[2260.440354, "o", "sher.Confirmation.message\u001b[39m, \u001b[38;2;177;185;249mcontact.finisher.EmailToReceiver.subject\u001b[39m                        │\r\u001b[2C\u001b[1B├────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Error message              │ \u001b[38;2;177;185;249mcontact.validation.error.phone.1221565130\u001b[39m, or \u001b[38;2;177;185;249mvalidation.error.1221560910\u001b[39m for one shared by all fields │\r\u001b[2C\u001b[1B└────────────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe English text\u001b[20Gin\u001b[23Gthe\u001b[27Gform's\u001b[34GYAML stays as the source. Any key missing from the \u001b[38;2;177;185;249msw\u001b[39m file falls back to that\u001b[112GE\u001b[114Gglish text.\u001b[126G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo things the YAML can't keep as they are:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mCustom error messages:\u001b[22m the message\u001b[40G written directly into th\u001b[66G YAML (the phone number and the two \"I'm\u001b[107Gnot a robot\"\u001b[120Gm\u001b[122Gssages)\u001b[130Gare\u001b[134Greturned\u001b[143Gas\u001b[146Gthey\u001b[151Gare\u001b[155Gand\r\u001b[4C\u001b[1Bnever\u001b[11Gtranslated.\u001b[23GThey\u001b[28Ghave\u001b[33Gto\u001b[36Gmove\u001b[41Ginto\u001b[46Gthe\u001b[50GXLF\u001b[54Gunder\u001b[60Gthe\u001b[64Gkeys\u001b[69Gabove.\r\u001b[2C\u001b[1B- \u001b[1mStandard\u001b[14Gerror mess\u001b[25Gges:\u001b[22m the default messages\u001b[51G(\"This\u001b[58Gfield\u001b[64Gis\u001b[67Gmandatory\",\u001b[79G\"invalid\u001b[88Gemail\u001b[94Gaddress\")\u001b[104Gcome\u001b[109Gfrom\u001b[114GEXT:form's\u001b[125Gown\u001b[129Glabels.\u001b[137GTYPO3\u001b[143Ghas\u001b[147Gno\u001b[150GKiswahili\r\u001b[2C\u001b[1B \u001b[5Gfor them (it doesn't