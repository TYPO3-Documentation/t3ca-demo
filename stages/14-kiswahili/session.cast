[2785.303871, "o", "\u001b[?25l\u001b[H\u001b[5Gfor them (i\u001b[17G doesn't even\u001b[31Gknow the langua\u001b[47Ge, which is why the sit\u001b[71Gpackage \u001b[81Ggisters\u001b[89G\u001b[38;2;177;185;249msw\u001b[39m).\u001b[94GSo\u001b[97G\u001b[38;2;177;185;249msw.form.xlf\u001b[109G\u001b[39mneeds\u001b[115Gthem\u001b[120Gtoo,\u001b[125Gas\u001b[128G\u001b[38;2;177;185;249mvalidation.error.<code>\u001b[152G\u001b[39mfor\u001b[156Gthe\r\u001b[4C\u001b[1Bvalidators\u001b[16Gthe\u001b[20Gform\u001b[25Guses:\u001b[31GNotEmpty,\u001b[41GStringLength,\u001b[55GEmailAddress,\u001b[69GRegularExpression.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOutside the form:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GTh\u001b[8G header \"Write\u001b[23Gt\u001b[26Gus\" and\u001b[34Gth\u001b[37G sidebar texts\u001b[52Gare ordinary\u001b[65Gcontent\u001b[73Gelements.\u001b[83GThey\u001b[88Gstay\u001b[93GEnglish\u001b[101Guntil\u001b[107Gthe\u001b[111GContact\u001b[119Gpage\u001b[124Ggets\u001b[129GKiswahili\u001b[139Gcontent,\u001b[148Gwhich\u001b[154Gthe\r\u001b[2C\u001b[1B \u001b[5Gse\u001b[8Gd script\u001b[17Gcould do like it\u001b[34Gd\u001b[36Ges for the home page.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe mail to the municipality would show\u001b[45Gits\u001b[49Gfield labels\u001b[62Gin\u001b[65GK\u001b[67Gswahili\u001b[75Gwhen \u001b[81Gomeone\u001b[88Gwrites\u001b[95Gfrom\u001b[100G\u001b[38;2;177;185;249m/sw/\u001b[39m,\u001b[106Gbecause\u001b[114Gthe\u001b[118Gmail\u001b[123Gtemplate\u001b[132Gtranslates\u001b[143Gthem\u001b[148Gtoo.\u001b[153GIf\u001b[156Gthe\r\u001b[4C\u001b[1Boffice\u001b[12Gshould\u001b[19Galways\u001b[26Gget\u001b[30GEnglish\u001b[38Gmails,\u001b[45Gthe\u001b[49Gtemplate\u001b[58Gcan\u001b[62Gbe\u001b[65Gpinned\u001b[72Gto\u001b[75GEnglish.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gbuild\u001b[18Git:\u001b[22Gthe\u001b[26Gtranslation\u001b[38Gfile\u001b[43Gfor\u001b[47Gthe\u001b[51Gwhole\u001b[57Gform,