[2828.669105, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mThe site now has a Kiswahili version with a working language menu and search, all still uncommitted. I explained how to translate the contact form, \r\u001b[2C\u001b[1Band next I'm waiting for your go to build that translation. (turn off recaps in /config)\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mgo\u001b[39m                                                                                                                                                           \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Building it. First the error codes and the texts EXT:form uses by default:\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mOur file at key 20 is read before the core's (10).\u001b[54GNow\u001b[58Gchecking\u001b[67Gwhere\u001b[73Gthe\u001b[77GAltcha\u001b[84Gwidget\u001b[91Ggets\u001b[96Gits\u001b[100Gown\u001b[104Gtexts\u001b[110G(\"I'm\u001b[116Gnot\u001b[120Ga\u001b[122Grobot\"):\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe Altcha widget has\u001b[25Gits\u001b[29Gown\u001b[33Gtexts\u001b[39G(\"I'm\u001b[45Gnot\u001b[49Ga\u001b[51Grobot\",\u001b[59G\"Verifying…\"),\u001b[74Gwhich\u001b[80Gthe\u001b[84Gextension\u001b[94Gpasses\u001b[101Gin\u001b[104Gthrough\u001b[112Gan\u001b[115Gempty\u001b[121Gpartial.\u001b[130GChecking\u001b[139Gwhich\u001b[145Gkeys\u001b[150Gthe\u001b[154Gwidget\r\u001b[2C\u001b[1Btakes\u001b[9Gand\u001b[13Gwhether\u001b[21Git\u001b[24Gships\u001b[30GKiswahili:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe widget ships a Kiswahili\u001b[32Gbundle\u001b[39G(\"sw\")\u001b[46Gand\u001b[50Greads\u001b[56Gthe\u001b[60Glanguage\u001b[69Gfrom\u001b[74G\u001b[38;2;177;185;249m<html lang>\u001b[39m.\u001b[87GChecking\u001b[96Gthat\u001b[101Git\u001b[104Gmaps\u001b[109Gour\u001b[113G\u001b[38;2;177;185;249msw-KE\u001b[119G\u001b[39mto\u001b[122G\u001b[38;2;177;185;249msw\u001b[39m:\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe widget maps \u001b[38;2;177;185;249msw-KE\u001b[25G\u001b[39mto\u001b[28Gits\u001b[32G\u001b[38;2;177;185;249msw\u001b[35G\u001b[39mbundle\u001b[42Gby\u001b[45Gitself,\u001b[53Gso\u001b[56GAltcha\u001b[63Gneeds\u001b[69Gno\u001b[72Gwork.\u001b[78GNext,\u001b[84Gchecking\u001b[93Ghow\u001b[97Gthe\u001b[101Gmail\u001b[106Gfinisher\u001b[115Gchooses\u001b[123Gits\u001b[127Glanguage,\u001b[137Gso\u001b[140Gthe\u001b[144Goffice\u001b[151Gmail\u001b[156Gcan\r\u001b[2C\u001b[1Bstay\u001b[8GEnglish:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSetting \u001b[38;2;177;185;249mtranslation.language: default\u001b[39m on EmailToReceiver\u001b[60Gkeeps\u001b[66Gthe\u001b[70Goffice\u001b[77Gmail\u001b[82GEnglish.\u001b[91GNow\u001b[95Gthe\u001b[99Gcontent\u001b[107Gof\u001b[110Gthe\u001b[114GContact\u001b[122Gpage,\u001b[128Gfor\u001b[132Gthe\u001b[136Gseed\u001b[141Gscript:\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mT\u001b[5Ge Kiswa\u001b[13Gili sign-in label of \u001b[35Gh\u001b[37G Altcha\u001b[45Gwidget,\u001b[53Gso\u001b[56Gthe\u001b[60Gerror\u001b[66Gmessage\u001b[74Gcan\u001b[78Gname\u001b[83Git\u001b[86Gthe\u001b[90G