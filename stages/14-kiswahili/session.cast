[3097.695895, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[12G\u001b[38;2;248;248;242m                                                            \u001b[73G   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242mThe error mes\u001b[26Gages are in \u001b[39Ghe same file\u001b[53GMessages writ\u001b[67Gen\u001b[70Ginto \u001b[76Ghe form\u001b[84Gdefinition\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242m(`validati\u001b[23GnErrorMessages`) are shown as they are, in \u001b[67Gvery language,\u001b[82Gso\u001b[89Gf\u001b[91Grm  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m50\u001b[12G\u001b[38;2;248;248;242mkeeps none: the \u001b[29Gnes\u001b[33Gfor the phone number an\u001b[59Ghe spam pro\u001b[71Gection are keys of the\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m51\u001b[12G\u001b[38;2;248;248;242mform\u001b[17G(`contact.validation.error.phone.1221565130`),\u001b[64Gand\u001b[68Gthe\u001b[72Gmessages\u001b[81Gof\u001b[84Gthe\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m52\u001b[12G\u001b[38;2;248;248;242mvalidat\u001b[21Gs are k\u001b[29Gys for every\u001b[42Gform\u001b[47G(`validation.error.1221560910`). EXT:form has \u001b[94Go\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;2;153;153;153m… +16 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe contact form is translated. On \u001b[38;2;177;185;249m/sw/wasiliana-nasi\u001b[39m the labels, the hints, the topic options, the consent text with its link to \u001b[38;2;177;185;249m/sw/sera-ya-faragha\u001b[39m,\u001b[154Gand\r\u001b[2C\u001b[1Bthe submit button\u001b[21G\"Tuma\u001b[27Gujumbe\"\u001b[35Gare\u001b[39Gall\u001b[43Gin\u001b[46GKiswahili.\u001b[57GThe\u001b[61GEnglish\u001b[69Gpage\u001b[74Gis\u001b[77Gunchanged.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[19G\u001b[22mI\u001b[21Gsent\u001b[26Gthe\u001b[30Gform\u001b[35Gwith\u001b[40Gempty\u001b[46Gfields,\u001b[54Gan\u001b[57Ginvalid\u001b[65Gemail,\u001b[72Gthe\u001b[76Gphone\u001b[82Gnumber\u001b[89G\"abc\"\u001b[95Gand\u001b[99Ga\u001b[101Gtoo-short\u001b[111Gmessage.\u001b[120GAll\u001b[124G7\u001b[126Gerror\u001b[132Gmessages\u001b[141Gcome\u001b[146Gback\u001b[151Gin\r\u001b[1B \u001b[3GKiswahili on \u001b[38;2;177;185;249m/sw/\u001b[39m and i\u001b[27G English on \u001b[38;2;177;185;249m/contact\u001b[39m. The Contact\u001b[61Gp\u001b[63Gg\u001b[65G'\u001b[67G own content\u001b[80Galso shows in Ki\u001b[97Gwahili: th\u001b[108G heading \"Tuandikie\",\u001b[131Ghe address, the opening\u001b[K\r\u001b[2C\u001b[1Bhour\u001b[8G, \"Repor\u001b[17G a problem\", and the image's\u001b[46Galt text and caption.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mNot tested: a message that actually gets sent.\u001b[22m That \u001b[56Geeds the\u001b[65G\"I'm no\u001b[73G a\u001b[76Grobot\" puzzle solved in a browse\u001b[109G.\u001b[111GSo the Kiswahili c\u001b[130Gnfirmation\u001b[141Gmessage and the\r\u001b[2C\u001b[1BEnglish mail\u001b[16Gto the office are written but unproven. To check, \u001b[67Gend the form\u001b[80Gonce\u001b[85Gfr\u001b[88Gm \u001b[38;2;177;185;249m/sw/wasiliana-nasi\u001b[109G\u001b[39mand look at the mail\u001b[130Gin \u001b[38;2;177;185;249mddev mailpit\u001b[39m.\u001b[147G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTran\u001b[10Glation\u001b[17Gfile:\u001b[22m \u001b[38;2;177;185;249mConfiguration/Form/Sitepackage/config.yaml\u001b[39m points the form framework to the new \u001b[38;2;177;185;249mform.xlf\u001b[39m. \u001b[38;2;177;185;249mform.xlf\u001b[39m holds\u001b[128Gthe English text\u001b[145G and\u001b[K\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249msw.form.xlf\u001b[39m the Kiswahili ones.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mError messages:\u001b[21G\u001b[22mthe\u001b[25Gphone\u001b[31Gand\u001b[35G\"I'm\u001b[40Gnot\u001b[44Ga\u001b[46Grobot\"\u001b[53Gmessages\u001b[62Gmoved\u001b[68Gfrom\u001b[73G\u001b[38;2;177;185;249mcontact.form.yaml\u001b[91G\u001b[39minto\u001b[96Gthe\u001b[100GXLF,\u001b[105Gbecause\u001b[113Gtext\u001b[118Gwritten\u001b[126Gin\u001b[129Gthe\u001b[133GYAML\u001b[138Gis\u001b[141Gshown\u001b[147Guntranslated.\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249msw.form.xlf\u001b[17G\u001b[39malso\u001b[22Gcarries\u001b[30GKiswahili\u001b[40Gfor\u001b[44Gthe\u001b[48Gstandard\u001b[57Gvalidator\u001b[67Gmessages,\u001b[77Gsince\u001b[83GTYPO3\u001b[89Ghas\u001b[93Gnone.\r\u001b[4C\u001b[1B\u001b[1mOffice mail:\u001b[22m it stays English, whatever language the visitor\u001b[66Guses (\u001b[38;2;177;185;249mtranslation.language: default\u001b[39m on EmailToReceiver).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAltcha:\u001b[22m the\u001b[17Gwidget switches to Kiswahili\u001b[46Gby\u001b[49Gitself,\u001b[57Gbecause\u001b[65Git\u001b[68Greads\u001b[74Gthe\u001b[78Glanguage\u001b[87Gfrom\u001b[92G\u001b[38;2;177;185;249m<html lang>\u001b[104G\u001b[39mand\u001b[108Gships\u001b[114GKiswahili.\u001b[125GNo\u001b[128Gchange\u001b[135Gneeded.\r\u001b[4C\u001b[1B\u001b[1mContact page content:\u001b[22m \u001b[38;2;177;185;249mseed-kiswahili.php\u001b[46G\u001b[39mn\u001b[48Gw \u001b[51Granslates it too. I restored the snapshot, ran the script again, rebu\u001b[121Gl\u001b[123G the search index\u001b[141Gand exported\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata.x\u001b[12Gl\u001b[39m again.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mREADME:\u001b[22m a new sec\u001b[23Gion, \"The form in Kiswahili\", explain\u001b"]
[3097.69603, "o", "[61G \u001b[63Ghe\u001b[66Gkey format. Any new field needs its\u001b[102Gkey added in both XLF\u001b[124Gfiles.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing is committed. Should I prepare the\u001b[46G\"Stage 14-languages\" commit and show you the mess\u001b[96Gge?\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 3m 25s · done 7:14 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m/exit\u001b[39m                                                                                                                                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✽\u001b[3GTomfoolering… \u001b[49G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[42;1H\u001b[40;3H\u001b[?25h"]
