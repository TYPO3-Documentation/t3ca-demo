1b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m,\u001b[36Gw\u001b[38Gth\u001b[41Gthe JS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's readable.\u001b[22m This repo looks l\u001b[38Gke a\u001b[43Gstaged demo\u001b[55G(\u001b[38;2;177;185;249mStage 00…02\u001b[39m),\u001b[70Gand\u001b[74Ga\u001b[76Ghand-written\u001b[89Gpackage\u001b[97Gis\r\u001b[4C\u001b[1Bsomething\u001b[15Gpeople\u001b[22Gcan\u001b[26Gfollow\u001b[33Gcommit\u001b[40Gby\u001b[43Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo decisions to settle while setting it up:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKeep the \u001b[38;2;177;185;249mtypo3/fluid-styled-content\u001b[39m set.\u001b[22m EXT:form, felogin a\u001b[66Gd the\u001b[72Gsearch\u001b[79Gplugin\u001b[86Gall\u001b[90Grender\u001b[97Gthrough\r\u001b[2C\u001b[1B \u001b[5Gits \u001b[38;2;177;185;249mlib.contentElement\u001b[39m. If you drop it,\u001b[45Gthey r\u001b[52Gnder as nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mProbably drop \u001b[38;2;177;185;249mfluid-styled-content-css\u001b[39m,\u001b[45G\u001b[22mbecause\u001b[53Gyour\u001b[58GSCSS\u001b[63Gshould\u001b[70Gstyle\u001b[76Gthe\u001b[80Gcontent\u001b[88Gelements.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecisions for you before content work\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gpage\u001b[12Gframe\u001b[18Gis\u001b[21Gthe\u001b[25Geasy\u001b[30Gpart.\u001b[36GThese\u001b[42Gare\u001b[46Gproduct\u001b[54Gdecisions\u001b[64Gyou\u001b[68Gshould\u001b[75Gmake:\r\u001b[2C\u001b[1B                                     \u001b[69G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
