e:\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mHome\u001b[39m, \u001b[38;2;177;185;249mSidebarLeft\u001b[39m, \u001b[38;2;177;185;249mDefault\u001b[39m (full width),\u001b[46G\u001b[38;2;177;185;249mSidebarRight\u001b[39m \u001b[60Gnd \u001b[38;2;177;185;249mNarrow\u001b[39m. Each\u001b[76Gneeds \u001b[83G page template wit\u001b[102G a\u001b[K\r\u001b[4C\u001b[1Bmatching name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe header and footer become partials.\u001b[44G\u001b[22mThese\u001b[50Gare\u001b[54Gfragments\u001b[64Gof\u001b[67Gthe\u001b[71Gbody\u001b[76Gonly.\u001b[82GThe\u001b[86G\u001b[38;2;177;185;249m<head>\u001b[93G\u001b[39mand\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m<link>\u001b[39m/\u001b[38;2;177;185;249m<script>\u001b[39m tags go into the page setup as \u001b[38;2;177;185;249mincludeCSS\u001b[39m/\u001b[38;2;177;185;249mincludeJS\u001b[39m. The navigation and\u001b[93Gbreadcrumb\r\u001b[4C\u001b[1Bcome from the menu processor\u001b[34Ginste\u001b[40Gd of hard-coded links, and \u001b[38;2;177;185;249mlogo.svg\u001b[39m is loaded via \u001b[38;2;177;185;249mf:uri.resource\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe SCSS build moves in almost unchanged.\u001b[22m It g\u001b[52Ges into the package and\u001b[76Gwrites to\u001b[86G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m, with the JS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's readable.\u001b[22m This repo looks\u001b[36Gl\u001b[38Gke\u001b[41Ga staged demo (\u001b[38;2;177;185;249mStage 00…02\u001b[39m), and a hand-written\u001b[89Gpackage\u001b[97Gis\r\u001b[2C\u001b[1B \u001b[5Gsomething people can follow comm\u001b[38Gt \u001b[70G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
