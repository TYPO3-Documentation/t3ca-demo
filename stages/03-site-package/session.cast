[62.28156, "o", "\u001b[?25l\u001b[H\u001b[3G- It brings its own markup, CSS and content elements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u001b[85Gwith\u001b[90GBEM\u001b[94Gclasses,\u001b[103Gso\r\u001b[2C\u001b[1B \u001b[5Gyou'd spend your time overriding it.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\r\u001b[2C\u001b[1B\u001b[22m- This is a trap. TYPO3 normally writes the \u001b[38;2;177;185;249m<html>\u001b[39m, \u001b[38;2;177;185;249m<head>\u001b[39m, CSS and JS includes and meta\u001b[92Gtags.\u001b[98GWith\u001b[103Gthis\r\u001b[2C\u001b[1B \u001b[5Gsw\u001b[8Gtch,\u001b[13Gthe template car\u001b[30Gies the whole document and TYPO3\u001b[63Gadds \u001b[69Gothing, so the meta \u001b[91Ggs and\u001b[98Gevery\u001b[K\r\u001b[4C\u001b[1Bextension's\u001b[17Gassets are lost.\u001b[34G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy option 1\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe design maps cleanly onto TYPO3.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfive\u001b[58Glayouts\u001b[66Gbecomes\u001b[74Ga\u001b[76Gpage\u001b[81Glayout\u001b[88Geditors\u001b[96Gcan\u001b[100Gchoose:\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mHome\u001b[39m, \u001b[38;2;177;185;249mSidebarLeft\u001b[39m, \u001b[38;2;177;185;249mDefault\u001b[39m (full width),\u001b[46G\u001b[38;2;177;185;249mSidebarRight\u001b[39m \u001b[60Gnd \u001b[38;2;177;185;249mNarrow\u001b[39m. Each\u001b[76Gneeds \u001b[83G page template wit\u001b[102G a\u001b[K\r\u001b[4C\u001b[1Bmatching name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe header and footer become partials.\u001b[44G\u001b[22mThese\u001b[50Gare\u001b[54Gfragments\u001b[64Gof\u001b[67Gthe\u001b[71Gbody\u001b[76Gonly.\u001b[82GThe\u001b[86G\u001b[38;2;177;185;249m<head>\u001b[93G\u001b[39mand\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m<link>\u001b[39m/\u001b[38;2;177;185;249m<script>\u001b[39m tags go into the page setup as \u001b[38;2;177;185;249mincludeCSS\u001b[39m/\u001b[38;2;177;185;249mincludeJS\u001b[39m. The navigation and\u001b[93Gbreadcrumb\r\u001b[4C\u001b[1Bcome from the menu processor\u001b[34Ginste\u001b[40Gd of hard-coded links, and \u001b[38;2;177;185;249mlogo.svg\u001b[39m is loaded via \u001b[38;2;177;185;249mf:uri.resource\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe SCSS build moves in almost unchanged.\u001b[22m It g\u001b[52Ges into the package and\u001b[76Gwrites to\u001b[86G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m, with the JS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's readable.\u001b[22m This repo looks\u001b[36Gl\u001b[38Gke\u001b[41Ga staged demo (\u001b[38;2;177;185;249mStage 00…02\u001b[39m), and a hand-written\u001b[89Gpackage\u001b[97Gis\r\u001b[2C\u001b[1B \u001b[5Gsomething people can follow comm\u001b[38Gt by\u001b[43Gcommit.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo\u001b[7Gdecisions\u001b[17Gto\u001b[20Gsettle\u001b[27Gwhile\u001b[33Gsetting\u001b[41Git\u001b[44Gup:\r\u001b[2C\u001b[1B- \u001b[1mKeep the \u001b[38;2;177;185;249mtypo3/fluid-styled-content\u001b[39m set.\u001b[22m EXT:form,\u001b[56Gfelogin\u001b[64Gand\u001b[68Gthe\u001b[72Gsearch\u001b[79Gplugin\u001b[86Gall\u001b[90Grender\u001b[97Gthrough\r\u001b[2C\u001b[1B \u001b[5Gits \u001b[38;2;177;185;249mlib.contentElement\u001b[39m. If you drop it, they render as nothi\u001b[66Gg.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mProbably drop \u001b[38;2;177;185;249mfluid-styled-content-css\u001b[39m,\u001b[45G\u001b[22mbecaus\u001b[52G your SCSS should\u001b[70Gstyle\u001b[76Gthe\u001b[80Gcontent\u001b[88Gelements.\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[62.419368, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GThis\u001b[10Gis\u001b[13Ga\u001b[15Gtrap.\u001b[21GTYPO3\u001b[27Gnormally\u001b[36Gwrites\u001b[43Gthe\u001b[47G\u001b[38;2;177;185;249m<html>\u001b[39m,\u001b[55G\u001b[38;2;177;185;249m<head>\u001b[39m,\u001b[63GCSS\u001b[67Gand\u001b[71GJS\u001b[74Gincludes\u001b[83Gand\u001b[87Gmeta\u001b[92Gtags.\u001b[98GWith\u001b[103Gthis\r\u001b[2C\u001b[1B  switch, the template carries the whole document and TYPO3 adds nothing, so the meta tags\u001b[94Gand\u001b[98Gevery\r\u001b[2C\u001b[1B \u001b[5Gextension's \u001b[18Gssets are lost.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy option 1\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mThe design maps cleanly onto TYPO3.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfive\u001b[58Glayouts\u001b[66Gbecomes\u001b[74Ga\u001b[76Gpage\u001b[81Glayout\u001b[88Geditors\u001b[96Gcan\u001b[100Gchoose:\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mHome\u001b[39m,\u001b[11G\u001b[38;2;177;185;249mSidebarLeft\u001b[39m,\u001b[24G\u001b[38;2;177;185;249mDefault\u001b[32G\u001b[39m(full\u001b[38Gwidth),\u001b[46G\u001b[38;2;177;185;249mSidebarRight\u001b[59G\u001b[39mand\u001b[63G\u001b[38;2;177;185;249mNarrow\u001b[39m.\u001b[71GEach\u001b[76Gneeds\u001b[82Ga\u001b[84Gpage\u001b[89Gtemplate\u001b[98Gwith\u001b[103Ga\r\u001b[2C\u001b[1B \u001b[5Gmatching name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe header and footer become partials.\u001b[22m These are fragme\u001b[61Gts of the\u001b[71Gbody\u001b[76Gonly.\u001b[82GThe \u001b[38;2;177;185;249m<head>\u001b[39m and the\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m<link>\u001b[39m/\u001b[38;2;177;185;249m<script>\u001b[21G\u001b[39mtags\u001b[26Ggo\u001b[29Ginto\u001b[34Gthe\u001b[38Gpage\u001b[43Gsetup\u001b[49Gas\u001b[52G\u001b[38;2;177;185;249mincludeCSS\u001b[39m/\u001b[38;2;177;185;249mincludeJS\u001b[39m.\u001b[74GThe\u001b[78Gnavigation\u001b[89Gand\u001b[93Gbreadcrumb\r\u001b[2C\u001b[1B \u001b[5Gcome from the menu processor instead of \u001b[46Gard-coded links, and\u001b[67G\u001b[38;2;177;185;249mlogo.svg\u001b[76G\u001b[39mis loaded\u001b[86Gvia \u001b[38;2;177;185;249mf:uri.resource\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe SCSS build moves in almost unchanged.\u001b[22m It goes into the package and writes to\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m, with the\u001b[45GJS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt's readable.\u001b[22m This repo looks like a staged\u001b[50Gdemo\u001b[55G(\u001b[38;2;177;185;249mStage 00…02\u001b[39m), and a\u001b[76Ghand-written\u001b[89Gpackage\u001b[97Gis\r\u001b[4C\u001b[1Bsomething people can follow comm\u001b[39G by commit.\u001b[51G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo d\u001b[9Gcisions to settle while\u001b[33Gsett\u001b[38Gng it up:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKeep the \u001b[38;2;177;185;249mtypo3/fluid-styled-content\u001b[39m set.\u001b[46G\u001b[22mEXT:form,\u001b[56Gfelogin\u001b[64Gand\u001b[68Gthe\u001b[72Gsearch\u001b[79Gplugin\u001b[86Gall\u001b[90Grender\u001b[97Gthrough\r\u001b[2C\u001b[1B  its \u001b[38;2;177;185;249mlib.contentElement\u001b[39m. If you drop\u001b[43G, they\u001b[50Grender\u001b[57Gas\u001b[60Gnothing.\r\u001b[4C\u001b[1B\u001b[1mProbably\u001b[14Gdrop \u001b[38;2;177;185;249mfluid-styled-content-css\u001b[39m,\u001b[22m because your SCSS should style t\u001b[78Ge content elements.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecisions fo\u001b[16G you before content work\u001b[22m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
