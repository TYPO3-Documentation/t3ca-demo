[547.188568, "o", "\u001b[?25l\u001b[H\u001b[3G│ SidebarLeft  │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ SidebarRight │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Narrow       │ 200  │ 1/1/1/1                   │ no (has no sidebar)     │\r\u001b[2C\u001b[1B└──────────────┴──────┴───────────────────────────┴─────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNavigation:\u001b[17G\u001b[22mI\u001b[19Gadded\u001b[25Gtemporary\u001b[35G\"Revenue\u001b[44G&\u001b[46Gpayments\u001b[55G›\u001b[57GLand\u001b[62Grates\"\u001b[69Gpages.\u001b[76GThe\u001b[80Gmain\u001b[85Gnav,\u001b[90Gbreadcrumb\u001b[101Gand\r\u001b[2C\u001b[1B \u001b[5Gsub-navigation ren\u001b[24Ger with the right \u001b[38;2;177;185;249maria-current\u001b[55G\u001b[39mvalues.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLabels:\u001b[22m all page layout and column labels resolve\u001b[55Gin the backend.\r\u001b[4C\u001b[1B\u001b[1mTest data:\u001b[22m I switched page 1's layout and\u001b[47Gcreated\u001b[55Gtes\u001b[59G records through\u001b[76GDataHandler,\u001b[89Gthen\u001b[94Grestored\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glayout to empty. T\u001b[25G test pages (uid 2–4)\u001b[47Gand content el\u001b[62Gment (uid 2) are soft-d\u001b[86Gleted, so you can\u001b[K\r\u001b[4C\u001b[1Bpurge them in the R\u001b[25Gcycler.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot tested:\u001b[22m I\u001b[19Gdidn't open the\u001b[35Gpage\u001b[40Gmodule\u001b[47Gin\u001b[50Ga\u001b[52Gbrowser.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo bugs I fixed while testing\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEmpty page heading:\u001b[25G\u001b[22m\u001b[38;2;177;185;249m{page.title}\u001b[38G\u001b[39mrendered\u001b[47Gnothing.\u001b[56GIn\u001b[59Gv14\u001b[63G\u001b[38;2;177;185;249mpage\u001b[68G\u001b[39mis\u001b[71Gan\u001b[74Gobject,\u001b[82Gso\u001b[85Gthe\u001b[89Gright\u001b[95Gpath\u001b[100Gis\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m{page.pageRecord.title}\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFooter cut short:\u001b[22m the address\u001b[35Gand\u001b[39Gopening\u001b[47Ghours\u001b[53Gstopped\u001b[61Gafter\u001b[67Gthe\u001b[71Gfirst\u001b[77Gline,\u001b[83Gbecause\u001b[91G\u001b[38;2;177;185;249m{settings}\u001b[102G\u001b[39mreads\r\u001b[2C\u001b[1B \u001b[5GTypoScript constan\u001b[24Gs an\u001b[29G tho\u001b[34Ge end at a line break. The\u001b[61Gfooter now reads \u001b[38;2;177;185;249m{site.settings.all…}\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I changed the design\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFocus ring:\u001b[17G\u001b[22mthe\u001b[21Gdesign's\u001b[30Ggold\u001b[35Goutline\u001b[43Ghas\u001b[47Gonly\u001b[52G1.82:1\u001b[59Gcontrast\u001b[68Gon\u001b[71Gwhite,\u001b[78Gand\u001b[82GWCAG\u001b[87GAA\u001b[90G(which\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's README\u001b[21Gtargets)\u001b[30Gasks\u001b[35Gfor 3:1. It's now dark green (12.3:1) on light\u001b[82Gbackgrounds and stays\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[547.492167, "o", "\u001b[?25l\u001b[H\u001b[12GRight\r\u001b[4C\u001b[2BNarrow      \u001b[55Gno (has\u001b[63Gno\u001b[66Gsidebar)\r\u001b[2C\u001b[1B└\u001b[18G┴\u001b[25G┴\u001b[53G┴\u001b[79G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mNavigation:\u001b[22m I added temporary \"Revenue & payments › Land rates\" pages. The main\u001b[85Gnav,\u001b[90Gbreadcrumb\u001b[101Gand\r\u001b[4C\u001b[1Bsub-navigation\u001b[20Grender\u001b[27Gwith\u001b[32Gthe\u001b[36Gright\u001b[42G\u001b[38;2;177;185;249maria-current\u001b[55G\u001b[39mvalues.\r\u001b[4C\u001b[1B\u001b[1mL\u001b[7Gbels:\u001b[22m all\u001b[17Gpage layout and column labels resolve\u001b[55Gin the\u001b[62Gb\u001b[64Gckend.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTest data:\u001b[22m I switch\u001b[25Gd\u001b[27Gpage\u001b[32G1's\u001b[36Glayout and created\u001b[55Gtest records\u001b[68Gthrough\u001b[76GDataHandler,\u001b[89Gthen\u001b[94Grestored\u001b[103Gthe\r\u001b[2C\u001b[1B \u001b[5Glayout to em\u001b[18Gty.\u001b[22GThe test pages (uid 2–4)\u001b[47Gand conte\u001b[57Gt element (uid 2)\u001b[75Gare\u001b[79Gsoft-deleted,\u001b[93Gso\u001b[96Gyou\u001b[100Gcan\r\u001b[2C\u001b[1B \u001b[5Gpurge them\u001b[16Gin the R\u001b[25Gcycler.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot tested:\u001b[22m I didn't\u001b[26Gopen\u001b[31Gthe page module\u001b[47Gi\u001b[49G a browser.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo bugs I fixed while testing\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mEmpty page h\u001b[18Gading:\u001b[22m \u001b[38;2;177;185;249m{page.title}\u001b[38G\u001b[39mrendered\u001b[47Gnothing.\u001b[56GIn\u001b[59Gv14\u001b[63G\u001b[38;2;177;185;249mpage\u001b[68G\u001b[39mis\u001b[71Gan\u001b[74Gobject,\u001b[82Gso\u001b[85Gthe\u001b[89Gright\u001b[95Gpath\u001b[100Gis\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m{page.pageRecord.title}\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mFoo\u001b[9Ger cut\u001b[16Gshort:\u001b[22m the address and opening\u001b[47Gh\u001b[49Gurs stopped after the\u001b[71Gfirst line, because \u001b[38;2;177;185;249m{settings}\u001b[39m reads\r\u001b[4C\u001b[1BTypoScript constants and\u001b[30Gthose\u001b[36Gend\u001b[40Gat\u001b[43Ga\u001b[45Gline\u001b[50Gbreak.\u001b[57GThe\u001b[61Gfooter\u001b[68Gnow\u001b[72Greads\u001b[78G\u001b[38;2;177;185;249m{site.settings.all…}\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I changed the design\u001b[30G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mFocus\u001b[11Gring:\u001b[22m the design's\u001b[30Ggold\u001b[35Goutline\u001b[43Ghas\u001b[47Gonly\u001b[52G1.82:1\u001b[59Gcontrast\u001b[68Gon\u001b[71Gwhite,\u001b[78Gand\u001b[82GWCAG\u001b[87GAA\u001b[90G(which\u001b[97Gthe\r\u001b[4C\u001b[1Bdesign's\u001b[14GREADME\u001b[21Gtargets)\u001b[30Gasks\u001b[35Gfor\u001b[39G3:1.\u001b[44GIt's\u001b[49Gnow\u001b[53Gdark\u001b[58Ggreen\u001b[64G(12.3:1)\u001b[73Gon\u001b[76Glight\u001b[82Gbackgrounds\u001b[94Gand\u001b[98Gstays\r\u001b[2C\u001b[1B \u001b[5Ggold on the\u001b[17Gdark header,\u001b[30Gnav,\u001b[35Gfooter and slider (4.5–6.7:1).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
