[56.688949, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[38;2;177;185;249mfluid-styled-content\u001b[24G\u001b[39msets.\u001b[30GThe\u001b[34Gdesign\u001b[41Ghas\u001b[45G5\u001b[47Gpages\u001b[53Gwith\u001b[58G5\u001b[60Gdifferent\u001b[70Glayouts,\u001b[79Ga\u001b[81Gshared\u001b[88Gheader\u001b[95Gand\u001b[99Gfooter,\r\u001b[1B  about 900 lines of SCSS compiled\u001b[36Gwith\u001b[41Gplain\u001b[47G\u001b[38;2;177;185;249msass\u001b[39m,\u001b[53G5\u001b[55Gsmall\u001b[61GJS\u001b[64Gfiles,\u001b[71Gand\u001b[75Gseveral\u001b[83Ginteractive\u001b[95Gparts:\u001b[102Ga\r\u001b[1B  slider,\u001b[11Ga newsletter sign-up, a\u001b[35Gcontact\u001b[43Gform,\u001b[49Ga\u001b[51Glogin\u001b[57Gform,\u001b[63Gsearch,\u001b[71Gand\u001b[75Ga\u001b[77Gland\u001b[82Grates\u001b[88Gcalculator.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOptions\r\u001b[2B\u001b[22m  \u001b[1m1. Write a small sitepackage by hand (recommended).\u001b[22m You create \u001b[38;2;177;185;249mpackages/mto-safi/\u001b[39m yourself, add one site\r\u001b[1B  set, render pages with \u001b[38;2;177;185;249mPAGEVIEW\u001b[39m, and keep all templates under one root (\u001b[38;2;177;185;249mResources/Private/Templates/\u001b[39m).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFor:\u001b[10G\u001b[22mYou\u001b[14Gonly\u001b[19Ghave\u001b[24Gthe\u001b[28Gfiles\u001b[34Gyou\u001b[38Gneed,\u001b[44Gand\u001b[48Gthe\u001b[52Glayout\u001b[59Gfollows\u001b[67Gwhat\u001b[72Gv14\u001b[76Gexpects.\r\u001b[1B \u001b[3G- \u001b[1mAgainst:\u001b[22m You write\u001b[24Gm\u001b[26Gybe 15–20 fil\u001b[40Gs y\u001b[44Gurself.\u001b[52GFor a desig\u001b[64G this siz\u001b[74G, that's an afternoon.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Generate it with the Site Package Builder at get.typo3.org, then trim it.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mFor:\u001b[10G\u001b[22mIt's\u001b[15Gfast,\u001b[21Gand\u001b[25GComposer,\u001b[35G\u001b[38;2;177;185;249mext_emconf\u001b[46G\u001b[39mand\u001b[50Gthe\u001b[54Gset\u001b[58Gcome\u001b[63Gpre-filled.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAgainst:\u001b[14G\u001b[22mIt\u001b[17Gcreates\u001b[25Gmany\u001b[30Gempty\u001b[36Gfiles,\u001b[43Gand\u001b[47Gits\u001b[51Gfolders\u001b[59G(\u001b[38;2;177;185;249mResources/Private/PageView/…\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mPageTsConfig/BackendLayouts/\u001b[39m)\u001b[35Gdon't\u001b[41Gmatch\u001b[47Gthe\u001b[51Gv14\u001b[55Glayout\u001b[62Gabove.\u001b[69GYou'd\u001b[75Gdelete\u001b[82Gand\u001b[86Gmove\u001b[91Gabout\u001b[97Gas\u001b[100Gmuch\u001b[105Gas\r\u001b[4C\u001b[1Byou'd\u001b[11Gwrite.\u001b[18GThe\u001b[22Gconsole\u001b[30Galternatives\u001b[43Gdon't\u001b[49Gcreate\u001b[56Ga\u001b[58Gwhole\u001b[64Gsitepackage\u001b[76Geither:\u001b[84G\u001b[38;2;177;185;249mmake:site-package\r\u001b[4C\u001b[1B\u001b[39mrefuses,\u001b[14Gand\u001b[18G\u001b[38;2;177;185;249mfriendsoftypo3/kickstarter\u001b[45G\u001b[39monly\u001b[50Gwrites\u001b[57Gparts.\r\u001b[2C\u001b[2B\u001b[1m3. Build on top of \u001b[38;2;177;185;249mtheme_camino\u001b[39m, TYPO3 v14's built-in theme.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GIt's\u001b[10Gworth\u001b[16Greading\u001b[24Gas\u001b[27Gan\u001b[30Gexample,\u001b[39Gbut\u001b[43Gdon't\u001b[49Gdepend\u001b[56Gon\u001b[59Git.\u001b[63GIt's\u001b[68Gtied\u001b[73Gto\u001b[76Gone\u001b[80Grelease\u001b[88Gline\u001b[93Gand\u001b[97Gis\r\u001b[4C\u001b[1Bannounced\u001b[15Gto\u001b[18Gmove\u001b[23Gout\u001b[27Gof\u001b[30Gthe\u001b[34Gcore.\u001b[40GIts\u001b[44Glook\u001b[49Galso\u001b[54Ghas\u001b[58Gnothing\u001b[66Gto\u001b[69Gdo\u001b[72Gwith\u001b[77Gthis\u001b[82Gdesign.\r\u001b[2C\u001b[2B\u001b[1m4. Use a framework theme such as \u001b[38;2;177;185;249mbootstrap_package\u001b[39m.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GIt\u001b[8Gbrings\u001b[15Gits\u001b[19Gown\u001b[23Gmarkup,\u001b[31GCSS\u001b[35Gand\u001b[39Gcontent\u001b[47Gelements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u0