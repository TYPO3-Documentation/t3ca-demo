[64.461408, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Build on top of \u001b[38;2;177;185;249mtheme_camino\u001b[39m, TYPO3 v14's built-in theme.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt's worth reading as\u001b[27Gan\u001b[30Gexample, bu\u001b[42G don't\u001b[49Gdepend on i\u001b[61G. It's tied to one rel\u001b[84Gase line\u001b[93Gand\u001b[97Gis\r\u001b[4C\u001b[1Bannounced\u001b[15Gto\u001b[18Gmove\u001b[23Gout\u001b[27Gof\u001b[30Gthe\u001b[34Gcore.\u001b[40GIts\u001b[44Glook\u001b[49Galso\u001b[54Ghas\u001b[58Gnothing\u001b[66Gto\u001b[69Gdo\u001b[72Gwith\u001b[77Gthis\u001b[82Gdesign.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Use a framework theme such as \u001b[38;2;177;185;249mbootstrap_package\u001b[39m.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt brings its own markup, CSS and content\u001b[47Gelements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u001b[85Gwith\u001b[90GBEM\u001b[94Gclasses,\u001b[103Gso\r\u001b[4C\u001b[1Byou'd\u001b[11Gspend\u001b[17Gyour\u001b[22Gtime\u001b[27Goverriding\u001b[38Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GTh\u001b[8Gs is\u001b[13Ga trap. TYPO3 no\u001b[30Gmally writes the \u001b[38;2;177;185;249m<html>\u001b[39m, \u001b[38;2;177;185;249m<head>\u001b[39m,\u001b[63GCSS a\u001b[69Gd JS includes and me\u001b[91G tags.\u001b[98GWith this\r\u001b[4C\u001b[1Bswitch, the\u001b[17Gtemplate carries\u001b[34Gthe\u001b[38Gwhole\u001b[44Gdocument\u001b[53Gand\u001b[57GTYPO3\u001b[63Gadds\u001b[68Gnothing,\u001b[77Gso\u001b[80Gthe\u001b[84Gmeta\u001b[89Gtags\u001b[94Gand\u001b[98Gevery\r\u001b[4C\u001b[1Bextension's\u001b[17Gassets\u001b[24Gare\u001b[28Glost.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy option 1\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe design maps cleanly onto TYPO3.\u001b[22m Each\u001b[46Gof the five l\u001b[60Gyouts becomes a\u001b[76Gpage l\u001b[83Gyout editors can c\u001b[102Goose:\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mHome\u001b[39m, \u001b[38;2;177;185;249mSidebarLeft\u001b[39m,\u001b[24G\u001b[38;2;177;185;249mDefault\u001b[32G\u001b[39m(full\u001b[38Gwidth),\u001b[46G\u001b[38;2;177;185;249mSidebarRight\u001b[59G\u001b[39mand\u001b[63G\u001b[38;2;177;185;249mNarrow\u001b[39m.\u001b[71GEach\u001b[76Gneeds\u001b[82Ga\u001b[84Gpage\u001b[89Gtemplate\u001b[98Gwith\u001b[103Ga\r\u001b[2C\u001b[1B \u001b[5Gmatching name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe header and footer become partials.\u001b[22m These are fragments of the body only. The \u001b[38;2;177;185;249m<head>\u001b[93G\u001b[39mand the\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m<link>\u001b[39m/\u001b[38;2;177;185;249m<script>\u001b[39m tags go into\u001b[34Gthe p\u001b[40Gge setup as \u001b[38;2;177;185;249mincludeCSS\u001b[39m/\u001b[38;2;177;185;249mincludeJS\u001b[39m. The navigation and breadcrumb\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gcome from the menu processor instead of hard-c\u001b[52Gded links, and \u001b[38;2;177;185;249mlogo.svg\u001b[76G\u001b[39mis loaded\u001b[86Gvia\u001b[90G\u001b[38;2;177;185;249mf:uri.resource\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe SCSS build moves in almost unchanged.\u001b[22m It goes into the package and writes\u001b[83Gto\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m,\u001b[36Gw\u001b[38Gth\u001b[41Gthe JS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's readable.\u001b[22m This repo looks l\u001b[38Gke\u001b[70Gand\u001b[74Ga\u001b[76Ghand-written\u001b[89Gpackage\u001b[97Gis\u001b[31;1H\u001b[29;3H\u001b[?25h"]
