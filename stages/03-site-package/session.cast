01b[K\r\u001b[2C\u001b[1B\u001b[1mStill to do\u001b[15G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mContent elements:\u001b[23G\u001b[22mslider,\u001b[31Gquick-link\u001b[42Gtiles,\u001b[49Gnews\u001b[54Gand\u001b[58Gevents,\u001b[66Gnewsletter,\u001b[78Gcontact\u001b[86Gcard,\u001b[92Ginfo\u001b[97Gbox,\r\u001b[4C\u001b[1Bdownloads\u001b[15Glist\u001b[20Gand\u001b[24Gthe\u001b[28Gland\u001b[33Grates\u001b[39Gcalculator.\u001b[51GOnly\u001b[56G\u001b[38;2;177;185;249mnavigation.js\u001b[70G\u001b[39mis\u001b[73Gincluded\u001b[82Gsite-wide;\u001b[93Gthe\u001b[97Gother\r\u001b[2C\u001b[1B \u001b[5Gscripts should come \u001b[26Gn with their element\u001b[47G.\u001b[49G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSearch:\u001b[22m no search ext\u001b[27Gnsion\u001b[33Gis inst\u001b[42Gled. The\u001b[51Gheader form still subm\u001b[74Gts \u001b[38;2;177;185;249mq\u001b[39m and only shows once a search\r\u001b[4C\u001b[1Bpage i\u001b[14Get.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPages to create:\u001b[22m s\u001b[24Gt the service menu, footer\u001b[51Gm\u001b[53Gnu and search page in the\u001b[79Gsite settings.\u001b[94GU\u001b[96Gtil th\u001b[103Gn\u001b[K\r\u001b[4C\u001b[1Bthose parts stay\u001b[22Ghidden.\r\u001b[4C\u001b[1B\u001b[1mBrow\u001b[10Ger tab title:\u001b[22m shows\u001b[30Gonly the page\u001b[44Gtitl\u001b[49G,\u001b[51Gb\u001b[53Gcause th\u001b[62G site conf\u001b[73Gg\u001b[75Ghas\u001b[79Gno \u001b[38;2;177;185;249mwebsiteTitle\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour decisions:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249m/sitemap.xml\u001b[39m and\u001b[24G\u001b[38;2;177;185;249m/robots.txt\u001b[39m r\u001b[38Gturn 404. The fix is\u001b[60Go add the \u001b[38;2;177;185;249mtypo3/seo-sit\u001b[84Gmap\u001b[39m set and\u001b[96Ga\u001b[98Gstatic\r\u001b[2C\u001b[1B \u001b[5G  \u001b[38;2;177;185;249mrobots.txt\u001b[39m route\u001b[24Gin\u001b[27Gthe\u001b[31Gsite\u001b[36Gconfig.\r\u001b[6C\u001b[1B