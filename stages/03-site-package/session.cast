[551.338961, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mFooter cut short:\u001b[22m the address\u001b[35Gand\u001b[39Gopening\u001b[47Ghours\u001b[53Gstopped\u001b[61Gafter\u001b[67Gthe\u001b[71Gfirst\u001b[77Gline,\u001b[83Gbecause\u001b[91G\u001b[38;2;177;185;249m{settings}\u001b[102G\u001b[39mreads\r\u001b[2C\u001b[1B \u001b[5GTypoScript constan\u001b[24Gs an\u001b[29G tho\u001b[34Ge end at a line break. The\u001b[61Gfooter now reads \u001b[38;2;177;185;249m{site.settings.all…}\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I changed the design\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFocus ring:\u001b[17G\u001b[22mthe\u001b[21Gdesign's\u001b[30Ggold\u001b[35Goutline\u001b[43Ghas\u001b[47Gonly\u001b[52G1.82:1\u001b[59Gcontrast\u001b[68Gon\u001b[71Gwhite,\u001b[78Gand\u001b[82GWCAG\u001b[87GAA\u001b[90G(which\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's README\u001b[21Gtargets)\u001b[30Gasks\u001b[35Gfor 3:1. It's now dark green (12.3:1) on light\u001b[82Gbackgrounds and stays\r\u001b[4C\u001b[1Bgold on the dark header,\u001b[30Gnav,\u001b[37Goter and slider\u001b[53G(4.5–6.7:1).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mParent pages in menus:\u001b[22m a\u001b[30Gp\u001b[32Grent \u001b[38Gf the current page is now marked\u001b[71G\u001b[38;2;177;185;249maria-current=\"true\"\u001b[91G\u001b[39mand\u001b[95Gkeeps\u001b[101Gthe\r\u001b[2C\u001b[1B \u001b[5Gdesign's highlight. The desig\u001b[35G marked it as \u001b[38;2;177;185;249m\"page\"\u001b[39m,\u001b[57Gwhich tells screen readers it's the curr\u001b[98Gnt\u001b[101Gpage.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPage headings:\u001b[22m every layout except Home renders the\u001b[57Gpage tit\u001b[66Ge a\u001b[70G \u001b[38;2;177;185;249m<h1>\u001b[39m, so content element h\u001b[98Gadings\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gcome out as \u001b[38;2;177;185;249m<h2>\u001b[39m. Home gets\u001b[33Ga h\u001b[37Gading only sc\u001b[51Geen readers see,\u001b[68Gbecause the\u001b[80Gdesig\u001b[86G shows \u001b[94Gone there.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHome spacing:\u001b[22m the\u001b[23Ggap between\u001b[36Gome sections now wo\u001b[56Gks for\u001b[63Gcontent elements, wh\u001b[84Gch\u001b[87Garen't wrapped in\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m<section>\u001b[39m like the static HTML was.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill to do\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent elements:\u001b[23G\u001b[22mslider,\u001b[31Gquick-link\u001b[42Gtiles,\u001b[49Gnews\u001b[54Gand\u001b[58Gevents,\u001b[66Gnewsletter,\u001b[78Gcontact\u001b[86Gcard,\u001b[92Ginfo\u001b[97Gbox,\r\u001b[2C\u001b[1B \u001b[5Gdownloads list and the land rates calcu\u001b[45Gator. Only \u001b[38;2;177;185;249mnavigation.js\u001b[39m is included si\u001b[85Ge-wi\u001b[90Ge; the\u001b[97Gother\r\u001b[4C\u001b[1Bscripts \u001b[14Ghould\u001b[20Gcome in\u001b[28Gwith\u001b[33Gtheir\u001b[39Gelements.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSearch:\u001b[13G\u001b[22mno sear\u001b[21Gh \u001b[24Gxtens\u001b[30Gon\u001b[33Gis \u001b[37Gnstall\u001b[44Gd. The\u001b[51Gheader\u001b[58Gform\u001b[63Gstill\u001b[69Gsubmits\u001b[77G\u001b[38;2;177;185;249mq\u001b[79G\u001b[39mand\u001b[83Gonly\u001b[88Gshows\u001b[94Gonce\u001b[99Ga\u001b[101Gsearch\r\u001b[2C\u001b[1B \u001b[5Gpage is\u001b[13Gset.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPages to create:\u001b[22G\u001b[22mset\u001b[26Gthe\u001b[30Gservice\u001b[38Gmenu,\u001b[44Gfooter\u001b[51Gmenu\u001b[56Gand\u001b[60Gsearch\u001b[67Gpage\u001b[72Gin\u001b[75Gthe\u001b[79Gsite\u001b[84Gsettings.\u001b[94GUntil\u001b[100Gthen\r\u001b[2C\u001b[1B \u001b[5Gthose parts stay\u001b[22Ghidden.\u001b[30G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBrowser tab title:\u001b[22m shows\u001b[30Gonly\u001b[35Gthe\u001b[39Gpage\u001b[44Gtitle,\u001b[51Gbecause\u001b[59Gthe\u