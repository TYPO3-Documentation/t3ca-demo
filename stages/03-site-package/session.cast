[64.491737, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mPageTsConfig/BackendLayouts\u001b[33G\u001b[39m) don't match the v14 layou\u001b[61G above.\u001b[69GYou'd\u001b[75Gdelete\u001b[82Gand\u001b[86Gmove\u001b[91Gabout\u001b[97Gas\u001b[100Gmuch\u001b[105Gas\r\u001b[4C\u001b[1Byou'd\u001b[11Gwrite.\u001b[18GThe\u001b[22Gconsole\u001b[30Galternatives\u001b[43Gdon't\u001b[49Gcreate\u001b[56Ga\u001b[58Gwhole\u001b[64Gsitepackage\u001b[76Geither:\u001b[84G\u001b[38;2;177;185;249mmake:site-package\r\u001b[2C\u001b[1B\u001b[39m  refuses, and \u001b[38;2;177;185;249mfriendsoftypo3/kickstarter\u001b[39m only writes parts.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Build on top of \u001b[38;2;177;185;249mtheme_camino\u001b[39m, TYPO3 v14's built-in theme.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt's\u001b[10Gworth\u001b[16Greading\u001b[24Gas\u001b[27Gan\u001b[30Gexample,\u001b[39Gbut\u001b[43Gdon't\u001b[49Gdepend\u001b[56Gon\u001b[59Git.\u001b[63GIt's\u001b[68Gtied\u001b[73Gto\u001b[76Gone\u001b[80Grelease\u001b[88Gline\u001b[93Gand\u001b[97Gis\r\u001b[2C\u001b[1B  announced to move out of the core. Its look also has\u001b[58Gnothing\u001b[66Gto\u001b[69Gdo\u001b[72Gwith\u001b[77Gthis\u001b[82Gdesign.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Use a framework theme such as \u001b[38;2;177;185;249mbootstrap_package\u001b[39m.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GIt\u001b[8Gbrings\u001b[15Gits\u001b[19Gown\u001b[23Gmarkup,\u001b[31GCSS\u001b[35Gand\u001b[39Gcontent\u001b[47Gelements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u001b[85Gwith\u001b[90GBEM\u001b[94Gclasses,\u001b[103Gso\r\u001b[2C\u001b[1B  you'd spend your time overriding it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThis is a t