[83G page template wit\u001b[102G a\u001b[K\r\u001b[4C\u001b[1Bmatching name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe header and footer become partials.\u001b[44G\u001b[22mThese\u001b[50Gare\u001b[54Gfragments\u001b[64Gof\u001b[67Gthe\u001b[71Gbody\u001b[76Gonly.\u001b[82GThe\u001b[86G\u001b[38;2;177;185;249m<head>\u001b[93G\u001b[39mand\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m<link>\u001b[39m/\u001b[38;2;177;185;249m<script>\u001b[39m tags go into the page setup as \u001b[38;2;177;185;249mincludeCSS\u001b[39m/\u001b[38;2;177;185;249mincludeJS\u001b[39m. The navigation and\u001b[93Gbreadcrumb\r\u001b[4C\u001b[1Bcome from the menu processor\u001b[34Ginste\u001b[40Gd of hard-coded links, and \u001b[38;2;177;185;249mlogo.svg\u001b[39m is loaded via \u001b[38;2;177;185;249mf:uri.resource\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe SCSS build moves in almost unchanged.\u001b[22m It g\u001b[52Ges into the package and\u001b[76Gwrites to\u001b[86G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m, with the JS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's readable.\u001b[22m This repo looks\u001b[36Gl\u001b[38Gke\u001b[41Ga staged demo (\u001b[38;2;177;185;249mStage 00…02\u001b[39m), and a hand-written\u001b[89Gpackage\u001b[97Gis\r\u001b[2C\u001b[1B \u001b[5Gsomething people can follow comm\u001b[38Gt by\u001b[43Gcommit.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo\u001b[7Gdecisions\u001b[17Gto\u001b[20Gsettle\u001b[27Gwhile\u001b[33Gsetting\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[100.629332, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Use a framework theme such as \u001b[38;2;177;185;249mbootstrap_package\u001b[39m.\r\u001b[2C\u001b[1B\u001b[22m- It brings its own markup, CSS and content elements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u001b[85Gwith\u001b[90GBEM\u001b[94Gclasses,\u001b[103Gso\r\u001b[2C\u001b[1B \u001b[5Gyou'd spend your time overriding it.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\r\u001b[2C\u001b[1B\u001b[22m- This is a trap. TYPO3 normally writes the \u001b[38;2;177;185;249m<html>\u001b[39m, \u001b[38;2;177;185;249m<head>\u001b[39m, CSS and JS includes and meta\u001b[92Gtags.\u001b[98GWith\u001b[103Gthis\r\u001b[2C\u001b[1B \u001b[5Gsw\u001b[8Gtch,\u001b[13Gthe template car\u001b[30Gies the whole document and TYPO3\u001b[63Gadds \u001b[69Gothing, so the meta \u001b[91Ggs and\u001b[98Gevery\u001b[K\r\u001b[4C\u001b[1Bextension's\u001b[17Gassets are lost.\u001b[34G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy option 1\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe design maps cleanly onto TYPO3.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfive\u001b[58Glayouts\u001b[66Gbecomes\u001b[74Ga\u001b[76Gpage\u001b[81Glayout\u001b[88Geditors\u001b[96Gcan\u001b[100Gchoose:\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mHome\u001b[39m, \u001b[38;2;177;185;249mSidebarLeft\u001b[39m, \u001b[38;2;177;185;249mDefault\u001b[39m (full width),\u001b[46G\u001b[38;2;177;185;249mSidebarRight\u001b[39m \u001b[60Gnd \u001b[38;2;177;185;249mNarrow\u001b[39m. Each\u001b[76Gneeds \u001b[83G page template wit\u001b[102G a\u001b[K\r\u001b[4C\u001b[1Bmatching name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe header and footer become partials.\u001b[44G\u001b[22mThese\u001b[50Gare\u001b[54Gfragments\u001b[64Gof\u001b[67Gthe\u001b[71Gbody\u001b[76Gonly.\u001b[82GThe\u001b[86G\u001b[38;2;177;185;249m<head>\u001b[93G\u001b[39mand\u001b[97Gthe\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m<link>\u001b[39m/\u001b[38;2;177;185;249m<script>\u001b[39m tags go into the page setup as \u001b[38;2;177;185;249mincludeCSS\u001b[39m/\u001b[38;2;177;185;249mincludeJS\u001b[39m. The navigation and\u001b[93Gbreadcrumb\r\u001b[4C\u001b[1Bcome from the menu processor\u001b[34Ginste\u001b[40Gd of hard-coded links, and \u001b[38;2;177;185;249mlogo.svg\u001b[39m is loaded via \u001b[38;2;177;185;249mf:uri.resource\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe SCSS build moves in almost unchanged.\u001b[22m It g\u001b[52Ges into the package and\u001b[76Gwrites to\u001b[86G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m, with the JS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt's readable.\u001b[22m This repo looks\u001b[36Gl\u001b[38Gke\u001b[41Ga staged demo (\u001b[38;2;177;185;249mStage 00…02\u001b[39m), and a hand-written\u001b[89Gpackage\u001b[97Gis\r\u001b[2C\u001b[1B \u001b[5Gsomething people can follow comm\u001b[38Gt by\u001b[43Gcommit.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo\u001b[7Gdecisions\u001b[17Gto\u001b[20Gsettle\u001b[27Gwhile\u001b[33Gsetting\u001b[41Git\u001b[44Gup:\r\u001b[2C\u001b[1B- \u001b[1mKeep the \u001b[38;2;177;185;249mtypo3/fluid-styled-content\u001b[69G\u001b[22m\u001b[39mhe\u001b[72Gsearch\u001b[79Gplugin\u001b[86Gall\u001b[90Grender\u001b[97Gthrough\u001b[31;1H\u001b[29;3H\u001b[?25h"]
