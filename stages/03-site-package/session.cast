[543.45474, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mTemplates:\r\u001b[4C\u001b[1B\u001b[22m-\u001b[7GOne\u001b[11Gpage\u001b[16Gframe\u001b[22G(\u001b[38;2;177;185;249mLayouts/Pages/Default\u001b[39m)\u001b[46Gplus\u001b[51Gpartials\u001b[60Gunder\u001b[66G\u001b[38;2;177;185;249mPartials/Page/\u001b[81G\u001b[39mfor\u001b[85Gthe\u001b[89Gheader,\u001b[97Gfooter,\r\u001b[1B \u001b[3G   \u001b[7Gbreadcrumb and\u001b[22Gmenu links. They're in their own folder so they can't collide\u001b[84Gwith\u001b[K\r\u001b[2C\u001b[1B    fluid_styled_content\u001b[28Gs\u001b[30G\u001b[38;2;177;185;249mHeader\u001b[39m partial.\u001b[K\r\u001b[2C\u001b[1B  - All navigation comes from \u001b[34Gage\u001b[38Gdata:\u001b[44Gmain nav, sub-navigation,\u001b[70Gbreadcrumb,\u001b[82Gservice\u001b[90Gmenu,\u001b[96Gfooter\u001b[103Gmenu\r\u001b[6C\u001b[1Band\u001b[11Glanguage\u001b[20Gmenu.\r\u001b[2C\u001b[1B  - CSS, JS and favicon\u001b[27Gare\u001b[31Gincluded\u001b[40Gthrough\u001b[48GTypoScript\u001b[59G(\u001b[38;2;177;185;249mincludeCSS\u001b[39m,\u001b[72G\u001b[38;2;177;185;249mincludeJSFooter\u001b[39m,\u001b[89G\u001b[38;2;177;185;249mshortcutIcon\u001b[39m).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSCSS:\u001b[11G\u001b[22mit\u001b[14Gmoved\u001b[20Ginto\u001b[25Gthe\u001b[29Gpackage.\u001b[38G\u001b[38;2;177;185;249mnpm run build\u001b[52G\u001b[39mwrites\u001b[59G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m.\r\u001b[1B \u001b[3G- \u001b[1mSite config:\u001b[22m \u001b[38;2;177;185;249mconfig/sites/main/setup.typoscript\u001b[39m h\u001b[55Gld the installer's welcome\u001b[82Gpage, which wou\u001b[98Gd have\u001b[K\r\u001b[2C\u001b[1B  overri\u001b[12Gden the\u001b[20Gse\u001b[23G. It\u001b[29Gcontent is \u001b[41Gow a\u001b[46Gcomment; the file \u001b[65Gs still there.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2B \u001b[3GI flushed \u001b[15Gches and re\u001b[27Gdered page 1 onc\u001b[44G with each lay\u001b[59Gut:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────┬──────┬───────────────────────────┬─────────────────────────┐\r\u001b[2C\u001b[1B│    Layout    │ HTTP │ \u001b[38;2;177;185;249m<html>\u001b[39m/\u001b[38;2;177;185;249m<head>\u001b[39m/\u001b[38;2;177;185;249m<body>\u001b[39m/\u001b[38;2;177;185;249m<h1>\u001b[39m │ Sidebar\u001b[63Gcolumn\u001b[70Grendered\u001b[79G│\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[1B \u001b[3G│ Def\u001b[9Gult   \u001b[16G  │ 200  │ 1/1/1/1\u001b[35G    \u001b[40G      \u001b[47G    \u001b[52G │ no (h\u001b[61Gs no sidebar) \u001b[76G   │\u001b[K\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GHome\u001b[18G│\u001b[20G200\u001b[25G│\u001b[27G1/1/1/1\u001b[35G(hidden\u001b[43Gh1)\u001b[53G│\u001b[55Gno\u001b[58G(has\u001b[63Gno\u001b[66Gsidebar)\u001b[79G│\r\u001b[1B \u001b[3G├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[1B  │ SidebarLeft  │ 200  │ 1/1/1/1                   │ yes \u001b[79G│\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[1B \u001b[3G│ SidebarRight │ 200\u001b[24G │ 1/1/1/1                   │ yes\u001b[79G│\r\u001b[1B  └──────────────┴──────┴───────────────────────────┴─────────────────────────┘\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[543.742672, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G- All navigation\u001b[22Gcomes\u001b[28Gfrom\u001b[33Gpage\u001b[38Gdata:\u001b[44Gmain\u001b[49Gnav,\u001b[54Gsub-navigation,\u001b[70Gbreadcrumb,\u001b[82Gservice\u001b[90Gmenu,\u001b[96Gfooter\u001b[103Gmenu\r\u001b[4C\u001b[1B \u001b[7Ga\u001b[9Gd\u001b[11Gl\u001b[13Gnguage menu.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GCSS, JS and favicon\u001b[27Gare included throug\u001b[47G Typ\u001b[52GScript (\u001b[38;2;177;185;249mincludeCSS\u001b[39m, \u001b[38;2;177;185;249mincludeJSFooter\u001b[39m,\u001b[89G\u001b[38;2;177;185;249mshortcutIcon\u001b[39m).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSCSS:\u001b[22m it mov\u001b[19G into the package. \u001b[38;2;177;185;249mnpm run build\u001b[52G\u001b[39mwrites\u001b[59G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite config:\u001b[22m \u001b[38;2;177;185;249mconfig/sites/main/setup.typoscript\u001b[39m held the installer's welcome\u001b[82Gpage, which would have\u001b[K\r\u001b[4C\u001b[1Boverridden th\u001b[20Gs\u001b[22Gt. Its\u001b[29Gcontent\u001b[37Gis\u001b[40Gnow\u001b[44Ga\u001b[46Gcomment;\u001b[55Gthe\u001b[59Gfile\u001b[64Gis\u001b[67Gstill\u001b[73Gthere.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gflushe\u001b[12G caches\u001b[20Gand rendered page 1\u001b[40Gonce with \u001b[51Gach\u001b[55Glayout:\u001b[K\r\u001b[2C\u001b[2B┌──────────────┬──────┬───────────────────────────┬─────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[8GLayout\u001b[18G│\u001b[20GHTTP\u001b[25G│\u001b[27G\u001b[38;2;177;185;249m<html>\u001b[39m/\u001b[38;2;177;185;249m<head>\u001b[39m/\u001b[38;2;177;185;249m<body>\u001b[39m/\u001b[38;2;177;185;249m<h1>\u001b[53G\u001b[39m│\u001b[55GSidebar\u001b[63Gcolumn\u001b[70Grendered\u001b[79G│\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────