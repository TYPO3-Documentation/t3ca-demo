[56.925701, "o", "\u001b[?25l\u001b[H\u001b[3Gslider, a newsletter\u001b[25Gign-up, a contact form, a log\u001b[55Gn form, s\u001b[65Garch, \u001b[72Gnd a land r\u001b[84Gt\u001b[86Gs\u001b[88Gcalculator.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOptions\u001b[11G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[1m1. Write a small sitepackage by hand (recommended).\u001b[55G\u001b[22mYou\u001b[59Gcreate\u001b[66G\u001b[38;2;177;185;249mpackages/mto-safi/\u001b[85G\u001b[39myourself,\u001b[95Gadd\u001b[99Gone\u001b[103Gsite\r\u001b[2C\u001b[1Bset,\u001b[8Grender\u001b[15Gpages\u001b[21Gwith\u001b[26G\u001b[38;2;177;185;249mPAGEVIEW\u001b[39m,\u001b[36Gand\u001b[40Gkeep\u001b[45Gall\u001b[49Gtemplates\u001b[59Gunder\u001b[65Gone\u001b[69Groot\u001b[74G(\u001b[38;2;177;185;249mResources/Private/Templates/\u001b[39m).\r\u001b[2C\u001b[1B- \u001b[1mFo\u001b[8G:\u001b[22m You only have the files you need, and the layout\u001b[59Gfollows what v14 expects.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mAgainst:\u001b[22m You write maybe 15–20\u001b[36Gfiles yourself. For a design\u001b[65Gthis size, that's an afternoon.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Generate it with the Site Package Builder at get.typo3.org, then trim it.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFor:\u001b[10G\u001b[22mIt's\u001b[15Gfast,\u001b[21Gand\u001b[25GComposer,\u001b[35G\u001b[38;2;177;185;249mext_emconf\u001b[46G\u001b[39mand\u001b[50Gthe\u001b[54Gset\u001b[58Gcome\u001b[63Gpre-filled.\r\u001b[2C\u001b[1B- \u001b[1mAgainst:\u001b[22m It creates many empty files, and its folders (\u001b[38;2;177;185;249mResources/Private/PageView/…\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mPageTsConfig/BackendLayouts/\u001b[39m)\u001b[35Gdon't match the v14 layout above. You'd\u001b[75Gdelete\u001b[82Gand\u001b[86Gmove\u001b[91Gabout\u001b[97Gas\u001b[100Gmuch\u001b[105Gas\r\u001b[2C\u001b[1B \u001b[5Gyou'd write. The console\u001b[30Galternatives\u001b[43Gdon't create a whole sitepackage either: \u001b[38;2;177;185;249mmake:site-package\r\u001b[4C\u001b[1B\u001b[39mrefuses, and \u001b[38;2;177;185;249mfriendsoftypo3\u001b[33Gkickstarter\u001b[39m only writes par\u001b[61Gs.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Build on top of \u001b[38;2;177;185;249mtheme_camino\u001b[39m, TYPO3 v14's built-in theme.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GIt's\u001b[10Gworth\u001b[16Greading\u001b[24Gas\u001b[27Gan\u001b[30Gexample,\u001b[39Gbut\u001b[43Gdon't\u001b[49Gdepend\u001b[56Gon\u001b[59Git.\u001b[63GIt's\u001b[68Gtied\u001b[73Gto\u001b[76Gone\u001b[80Grelease\u001b[88Gline\u001b[93Gand\u001b[97Gis\r\u001b[2C\u001b[1B  announced to move out of the core. Its look also has nothing\u001b[66Gto\u001b[69Gdo\u001b[72Gwith\u001b[77Gthis\u001b[82Gdesign.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Use a framework theme such as \u001b[38;2;177;185;249mbootstrap_package\u001b[39m.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt\u001b[8Gbrings\u001b[15Gits\u001b[19Gown\u001b[23Gmarkup,\u001b[31GCSS\u001b[35Gand\u001b[39Gcontent\u001b[47Gelements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u001b[85Gwith\u001b[90GBEM\u001b[94Gclasses,\u001b[103Gso\r\u001b[2C\u001b[1B  you'd spend your time overriding it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\r\u001b[2C\u001b[1B\u001b[22m-\u001b[31;1H\u001b[29;3H\u001b[?25h"]
