[544.141947, "o", "\u001b[?25l\u001b[H\u001b[7GCSS, JS and favicon are include\u001b[39G \u001b[41Ghrough TypoScript (\u001b[38;2;177;185;249mincludeCSS\u001b[39m, \u001b[38;2;177;185;249mincludeJSFooter\u001b[39m, \u001b[38;2;177;185;249mshortcutIcon\u001b[39m).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSCSS:\u001b[11G\u001b[22mit moved\u001b[20Ginto the\u001b[29Gpackage.\u001b[38G\u001b[38;2;177;185;249mnpm run build\u001b[52G\u001b[39mwrites\u001b[59G\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSite config:\u001b[22m \u001b[38;2;177;185;249mconfig/sites/main/setup.typoscript\u001b[39m held the installer's welcome page, which would have\r\u001b[2C\u001b[1B \u001b[5Goverridden the\u001b[20Gse\u001b[23G.\u001b[25GIts\u001b[29Gcontent is now a comment; \u001b[56Ghe\u001b[59Gfile is still there.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[2C\u001b[2BI flushed caches\u001b[20Gand\u001b[24Grendered\u001b[33Gpage\u001b[38G1\u001b[40Gonce\u001b[45Gwith\u001b[50Geach\u001b[55Glayout:\r\u001b[2C\u001b[2B┌──────────────┬──────┬───────────────────────────┬─────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[8GLayout\u001b[18G│\u001b[20GHTTP\u001b[25G│\u001b[27G\u001b[38;2;177;185;249m<html>\u001b[39m/\u001b[38;2;177;185;249m<head>\u001b[39m/\u001b[38;2;177;185;249m<body>\u001b[39m/\u001b[38;2;177;185;249m<h1>\u001b[53G\u001b[39m│\u001b[55GSidebar\u001b[63Gcolumn\u001b[70Grendered\u001b[79G│\r\u001b[2C\u001b[1B├\u001b[18G┼\u001b[25G┼\u001b[53G┼\u001b[79G┤\r\u001b[4C\u001b[1BDefault  \u001b[20G200 \u001b[27G1/1/1/1                  \u001b[55Gno (h\u001b[61Gs\u001b[63Gn\u001b[65G sidebar)    \r\u001b[4C\u001b[2BHome   \u001b[35G(hidden\u001b[43Gh1)\r\u001b[4C\u001b[2BSid\u001b[9GbarLeft\u001b[35G       \u001b[43G   \u001b[55Gyes    \u001b[63G  \u001b[66G        \r\u001b[11C\u001b[2BRight\r\u001b[4C\u001b[2BNarrow      \u001b[55Gno (has\u001b[63Gno\u001b[66Gsidebar)\r\u001b[2C\u001b[1B└\u001b[18G┴\u001b[25G┴\u001b[53G┴\u001b[79G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mNavigation:\u001b[22m I added temporary \"Revenue & payments › Land rates\" pages. The main\u001b[85Gnav,\u001b[90Gbreadcrumb\u001b[101Gand\r\u001b[4C\u001b[1Bsub-navigation\u001b[20Grender\u001b[27Gwith\u001b[32Gthe\u001b[36Gright\u001b[42G\u001b[38;2;177;185;249maria-current\u001b[55G\u001b[39mvalues.\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[544.290522, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mSCSS:\u001b[22m it moved into the package. \u001b[38;2;177;185;249mnpm run build\u001b[39m writes\u001b[59G\u001b[38;2;177;185;249mResourc\u001b[67Gs/Publi\u001b[75G/Css/main.css\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[1mite config:\u001b[22m \u001b[38;2;177;185;249mconfig/sites/main/setup.typoscript\u001b[39m held the installer's welcome page, which\u001b[94Gwould\u001b[100Ghave\r\u001b[2C\u001b[1B \u001b[5Goverridden the set. Its content is now a comment; the file is still th\u001b[76Gre.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gflushed\u001b[13Gcaches\u001b[20Gand\u001b[24Grendered\u001b[33Gpage\u001b[38G1\u001b[40Gonce\u001b[45Gwith\u001b[50Geach\u001b[55Glayout:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────┬──────┬───────────────────────────┬─────────────────────────┐\r\u001b[2C\u001b[1B│    Layout    │ HTTP │ \u001b[38;2;177;185;249m<html>\u001b[39m/\u001b[38;2;177;185;249m<head>\u001b[39m/\u001b[38;2;177;185;249m<body>\u001b[39m/\u001b[38;2;177;185;249m<h1>\u001b[39m │ Sidebar column rendered │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Default      │ 200  │ 1/1/1/1                   │ no (has no sidebar)     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Home         │ 200  │ 1/1/1/1 (hidden h1)       │ no (has no sidebar)     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ SidebarLeft  │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ SidebarRight │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Narrow       │ 200  │ 1/1/1/1                   │ no (has no sidebar)     │\r\u001b[2C\u001b[1B└──────────────┴──────┴───────────────────────────┴─────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNavigation:\u001b[17G\u001b[22mI\u001b[19Gadded\u001b[25Gtemporary\u001b[35G\"Revenue\u001b[44G&\u001b[46Gpayments\u001b[55G›\u001b[57GLand\u001b[62Grates\"\u001b[69Gpages.\u001b[76GThe\u001b[80Gmain\u001b[85Gnav,\u001b[90Gbreadcrumb\u001b[101Gand\r\u001b[2C\u001b[1B \u001b[5Gsub-navigation ren\u001b[24Ger with the right \u001b[38;2;177;185;249maria-current\u001b[55G\u001b[39mvalues.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLabels:\u001b[22m all page layout and column labels resolve\u001b[55Gin the backend.\u001b[31;1H\u001b[29;3H\u001b[?25h"]
