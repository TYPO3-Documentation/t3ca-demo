[440.496572, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gpage\u001b[12Grenders\u001b[20Gwith\u001b[25Gone\u001b[29Gdocument,\u001b[39Gbut\u001b[43Gthe\u001b[47G\u001b[38;2;177;185;249m<h1>\u001b[52G\u001b[39mis\u001b[55Gempty\u001b[61Gbecause\u001b[69G\u001b[38;2;177;185;249m{page.title}\u001b[82G\u001b[39mpoints\u001b[89Gat\u001b[92Gthe\u001b[96Gwrong\u001b[102Gpath,\r\u001b[1B \u001b[3Gand the multi-line footer settings get\u001b[42Gcut after the first line.\u001b[68GI'm rea\u001b[76Ging how\u001b[84GPAGEVIEW assigns\u001b[101G\u001b[38;2;177;185;249mpage\r\u001b[2C\u001b[1B\u001b[39mand\u001b[7G\u001b[38;2;177;185;249msettings\u001b[16G\u001b[39mnext.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTypoScript constants ar\u001b[27G read line\u001b[38Gby line, so a\u001b[52Gmulti-line \u001b[38;2;177;185;249mtext\u001b[68G\u001b[39msetting gets truncated, while the \u001b[38;2;177;185;249mSite\r\u001b[2C\u001b[1B\u001b[39mobject keeps\u001b[16Gthe full value.\u001b[32GI'm\u001b[36Gchecking\u001b[45Gwhat\u001b[50G\u001b[38;2;177;185;249mSiteSettings::getAll()\u001b[73G\u001b[39mreturns\u001b[81Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[6C\u001b[2B\u001b[1m1\u001b[22G\u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;177;185;249mgetAll()\u001b[39m returns the\u001b[24Gnested tree, so \u001b[38;2;177;185;249m{site.settings.all.mtosafi.footer.address}\u001b[39m keeps the l\u001b[95Gn\u001b[98Gbr\u001b[101Gaks.\u001b[K\r\u001b[2C\u001b[1BThe page title is \u001b[38;2;177;185;249m{page.pageRecord.title}\u001b[39m. Fixing both:\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd /home/lina-wolf/projects/typo3/t3ca-2026/demo/packages/mtosafi_sitepackage/Resources/Private/Tem\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mplates && sed -i 's/<h1>{page.title}<\\/h1>/<h1>{page.pageRecord.title}<\\/h1>/' Pages/*.fluid.html && \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mgrep -n \"h1\" Pages/*.fluid.html && python3 -I - <<'EOF'\r\u001b[5C\u001b[1Bp='Partials/Page/Footer.fluid.html'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153ms=ope…\u001b[13G\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
