[544.993079, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow I tested it\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gflushed\u001b[13Gcaches\u001b[20Gand\u001b[24Grendered\u001b[33Gpage\u001b[38G1\u001b[40Gonce\u001b[45Gwith\u001b[50Geach\u001b[55Glayout:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────┬──────┬───────────────────────────┬─────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[5G   Layout    │\u001b[20GHTTP │ \u001b[38;2;177;185;249m<html>\u001b[39m/\u001b[38;2;177;185;249m<head>\u001b[39m/\u001b[38;2;177;185;249m<body>\u001b[39m/\u001b[38;2;177;185;249m<h1>\u001b[39m │\u001b[55GSidebar\u001b[63Gcolumn\u001b[70Grendered\u001b[79G│\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Default      │ 200  │ 1/1/1/1                   │ no (has no sidebar)     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Home         │ 200  │ 1/1/1/1 (hidden h1)       │ no (has no sidebar)     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ SidebarLeft  │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ SidebarRight │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Narrow       │ 200  │ 1/1/1/1                   │ no (has no sidebar)     │\r\u001b[2C\u001b[1B└──────────────┴──────┴───────────────────────────┴─────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNavigation:\u001b[17G\u001b[22mI added\u001b[25Gtemporary\u001b[35G\"Revenue\u001b[44G&\u001b[46Gpayments\u001b[55G› Land rate\u001b[67G\" pages.\u001b[76GThe main\u001b[85Gnav,\u001b[90Gbreadcrumb\u001b[101Gand\r\u001b[2C\u001b[1B  sub-navigation render with the right \u001b[38;2;177;185;249maria-current\u001b[39m values.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLabels:\u001b[13G\u001b[22mall\u001b[17Gpage\u001b[22Glayout\u001b[29Gand\u001b[33Gcolumn\u001b[40Glabels\u001b[47Gresolve\u001b[55Gin\u001b[58Gthe\u001b[62Gbackend.\r\u001b[4C\u001b[1B\u001b[1mTest data:\u001b[22m I switched page 1's layout and created\u001b[55Gtest record\u001b[67G through\u001b[76GDataH\u001b[82Gndler, then restored the\r\u001b[4C\u001b[1Blayout to empty. Th\u001b[25G tes\u001b[30G pag\u001b[35Gs (uid\u001b[42G2–4) and content \u001b[60Glement\u001b[67G(uid 2)\u001b[75Gare\u001b[79Gsoft-deleted,\u001b[93Gso\u001b[96Gyou\u001b[100Gcan\r\u001b[2C\u001b[1B \u001b[5Gpurge them in the Recycler.\u001b[33G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[545.245922, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mHow I tested it\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gflushed\u001b[13Gcaches\u001b[20Gand\u001b[24Grendered\u001b[33Gpage\u001b[38G1\u001b[40Gonce\u001b[45Gwith\u001b[50Geach\u001b[55Glayout:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────┬──────┬───────────────────────────┬─────────────────────────┐\r\u001b[2C\u001b[1B│    Layout    │ HTTP │ \u001b[38;2;177;185;249m<html>\u001b[39m/\u001b[38;2;177;185;249m<head>\u001b[39m/\u001b[38;2;177;185;249m<body>\u001b[39m/\u001b[38;2;177;185;249m<h1>\u001b[39m │ Sidebar column rendered │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Default      │ 200  │ 1/1/1/1                   │ no (has no sidebar)     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Home         │ 200  │ 1/1/1/1 (hidden h1)       │ no (has no sidebar)     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ SidebarLeft  │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ SidebarRight │ 200  │ 1/1/1/1                   │ yes                     │\r\u001b[2C\u001b[1B├──────────────┼──────┼───────────────────────────┼─────────────────────────┤\r\u001b[2C\u001b[1B│ Narrow       │ 200  │ 1/1/1/1                   │ no (has no sidebar)     │\r\u001b[2C\u001b[1B└──────────────┴──────┴───────────────────────────┴─────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNavigation:\u001b[17G\u001b[22mI\u001b[19Gadded\u001b[25Gtemporary\u001b[35G\"Revenue\u001b[44G&\u001b[46Gpayments\u001b[55G›\u001b[57GLand\u001b[62Grates\"\u001b[69Gpages.\u001b[76GThe\u001b[80Gmain\u001b[85Gnav,\u001b[90Gbreadcru