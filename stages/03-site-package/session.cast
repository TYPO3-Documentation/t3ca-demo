[61.121311, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1m3. Build on top of \u001b[38;2;177;185;249mtheme_camino\u001b[39m, TYPO3 v14's built-in theme.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GIt's\u001b[10Gworth\u001b[16Greading\u001b[24Gas\u001b[27Gan\u001b[30Gexample,\u001b[39Gbut\u001b[43Gdon't\u001b[49Gdepend\u001b[56Gon\u001b[59Git.\u001b[63GIt's\u001b[68Gtied\u001b[73Gto\u001b[76Gone\u001b[80Grelease\u001b[88Gline\u001b[93Gand\u001b[97Gis\r\u001b[2C\u001b[1B  announced to move out of the core. Its look also has nothing\u001b[66Gto\u001b[69Gdo\u001b[72Gwith\u001b[77Gthis\u001b[82Gdesign.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Use a framework theme such as \u001b[38;2;177;185;249mbootstrap_package\u001b[39m.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt\u001b[8Gbrings\u001b[15Gits\u001b[19Gown\u001b[23Gmarkup,\u001b[31GCSS\u001b[35Gand\u001b[39Gcontent\u001b[47Gelements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u001b[85Gwith\u001b[90GBEM\u001b[94Gclasses,\u001b[103Gso\r\u001b[2C\u001b[1B  you'd spend your time overriding it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GThis\u001b[10Gis\u001b[13Ga\u001b[15Gtrap.\u001b[21GTYPO3\u001b[27Gnormally\u001b[36Gwrites\u001b[43Gthe\u001b[47G\u001b[38;2;177;185;249m<html>\u001b[39m,\u001b[55G\u001b[38;2;177;185;249m<head>\u001b[39m,\u001b[63GCSS\u001b[67Gand\u001b[71GJS\u001b[74Gincludes\u001b[83Gand\u001b[87Gmeta\u001b[92Gtags.\u001b[98GWith\u001b[103Gthis\r\u001b[2C\u001b[1B  switch, the template carries the whole document and TYPO3 adds nothing, so the meta tags\u001b[94Gand\u001b[98Gevery\r\u001b[2C\u001b[1B \u001b[5Gextension's \u001b[18Gssets are lost.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy option 1\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mThe design maps cleanly onto TYPO3.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfive\u001b[58Glayouts\u001b[66Gbecomes\u001b[74Ga\u001b[76Gpage\u001b[81Glayout\u001b[88Geditors\u001b[96Gcan\u001b[100Gchoose:\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mHome\u001b[39m,\u001b[11G\u001b[38;2;177;185;249mSidebarLeft\u001b[39m,\u001b[24G\u001b[38;2;177;185;249mDefault\u001b[32G\u001b[39m(full\u001b[38Gwidth),\u001b[46G\u001b[38;2;177;185;249mSidebarRight\u001b[59G\u001b[39mand\u001b[63G\u001b[38;2;177;185;249mNarrow\u001b[39m.\u001b[71GEach\u001b[76Gneeds\u001b[82Ga\u001b[84Gpage\u001b[89Gtemplate\u001b[98Gwith\u001b[103Ga\r\u001b[2C\u001b[1B \u001b[5Gmatching name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe header and footer become partials.\u001b[22m These are fragme\u001b[61Gts of the\u001b[71Gbody\u001b[76Gonly.\u001b[82GThe \u001b[38;2;177;185;249m<head>\u001b[39m and the\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m<link>\u001b[39m/\u001b[38;2;177;185;249m<script>\u001b[21G\u001b[39mtags\u001b[26Ggo\u001b[29Ginto\u001b[34Gthe\u001b[38Gpage\u001b[43Gsetup\u001b[49Gas\u001b[52G\u001b[38;2;177;185;249mincludeCSS\u001b[39m/\u001b[38;2;177;185;249mincludeJS\u001b[39m.\u001b[74GThe\u001b[78Gnavigation\u001b[89Gand\u001b[93Gbreadcrumb\r\u001b[2C\u001b[1B \u001b[5Gcome from the menu processor instead of \u001b[46Gard-coded links, and\u001b[67G\u001b[38;2;177;185;249mlogo.svg\u001b[76G\u001b[39mis loaded\u001b[86Gvia \u001b[38;2;177;185;249mf:uri.resource\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe SCSS build moves in almost unchanged.\u001b[22m It goes into the package and writes to\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mResources/Public/Css/main.css\u001b[39m, with the\u001b[45GJS in \u001b[38;2;177;185;249mResources/Public/JavaScript/\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt's readable.\u001b[22m This repo looks like a staged\u001b[50Gdemo\u001b[55G(\u001b[38;2;177;185;249mStage 00…02\u001b[39m), and a\u001b[76Ghand-written\u001b[89Gpackage\u001b[97Gis\r\u001b[4C\u001b[1Bsomething people can follow comm\u001b[39G by commit.\u001b[51G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[61.282443, "o", "\u001b[?25l\u001b[H\u001b[3G  announced to move out of the core. Its look also has nothing\u001b[66Gto\u001b[69Gdo\u001b[72Gwith\u001b[77Gthis\u001b[82Gdesign.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Use a framework theme such as \u001b[38;2;177;185;249mbootstrap_package\u001b[39m.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt\u001b[8Gbrings\u001b[15Gits\u001b[19Gown\u001b[23Gmarkup,\u001b[31GCSS\u001b[35Gand\u001b[39Gcontent\u001b[47Gelements.\u001b[57GYour\u001b[62Gdesign\u001b[69Gis\u001b[72Gfully\u001b[78Gcustom\u001b[85Gwith\u001b[90GBEM\u001b[94Gclasses,\u001b[103Gso\r\u001b[2C\u001b[1B  you'd spend your time overriding it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. Paste the HTML in and switch off TYPO3's page output (\u001b[38;2;177;185;249mconfig.disableAllHeaderCode\u001b[39m).\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GThis\u001b[10Gis\u001b[13Ga\u001b[15Gtrap.\u001b[21GTYPO3\u001b[27Gnormally\u001b[36Gwrites\u001b[43Gthe\u001b[47G\u001b[38;2;177;185;249m<html>\u001b[39m,\u001b[55G\u001b[38;2;177;185;249m<head>\u001b[39m,\u001b[63GCSS\u001b[67Gand\u001b[71GJS\u001b[74Gincludes\u001b[83Gand\u001b[87Gmeta\u001b[92Gtags.\u001b[98GWith\u001b[103Gthis\r\u001b[2C\u001b[1B  switch, the template carries the whole document and TYPO3 adds nothing, so the meta tags\u001b[94Gand\u001b[98Gevery\r\u001b[2C\u001b[1B \u001b[5Gextension's \u001b[18Gssets are lost.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy option 1\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mThe design maps cleanly onto TYPO3.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfive\u001b[58Glayouts\u001b[66Gbecomes\u001b[74Ga\u001b[76Gpage\u001b[81Glayout\u001b[88Geditors\u001b[96Gcan\u001b[100Gchoose:\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mHome\u001b[39m,\u001b[11G\u001b[38;2;177;185;249mSidebarLeft\u001b[39m,\u001b[24G\u001b[38;2;177;185;249mDefault\u001b[32G\u001b[39m(full\u001b[38Gwidth),\u001b[46G\u00