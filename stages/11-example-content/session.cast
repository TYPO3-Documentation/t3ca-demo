[367.996797, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 33 \u001b[22m `Build/Initialisation/seed-news.php` the news on top of them,\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 34 \u001b[22m `Build/Initialisation/seed-home.php` the slider and the service tiles of the home page\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 35 \u001b[22m and `Build/Initialisation/seed-not-found.php` the \"Page not found\" page with the\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 32 -\u001b[38;2;248;248;242m404 error handling of the site \u001b[48;2;92;2;0mand \u001b[48;2;61;1;0m`Build/Initialisation/seed-search.php` the            \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 33 -\u001b[38;2;248;248;242msearch, and it is exported from there:                                                   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m36\u001b[11G\u001b[38;2;248;248;242m404 error\u001b[21Ghandling\u001b[30Gof\u001b[33Gthe\u001b[37Gsite\u001b[48;2;4;71;0m,\u001b[43G\u001b[48;2;2;40;0m`Build/Initialisation/seed-search.php`\u001b[82Gthe\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 37 +\u001b[38;2;248;248;242msearch and `Build/Initialisation/seed-pages.php` the example content of the other        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 38 +\u001b[38;2;248;248;242mpages, with the illustrations in `Build/Initialisation/images/`, and it is exported      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 39 +\u001b[38;2;248;248;242mfrom there:                                                                              \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 40 \r\u001b[5C\u001b[1B 41 \u001b[22m     ddev exec php Build/Initialisation/seed-page-tree.php\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 42 \u001b[15G\u001b[22mddev\u001b[20Gexec\u001b[25Gphp\u001b[29GBuild/Initialisation/seed-news.php\r\u001b[5C\u001b[1B\u001b[2m 43 \u001b[22m   \u001b[15Gddev\u001b[20Gexec\u001b[25Gphp\u001b[29GBuild/Initialisation/seed-home.php\r\u001b[1B     \u001b[2m 44 \u001b[22m     ddev exec php\u001b[29GBuild/Initialisation/seed-not-found.php\r\u001b[5C\u001b[1B\u001b[2m 45 \u001b[15G\u001b[22mddev\u001b[20Gexec\u001b[25Gphp\u001b[29GBuild/Initialisation/seed-search.php\r\u001b[1B \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 46 +\u001b[38;2;248;248;242m    ddev exec php Build/Initialisation/seed-pages.php                                    \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 47 \u001b[15G\u001b[22mddev\u001b[20Gexec\u001b[25Gtypo3\u001b[31Gimpexp:export\u001b[45G--type=xml\u001b[56G--pid=1\u001b[64G--levels=999\u001b[77G\\\r\u001b[1B \u001b[3G   \u001b[2m 48 \u001b[22m \u001b[12G       --table=pages --\u001b[36Gable=tt_content\u001b[52G--table=sys_category\u001b[73G\\\r\u001b[1B     \u001b[2m 49 \u001b[22m         --table=tx_news_domain_model_news --table=tx_news_domain_model_link \\\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 107 \u001b[22m   their fields\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +16 lines \r\u001b[1B  ⎿  Allow\u001b[12Gd by auto mode\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m*\u001b[3G\u001b[38;2;235;159;127mKerfuffling…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
