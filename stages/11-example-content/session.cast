    \r\u001b[4C\u001b[2BClick\u001b[11Gthe\u001b[15G2nd\u001b[19Gimage\u001b[27Gmark\u001b[32Gt picture, \"Image 2 of 4\", its caption\r\u001b[32C\u001b[2B3\u001b[39G,\u001b[41Gcaption\u001b[49Gchanges\u001b[57Gwith\u001b[62Git\r\u001b[4C\u001b[2B→       \u001b[14G      \u001b[27Gimage 4\u001b[35Gof 4\u001b[40G \r\u001b[2C\u001b[1B├\u001b[25G┼\u001b[71G┤\r\u001b[2C\u001b[1B│\u001b[5GPrevious\u001b[14Gbutton\u001b[25G│\u001b[27Gback\u001b[32Gto\u001b[35G3\u001b[37Gof\u001b[40G4\u001b[71G│\r\u001b[2C\u001b[1B└─────────────────────┴──────────────\u001b[69G──┘\u001b[73G\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[1733.339565, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by auto mode\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEvery image now has a caption, and Trade\u001b[44G&\u001b[46Gtourism\u001b[54Ghas\u001b[58Ga\u001b[60Gfour-image\u001b[71Ggallery\u001b[79Gfor\u001b[83Gtesting\u001b[91Gthe\u001b[95Glightbox:\r\u001b[2C\u001b[1B\u001b]8;id=1obiluj;https://demo.ddev.site/trade-tourism\u0007\u001b[94mhttps://demo.ddev.site/trade-tourism\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaptions:\u001b[22m fluid_s\u001b[21Gy\u001b[24Gd_content\u001b[34Galready\u001b[42Gshows\u001b[48Gan\u001b[51Gimage's\u001b[59G\"Description\"\u001b[73Gfield\u001b[79Gas\u001b[82Ga\u001b[84Gcaption,\u001b[93Gso\u001b[96Gthis\u001b[101Gwas\r\u001b[2C\u001b[1Bcontent plus a little styling:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAll 20 images have a short\u001b[32Gcaption,\u001b[41Gshown\u001b[47Gin\u001b[50Gsmall\u001b[56Ggrey\u001b[61Gtext\u001b[66Gunder\u001b[72Gthe\u001b[76Gimage\u001b[82Gand\u001b[86Gcentred\u001b[94Gunder\u001b[100Gthe\r\u001b[2C\u001b[1B \u001b[5Gpic\u001b[9Gu\u001b[11Ge\u001b[13Gin the lightbox.\u001b[K\r\u001b[4C\u001b[1BEditors fill in \"Description\"\u001b[35Gon an im\u001b[44Gge to add or change its capt\u001b[73Gon.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gaccessibility\u001b[23Gand\u001b[27Gprivacy\u001b[35Gimages\u001b[42Gsay\u001b[46Gthey\u001b[51Gare\u001b[55Gexample\u001b[63Gimages,\u001b[71Glike\u001b[76Gtheir\u001b[82Gtext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGallery:\u001b[12G\u001b[22mI added an \"Imag\u001b[30G\" element, \"Impre\u001b[48Gsions of\u001b[57GMto\u001b[61GSafi\",\u001b[68Gwith\u001b[73Gfour\u001b[78Gpictures\u001b[87Gin\u001b[90Gtwo\u001b[94Gcolumns,\u001b[103Geach\r\u001b[2C\u001b[1Bwith\u001b[8Gits\u001b[12Gown\u001b[16Gcaption.\u001b[25GI\u001b[27Gtested\u001b[34Git\u001b[37Gin\u001b[40Gheadless\u001b[49GChrome:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────────────┬─────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│        Step         │                    Shows                    │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Click the 2nd image │ market picture, \"Image 2 of 4\", its caption │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ →                   │ image 3 of 4, caption changes with it       │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ →                   │ image 4 of 4                                │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Previous button     │ back to 3 of \u001b[69G  │\u001b[31;1H\u001b[29;3H\u001b[?25h"]
