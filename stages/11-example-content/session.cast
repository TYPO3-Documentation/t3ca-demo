[384.150441, "o", "\u001b[?25l\u001b[H  - \u001b[1mRevenue & payments\u001b[22m: an \u001b[29Gntro\u001b[34Gwith\u001b[39Gan\u001b[42Gimage\u001b[48Gand\u001b[52Ga\u001b[54Gmenu\u001b[59Gof\u001b[62Gits\u001b[66Gsubpages.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLand rates, Single business permit, Parking fees, Market fees, Waiver of interest\u001b[22m:\u001b[88Gtext\u001b[93Gwith\u001b[98Gan\u001b[101Gimage,\r\u001b[4C\u001b[1Bplus a\u001b[12Gfee table \u001b[23Gr a \"what you need\"\u001b[43Glist.\u001b[49GThe\u001b[53Gland\u001b[58Grates\u001b[64Gfollow\r\u001b[1B    \u001b[38;2;177;185;249mdesign/docs/land-rates-calculation.md\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHealth, Environment & water, Trade & tourism, Public participation, Contact\u001b[22m:\u001b[82Gtext\u001b[87Gwith\u001b[92Gan\u001b[95Gimage,\u001b[102Gplus\r\u001b[4C\u001b[1Ba table or list (health ce\u001b[32Gtres, waste collec\u001b[51Gion d\u001b[57Gys, forum dates, opening hours).\u001b[90GContact\u001b[98Greuses\r\u001b[4C\u001b[1Bthe address\u001b[17Gand\u001b[21Ghours\u001b[27Gfrom\u001b[32G\u001b[38;2;177;185;249mdesign/contact.html\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mE-services portal, Access to information, Tenders\u001b[22m: text with an image; Access to information and\r\u001b[4C\u001b[1BTenders also have a list or table.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAccessibility statement, Privacy policy\u001b[22m: these say they are placeholders. Their real text is for\u001b[102Gthe\r\u001b[4C\u001b[1Bmunicipality to write, so I didn't invent legal text.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mImages\u001b[22m: 16 flat SVG drawings in the design's green, red and gold, each with alternative text. They\r\u001b[4C\u001b[1Bland in \u001b[38;2;177;185;249mfileadmin/user_upload/pages/\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it's built\u001b[22m (following the project's existing pattern)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mBuild/Initialisation/seed-pages.php\u001b[41G\u001b[39mwrites\u001b[48Gthe\u001b[52Gcontent,\u001b[61Gand\u001b[65Gits\u001b[69Gdrawings\u001b[78Gare\u001b[82Gin\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mBuild/Initialisation/images/\u001b[39m.\u001b[35GLike\u001b[40Gthe\u001b[44Gother\u001b[50Gseed\u001b[55Gscripts,\u001b[64Git\u001b[67Grefuses\u001b[75Gto\u001b[78Grun\u001b[82Gif\u001b[85Gany\u001b[89Gof\u001b[92Gthose\u001b[98Gpages\r\u001b[4C\u001b[1Balready \u001b[14Gas content.\u001b[K\r\u001b[1B  - I re-exported \u001b[38;2;177;185;249mInitialisation/data.xml\u001b[43G\u001b[39mand\u001b[47Greplaced\u001b[56Git\u001b[59Gwith\u001b[64Gthe\u001b[68Gnew\u001b[72Gexport,\u001b[80Gadding\u001b[87G16\u001b[90Gfiles\u001b[96Gto\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata.xml.files/\u001b[39m.\u001b[22GRecord\u001b[29Gcounts\u001b[36Gfor\u001b[40Gall\u001b[44Gother\u001b[50Gtables\u001b[57Gare\u001b[61Gunchanged.\r\u001b[1B \u001b[3G- The sitepackage README\u001b[28Glists\u001b[34Gthe\u001b[38Gnew\u001b[42Gscript\u001b[49Gand\u001b[53Gdescribes\u001b[63Gthe\u001b[67Gcontent.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges beyond content.\u001b[22m Without these, the pages didn't\u001b[59Glook\u001b[64Gright:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mImage layout:\u001b[19G\u001b[22mthe\u001b[23Gsite\u001b[28Gdidn't\u001b[35Gload\u001b[40Gfluid_styled_content's\u001b[63GCSS,\u001b[68Gso\u001b[71Gimages\u001b[78Gnever\u001b[84Gsat\u001b[88Gbeside\u001b[95Gthe\u001b[99Gtext.\u001b[105GI\r\u001b[1B \u001b[3G  added \u001b[38;2;177;185;249mtypo3/fluid-styled-content-css\u001b[39m to the site set's\u001b[60Gdependencies.\r\u001b[1B  -\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.430901, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[25B\u001b[1mStyles:\u001b[13G\u001b[22mI\u001b[15Gadded\u001b[21Ga\u001b[23Gtable\u001b[29Gstyle\u001b[35Gin\u001b[38Gthe\u001b[42Gdesign's\u001b[51Gcolours\u001b[59Gand\u001b[63Gmade\u001b[68Gimages\u001b[75Gsit\u001b[79Gabove\u001b[85Gthe\u001b[89Gtext\u001b[94Gon\u001b[97Gsmall\u001b[31;1H\u001b[29;3H\u001b[?25h"]
[384.729892, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G\u001b[38;2;177;185;249mdesign/docs/land-rates-calculation.md\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mHealth, Enviro\u001b[20Gment & water, T\u001b[36Gade & tourism, Public participation, Contact\u001b[22m: text with an image, plus\u001b[K\r\u001b[4C\u001b[1Ba table or\u001b[16Glist (health centres, waste collection days, forum dates,\u001b[74Gopening\u001b[82Ghours).\u001b[90GContact\u001b[98Greuses\r\u001b[4C\u001b[1Bthe address and hours from \u001b[38;2;177;185;249mdesign/contact.html\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mE-services portal, Access to\u001b[34Ginformati\u001b[44Gn, Tenders\u001b[22m: text with an image; Access to inform\u001b[93Gtion and\u001b[102G\u001b[K\r\u001b[4C\u001b[1BTenders\u001b[13Galso have a \u001b[26Gist or table.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAccessibility statement, Privacy policy\u001b[22m: these say\u001b[56Gthey\u001b[61Gare\u001b[65Gplaceholders.\u001b[79GTheir\u001b[85Greal\u001b[90Gtext\u001b[95Gis\u001b[98Gfor\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gmunicipality to write, so I didn't invent legal tex\u001b[57G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mImages\u001b[22m:\u001b[13G16 flat SVG\u001b[25Gdrawings in the\u001b[41Gdesign's\u001b[50Ggreen,\u001b[57Gred\u001b[61Gand\u001b[65Ggold,\u001b[71Geach\u001b[76Gwith\u001b[81Galternative\u001b[93Gtext.\u001b[99GThey\r\u001b[2C\u001b[1B \u001b[5Gland in \u001b[38;2;177;185;249mfileadmin/user_upload/pages/\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it'\u001b[11G built\u001b[22m (following the project's existin\u001b[51G patte\u001b[58Gn)\u001b[61G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mBuild/Initialisation/seed-p\u001b[33Gges.php\u001b[39m writes\u001b[48Gthe\u001b[52Gcontent,\u001b[61Gand\u001b[65Gits\u001b[69Gdrawings\u001b[78Gare\u001b[82Gin\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mBuild/Initialisation/images/\u001b[39m.\u001b[35GLike\u001b[40Gthe\u001b[44Gother\u001b[50Gseed\u001b[55Gscripts,\u001b[64Git\u001b[67Grefuses\u001b[75Gto\u001b[78Grun\u001b[82Gif\u001b[85Gany\u001b[89Gof\u001b[92Gthose\u001b[98Gpages\r\u001b[2C\u001b[1B  already has content.\u001b[K\r\u001b[4C\u001b[1BI re-exported \u001b[38;2;177;185;249mInitialisation/data.xml\u001b[39m and repla\u001b[53Ged it with the new export, adding\u001b[87G16\u001b[90Gfiles\u001b[96Gto\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdata.xml.f\u001b[16Gles/\u001b[39m. Record counts for\u001b[40Gall\u001b[50Gtable\u001b[56G are unchang\u001b[69Gd.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe sitep\u001b[15Gckage README\u001b[28Glists\u001b[34Gthe\u001b[38Gnew\u001b[42Gscript\u001b[49Gand\u001b[53Gdescribes\u001b[63Gthe\u001b[67Gcontent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges beyond content.\u001b[22m Withou\u001b[34G these, the pages didn't look right:\u001b[K\r\u001b[4C\u001b[1B\u001b[1mImage layout:\u001b[22m the site\u001b[28Gd\u001b[30Gdn't load fluid_s\u001b[48Gyle\u001b[52G_content'\u001b[63GCSS, so images\u001b[78Gnever\u001b[84Gsat\u001b[88Gbeside\u001b[95Gthe\u001b[99Gtext.\u001b[105GI\r\u001b[4C\u001b[1Badded\u001b[11G\u001b[38;2;177;185;249mtypo3/fluid-styled-content-css\u001b[42G\u001b[39mto\u001b[45Gthe\u001b[49Gsite\u001b[54Gset's\u001b[60Gdependencies.\r\u001b[2C\u001b[1B- \u001b[1mStyles:\u001b[22m I added a table style\u001b[35Gin the\u001b[42Gdesign's colours\u001b[59Gand made images\u001b[75Gsit\u001b[79Gabove\u001b[85Gthe\u001b[89Gtext\u001b[94Gon\u001b[97Gsmall\r\u001b[2C\u001b[1B \u001b[5Gscreens, where the side-by-side layout squeez\u001b[52G the text into a narrow column.\u001b[84GThe\u001b[88Gchang\u001b[94Gs are in\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m_components.scss\u001b[39m, with \u001b[38;2;177;185;249mmain.css\u001b[39m rebuilt.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
