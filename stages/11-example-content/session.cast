153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mReading\u001b[11Gwhat\u001b[16Glanded\u001b[23Gback\u001b[28Gout\u001b[32Gof\u001b[35Gthe\u001b[39Gdatabase:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m4\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gcontent\u001b[15Gis\u001b[18Gin,\u001b[22Gbut\u001b[26Gthe\u001b[30Gscreenshot\u001b[41Gshows\u001b[47Gthe\u001b[51Gimage\u001b[57Gisn't\u001b[63Gsitting\u001b[71Gbeside\u001b[78Gthe\u001b[82Gtext\u001b[87Gand\u001b[91Gthe\u001b[95Gtable\u001b[101Gis\r\u001b[1B \u001b[3Gunstyled, sin\u001b[17Ge th\u001b[22G site isn't \u001b[35Goading \u001b[43Gluid_styled_c\u001b[57Gntent's gallery CSS. I'm checking what the\u001b[K\r\u001b[2C\u001b[1Bsitepackage provides for that.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[42C\u001b[2B\u001b[38;2;153;153;153mthought for 8s)\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
