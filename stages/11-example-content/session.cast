[1493.358241, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mImage links:\u001b[22m I replaced one fluid_styled_content partial,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mTemplates/Partials/Content/Media/Type/Image.fluid.html\u001b[39m. When\u001b[66G\"Enlarge on click\" is set, the image\u001b[K\r\u001b[4C\u001b[1Blinks to it\u001b[18Gla\u001b[21Gge\u001b[24Gv\u001b[26Gr\u001b[28Gion (up to 1920 px), so it still works without JavaScript. Screen readers\u001b[102Ghe\u001b[105Gr\r\u001b[4C\u001b[1B\"(show\u001b[12Glarger)\"\u001b[21Gon\u001b[24Gthe\u001b[28Glink.\r\u001b[4C\u001b[1B\u001b[1mLabels:\u001b[22m \"Close\", \"Previous image\", \"Next imag\u001b[51G\",\u001b[54G\"Image 2\u001b[63Gof\u001b[66G3\"\u001b[69Gand\u001b[73G\"(show\u001b[80Glarger)\"\u001b[89Gare\u001b[93Gin\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mfrontend.xlf\u001b[39m, so they can be translated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefault on:\u001b[22m new cont\u001b[26Gnt elements have \"Enlarge\u001b[52Gon\u001b[55Gcl\u001b[58Gck\" switched \u001b[72Gn (\u001b[38;2;177;185;249mTCAdefaults\u001b[87G\u001b[39min \u001b[38;2;177;185;249mpage.tsconfig\u001b[39m). I\r\u001b[4C\u001b[1Bchecked that the se\u001b[25Gting is picked\u001b[40Gup\u001b[43Gfor\u001b[47Gthe\u001b[51Gsite's\u001b[58Gpages.\u001b[65GEditors\u001b[73Gcan\u001b[77Gstill\u001b[83Gswitch\u001b[90Git\u001b[93Goff\u001b[97Gper\r\u001b[2C\u001b[1B \u001b[5Gelement.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNews:\u001b[22m images on the news detail page open\u001b[47Gin\u001b[50Gthe\u001b[54Gsame\u001b[59Glightbox.\u001b[69GNo\u001b[72Gnews\u001b[77Gitem\u001b[82Ghas\u001b[86Gan\u001b[89Gimage\u001b[95Gyet,\u001b[100Gso\u001b[103Gthis\r\u001b[2C\u001b[1B \u001b[5Gpart hasn't\u001b[17Gb\u001b[19Gen seen working.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeeded content:\u001b[22m I rolled\u001b[30Gthe database\u001b[43Gback to\u001b[51Gthe sna\u001b[59Gshot an\u001b[67G re-ran the seed \u001b[87Gh \"Enlarge on\u001b[101Gclick\"\r\u001b[4C\u001b[1Bon all 16\u001b[15Gimages.\u001b[23GThen\u001b[28GI\u001b[30Gre-exported\u001b[42G\u001b[38;2;177;185;249mdata.xml\u001b[39m:\u001b[52Git\u001b[55Ghas\u001b[59Gthe\u001b[63Gsame\u001b[68Grecords\u001b[76Gand\u001b[80Gfiles\u001b[86Gas\u001b[89Gbefore,\u001b[97Gwith\u001b[102Gthe\r\u001b[2C\u001b[1B \u001b[5Gflag now s\u001b[16Gt. The README\u001b[32Gscribes the lightbox.\u001b[54G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot tested yet:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPrevious/next: no\u001b[23Gel\u001b[26Gment has m\u001b[38Ge than one image, so\u001b[61Gat part hasn't\u001b[76Grun\u001b[80Gin a brows\u001b[91Gr.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe fresh-install\u001b[23Gimport, a\u001b[33G before: it needs the\u001b[55GREADME's\u001b[64G\u001b[38;2;177;185;249mddev delete\u001b[39m,\u001b[77Gwhich\u001b[83Gwipes\u001b[89Gthis\u001b[94Gdatabase.\r\u001b[2C\u001b[2BNothing is committed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 3m 30s · done 6:17 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWe also need subtitles for the images\u001b[39m                                                                   \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m·\u001b[3GBloviating… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153m · esc to interrupt\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
