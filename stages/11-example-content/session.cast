ry:\u001b[12G\u001b[22mI\u001b[14Gadded\u001b[20Gan\u001b[23G\"Images\"\u001b[32Gelement,\u001b[41G\"Impressions\u001b[54Gof\u001b[57GMto\u001b[61GSafi\",\u001b[68Gwith\u001b[73Gfour\u001b[78Gpictures\u001b[87Gin\u001b[90Gtwo\u001b[94Gcolumns,\u001b[103Geach\r\u001b[2C\u001b[1Bwith its own caption. I tested it in headless Chrome:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌\u001b[25G┬\u001b[71G┐\r\u001b[4C\u001b[1B     \u001b[11G Step  \u001b[19G     \u001b[27G      \u001b[34G        \u001b[43G   Shows\u001b[52G  \u001b[55G   \u001b[59G   \u001b[63G       \r\u001b[4C\u001b[2BClick\u001b[11Gthe\u001b[15G2nd\u001b[19Gimage\u001b[27Gmark\u001b[32Gt picture, \"Image 2 of 4\", its caption\r\u001b[32C\u001b[2B3\u001b[39G,\u001b[41Gcaption\u001b[49Gchanges\u001b[57Gwith\u001b[62Git\r\u001b[4C\u001b[2B→       \u001b[14G      \u001b[27Gimage 4\u001b[35Gof 4\u001b[31;1H\u001b[29;3H\u001b[?25h"]
