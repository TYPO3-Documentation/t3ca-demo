[1514.685774, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gflag now set. The\u001b[23GREADME\u001b[30Gdescribes the ligh\u001b[49Gbox.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot tested yet:\u001b[19G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPrevious/next:\u001b[20Gno\u001b[23Gelement\u001b[31Ghas\u001b[35Gmore\u001b[40Gthan\u001b[45Gone\u001b[49Gimage,\u001b[56Gso\u001b[59Gthat\u001b[64Gpart\u001b[69Ghasn't\u001b[76Grun\u001b[80Gin\u001b[83Ga\u001b[85Gbrowser.\r\u001b[2C\u001b[1B- The fresh-install\u001b[23Gimport,\u001b[31Gas\u001b[34Gbefore:\u001b[42Git\u001b[45Gneeds\u001b[51Gthe\u001b[55GREADME's\u001b[64G\u001b[38;2;177;185;249mddev delete\u001b[39m,\u001b[77Gwhich\u001b[83Gwipes\u001b[89Gthis\u001b[94Gdatabase.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot\u001b[7Ging i\u001b[13G committed.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 3m 30s · done 6:17 PM\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mWe also need subtitles for the images\u001b[39m                                                                   \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Captions are already part of fluid_styled_content: an image's \"Description\" field renders as a\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m<figcaption>\u001b[16G\u001b[39munder\u001b[22Git,\u001b[26Gand\u001b[30Gthe\u001b[34Glightbox\u001b[43Gshows\u001b[49Git\u001b[52Gtoo.\u001b[57GSo\u001b[60Gthis\u001b[65Gneeds\u001b[71Ga\u001b[73Gcaption\u001b[81Gfor\u001b[85Geach\u001b[90Gseeded\u001b[97Gimage\u001b[103Gand\r\u001b[1B \u001b[3Ga caption style in the design. I'm adding b\u001b[47Gth, \u001b[52Ghen re-se\u001b[62Gding and re-export\u001b[81Gng.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mAdding captions, caption \u001b[29Gtyle; resee\u001b[41G and checking HTML\u001b[38;2;153;153;153m · 2s\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3 - <<'EOF'