[1590.802354, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m… +12 lines\u001b[22m\u001b[K\r\u001b[43C\u001b[1B\u001b[1mEADME.md\u001b[22m \u001b[38;2;56;166;96m+5\u001b[39m \u001b[38;2;179;89;107m-1\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m18 \u001b[22m and land in `fileadmin/user_upload/slides/`.\u001b[56GThe\u001b[60G\"Page\u001b[66Gnot\u001b[70Gfound\"\u001b[77Gpage\u001b[82Gcarries\u001b[90Gthe\r\u001b[6C\u001b[1B\u001b[2m19 \u001b[22m text the site shows for\u001b[35Gan address\u001b[46Gthat\u001b[51Gdoes\u001b[56Gnot\u001b[60Gexist.\u001b[67GEvery\u001b[73Gother\u001b[79Gpage\u001b[84Gcarries\r\u001b[6C\u001b[1B\u001b[2m20 \u001b[22m example content:\u001b[28Ga\u001b[30G\"Text\u001b[36G&\u001b[38GImages\"\u001b[46Gelement\u001b[54Gwith\u001b[59Gan\u001b[62Gillustration,\u001b[76Gmost\u001b[81Gof\u001b[84Gthem\u001b[89Ga\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m2\u001b[9G -\u001b[38;2;248;248;242mtable, a list o\u001b[27G the menu of the subpages\u001b[53Gbeside\u001b[60Git\u001b[48;2;92;2;0m.\u001b[64GThe\u001b[68Gillustrations\u001b[82Gland\u001b[87Gin\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m2\u001b[9G +\u001b[38;2;248;248;242mtable, a list or the menu of the subpages\u001b[53Gbeside\u001b[60Git\u001b[48;2;4;71;0m;\u001b[64G\"Trade\u001b[71G&\u001b[73Gtourism\"\u001b[82Galso has a\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 22 +\u001b[38;2;248;248;242mgallery of four images. Every image has an alternative text and a caption, which         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 23 +\u001b[38;2;248;248;242mshows under it and in the lightbox. The illustrations land in                            \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m24 \u001b[22m `fileadmin/user_upload/pages/`.\u001b[43GThe\u001b[47Gtexts\u001b[53Gare\u001b[57Gmade\u001b[62Gup\u001b[65Gfor\u001b[69Gthe\u001b[73Gfictional\r\u001b[1B     \u001b[2m 25 \u001b[22m municipality;\u001b[25Gthe\u001b[29Gaccessibility\u001b[43Gstatement\u001b[53Gand\u001b[57Gthe\u001b[61Gprivacy\u001b[69Gpolicy\u001b[76Gsay\u001b[80Gthat\u001b[85Gthey\u001b[90Gare\r\u001b[5C\u001b[1B\u001b[2m 26 \u001b[22m placeholders, because their real text is the municipality's\u001b[71Gto\u001b[74Gwrite.\u001b[81GThe\u001b[85G\"Search\u001b[93Gindex\"\r\u001b[1B     \u001b[2m    \u001b[22m folder holds what\u001b[29Gthe\u001b[33Gsearch\u001b[40Gneeds:\u001b[47Gthe\u001b[51Gfilter\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 134 \u001b[22m \u001b[13Ghem and the table the design's look, and puts a\u001b[61G image beside the text above\u001b[90Git on\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 135 \u001b[22m small screens.\u001b[27G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 136 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 137 +\u001b[38;2;248;248;242mAn image's description is its caption, under the image and in the lightbox.             \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 138 +\u001b[38;2;248;248;242m                                                                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 139 \u001b[22m An image with \"Enlarge on click\" opens\u001b[51Gfull\u001b[56Gsize\u001b[61G(up\u001b[65Gto\u001b[68G1920\u001b[73Gpixels)\u001b[81Gin\u001b[84Ga\u001b[86Glightbox,\u001b[96Ga\r\u001b[5C\u001b[1B\u001b[2m 140 \u001b[22m modal dialog\u001b[25Gwith\u001b[30Gprevious\u001b[39Gand\u001b[43Gnext\u001b[48Gfor\u001b[52Gthe\u001b[56Gimages\u001b[63Gof\u001b[66Gthe\u001b[70Gsame\u001b[75Gelement,\u001b[84Gthe\u001b[88Garrow\r\u001b[5C\u001b[1B\u001b[2m 141 \u001b[22m keys, Escape and a click beside the image to close. New elements have \"Enlarge\u001b[91Gon\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Allowed by aut\u001b[21G mod\u001b[26G\u001b[39m\u001b[K\u001b[31;1H\u001b[29;3H\u001b[?25h"]
