[1394.149531, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mLightbox script:\u001b[22m \u001b[38;2;177;185;249mResources/Public/JavaScrip\u001b[49G/lightbox.js\u001b[39m uses the browser's\u001b[81Gbuilt-in\u001b[90Gmodal\u001b[96Gdialog,\r\u001b[4C\u001b[1Bwith\u001b[10Gno\u001b[13Glibrary.\u001b[22GIt\u001b[25Ghas\u001b[29Ga\u001b[31Gclose\u001b[37Gbutton,\u001b[45GEscape,\u001b[53Gclick\u001b[59Gbeside\u001b[66Gthe\u001b[70Gimage\u001b[76Gto\u001b[79Gclose,\u001b[86Gand\u001b[90Gprevious/next\r\u001b[2C\u001b[1B  buttons plus\u001b[18Garrow\u001b[24Gkeys\u001b[29Gwhen\u001b[34Gone\u001b[38Gelement\u001b[46Ghas\u001b[50Gseveral\u001b[58Gimages.\u001b[66GPages\u001b[72Gwithout\u001b[80Gzoomable\u001b[89Gimages\u001b[96Gdon't\u001b[102Gload\r\u001b[2C\u001b[1B \u001b[5Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mImage links:\u001b[22m I replaced\u001b[29Gone fluid_s\u001b[41Gyled_cont\u001b[51Gnt partial,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mTemplates/Partials/Content/Media/Type/Image.fluid.html\u001b[39m. When\u001b[66G\"Enlarge on click\" is set, the image\u001b[K\r\u001b[4C\u001b[1Blinks\u001b[11Gto\u001b[14Gits\u001b[18Glarge\u001b[24Gversion\u001b[32G(up\u001b[36Gto\u001b[39G1920\u001b[44Gpx),\u001b[49Gso\u001b[52Git\u001b[55Gstill\u001b[61Gworks\u001b[67Gwithout\u001b[75GJavaScript.\u001b[87GScreen\u001b[94Greaders\u001b[102Ghear\r\u001b[2C\u001b[1B \u001b[5G\"(show larger)\" on th\u001b[27G li\u001b[31Gk.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLabels:\u001b[22m \"Close\", \"Previous image\", \"Next image\", \"Image\u001b[61G2 of\u001b[66G3\" and \"(show larger)\" are\u001b[93Gin\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mfrontend.xlf\u001b[39m, so they can be translated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefault on:\u001b[22m new\u001b[21Gcon\u001b[25Gent elements\u001b[38Ghave\u001b[43G\"Enlarge\u001b[52Gon\u001b[55Gclick\"\u001b[62Gswitched\u001b[71Gon\u001b[74G(\u001b[38;2;177;185;249mTCAdefaults\u001b[87G\u001