[1733.010122, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bpicture\u001b[13Gin\u001b[16Gthe\u001b[20Glightbox.\r\u001b[2C\u001b[1B- Editors fill in \"Description\" on an\u001b[41Gimage to add\u001b[55Gr\u001b[57Gchange \u001b[65Gts\u001b[68Gcaption.\u001b[K\r\u001b[2C\u001b[1B- T\u001b[7Ge accessibility and\u001b[27Gprivacy images say they are example\u001b[63Gimages,\u001b[71Glike\u001b[76Gtheir\u001b[82Gtext.\r\u001b[2C\u001b[2B\u001b[1mGallery:\u001b[22m I added an \"Images\" element, \"Impressions of Mto Safi\", with\u001b[73Gfour\u001b[78Gpictures\u001b[87Gin\u001b[90Gtwo\u001b[94Gcolumns,\u001b[103Geach\r\u001b[2C\u001b[1Bwith\u001b[8Gits\u001b[12Gown caption.\u001b[25GI\u001b[27Gtested\u001b[34Git\u001b[37Gin\u001b[40Gheadless Chrome:\u001b[71G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────────────┬─────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│        Step         │                    Shows                    │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Click the 2nd image │ market picture, \"Image 2 of 4\", its caption │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ →                   │ image 3 of 4, caption changes with it       │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ →                   │ image 4 of 4                                │\r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Previous but\u001b[18Gon\u001b[21G    │ b\u001b[29Gck\u001b[32Gto 3\u001b[37Gof\u001b[40G4  \u001b[44G     \u001b[50G      \u001b[57G       \u001b[65G  \u001b[68G   │\u001b[73G\u001b[K\r\u001b[2C\u001b[1B└─────────────────────┴─────────────────────────────────────────────┘\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWrapping from the last image back to the first\u0