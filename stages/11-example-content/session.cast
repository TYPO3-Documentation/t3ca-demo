ist\u001b[39m, \u001b[38;2;249;38;114mor\u001b[39m the menu\u001b[42Gof the subpages. T\u001b[62G texts\u001b[69Gar\u001b[73Gmade up \u001b[38;2;249;38;114mfor\u001b[39m the\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[13G\u001b[22mfi\u001b[16Gtional\u001b[23Gmunicipality, the land\u001b[46Grates foll\u001b[57Gw design/docs/land-rat\u001b[80Gs-calculation.md\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +399 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTaking a database\u001b[21Gsnapshot\u001b[30Gfirst\u001b[36Gso\u001b[39Gthe\u001b[43Gseed\u001b[48Gcan\u001b[52Gbe\u001b[55Gundone,\u001b[63Gthen\u001b[68Grunning\u001b[76Git.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[4G\u001b[39mead\u001b[11Gwhat \u001b[17Ganded back\u001b[28Gout\u001b[32Gof\u001b[35Gthe\u001b[39Gdatabase:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mKerfuf\u001b[38;2;235;159;127mfli\u001b[38;2;215;119;87mng…\u001b[39m\u001b[31;1H\u001b[29;3H\u001b[?25h"]
