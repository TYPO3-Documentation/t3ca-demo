[1511.508401, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mS\u001b[7Geded c\u001b[15Gtent:\u001b[21G\u001b[22mI rolled the datab\u001b[40Gs\u001b[43Gback to the\u001b[55Gsnapshot and re-ran the seed with \"Enlarge on click\"\r\u001b[4C\u001b[1Bon all 16 images. Then I\u001b[30Gre-exported \u001b[38;2;177;185;249mdata.xml\u001b[39m: \u001b[54G has th\u001b[62G same records and files as before,\u001b[97Gwith\u001b[102Gthe\r\u001b[4C\u001b[1Bf\u001b[7Gag \u001b[11Gow\u001b[14Gset.\u001b[19GThe\u001b[23GREADME\u001b[30Gdescribes\u001b[40Gthe\u001b[44Glightbox.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot tested yet:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BPrevious/next: no\u001b[23Gelem\u001b[28Gnt \u001b[32Gas more than one imag\u001b[54G, so t\u001b[61Ga\u001b[64Gpart hasn't run in a browser.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe fresh-\u001b[16Gnstall\u001b[23Gimport, as befor\u001b[40G:\u001b[42Git needs the\u001b[55GREADME's \u001b[38;2;177;185;249mddev delete\u001b[39m, which wipe\u001b[89Gthis database.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Gis\u001b[14Gcommitted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 3m 30s · done 6:17 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWe also need subtitles for the images\u001b[39m                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCaptions\u001b[12Gare\u001b[16Galready\u001b[24Gpart\u001b[29Gof\u001b[32Gfluid_styled_content:\u001b[54Gan\u001b[57Gimage's\u001b[65G\"Description\"\u001b[79Gfield\u001b[85Grenders\u001b[93Gas\u001b[96Ga\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249m<figcaption>\u001b[39m under it, and the lightbox\u001b[43Gshows\u001b[49Git\u001b[52Gtoo.\u001b[57GSo\u001b[60Gthis\u001b[65Gneeds\u001b[71Ga\u001b[73Gcaption\u001b[81Gfor\u001b[85Geach\u001b[90Gseeded\u001b[97Gimage\u001b[103Gand\r\u001b[2C\u001b[1Ba\u001b[5Gcaption\u001b[13Gstyle\u001b[19Gin\u001b[22Gthe\u001b[26Gdesign.\u001b[34GI'm\u001b[38Gadding\u001b[45Gboth,\u001b[51Gthen\u001b[56Gre-seeding\u001b[67Gand\u001b[71Gre-exporting.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mAdding\u001b[10Gcaptions,\u001b[20Gcaption\u001b[28Gstyle;\u001b[35Greseed\u001b[42Gand\u001b[46Gchecking\u001b[55GHTML\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153mp='Build/Initialisation/seed-pages.php'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G \u001b[38;2;153;153;153ms=open(p).read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153ma=\"\"\"$pageUids = [];\"\"\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mb=\"\"\"// The caption under each image and in the lightbox, by image. It goes on the reference…\r\u001b[25C\u001b[2B6\u001b[39m\u001b[31;1H\u001b[29;35H\u001b[?25h"]
