[1514.736056, "o", "\u001b[?25l\u001b[H\r\u001b[25B\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;218;124;92mBloviating…\u001b[39m\u001b[31;1H\u001b[29;49H\u001b[?25h"]
[1514.829241, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GPrevious/n\u001b[16Gxt: no\u001b[23Gelement has more\u001b[42Gan one image,\u001b[56Gso\u001b[59Gthat\u001b[64Gpart\u001b[69Ghasn't\u001b[76Grun\u001b[80Gin\u001b[83Ga\u001b[85Gbrowser.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gfresh-install\u001b[23Gimport,\u001b[31Gas\u001b[34Gbefore:\u001b[42Git\u001b[45Gneeds\u001b[51Gthe\u001b[55GREADME's\u001b[64G\u001b[38;2;177;185;249mddev delete\u001b[39m,\u001b[77Gwhich\u001b[83Gwipes\u001b[89Gthis\u001b[94Gdatabase.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing i\u001b[13G committed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 3m 30s · done 6:17 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWe also need subtitles for the images\u001b[39m                                                                   \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCaptions\u001b[12Gare\u001b[16Galready\u001b[24Gpart\u001b[29Gof\u001b[32Gfluid_styled_content:\u001b[54Gan\u001b[57Gimage's\u001b[65G\"Description\"\u001b[79Gfield\u001b[85Grenders\u001b[93Gas\u001b[96Ga\r\u001b[1B  \u001b[38;2;177;185;249m<figcaption>\u001b[39m under it, and the lightbox shows it too. So this needs a caption for each seeded image and\u001b[K\r\u001b[2C\u001b[1Ba\u001b[5Gcaption\u001b[13Gstyle\u001b[19Gin\u001b[22Gthe\u001b[26Gdesign.\u001b[34GI'm\u001b[38Gadding\u001b[45Gboth,\u001b[51Gthen\u001b[56Gre-seeding\u001b[67Gand\u001b[71Gre-exporting.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mAdding captions, cap\u001b[24Gion styl\u001b[33G; reseed and checking HTML\u001b[38;2;153;153;153m · 2s\u001b[65G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3 - <<'EOF'\u001b[26G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mp='Build/Initialisation/seed-pages.php'\r\u001b[1B\u001b[39m \u