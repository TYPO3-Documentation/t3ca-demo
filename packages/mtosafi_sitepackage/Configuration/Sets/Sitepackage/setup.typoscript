config {
  # "Land rates — Mto Safi Municipality": the page first, then the website title of the site language.
  pageTitleFirst = 1
  pageTitleSeparator = —
  pageTitleSeparator.noTrimWrap = | | |
}

page = PAGE
page {
  typeNum = 0
  shortcutIcon = EXT:mtosafi_sitepackage/Resources/Public/Images/logo.svg

  meta.viewport = width=device-width, initial-scale=1

  includeCSS {
    mtosafi = EXT:mtosafi_sitepackage/Resources/Public/Css/main.css
  }

  includeJSFooter {
    mtosafiNavigation = EXT:mtosafi_sitepackage/Resources/Public/JavaScript/navigation.js
    mtosafiNavigation.defer = 1
  }

  10 = PAGEVIEW
  10 {
    paths.10 = EXT:mtosafi_sitepackage/Resources/Private/Templates/

    dataProcessing {
      # The home page as the first entry of the main navigation.
      10 = menu
      10 {
        special = list
        special.value.data = site:rootPageId
        as = homeNavigation
      }

      # The pages below the home page.
      20 = menu
      20 {
        levels = 1
        as = mainNavigation
      }

      # The section the current page belongs to, for the sub-navigation of the SidebarLeft layout.
      30 = menu
      30 {
        special = directory
        special.value.data = leveluid:1
        levels = 1
        as = subNavigation
      }

      # Pages hidden from the navigation, such as the search, still belong in the breadcrumb.
      40 = menu
      40 {
        special = rootline
        special.range = 0|-1
        includeNotInMenu = 1
        as = breadcrumb
      }

      50 = menu
      50 {
        if.isTrue = {$mtosafi.navigation.serviceMenu}
        special = directory
        special.value = {$mtosafi.navigation.serviceMenu}
        as = serviceNavigation
      }

      60 = menu
      60 {
        if.isTrue = {$mtosafi.navigation.footerMenu}
        special = directory
        special.value = {$mtosafi.navigation.footerMenu}
        as = footerNavigation
      }

      70 = language-menu
      70 {
        languages = auto
        as = languageNavigation
      }
    }
  }
}

# Content elements of the sitepackage: their templates in Templates/Content/, the layout
# and the other partials stay those of fluid_styled_content.
lib.contentElement.templateRootPaths.200 = EXT:mtosafi_sitepackage/Resources/Private/Templates/Content/
# Partials of fluid_styled_content the site replaces: Media/Type/Image opens "Enlarge on
# click" in the site's lightbox. Partials/Content/ keeps them apart from the page partials.
lib.contentElement.partialRootPaths.200 = EXT:mtosafi_sitepackage/Resources/Private/Templates/Partials/Content/

@import './TypoScript/ContentElements/*.typoscript'

# News (EXT:news): the design's markup instead of the extension's own, and none of its CSS.
plugin.tx_news {
  view {
    templateRootPaths.10 = EXT:mtosafi_sitepackage/Resources/Private/Extensions/News/Templates/
    partialRootPaths.10 = EXT:mtosafi_sitepackage/Resources/Private/Extensions/News/Partials/
    layoutRootPaths.10 = EXT:mtosafi_sitepackage/Resources/Private/Extensions/News/Layouts/
  }
  settings {
    cssFile =
    displayDummyIfNoMedia = 0
    list.paginate.itemsPerPage = 12
  }
}

# Search (EXT:ke_search): the design's markup, none of the extension's CSS, and "q" as the
# parameter of the search word, which the search field in the page header submits.
# Extensions/Search/Partials/ holds the markup of a result that does not depend on the
# search engine.
plugin.tx_kesearch_pi1 {
  view {
    templateRootPaths.10 = EXT:mtosafi_sitepackage/Resources/Private/Extensions/KeSearch/Templates/
    partialRootPaths.10 = EXT:mtosafi_sitepackage/Resources/Private/Extensions/Search/Partials/
    partialRootPaths.20 = EXT:mtosafi_sitepackage/Resources/Private/Extensions/KeSearch/Partials/
    layoutRootPaths.10 = EXT:mtosafi_sitepackage/Resources/Private/Extensions/KeSearch/Layouts/
  }
  cssFile =
  searchWordParameter = q
}

# The result list copied these from the search box before the lines above were set.
plugin.tx_kesearch_pi2 {
  view < plugin.tx_kesearch_pi1.view
  cssFile =
  searchWordParameter < plugin.tx_kesearch_pi1.searchWordParameter
}
