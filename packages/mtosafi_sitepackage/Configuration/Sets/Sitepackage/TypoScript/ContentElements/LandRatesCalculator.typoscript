# Land rates calculator (CType mtosafi_landrates): design/land-rates.html, the calculator.
# lib.contentElement hands the element to the template as {record}; its land uses are
# {record.tx_mtosafisitepackage_landuses}, in the editor's order, translated and
# without the hidden ones.
tt_content.mtosafi_landrates =< lib.contentElement
tt_content.mtosafi_landrates {
  templateName = LandRatesCalculator
}
