# Slider (CType mtosafi_slider): design/index.html, the carousel at the top.
# lib.contentElement hands the element to the template as {record}; its slides are
# {record.tx_mtosafisitepackage_slides}, in the editor's order, translated and
# without the hidden ones.
tt_content.mtosafi_slider =< lib.contentElement
tt_content.mtosafi_slider {
  templateName = Slider
}
