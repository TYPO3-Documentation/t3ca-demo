{
    "name": "mtosafi/sitepackage",
    "description": "Sitepackage of the Mto Safi Municipality website: site set, page layouts, page templates and the design's styles.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Lina Wolf",
            "role": "Developer"
        }
    ],
    "require": {
        "georgringer/news": "^14.1",
        "tpwd/ke_search": "^7.5",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-impexp": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mtosafi_sitepackage"
        }
    },
    "autoload": {
        "psr-4": {
            "Mtosafi\\Sitepackage\\": "Classes/"
        }
    }
}
