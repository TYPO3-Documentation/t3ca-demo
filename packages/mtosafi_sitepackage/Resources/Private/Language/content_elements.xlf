<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" datatype="plaintext" original="EXT:mtosafi_sitepackage/Resources/Private/Language/content_elements.xlf" date="2026-11-22T00:00:00Z" product-name="mtosafi_sitepackage">
		<header/>
		<body>
			<trans-unit id="group">
				<source>Mto Safi</source>
			</trans-unit>
			<trans-unit id="tiles.title">
				<source>Service tiles</source>
			</trans-unit>
			<trans-unit id="tiles.description">
				<source>A heading and a grid of tiles, each with an icon and a link to a service, such as "Popular services" on the home page.</source>
			</trans-unit>
			<trans-unit id="tiles.field.tiles">
				<source>Tiles</source>
			</trans-unit>
			<trans-unit id="tiles.field.tiles.new">
				<source>Add a tile</source>
			</trans-unit>
			<trans-unit id="tile">
				<source>Service tile</source>
			</trans-unit>
			<trans-unit id="tile.icon">
				<source>Icon</source>
			</trans-unit>
			<trans-unit id="tile.icon.description">
				<source>One emoji, such as 🏡. It is decoration only: screen readers skip it, so the label has to say everything.</source>
			</trans-unit>
			<trans-unit id="tile.label">
				<source>Label</source>
			</trans-unit>
			<trans-unit id="tile.link">
				<source>Link</source>
			</trans-unit>
			<trans-unit id="tile.link.description">
				<source>The page of the service, usually. A link to another website opens in the same window.</source>
			</trans-unit>
			<trans-unit id="slider.title">
				<source>Slider</source>
			</trans-unit>
			<trans-unit id="slider.description">
				<source>Slides with a large image and a caption with a heading, a short text and a button, one at a time, such as the highlights at the top of the home page.</source>
			</trans-unit>
			<trans-unit id="slider.field.header">
				<source>Name for screen readers</source>
			</trans-unit>
			<trans-unit id="slider.field.header.description">
				<source>Not shown on the page. Screen readers announce the slider by it, such as "Highlights".</source>
			</trans-unit>
			<trans-unit id="slider.field.slides">
				<source>Slides</source>
			</trans-unit>
			<trans-unit id="slider.field.slides.new">
				<source>Add a slide</source>
			</trans-unit>
			<trans-unit id="slide">
				<source>Slide</source>
			</trans-unit>
			<trans-unit id="slide.image">
				<source>Image</source>
			</trans-unit>
			<trans-unit id="slide.image.description">
				<source>A wide picture, at least 1600 × 560 pixels; it is cropped to fill the slide. It is decoration only: screen readers skip it, so the heading and the text have to say everything.</source>
			</trans-unit>
			<trans-unit id="slide.title">
				<source>Heading</source>
			</trans-unit>
			<trans-unit id="slide.text">
				<source>Text</source>
			</trans-unit>
			<trans-unit id="slide.palette.button">
				<source>Button</source>
			</trans-unit>
			<trans-unit id="slide.link_label">
				<source>Button text</source>
			</trans-unit>
			<trans-unit id="slide.link_label.description">
				<source>Says where the button leads, such as "Calculate land rates". The button shows only where it has a text and a link.</source>
			</trans-unit>
			<trans-unit id="slide.link">
				<source>Link</source>
			</trans-unit>
			<trans-unit id="landrates.title">
				<source>Land rates calculator</source>
			</trans-unit>
			<trans-unit id="landrates.description">
				<source>Owners calculate their annual land rate from the land use and the rateable value of their plot, with the interest for paying late, in Kenya shillings.</source>
			</trans-unit>
			<trans-unit id="landrates.field.landuses">
				<source>Land uses</source>
			</trans-unit>
			<trans-unit id="landrates.field.landuses.new">
				<source>Add a land use</source>
			</trans-unit>
			<trans-unit id="landrates.palette.rates">
				<source>Minimum and interest</source>
			</trans-unit>
			<trans-unit id="landrates.field.minimum">
				<source>Minimum rate (KES per plot and year)</source>
			</trans-unit>
			<trans-unit id="landrates.field.minimum.description">
				<source>A plot pays at least this much, whatever its value. 0 for no minimum.</source>
			</trans-unit>
			<trans-unit id="landrates.field.interest">
				<source>Interest when paid late (% per month)</source>
			</trans-unit>
			<trans-unit id="landrates.field.interest.description">
				<source>Percent of the annual rate, for every month after 31 March that has started before the rate is paid, such as 1 for 1 %. 0 for no interest.</source>
			</trans-unit>
			<trans-unit id="landuse">
				<source>Land use</source>
			</trans-unit>
			<trans-unit id="landuse.label">
				<source>Land use</source>
			</trans-unit>
			<trans-unit id="landuse.label.description">
				<source>As the valuation roll names it, such as "Residential".</source>
			</trans-unit>
			<trans-unit id="landuse.percent">
				<source>Rate (% of the rateable value per year)</source>
			</trans-unit>
			<trans-unit id="landuse.percent.description">
				<source>Such as 0.5 for 0.5 %. A translation calculates with the rate of the default language.</source>
			</trans-unit>
			<trans-unit id="preview.landrates.minimum">
				<source>Minimum rate: KES %1$s per plot and year</source>
			</trans-unit>
			<trans-unit id="preview.landrates.interest">
				<source>Interest when paid late: %1$s %% per month</source>
			</trans-unit>
			<trans-unit id="preview.noLink">
				<source>no link</source>
			</trans-unit>
		</body>
	</file>
</xliff>
